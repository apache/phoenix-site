nctions","tags":["multi-page"],"type":"text","url":"/docs/functions#sqrt","content":"Example"},"2156":{"id":"/docs/functions-241","page_id":"/docs/functions","tags":["multi-page"],"type":"text","url":"/docs/functions#cbrt","content":"Returns the cube root of the given numeric expression as a DOUBLE."},"2157":{"id":"/docs/functions-242","page_id":"/docs/functions","tags":["multi-page"],"type":"text","url":"/docs/functions#cbrt","content":"Example"},"2158":{"id":"/docs/functions-243","page_id":"/docs/functions","tags":["multi-page"],"type":"text","url":"/docs/functions#exp","content":"Returns Euler's number e raised to the power of the given numeric value as a DOUBLE."},"2159":{"id":"/docs/functions-244","page_id":"/docs/functions","tags":["multi-page"],"type":"text","url":"/docs/functions#exp","content":"Example"},"2160":{"id":"/docs/functions-245","page_id":"/docs/functions","tags":["multi-page"],"type":"text","url":"/docs/functions#power","content":"Returns the value of the first argument raised to the power of the second argument as a DOUBLE."},"2161":{"id":"/docs/functions-246","page_id":"/docs/functions","tags":["multi-page"],"type":"text","url":"/docs/functions#power","content":"Example"},"2162":{"id":"/docs/functions-247","page_id":"/docs/functions","tags":["multi-page"],"type":"text","url":"/docs/functions#ln","content":"Returns the natural logarithm (base e) of the given positive expression as a DOUBLE."},"2163":{"id":"/docs/functions-248","page_id":"/docs/functions","tags":["multi-page"],"type":"text","url":"/docs/functions#ln","content":"Example"},"2164":{"id":"/docs/functions-249","page_id":"/docs/functions","tags":["multi-page"],"type":"text","url":"/docs/functions#log","content":"Returns the logarithm of the first argument computed at the base of the second argument as a DOUBLE. If omitted, a base of 10 will be used for the second argument."},"2165":{"id":"/docs/functions-250","page_id":"/docs/functions","tags":["multi-page"],"type":"text","url":"/docs/functions#log","content":"Example"},"2166":{"id":"/docs/fundamentals/backward-compatibility","page_id":"/docs/fundamentals/backward-compatibility","type":"page","content":"Backward Compatibility","breadcrumbs":["Docs","Multi-Page Documentation","Development","Fundamentals"],"tags":["multi-page"],"url":"/docs/fundamentals/backward-compatibility"},"2167":{"id":"/docs/fundamentals/backward-compatibility-0","page_id":"/docs/fundamentals/backward-compatibility","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/backward-compatibility","content":"Phoenix upgrade compatibility across patch, minor, and major releases."},"2168":{"id":"/docs/fundamentals/backward-compatibility-1","page_id":"/docs/fundamentals/backward-compatibility","type":"heading","tags":["multi-page"],"url":"/docs/fundamentals/backward-compatibility#versioning-convention","content":"Versioning Convention"},"2169":{"id":"/docs/fundamentals/backward-compatibility-2","page_id":"/docs/fundamentals/backward-compatibility","type":"heading","tags":["multi-page"],"url":"/docs/fundamentals/backward-compatibility#patch-release","content":"Patch Release"},"2170":{"id":"/docs/fundamentals/backward-compatibility-3","page_id":"/docs/fundamentals/backward-compatibility","type":"heading","tags":["multi-page"],"url":"/docs/fundamentals/backward-compatibility#minor-release","content":"Minor Release"},"2171":{"id":"/docs/fundamentals/backward-compatibility-4","page_id":"/docs/fundamentals/backward-compatibility","type":"heading","tags":["multi-page"],"url":"/docs/fundamentals/backward-compatibility#major-release","content":"Major Release"},"2172":{"id":"/docs/fundamentals/backward-compatibility-5","page_id":"/docs/fundamentals/backward-compatibility","type":"heading","tags":["multi-page"],"url":"/docs/fundamentals/backward-compatibility#release-notes","content":"Release Notes"},"2173":{"id":"/docs/fundamentals/backward-compatibility-6","page_id":"/docs/fundamentals/backward-compatibility","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/backward-compatibility","content":"Phoenix maintains backward compatibility across at least two minor releases to allow for no downtime through server-side rolling\nrestarts upon upgrading. See below for details."},"2174":{"id":"/docs/fundamentals/backward-compatibility-7","page_id":"/docs/fundamentals/backward-compatibility","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/backward-compatibility#versioning-convention","content":"Phoenix uses a standard three number versioning schema of the form:"},"2175":{"id":"/docs/fundamentals/backward-compatibility-8","page_id":"/docs/fundamentals/backward-compatibility","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/backward-compatibility#versioning-convention","content":"For example, 4.2.1 has a major version of 4,\na minor version of 2, and a patch version of 1."},"2176":{"id":"/docs/fundamentals/backward-compatibility-9","page_id":"/docs/fundamentals/backward-compatibility","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/backward-compatibility#patch-release","content":"Upgrading to a new patch release (i.e. only the patch version has changed) is the simplest case. The jar upgrade may occur in any order: client first or server first, and a mix of clients with different patch release versions is fine."},"2177":{"id":"/docs/fundamentals/backward-compatibility-10","page_id":"/docs/fundamentals/backward-compatibility","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/backward-compatibility#minor-release","content":"When upgrading to a new minor release (i.e. the major version is the same, but the minor\nversion has changed), sometimes modifications to the system tables are necessary to either\nfix a bug or provide a new feature. This upgrade will occur automatically the first time a\nnewly upgraded client connects to the newly upgraded server. It is required that the\nserver-side jar be upgraded first across your entire cluster, before any clients are\nupgraded. An older client (two minor versions back) will work with a newer server jar when\nthe minor version is different, but not vice versa. In other words, clients do not need to\nbe upgraded in lock step with the server. However, as the server version moves forward,\nthe client version should move forward as well. This allows Phoenix to evolve its client/server\nprotocol while still providing clients sufficient time to upgrade their clients."},"2178":{"id":"/docs/fundamentals/backward-compatibility-11","page_id":"/docs/fundamentals/backward-compatibility","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/backward-compatibility#minor-release","content":"As of the 4.3 release, a mix of clients on different minor release versions is supported as well\n(note that prior releases required all clients to be upgraded at the same time). Another improvement\nas of the 4.3 release is that an upgrade may be done directly from one minor version to another\nhigher minor version (prior releases required an upgrade to each minor version in between)."},"2179":{"id":"/docs/fundamentals/backward-compatibility-12","page_id":"/docs/fundamentals/backward-compatibility","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/backward-compatibility#major-release","content":"Upgrading to a new major release may require downtime as well as potentially the running of a migration\nscript. Additionally, all clients and servers may need to be upgraded at the same time. This will be\ndetermined on a release-by-release basis."},"2180":{"id":"/docs/fundamentals/backward-compatibility-13","page_id":"/docs/fundamentals/backward-compatibility","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/backward-compatibility#release-notes","content":"Specific details on issues and their fixes that may impact you can be found here."},"2181":{"id":"/docs/fundamentals/building","page_id":"/docs/fundamentals/building","type":"page","content":"Building","breadcrumbs":["Docs","Multi-Page Documentation","Development","Fundamentals"],"tags":["multi-page"],"url":"/docs/fundamentals/building"},"2182":{"id":"/docs/fundamentals/building-0","page_id":"/docs/fundamentals/building","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/building","content":"Build Apache Phoenix and add it to Maven-based projects."},"2183":{"id":"/docs/fundamentals/building-1","page_id":"/docs/fundamentals/building","type":"heading","tags":["multi-page"],"url":"/docs/fundamentals/building#building-the-main-phoenix-project","content":"Building the Main Phoenix Project"},"2184":{"id":"/docs/fundamentals/building-2","page_id":"/docs/fundamentals/building","type":"heading","tags":["multi-page"],"url":"/docs/fundamentals/building#using-phoenix-in-a-maven-project","content":"Using Phoenix in a Maven Project"},"2185":{"id":"/docs/fundamentals/building-3","page_id":"/docs/fundamentals/building","type":"heading","tags":["multi-page"],"url":"/docs/fundamentals/building#branches","content":"Branches"},"2186":{"id":"/docs/fundamentals/building-4","page_id":"/docs/fundamentals/building","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/building#building-the-main-phoenix-project","content":"Phoenix consists of several subprojects."},"2187":{"id":"/docs/fundamentals/building-5","page_id":"/docs/fundamentals/building","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/building#building-the-main-phoenix-project","content":"The core project is phoenix, which depends on phoenix-thirdparty, phoenix-omid, and phoenix-tephra."},"2188":{"id":"/docs/fundamentals/building-6","page_id":"/docs/fundamentals/building","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/building#building-the-main-phoenix-project","content":"phoenix-queryserver and phoenix-connectors are optional packages that also depend on phoenix."},"2189":{"id":"/docs/fundamentals/building-7","page_id":"/docs/fundamentals/building","tags":["multi-page"],"type":"text","url":"/do