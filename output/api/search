es-12","page_id":"/docs/features/secondary-indexes","type":"heading","tags":["multi-page"],"url":"/docs/features/secondary-indexes#partial-indexes-limitations","content":"Limitations"},"1278":{"id":"/docs/features/secondary-indexes-13","page_id":"/docs/features/secondary-indexes","type":"heading","tags":["multi-page"],"url":"/docs/features/secondary-indexes#index-population","content":"Index Population"},"1279":{"id":"/docs/features/secondary-indexes-14","page_id":"/docs/features/secondary-indexes","type":"heading","tags":["multi-page"],"url":"/docs/features/secondary-indexes#async-index-threshold","content":"ASYNC Index threshold"},"1280":{"id":"/docs/features/secondary-indexes-15","page_id":"/docs/features/secondary-indexes","type":"heading","tags":["multi-page"],"url":"/docs/features/secondary-indexes#index-usage","content":"Index Usage"},"1281":{"id":"/docs/features/secondary-indexes-16","page_id":"/docs/features/secondary-indexes","type":"heading","tags":["multi-page"],"url":"/docs/features/secondary-indexes#index-removal","content":"Index Removal"},"1282":{"id":"/docs/features/secondary-indexes-17","page_id":"/docs/features/secondary-indexes","type":"heading","tags":["multi-page"],"url":"/docs/features/secondary-indexes#index-properties","content":"Index Properties"},"1283":{"id":"/docs/features/secondary-indexes-18","page_id":"/docs/features/secondary-indexes","type":"heading","tags":["multi-page"],"url":"/docs/features/secondary-indexes#consistency-guarantees","content":"Consistency Guarantees"},"1284":{"id":"/docs/features/secondary-indexes-19","page_id":"/docs/features/secondary-indexes","type":"heading","tags":["multi-page"],"url":"/docs/features/secondary-indexes#local-indexes-1","content":"Local Indexes"},"1285":{"id":"/docs/features/secondary-indexes-20","page_id":"/docs/features/secondary-indexes","type":"heading","tags":["multi-page"],"url":"/docs/features/secondary-indexes#global-indexes-on-transactional-tables","content":"Global Indexes on Transactional Tables"},"1286":{"id":"/docs/features/secondary-indexes-21","page_id":"/docs/features/secondary-indexes","type":"heading","tags":["multi-page"],"url":"/docs/features/secondary-indexes#global-indexes-on-immutable-tables","content":"Global Indexes on Immutable Tables"},"1287":{"id":"/docs/features/secondary-indexes-22","page_id":"/docs/features/secondary-indexes","type":"heading","tags":["multi-page"],"url":"/docs/features/secondary-indexes#immutable-table-indexes-for-415-and-51-and-newer-versions","content":"Immutable table indexes for 4.15 (and 5.1) and newer versions"},"1288":{"id":"/docs/features/secondary-indexes-23","page_id":"/docs/features/secondary-indexes","type":"heading","tags":["multi-page"],"url":"/docs/features/secondary-indexes#immutable-table-indexes-for-414-and-50-and-older-versions","content":"Immutable table indexes for 4.14 (and 5.0) and older versions"},"1289":{"id":"/docs/features/secondary-indexes-24","page_id":"/docs/features/secondary-indexes","type":"heading","tags":["multi-page"],"url":"/docs/features/secondary-indexes#global-indexes-on-mutable-tables","content":"Global Indexes on Mutable Tables"},"1290":{"id":"/docs/features/secondary-indexes-25","page_id":"/docs/features/secondary-indexes","type":"heading","tags":["multi-page"],"url":"/docs/features/secondary-indexes#mutable-table-indexes-for-415-and-51-and-newer-versions","content":"Mutable table indexes for 4.15 (and 5.1) and newer versions"},"1291":{"id":"/docs/features/secondary-indexes-26","page_id":"/docs/features/secondary-indexes","type":"heading","tags":["multi-page"],"url":"/docs/features/secondary-indexes#mutable-table-indexes-for-414-and-50-and-older-versions","content":"Mutable table indexes for 4.14 (and 5.0) and older versions"},"1292":{"id":"/docs/features/secondary-indexes-27","page_id":"/docs/features/secondary-indexes","type":"heading","tags":["multi-page"],"url":"/docs/features/secondary-indexes#bulkload-tool-limitation","content":"BulkLoad Tool Limitation"},"1293":{"id":"/docs/features/secondary-indexes-28","page_id":"/docs/features/secondary-indexes","type":"heading","tags":["multi-page"],"url":"/docs/features/secondary-indexes#setup","content":"Setup"},"1294":{"id":"/docs/features/secondary-indexes-29","page_id":"/docs/features/secondary-indexes","type":"heading","tags":["multi-page"],"url":"/docs/features/secondary-indexes#for-phoenix-412-and-later","content":"For Phoenix 4.12 and later"},"1295":{"id":"/docs/features/secondary-indexes-30","page_id":"/docs/features/secondary-indexes","type":"heading","tags":["multi-page"],"url":"/docs/features/secondary-indexes#for-phoenix-48---411","content":"For Phoenix 4.8 - 4.11"},"1296":{"id":"/docs/features/secondary-indexes-31","page_id":"/docs/features/secondary-indexes","type":"heading","tags":["multi-page"],"url":"/docs/features/secondary-indexes#for-phoenix-versions-47-and-below","content":"For Phoenix versions 4.7 and below"},"1297":{"id":"/docs/features/secondary-indexes-32","page_id":"/docs/features/secondary-indexes","type":"heading","tags":["multi-page"],"url":"/docs/features/secondary-indexes#upgrading-local-indexes-created-before-480","content":"Upgrading Local Indexes created before 4.8.0"},"1298":{"id":"/docs/features/secondary-indexes-33","page_id":"/docs/features/secondary-indexes","type":"heading","tags":["multi-page"],"url":"/docs/features/secondary-indexes#secondary-indexes-tuning","content":"Tuning"},"1299":{"id":"/docs/features/secondary-indexes-34","page_id":"/docs/features/secondary-indexes","type":"heading","tags":["multi-page"],"url":"/docs/features/secondary-indexes#secondary-indexes-performance","content":"Performance"},"1300":{"id":"/docs/features/secondary-indexes-35","page_id":"/docs/features/secondary-indexes","type":"heading","tags":["multi-page"],"url":"/docs/features/secondary-indexes#index-scrutiny-tool","content":"Index Scrutiny Tool"},"1301":{"id":"/docs/features/secondary-indexes-36","page_id":"/docs/features/secondary-indexes","type":"heading","tags":["multi-page"],"url":"/docs/features/secondary-indexes#secondary-indexes-limitations","content":"Limitations"},"1302":{"id":"/docs/features/secondary-indexes-37","page_id":"/docs/features/secondary-indexes","type":"heading","tags":["multi-page"],"url":"/docs/features/secondary-indexes#index-upgrade-tool","content":"Index Upgrade Tool"},"1303":{"id":"/docs/features/secondary-indexes-38","page_id":"/docs/features/secondary-indexes","type":"heading","tags":["multi-page"],"url":"/docs/features/secondary-indexes#secondary-indexes-resources","content":"Resources"},"1304":{"id":"/docs/features/secondary-indexes-39","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes","content":"Secondary indexes are an orthogonal way to access data from its primary access path. In HBase, you have a single\nindex that is lexicographically sorted on the primary row key. Access to records in any way other than through\nthe primary row requires scanning over potentially all the rows in the table to test them against your filter.\nWith secondary indexing, the columns or expressions you index form an alternate row key to allow point lookups\nand range scans along this new axis."},"1305":{"id":"/docs/features/secondary-indexes-40","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#covered-indexes","content":"Phoenix is particularly powerful in that we provide covered indexes -\nwe do not need to go back to the primary table once we have found the index entry. Instead, we bundle the data\nwe care about right in the index rows, saving read-time overhead."},"1306":{"id":"/docs/features/secondary-indexes-41","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#covered-indexes","content":"For example, the following would create an index on the v1 and v2 columns and\ninclude the v3 column in the index as well to prevent having to get it from the data table:"},"1307":{"id":"/docs/features/secondary-indexes-42","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#functional-indexes","content":"Functional indexes (available in 4.3 and above) allow you to create\nan index not just on columns, but on an arbitrary expressions. Then when a query uses that expression, the index\nmay be used to retrieve the results instead of the data table. For example, you could create an index on UPPER(FIRST_NAME||' '||LAST_NAME)\nto allow you to do case insensitive searches on the combined first name and last name of a person."},"1308":{"id":"/docs/features/secondary-indexes-43","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#functional-indexes","content":"For example, the following would create this functional index:"},"1309":{"id":"/docs/features/secondary-indexes-44","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#functional-indexes","content":"With this index in place, when the following query is issued, the index would be used instead of the data table to retrieve the results:"},"1310":{"id":"/docs/features/secondary-indexes-45","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#functional-indexes","content":"Phoenix supports two types of indexing techniques: global and local indexing.\nEach are useful in different scenarios and have their own failure profiles and performance characteristics."},"1311":{"id":"/docs/features/secondary-indexes-46","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#global-indexes","content":"Global indexing targets read heavy uses cases. With global indexes, all the performance penalties for indexes occur at write time. We intercept the data table updates on write (DELETE, UPSERT VALUES and UPSERT SELECT), build the index update and then sent any necessary updates to all interested index tables. At read time, Phoenix will select the index table to use that will produce the fastest query time and directly scan it just like any other HBase table. An index will not be used for a query that references a column that isn't part of the index."},"1312":{"id":"/docs/features/secondary-indexes-47","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#local-indexes","content":"Local indexing targets write heavy, space constrained use cases. Just like with global indexes, Phoenix will automatically select whether or not to use a local index at query-time. With local indexes, index data and table data co-reside on same server preventing any network overhead during writes. Local indexes can be used even when the query isn't fully covered (i.e. Phoenix automatically retrieve the columns not in the index through point gets against the data table). Unlike global indexes, all local indexes of a table are stored in a single, separate shared table prior to 4.8.0 version. From 4.8.0 onwards we are storing all local index data in the separate shadow column families in the same data table. At read time when the local index is used, every region must be examined for the data as the exact region location of index data cannot be predetermined. Thus some overhead occurs at read-time."},"1313":{"id":"/docs/features/secondary-indexes-48","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#uncovered-indexes","content":"A global index is \"covered\" for a query when every column the query references is in\nthe index — either in the index key or in INCLUDE. Historically a global index that\nwasn't covered for a query simply wasn't used: Phoenix would fall back to a full\ndata-table scan. Uncovered indexes lift that restriction — Phoenix can use a\nglobal index even when the query needs columns that aren't in it, by joining back\nto the data table on the server side to fetch the missing columns\n(PHOENIX-6458)."},"1314":{"id":"/docs/features/secondary-indexes-49","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#uncovered-indexes","content":"Local indexes already worked this way (see Local Indexes above);\nthe new capability is for global indexes."},"1315":{"id":"/docs/features/secondary-indexes-50","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#uncovered-indexes-when","content":"Both an INCLUDE covered index and an uncovered index let the same query use the\nindex. They trade off different costs:"},"1316":{"id":"/docs/features/secondary-indexes-51","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#uncovered-indexes-when","content":"Approach"},"1317":{"id":"/docs/features/secondary-indexes-52","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#uncovered-indexes-when","content":"Index size"},"1318":{"id":"/docs/features/secondary-indexes-53","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#uncovered-indexes-when","content":"Read path"},"1319":{"id":"/docs/features/secondary-indexes-54","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#uncovered-indexes-when","content":"Best when"},"1320":{"id":"/docs/features/secondary-indexes-55","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#uncovered-indexes-when","content":"CREATE INDEX ... INCLUDE (c)"},"1321":{"id":"/docs/features/secondary-indexes-56","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#uncovered-indexes-when","content":"Larger — c is duplicated"},"1322":{"id":"/docs/features/secondary-indexes-57","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#uncovered-indexes-when","content":"Index-only scan"},"1323":{"id":"/docs/features/secondary-indexes-58","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#uncovered-indexes-when","content":"Column c is small, frequently read with the index, and updated rarely"},"1324":{"id":"/docs/features/secondary-indexes-59","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#uncovered-indexes-when","content":"CREATE UNCOVERED INDEX"},"1325":{"id":"/docs/features/secondary-indexes-60","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#uncovered-indexes-when","content":"Smaller — only the key"},"1326":{"id":"/docs/features/secondary-indexes-61","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#uncovered-indexes-when","content":"Index seek + server-side join to data row"},"1327":{"id":"/docs/features/secondary-indexes-62","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#uncovered-indexes-when","content":"Column is large, rarely read with this access path, or updated often"},"1328":{"id":"/docs/features/secondary-indexes-63","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#uncovered-indexes-when","content":"A common pattern is to leave wide payload columns out of the index entirely and\nlet Phoenix fetch them via the join-back when needed. This keeps the index compact\nand write-cheap, at the cost of a per-matching-row data-table read on the rare query\nthat wants the payload."},"1329":{"id":"/docs/features/secondary-indexes-64","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#uncovered-indexes-usage","content":"Declare an uncovered global index with the UNCOVERED keyword in the DDL.\nUNCOVERED is global-only (cannot be combined with LOCAL) and cannot be combined\nwith INCLUDE — the whole point is to skip duplicating columns:"},"1330":{"id":"/docs/features/secondary-indexes-65","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#uncovered-indexes-usage","content":"The planner picks an uncovered index automatically when it's the best plan; no\nhint is required. If you want to force it (e.g. to compare plans), use the\nstandard index hint:"},"1331":{"id":"/docs/features/secondary-indexes-66","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#partial-indexes","content":"A partial index indexes only the rows of the data table that satisfy a SQL\nboolean predicate, supplied at CREATE INDEX time via a WHERE clause. The\nindex is smaller, writes that don't affect the predicate are cheaper, and the\nplanner only uses it for queries whose own predicate implies the index's. Added\nin PHOENIX-7032."},"1332":{"id":"/docs/features/secondary-indexes-67","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#partial-indexes-when","content":"Reach for a partial index when the workload reads a small, well-defined slice of\na much larger table — and that slice is identifiable by a SQL predicate. Common\nshapes:"},"1333":{"id":"/docs/features/secondary-indexes-68","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#partial-indexes-when","content":"Open / active records: WHERE status IN ('OPEN', 'PENDING') on a table that\nalso stores closed records."},"1334":{"id":"/docs/features/secondary-indexes-69","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#partial-indexes-when","content":"Recent rows: WHERE created_at > DATE '2024-01-01'."},"1335":{"id":"/docs/features/secondary-indexes-70","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#partial-indexes-when","content":"Hot tier: WHERE priority >= 5 for paging / alerting workloads."},"1336":{"id":"/docs/features/secondary-indexes-71","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#partial-indexes-when","content":"Failure investigation: WHERE result = 'FAIL' on a successful-most-of-the-time\ntable."},"1337":{"id":"/docs/features/secondary-indexes-72","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#partial-indexes-usage","content":"The DDL is a regular CREATE INDEX with a trailing WHERE clause. Both\ncovered and uncovered global indexes can be partial:"},"1338":{"id":"/docs/features/secondary-indexes-73","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#partial-indexes-usage","content":"The planner uses the index for any query whose WHERE clause implies the\nindex's predicate:"},"1339":{"id":"/docs/features/secondary-indexes-74","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#partial-indexes-mutations","content":"Partial indexes correctly maintain themselves when a mutation moves a row into\nor out of the predicate, including under ON DUPLICATE KEY UPDATE:"},"1340":{"id":"/docs/features/secondary-indexes-75","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#partial-indexes-mutations","content":"A row that starts satisfying the predicate after an update has its index\nrow created."},"1341":{"id":"/docs/features/secondary-indexes-76","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#partial-indexes-mutations","content":"A row that stops satisfying the predicate after an update has its index\nrow removed."},"1342":{"id":"/docs/features/secondary-indexes-77","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#partial-indexes-mutations","content":"This means a partial index stays consistent for a workload like \"close an\norder\" even though that operation flips the row out of the index's covered\nslice."},"1343":{"id":"/docs/features/secondary-indexes-78","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#partial-indexes-limitations","content":"Local partial indexes are not supported — only global (covered or\nuncovered) partial indexes work today."},"1344":{"id":"/docs/features/secondary-indexes-79","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#partial-indexes-limitations","content":"The WHERE predicate is fixed at CREATE INDEX time. To change it, drop and\nrecreate the index."},"1345":{"id":"/docs/features/secondary-indexes-80","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#index-population","content":"By default, when an index is created, it is populated synchronously during the CREATE INDEX call. This may not be feasible depending on the current size of the data table. As of 4.5, initially population of an index may be done asynchronously by including the ASYNC keyword in the index creation DDL statement:"},"1346":{"id":"/docs/features/secondary-indexes-81","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#index-population","content":"The map reduce job that populates the index table must be kicked off separately through the HBase command line like this:"},"1347":{"id":"/docs/features/secondary-indexes-82","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#index-population","content":"Only when the map reduce job is complete will the index be activated and start to be used in queries. The job is resilient to the client being exited. The output-path option is used to specify a HDFS directory that is used for writing HFiles to."},"1348":{"id":"/docs/features/secondary-indexes-83","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#index-population","content":"You can also start index population for all indexes in BUILDING (\"b\") state with the following HBase command line:"},"1349":{"id":"/docs/features/secondary-indexes-84","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#async-index-threshold","content":"As of 4.16 (and 5.1), setting the phoenix.index.async.threshold property to a positive number will disallow synchronous index creation if the estimated indexed data size exceeds phoenix.index.async.threshold (in bytes)."},"1350":{"id":"/docs/features/secondary-indexes-85","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#index-usage","content":"Indexes are automatically used by Phoenix to service a query when it's determined more efficient to do so. However, a global index will not be used unless all of the columns referenced in the query are contained in the index. For example, the following query would not use the index, because v2 is referenced in the query but not included in the index:"},"1351":{"id":"/docs/features/secondary-indexes-86","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#index-usage","content":"There are two means of getting an index to be used in this case:"},"1352":{"id":"/docs/features/secondary-indexes-87","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#index-usage","content":"Create a covered index by including v2 in the index:"},"1353":{"id":"/docs/features/secondary-indexes-88","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#index-usage","content":"This will cause the v2 column value to be copied into the index and kept in synch as it changes. This will obviously increase the size of the index."},"1354":{"id":"/docs/features/secondary-indexes-89","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#index-usage","content":"Create a local index:"},"1355":{"id":"/docs/features/secondary-indexes-90","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#index-usage","content":"Unlike global indexes, local indexes will use an index even when all columns referenced in the query are not contained in the index. This is done by default for local indexes because we know that the table and index data coreside on the same region server thus ensuring the lookup is local."},"1356":{"id":"/docs/features/secondary-indexes-91","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#index-removal","content":"To drop an index, you'd issue the following statement:"},"1357":{"id":"/docs/features/secondary-indexes-92","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#index-removal","content":"If an indexed column is dropped in the data table, the index will automatically be dropped. In addition, if a covered column is dropped in the data table, it will be automatically dropped from the index as well."},"1358":{"id":"/docs/features/secondary-indexes-93","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#index-properties","content":"Just like with the CREATE TABLE statement, the CREATE INDEX statement may pass through properties to apply to the underlying HBase table, including the ability to salt it:"},"1359":{"id":"/docs/features/secondary-indexes-94","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#index-properties","content":"Note that if the primary table is salted, then the index is automatically salted in the same way for global indexes. In addition, the MAX_FILESIZE for the index is adjusted down, relative to the size of the primary versus index table. For more on salting see here. With local indexes, on the other hand, specifying SALT_BUCKETS is not allowed."},"1360":{"id":"/docs/features/secondary-indexes-95","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#consistency-guarantees","content":"On successful return to the client after a commit, all data is guaranteed to be written to all interested indexes and the\nprimary table. In other words, index updates are synchronous with the same strong consistency guarantees provided by HBase."},"1361":{"id":"/docs/features/secondary-indexes-96","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#consistency-guarantees","content":"However, since indexes are stored in separate tables than the data table, depending on the properties of the table and the\ntype of index, the consistency between your table and index varies in the event that a commit fails due to a server-side\ncrash. This is an important design consideration driven by your requirements and use case."},"1362":{"id":"/docs/features/secondary-indexes-97","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#consistency-guarantees","content":"Outlined below are the different options with various levels of consistency guarantees."},"1363":{"id":"/docs/features/secondary-indexes-98","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#local-indexes-1","content":"Since Phoenix 4.8 local indexes are always guaranteed to be consistent."},"1364":{"id":"/docs/features/secondary-indexes-99","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#global-indexes-on-transactional-tables","content":"By declaring your table as transactional, you achieve the highest level of consistency guarantee\nbetween your table and index. In this case, your commit of your table mutations and related index updates are atomic\nwith strong ACID guarantees. If the commit fails, then none of your data (table\nor index) is updated, thus ensuring that your table and index are always in sync."},"1365":{"id":"/docs/features/secondary-indexes-100","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#global-indexes-on-transactional-tables","content":"Why not just always declare your tables as transactional? This may be fine, especially if your\ntable is declared as immutable, since the transactional overhead is very small in this case. However, if your data\nis mutable, make sure that the overhead associated with the conflict detection that occurs with transactional tables\nand the operational overhead of running the transaction manager is acceptable. Additionally, transactional tables\nwith secondary indexes potentially lowers your availability of being able to write to your data table, as both the\ndata table and its secondary index tables must be availalbe as otherwise the write will fail."},"1366":{"id":"/docs/features/secondary-indexes-101","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#global-indexes-on-immutable-tables","content":"For a table in which the data is only written once and never updated in-place, certain optimizations may be made to reduce the write-time overhead for incremental maintenance.\nThis is common with time-series data such as log or event data, where once a row is written, it will never be updated.\nTo take advantage of these optimizations, declare your table as immutable by adding the IMMUTABLE_ROWS=true property to your DDL statement:"},"1367":{"id":"/docs/features/secondary-indexes-102","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#global-indexes-on-immutable-tables","content":"All indexes on a table declared with IMMUTABLE_ROWS=true are considered immutable (note that by default, tables are considered mutable).\nFor global immutable indexes, the index is maintained entirely on the client-side with the index table being generated as changes to the data table occur.\nLocal immutable indexes, on the other hand, are maintained on the server-side.\nNote that no safeguards are in-place to enforce that a table declared as immutable doesn't actually mutate data (as that would negate the performance gain achieved).\nIf that was to occur, the index would no longer be in sync with the table."},"1368":{"id":"/docs/features/secondary-indexes-103","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#global-indexes-on-immutable-tables","content":"If you have an existing table that you'd like to switch from immutable indexing to mutable indexing, use the ALTER TABLE command as show below:"},"1369":{"id":"/docs/features/secondary-indexes-104","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#global-indexes-on-immutable-tables","content":"Global Indexing for Immutable tables has been completely rewritten for version 4.15 (and 5.1)"},"1370":{"id":"/docs/features/secondary-indexes-105","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#immutable-table-indexes-for-415-and-51-and-newer-versions","content":"Immutable index updates go through the same three phase writes as mutable index updates do except that deleting or un-verifying existing index rows is not applicable to immutable indexes.\nThis guarantees that the index tables are always in sync with the data tables."},"1371":{"id":"/docs/features/secondary-indexes-106","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#immutable-table-indexes-for-414-and-50-and-older-versions","content":"Indexes on non transactional, immutable tables have no mechanism in place to automatically deal with a commit failure. Maintaining\nconsistency between the table and index is left to the client to handle. Because the updates are idempotent, the simplest\nsolution is for the client to continue retrying the batch of mutations until they succeed."},"1372":{"id":"/docs/features/secondary-indexes-107","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#global-indexes-on-mutable-tables","content":"Global Indexing for Mutable tables has been completely rewritten for version 4.15 (and 5.1)"},"1373":{"id":"/docs/features/secondary-indexes-108","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#mutable-table-indexes-for-415-and-51-and-newer-versions","content":"The new Strongly Consistent Global Indexing feature uses a three-phase indexing algorithm to guarantee that the index tables are always in sync with the data tables."},"1374":{"id":"/docs/features/secondary-indexes-109","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#mutable-table-indexes-for-415-and-51-and-newer-versions","content":"The implementation uses a shadow column to track the status of index rows:"},"1375":{"id":"/docs/features/secondary-indexes-110","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#mutable-table-indexes-for-415-and-51-and-newer-versions","content":"Write:"},"1376":{"id":"/docs/features/secondary-indexes-111","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#mutable-table-indexes-for-415-and-51-and-newer-versions","content":"Set the status of existing index rows to unverified and write the new index rows with the unverified status"},"1377":{"id":"/docs/features/secondary-indexes-112","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#mutable-table-indexes-for-415-and-51-and-newer-versions","content":"Write the data table rows"},"1378":{"id":"/docs/features/secondary-indexes-113","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#mutable-table-indexes-for-415-and-51-and-newer-versions","content":"Delete the existing index rows and set the status of new rows to verified"},"1379":{"id":"/docs/features/secondary-indexes-114","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#mutable-table-indexes-for-415-and-51-and-newer-versions","content":"Read:"},"1380":{"id":"/docs/features/secondary-indexes-115","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#mutable-table-indexes-for-415-and-51-and-newer-versions","content":"Read the index rows and check their status"},"1381":{"id":"/docs/features/secondary-indexes-116","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#mutable-table-indexes-for-415-and-51-and-newer-versions","content":"The unverified rows are repaired from the data table"},"1382":{"id":"/docs/features/secondary-indexes-117","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#mutable-table-indexes-for-415-and-51-and-newer-versions","content":"Delete:"},"1383":{"id":"/docs/features/secondary-indexes-118","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#mutable-table-indexes-for-415-and-51-and-newer-versions","content":"Set the index table rows with the unverified status"},"1384":{"id":"/docs/features/secondary-indexes-119","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#mutable-table-indexes-for-415-and-51-and-newer-versions","content":"Delete the data table rows"},"1385":{"id":"/docs/features/secondary-indexes-120","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#mutable-table-indexes-for-415-and-51-and-newer-versions","content":"Delete index table rows"},"1386":{"id":"/docs/features/secondary-indexes-121","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#mutable-table-indexes-for-415-and-51-and-newer-versions","content":"See resources for more in-depth information."},"1387":{"id":"/docs/features/secondary-indexes-122","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#mutable-table-indexes-for-415-and-51-and-newer-versions","content":"All newly created tables use the new indexing algorithm."},"1388":{"id":"/docs/features/secondary-indexes-123","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#mutable-table-indexes-for-415-and-51-and-newer-versions","content":"Indexes created with older Phoenix versions will continue to use the old implementation, until upgraded with IndexUpgradeTool"},"1389":{"id":"/docs/features/secondary-indexes-124","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#mutable-table-indexes-for-414-and-50-and-older-versions","content":"For non transactional mutable tables, we maintain index update durability by adding the index updates to the Write-Ahead-Log (WAL) entry of the primary table row.\nOnly after the WAL entry is successfully synced to disk do we attempt to make the index/primary table updates. We write the\nindex updates in parallel by default, leading to very high throughput. If the server crashes while we are writing the index\nupdates, we replay the all the index updates to the index tables in the WAL recovery process and rely on the idempotence of\nthe updates to ensure correctness. Therefore, indexes on non transactional mutable tables are only ever a single batch of\nedits behind the primary table."},"1390":{"id":"/docs/features/secondary-indexes-125","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#mutable-table-indexes-for-414-and-50-and-older-versions","content":"It's important to note several points:"},"1391":{"id":"/docs/features/secondary-indexes-126","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#mutable-table-indexes-for-414-and-50-and-older-versions","content":"For non transactional tables, you could see the index table out of sync with the primary table."},"1392":{"id":"/docs/features/secondary-indexes-127","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#mutable-table-indexes-for-414-and-50-and-older-versions","content":"As noted above, this is ok as we are only a very small bit behind and out of sync for very short periods"},"1393":{"id":"/docs/features/secondary-indexes-128","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#mutable-table-indexes-for-414-and-50-and-older-versions","content":"Each data row and its index row(s) are guaranteed to to be written or lost - we never see partial updates as this is part of the atomicity guarantees of HBase."},"1394":{"id":"/docs/features/secondary-indexes-129","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#mutable-table-indexes-for-414-and-50-and-older-versions","content":"Data is first written to the table followed by the index tables (the reverse is true if the WAL is disabled)."},"1395":{"id":"/docs/features/secondary-indexes-130","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#mutable-table-indexes-for-414-and-50-and-older-versions","content":"Singular Write Path"},"1396":{"id":"/docs/features/secondary-indexes-131","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#mutable-table-indexes-for-414-and-50-and-older-versions","content":"There is a single write path that guarantees the failure properties. All writes to the HRegion get intercepted by our\ncoprocessor. We then build the index updates based on the pending update (or updates, in the case of the batch).\nThese update are then appended to the WAL entry for the original update."},"1397":{"id":"/docs/features/secondary-indexes-132","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#mutable-table-indexes-for-414-and-50-and-older-versions","content":"If we get any failure up to this point, we return the failure to the client and no data is persisted or made visible\nto the client."},"1398":{"id":"/docs/features/secondary-indexes-133","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#mutable-table-indexes-for-414-and-50-and-older-versions","content":"Once the WAL is written, we ensure that the index and primary table data will become visible, even in the case of a failure."},"1399":{"id":"/docs/features/secondary-indexes-134","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#mutable-table-indexes-for-414-and-50-and-older-versions","content":"If the server does crash, we then replay the index updates with the usual WAL replay mechanism"},"1400":{"id":"/docs/features/secondary-indexes-135","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#mutable-table-indexes-for-414-and-50-and-older-versions","content":"If the server does not crash, we just insert the index updates to their respective tables."},"1401":{"id":"/docs/features/secondary-indexes-136","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#mutable-table-indexes-for-414-and-50-and-older-versions","content":"If the index updates fail, the various means of maintaining consistency are outlined below."},"1402":{"id":"/docs/features/secondary-indexes-137","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#mutable-table-indexes-for-414-and-50-and-older-versions","content":"If the Phoenix system catalog table cannot be reached when a failure occurs, we force the server to be immediately aborted and failing this, call System.exit on the JVM, forcing the server to die. By killing the server, we ensure that the WAL will be replayed on recovery, replaying the index updates to their appropriate tables. This ensures that a secondary index is not continued to be used when it's in a know, invalid state."},"1403":{"id":"/docs/features/secondary-indexes-138","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#mutable-table-indexes-for-414-and-50-and-older-versions","content":"Disallow table writes until mutable index is consistent"},"1404":{"id":"/docs/features/secondary-indexes-139","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#mutable-table-indexes-for-414-and-50-and-older-versions","content":"The highest level of maintaining consistency between your non transactional table and index is to declare that writes to the\ndata table should be temporarily disallowed in the event of a failure to update the index. In this consistency\nmode, the table and index will be held at the timestamp before the failure occurred, with writes to the data\ntable being disallowed until the index is back online and in-sync with the data table. The index will\nremain active and continue to be used by queries as usual."},"1405":{"id":"/docs/features/secondary-indexes-140","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#mutable-table-indexes-for-414-and-50-and-older-versions","content":"The following server-side configurations control this behavior:"},"1406":{"id":"/docs/features/secondary-indexes-141","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#mutable-table-indexes-for-414-and-50-and-older-versions","content":"phoenix.index.failure.block.write must be true to enable a writes to the data table to fail\nin the event of a commit failure until the index can be caught up with the data table."},"1407":{"id":"/docs/features/secondary-indexes-142","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#mutable-table-indexes-for-414-and-50-and-older-versions","content":"phoenix.index.failure.handling.rebuild must be true (the default) to enable a mutable index to\nbe rebuilt in the background in the event of a commit failure."},"1408":{"id":"/docs/features/secondary-indexes-143","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#mutable-table-indexes-for-414-and-50-and-older-versions","content":"Disable mutable indexes on write failure until consistency restored"},"1409":{"id":"/docs/features/secondary-indexes-144","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#mutable-table-indexes-for-414-and-50-and-older-versions","content":"The default behavior with mutable indexes is to mark the index as disabled if a write to them fails at commit time,\npartially rebuild them in the background, and then mark them as active again once consistency is restored. In this\nconsistency mode, writes to the data table will not be blocked while the secondary index is being rebuilt. However,\nthe secondary index will not be used by queries while the rebuild is happening."},"1410":{"id":"/docs/features/secondary-indexes-145","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#mutable-table-indexes-for-414-and-50-and-older-versions","content":"The following server-side configurations control this behavior:"},"1411":{"id":"/docs/features/secondary-indexes-146","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#mutable-table-indexes-for-414-and-50-and-older-versions","content":"phoenix.index.failure.handling.rebuild must be true (the default) to enable a mutable index to\nbe rebuilt in the background in the event of a commit failure."},"1412":{"id":"/docs/features/secondary-indexes-147","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#mutable-table-indexes-for-414-and-50-and-older-versions","content":"phoenix.index.failure.handling.rebuild.interval controls the millisecond frequency at which the server\nchecks whether or not a mutable index needs to be partially rebuilt to catch up with updates to the data\ntable. The default is 10000 or 10 seconds."},"1413":{"id":"/docs/features/secondary-indexes-148","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#mutable-table-indexes-for-414-and-50-and-older-versions","content":"phoenix.index.failure.handling.rebuild.overlap.time controls how many milliseconds to go back from the timestamp\nat which the failure occurred to go back when a partial rebuild is performed. The default is 1."},"1414":{"id":"/docs/features/secondary-indexes-149","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#mutable-table-indexes-for-414-and-50-and-older-versions","content":"Disable mutable index on write failure with manual rebuild required"},"1415":{"id":"/docs/features/secondary-indexes-150","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#mutable-table-indexes-for-414-and-50-and-older-versions","content":"This is the lowest level of consistency for mutable secondary indexes. In this case, when a write to a secondary\nindex fails, the index will be marked as disabled with a manual\nrebuild of the index required to enable it to be used\nonce again by queries."},"1416":{"id":"/docs/features/secondary-indexes-151","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#mutable-table-indexes-for-414-and-50-and-older-versions","content":"The following server-side configurations control this behavior:"},"1417":{"id":"/docs/features/secondary-indexes-152","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#mutable-table-indexes-for-414-and-50-and-older-versions","content":"phoenix.index.failure.handling.rebuild must be set to false to disable a mutable index from being\nrebuilt in the background in the event of a commit failure."},"1418":{"id":"/docs/features/secondary-indexes-153","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#bulkload-tool-limitation","content":"The BulkLoadTools (e.g. CSVBulkLoadTool and JSONBulkLoadTool) cannot presently generate correct updates to mutable\nsecondary indexes when pre-existing records are being updated. In the normal mutable secondary index write path, we can\nsafely calculate a Delete (for the old record) and a Put (for the new record) for each secondary index while holding a\nrow-lock to prevent concurrent updates. In the context of a MapReduce job, we cannot effectively execute this same logic\nbecause we are specifically doing this \"out of band\" from the HBase RegionServers. As such, while these Tools generate\nHFiles for the index tables with the proper updates for the data being loaded, any previous index records corresponding\nto the same record in the table are not deleted. This net-effect of this limitation is: if you use these Tools to re-ingest\nthe same records to an index table, that index table will have duplicate records in it which will result in incorrect\nquery results from that index table."},"1419":{"id":"/docs/features/secondary-indexes-154","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#bulkload-tool-limitation","content":"To perform incremental loads of data using the BulkLoadTools which may update existing records, you must\ndrop and re-create all index tables after the data table is loaded. Re-creating the index with the ASYNC option and\nusing IndexTool to populate and enable that index is likely a must for tables of non-trivial size."},"1420":{"id":"/docs/features/secondary-indexes-155","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#bulkload-tool-limitation","content":"To perform incremental loading of CSV datasets that do not require any manual index intervention, the psql tool can\nbe used in place of the BulkLoadTools. Additionally, a MapReduce job could be written to parse CSV/JSON data and write\nit directly to Phoenix; although, such a tool is not currently provided by Phoenix for users."},"1421":{"id":"/docs/features/secondary-indexes-156","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#setup","content":"Non transactional, mutable indexing requires special configuration options on the region server and master to run - Phoenix ensures that they are setup correctly when you enable mutable indexing on the table; if the correct properties are not set, you will not be able to use secondary indexing. After adding these settings to your hbase-site.xml, you'll need to do a rolling restart of your cluster."},"1422":{"id":"/docs/features/secondary-indexes-157","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#setup","content":"As Phoenix matures, it needs less and less manual configuration. For older Phoenix versions you'll need to add the properties listed for that version, as well as the properties listed for the later versions."},"1423":{"id":"/docs/features/secondary-indexes-158","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#for-phoenix-412-and-later","content":"You will need to add the following parameters to hbase-site.xml on each region server:"},"1424":{"id":"/docs/features/secondary-indexes-159","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#for-phoenix-412-and-later","content":"The above property enables custom WAL edits to be written, ensuring proper writing/replay of the index updates. This codec supports the usual host of WALEdit options, most notably WALEdit compression."},"1425":{"id":"/docs/features/secondary-indexes-160","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#for-phoenix-48---411","content":"The following configuration changes are also required to the server-side hbase-site.xml on the master and regions server nodes:"},"1426":{"id":"/docs/features/secondary-indexes-161","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#for-phoenix-48---411","content":"The above properties prevent deadlocks from occurring during index maintenance for global indexes (HBase 0.98.4+ and Phoenix 4.3.1+) by ensuring index updates are processed with a higher priority than data updates. It also prevents deadlocks by ensuring metadata rpc calls are processed with a higher priority than data rpc calls."},"1427":{"id":"/docs/features/secondary-indexes-162","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#for-phoenix-versions-47-and-below","content":"The following configuration changes are also required to the server-side hbase-site.xml on the master and regions server nodes:"},"1428":{"id":"/docs/features/secondary-indexes-163","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#for-phoenix-versions-47-and-below","content":"The above properties are required to use local indexing."},"1429":{"id":"/docs/features/secondary-indexes-164","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#upgrading-local-indexes-created-before-480","content":"While upgrading the Phoenix to 4.8.0+ version at server remove above three local indexing related configurations from hbase-site.xml if present. From client we are supporting both online(while initializing the connection from phoenix client of 4.8.0+ versions) and offline(using psql tool) upgrade of local indexes created before 4.8.0. As part of upgrade we recreate the local indexes in ASYNC mode. After upgrade user need to build the indexes using IndexTool"},"1430":{"id":"/docs/features/secondary-indexes-165","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#upgrading-local-indexes-created-before-480","content":"Following client side configuration used in the upgrade."},"1431":{"id":"/docs/features/secondary-indexes-166","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#upgrading-local-indexes-created-before-480","content":"phoenix.client.localIndexUpgradeThe value of it is true means online upgrade and false means offline upgrade.Default: true"},"1432":{"id":"/docs/features/secondary-indexes-167","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#upgrading-local-indexes-created-before-480","content":"Command to run offline upgrade using psql:"},"1433":{"id":"/docs/features/secondary-indexes-168","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#secondary-indexes-tuning","content":"Out the box, indexing is pretty fast. However, to optimize for your particular environment and workload, there are several properties you can tune."},"1434":{"id":"/docs/features/secondary-indexes-169","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#secondary-indexes-tuning","content":"All the following parameters must be set in hbase-site.xml - they are true for the entire cluster and all index tables, as well as across all regions on the same server (so, for instance, a single server would not write to too many different index tables at once)."},"1435":{"id":"/docs/features/secondary-indexes-170","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#secondary-indexes-tuning","content":"index.builder.threads.max"},"1436":{"id":"/docs/features/secondary-indexes-171","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#secondary-indexes-tuning","content":"Number of threads to used to build the index update from the primary table update"},"1437":{"id":"/docs/features/secondary-indexes-172","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#secondary-indexes-tuning","content":"Increasing this value overcomes the bottleneck of reading the current row state from the underlying HRegion. Tuning this value too high will just bottleneck at the HRegion as it will not be able to handle too many concurrent scan requests as well as general thread-swapping concerns."},"1438":{"id":"/docs/features/secondary-indexes-173","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#secondary-indexes-tuning","content":"Default: 10"},"1439":{"id":"/docs/features/secondary-indexes-174","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#secondary-indexes-tuning","content":"index.builder.threads.keepalivetime"},"1440":{"id":"/docs/features/secondary-indexes-175","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#secondary-indexes-tuning","content":"Amount of time in seconds after we expire threads in the builder thread pool."},"1441":{"id":"/docs/features/secondary-indexes-176","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#secondary-indexes-tuning","content":"Unused threads are immediately released after this amount of time and not core threads are retained (though this last is a small concern as tables are expected to sustain a fairly constant write load), but simultaneously allows us to drop threads if we are not seeing the expected load."},"1442":{"id":"/docs/features/secondary-indexes-177","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#secondary-indexes-tuning","content":"Default: 60"},"1443":{"id":"/docs/features/secondary-indexes-178","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#secondary-indexes-tuning","content":"index.writer.threads.max"},"1444":{"id":"/docs/features/secondary-indexes-179","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#secondary-indexes-tuning","content":"Number of threads to use when writing to the target index tables."},"1445":{"id":"/docs/features/secondary-indexes-180","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#secondary-indexes-tuning","content":"The first level of parallelization, on a per-table basis - it should roughly correspond to the number of index tables"},"1446":{"id":"/docs/features/secondary-indexes-181","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#secondary-indexes-tuning","content":"Default: 10"},"1447":{"id":"/docs/features/secondary-indexes-182","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#secondary-indexes-tuning","content":"index.writer.threads.keepalivetime"},"1448":{"id":"/docs/features/secondary-indexes-183","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#secondary-indexes-tuning","content":"Amount of time in seconds after we expire threads in the writer thread pool."},"1449":{"id":"/docs/features/secondary-indexes-184","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#secondary-indexes-tuning","content":"Unused threads are immediately released after this amount of time and not core threads are retained (though this last is a small concern as tables are expected to sustain a fairly constant write load), but simultaneously allows us to drop threads if we are not seeing the expected load."},"1450":{"id":"/docs/features/secondary-indexes-185","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#secondary-indexes-tuning","content":"Default: 60"},"1451":{"id":"/docs/features/secondary-indexes-186","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#secondary-indexes-tuning","content":"hbase.htable.threads.max"},"1452":{"id":"/docs/features/secondary-indexes-187","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#secondary-indexes-tuning","content":"Number of threads each index HTable can use for writes."},"1453":{"id":"/docs/features/secondary-indexes-188","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#secondary-indexes-tuning","content":"Increasing this allows more concurrent index updates (for instance across batches), leading to high overall throughput."},"1454":{"id":"/docs/features/secondary-indexes-189","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#secondary-indexes-tuning","content":"Default: 2,147,483,647"},"1455":{"id":"/docs/features/secondary-indexes-190","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#secondary-indexes-tuning","content":"hbase.htable.threads.keepalivetime"},"1456":{"id":"/docs/features/secondary-indexes-191","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#secondary-indexes-tuning","content":"Amount of time in seconds after we expire threads in the HTable's thread pool."},"1457":{"id":"/docs/features/secondary-indexes-192","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#secondary-indexes-tuning","content":"Using the \"direct handoff\" approach, new threads will only be created if it is necessary and will grow unbounded. This could be bad but HTables only create as many Runnables as there are region servers; therefore, it also scales when new region servers are added."},"1458":{"id":"/docs/features/secondary-indexes-193","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#secondary-indexes-tuning","content":"Default: 60"},"1459":{"id":"/docs/features/secondary-indexes-194","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#secondary-indexes-tuning","content":"index.tablefactory.cache.size"},"1460":{"id":"/docs/features/secondary-indexes-195","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#secondary-indexes-tuning","content":"Number of index HTables we should keep in cache."},"1461":{"id":"/docs/features/secondary-indexes-196","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#secondary-indexes-tuning","content":"Increasing this number ensures that we do not need to recreate an HTable for each attempt to write to an index table. Conversely, you could see memory pressure if this value is set too high."},"1462":{"id":"/docs/features/secondary-indexes-197","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#secondary-indexes-tuning","content":"Default: 10"},"1463":{"id":"/docs/features/secondary-indexes-198","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#secondary-indexes-tuning","content":"org.apache.phoenix.regionserver.index.priority.min"},"1464":{"id":"/docs/features/secondary-indexes-199","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#secondary-indexes-tuning","content":"Value to specify to bottom (inclusive) of the range in which index priority may lie."},"1465":{"id":"/docs/features/secondary-indexes-200","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#secondary-indexes-tuning","content":"Default: 1000"},"1466":{"id":"/docs/features/secondary-indexes-201","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#secondary-indexes-tuning","content":"org.apache.phoenix.regionserver.index.priority.max"},"1467":{"id":"/docs/features/secondary-indexes-202","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#secondary-indexes-tuning","content":"Value to specify to top (exclusive) of the range in which index priority may lie."},"1468":{"id":"/docs/features/secondary-indexes-203","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#secondary-indexes-tuning","content":"Higher priorites within the index min/max range do not means updates are processed sooner."},"1469":{"id":"/docs/features/secondary-indexes-204","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#secondary-indexes-tuning","content":"Default: 1050"},"1470":{"id":"/docs/features/secondary-indexes-205","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#secondary-indexes-tuning","content":"org.apache.phoenix.regionserver.index.handler.count"},"1471":{"id":"/docs/features/secondary-indexes-206","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#secondary-indexes-tuning","content":"Number of threads to use when serving index write requests for global index maintenance."},"1472":{"id":"/docs/features/secondary-indexes-207","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#secondary-indexes-tuning","content":"Though the actual number of threads is dictated by the Max(number of call queues, handler count), where the number of call queues is determined by standard HBase configuration. To further tune the queues, you can adjust the standard rpc queue length parameters (currently, there are no special knobs for the index queues), specifically ipc.server.max.callqueue.length and ipc.server.callqueue.handler.factor. See the HBase Reference Guide for more details."},"1473":{"id":"/docs/features/secondary-indexes-208","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#secondary-indexes-tuning","content":"Default: 30"},"1474":{"id":"/docs/features/secondary-indexes-209","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#secondary-indexes-performance","content":"We track secondary index performance via our performance framework. This is a generic test of performance based on defaults - your results will vary based on hardware specs as well as you individual configuration."},"1475":{"id":"/docs/features/secondary-indexes-210","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#secondary-indexes-performance","content":"That said, we have seen secondary indexing (both immutable and mutable) go as quickly as < 2x the regular write path on a small, (3 node) desktop-based cluster. This is actually pretty reasonable as we have to write to multiple tables as well as build the index update."},"1476":{"id":"/docs/features/secondary-indexes-211","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#index-scrutiny-tool","content":"With Phoenix 4.12, there is now a tool to run a MapReduce job to verify that an index table is valid against its data table. The only way to find orphaned rows in either table is to scan over all rows in the table and do a lookup in the other table for the corresponding row. For that reason, the tool can run with either the data or index table as the \"source\" table, and the other as the \"target\" table. The tool writes all invalid rows it finds either to file or to an output table PHOENIX_INDEX_SCRUTINY. An invalid row is a source row that either has no corresponding row in the target table, or has an incorrect value in the target table (i.e. covered column value)."},"1477":{"id":"/docs/features/secondary-indexes-212","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#index-scrutiny-tool","content":"The tool has job counters that track its status. VALID_ROW_COUNT, INVALID_ROW_COUNT, BAD_COVERED_COL_VAL_COUNT. Note that invalid rows - bad col val rows = number of orphaned rows. These counters are written to the table PHOENIX_INDEX_SCRUTINY_METADATA, along with other job metadata."},"1478":{"id":"/docs/features/secondary-indexes-213","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#index-scrutiny-tool","content":"The Index Scrutiny Tool can be launched via the hbase command (in hbase/bin) as follows:"},"1479":{"id":"/docs/features/secondary-indexes-214","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#index-scrutiny-tool","content":"It can also be run from Hadoop using either the phoenix-core or phoenix-server jar as follows:"},"1480":{"id":"/docs/features/secondary-indexes-215","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#index-scrutiny-tool","content":"By default two mapreduce jobs are launched, one with the data table as the source table and one with the index table as the source table."},"1481":{"id":"/docs/features/secondary-indexes-216","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#index-scrutiny-tool","content":"The following parameters can be used with the Index Scrutiny Tool:"},"1482":{"id":"/docs/features/secondary-indexes-217","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#index-scrutiny-tool","content":"Parameter"},"1483":{"id":"/docs/features/secondary-indexes-218","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#index-scrutiny-tool","content":"Description"},"1484":{"id":"/docs/features/secondary-indexes-219","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#index-scrutiny-tool","content":"-dt,--data-table"},"1485":{"id":"/docs/features/secondary-indexes-220","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#index-scrutiny-tool","content":"Data table name (mandatory)"},"1486":{"id":"/docs/features/secondary-indexes-221","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#index-scrutiny-tool","content":"-it,--index-table"},"1487":{"id":"/docs/features/secondary-indexes-222","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#index-scrutiny-tool","content":"Index table name (mandatory)"},"1488":{"id":"/docs/features/secondary-indexes-223","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#index-scrutiny-tool","content":"-s,--schema"},"1489":{"id":"/docs/features/secondary-indexes-224","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#index-scrutiny-tool","content":"Phoenix schema name (optional)"},"1490":{"id":"/docs/features/secondary-indexes-225","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#index-scrutiny-tool","content":"-src,--source"},"1491":{"id":"/docs/features/secondary-indexes-226","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#index-scrutiny-tool","content":"DATA_TABLE_SOURCE, INDEX_TABLE_SOURCE, or BOTH. Defaults to BOTH"},"1492":{"id":"/docs/features/secondary-indexes-227","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#index-scrutiny-tool","content":"-o,--output"},"1493":{"id":"/docs/features/secondary-indexes-228","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#index-scrutiny-tool","content":"Whether to output invalid rows. Off by default"},"1494":{"id":"/docs/features/secondary-indexes-229","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#index-scrutiny-tool","content":"-of,--output-format"},"1495":{"id":"/docs/features/secondary-indexes-230","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#index-scrutiny-tool","content":"TABLE or FILE output format. Defaults to TABLE"},"1496":{"id":"/docs/features/secondary-indexes-231","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#index-scrutiny-tool","content":"-om,--output-max"},"1497":{"id":"/docs/features/secondary-indexes-232","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#index-scrutiny-tool","content":"Maximum number of invalid rows to output per mapper. Defaults to 1M"},"1498":{"id":"/docs/features/secondary-indexes-233","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#index-scrutiny-tool","content":"-op,--output-path"},"1499":{"id":"/docs/features/secondary-indexes-234","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#index-scrutiny-tool","content":"For FILE output format, the HDFS directory where files are written"},"1500":{"id":"/docs/features/secondary-indexes-235","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#index-scrutiny-tool","content":"-t,--time"},"1501":{"id":"/docs/features/secondary-indexes-236","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#index-scrutiny-tool","content":"Timestamp in millis at which to run the scrutiny. This is important so that incoming writes don't throw off the scrutiny. Defaults to current time minus 60 seconds"},"1502":{"id":"/docs/features/secondary-indexes-237","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#index-scrutiny-tool","content":"-b,--batch-size"},"1503":{"id":"/docs/features/secondary-indexes-238","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#index-scrutiny-tool","content":"Number of rows to compare at a time"},"1504":{"id":"/docs/features/secondary-indexes-239","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#secondary-indexes-limitations","content":"If rows are actively being updated or deleted while the scrutiny is running, the tool may give you false positives for inconsistencies (PHOENIX-4277)."},"1505":{"id":"/docs/features/secondary-indexes-240","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#secondary-indexes-limitations","content":"Snapshot reads are not supported by the scrutiny tool (PHOENIX-4270)."},"1506":{"id":"/docs/features/secondary-indexes-241","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#index-upgrade-tool","content":"IndexUpgradeTool updates global indexes created by Phoenix 4.14 and earlier (or 5.0) to use the new Strongly Consistent Global Indexes implementation."},"1507":{"id":"/docs/features/secondary-indexes-242","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#index-upgrade-tool","content":"It accepts following parameters:"},"1508":{"id":"/docs/features/secondary-indexes-243","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#index-upgrade-tool","content":"Parameter"},"1509":{"id":"/docs/features/secondary-indexes-244","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#index-upgrade-tool","content":"Description"},"1510":{"id":"/docs/features/secondary-indexes-245","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#index-upgrade-tool","content":"only in version"},"1511":{"id":"/docs/features/secondary-indexes-246","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#index-upgrade-tool","content":"-o,--operation"},"1512":{"id":"/docs/features/secondary-indexes-247","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#index-upgrade-tool","content":"upgrade or rollback (mandatory)"},"1513":{"id":"/docs/features/secondary-indexes-248","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#index-upgrade-tool","content":"-tb,--tables"},"1514":{"id":"/docs/features/secondary-indexes-249","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#index-upgrade-tool","content":"[table1,table2,table3] (-tb or -f mandatory)"},"1515":{"id":"/docs/features/secondary-indexes-250","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#index-upgrade-tool","content":"-f,--file"},"1516":{"id":"/docs/features/secondary-indexes-251","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#index-upgrade-tool","content":"Csv file with above format (-tb or -f mandatory)"},"1517":{"id":"/docs/features/secondary-indexes-252","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#index-upgrade-tool","content":"-d,--dry-run"},"1518":{"id":"/docs/features/secondary-indexes-253","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#index-upgrade-tool","content":"If passed this will just output steps that will be executed; like a dry run"},"1519":{"id":"/docs/features/secondary-indexes-254","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#index-upgrade-tool","content":"-h,--help"},"1520":{"id":"/docs/features/secondary-indexes-255","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#index-upgrade-tool","content":"Help on how to use the tool"},"1521":{"id":"/docs/features/secondary-indexes-256","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#index-upgrade-tool","content":"-lf,--logfile"},"1522":{"id":"/docs/features/secondary-indexes-257","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#index-upgrade-tool","content":"File location to dump the logs"},"1523":{"id":"/docs/features/secondary-indexes-258","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#index-upgrade-tool","content":"-sr,--index-sync-rebuild"},"1524":{"id":"/docs/features/secondary-indexes-259","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#index-upgrade-tool","content":"whether or not synchronously rebuild the indexes; default rebuild asynchronous"},"1525":{"id":"/docs/features/secondary-indexes-260","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#index-upgrade-tool","content":"4.15"},"1526":{"id":"/docs/features/secondary-indexes-261","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#index-upgrade-tool","content":"-rb,--index-rebuild"},"1527":{"id":"/docs/features/secondary-indexes-262","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#index-upgrade-tool","content":"Rebuild the indexes. Set -tool to pass options to IndexTool"},"1528":{"id":"/docs/features/secondary-indexes-263","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#index-upgrade-tool","content":"4.16+, 5.1+"},"1529":{"id":"/docs/features/secondary-indexes-264","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#index-upgrade-tool","content":"-tool,--index-tool"},"1530":{"id":"/docs/features/secondary-indexes-265","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#index-upgrade-tool","content":"Options to pass to indexTool when rebuilding indexes"},"1531":{"id":"/docs/features/secondary-indexes-266","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#index-upgrade-tool","content":"4.16+, 5.1+"},"1532":{"id":"/docs/features/secondary-indexes-267","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#index-upgrade-tool","content":"For 4.16+/5.1+ either specifying the -rb option, or manually rebuilding the indexes with IndexTool after the upgrade is recommended, otherwise the first access of every index row will trigger an index row repair."},"1533":{"id":"/docs/features/secondary-indexes-268","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#index-upgrade-tool","content":"Depending on whether index is mutable, it will remove Indexer coprocessor from a data table and load new coprocessor IndexRegionObserver. For both immutable and mutable, it will load GlobalIndexChecker coprocessor on Index table. During this process, data table and index table are disabled-loaded/unloaded with coproc-enabled within short time span. At the end, it does an asynchronous index rebuilds. Index reads are not blocked while index-rebuild is still ongoing, however, they may be a bit slower for rows written prior to upgrade."},"1534":{"id":"/docs/features/secondary-indexes-269","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#index-upgrade-tool","content":"IndexUpgradeTool doesn't make any distinction between view-index and table-index. When a table is passed, it will perform the upgrade-operation on all the 'children' indexes of the given table."},"1535":{"id":"/docs/features/secondary-indexes-270","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#secondary-indexes-resources","content":"There have been several presentations given on how secondary indexing works in Phoenix that have a more in-depth look at how indexing works (with pretty pictures!):"},"1536":{"id":"/docs/features/secondary-indexes-271","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#secondary-indexes-resources","content":"Slides for Strongly Consistent Global Indexes for Apache Phoenix, 2019 Distributed SQL Summit"},"1537":{"id":"/docs/features/secondary-indexes-272","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#secondary-indexes-resources","content":"Recording of Strongly Consistent Global Indexes for Apache Phoenix, 2019 Distributed SQL Summit"},"1538":{"id":"/docs/features/secondary-indexes-273","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#secondary-indexes-resources","content":"Slides for Local Secondary Indexes in Apache Phoenix, 2017 PhoenixCon"},"1539":{"id":"/docs/features/secondary-indexes-274","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#secondary-indexes-resources","content":"These older resources refer to obsolete implementations in some cases"},"1540":{"id":"/docs/features/secondary-indexes-275","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#secondary-indexes-resources","content":"Los Anglees HBase Meetup - Sept, 4th, 2013"},"1541":{"id":"/docs/features/secondary-indexes-276","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#secondary-indexes-resources","content":"Local Indexes by Huawei"},"1542":{"id":"/docs/features/secondary-indexes-277","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#secondary-indexes-resources","content":"PHOENIX-938 and HBASE-11513 for deadlock prevention during global index maintenance."},"1543":{"id":"/docs/features/secondary-indexes-278","page_id":"/docs/features/secondary-indexes","tags":["multi-page"],"type":"text","url":"/docs/features/secondary-indexes#secondary-indexes-resources","content":"PHOENIX-1112: Atomically rebuild index partially when index update fails"},"1544":{"id":"/docs/features/segment-scan","page_id":"/docs/features/segment-scan","type":"page","content":"Segment Scan","breadcrumbs":["Docs","Multi-Page Documentation","Development","Features"],"tags":["multi-page"],"url":"/docs/features/segment-scan"},"1545":{"id":"/docs/features/segment-scan-0","page_id":"/docs/features/segment-scan","tags":["multi-page"],"type":"text","url":"/docs/features/segment-scan","content":"Get N evenly-bucketed key ranges for a Phoenix table so a client can drive a parallel full-table scan."},"1546":{"id":"/docs/features/segment-scan-1","page_id":"/docs/features/segment-scan","type":"heading","tags":["multi-page"],"url":"/docs/features/segment-scan#segment-scan-when","content":"When to use it"},"1547":{"id":"/docs/features/segment-scan-2","page_id":"/docs/features/segment-scan","type":"heading","tags":["multi-page"],"url":"/docs/features/segment-scan#segment-scan-usage","content":"Basic usage"},"1548":{"id":"/docs/features/segment-scan-3","page_id":"/docs/features/segment-scan","type":"heading","tags":["multi-page"],"url":"/docs/features/segment-scan#segment-scan-count","content":"How many segments you actually get"},"1549":{"id":"/docs/features/segment-scan-4","page_id":"/docs/features/segment-scan","type":"heading","tags":["multi-page"],"url":"/docs/features/segment-scan#segment-scan-how","content":"How it actually runs"},"1550":{"id":"/docs/features/segment-scan-5","page_id":"/docs/features/segment-scan","type":"heading","tags":["multi-page"],"url":"/docs/features/segment-scan#segment-scan-watch","content":"Things to watch for"},"1551":{"id":"/docs/features/segment-scan-6","page_id":"/docs/features/segment-scan","tags":["multi-page"],"type":"text","url":"/docs/features/segment-scan","content":"Segment Scan turns a Phoenix table into N contiguous, non-overlapping key ranges\nthat you can hand out to a pool of workers to drive a parallel full-table scan. It is\nthe natural primitive for ETL exports, table validation/repair tools, bulk\nre-encoding, and anything else that needs to walk every row as fast as the cluster\ncan serve it. Available in Phoenix 5.3.0\n(PHOENIX-7684)."},"1552":{"id":"/docs/features/segment-scan-7","page_id":"/docs/features/segment-scan","tags":["multi-page"],"type":"text","url":"/docs/features/segment-scan#segment-scan-when","content":"Reach for Segment Scan when you want to read every row and you'd rather have many\nworkers do it concurrently than one client streaming sequentially. Typical use cases:"},"1553":{"id":"/docs/features/segment-scan-8","page_id":"/docs/features/segment-scan","tags":["multi-page"],"type":"text","url":"/docs/features/segment-scan#segment-scan-when","content":"Snapshot exports to a data lake / warehouse."},"1554":{"id":"/docs/features/segment-scan-9","page_id":"/docs/features/segment-scan","tags":["multi-page"],"type":"text","url":"/docs/features/segment-scan#segment-scan-when","content":"Backfills or re-encodes (e.g. moving a column from VARBINARY to\nVARBINARY_ENCODED)."},"1555":{"id":"/docs/features/segment-scan-10","page_id":"/docs/features/segment-scan","tags":["multi-page"],"type":"text","url":"/docs/features/segment-scan#segment-scan-when","content":"Validation/repair scripts that scrub or hash every row."},"1556":{"id":"/docs/features/segment-scan-11","page_id":"/docs/features/segment-scan","tags":["multi-page"],"type":"text","url":"/docs/features/segment-scan#segment-scan-when","content":"DynamoDB-style parallel scan against a Phoenix-backed table."},"1557":{"id":"/docs/features/segment-scan-12","page_id":"/docs/features/segment-scan","tags":["multi-page"],"type":"text","url":"/docs/features/segment-scan#segment-scan-when","content":"If you only want to read some rows (e.g. by a key prefix or an indexed predicate),\nissue a normal SQL query — Segment Scan is for full-table fan-out, not selective\nfiltering."},"1558":{"id":"/docs/features/segment-scan-13","page_id":"/docs/features/segment-scan","tags":["multi-page"],"type":"text","url":"/docs/features/segment-scan#segment-scan-usage","content":"TOTAL_SEGMENTS() = N in the WHERE clause asks Phoenix to return N segment\nboundaries instead of running the query against the data. The boundaries are\nprojected via the SCAN_START_KEY() and SCAN_END_KEY() functions:"},"1559":{"id":"/docs/features/segment-scan-14","page_id":"/docs/features/segment-scan","tags":["multi-page"],"type":"text","url":"/docs/features/segment-scan#segment-scan-usage","content":"You get back one row per segment with two VARBINARY columns: the start key and\nthe end key of that range, as raw HBase row-key bytes. Either may be empty — an\nempty start key means \"from the beginning of the table\"; an empty end key means\n\"to the end of the table\"."},"1560":{"id":"/docs/features/segment-scan-15","page_id":"/docs/features/segment-scan","tags":["multi-page"],"type":"text","url":"/docs/features/segment-scan#segment-scan-usage","content":"To scan a segment, pass each (start_key, end_key) pair back into a regular Phoenix\nSQL query, using SCAN_START_KEY() and SCAN_END_KEY() as predicates with the\nbytes bound as parameters:"},"1561":{"id":"/docs/features/segment-scan-16","page_id":"/docs/features/segment-scan","tags":["multi-page"],"type":"text","url":"/docs/features/segment-scan#segment-scan-usage","content":"Phoenix translates these predicates into the underlying HBase scan bounds for you,\nso a worker pool can stay in plain SQL — each worker runs its own query against one\nsegment, in parallel."},"1562":{"id":"/docs/features/segment-scan-17","page_id":"/docs/features/segment-scan","tags":["multi-page"],"type":"text","url":"/docs/features/segment-scan#segment-scan-count","content":"The number of segments returned is min(N, num_regions):"},"1563":{"id":"/docs/features/segment-scan-18","page_id":"/docs/features/segment-scan","tags":["multi-page"],"type":"text","url":"/docs/features/segment-scan#segment-scan-count","content":"If N <= num_regions, Phoenix bundles consecutive regions together so you get\nexactly N segments. The grouping is as even as possible — with r = num_regions\nmod N segments getting one extra region."},"1564":{"id":"/docs/features/segment-scan-19","page_id":"/docs/features/segment-scan","tags":["multi-page"],"type":"text","url":"/docs/features/segment-scan#segment-scan-count","content":"If N > num_regions, you simply get one segment per region. Phoenix will not\nsplit a region's key range into smaller sub-ranges for you, so the maximum\nachievable parallelism is bounded by the number of regions in the table."},"1565":{"id":"/docs/features/segment-scan-20","page_id":"/docs/features/segment-scan","tags":["multi-page"],"type":"text","url":"/docs/features/segment-scan#segment-scan-count","content":"If you want more parallelism than your region count permits, pre-split the table or\nsalt it; Segment Scan respects whatever the current region layout is."},"1566":{"id":"/docs/features/segment-scan-21","page_id":"/docs/features/segment-scan","tags":["multi-page"],"type":"text","url":"/docs/features/segment-scan#segment-scan-count","content":"N must be a positive integer. Passing 0 or a negative value returns SQL error\ncode 221 (\"TOTAL_SEGMENTS() value must be greater than 0\")."},"1567":{"id":"/docs/features/segment-scan-22","page_id":"/docs/features/segment-scan","tags":["multi-page"],"type":"text","url":"/docs/features/segment-scan#segment-scan-how","content":"TOTAL_SEGMENTS() is a marker, not a server-side function. The Phoenix planner sees\nit during compilation and replaces the query plan entirely with a client-side plan\nthat:"},"1568":{"id":"/docs/features/segment-scan-23","page_id":"/docs/features/segment-scan","tags":["multi-page"],"type":"text","url":"/docs/features/segment-scan#segment-scan-how","content":"Looks up the table's current region locations."},"1569":{"id":"/docs/features/segment-scan-24","page_id":"/docs/features/segment-scan","tags":["multi-page"],"type":"text","url":"/docs/features/segment-scan#segment-scan-how","content":"Buckets them into min(N, num_regions) contiguous groups."},"1570":{"id":"/docs/features/segment-scan-25","page_id":"/docs/features/segment-scan","tags":["multi-page"],"type":"text","url":"/docs/features/segment-scan#segment-scan-how","content":"Returns each group's combined (start_key, end_key) as a result row."},"1571":{"id":"/docs/features/segment-scan-26","page_id":"/docs/features/segment-scan","tags":["multi-page"],"type":"text","url":"/docs/features/segment-scan#segment-scan-how","content":"No region-server scan is issued for this query — it's a metadata-only operation, so\nit's cheap to call, and it doesn't read or count any of the actual data."},"1572":{"id":"/docs/features/segment-scan-27","page_id":"/docs/features/segment-scan","tags":["multi-page"],"type":"text","url":"/docs/features/segment-scan#segment-scan-watch","content":"Region layout changes between discovery and scan. The segments you got back\nreflect the region layout at the time of the call. If the table splits or merges\nbetween segment discovery and your parallel scan, your (start_key, end_key)\nranges are still valid as byte ranges — they just may not align with current\nregions. The parallel scan still works; you just lose some of the\nregion-locality benefit."},"1573":{"id":"/docs/features/segment-scan-28","page_id":"/docs/features/segment-scan","tags":["multi-page"],"type":"text","url":"/docs/features/segment-scan#segment-scan-watch","content":"Each segment can still hold a lot of data. Segments correspond to one or more\nwhole regions. If your regions are large or unevenly populated, individual\nworkers may end up scanning more than others. Use this with the standard scan\ncontrols (paging, batch sizes) rather than relying on Segment Scan to balance row\ncounts."},"1574":{"id":"/docs/features/segment-scan-29","page_id":"/docs/features/segment-scan","tags":["multi-page"],"type":"text","url":"/docs/features/segment-scan#segment-scan-watch","content":"Segment Scan describes ranges; it doesn't scan. The parallel scan itself is\nyour responsibility — a worker pool takes one (start_key, end_key) per task and\nruns a regular Phoenix query bounded with SCAN_START_KEY() = ? AND SCAN_END_KEY()\n= ?."},"1575":{"id":"/docs/features/skip-scan","page_id":"/docs/features/skip-scan","type":"page","content":"Skip Scan","breadcrumbs":["Docs","Multi-Page Documentation","Development","Features"],"tags":["multi-page"],"url":"/docs/features/skip-scan"},"1576":{"id":"/docs/features/skip-scan-0","page_id":"/docs/features/skip-scan","tags":["multi-page"],"type":"text","url":"/docs/features/skip-scan","content":"How Phoenix Skip Scan uses key-range hints to efficiently skip non-matching row-key regions."},"1577":{"id":"/docs/features/skip-scan-1","page_id":"/docs/features/skip-scan","tags":["multi-page"],"type":"text","url":"/docs/features/skip-scan","content":"Phoenix uses Skip Scan for intra-row scanning which allows for significant performance improvement over Range Scan when rows are retrieved based on a given set of keys."},"1578":{"id":"/docs/features/skip-scan-2","page_id":"/docs/features/skip-scan","tags":["multi-page"],"type":"text","url":"/docs/features/skip-scan","content":"Skip Scan leverages SEEK_NEXT_USING_HINT in HBase filters. It stores information about which key sets or key ranges are being searched for in each column. During filter evaluation, it checks whether a key is in one of the valid combinations or ranges. If not, it computes the next highest key to jump to."},"1579":{"id":"/docs/features/skip-scan-3","page_id":"/docs/features/skip-scan","tags":["multi-page"],"type":"text","url":"/docs/features/skip-scan","content":"Input to SkipScanFilter is a List<List<KeyRange>> where the top-level list represents each row-key column (that is, each primary key part), and the inner list represents OR-ed byte-array boundaries."},"1580":{"id":"/docs/features/skip-scan-4","page_id":"/docs/features/skip-scan","tags":["multi-page"],"type":"text","url":"/docs/features/skip-scan","content":"Consider the following query:"},"1581":{"id":"/docs/features/skip-scan-5","page_id":"/docs/features/skip-scan","tags":["multi-page"],"type":"text","url":"/docs/features/skip-scan","content":"For the query above, the List<List<KeyRange>> passed to SkipScanFilter would look like:"},"1582":{"id":"/docs/features/skip-scan-6","page_id":"/docs/features/skip-scan","tags":["multi-page"],"type":"text","url":"/docs/features/skip-scan","content":"Here, [[a - b], [d - e]] represents ranges for KEY1, and [1, 2] represents the keys for KEY2."},"1583":{"id":"/docs/features/skip-scan-7","page_id":"/docs/features/skip-scan","tags":["multi-page"],"type":"text","url":"/docs/features/skip-scan","content":"The following diagram illustrates graphically how the skip scan is able to jump around the key space:"},"1584":{"id":"/docs/features/statistics-collection","page_id":"/docs/features/statistics-collection","type":"page","content":"Statistics Collection","breadcrumbs":["Docs","Multi-Page Documentation","Development","Features"],"tags":["multi-page"],"url":"/docs/features/statistics-collection"},"1585":{"id":"/docs/features/statistics-collection-0","page_id":"/docs/features/statistics-collection","tags":["multi-page"],"type":"text","url":"/docs/features/statistics-collection","content":"How Phoenix collects and uses guidepost statistics for query parallelization, with commands and configuration."},"1586":{"id":"/docs/features/statistics-collection-1","page_id":"/docs/features/statistics-collection","type":"heading","tags":["multi-page"],"url":"/docs/features/statistics-collection#statistics-collection-parallelization","content":"Parallelization"},"1587":{"id":"/docs/features/statistics-collection-2","page_id":"/docs/features/statistics-collection","type":"heading","tags":["multi-page"],"url":"/docs/features/statistics-collection#statistics-collection-examples","content":"Examples"},"1588":{"id":"/docs/features/statistics-collection-3","page_id":"/docs/features/statistics-collection","type":"heading","tags":["multi-page"],"url":"/docs/features/statistics-collection#known-issues","content":"Known issues"},"1589":{"id":"/docs/features/statistics-collection-4","page_id":"/docs/features/statistics-collection","type":"heading","tags":["multi-page"],"url":"/docs/features/statistics-collection#statistics-collection-configuration","content":"Configuration"},"1590":{"id":"/docs/features/statistics-collection-5","page_id":"/docs/features/statistics-collection","tags":["multi-page"],"type":"text","url":"/docs/features/statistics-collection","content":"The UPDATE STATISTICS command updates the statistics collected on a table.\nThis command collects a set of keys per region per column family that\nare equal byte distanced from each other. These collected keys are called guideposts\nand they act as hints/guides to improve the parallelization of queries on a given\ntarget region."},"1591":{"id":"/docs/features/statistics-collection-6","page_id":"/docs/features/statistics-collection","tags":["multi-page"],"type":"text","url":"/docs/features/statistics-collection","content":"Statistics are also automatically collected during major compactions and region splits so\nmanually running this command may not be necessary."},"1592":{"id":"/docs/features/statistics-collection-7","page_id":"/docs/features/statistics-collection","tags":["multi-page"],"type":"text","url":"/docs/features/statistics-collection#statistics-collection-parallelization","content":"Phoenix breaks up queries into multiple scans and runs them in parallel to reduce latency.\nParallelization in Phoenix is driven by statistics-related configuration parameters.\nEach chunk of data between guideposts will be run in parallel in a separate scan to improve\nquery performance. The chunk size is determined by the GUIDE_POSTS_WIDTH table property (Phoenix 4.9+)\nor the global server-side phoenix.stats.guidepost.width parameter if the table property is\nnot set. As the size of the chunks decrease,\nyou'll want to increase phoenix.query.queueSize as more work will be queued in that\ncase. Note that at a minimum, separate scans will be run for each table region. Statistics in Phoenix\nprovides a means of gaining intraregion parallelization. In addition to the guidepost width specification,\nthe client-side phoenix.query.threadPoolSize and phoenix.query.queueSize parameters\nand the server-side hbase.regionserver.handler.count parameter have an impact on the amount\nof parallelization."},"1593":{"id":"/docs/features/statistics-collection-8","page_id":"/docs/features/statistics-collection","tags":["multi-page"],"type":"text","url":"/docs/features/statistics-collection#statistics-collection-examples","content":"To update the statistics for a given table my_table, execute the following command:"},"1594":{"id":"/docs/features/statistics-collection-9","page_id":"/docs/features/statistics-collection","tags":["multi-page"],"type":"text","url":"/docs/features/statistics-collection#statistics-collection-examples","content":"The above syntax would collect the statistics for the table my_table and all the index tables,\nviews and view index tables associated with the table my_table."},"1595":{"id":"/docs/features/statistics-collection-10","page_id":"/docs/features/statistics-collection","tags":["multi-page"],"type":"text","url":"/docs/features/statistics-collection#statistics-collection-examples","content":"The equivalent syntax is:"},"1596":{"id":"/docs/features/statistics-collection-11","page_id":"/docs/features/statistics-collection","tags":["multi-page"],"type":"text","url":"/docs/features/statistics-collection#statistics-collection-examples","content":"To collect statistics on the index table only:"},"1597":{"id":"/docs/features/statistics-collection-12","page_id":"/docs/features/statistics-collection","tags":["multi-page"],"type":"text","url":"/docs/features/statistics-collection#statistics-collection-examples","content":"To collect statistics on the table only:"},"1598":{"id":"/docs/features/statistics-collection-13","page_id":"/docs/features/statistics-collection","tags":["multi-page"],"type":"text","url":"/docs/features/statistics-collection#statistics-collection-examples","content":"To modify the guidepost width to 10MB for a table, execute the following command:"},"1599":{"id":"/docs/features/statistics-collection-14","page_id":"/docs/features/statistics-collection","tags":["multi-page"],"type":"text","url":"/docs/features/statistics-collection#statistics-collection-examples","content":"To remove the guidepost width, set the property to null:"},"1600":{"id":"/docs/features/statistics-collection-15","page_id":"/docs/features/statistics-collection","tags":["multi-page"],"type":"text","url":"/docs/features/statistics-collection#known-issues","content":"Duplicated records (SQL count shows more rows than HBase row_count) can occur in Phoenix versions earlier than 4.12."},"1601":{"id":"/docs/features/statistics-collection-16","page_id":"/docs/features/statistics-collection","tags":["multi-page"],"type":"text","url":"/docs/features/statistics-collection#known-issues","content":"This may happen for tables with several regions where guideposts were not generated for the last region(s) because the region size is smaller than the guidepost width.\nIn that case, parallel scans for those regions may start with the latest guidepost instead of the region start key.\nThis was fixed in 4.12 as part of PHOENIX-4007."},"1602":{"id":"/docs/features/statistics-collection-17","page_id":"/docs/features/statistics-collection","tags":["multi-page"],"type":"text","url":"/docs/features/statistics-collection#statistics-collection-configuration","content":"The configuration parameters controlling statistics collection include:"},"1603":{"id":"/docs/features/statistics-collection-18","page_id":"/docs/features/statistics-collection","tags":["multi-page"],"type":"text","url":"/docs/features/statistics-collection#statistics-collection-configuration","content":"phoenix.stats.guidepost.width"},"1604":{"id":"/docs/features/statistics-collection-19","page_id":"/docs/features/statistics-collection","tags":["multi-page"],"type":"text","url":"/docs/features/statistics-collection#statistics-collection-configuration","content":"A server-side parameter that specifies the number of bytes between guideposts.\nA smaller amount increases parallelization, but also increases the number of\nchunks which must be merged on the client side."},"1605":{"id":"/docs/features/statistics-collection-20","page_id":"/docs/features/statistics-collection","tags":["multi-page"],"type":"text","url":"/docs/features/statistics-collection#statistics-collection-configuration","content":"The default value is 104857600 (100 MB)."},"1606":{"id":"/docs/features/statistics-collection-21","page_id":"/docs/features/statistics-collection","tags":["multi-page"],"type":"text","url":"/docs/features/statistics-collection#statistics-collection-configuration","content":"phoenix.stats.updateFrequency"},"1607":{"id":"/docs/features/statistics-collection-22","page_id":"/docs/features/statistics-collection","tags":["multi-page"],"type":"text","url":"/docs/features/statistics-collection#statistics-collection-configuration","content":"A server-side parameter that determines the frequency in milliseconds for which statistics\nwill be refreshed from the statistics table and subsequently used by the client."},"1608":{"id":"/docs/features/statistics-collection-23","page_id":"/docs/features/statistics-collection","tags":["multi-page"],"type":"text","url":"/docs/features/statistics-collection#statistics-collection-configuration","content":"The default value is 900000 (15 mins)."},"1609":{"id":"/docs/features/statistics-collection-24","page_id":"/docs/features/statistics-collection","tags":["multi-page"],"type":"text","url":"/docs/features/statistics-collection#statistics-collection-configuration","content":"phoenix.stats.minUpdateFrequency - A client-side parameter that determines the minimum amount of time in milliseconds that\nmust pass before statistics may again be manually collected through another UPDATE\nSTATISTICS call. - The default value is phoenix.stats.updateFrequency divided by two (7.5 mins)."},"1610":{"id":"/docs/features/statistics-collection-25","page_id":"/docs/features/statistics-collection","tags":["multi-page"],"type":"text","url":"/docs/features/statistics-collection#statistics-collection-configuration","content":"phoenix.stats.useCurrentTime"},"1611":{"id":"/docs/features/statistics-collection-26","page_id":"/docs/features/statistics-collection","tags":["multi-page"],"type":"text","url":"/docs/features/statistics-collection#statistics-collection-configuration","content":"An advanced server-side parameter that, if true, causes the current time on the server-side\nto be used as the timestamp of rows in the statistics table when background tasks such as\ncompactions or splits occur. If false, then the max timestamp found while traversing the\ntable over which statistics are being collected is used as the timestamp. Unless your\nclient is controlling the timestamps while reading and writing data, this parameter\nshould be left alone."},"1612":{"id":"/docs/features/statistics-collection-27","page_id":"/docs/features/statistics-collection","tags":["multi-page"],"type":"text","url":"/docs/features/statistics-collection#statistics-collection-configuration","content":"The default value is true."},"1613":{"id":"/docs/features/statistics-collection-28","page_id":"/docs/features/statistics-collection","tags":["multi-page"],"type":"text","url":"/docs/features/statistics-collection#statistics-collection-configuration","content":"phoenix.use.stats.parallelization"},"1614":{"id":"/docs/features/statistics-collection-29","page_id":"/docs/features/statistics-collection","tags":["multi-page"],"type":"text","url":"/docs/features/statistics-collection#statistics-collection-configuration","content":"This configuration is available starting in Phoenix 4.12. It controls whether statistical information\non the data should be used to drive query parallelization."},"1615":{"id":"/docs/features/statistics-collection-30","page_id":"/docs/features/statistics-collection","tags":["multi-page"],"type":"text","url":"/docs/features/statistics-collection#statistics-collection-configuration","content":"The default value is true."},"1616":{"id":"/docs/features/storage-formats","page_id":"/docs/features/storage-formats","type":"page","content":"Storage Formats","breadcrumbs":["Docs","Multi-Page Documentation","Development","Features"],"tags":["multi-page"],"url":"/docs/features/storage-formats"},"1617":{"id":"/docs/features/storage-formats-0","page_id":"/docs/features/storage-formats","tags":["multi-page"],"type":"text","url":"/docs/features/storage-formats","content":"Configure Phoenix column mapping and immutable storage encoding for better storage efficiency and performance."},"1618":{"id":"/docs/features/storage-formats-1","page_id":"/docs/features/storage-formats","type":"heading","tags":["multi-page"],"url":"/docs/features/storage-formats#how-to-use-column-mapping","content":"How to use column mapping"},"1619":{"id":"/docs/features/storage-formats-2","page_id":"/docs/features/storage-formats","type":"heading","tags":["multi-page"],"url":"/docs/features/storage-formats#how-to-use-immutable-data-encoding","content":"How to use immutable data encoding"},"1620":{"id":"/docs/features/storage-formats-3","page_id":"/docs/features/storage-formats","type":"heading","tags":["multi-page"],"url":"/docs/features/storage-formats#how-to-disable-column-mapping","content":"How to disable column mapping"},"1621":{"id":"/docs/features/storage-formats-4","page_id":"/docs/features/storage-formats","tags":["multi-page"],"type":"text","url":"/docs/features/storage-formats","content":"As part of Phoenix 4.10, we have reduced on-disk storage size to improve overall performance by implementing the following enhancements:"},"1622":{"id":"/docs/features/storage-formats-5","page_id":"/docs/features/storage-formats","tags":["multi-page"],"type":"text","url":"/docs/features/storage-formats","content":"Introduce a layer of indirection between Phoenix column names and the corresponding HBase column qualifiers."},"1623":{"id":"/docs/features/storage-formats-6","page_id":"/docs/features/storage-formats","tags":["multi-page"],"type":"text","url":"/docs/features/storage-formats","content":"Support a new encoding scheme for immutable tables that packs all values into a single cell per column family."},"1624":{"id":"/docs/features/storage-formats-7","page_id":"/docs/features/storage-formats","tags":["multi-page"],"type":"text","url":"/docs/features/storage-formats","content":"For more details on column mapping and immutable data encoding, see this blog."},"1625":{"id":"/docs/features/storage-formats-8","page_id":"/docs/features/storage-formats","tags":["multi-page"],"type":"text","url":"/docs/features/storage-formats#how-to-use-column-mapping","content":"You can set the column mapping property only when creating a table. Before deciding to use column mapping, think about how many columns your table and view hierarchy will require over their lifecycle. The following limits apply for each mapping scheme:"},"1626":{"id":"/docs/features/storage-formats-9","page_id":"/docs/features/storage-formats","tags":["multi-page"],"type":"text","url":"/docs/features/storage-formats#how-to-use-column-mapping","content":"Config/Property Value"},"1627":{"id":"/docs/features/storage-formats-10","page_id":"/docs/features/storage-formats","tags":["multi-page"],"type":"text","url":"/docs/features/storage-formats#how-to-use-column-mapping","content":"Max # of columns"},"1628":{"id":"/docs/features/storage-formats-11","page_id":"/docs/features/storage-formats","tags":["multi-page"],"type":"text","url":"/docs/features/storage-formats#how-to-use-column-mapping","content":"1"},"1629":{"id":"/docs/features/storage-formats-12","page_id":"/docs/features/storage-formats","tags":["multi-page"],"type":"text","url":"/docs/features/storage-formats#how-to-use-column-mapping","content":"255"},"1630":{"id":"/docs/features/storage-formats-13","page_id":"/docs/features/storage-formats","tags":["multi-page"],"type":"text","url":"/docs/features/storage-formats#how-to-use-column-mapping","content":"2"},"1631":{"id":"/docs/features/storage-formats-14","page_id":"/docs/features/storage-formats","tags":["multi-page"],"type":"text","url":"/docs/features/storage-formats#how-to-use-column-mapping","content":"65535"},"1632":{"id":"/docs/features/storage-formats-15","page_id":"/docs/features/storage-formats","tags":["multi-page"],"type":"text","url":"/docs/features/storage-formats#how-to-use-column-mapping","content":"3"},"1633":{"id":"/docs/features/storage-formats-16","page_id":"/docs/features/storage-formats","tags":["multi-page"],"type":"text","url":"/docs/features/storage-formats#how-to-use-column-mapping","content":"16777215"},"1634":{"id":"/docs/features/storage-formats-17","page_id":"/docs/features/storage-formats","tags":["multi-page"],"type":"text","url":"/docs/features/storage-formats#how-to-use-column-mapping","content":"4"},"1635":{"id":"/docs/features/storage-formats-18","page_id":"/docs/features/storage-formats","tags":["multi-page"],"type":"text","url":"/docs/features/storage-formats#how-to-use-column-mapping","content":"2147483647"},"1636":{"id":"/docs/features/storage-formats-19","page_id":"/docs/features/storage-formats","tags":["multi-page"],"type":"text","url":"/docs/features/storage-formats#how-to-use-column-mapping","content":"NONE"},"1637":{"id":"/docs/features/storage-formats-20","page_id":"/docs/features/storage-formats","tags":["multi-page"],"type":"text","url":"/docs/features/storage-formats#how-to-use-column-mapping","content":"no limit (theoretically)"},"1638":{"id":"/docs/features/storage-formats-21","page_id":"/docs/features/storage-formats","tags":["multi-page"],"type":"text","url":"/docs/features/storage-formats#how-to-use-column-mapping","content":"For mutable tables, this limit applies to columns in all column families. For immutable tables, the limit applies per column family. By default, new Phoenix tables use column mapping. These defaults can be overridden by setting the following config value in hbase-site.xml."},"1639":{"id":"/docs/features/storage-formats-22","page_id":"/docs/features/storage-formats","tags":["multi-page"],"type":"text","url":"/docs/features/storage-formats#how-to-use-column-mapping","content":"Table type"},"1640":{"id":"/docs/features/storage-formats-23","page_id":"/docs/features/storage-formats","tags":["multi-page"],"type":"text","url":"/docs/features/storage-formats#how-to-use-column-mapping","content":"Default Column mapping"},"1641":{"id":"/docs/features/storage-formats-24","page_id":"/docs/features/storage-formats","tags":["multi-page"],"type":"text","url":"/docs/features/storage-formats#how-to-use-column-mapping","content":"Config"},"1642":{"id":"/docs/features/storage-formats-25","page_id":"/docs/features/storage-formats","tags":["multi-page"],"type":"text","url":"/docs/features/storage-formats#how-to-use-column-mapping","content":"Mutable/Immutable"},"1643":{"id":"/docs/features/storage-formats-26","page_id":"/docs/features/storage-formats","tags":["multi-page"],"type":"text","url":"/docs/features/storage-formats#how-to-use-column-mapping","content":"2 byte qualifiers"},"1644":{"id":"/docs/features/storage-formats-27","page_id":"/docs/features/storage-formats","tags":["multi-page"],"type":"text","url":"/docs/features/storage-formats#how-to-use-column-mapping","content":"phoenix.default.column.encoded.bytes.attrib"},"1645":{"id":"/docs/features/storage-formats-28","page_id":"/docs/features/storage-formats","tags":["multi-page"],"type":"text","url":"/docs/features/storage-formats#how-to-use-column-mapping","content":"This config controls global defaults that apply to all tables. If you want a different mapping scheme than the global default, use the COLUMN_ENCODED_BYTES table property."},"1646":{"id":"/docs/features/storage-formats-29","page_id":"/docs/features/storage-formats","tags":["multi-page"],"type":"text","url":"/docs/features/storage-formats#how-to-use-immutable-data-encoding","content":"Like column mapping, immutable data encoding can only be set when creating a table. Through performance testing, SINGLE_CELL_ARRAY_WITH_OFFSETS generally provides strong performance and space savings. Below are some scenarios where ONE_CELL_PER_COLUMN encoding may be a better fit."},"1647":{"id":"/docs/features/storage-formats-30","page_id":"/docs/features/storage-formats","tags":["multi-page"],"type":"text","url":"/docs/features/storage-formats#how-to-use-immutable-data-encoding","content":"Data is sparse, i.e. less than 50% of the columns have values."},"1648":{"id":"/docs/features/storage-formats-31","page_id":"/docs/features/storage-formats","tags":["multi-page"],"type":"text","url":"/docs/features/storage-formats#how-to-use-immutable-data-encoding","content":"Size of data within a column family gets too big. With default HBase block size of 64K, if data within a column family grows beyond 50K then SINGLE_CELL_ARRAY_WITH_OFFSETS is generally not recommended."},"1649":{"id":"/docs/features/storage-formats-32","page_id":"/docs/features/storage-formats","tags":["multi-page"],"type":"text","url":"/docs/features/storage-formats#how-to-use-immutable-data-encoding","content":"Immutable tables that are expected to have views on them."},"1650":{"id":"/docs/features/storage-formats-33","page_id":"/docs/features/storage-formats","tags":["multi-page"],"type":"text","url":"/docs/features/storage-formats#how-to-use-immutable-data-encoding","content":"By default, immutable non-multitenant tables are created using two-byte column mapping and SINGLE_CELL_ARRAY_WITH_OFFSETS data encoding. Immutable multi-tenant tables are created with two-byte column mapping and ONE_CELL_PER_COLUMN data encoding. This is because users often create tenant-specific views on base multi-tenant tables, and as noted above this is more suitable for ONE_CELL_PER_COLUMN. Like column mapping, you can change these global defaults by setting the following configs in hbase-site.xml."},"1651":{"id":"/docs/features/storage-formats-34","page_id":"/docs/features/storage-formats","tags":["multi-page"],"type":"text","url":"/docs/features/storage-formats#how-to-use-immutable-data-encoding","content":"Immutable Table type"},"1652":{"id":"/docs/features/storage-formats-35","page_id":"/docs/features/storage-formats","tags":["multi-page"],"type":"text","url":"/docs/features/storage-formats#how-to-use-immutable-data-encoding","content":"Immutable storage scheme"},"1653":{"id":"/docs/features/storage-formats-36","page_id":"/docs/features/storage-formats","tags":["multi-page"],"type":"text","url":"/docs/features/storage-formats#how-to-use-immutable-data-encoding","content":"Config"},"1654":{"id":"/docs/features/storage-formats-37","page_id":"/docs/features/storage-formats","tags":["multi-page"],"type":"text","url":"/docs/features/storage-formats#how-to-use-immutable-data-encoding","content":"Multi-tenant"},"1655":{"id":"/docs/features/storage-formats-38","page_id":"/docs/features/storage-formats","tags":["multi-page"],"type":"text","url":"/docs/features/storage-formats#how-to-use-immutable-data-encoding","content":"ONE_CELL_PER_COLUMN"},"1656":{"id":"/docs/features/storage-formats-39","page_id":"/docs/features/storage-formats","tags":["multi-page"],"type":"text","url":"/docs/features/storage-formats#how-to-use-immutable-data-encoding","content":"phoenix.default.multitenant.immutable.storage.scheme"},"1657":{"id":"/docs/features/storage-formats-40","page_id":"/docs/features/storage-formats","tags":["multi-page"],"type":"text","url":"/docs/features/storage-formats#how-to-use-immutable-data-encoding","content":"Non multi-tenant"},"1658":{"id":"/docs/features/storage-formats-41","page_id":"/docs/features/storage-formats","tags":["multi-page"],"type":"text","url":"/docs/features/storage-formats#how-to-use-immutable-data-encoding","content":"SINGLE_CELL_ARRAY_WITH_OFFSETS"},"1659":{"id":"/docs/features/storage-formats-42","page_id":"/docs/features/storage-formats","tags":["multi-page"],"type":"text","url":"/docs/features/storage-formats#how-to-use-immutable-data-encoding","content":"phoenix.default.immutable.storage.scheme"},"1660":{"id":"/docs/features/storage-formats-43","page_id":"/docs/features/storage-formats","tags":["multi-page"],"type":"text","url":"/docs/features/storage-formats#how-to-use-immutable-data-encoding","content":"You can also provide specific immutable storage and column mapping schemes with the IMMUTABLE_STORAGE_SCHEME and COLUMN_ENCODED_BYTES table properties. For example:"},"1661":{"id":"/docs/features/storage-formats-44","page_id":"/docs/features/storage-formats","tags":["multi-page"],"type":"text","url":"/docs/features/storage-formats#how-to-use-immutable-data-encoding","content":"You can choose not to use SINGLE_CELL_ARRAY_WITH_OFFSETS while still using numeric column mapping. For example:"},"1662":{"id":"/docs/features/storage-formats-45","page_id":"/docs/features/storage-formats","tags":["multi-page"],"type":"text","url":"/docs/features/storage-formats#how-to-use-immutable-data-encoding","content":"When using SINGLE_CELL_ARRAY_WITH_OFFSETS, you must use a numeric column mapping scheme. Attempting to use SINGLE_CELL_ARRAY_WITH_OFFSETS with COLUMN_ENCODED_BYTES = NONE throws an error."},"1663":{"id":"/docs/features/storage-formats-46","page_id":"/docs/features/storage-formats","tags":["multi-page"],"type":"text","url":"/docs/features/storage-formats#how-to-disable-column-mapping","content":"To disable column mapping across all new tables, set phoenix.default.column.encoded.bytes.attrib to 0. You can also keep it enabled globally and disable it selectively for a table by setting COLUMN_ENCODED_BYTES = 0 in the CREATE TABLE statement."},"1664":{"id":"/docs/features/table-sampling","page_id":"/docs/features/table-sampling","type":"page","content":"Table Sampling","breadcrumbs":["Docs","Multi-Page Documentation","Development","Features"],"tags":["multi-page"],"url":"/docs/features/table-sampling"},"1665":{"id":"/docs/features/table-sampling-0","page_id":"/docs/features/table-sampling","tags":["multi-page"],"type":"text","url":"/docs/features/table-sampling","content":"Use TABLESAMPLE in Phoenix for Bernoulli-style sampling, with performance notes, repeatability behavior, and tuning guidance."},"1666":{"id":"/docs/features/table-sampling-1","page_id":"/docs/features/table-sampling","type":"heading","tags":["multi-page"],"url":"/docs/features/table-sampling#table-sampling-performance","content":"Performance"},"1667":{"id":"/docs/features/table-sampling-2","page_id":"/docs/features/table-sampling","type":"heading","tags":["multi-page"],"url":"/docs/features/table-sampling#repeatable","content":"Repeatable"},"1668":{"id":"/docs/features/table-sampling-3","page_id":"/docs/features/table-sampling","type":"heading","tags":["multi-page"],"url":"/docs/features/table-sampling#table-sampling-examples","content":"Examples"},"1669":{"id":"/docs/features/table-sampling-4","page_id":"/docs/features/table-sampling","type":"heading","tags":["multi-page"],"url":"/docs/features/table-sampling#table-sampling-tuning","content":"Tuning"},"1670":{"id":"/docs/features/table-sampling-5","page_id":"/docs/features/table-sampling","tags":["multi-page"],"type":"text","url":"/docs/features/table-sampling","content":"To support table sampling (similar to PostgreSQL and T-SQL syntax), a TABLESAMPLE clause was incorporated into aliased table references as of Phoenix 4.12. The general syntax is described here. This feature limits the number of rows returned from a table to a percentage of rows. See PHOENIX-153 for implementation details."},"1671":{"id":"/docs/features/table-sampling-6","page_id":"/docs/features/table-sampling","tags":["multi-page"],"type":"text","url":"/docs/features/table-sampling","content":"This feature is implemented with a Bernoulli trial and a consistent-hashing-based table sampler to achieve Bernoulli sampling on a given row population. Given a sampling rate, it leverages Phoenix statistics and HBase region distribution to perform table sampling."},"1672":{"id":"/docs/features/table-sampling-7","page_id":"/docs/features/table-sampling","tags":["multi-page"],"type":"text","url":"/docs/features/table-sampling","content":"As part of statistics collection, a guidepost (a row reference) is created at equidistant byte intervals. When sampling is required, a Bernoulli trial process is applied repeatedly on each guidepost in each region with a probability proportional to the sampling rate. An included guidepost results in all rows between it and the next guidepost being included in the sample population."},"1673":{"id":"/docs/features/table-sampling-8","page_id":"/docs/features/table-sampling","tags":["multi-page"],"type":"text","url":"/docs/features/table-sampling#table-sampling-performance","content":"Sampling on a table with a sampling rate of 100% costs roughly the same computational resources as a query without sampling.\nResource consumption drops quickly as sampling rate decreases. In general, the amortized complexity of the sampling process is O(k + mn), where:"},"1674":{"id":"/docs/features/table-sampling-9","page_id":"/docs/features/table-sampling","tags":["multi-page"],"type":"text","url":"/docs/features/table-sampling#table-sampling-performance","content":"n is the number of regions in the sampled HBase table."},"1675":{"id":"/docs/features/table-sampling-10","page_id":"/docs/features/table-sampling","tags":["multi-page"],"type":"text","url":"/docs/features/table-sampling#table-sampling-performance","content":"m is the number of guideposts."},"1676":{"id":"/docs/features/table-sampling-11","page_id":"/docs/features/table-sampling","tags":["multi-page"],"type":"text","url":"/docs/features/table-sampling#table-sampling-performance","content":"k is the sampled population size."},"1677":{"id":"/docs/features/table-sampling-12","page_id":"/docs/features/table-sampling","tags":["multi-page"],"type":"text","url":"/docs/features/table-sampling#repeatable","content":"Repeatable means repeated sampling on the same table returns the same sampled result."},"1678":{"id":"/docs/features/table-sampling-13","page_id":"/docs/features/table-sampling","tags":["multi-page"],"type":"text","url":"/docs/features/table-sampling#repeatable","content":"Repeatability is enabled by applying a consistent-hashing process to the binary representation of the start row key of each guidepost in each region during sampling. By default, an FNV1 implementation with lazy modulo is used. See FNV1."},"1679":{"id":"/docs/features/table-sampling-14","page_id":"/docs/features/table-sampling","tags":["multi-page"],"type":"text","url":"/docs/features/table-sampling#table-sampling-examples","content":"To sample a table, execute a query such as the following. The sampling rate is a numeric value between 0 and 100, inclusive."},"1680":{"id":"/docs/features/table-sampling-15","page_id":"/docs/features/table-sampling","tags":["multi-page"],"type":"text","url":"/docs/features/table-sampling#table-sampling-examples","content":"More examples:"},"1681":{"id":"/docs/features/table-sampling-16","page_id":"/docs/features/table-sampling","tags":["multi-page"],"type":"text","url":"/docs/features/table-sampling#table-sampling-examples","content":"To use with aggregation:"},"1682":{"id":"/docs/features/table-sampling-17","page_id":"/docs/features/table-sampling","tags":["multi-page"],"type":"text","url":"/docs/features/table-sampling#table-sampling-examples","content":"To explain a sampled query:"},"1683":{"id":"/docs/features/table-sampling-18","page_id":"/docs/features/table-sampling","tags":["multi-page"],"type":"text","url":"/docs/features/table-sampling#table-sampling-tuning","content":"Due to the sampling process, TABLESAMPLE should be used with caution. For example, a join of two tables is likely to return a match for each row in both tables; however, when sampling is applied to one or both tables, join results may differ from non-sampled expectations."},"1684":{"id":"/docs/features/table-sampling-19","page_id":"/docs/features/table-sampling","tags":["multi-page"],"type":"text","url":"/docs/features/table-sampling#table-sampling-tuning","content":"Statistics should be collected to achieve the best sampling accuracy. To turn on statistics collection, refer to Statistics Collection."},"1685":{"id":"/docs/features/table-sampling-20","page_id":"/docs/features/table-sampling","tags":["multi-page"],"type":"text","url":"/docs/features/table-sampling#table-sampling-tuning","content":"A denser guidepost setting improves sampling accuracy, but may reduce performance. A comparison is shown below."},"1686":{"id":"/docs/features/tracing","page_id":"/docs/features/tracing","type":"page","content":"Tracing","breadcrumbs":["Docs","Multi-Page Documentation","Development","Features"],"tags":["multi-page"],"url":"/docs/features/tracing"},"1687":{"id":"/docs/features/tracing-0","page_id":"/docs/features/tracing","tags":["multi-page"],"type":"text","url":"/docs/features/tracing","content":"Configure, enable, collect, and inspect Phoenix tracing data, including metrics sinks and tracing web app usage."},"1688":{"id":"/docs/features/tracing-1","page_id":"/docs/features/tracing","type":"heading","tags":["multi-page"],"url":"/docs/features/tracing#tracing-configuration","content":"Configuration"},"1689":{"id":"/docs/features/tracing-2","page_id":"/docs/features/tracing","type":"heading","tags":["multi-page"],"url":"/docs/features/tracing#hadoop-metrics2-phoenixproperties","content":"hadoop-metrics2-phoenix.properties"},"1690":{"id":"/docs/features/tracing-3","page_id":"/docs/features/tracing","type":"heading","tags":["multi-page"],"url":"/docs/features/tracing#hadoop-metrics2-hbaseproperties","content":"hadoop-metrics2-hbase.properties"},"1691":{"id":"/docs/features/tracing-4","page_id":"/docs/features/tracing","type":"heading","tags":["multi-page"],"url":"/docs/features/tracing#disabling-tracing","content":"Disabling tracing"},"1692":{"id":"/docs/features/tracing-5","page_id":"/docs/features/tracing","type":"heading","tags":["multi-page"],"url":"/docs/features/tracing#tracing-usage","content":"Usage"},"1693":{"id":"/docs/features/tracing-6","page_id":"/docs/features/tracing","type":"heading","tags":["multi-page"],"url":"/docs/features/tracing#client-property","content":"Client Property"},"1694":{"id":"/docs/features/tracing-7","page_id":"/docs/features/tracing","type":"heading","tags":["multi-page"],"url":"/docs/features/tracing#hbase-sitexml","content":"hbase-site.xml"},"1695":{"id":"/docs/features/tracing-8","page_id":"/docs/features/tracing","type":"heading","tags":["multi-page"],"url":"/docs/features/tracing#reading-traces","content":"Reading Traces"},"1696":{"id":"/docs/features/tracing-9","page_id":"/docs/features/tracing","type":"heading","tags":["multi-page"],"url":"/docs/features/tracing#phoenix-tracing-web-application","content":"Phoenix Tracing Web Application"},"1697":{"id":"/docs/features/tracing-10","page_id":"/docs/features/tracing","type":"heading","tags":["multi-page"],"url":"/docs/features/tracing#how-to-start-the-tracing-web-application","content":"How to start the tracing web application"},"1698":{"id":"/docs/features/tracing-11","page_id":"/docs/features/tracing","type":"heading","tags":["multi-page"],"url":"/docs/features/tracing#changing-the-web-app-port-number","content":"Changing the web app port number"},"1699":{"id":"/docs/features/tracing-12","page_id":"/docs/features/tracing","type":"heading","tags":["multi-page"],"url":"/docs/features/tracing#feature-list","content":"Feature list"},"1700":{"id":"/docs/features/tracing-13","page_id":"/docs/features/tracing","type":"heading","tags":["multi-page"],"url":"/docs/features/tracing#list","content":"List"},"1701":{"id":"/docs/features/tracing-14","page_id":"/docs/features/tracing","type":"heading","tags":["multi-page"],"url":"/docs/features/tracing#dependency-tree","content":"Dependency tree"},"1702":{"id":"/docs/features/tracing-15","page_id":"/docs/features/tracing","type":"heading","tags":["multi-page"],"url":"/docs/features/tracing#trace-count","content":"Trace count"},"1703":{"id":"/docs/features/tracing-16","page_id":"/docs/features/tracing","type":"heading","tags":["multi-page"],"url":"/docs/features/tracing#trace-distribution","content":"Trace distribution"},"1704":{"id":"/docs/features/tracing-17","page_id":"/docs/features/tracing","type":"heading","tags":["multi-page"],"url":"/docs/features/tracing#timeline","content":"Timeline"},"1705":{"id":"/docs/features/tracing-18","page_id":"/docs/features/tracing","tags":["multi-page"],"type":"text","url":"/docs/features/tracing","content":"As of Phoenix 4.1.0, Phoenix supports collecting per-request traces. This allows you to see each important step in a query or insertion, all the way from the client through HBase and back again."},"1706":{"id":"/docs/features/tracing-19","page_id":"/docs/features/tracing","tags":["multi-page"],"type":"text","url":"/docs/features/tracing","content":"Phoenix leverages Cloudera's HTrace library to integrate with HBase tracing utilities. Trace metrics are then deposited into a Hadoop Metrics2 sink that writes them into a Phoenix table."},"1707":{"id":"/docs/features/tracing-20","page_id":"/docs/features/tracing","tags":["multi-page"],"type":"text","url":"/docs/features/tracing","content":"Writing traces to a Phoenix table is not supported on Hadoop 1."},"1708":{"id":"/docs/features/tracing-21","page_id":"/docs/features/tracing","tags":["multi-page"],"type":"text","url":"/docs/features/tracing#tracing-configuration","content":"There are two key configuration files that you will need to update."},"1709":{"id":"/docs/features/tracing-22","page_id":"/docs/features/tracing","tags":["multi-page"],"type":"text","url":"/docs/features/tracing#tracing-configuration","content":"hadoop-metrics2-phoenix.properties"},"1710":{"id":"/docs/features/tracing-23","page_id":"/docs/features/tracing","tags":["multi-page"],"type":"text","url":"/docs/features/tracing#tracing-configuration","content":"hadoop-metrics2-hbase.properties"},"1711":{"id":"/docs/features/tracing-24","page_id":"/docs/features/tracing","tags":["multi-page"],"type":"text","url":"/docs/features/tracing#tracing-configuration","content":"They contain the properties you need to set on the client and server, respectively, as well as information on how the Metrics2 system uses the configuration files."},"1712":{"id":"/docs/features/tracing-25","page_id":"/docs/features/tracing","tags":["multi-page"],"type":"text","url":"/docs/features/tracing#tracing-configuration","content":"Put these files on their respective classpaths and restart the process to pick up the new configurations."},"1713":{"id":"/docs/features/tracing-26","page_id":"/docs/features/tracing","tags":["multi-page"],"type":"text","url":"/docs/features/tracing#hadoop-metrics2-phoenixproperties","content":"This file will configure the Hadoop Metrics2 system for Phoenix clients."},"1714":{"id":"/docs/features/tracing-27","page_id":"/docs/features/tracing","tags":["multi-page"],"type":"text","url":"/docs/features/tracing#hadoop-metrics2-phoenixproperties","content":"The default properties you should set are:"},"1715":{"id":"/docs/features/tracing-28","page_id":"/docs/features/tracing","tags":["multi-page"],"type":"text","url":"/docs/features/tracing#hadoop-metrics2-phoenixproperties","content":"This enables standard Phoenix metrics sink (which collects the trace information) and writer (writes the traces to the Phoenix SYSTEM.TRACING_STATS table). You can modify this to set your own custom classes as well, if you have them."},"1716":{"id":"/docs/features/tracing-29","page_id":"/docs/features/tracing","tags":["multi-page"],"type":"text","url":"/docs/features/tracing#hadoop-metrics2-phoenixproperties","content":"See the properties file in the source (phoenix-hadoop2-compat/bin) for more information on setting custom sinks and writers."},"1717":{"id":"/docs/features/tracing-30","page_id":"/docs/features/tracing","tags":["multi-page"],"type":"text","url":"/docs/features/tracing#hadoop-metrics2-hbaseproperties","content":"A default HBase deployment already includes a Metrics2 configuration, so Phoenix Metrics2 config can either replace the existing file (if you do not have custom settings) or be merged into your existing Metrics2 configuration file."},"1718":{"id":"/docs/features/tracing-31","page_id":"/docs/features/tracing","tags":["multi-page"],"type":"text","url":"/docs/features/tracing#hadoop-metrics2-hbaseproperties","content":"These are essentially the same properties as in hadoop-metrics2-phoenix.properties, but prefixed with hbase instead of phoenix so they are loaded with the rest of HBase metrics."},"1719":{"id":"/docs/features/tracing-32","page_id":"/docs/features/tracing","tags":["multi-page"],"type":"text","url":"/docs/features/tracing#disabling-tracing","content":"You can disable tracing for client requests by creating a new connection without the tracing property enabled (see below)."},"1720":{"id":"/docs/features/tracing-33","page_id":"/docs/features/tracing","tags":["multi-page"],"type":"text","url":"/docs/features/tracing#disabling-tracing","content":"However, on the server side, once the metrics sink is enabled you cannot turn off trace collection and writing unless you remove the Phoenix Metrics2 configuration and restart the region server. This is enforced by the Metrics2 framework, which assumes server metrics should always be collected."},"1721":{"id":"/docs/features/tracing-34","page_id":"/docs/features/tracing","tags":["multi-page"],"type":"text","url":"/docs/features/tracing#tracing-usage","content":"There are only a couple small things you need to do to enable tracing a given request with Phoenix."},"1722":{"id":"/docs/features/tracing-35","page_id":"/docs/features/tracing","tags":["multi-page"],"type":"text","url":"/docs/features/tracing#client-property","content":"The frequency of tracing is determined by the following client-side Phoenix property:"},"1723":{"id":"/docs/features/tracing-36","page_id":"/docs/features/tracing","tags":["multi-page"],"type":"text","url":"/docs/features/tracing#client-property","content":"There are three possible tracing frequencies you can use:"},"1724":{"id":"/docs/features/tracing-37","page_id":"/docs/features/tracing","tags":["multi-page"],"type":"text","url":"/docs/features/tracing#client-property","content":"never"},"1725":{"id":"/docs/features/tracing-38","page_id":"/docs/features/tracing","tags":["multi-page"],"type":"text","url":"/docs/features/tracing#client-property","content":"This is the default"},"1726":{"id":"/docs/features/tracing-39","page_id":"/docs/features/tracing","tags":["multi-page"],"type":"text","url":"/docs/features/tracing#client-property","content":"always"},"1727":{"id":"/docs/features/tracing-40","page_id":"/docs/features/tracing","tags":["multi-page"],"type":"text","url":"/docs/features/tracing#client-property","content":"Every request will be traced"},"1728":{"id":"/docs/features/tracing-41","page_id":"/docs/features/tracing","tags":["multi-page"],"type":"text","url":"/docs/features/tracing#client-property","content":"probability"},"1729":{"id":"/docs/features/tracing-42","page_id":"/docs/features/tracing","tags":["multi-page"],"type":"text","url":"/docs/features/tracing#client-property","content":"Take traces with a probabilistic frequency"},"1730":{"id":"/docs/features/tracing-43","page_id":"/docs/features/tracing","tags":["multi-page"],"type":"text","url":"/docs/features/tracing#client-property","content":"probability threshold is set by phoenix.trace.probability.threshold with a default of 0.05 (5%)."},"1731":{"id":"/docs/features/tracing-44","page_id":"/docs/features/tracing","tags":["multi-page"],"type":"text","url":"/docs/features/tracing#client-property","content":"As with other configuration properties, this property may be specified at JDBC connection time as a connection property.\nEnabling one of these properties only turns on trace collection. Trace data still needs to be deposited somewhere."},"1732":{"id":"/docs/features/tracing-45","page_id":"/docs/features/tracing","tags":["multi-page"],"type":"text","url":"/docs/features/tracing#client-property","content":"Example:"},"1733":{"id":"/docs/features/tracing-46","page_id":"/docs/features/tracing","tags":["multi-page"],"type":"text","url":"/docs/features/tracing#hbase-sitexml","content":"You can also enable tracing via hbase-site.xml. However, only always and never are currently supported."},"1734":{"id":"/docs/features/tracing-47","page_id":"/docs/features/tracing","tags":["multi-page"],"type":"text","url":"/docs/features/tracing#reading-traces","content":"Once the traces are deposited into the tracing table, by default SYSTEM.TRACING_STATS, but it is configurable in the HBase configuration via:"},"1735":{"id":"/docs/features/tracing-48","page_id":"/docs/features/tracing","tags":["multi-page"],"type":"text","url":"/docs/features/tracing#reading-traces","content":"The tracing table is initialized via the DDL:"},"1736":{"id":"/docs/features/tracing-49","page_id":"/docs/features/tracing","tags":["multi-page"],"type":"text","url":"/docs/features/tracing#reading-traces","content":"The tracing table also contains a number of dynamic columns for each trace. A trace is identified by trace ID (request ID), parent ID (parent span ID), and span ID (individual segment ID), and may have multiple tags and annotations. Once you know the number of tags and annotations, you can retrieve them from the table with a query like:"},"1737":{"id":"/docs/features/tracing-50","page_id":"/docs/features/tracing","tags":["multi-page"],"type":"text","url":"/docs/features/tracing#reading-traces","content":"Where columns is either annotations.aX or tags.tX, where X is the index of the dynamic column to look up."},"1738":{"id":"/docs/features/tracing-51","page_id":"/docs/features/tracing","tags":["multi-page"],"type":"text","url":"/docs/features/tracing#reading-traces","content":"For more usage examples, see TraceReader, which can programmatically read traces from the tracing results table."},"1739":{"id":"/docs/features/tracing-52","page_id":"/docs/features/tracing","tags":["multi-page"],"type":"text","url":"/docs/features/tracing#reading-traces","content":"Custom annotations can also be passed into Phoenix to be added to traces. Phoenix looks for connection properties whose names start with phoenix.annotation. and adds them as annotations to client-side traces. For example, a connection property phoenix.annotation.myannotation=abc results in an annotation with key myannotation and value abc. Use this to link traces to other request identifiers in your system, such as user or session IDs."},"1740":{"id":"/docs/features/tracing-53","page_id":"/docs/features/tracing","tags":["multi-page"],"type":"text","url":"/docs/features/tracing#how-to-start-the-tracing-web-application","content":"Enable tracing for Apache Phoenix as above"},"1741":{"id":"/docs/features/tracing-54","page_id":"/docs/features/tracing","tags":["multi-page"],"type":"text","url":"/docs/features/tracing#how-to-start-the-tracing-web-application","content":"Start the web app:"},"1742":{"id":"/docs/features/tracing-55","page_id":"/docs/features/tracing","tags":["multi-page"],"type":"text","url":"/docs/features/tracing#how-to-start-the-tracing-web-application","content":"Open this URL in your browser: http://localhost:8864/webapp/"},"1743":{"id":"/docs/features/tracing-56","page_id":"/docs/features/tracing","tags":["multi-page"],"type":"text","url":"/docs/features/tracing#how-to-start-the-tracing-web-application","content":"Stop the tracing web app:"},"1744":{"id":"/docs/features/tracing-57","page_id":"/docs/features/tracing","tags":["multi-page"],"type":"text","url":"/docs/features/tracing#changing-the-web-app-port-number","content":"Execute the command below:"},"1745":{"id":"/docs/features/tracing-58","page_id":"/docs/features/tracing","tags":["multi-page"],"type":"text","url":"/docs/features/tracing#feature-list","content":"The tracing web app for Apache Phoenix includes: feature list, dependency tree, trace count, trace distribution, and timeline."},"1746":{"id":"/docs/features/tracing-59","page_id":"/docs/features/tracing","tags":["multi-page"],"type":"text","url":"/docs/features/tracing#list","content":"The most recent traces are listed down. The limiting value entered on the textbox is used to determine the trace count displayed. With each trace, there is a link to view either the dependency tree or the timeline."},"1747":{"id":"/docs/features/tracing-60","page_id":"/docs/features/tracing","tags":["multi-page"],"type":"text","url":"/docs/features/tracing#dependency-tree","content":"The dependency tree shows traces for a given trace ID in a tree view. Parent-child relationships are displayed clearly. Tooltip data includes host name, parent ID, span ID, start time, end time, description, and duration. Each node is collapsible and expandable. The SQL query is shown for each tree rendering. Clear is used to remove the tree from view."},"1748":{"id":"/docs/features/tracing-61","page_id":"/docs/features/tracing","tags":["multi-page"],"type":"text","url":"/docs/features/tracing#trace-count","content":"The trace list is categorized by description. The trace count chart can be viewed as pie, line, bar, or area chart. The chart selector is collapsible and can be hidden."},"1749":{"id":"/docs/features/tracing-62","page_id":"/docs/features/tracing","tags":["multi-page"],"type":"text","url":"/docs/features/tracing#trace-distribution","content":"The trace distribution chart shows traces across Phoenix hosts on which they are running. Chart types include pie, line, bar, and area. The chart selector is collapsible and can be hidden."},"1750":{"id":"/docs/features/tracing-63","page_id":"/docs/features/tracing","tags":["multi-page"],"type":"text","url":"/docs/features/tracing#timeline","content":"The traces can be viewed along the time axis for a given trace id. Traces can be added or cleared from the timeline. There should be a minimum of two traces starting at two different times for the system to draw its timeline. This feature helps the user to easily compare execution times between traces and within the same trace."},"1751":{"id":"/docs/features/transactions","page_id":"/docs/features/transactions","type":"page","content":"Transactions","breadcrumbs":["Docs","Multi-Page Documentation","Development","Features"],"tags":["multi-page"],"url":"/docs/features/transactions"},"1752":{"id":"/docs/features/transactions-0","page_id":"/docs/features/transactions","tags":["multi-page"],"type":"text","url":"/docs/features/transactions","content":"Configure and use transactional tables in Phoenix with Tephra, including setup steps and limitations."},"1753":{"id":"/docs/features/transactions-1","page_id":"/docs/features/transactions","type":"heading","tags":["multi-page"],"url":"/docs/features/transactions#transactions-limitations","content":"Limitations"},"1754":{"id":"/docs/features/transactions-2","page_id":"/docs/features/transactions","tags":["multi-page"],"type":"text","url":"/docs/features/transactions","content":"Transactions (beta). Above and beyond the row-level transactional semantics of HBase, Phoenix adds cross row and cross table transaction support with full ACID semantics by integrating with Tephra, now an Apache incubator project. Tephra provides snapshot isolation of concurrent transactions by implementing multi-versioned concurrency control."},"1755":{"id":"/docs/features/transactions-3","page_id":"/docs/features/transactions","tags":["multi-page"],"type":"text","url":"/docs/features/transactions","content":"Set up a system to use transactions in Phoenix with the following steps:"},"1756":{"id":"/docs/features/transactions-4","page_id":"/docs/features/transactions","tags":["multi-page"],"type":"text","url":"/docs/features/transactions","content":"Add the following config to your client-side hbase-site.xml file to enable transactions:"},"1757":{"id":"/docs/features/transactions-5","page_id":"/docs/features/transactions","tags":["multi-page"],"type":"text","url":"/docs/features/transactions","content":"Add the following config to your server-side hbase-site.xml file to configure the transaction manager.\nThe \"Transaction Server Configuration\" section of Tephra describes the available configuration options."},"1758":{"id":"/docs/features/transactions-6","page_id":"/docs/features/transactions","tags":["multi-page"],"type":"text","url":"/docs/features/transactions","content":"Also set the transaction timeout (time after which open transactions become invalid) to a reasonable value:"},"1759":{"id":"/docs/features/transactions-7","page_id":"/docs/features/transactions","tags":["multi-page"],"type":"text","url":"/docs/features/transactions","content":"Set $HBASE_HOME and start the transaction manager:"},"1760":{"id":"/docs/features/transactions-8","page_id":"/docs/features/transactions","tags":["multi-page"],"type":"text","url":"/docs/features/transactions","content":"The transaction manager would typically be configured to run on one or more of the master nodes in your HBase cluster."},"1761":{"id":"/docs/features/transactions-9","page_id":"/docs/features/transactions","tags":["multi-page"],"type":"text","url":"/docs/features/transactions","content":"Once this setup is done, transactions may then be enabled on a table by table basis by using the TRANSACTIONAL=true property when you create your table:"},"1762":{"id":"/docs/features/transactions-10","page_id":"/docs/features/transactions","tags":["multi-page"],"type":"text","url":"/docs/features/transactions","content":"An existing table may also be altered to be transactional, but be careful because you cannot switch a transactional table back to being non transactional:"},"1763":{"id":"/docs/features/transactions-11","page_id":"/docs/features/transactions","tags":["multi-page"],"type":"text","url":"/docs/features/transactions","content":"A transaction is started implicitly through the execution of a statement on a transactional table and then finished through either a commit or rollback. Once started, the statements will not see any data committed by other transactions until the transaction is complete. They will, however, see their own uncommitted data. For example:"},"1764":{"id":"/docs/features/transactions-12","page_id":"/docs/features/transactions","tags":["multi-page"],"type":"text","url":"/docs/features/transactions","content":"An exception is thrown if a transaction tries to commit a row that conflicts with other overlapping transaction that already committed. For example:"},"1765":{"id":"/docs/features/transactions-13","page_id":"/docs/features/transactions","tags":["multi-page"],"type":"text","url":"/docs/features/transactions","content":"In a second transaction perform a commit for the same row."},"1766":{"id":"/docs/features/transactions-14","page_id":"/docs/features/transactions","tags":["multi-page"],"type":"text","url":"/docs/features/transactions","content":"Now if you try to commit the first transaction you will get an exception"},"1767":{"id":"/docs/features/transactions-15","page_id":"/docs/features/transactions","tags":["multi-page"],"type":"text","url":"/docs/features/transactions","content":"Queries are only able to view commits that completed before the current transaction started and are not able to view the in progress changes of other transactions."},"1768":{"id":"/docs/features/transactions-16","page_id":"/docs/features/transactions","tags":["multi-page"],"type":"text","url":"/docs/features/transactions","content":"Indexes added to a transactional table are transactional as well with regard to their incremental maintenance. For example, the following index added to my_table will be kept transactional consistent with its data table as mutations are made:"},"1769":{"id":"/docs/features/transactions-17","page_id":"/docs/features/transactions","tags":["multi-page"],"type":"text","url":"/docs/features/transactions","content":"During a commit, if either the index or data table write fails, an exception is thrown and the client can either roll back or retry.\nIf the commit fails both the index and data table rows are not visible."},"1770":{"id":"/docs/features/transactions-18","page_id":"/docs/features/transactions","tags":["multi-page"],"type":"text","url":"/docs/features/transactions","content":"An external Tephra transaction that has already been started can be used with Phoenix by setting the transaction context of the Phoenix connection:"},"1771":{"id":"/docs/features/transactions-19","page_id":"/docs/features/transactions","tags":["multi-page"],"type":"text","url":"/docs/features/transactions#transactions-limitations","content":"Starting a transaction on a connection with an SCN set is not allowed."},"1772":{"id":"/docs/features/transactions-20","page_id":"/docs/features/transactions","tags":["multi-page"],"type":"text","url":"/docs/features/transactions#transactions-limitations","content":"Setting the maximum number of versions property while creating a transactional table limits the number of snapshots available for concurrent transactions."},"1773":{"id":"/docs/features/transactions-21","page_id":"/docs/features/transactions","tags":["multi-page"],"type":"text","url":"/docs/features/transactions#transactions-limitations","content":"When a transaction times out or if it cannot be rolled back by the client, it is added to an invalid list. This list can potentially grow if there are a lot of failed or timed out transactions.\nFor now, an administrator can manually clear transactions from this list after a major compaction has occurred. TEPHRA-35 describes ongoing work to automatically remove transactions from the invalid list once all data associated with the transaction has been removed."},"1774":{"id":"/docs/features/transactions-22","page_id":"/docs/features/transactions","tags":["multi-page"],"type":"text","url":"/docs/features/transactions#transactions-limitations","content":"If adding an index asynchronously to an existing transactional table, make sure to run a major compaction before issuing the CREATE INDEX ASYNC command as otherwise invalid and/or uncommitted transactions may appear in your index PHOENIX-2154."},"1775":{"id":"/docs/features/ttl","page_id":"/docs/features/ttl","type":"page","content":"TTL","breadcrumbs":["Docs","Multi-Page Documentation","Development","Features"],"tags":["multi-page"],"url":"/docs/features/ttl"},"1776":{"id":"/docs/features/ttl-0","page_id":"/docs/features/ttl","tags":["multi-page"],"type":"text","url":"/docs/features/ttl","content":"Phoenix TTL flavors (time-based, view, conditional) and the IS_STRICT_TTL property that controls visibility of expired rows."},"1777":{"id":"/docs/features/ttl-1","page_id":"/docs/features/ttl","type":"heading","tags":["multi-page"],"url":"/docs/features/ttl#time-based-ttl","content":"Time-based TTL"},"1778":{"id":"/docs/features/ttl-2","page_id":"/docs/features/ttl","type":"heading","tags":["multi-page"],"url":"/docs/features/ttl#view-ttl-summary","content":"View TTL"},"1779":{"id":"/docs/features/ttl-3","page_id":"/docs/features/ttl","type":"heading","tags":["multi-page"],"url":"/docs/features/ttl#conditional-ttl-summary","content":"Conditional TTL"},"1780":{"id":"/docs/features/ttl-4","page_id":"/docs/features/ttl","type":"heading","tags":["multi-page"],"url":"/docs/features/ttl#strict-vs-relaxed-ttl","content":"Strict vs Relaxed TTL"},"1781":{"id":"/docs/features/ttl-5","page_id":"/docs/features/ttl","tags":["multi-page"],"type":"text","url":"/docs/features/ttl","content":"Phoenix supports per-row time-to-live (TTL) so that rows can be expired and removed\nwithout an application-issued DELETE. There are three flavors, and one orthogonal\ntable property — IS_STRICT_TTL — that controls how aggressively expired rows are\nhidden from reads."},"1782":{"id":"/docs/features/ttl-6","page_id":"/docs/features/ttl","tags":["multi-page"],"type":"text","url":"/docs/features/ttl#time-based-ttl","content":"Set a numeric value (in seconds) on the TTL table property at CREATE TABLE time\nto age every row out a fixed duration after its cell timestamp:"},"1783":{"id":"/docs/features/ttl-7","page_id":"/docs/features/ttl","tags":["multi-page"],"type":"text","url":"/docs/features/ttl#time-based-ttl","content":"Rows older than the TTL are removed by Phoenix compaction during HBase region\ncompactions. Time-based TTL is the right choice when retention is a flat duration\nthat applies uniformly to every row in the table."},"1784":{"id":"/docs/features/ttl-8","page_id":"/docs/features/ttl","tags":["multi-page"],"type":"text","url":"/docs/features/ttl#view-ttl-summary","content":"Each view over a shared base table can set its own retention\nwindow, so different tenants or use cases can age data out independently without\nsplitting the underlying table. See View TTL for the\nfull feature."},"1785":{"id":"/docs/features/ttl-9","page_id":"/docs/features/ttl","tags":["multi-page"],"type":"text","url":"/docs/features/ttl#conditional-ttl-summary","content":"Express row expiration as a SQL boolean expression evaluated against the row's own\ncolumn values, instead of a fixed duration. A row is considered expired the moment\nthe expression evaluates to TRUE for that row. See\nConditional TTL for the full feature."},"1786":{"id":"/docs/features/ttl-10","page_id":"/docs/features/ttl","tags":["multi-page"],"type":"text","url":"/docs/features/ttl#strict-vs-relaxed-ttl","content":"IS_STRICT_TTL is a table property that controls how strictly expired rows are\nhidden from reads. It applies to every flavor of TTL above — time-based, view,\nand conditional. The default is true (strict)."},"1787":{"id":"/docs/features/ttl-11","page_id":"/docs/features/ttl","tags":["multi-page"],"type":"text","url":"/docs/features/ttl#strict-vs-relaxed-ttl","content":"Mode"},"1788":{"id":"/docs/features/ttl-12","page_id":"/docs/features/ttl","tags":["multi-page"],"type":"text","url":"/docs/features/ttl#strict-vs-relaxed-ttl","content":"Behavior"},"1789":{"id":"/docs/features/ttl-13","page_id":"/docs/features/ttl","tags":["multi-page"],"type":"text","url":"/docs/features/ttl#strict-vs-relaxed-ttl","content":"Strict (IS_STRICT_TTL = true, default)"},"1790":{"id":"/docs/features/ttl-14","page_id":"/docs/features/ttl","tags":["multi-page"],"type":"text","url":"/docs/features/ttl#strict-vs-relaxed-ttl","content":"Expired rows are filtered out on every read path — they're invisible to queries the moment they expire."},"1791":{"id":"/docs/features/ttl-15","page_id":"/docs/features/ttl","tags":["multi-page"],"type":"text","url":"/docs/features/ttl#strict-vs-relaxed-ttl","content":"Relaxed (IS_STRICT_TTL = false)"},"1792":{"id":"/docs/features/ttl-16","page_id":"/docs/features/ttl","tags":["multi-page"],"type":"text","url":"/docs/features/ttl#strict-vs-relaxed-ttl","content":"Expired rows remain visible to readers until major compaction physically removes them. Similar to DynamoDB's TTL expiry behavior."},"1793":{"id":"/docs/features/ttl-17","page_id":"/docs/features/ttl","tags":["multi-page"],"type":"text","url":"/docs/features/ttl#strict-vs-relaxed-ttl","content":"The trade-off:"},"1794":{"id":"/docs/features/ttl-18","page_id":"/docs/features/ttl","tags":["multi-page"],"type":"text","url":"/docs/features/ttl#strict-vs-relaxed-ttl","content":"Strict gives you a strong \"expired = invisible\" guarantee. It's the right\nchoice when retention is a correctness or compliance concern."},"1795":{"id":"/docs/features/ttl-19","page_id":"/docs/features/ttl","tags":["multi-page"],"type":"text","url":"/docs/features/ttl#strict-vs-relaxed-ttl","content":"Relaxed has a cheaper write path. The largest gain is with\nConditional TTL: under strict mode, every\nmutation reads the current row state to evaluate the TTL expression, which adds\nlatency. Relaxed mode skips that pre-read."},"1796":{"id":"/docs/features/ttl-20","page_id":"/docs/features/ttl","tags":["multi-page"],"type":"text","url":"/docs/features/ttl#strict-vs-relaxed-ttl","content":"You can also switch a table between modes:"},"1797":{"id":"/docs/features/ttl-21","page_id":"/docs/features/ttl","tags":["multi-page"],"type":"text","url":"/docs/features/ttl#strict-vs-relaxed-ttl","content":"Start with the default. Switch to relaxed only when the cheaper write path is the\nright trade-off for your workload and eventual visibility of expired rows is\nacceptable for your readers."},"1798":{"id":"/docs/features/user-defined-functions","page_id":"/docs/features/user-defined-functions","type":"page","content":"User-defined Functions","breadcrumbs":["Docs","Multi-Page Documentation","Development","Features"],"tags":["multi-page"],"url":"/docs/features/user-defined-functions"},"1799":{"id":"/docs/features/user-defined-functions-0","page_id":"/docs/features/user-defined-functions","tags":["multi-page"],"type":"text","url":"/docs/features/user-defined-functions","content":"Create, deploy, and manage custom Phoenix UDFs with configuration, implementation steps, and known limitations."},"1800":{"id":"/docs/features/user-defined-functions-1","page_id":"/docs/features/user-defined-functions","type":"heading","tags":["multi-page"],"url":"/docs/features/user-defined-functions#user-defined-functions-overview","content":"Overview"},"1801":{"id":"/docs/features/user-defined-functions-2","page_id":"/docs/features/user-defined-functions","type":"heading","tags":["multi-page"],"url":"/docs/features/user-defined-functions#user-defined-functions-configuration","content":"Configuration"},"1802":{"id":"/docs/features/user-defined-functions-3","page_id":"/docs/features/user-defined-functions","type":"heading","tags":["multi-page"],"url":"/docs/features/user-defined-functions#creating-custom-udfs","content":"Creating Custom UDFs"},"1803":{"id":"/docs/features/user-defined-functions-4","page_id":"/docs/features/user-defined-functions","type":"heading","tags":["multi-page"],"url":"/docs/features/user-defined-functions#dropping-the-udfs","content":"Dropping the UDFs"},"1804":{"id":"/docs/features/user-defined-functions-5","page_id":"/docs/features/user-defined-functions","type":"heading","tags":["multi-page"],"url":"/docs/features/user-defined-functions#how-to-write-custom-udf","content":"How to write custom UDF"},"1805":{"id":"/docs/features/user-defined-functions-6","page_id":"/docs/features/user-defined-functions","type":"heading","tags":["multi-page"],"url":"/docs/features/user-defined-functions#user-defined-functions-limitations","content":"Limitations"},"1806":{"id":"/docs/features/user-defined-functions-7","page_id":"/docs/features/user-defined-functions","tags":["multi-page"],"type":"text","url":"/docs/features/user-defined-functions","content":"As of Phoenix 4.4.0 we have added the ability to allow users to create and deploy\ntheir own custom or domain-specific UDFs to the cluster."},"1807":{"id":"/docs/features/user-defined-functions-8","page_id":"/docs/features/user-defined-functions","tags":["multi-page"],"type":"text","url":"/docs/features/user-defined-functions#user-defined-functions-overview","content":"Users can create temporary or permanent user-defined (domain-specific) scalar functions.\nUDFs can be used like built-in functions in queries such as SELECT, UPSERT, DELETE, and when creating functional indexes.\nTemporary functions are session-scoped and are not accessible from other sessions.\nPermanent function metadata is stored in the SYSTEM.FUNCTION table.\nPhoenix also supports tenant-specific functions. Functions created in one tenant-specific connection are not visible to other tenant-specific connections.\nOnly global tenant (no-tenant) functions are visible to all connections."},"1808":{"id":"/docs/features/user-defined-functions-9","page_id":"/docs/features/user-defined-functions","tags":["multi-page"],"type":"text","url":"/docs/features/user-defined-functions#user-defined-functions-overview","content":"Phoenix leverages the HBase dynamic class loader to load UDF JARs from HDFS at the Phoenix client and region server without restarting services."},"1809":{"id":"/docs/features/user-defined-functions-10","page_id":"/docs/features/user-defined-functions","tags":["multi-page"],"type":"text","url":"/docs/features/user-defined-functions#user-defined-functions-configuration","content":"Add the following parameters to hbase-site.xml on the Phoenix client:"},"1810":{"id":"/docs/features/user-defined-functions-11","page_id":"/docs/features/user-defined-functions","tags":["multi-page"],"type":"text","url":"/docs/features/user-defined-functions#user-defined-functions-configuration","content":"The last two configuration values should match the HBase server-side configuration."},"1811":{"id":"/docs/features/user-defined-functions-12","page_id":"/docs/features/user-defined-functions","tags":["multi-page"],"type":"text","url":"/docs/features/user-defined-functions#user-defined-functions-configuration","content":"As with other configuration properties, phoenix.functions.allowUserDefinedFunctions\nmay be specified at JDBC connection time as a connection property."},"1812":{"id":"/docs/features/user-defined-functions-13","page_id":"/docs/features/user-defined-functions","tags":["multi-page"],"type":"text","url":"/docs/features/user-defined-functions#user-defined-functions-configuration","content":"Example:"},"1813":{"id":"/docs/features/user-defined-functions-14","page_id":"/docs/features/user-defined-functions","tags":["multi-page"],"type":"text","url":"/docs/features/user-defined-functions#user-defined-functions-configuration","content":"The following optional parameter is used by the dynamic class loader to copy JARs from HDFS into the local filesystem:"},"1814":{"id":"/docs/features/user-defined-functions-15","page_id":"/docs/features/user-defined-functions","tags":["multi-page"],"type":"text","url":"/docs/features/user-defined-functions#creating-custom-udfs","content":"Implement your custom UDF by following How to write custom\nUDF."},"1815":{"id":"/docs/features/user-defined-functions-16","page_id":"/docs/features/user-defined-functions","tags":["multi-page"],"type":"text","url":"/docs/features/user-defined-functions#creating-custom-udfs","content":"Compile your code into a JAR, then deploy the JAR to HDFS. It is recommended\nto add the JAR to the HDFS directory configured by hbase.dynamic.jars.dir."},"1816":{"id":"/docs/features/user-defined-functions-17","page_id":"/docs/features/user-defined-functions","tags":["multi-page"],"type":"text","url":"/docs/features/user-defined-functions#dropping-the-udfs","content":"You can drop functions using the DROP FUNCTION query.\nDropping a function deletes the metadata for that function from Phoenix."},"1817":{"id":"/docs/features/user-defined-functions-18","page_id":"/docs/features/user-defined-functions","tags":["multi-page"],"type":"text","url":"/docs/features/user-defined-functions#how-to-write-custom-udf","content":"You can follow these steps to write your UDF (for more detail, see this blog post):"},"1818":{"id":"/docs/features/user-defined-functions-19","page_id":"/docs/features/user-defined-functions","tags":["multi-page"],"type":"text","url":"/docs/features/user-defined-functions#how-to-write-custom-udf","content":"Create a new class derived from org.apache.phoenix.expression.function.ScalarFunction."},"1819":{"id":"/docs/features/user-defined-functions-20","page_id":"/docs/features/user-defined-functions","tags":["multi-page"],"type":"text","url":"/docs/features/user-defined-functions#how-to-write-custom-udf","content":"Implement getDataType() to determine the function return type."},"1820":{"id":"/docs/features/user-defined-functions-21","page_id":"/docs/features/user-defined-functions","tags":["multi-page"],"type":"text","url":"/docs/features/user-defined-functions#how-to-write-custom-udf","content":"Implement evaluate() to calculate the result for each row.\nThe method receives org.apache.phoenix.schema.tuple.Tuple with the current row state and an org.apache.hadoop.hbase.io.ImmutableBytesWritable to populate with the function result.\nThe method returns false if there is not enough information to calculate the result (usually because one argument is unknown), and true otherwise."},"1821":{"id":"/docs/features/user-defined-functions-22","page_id":"/docs/features/user-defined-functions","tags":["multi-page"],"type":"text","url":"/docs/features/user-defined-functions#how-to-write-custom-udf","content":"Below are additional optimization-related steps."},"1822":{"id":"/docs/features/user-defined-functions-23","page_id":"/docs/features/user-defined-functions","tags":["multi-page"],"type":"text","url":"/docs/features/user-defined-functions#how-to-write-custom-udf","content":"To contribute to scan start/stop key formation, custom functions need to override the following two methods from ScalarFunction:"},"1823":{"id":"/docs/features/user-defined-functions-24","page_id":"/docs/features/user-defined-functions","tags":["multi-page"],"type":"text","url":"/docs/features/user-defined-functions#how-to-write-custom-udf","content":"Additionally, to enable ORDER BY optimization or in-place GROUP BY, override:"},"1824":{"id":"/docs/features/user-defined-functions-25","page_id":"/docs/features/user-defined-functions","tags":["multi-page"],"type":"text","url":"/docs/features/user-defined-functions#user-defined-functions-limitations","content":"The JAR containing UDFs must be manually added to and deleted from HDFS. There is ongoing work to add SQL statements for JAR add/remove (PHOENIX-1890)."},"1825":{"id":"/docs/features/user-defined-functions-26","page_id":"/docs/features/user-defined-functions","tags":["multi-page"],"type":"text","url":"/docs/features/user-defined-functions#user-defined-functions-limitations","content":"The dynamic class loader copies UDF JARs to {hbase.local.dir}/jars at the Phoenix client and region server when a UDF is used in queries. These JARs must be deleted manually when a function is deleted."},"1826":{"id":"/docs/features/user-defined-functions-27","page_id":"/docs/features/user-defined-functions","tags":["multi-page"],"type":"text","url":"/docs/features/user-defined-functions#user-defined-functions-limitations","content":"Functional indexes must be rebuilt manually if the function implementation changes (PHOENIX-1907)."},"1827":{"id":"/docs/features/user-defined-functions-28","page_id":"/docs/features/user-defined-functions","tags":["multi-page"],"type":"text","url":"/docs/features/user-defined-functions#user-defined-functions-limitations","content":"Once loaded, a JAR is not unloaded. Use a different JAR for modified implementations to avoid restarting the cluster (PHOENIX-1907)."},"1828":{"id":"/docs/features/user-defined-functions-29","page_id":"/docs/features/user-defined-functions","tags":["multi-page"],"type":"text","url":"/docs/features/user-defined-functions#user-defined-functions-limitations","content":"To list functions, query the SYSTEM.\"FUNCTION\" table (PHOENIX-1921)."},"1829":{"id":"/docs/features/varbinary-encoded","page_id":"/docs/features/varbinary-encoded","type":"page","content":"VARBINARY_ENCODED","breadcrumbs":["Docs","Multi-Page Documentation","Development","Features"],"tags":["multi-page"],"url":"/docs/features/varbinary-encoded"},"1830":{"id":"/docs/features/varbinary-encoded-0","page_id":"/docs/features/varbinary-encoded","tags":["multi-page"],"type":"text","url":"/docs/features/varbinary-encoded","content":"A variable-length binary type that sorts correctly anywhere in a composite key — use it for row keys, index keys, and row value constructors that contain binary data."},"1831":{"id":"/docs/features/varbinary-encoded-1","page_id":"/docs/features/varbinary-encoded","type":"heading","tags":["multi-page"],"url":"/docs/features/varbinary-encoded#varbinary-encoded-when","content":"When to use it"},"1832":{"id":"/docs/features/varbinary-encoded-2","page_id":"/docs/features/varbinary-encoded","type":"heading","tags":["multi-page"],"url":"/docs/features/varbinary-encoded#varbinary-encoded-defining","content":"Defining columns"},"1833":{"id":"/docs/features/varbinary-encoded-3","page_id":"/docs/features/varbinary-encoded","type":"heading","tags":["multi-page"],"url":"/docs/features/varbinary-encoded#varbinary-encoded-paging","content":"Paged scans with row value constructors"},"1834":{"id":"/docs/features/varbinary-encoded-4","page_id":"/docs/features/varbinary-encoded","type":"heading","tags":["multi-page"],"url":"/docs/features/varbinary-encoded#varbinary-encoded-sizing","content":"Sizing and storage"},"1835":{"id":"/docs/features/varbinary-encoded-5","page_id":"/docs/features/varbinary-encoded","type":"heading","tags":["multi-page"],"url":"/docs/features/varbinary-encoded#varbinary-encoded-migrating","content":"Migrating from VARBINARY"},"1836":{"id":"/docs/features/varbinary-encoded-6","page_id":"/docs/features/varbinary-encoded","tags":["multi-page"],"type":"text","url":"/docs/features/varbinary-encoded","content":"VARBINARY_ENCODED is the safe choice whenever you need a variable-length binary\ncolumn that participates in ordering: a non-trailing column of a composite primary\nkey, a secondary-index key, or a row value constructor used for paged queries.\nIntroduced in Phoenix 5.3.0\n(PHOENIX-7357)."},"1837":{"id":"/docs/features/varbinary-encoded-7","page_id":"/docs/features/varbinary-encoded","tags":["multi-page"],"type":"text","url":"/docs/features/varbinary-encoded#varbinary-encoded-when","content":"Pick VARBINARY_ENCODED over VARBINARY when any of the following is true:"},"1838":{"id":"/docs/features/varbinary-encoded-8","page_id":"/docs/features/varbinary-encoded","tags":["multi-page"],"type":"text","url":"/docs/features/varbinary-encoded#varbinary-encoded-when","content":"The column is part of a multi-column primary key and is not the last PK column."},"1839":{"id":"/docs/features/varbinary-encoded-9","page_id":"/docs/features/varbinary-encoded","tags":["multi-page"],"type":"text","url":"/docs/features/varbinary-encoded#varbinary-encoded-when","content":"The column is used as part of an index key."},"1840":{"id":"/docs/features/varbinary-encoded-10","page_id":"/docs/features/varbinary-encoded","tags":["multi-page"],"type":"text","url":"/docs/features/varbinary-encoded#varbinary-encoded-when","content":"You scan with row value constructors (e.g., WHERE (a, b) > (?, ?) for keyset\npagination) and one of the columns is binary."},"1841":{"id":"/docs/features/varbinary-encoded-11","page_id":"/docs/features/varbinary-encoded","tags":["multi-page"],"type":"text","url":"/docs/features/varbinary-encoded#varbinary-encoded-when","content":"The binary value can contain 0x00 bytes and you cannot guarantee it never will."},"1842":{"id":"/docs/features/varbinary-encoded-12","page_id":"/docs/features/varbinary-encoded","tags":["multi-page"],"type":"text","url":"/docs/features/varbinary-encoded#varbinary-encoded-when","content":"Stick with VARBINARY only when the column is purely a payload — i.e. it's never used\nin a WHERE, ORDER BY, index, or non-trailing PK position."},"1843":{"id":"/docs/features/varbinary-encoded-13","page_id":"/docs/features/varbinary-encoded","tags":["multi-page"],"type":"text","url":"/docs/features/varbinary-encoded#varbinary-encoded-when","content":"The reason: VARBINARY uses 0x00 as a separator between columns in the encoded row\nkey, so an embedded 0x00 byte in an earlier PK column collides with the separator and\nbreaks ordering. VARBINARY_ENCODED escapes zero bytes during encoding so the\nbyte-by-byte sort order of the encoded form matches the lexicographic order of the\noriginal bytes. The transform is reversed on read, so application code keeps seeing the\noriginal bytes."},"1844":{"id":"/docs/features/varbinary-encoded-14","page_id":"/docs/features/varbinary-encoded","tags":["multi-page"],"type":"text","url":"/docs/features/varbinary-encoded#varbinary-encoded-defining","content":"Use it like any other column type — including in any position of a composite key:"},"1845":{"id":"/docs/features/varbinary-encoded-15","page_id":"/docs/features/varbinary-encoded","tags":["multi-page"],"type":"text","url":"/docs/features/varbinary-encoded#varbinary-encoded-defining","content":"Literals use the standard hex form x'...' in both UPSERT and WHERE:"},"1846":{"id":"/docs/features/varbinary-encoded-16","page_id":"/docs/features/varbinary-encoded","tags":["multi-page"],"type":"text","url":"/docs/features/varbinary-encoded#varbinary-encoded-paging","content":"The intended use case for VARBINARY_ENCODED in a composite key is keyset pagination\nthat resumes from the last seen row. Because the type orders correctly, you can drive\nthis with a row value constructor without any application-level encoding:"},"1847":{"id":"/docs/features/varbinary-encoded-17","page_id":"/docs/features/varbinary-encoded","tags":["multi-page"],"type":"text","url":"/docs/features/varbinary-encoded#varbinary-encoded-paging","content":"Bind the two parameters to the last row seen by the previous page; Phoenix turns the\npredicate into an efficient seek directly to the resume point. See\nPaged Queries for the broader pattern."},"1848":{"id":"/docs/features/varbinary-encoded-18","page_id":"/docs/features/varbinary-encoded","tags":["multi-page"],"type":"text","url":"/docs/features/varbinary-encoded#varbinary-encoded-sizing","content":"The encoded form is at most 1 extra byte per 0x00 byte in the value. For typical\ninputs (random IDs, hashes, opaque tokens) the overhead is effectively zero. Plan a bit\nof headroom only when values are known to contain many zero bytes (e.g. fixed-width\nintegers stored raw with a lot of high-order zeros — in which case a fixed-width\nUNSIGNED_* type is usually a better choice anyway)."},"1849":{"id":"/docs/features/varbinary-encoded-19","page_id":"/docs/features/varbinary-encoded","tags":["multi-page"],"type":"text","url":"/docs/features/varbinary-encoded#varbinary-encoded-migrating","content":"Phoenix does not support changing a column's type in place via ALTER TABLE, so\nmoving an existing VARBINARY column to VARBINARY_ENCODED is a copy-and-switch\noperation:"},"1850":{"id":"/docs/features/varbinary-encoded-20","page_id":"/docs/features/varbinary-encoded","tags":["multi-page"],"type":"text","url":"/docs/features/varbinary-encoded#varbinary-encoded-migrating","content":"Create a new table with the same schema but with the affected columns declared as\nVARBINARY_ENCODED."},"1851":{"id":"/docs/features/varbinary-encoded-21","page_id":"/docs/features/varbinary-encoded","tags":["multi-page"],"type":"text","url":"/docs/features/varbinary-encoded#varbinary-encoded-migrating","content":"Backfill: UPSERT INTO new_table SELECT ... FROM old_table; (Phoenix re-encodes\nthe values into the new physical layout for you)."},"1852":{"id":"/docs/features/varbinary-encoded-22","page_id":"/docs/features/varbinary-encoded","tags":["multi-page"],"type":"text","url":"/docs/features/varbinary-encoded#varbinary-encoded-migrating","content":"Cut over reads and writes to the new table, then drop the old one."},"1853":{"id":"/docs/features/varbinary-encoded-23","page_id":"/docs/features/varbinary-encoded","tags":["multi-page"],"type":"text","url":"/docs/features/varbinary-encoded#varbinary-encoded-migrating","content":"For a brand-new column that you're adding to an existing table, you can declare it as\nVARBINARY_ENCODED directly with ALTER TABLE ... ADD ...."},"1854":{"id":"/docs/features/view-ttl","page_id":"/docs/features/view-ttl","type":"page","content":"View TTL","breadcrumbs":["Docs","Multi-Page Documentation","Development","Features"],"tags":["multi-page"],"url":"/docs/features/view-ttl"},"1855":{"id":"/docs/features/view-ttl-0","page_id":"/docs/features/view-ttl","tags":["multi-page"],"type":"text","url":"/docs/features/view-ttl","content":"Per-view retention on top of a shared base table — different views can age data out on different schedules without splitting the table."},"1856":{"id":"/docs/features/view-ttl-1","page_id":"/docs/features/view-ttl","type":"heading","tags":["multi-page"],"url":"/docs/features/view-ttl#view-ttl-when","content":"When to use it"},"1857":{"id":"/docs/features/view-ttl-2","page_id":"/docs/features/view-ttl","type":"heading","tags":["multi-page"],"url":"/docs/features/view-ttl#view-ttl-enable","content":"Enable the feature"},"1858":{"id":"/docs/features/view-ttl-3","page_id":"/docs/features/view-ttl","type":"heading","tags":["multi-page"],"url":"/docs/features/view-ttl#view-ttl-define","content":"Defining a TTL on a view"},"1859":{"id":"/docs/features/view-ttl-4","page_id":"/docs/features/view-ttl","type":"heading","tags":["multi-page"],"url":"/docs/features/view-ttl#view-ttl-inheritance","content":"Inheritance and child views"},"1860":{"id":"/docs/features/view-ttl-5","page_id":"/docs/features/view-ttl","type":"heading","tags":["multi-page"],"url":"/docs/features/view-ttl#view-ttl-how","content":"How it actually expires data"},"1861":{"id":"/docs/features/view-ttl-6","page_id":"/docs/features/view-ttl","type":"heading","tags":["multi-page"],"url":"/docs/features/view-ttl#view-ttl-conditional","content":"Combining with Conditional TTL"},"1862":{"id":"/docs/features/view-ttl-7","page_id":"/docs/features/view-ttl","tags":["multi-page"],"type":"text","url":"/docs/features/view-ttl","content":"A Phoenix view is a logical table that shares a single physical\nHBase table with its sibling views. View TTL lets each view define its own data\nretention policy on top of that shared table. Rows that have outlived their view's TTL\ndisappear from queries against that view and are eventually removed in the background —\nwithout affecting any other view (or the base table). Available in Phoenix 5.3.0\n(PHOENIX-6978)."},"1863":{"id":"/docs/features/view-ttl-8","page_id":"/docs/features/view-ttl","tags":["multi-page"],"type":"text","url":"/docs/features/view-ttl#view-ttl-when","content":"The classic case is multi-tenant retention: one shared base table, many tenant\nviews, each tenant gets a different retention window driven by its plan, region, or\ncontract."},"1864":{"id":"/docs/features/view-ttl-9","page_id":"/docs/features/view-ttl","tags":["multi-page"],"type":"text","url":"/docs/features/view-ttl#view-ttl-when","content":"Scenario"},"1865":{"id":"/docs/features/view-ttl-10","page_id":"/docs/features/view-ttl","tags":["multi-page"],"type":"text","url":"/docs/features/view-ttl#view-ttl-when","content":"View TTL fit"},"1866":{"id":"/docs/features/view-ttl-11","page_id":"/docs/features/view-ttl","tags":["multi-page"],"type":"text","url":"/docs/features/view-ttl#view-ttl-when","content":"Per-tenant retention windows on one shared base table"},"1867":{"id":"/docs/features/view-ttl-12","page_id":"/docs/features/view-ttl","tags":["multi-page"],"type":"text","url":"/docs/features/view-ttl#view-ttl-when","content":"Yes"},"1868":{"id":"/docs/features/view-ttl-13","page_id":"/docs/features/view-ttl","tags":["multi-page"],"type":"text","url":"/docs/features/view-ttl#view-ttl-when","content":"Per-use-case retention (e.g., \"raw events 7 days, audit 1 year\")"},"1869":{"id":"/docs/features/view-ttl-14","page_id":"/docs/features/view-ttl","tags":["multi-page"],"type":"text","url":"/docs/features/view-ttl#view-ttl-when","content":"Yes"},"1870":{"id":"/docs/features/view-ttl-15","page_id":"/docs/features/view-ttl","tags":["multi-page"],"type":"text","url":"/docs/features/view-ttl#view-ttl-when","content":"Per-tenant extra columns on top of the shared base table (each tenant's view)"},"1871":{"id":"/docs/features/view-ttl-16","page_id":"/docs/features/view-ttl","tags":["multi-page"],"type":"text","url":"/docs/features/view-ttl#view-ttl-when","content":"Yes — views can extend the base schema, View TTL still applies"},"1872":{"id":"/docs/features/view-ttl-17","page_id":"/docs/features/view-ttl","tags":["multi-page"],"type":"text","url":"/docs/features/view-ttl#view-ttl-when","content":"Same retention for the entire physical table"},"1873":{"id":"/docs/features/view-ttl-18","page_id":"/docs/features/view-ttl","tags":["multi-page"],"type":"text","url":"/docs/features/view-ttl#view-ttl-when","content":"Use a regular table-level TTL instead"},"1874":{"id":"/docs/features/view-ttl-19","page_id":"/docs/features/view-ttl","tags":["multi-page"],"type":"text","url":"/docs/features/view-ttl#view-ttl-when","content":"Retention based on row content rather than age"},"1875":{"id":"/docs/features/view-ttl-20","page_id":"/docs/features/view-ttl","tags":["multi-page"],"type":"text","url":"/docs/features/view-ttl#view-ttl-when","content":"Use Conditional TTL"},"1876":{"id":"/docs/features/view-ttl-21","page_id":"/docs/features/view-ttl","tags":["multi-page"],"type":"text","url":"/docs/features/view-ttl#view-ttl-when","content":"Different base-table schemas per tenant (different PK, different core columns)"},"1877":{"id":"/docs/features/view-ttl-22","page_id":"/docs/features/view-ttl","tags":["multi-page"],"type":"text","url":"/docs/features/view-ttl#view-ttl-when","content":"Use separate tables — View TTL doesn't apply"},"1878":{"id":"/docs/features/view-ttl-23","page_id":"/docs/features/view-ttl","tags":["multi-page"],"type":"text","url":"/docs/features/view-ttl#view-ttl-when","content":"If the retention rule is the same for everyone reading the table, set TTL on the\ntable itself; you don't need View TTL."},"1879":{"id":"/docs/features/view-ttl-24","page_id":"/docs/features/view-ttl","tags":["multi-page"],"type":"text","url":"/docs/features/view-ttl#view-ttl-enable","content":"View TTL is off by default. Enable it cluster-wide by setting this server-side\nproperty and restarting region servers:"},"1880":{"id":"/docs/features/view-ttl-25","page_id":"/docs/features/view-ttl","tags":["multi-page"],"type":"text","url":"/docs/features/view-ttl#view-ttl-enable","content":"While the feature is disabled, attempts to declare TTL on a view return a SQL error\nexplaining the property must be turned on."},"1881":{"id":"/docs/features/view-ttl-26","page_id":"/docs/features/view-ttl","tags":["multi-page"],"type":"text","url":"/docs/features/view-ttl#view-ttl-define","content":"Set TTL (in seconds) as a property on CREATE VIEW. Different views over the same\nbase table can use different values:"},"1882":{"id":"/docs/features/view-ttl-27","page_id":"/docs/features/view-ttl","tags":["multi-page"],"type":"text","url":"/docs/features/view-ttl#view-ttl-define","content":"Adjust the value later, or remove the TTL entirely:"},"1883":{"id":"/docs/features/view-ttl-28","page_id":"/docs/features/view-ttl","tags":["multi-page"],"type":"text","url":"/docs/features/view-ttl#view-ttl-inheritance","content":"A child view inherits its parent view's TTL. Child views cannot override the\nparent's value — the TTL belongs to the view that owns it. If you need different\nretention windows for two slices of the same parent, create them as siblings under a\ncommon parent rather than nesting."},"1884":{"id":"/docs/features/view-ttl-29","page_id":"/docs/features/view-ttl","tags":["multi-page"],"type":"text","url":"/docs/features/view-ttl#view-ttl-inheritance","content":"In multi-tenant mode, each tenant connection sees its own view; setting TTL on a\ntenant view applies retention to that tenant's slice only."},"1885":{"id":"/docs/features/view-ttl-30","page_id":"/docs/features/view-ttl","tags":["multi-page"],"type":"text","url":"/docs/features/view-ttl#view-ttl-how","content":"Two things happen to expired rows:"},"1886":{"id":"/docs/features/view-ttl-31","page_id":"/docs/features/view-ttl","tags":["multi-page"],"type":"text","url":"/docs/features/view-ttl#view-ttl-how","content":"Read-time filter (immediate). Whenever a query goes through a view, Phoenix\nfilters out rows whose age exceeds the view's TTL — so as soon as a row is \"too\nold\" for a view, it disappears from queries against that view, even before\nphysical deletion."},"1887":{"id":"/docs/features/view-ttl-32","page_id":"/docs/features/view-ttl","tags":["multi-page"],"type":"text","url":"/docs/features/view-ttl#view-ttl-how","content":"Phoenix compaction (eventual). Expired rows are physically removed by\nPhoenix's compaction during HBase region compactions. This reclaims disk and\nstops the rows showing up via lower-level scans. There is no separate cleanup\njob — physical removal happens whenever the underlying HBase regions compact."},"1888":{"id":"/docs/features/view-ttl-33","page_id":"/docs/features/view-ttl","tags":["multi-page"],"type":"text","url":"/docs/features/view-ttl#view-ttl-conditional","content":"A view's TTL can also be a SQL boolean expression instead of a number, in which\ncase it follows the Conditional TTL rules. This\nunlocks expiry based on row content (e.g. expire 30 days after STATUS becomes\n'CLOSED'). The IS_STRICT_TTL property described in\nStrict vs Relaxed TTL applies to view\nTTL too."},"1889":{"id":"/docs/features/views","page_id":"/docs/features/views","type":"page","content":"Views","breadcrumbs":["Docs","Multi-Page Documentation","Development","Features"],"tags":["multi-page"],"url":"/docs/features/views"},"1890":{"id":"/docs/features/views-0","page_id":"/docs/features/views","tags":["multi-page"],"type":"text","url":"/docs/features/views","content":"Define updatable and read-only Phoenix views over shared HBase tables, including indexing behavior and limitations."},"1891":{"id":"/docs/features/views-1","page_id":"/docs/features/views","type":"heading","tags":["multi-page"],"url":"/docs/features/views#updatable-views","content":"Updatable Views"},"1892":{"id":"/docs/features/views-2","page_id":"/docs/features/views","type":"heading","tags":["multi-page"],"url":"/docs/features/views#read-only-views","content":"Read-only Views"},"1893":{"id":"/docs/features/views-3","page_id":"/docs/features/views","type":"heading","tags":["multi-page"],"url":"/docs/features/views#indexes-on-views","content":"Indexes on Views"},"1894":{"id":"/docs/features/views-4","page_id":"/docs/features/views","type":"heading","tags":["multi-page"],"url":"/docs/features/views#views-limitations","content":"Limitations"},"1895":{"id":"/docs/features/views-5","page_id":"/docs/features/views","tags":["multi-page"],"type":"text","url":"/docs/features/views","content":"The standard SQL view syntax (with some limitations) is now supported by Phoenix to enable multiple virtual tables to all share the same underlying physical HBase table. This is important in HBase as there are limits to the number of regions which HBase can manage. Limiting the number of tables can help limit the number of regions in a cluster."},"1896":{"id":"/docs/features/views-6","page_id":"/docs/features/views","tags":["multi-page"],"type":"text","url":"/docs/features/views","content":"For example, given the following table definition that defines a base table to collect product metrics:"},"1897":{"id":"/docs/features/views-7","page_id":"/docs/features/views","tags":["multi-page"],"type":"text","url":"/docs/features/views","content":"You may define the following view:"},"1898":{"id":"/docs/features/views-8","page_id":"/docs/features/views","tags":["multi-page"],"type":"text","url":"/docs/features/views","content":"In this case, the same underlying physical HBase table (i.e. PRODUCT_METRICS) stores all of the data.\nNotice that unlike with standard SQL views, you may define additional columns for your view. The view inherits all of the columns from its base table, in addition to being able to optionally add new KeyValue columns. You may also add these columns after-the-fact with an ALTER VIEW statement."},"1899":{"id":"/docs/features/views-9","page_id":"/docs/features/views","tags":["multi-page"],"type":"text","url":"/docs/features/views","content":"NOTE: Phoenix 4.15.0 onwards contains PHOENIX-4810 which introduces a new endpoint coprocessor on the SYSTEM.CHILD_LINK table for adding parent->child links, whenever a view is created. Thus, when namespace mapping is enabled, users that wish to create views will need to be granted EXEC permissions on SYSTEM.CHILD_LINK in order to be able to invoke this coprocessor."},"1900":{"id":"/docs/features/views-10","page_id":"/docs/features/views","tags":["multi-page"],"type":"text","url":"/docs/features/views#updatable-views","content":"If your view uses only simple equality expressions in the WHERE clause, you are also allowed to issue DML against the view. These views are termed updatable views. For example, in this case you could issue the following UPSERT statement:"},"1901":{"id":"/docs/features/views-11","page_id":"/docs/features/views","tags":["multi-page"],"type":"text","url":"/docs/features/views#updatable-views","content":"In this case, the row will be stored in the PRODUCT_METRICS HBase table and the metric_type column value will be inferred to be 'm' since the VIEW defines it as such."},"1902":{"id":"/docs/features/views-12","page_id":"/docs/features/views","tags":["multi-page"],"type":"text","url":"/docs/features/views#updatable-views","content":"Also, queries done through the view will automatically apply the WHERE clause filter. For example:"},"1903":{"id":"/docs/features/views-13","page_id":"/docs/features/views","tags":["multi-page"],"type":"text","url":"/docs/features/views#updatable-views","content":"This would sum all the dropped_calls across all product_metrics with a metric_type of 'm' and a carrier of 'Verizon'."},"1904":{"id":"/docs/features/views-14","page_id":"/docs/features/views","tags":["multi-page"],"type":"text","url":"/docs/features/views#read-only-views","content":"Views may also be defined with more complex WHERE clauses, but in that case you cannot issue DML against them as you'll get a ReadOnlyException. You are still allowed to query through them and their WHERE clauses will be in effect as with standard SQL views."},"1905":{"id":"/docs/features/views-15","page_id":"/docs/features/views","tags":["multi-page"],"type":"text","url":"/docs/features/views#read-only-views","content":"As expected, you may create a VIEW on another VIEW as well to further filter the data set. The same rules as above apply: if only simple equality expressions are used in the VIEW and its parent VIEW(s), the new view is updatable as well, otherwise it's read-only."},"1906":{"id":"/docs/features/views-16","page_id":"/docs/features/views","tags":["multi-page"],"type":"text","url":"/docs/features/views#read-only-views","content":"Note that the previous support for creating a read-only VIEW directly over an HBase table is still supported."},"1907":{"id":"/docs/features/views-17","page_id":"/docs/features/views","tags":["multi-page"],"type":"text","url":"/docs/features/views#indexes-on-views","content":"In addition, you may create an INDEX over a VIEW, just as with a TABLE. This is particularly useful to improve query performance over newly added columns on a VIEW, since it provides a way of doing point lookups based on these column values. Note that until PHOENIX-1499 gets implemented, an INDEX over a VIEW is only maintained if the updates are made through the VIEW (as opposed to through the underlying TABLE)."},"1908":{"id":"/docs/features/views-18","page_id":"/docs/features/views","tags":["multi-page"],"type":"text","url":"/docs/features/views#views-limitations","content":"Views have the following restrictions:"},"1909":{"id":"/docs/features/views-19","page_id":"/docs/features/views","tags":["multi-page"],"type":"text","url":"/docs/features/views#views-limitations","content":"An INDEX over a VIEW is only maintained if the updates are made through the VIEW. Updates made through the underlying TABLE or the parent VIEW will not be reflected in the index (PHOENIX-1499)."},"1910":{"id":"/docs/features/views-20","page_id":"/docs/features/views","tags":["multi-page"],"type":"text","url":"/docs/features/views#views-limitations","content":"A primary key column may not be added to a VIEW when its base table has a primary key constraint that ends with a variable-length column (PHOENIX-2157)."},"1911":{"id":"/docs/features/views-21","page_id":"/docs/features/views","tags":["multi-page"],"type":"text","url":"/docs/features/views#views-limitations","content":"A VIEW may be defined over only a single table through a simple SELECT * query. You may not create a VIEW over multiple joined tables or over aggregations (PHOENIX-1505, PHOENIX-1506)."},"1912":{"id":"/docs/features/views-22","page_id":"/docs/features/views","tags":["multi-page"],"type":"text","url":"/docs/features/views#views-limitations","content":"When a column is added to a VIEW, the new column is not automatically added to child VIEWs (PHOENIX-2054). The workaround is to manually add the column to child VIEWs."},"1913":{"id":"/docs/features/views-23","page_id":"/docs/features/views","tags":["multi-page"],"type":"text","url":"/docs/features/views#views-limitations","content":"All columns must be projected into a VIEW when it is created (that is, only CREATE VIEW ... AS SELECT * is supported). You may drop non-primary-key columns inherited from the base table after creation using ALTER VIEW. Providing a subset of columns or expressions in the SELECT clause is planned for a future release (PHOENIX-1507)."},"1914":{"id":"/docs/functions","page_id":"/docs/functions","type":"page","content":"SQL Functions","breadcrumbs":["Docs","Multi-Page Documentation","Reference"],"tags":["multi-page"],"url":"/docs/functions"},"1915":{"id":"/docs/functions-0","page_id":"/docs/functions","tags":["multi-page"],"type":"text","url":"/docs/functions","content":"Built-in SQL function reference for Apache Phoenix — aggregate, string, numeric, array, date/time, and general functions."},"1916":{"id":"/docs/functions-1","page_id":"/docs/functions","type":"heading","tags":["multi-page"],"url":"/docs/functions#functions-aggregate","content":"Functions (Aggregate)"},"1917":{"id":"/docs/functions-2","page_id":"/docs/functions","type":"heading","tags":["multi-page"],"url":"/docs/functions#avg","content":"AVG"},"1918":{"id":"/docs/functions-3","page_id":"/docs/functions","type":"heading","tags":["multi-page"],"url":"/docs/functions#count","content":"COUNT"},"1919":{"id":"/docs/functions-4","page_id":"/docs/functions","type":"heading","tags":["multi-page"],"url":"/docs/functions#approx_count_distinct","content":"APPROX_COUNT_DISTINCT"},"1920":{"id":"/docs/functions-5","page_id":"/docs/functions","type":"heading","tags":["multi-page"],"url":"/docs/functions#max","content":"MAX"},"1921":{"id":"/docs/functions-6","page_id":"/docs/functions","type":"heading","tags":["multi-page"],"url":"/docs/functions#min","content":"MIN"},"1922":{"id":"/docs/functions-7","page_id":"/docs/functions","type":"heading","tags":["multi-page"],"url":"/docs/functions#sum","content":"SUM"},"1923":{"id":"/docs/functions-8","page_id":"/docs/functions","type":"heading","tags":["multi-page"],"url":"/docs/functions#percentile_cont","content":"PERCENTILE_CONT"},"1924":{"id":"/docs/functions-9","page_id":"/docs/functions","type":"heading","ta