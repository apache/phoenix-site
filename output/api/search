ble Type"},"5674":{"id":"/docs/single-page-2000","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#how-are-schemas-mapped-for-different-table-types","content":"Physical Table"},"5675":{"id":"/docs/single-page-2001","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#how-are-schemas-mapped-for-different-table-types","content":"Description"},"5676":{"id":"/docs/single-page-2002","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#how-are-schemas-mapped-for-different-table-types","content":"CREATE TABLE S.T (ID INTEGER PRIMARY KEY)"},"5677":{"id":"/docs/single-page-2003","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#how-are-schemas-mapped-for-different-table-types","content":"TABLE"},"5678":{"id":"/docs/single-page-2004","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#how-are-schemas-mapped-for-different-table-types","content":"S:T"},"5679":{"id":"/docs/single-page-2005","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#how-are-schemas-mapped-for-different-table-types","content":"Table T is created in namespace S."},"5680":{"id":"/docs/single-page-2006","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#how-are-schemas-mapped-for-different-table-types","content":"CREATE INDEX IDX ON S.T(ID)"},"5681":{"id":"/docs/single-page-2007","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#how-are-schemas-mapped-for-different-table-types","content":"INDEX"},"5682":{"id":"/docs/single-page-2008","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#how-are-schemas-mapped-for-different-table-types","content":"S:IDX"},"5683":{"id":"/docs/single-page-2009","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#how-are-schemas-mapped-for-different-table-types","content":"Indexes inherit schema and namespace from the base table."},"5684":{"id":"/docs/single-page-2010","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#how-are-schemas-mapped-for-different-table-types","content":"CREATE VIEW V AS SELECT * FROM S.T"},"5685":{"id":"/docs/single-page-2011","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#how-are-schemas-mapped-for-different-table-types","content":"VIEW with default schema"},"5686":{"id":"/docs/single-page-2012","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#how-are-schemas-mapped-for-different-table-types","content":"S:T"},"5687":{"id":"/docs/single-page-2013","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#how-are-schemas-mapped-for-different-table-types","content":"View does not inherit schema from the parent table and can use the default schema."},"5688":{"id":"/docs/single-page-2014","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#how-are-schemas-mapped-for-different-table-types","content":"CREATE VIEW X.V AS SELECT * FROM S.T"},"5689":{"id":"/docs/single-page-2015","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#how-are-schemas-mapped-for-different-table-types","content":"VIEW with different schema than physical table"},"5690":{"id":"/docs/single-page-2016","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#how-are-schemas-mapped-for-different-table-types","content":"S:T"},"5691":{"id":"/docs/single-page-2017","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#how-are-schemas-mapped-for-different-table-types","content":"View uses the parent physical table and can have a different (or same) schema."},"5692":{"id":"/docs/single-page-2018","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#how-are-schemas-mapped-for-different-table-types","content":"CREATE VIEW S.V AS SELECT * FROM S.T"},"5693":{"id":"/docs/single-page-2019","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#how-are-schemas-mapped-for-different-table-types","content":"VIEW with same schema as physical table"},"5694":{"id":"/docs/single-page-2020","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#how-are-schemas-mapped-for-different-table-types","content":"S:T"},"5695":{"id":"/docs/single-page-2021","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#how-are-schemas-mapped-for-different-table-types","content":"View uses the parent physical table and can have a different (or same) schema."},"5696":{"id":"/docs/single-page-2022","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#how-are-schemas-mapped-for-different-table-types","content":"CREATE INDEX IDX ON S.V(ID)"},"5697":{"id":"/docs/single-page-2023","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#how-are-schemas-mapped-for-different-table-types","content":"VIEW INDEX"},"5698":{"id":"/docs/single-page-2024","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#how-are-schemas-mapped-for-different-table-types","content":"S:_IDX_T"},"5699":{"id":"/docs/single-page-2025","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#how-are-schemas-mapped-for-different-table-types","content":"View indexes inherit schema and map to the corresponding namespace."},"5700":{"id":"/docs/single-page-2026","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#what-is-a-namespace-and-what-are-the-benefits-of-mapping-tables-to-namespaces","content":"A namespace is a logical grouping of tables, analogous to a database in relational database systems. This abstraction lays the groundwork for multi-tenancy-related features:"},"5701":{"id":"/docs/single-page-2027","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#what-is-a-namespace-and-what-are-the-benefits-of-mapping-tables-to-namespaces","content":"Quota Management - Restrict the amount of resources (i.e. regions, tables) a namespace can consume."},"5702":{"id":"/docs/single-page-2028","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#what-is-a-namespace-and-what-are-the-benefits-of-mapping-tables-to-namespaces","content":"Namespace Security Administration - Provide another level of security administration for tenants."},"5703":{"id":"/docs/single-page-2029","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#what-is-a-namespace-and-what-are-the-benefits-of-mapping-tables-to-namespaces","content":"Region server groups - A namespace/table can be pinned to a subset of RegionServers, guaranteeing a coarse level of isolation."},"5704":{"id":"/docs/single-page-2030","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#what-is-a-namespace-and-what-are-the-benefits-of-mapping-tables-to-namespaces","content":"Details about namespace management can be read here."},"5705":{"id":"/docs/single-page-2031","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#namespace-mapping-resources","content":"PHOENIX-1311: Implementation details and discussion for the namespace mapping feature."},"5706":{"id":"/docs/single-page-2032","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#statistics-collection","content":"The UPDATE STATISTICS command updates the statistics collected on a table.\nThis command collects a set of keys per region per column family that\nare equal byte distanced from each other. These collected keys are called guideposts\nand they act as hints/guides to improve the parallelization of queries on a given\ntarget region."},"5707":{"id":"/docs/single-page-2033","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#statistics-collection","content":"Statistics are also automatically collected during major compactions and region splits so\nmanually running this command may not be necessary."},"5708":{"id":"/docs/single-page-2034","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#statistics-collection-parallelization","content":"Phoenix breaks up queries into multiple scans and runs them in parallel to reduce latency.\nParallelization in Phoenix is driven by statistics-related configuration parameters.\nEach chunk of data between guideposts will be run in parallel in a separate scan to improve\nquery performance. The chunk size is determined by the GUIDE_POSTS_WIDTH table property (Phoenix 4.9+)\nor the global server-side phoenix.stats.guidepost.width parameter if the table property is\nnot set. As the size of the chunks decrease,\nyou'll want to increase phoenix.query.queueSize as more work will be queued in that\ncase. Note that at a minimum, separate scans will be run for each table region. Statistics in Phoenix\nprovides a means of gaining intraregion parallelization. In addition to the guidepost width specification,\nthe client-side phoenix.query.threadPoolSize and phoenix.query.queueSize parameters\nand the server-side hbase.regionserver.handler.count parameter have an impact on the amount\nof parallelization."},"5709":{"id":"/docs/single-page-2035","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#statistics-collection-examples","content":"To update the statistics for a given table my_table, execute the following command:"},"5710":{"id":"/docs/single-page-2036","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#statistics-collection-examples","content":"The above syntax would collect the statistics for the table my_table and all the index tables,\nviews and view index tables associated with the table my_table."},"5711":{"id":"/docs/single-page-2037","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#statistics-collection-examples","content":"The equivalent syntax is:"},"5712":{"id":"/docs/single-page-2038","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#statistics-collection-examples","content":"To collect statistics on the index table only:"},"5713":{"id":"/docs/single-page-2039","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#statistics-collection-examples","content":"To collect statistics on the table only:"},"5714":{"id":"/docs/single-page-2040","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#statistics-collection-examples","content":"To modify the guidepost width to 10MB for a table, execute the following command:"},"5715":{"id":"/docs/single-page-2041","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#statistics-collection-examples","content":"To remove the guidepost width, set the property to null:"},"5716":{"id":"/docs/single-page-2042","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#known-issues","content":"Duplicated records (SQL count shows more rows than HBase row_count) can occur in Phoenix versions earlier than 4.12."},"5717":{"id":"/docs/single-page-2043","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#known-issues","content":"This may happen for tables with several regions where guideposts were not generated for the last region(s) because the region size is smaller than the guidepost width.\nIn that case, parallel scans for those regions may start with the latest guidepost instead of the region start key.\nThis was fixed in 4.12 as part of PHOENIX-4007."},"5718":{"id":"/docs/single-page-2044","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#statistics-collection-configuration","content":"The configuration parameters controlling statistics collection include:"},"5719":{"id":"/docs/single-page-2045","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#statistics-collection-configuration","content":"phoenix.stats.guidepost.width"},"5720":{"id":"/docs/single-page-2046","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#statistics-collection-configuration","content":"A server-side parameter that specifies the number of bytes between guideposts.\nA smaller amount increases parallelization, but also increases the number of\nchunks which must be merged on the client side."},"5721":{"id":"/docs/single-page-2047","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#statistics-collection-configuration","content":"The default value is 104857600 (100 MB)."},"5722":{"id":"/docs/single-page-2048","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#statistics-collection-configuration","content":"phoenix.stats.updateFrequency"},"5723":{"id":"/docs/single-page-2049","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#statistics-collection-configuration","content":"A server-side parameter that determines the frequency in milliseconds for which statistics\nwill be refreshed from the statistics table and subsequently used by the client."},"5724":{"id":"/docs/single-page-2050","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#statistics-collection-configuration","content":"The default value is 900000 (15 mins)."},"5725":{"id":"/docs/single-page-2051","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#statistics-collection-configuration","content":"phoenix.stats.minUpdateFrequency - A client-side parameter that determines the minimum amount of time in milliseconds that\nmust pass before statistics may again be manually collected through another UPDATE\nSTATISTICS call. - The default value is phoenix.stats.updateFrequency divided by two (7.5 mins)."},"5726":{"id":"/docs/single-page-2052","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#statistics-collection-configuration","content":"phoenix.stats.useCurrentTime"},"5727":{"id":"/docs/single-page-2053","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#statistics-collection-configuration","content":"An advanced server-side parameter that, if true, causes the current time on the server-side\nto be used as the timestamp of rows in the statistics table when background tasks such as\ncompactions or splits occur. If false, then the max timestamp found while traversing the\ntable over which statistics are being collected is used as the timestamp. Unless your\nclient is controlling the timestamps while reading and writing data, this parameter\nshould be left alone."},"5728":{"id":"/docs/single-page-2054","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#statistics-collection-configuration","content":"The default value is true."},"5729":{"id":"/docs/single-page-2055","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#statistics-collection-configuration","content":"phoenix.use.stats.parallelization"},"5730":{"id":"/docs/single-page-2056","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#statistics-collection-configuration","content":"This configuration is available starting in Phoenix 4.12. It controls whether statistical information\non the data should be used to drive query parallelization."},"5731":{"id":"/docs/single-page-2057","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#statistics-collection-configuration","content":"The default value is true."},"5732":{"id":"/docs/single-page-2058","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#row-timestamp-column","content":"Phoenix 4.6 provides a way to map HBase’s native row timestamp to a Phoenix column. This helps you take advantage of HBase optimizations for time ranges in store files, along with query optimizations built into Phoenix."},"5733":{"id":"/docs/single-page-2059","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#row-timestamp-column","content":"For a column to be designated as ROW_TIMESTAMP, certain constraints need to be followed:"},"5734":{"id":"/docs/single-page-2060","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#row-timestamp-column","content":"Only a primary key column of type TIME, DATE, TIMESTAMP, BIGINT, or UNSIGNED_LONG can be designated as ROW_TIMESTAMP."},"5735":{"id":"/docs/single-page-2061","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#row-timestamp-column","content":"Only one primary key column can be designated as ROW_TIMESTAMP."},"5736":{"id":"/docs/single-page-2062","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#row-timestamp-column","content":"The column value cannot be NULL (because it maps directly to the HBase row timestamp). This also means a column can be declared as ROW_TIMESTAMP only when creating the table."},"5737":{"id":"/docs/single-page-2063","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#row-timestamp-column","content":"A ROW_TIMESTAMP column value cannot be negative. For DATE/TIME/TIMESTAMP, the corresponding epoch time in milliseconds cannot be less than zero."},"5738":{"id":"/docs/single-page-2064","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#row-timestamp-column","content":"When upserting rows for a table with a row timestamp column (using UPSERT VALUES or UPSERT SELECT), you can explicitly provide the row timestamp value or let Phoenix set it automatically. When not specified, Phoenix sets the row timestamp column value to server-side time. The value also becomes the timestamp of the corresponding row in HBase."},"5739":{"id":"/docs/single-page-2065","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#sample-schema","content":"This sets CREATED_DATE to the value specified in the corresponding bind parameter."},"5740":{"id":"/docs/single-page-2066","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#sample-schema","content":"This sets CREATED_DATE to server-side time."},"5741":{"id":"/docs/single-page-2067","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#sample-schema","content":"This sets CREATED_DATE to the DATE selected from SOURCE_METRICS_TABLE."},"5742":{"id":"/docs/single-page-2068","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#sample-schema","content":"This sets CREATED_DATE in the destination table to the server timestamp."},"5743":{"id":"/docs/single-page-2069","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#sample-schema","content":"When querying with filters on the row timestamp column, Phoenix performs its usual row-key optimizations and can also set scan min/max time ranges appropriately. Using this time range information, HBase can skip store files that do not fall in the target time range, which significantly improves performance, especially for tail-end data queries."},"5744":{"id":"/docs/single-page-2070","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#see-also","content":"The PHOENIX_ROW_TIMESTAMP() function lets you read the underlying HBase row timestamp on any Phoenix table — even one without a declared ROW_TIMESTAMP column — and is indexable for fast time-bounded queries."},"5745":{"id":"/docs/single-page-2071","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#phoenix-row-timestamp","content":"PHOENIX_ROW_TIMESTAMP() is a built-in SQL function that returns the timestamp\nof the row's empty column, which Phoenix updates automatically on every write.\nIt's effectively the row's last-modified time, available on any Phoenix table\nwithout you having to declare or manage a timestamp column yourself. The return\ntype is DATE."},"5746":{"id":"/docs/single-page-2072","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#phoenix-row-timestamp","content":"It can be used in three places, and the third one is what makes it especially\npowerful:"},"5747":{"id":"/docs/single-page-2073","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#phoenix-row-timestamp","content":"As a projection in SELECT."},"5748":{"id":"/docs/single-page-2074","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#phoenix-row-timestamp","content":"As a predicate in WHERE (and JOIN) clauses."},"5749":{"id":"/docs/single-page-2075","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#phoenix-row-timestamp","content":"As the indexed expression in a functional index, which makes time-bounded reads fast even when the table isn't ordered by time."},"5750":{"id":"/docs/single-page-2076","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#phoenix-row-timestamp-read","content":"Project it like any other column:"},"5751":{"id":"/docs/single-page-2077","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#phoenix-row-timestamp-read","content":"The function takes no arguments and is evaluated server-side from the empty cell\nthat Phoenix already maintains for every row."},"5752":{"id":"/docs/single-page-2078","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#phoenix-row-timestamp-where","content":"Use it to bound queries by mutation time, including incremental \"what changed\nsince\" patterns:"},"5753":{"id":"/docs/single-page-2079","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#phoenix-row-timestamp-where","content":"Without an index, these predicates require a full scan of the table. The next\nsection fixes that."},"5754":{"id":"/docs/single-page-2080","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#phoenix-row-timestamp-index","content":"Create a functional index\non the function to make time-bounded reads fast. Phoenix can then seek directly\non the indexed timestamp instead of scanning the data table:"},"5755":{"id":"/docs/single-page-2081","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#phoenix-row-timestamp-index","content":"This is the typical recipe for \"scan rows changed in the last N minutes\" type\nqueries on a table whose primary key isn't time-ordered. Pair with\nuncovered indexes when you\ndon't want to duplicate payload columns into the index."},"5756":{"id":"/docs/single-page-2082","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#phoenix-row-timestamp-index","content":"If your downstream needs a continuous, ordered stream of changes rather than\nperiodic time-bounded scans — including the actual mutation deltas — reach for\nChange Data Capture instead. The functional\nindex pattern here is best suited to ad-hoc time-window reads from the same\nclient that issues regular SQL queries."},"5757":{"id":"/docs/single-page-2083","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#phoenix-row-timestamp-vs-row-timestamp","content":"Two related concepts share the word \"timestamp\" — they are not the same:"},"5758":{"id":"/docs/single-page-2084","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#phoenix-row-timestamp-vs-row-timestamp","content":"Feature"},"5759":{"id":"/docs/single-page-2085","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#phoenix-row-timestamp-vs-row-timestamp","content":"Direction"},"5760":{"id":"/docs/single-page-2086","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#phoenix-row-timestamp-vs-row-timestamp","content":"What it does"},"5761":{"id":"/docs/single-page-2087","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#phoenix-row-timestamp-vs-row-timestamp","content":"ROW_TIMESTAMP column"},"5762":{"id":"/docs/single-page-2088","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#phoenix-row-timestamp-vs-row-timestamp","content":"Write"},"5763":{"id":"/docs/single-page-2089","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#phoenix-row-timestamp-vs-row-timestamp","content":"Designate a primary-key column whose value is written into the underlying HBase row timestamp."},"5764":{"id":"/docs/single-page-2090","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#phoenix-row-timestamp-vs-row-timestamp","content":"PHOENIX_ROW_TIMESTAMP() function"},"5765":{"id":"/docs/single-page-2091","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#phoenix-row-timestamp-vs-row-timestamp","content":"Read"},"5766":{"id":"/docs/single-page-2092","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#phoenix-row-timestamp-vs-row-timestamp","content":"Return the underlying HBase row timestamp Phoenix already maintains on every row's empty cell."},"5767":{"id":"/docs/single-page-2093","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#phoenix-row-timestamp-vs-row-timestamp","content":"PHOENIX_ROW_TIMESTAMP() works on any Phoenix table, regardless of whether\nyou've declared a ROW_TIMESTAMP column. If you have declared one, both\nmechanisms read/write the same underlying timestamp, so PHOENIX_ROW_TIMESTAMP()\nreturns the value of the ROW_TIMESTAMP column for that row."},"5768":{"id":"/docs/single-page-2094","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#paged-queries","content":"Phoenix supports standard SQL constructs to enable paged queries:"},"5769":{"id":"/docs/single-page-2095","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#paged-queries","content":"Row Value Constructors (RVC)"},"5770":{"id":"/docs/single-page-2096","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#paged-queries","content":"OFFSET with LIMIT"},"5771":{"id":"/docs/single-page-2097","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#row-value-constructors-rvc","content":"A row value constructor is an ordered sequence of values delimited by parentheses. For example:"},"5772":{"id":"/docs/single-page-2098","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#row-value-constructors-rvc","content":"Just like regular values, row value constructors may be used in comparison expressions:"},"5773":{"id":"/docs/single-page-2099","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#row-value-constructors-rvc","content":"Row value constructors are compared by conceptually concatenating the values together and comparing them against each other, with the leftmost part being most significant. Section 8.2 (comparison predicates) of the SQL-92 standard explains this in detail, but here are a few examples of predicates that would evaluate to true:"},"5774":{"id":"/docs/single-page-2100","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#row-value-constructors-rvc","content":"Row value constructors may also be used in an IN list expression to efficiently query for a set of rows given the composite primary key columns. For example, the following would be optimized to be a point get of three rows:"},"5775":{"id":"/docs/single-page-2101","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#row-value-constructors-rvc","content":"Another primary use case for row value constructors is to support query-more type functionality by enabling an ordered set of rows to be incrementally stepped through. For example, the following query would step through a set of rows, 20 rows at a time:"},"5776":{"id":"/docs/single-page-2102","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#row-value-constructors-rvc","content":"Assuming that the client binds the three bind variables to the values of the last row processed, the next invocation would find the next 20 rows that match the query. If the columns you supply in your row value constructor match in order the columns from your primary key (or from a secondary index), then Phoenix will be able to turn the row value constructor expression into the start row of your scan. This enables a very efficient mechanism to locate at or after a row."},"5777":{"id":"/docs/single-page-2103","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#offset-with-limit","content":"Use OFFSET to specify the starting row offset into the result set returned by your query and LIMIT to specify the page size."},"5778":{"id":"/docs/single-page-2104","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#offset-with-limit","content":"For example, if page size is 10, then to select the second page, the following query can be used (rows 11 to 20 are returned):"},"5779":{"id":"/docs/single-page-2105","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#offset-with-limit","content":"OFFSET reads and skips rows on either the server or client depending on query type, whereas RVC is more effective for queries on the primary key axis because it can start directly from the provided key."},"5780":{"id":"/docs/single-page-2106","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#salted-tables","content":"Sequential writes in HBase may suffer from region server hotspotting if your row key is monotonically increasing. Salting the row key helps mitigate this problem. See this article for details."},"5781":{"id":"/docs/single-page-2107","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#salted-tables","content":"Phoenix provides a way to transparently salt the row key with a salting byte for a table. Specify this at table creation time with the SALT_BUCKETS table property, using a value from 1 to 256:"},"5782":{"id":"/docs/single-page-2108","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#salted-tables","content":"There are some behavior differences and cautions to be aware of when using a salted table."},"5783":{"id":"/docs/single-page-2109","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#sequential-scan","content":"Since a salted table does not store data in natural key sequence, a strict sequential scan does not return data in natural sorted order. Clauses that force sequential scan behavior (for example, LIMIT) may return rows differently compared to a non-salted table."},"5784":{"id":"/docs/single-page-2110","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#splitting","content":"If no split points are specified, a salted table is pre-split on salt-byte boundaries to ensure load distribution across region servers, including during initial table growth. If split points are provided manually, they must include the salt byte."},"5785":{"id":"/docs/single-page-2111","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#row-key-ordering","content":"Pre-splitting also ensures that entries in each region start with the same salt byte and are therefore locally sorted. During a parallel scan across regions, Phoenix can use this property to perform a client-side merge sort. The resulting scan can still be returned sequentially, as if from a normal table."},"5786":{"id":"/docs/single-page-2112","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#row-key-ordering","content":"This row-key ordered scan can be enabled by setting phoenix.query.rowKeyOrderSaltedTable=true in hbase-site.xml. When enabled, user-specified split points on salted tables are disallowed to ensure each bucket contains only entries with the same salt byte. With this property enabled, a salted table behaves more like a normal table for scans and returns items in row-key order."},"5787":{"id":"/docs/single-page-2113","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#salted-tables-performance","content":"Using salted tables with pre-splitting helps distribute write workload uniformly across region servers, which improves write performance. Our performance evaluation shows that salted tables can achieve up to 80% higher write throughput than non-salted tables."},"5788":{"id":"/docs/single-page-2114","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#salted-tables-performance","content":"Reads from salted tables can also benefit from more uniform data distribution. Our performance evaluation shows improved read performance for queries focused on subsets of data."},"5789":{"id":"/docs/single-page-2115","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#skip-scan","content":"Phoenix uses Skip Scan for intra-row scanning which allows for significant performance improvement over Range Scan when rows are retrieved based on a given set of keys."},"5790":{"id":"/docs/single-page-2116","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#skip-scan","content":"Skip Scan leverages SEEK_NEXT_USING_HINT in HBase filters. It stores information about which key sets or key ranges are being searched for in each column. During filter evaluation, it checks whether a key is in one of the valid combinations or ranges. If not, it computes the next highest key to jump to."},"5791":{"id":"/docs/single-page-2117","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#skip-scan","content":"Input to SkipScanFilter is a List<List<KeyRange>> where the top-level list represents each row-key column (that is, each primary key part), and the inner list represents OR-ed byte-array boundaries."},"5792":{"id":"/docs/single-page-2118","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#skip-scan","content":"Consider the following query:"},"5793":{"id":"/docs/single-page-2119","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#skip-scan","content":"For the query above, the List<List<KeyRange>> passed to SkipScanFilter would look like:"},"5794":{"id":"/docs/single-page-2120","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#skip-scan","content":"Here, [[a - b], [d - e]] represents ranges for KEY1, and [1, 2] represents the keys for KEY2."},"5795":{"id":"/docs/single-page-2121","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#skip-scan","content":"The following diagram illustrates graphically how the skip scan is able to jump around the key space:"},"5796":{"id":"/docs/single-page-2122","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#segment-scan","content":"Segment Scan turns a Phoenix table into N contiguous, non-overlapping key ranges\nthat you can hand out to a pool of workers to drive a parallel full-table scan. It is\nthe natural primitive for ETL exports, table validation/repair tools, bulk\nre-encoding, and anything else that needs to walk every row as fast as the cluster\ncan serve it. Available in Phoenix 5.3.0\n(PHOENIX-7684)."},"5797":{"id":"/docs/single-page-2123","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#segment-scan-when","content":"Reach for Segment Scan when you want to read every row and you'd rather have many\nworkers do it concurrently than one client streaming sequentially. Typical use cases:"},"5798":{"id":"/docs/single-page-2124","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#segment-scan-when","content":"Snapshot exports to a data lake / warehouse."},"5799":{"id":"/docs/single-page-2125","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#segment-scan-when","content":"Backfills or re-encodes (e.g. moving a column from VARBINARY to\nVARBINARY_ENCODED)."},"5800":{"id":"/docs/single-page-2126","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#segment-scan-when","content":"Validation/repair scripts that scrub or hash every row."},"5801":{"id":"/docs/single-page-2127","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#segment-scan-when","content":"DynamoDB-style parallel scan against a Phoenix-backed table."},"5802":{"id":"/docs/single-page-2128","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#segment-scan-when","content":"If you only want to read some rows (e.g. by a key prefix or an indexed predicate),\nissue a normal SQL query — Segment Scan is for full-table fan-out, not selective\nfiltering."},"5803":{"id":"/docs/single-page-2129","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#segment-scan-usage","content":"TOTAL_SEGMENTS() = N in the WHERE clause asks Phoenix to return N segment\nboundaries instead of running the query against the data. The boundaries are\nprojected via the SCAN_START_KEY() and SCAN_END_KEY() functions:"},"5804":{"id":"/docs/single-page-2130","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#segment-scan-usage","content":"You get back one row per segment with two VARBINARY columns: the start key and\nthe end key of that range, as raw HBase row-key bytes. Either may be empty — an\nempty start key means \"from the beginning of the table\"; an empty end key means\n\"to the end of the table\"."},"5805":{"id":"/docs/single-page-2131","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#segment-scan-usage","content":"To scan a segment, pass each (start_key, end_key) pair back into a regular Phoenix\nSQL query, using SCAN_START_KEY() and SCAN_END_KEY() as predicates with the\nbytes bound as parameters:"},"5806":{"id":"/docs/single-page-2132","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#segment-scan-usage","content":"Phoenix translates these predicates into the underlying HBase scan bounds for you,\nso a worker pool can stay in plain SQL — each worker runs its own query against one\nsegment, in parallel."},"5807":{"id":"/docs/single-page-2133","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#segment-scan-count","content":"The number of segments returned is min(N, num_regions):"},"5808":{"id":"/docs/single-page-2134","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#segment-scan-count","content":"If N <= num_regions, Phoenix bundles consecutive regions together so you get\nexactly N segments. The grouping is as even as possible — with r = num_regions\nmod N segments getting one extra region."},"5809":{"id":"/docs/single-page-2135","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#segment-scan-count","content":"If N > num_regions, you simply get one segment per region. Phoenix will not\nsplit a region's key range into smaller sub-ranges for you, so the maximum\nachievable parallelism is bounded by the number of regions in the table."},"5810":{"id":"/docs/single-page-2136","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#segment-scan-count","content":"If you want more parallelism than your region count permits, pre-split the table or\nsalt it; Segment Scan respects whatever the current region layout is."},"5811":{"id":"/docs/single-page-2137","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#segment-scan-count","content":"N must be a positive integer. Passing 0 or a negative value returns SQL error\ncode 221 (\"TOTAL_SEGMENTS() value must be greater than 0\")."},"5812":{"id":"/docs/single-page-2138","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#segment-scan-how","content":"TOTAL_SEGMENTS() is a marker, not a server-side function. The Phoenix planner sees\nit during compilation and replaces the query plan entirely with a client-side plan\nthat:"},"5813":{"id":"/docs/single-page-2139","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#segment-scan-how","content":"Looks up the table's current region locations."},"5814":{"id":"/docs/single-page-2140","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#segment-scan-how","content":"Buckets them into min(N, num_regions) contiguous groups."},"5815":{"id":"/docs/single-page-2141","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#segment-scan-how","content":"Returns each group's combined (start_key, end_key) as a result row."},"5816":{"id":"/docs/single-page-2142","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#segment-scan-how","content":"No region-server scan is issued for this query — it's a metadata-only operation, so\nit's cheap to call, and it doesn't read or count any of the actual data."},"5817":{"id":"/docs/single-page-2143","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#segment-scan-watch","content":"Region layout changes between discovery and scan. The segments you got back\nreflect the region layout at the time of the call. If the table splits or merges\nbetween segment discovery and your parallel scan, your (start_key, end_key)\nranges are still valid as byte ranges — they just may not align with current\nregions. The parallel scan still works; you just lose some of the\nregion-locality benefit."},"5818":{"id":"/docs/single-page-2144","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#segment-scan-watch","content":"Each segment can still hold a lot of data. Segments correspond to one or more\nwhole regions. If your regions are large or unevenly populated, individual\nworkers may end up scanning more than others. Use this with the standard scan\ncontrols (paging, batch sizes) rather than relying on Segment Scan to balance row\ncounts."},"5819":{"id":"/docs/single-page-2145","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#segment-scan-watch","content":"Segment Scan describes ranges; it doesn't scan. The parallel scan itself is\nyour responsibility — a worker pool takes one (start_key, end_key) per task and\nruns a regular Phoenix query bounded with SCAN_START_KEY() = ? AND SCAN_END_KEY()\n= ?."},"5820":{"id":"/docs/single-page-2146","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#table-sampling","content":"To support table sampling (similar to PostgreSQL and T-SQL syntax), a TABLESAMPLE clause was incorporated into aliased table references as of Phoenix 4.12. The general syntax is described here. This feature limits the number of rows returned from a table to a percentage of rows. See PHOENIX-153 for implementation details."},"5821":{"id":"/docs/single-page-2147","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#table-sampling","content":"This feature is implemented with a Bernoulli trial and a consistent-hashing-based table sampler to achieve Bernoulli sampling on a given row population. Given a sampling rate, it leverages Phoenix statistics and HBase region distribution to perform table sampling."},"5822":{"id":"/docs/single-page-2148","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#table-sampling","content":"As part of statistics collection, a guidepost (a row reference) is created at equidistant byte intervals. When sampling is required, a Bernoulli trial process is applied repeatedly on each guidepost in each region with a probability proportional to the sampling rate. An included guidepost results in all rows between it and the next guidepost being included in the sample population."},"5823":{"id":"/docs/single-page-2149","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#table-sampling-performance","content":"Sampling on a table with a sampling rate of 100% costs roughly the same computational resources as a query without sampling.\nResource consumption drops quickly as sampling rate decreases. In general, the amortized complexity of the sampling process is O(k + mn), where:"},"5824":{"id":"/docs/single-page-2150","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#table-sampling-performance","content":"n is the number of regions in the sampled HBase table."},"5825":{"id":"/docs/single-page-2151","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#table-sampling-performance","content":"m is the number of guideposts."},"5826":{"id":"/docs/single-page-2152","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#table-sampling-performance","content":"k is the sampled population size."},"5827":{"id":"/docs/single-page-2153","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#repeatable","content":"Repeatable means repeated sampling on the same table returns the same sampled result."},"5828":{"id":"/docs/single-page-2154","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#repeatable","content":"Repeatability is enabled by applying a consistent-hashing process to the binary representation of the start row key of each guidepost in each region during sampling. By default, an FNV1 implementation with lazy modulo is used. See FNV1."},"5829":{"id":"/docs/single-page-2155","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#table-sampling-examples","content":"To sample a table, execute a query such as the following. The sampling rate is a numeric value between 0 and 100, inclusive."},"5830":{"id":"/docs/single-page-2156","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#table-sampling-examples","content":"More examples:"},"5831":{"id":"/docs/single-page-2157","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#table-sampling-examples","content":"To use with aggregation:"},"5832":{"id":"/docs/single-page-2158","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#table-sampling-examples","content":"To explain a sampled query:"},"5833":{"id":"/docs/single-page-2159","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#table-sampling-tuning","content":"Due to the sampling process, TABLESAMPLE should be used with caution. For example, a join of two tables is likely to return a match for each row in both tables; however, when sampling is applied to one or both tables, join results may differ from non-sampled expectations."},"5834":{"id":"/docs/single-page-2160","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#table-sampling-tuning","content":"Statistics should be collected to achieve the best sampling accuracy. To turn on statistics collection, refer to Statistics Collection."},"5835":{"id":"/docs/single-page-2161","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#table-sampling-tuning","content":"A denser guidepost setting improves sampling accuracy, but may reduce performance. A comparison is shown below."},"5836":{"id":"/docs/single-page-2162","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#views","content":"The standard SQL view syntax (with some limitations) is now supported by Phoenix to enable multiple virtual tables to all share the same underlying physical HBase table. This is important in HBase as there are limits to the number of regions which HBase can manage. Limiting the number of tables can help limit the number of regions in a cluster."},"5837":{"id":"/docs/single-page-2163","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#views","content":"For example, given the following table definition that defines a base table to collect product metrics:"},"5838":{"id":"/docs/single-page-2164","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#views","content":"You may define the following view:"},"5839":{"id":"/docs/single-page-2165","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#views","content":"In this case, the same underlying physical HBase table (i.e. PRODUCT_METRICS) stores all of the data.\nNotice that unlike with standard SQL views, you may define additional columns for your view. The view inherits all of the columns from its base table, in addition to being able to optionally add new KeyValue columns. You may also add these columns after-the-fact with an ALTER VIEW statement."},"5840":{"id":"/docs/single-page-2166","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#views","content":"NOTE: Phoenix 4.15.0 onwards contains PHOENIX-4810 which introduces a new endpoint coprocessor on the SYSTEM.CHILD_LINK table for adding parent->child links, whenever a view is created. Thus, when namespace mapping is enabled, users that wish to create views will need to be granted EXEC permissions on SYSTEM.CHILD_LINK in order to be able to invoke this coprocessor."},"5841":{"id":"/docs/single-page-2167","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#updatable-views","content":"If your view uses only simple equality expressions in the WHERE clause, you are also allowed to issue DML against the view. These views are termed updatable views. For example, in this case you could issue the following UPSERT statement:"},"5842":{"id":"/docs/single-page-2168","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#updatable-views","content":"In this case, the row will be stored in the PRODUCT_METRICS HBase table and the metric_type column value will be inferred to be 'm' since the VIEW defines it as such."},"5843":{"id":"/docs/single-page-2169","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#updatable-views","content":"Also, queries done through the view will automatically apply the WHERE clause filter. For example:"},"5844":{"id":"/docs/single-page-2170","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#updatable-views","content":"This would sum all the dropped_calls across all product_metrics with a metric_type of 'm' and a carrier of 'Verizon'."},"5845":{"id":"/docs/single-page-2171","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#read-only-views","content":"Views may also be defined with more complex WHERE clauses, but in that case you cannot issue DML against them as you'll get a ReadOnlyException. You are still allowed to query through them and their WHERE clauses will be in effect as with standard SQL views."},"5846":{"id":"/docs/single-page-2172","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#read-only-views","content":"As expected, you may create a VIEW on another VIEW as well to further filter the data set. The same rules as above apply: if only simple equality expressions are used in the VIEW and its parent VIEW(s), the new view is updatable as well, otherwise it's read-only."},"5847":{"id":"/docs/single-page-2173","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#read-only-views","content":"Note that the previous support for creating a read-only VIEW directly over an HBase table is still supported."},"5848":{"id":"/docs/single-page-2174","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#indexes-on-views","content":"In addition, you may create an INDEX over a VIEW, just as with a TABLE. This is particularly useful to improve query performance over newly added columns on a VIEW, since it provides a way of doing point lookups based on these column values. Note that until PHOENIX-1499 gets implemented, an INDEX over a VIEW is only maintained if the updates are made through the VIEW (as opposed to through the underlying TABLE)."},"5849":{"id":"/docs/single-page-2175","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#views-limitations","content":"Views have the following restrictions:"},"5850":{"id":"/docs/single-page-2176","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#views-limitations","content":"An INDEX over a VIEW is only maintained if the updates are made through the VIEW. Updates made through the underlying TABLE or the parent VIEW will not be reflected in the index (PHOENIX-1499)."},"5851":{"id":"/docs/single-page-2177","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#views-limitations","content":"A primary key column may not be added to a VIEW when its base table has a primary key constraint that ends with a variable-length column (PHOENIX-2157)."},"5852":{"id":"/docs/single-page-2178","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#views-limitations","content":"A VIEW may be defined over only a single table through a simple SELECT * query. You may not create a VIEW over multiple joined tables or over aggregations (PHOENIX-1505, PHOENIX-1506)."},"5853":{"id":"/docs/single-page-2179","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#views-limitations","content":"When a column is added to a VIEW, the new column is not automatically added to child VIEWs (PHOENIX-2054). The workaround is to manually add the column to child VIEWs."},"5854":{"id":"/docs/single-page-2180","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#views-limitations","content":"All columns must be projected into a VIEW when it is created (that is, only CREATE VIEW ... AS SELECT * is supported). You may drop non-primary-key columns inherited from the base table after creation using ALTER VIEW. Providing a subset of columns or expressions in the SELECT clause is planned for a future release (PHOENIX-1507)."},"5855":{"id":"/docs/single-page-2181","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#ttl","content":"Phoenix supports per-row time-to-live (TTL) so that rows can be expired and removed\nwithout an application-issued DELETE. There are three flavors, and one orthogonal\ntable property — IS_STRICT_TTL — that controls how aggressively expired rows are\nhidden from reads."},"5856":{"id":"/docs/single-page-2182","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#time-based-ttl","content":"Set a numeric value (in seconds) on the TTL table property at CREATE TABLE time\nto age every row out a fixed duration after its cell timestamp:"},"5857":{"id":"/docs/single-page-2183","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#time-based-ttl","content":"Rows older than the TTL are removed by Phoenix compaction during HBase region\ncompactions. Time-based TTL is the right choice when retention is a flat duration\nthat applies uniformly to every row in the table."},"5858":{"id":"/docs/single-page-2184","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#view-ttl-summary","content":"Each view over a shared base table can set its own retention\nwindow, so different tenants or use cases can age data out independently without\nsplitting the underlying table. See View TTL for the\nfull feature."},"5859":{"id":"/docs/single-page-2185","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#conditional-ttl-summary","content":"Express row expiration as a SQL boolean expression evaluated against the row's own\ncolumn values, instead of a fixed duration. A row is considered expired the moment\nthe expression evaluates to TRUE for that row. See\nConditional TTL for the full feature."},"5860":{"id":"/docs/single-page-2186","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#strict-vs-relaxed-ttl","content":"IS_STRICT_TTL is a table property that controls how strictly expired rows are\nhidden from reads. It applies to every flavor of TTL above — time-based, view,\nand conditional. The default is true (strict)."},"5861":{"id":"/docs/single-page-2187","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#strict-vs-relaxed-ttl","content":"Mode"},"5862":{"id":"/docs/single-page-2188","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#strict-vs-relaxed-ttl","content":"Behavior"},"5863":{"id":"/docs/single-page-2189","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#strict-vs-relaxed-ttl","content":"Strict (IS_STRICT_TTL = true, default)"},"5864":{"id":"/docs/single-page-2190","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#strict-vs-relaxed-ttl","content":"Expired rows are filtered out on every read path — they're invisible to queries the moment they expire."},"5865":{"id":"/docs/single-page-2191","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#strict-vs-relaxed-ttl","content":"Relaxed (IS_STRICT_TTL = false)"},"5866":{"id":"/docs/single-page-2192","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#strict-vs-relaxed-ttl","content":"Expired rows remain visible to readers until major compaction physically removes them. Similar to DynamoDB's TTL expiry behavior."},"5867":{"id":"/docs/single-page-2193","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#strict-vs-relaxed-ttl","content":"The trade-off:"},"5868":{"id":"/docs/single-page-2194","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#strict-vs-relaxed-ttl","content":"Strict gives you a strong \"expired = invisible\" guarantee. It's the right\nchoice when retention is a correctness or compliance concern."},"5869":{"id":"/docs/single-page-2195","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#strict-vs-relaxed-ttl","content":"Relaxed has a cheaper write path. The largest gain is with\nConditional TTL: under strict mode, every\nmutation reads the current row state to evaluate the TTL expression, which adds\nlatency. Relaxed mode skips that pre-read."},"5870":{"id":"/docs/single-page-2196","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#strict-vs-relaxed-ttl","content":"You can also switch a table between modes:"},"5871":{"id":"/docs/single-page-2197","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#strict-vs-relaxed-ttl","content":"Start with the default. Switch to relaxed only when the cheaper write path is the\nright trade-off for your workload and eventual visibility of expired rows is\nacceptable for your readers."},"5872":{"id":"/docs/single-page-2198","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#view-ttl","content":"A Phoenix view is a logical table that shares a single physical\nHBase table with its sibling views. View TTL lets each view define its own data\nretention policy on top of that shared table. Rows that have outlived their view's TTL\ndisappear from queries against that view and are eventually removed in the background —\nwithout affecting any other view (or the base table). Available in Phoenix 5.3.0\n(PHOENIX-6978)."},"5873":{"id":"/docs/single-page-2199","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#view-ttl-when","content":"The classic case is multi-tenant retention: one shared base table, many tenant\nviews, each tenant gets a different retention window driven by its plan, region, or\ncontract."},"5874":{"id":"/docs/single-page-2200","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#view-ttl-when","content":"Scenario"},"5875":{"id":"/docs/single-page-2201","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#view-ttl-when","content":"View TTL fit"},"5876":{"id":"/docs/single-page-2202","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#view-ttl-when","content":"Per-tenant retention windows on one shared base table"},"5877":{"id":"/docs/single-page-2203","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#view-ttl-when","content":"Yes"},"5878":{"id":"/docs/single-page-2204","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#view-ttl-when","content":"Per-use-case retention (e.g., \"raw events 7 days, audit 1 year\")"},"5879":{"id":"/docs/single-page-2205","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#view-ttl-when","content":"Yes"},"5880":{"id":"/docs/single-page-2206","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#view-ttl-when","content":"Per-tenant extra columns on top of the shared base table (each tenant's view)"},"5881":{"id":"/docs/single-page-2207","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#view-ttl-when","content":"Yes — views can extend the base schema, View TTL still applies"},"5882":{"id":"/docs/single-page-2208","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#view-ttl-when","content":"Same retention for the entire physical table"},"5883":{"id":"/docs/single-page-2209","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#view-ttl-when","content":"Use a regular table-level TTL instead"},"5884":{"id":"/docs/single-page-2210","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#view-ttl-when","content":"Retention based on row content rather than age"},"5885":{"id":"/docs/single-page-2211","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#view-ttl-when","content":"Use Conditional TTL"},"5886":{"id":"/docs/single-page-2212","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#view-ttl-when","content":"Different base-table schemas per tenant (different PK, different core columns)"},"5887":{"id":"/docs/single-page-2213","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#view-ttl-when","content":"Use separate tables — View TTL doesn't apply"},"5888":{"id":"/docs/single-page-2214","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#view-ttl-when","content":"If the retention rule is the same for everyone reading the table, set TTL on the\ntable itself; you don't need View TTL."},"5889":{"id":"/docs/single-page-2215","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#view-ttl-enable","content":"View TTL is off by default. Enable it cluster-wide by setting this server-side\nproperty and restarting region servers:"},"5890":{"id":"/docs/single-page-2216","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#view-ttl-enable","content":"While the feature is disabled, attempts to declare TTL on a view return a SQL error\nexplaining the property must be turned on."},"5891":{"id":"/docs/single-page-2217","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#view-ttl-define","content":"Set TTL (in seconds) as a property on CREATE VIEW. Different views over the same\nbase table can use different values:"},"5892":{"id":"/docs/single-page-2218","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#view-ttl-define","content":"Adjust the value later, or remove the TTL entirely:"},"5893":{"id":"/docs/single-page-2219","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#view-ttl-inheritance","content":"A child view inherits its parent view's TTL. Child views cannot override the\nparent's value — the TTL belongs to the view that owns it. If you need different\nretention windows for two slices of the same parent, create them as siblings under a\ncommon parent rather than nesting."},"5894":{"id":"/docs/single-page-2220","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#view-ttl-inheritance","content":"In multi-tenant mode, each tenant connection sees its own view; setting TTL on a\ntenant view applies retention to that tenant's slice only."},"5895":{"id":"/docs/single-page-2221","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#view-ttl-how","content":"Two things happen to expired rows:"},"5896":{"id":"/docs/single-page-2222","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#view-ttl-how","content":"Read-time filter (immediate). Whenever a query goes through a view, Phoenix\nfilters out rows whose age exceeds the view's TTL — so as soon as a row is \"too\nold\" for a view, it disappears from queries against that view, even before\nphysical deletion."},"5897":{"id":"/docs/single-page-2223","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#view-ttl-how","content":"Phoenix compaction (eventual). Expired rows are physically removed by\nPhoenix's compaction during HBase region compactions. This reclaims disk and\nstops the rows showing up via lower-level scans. There is no separate cleanup\njob — physical removal happens whenever the underlying HBase regions compact."},"5898":{"id":"/docs/single-page-2224","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#view-ttl-conditional","content":"A view's TTL can also be a SQL boolean expression instead of a number, in which\ncase it follows the Conditional TTL rules. This\nunlocks expiry based on row content (e.g. expire 30 days after STATUS becomes\n'CLOSED'). The IS_STRICT_TTL property described in\nStrict vs Relaxed TTL applies to view\nTTL too."},"5899":{"id":"/docs/single-page-2225","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#conditional-ttl","content":"Conditional TTL lets you express row expiration as a SQL boolean expression\nevaluated against the row's own column values, instead of a fixed time-since-write\nnumber. A row is considered expired the moment the expression evaluates to TRUE for\nthat row. Available in Phoenix 5.3.0\n(PHOENIX-7170)."},"5900":{"id":"/docs/single-page-2226","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#conditional-ttl-when","content":"Conditional TTL fits whenever \"expired\" is an application concept, not just an\nage. Some typical cases:"},"5901":{"id":"/docs/single-page-2227","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#conditional-ttl-when","content":"\"Delete this row 30 days after STATUS becomes 'CLOSED'.\""},"5902":{"id":"/docs/single-page-2228","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#conditional-ttl-when","content":"\"Expire when RETAIN_UNTIL has passed.\""},"5903":{"id":"/docs/single-page-2229","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#conditional-ttl-when","content":"\"Keep failed records for a week, successful ones for an hour.\""},"5904":{"id":"/docs/single-page-2230","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#conditional-ttl-when","content":"\"Expire soft-deleted rows (is_deleted = TRUE) after a grace period.\""},"5905":{"id":"/docs/single-page-2231","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#conditional-ttl-when","content":"If retention is a flat duration that applies uniformly to all rows, use the regular\ntime-based TTL property. If different views over the same shared table need\ndifferent retention rules, look at View TTL — it composes\nwith conditional TTL."},"5906":{"id":"/docs/single-page-2232","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#conditional-ttl-define","content":"Pass a SQL boolean expression as the TTL table property at CREATE TABLE (or\nCREATE VIEW) time. The expression may reference any column of the table:"},"5907":{"id":"/docs/single-page-2233","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#conditional-ttl-define","content":"Update or remove the expression later with ALTER TABLE:"},"5908":{"id":"/docs/single-page-2234","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#conditional-ttl-define","content":"What \"expired\" means in practice:"},"5909":{"id":"/docs/single-page-2235","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#conditional-ttl-define","content":"Read-time: any query touching the row evaluates the TTL expression server-side\nand skips the row if it returns TRUE. Rows become invisible the moment they\nmatch the predicate, regardless of physical state."},"5910":{"id":"/docs/single-page-2236","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#conditional-ttl-define","content":"Phoenix compaction: expired rows are physically removed by Phoenix's\ncompaction during HBase region compactions. There is no separate cleanup job —\nphysical removal happens whenever the underlying regions compact."},"5911":{"id":"/docs/single-page-2237","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#conditional-ttl-write-path","content":"IS_STRICT_TTL is a table property that applies to any kind of TTL — see\nStrict vs Relaxed TTL for the full\ndescription."},"5912":{"id":"/docs/single-page-2238","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#conditional-ttl-write-path","content":"The conditional-TTL-specific cost is in the write path: with strict (the\ndefault), every mutation reads the current row state on the server to evaluate the\nTTL expression, which adds latency. With relaxed (IS_STRICT_TTL = false), that\nextra row read is skipped — at the cost of expired rows remaining visible to\nreaders until major compaction physically removes them."},"5913":{"id":"/docs/single-page-2239","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#conditional-ttl-limitations","content":"Conditional TTL requires the table to have a single column family."},"5914":{"id":"/docs/single-page-2240","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#conditional-ttl-limitations","content":"The TTL expression must be a valid Phoenix SQL boolean expression and may only\nreference columns of the same table — no joins, no subqueries."},"5915":{"id":"/docs/single-page-2241","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#conditional-ttl-limitations","content":"The classic time-based TTL = N (seconds) and conditional TTL = '<expr>' use the\nsame property; what you pass in determines which mode you get. You can't have both\nat once."},"5916":{"id":"/docs/single-page-2242","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#highlights","content":"Multi-tenancy in Phoenix works via a combination of multi-tenant tables and tenant-specific connections (detailed below)."},"5917":{"id":"/docs/single-page-2243","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#highlights","content":"Tenants open tenant-specific connections to Phoenix. These connections can only access data that belongs to the tenant."},"5918":{"id":"/docs/single-page-2244","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#highlights","content":"Tenants only see their own data in multi-tenant tables and can see all data in regular tables."},"5919":{"id":"/docs/single-page-2245","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#highlights","content":"In order to add their own columns, tenants create tenant-specific views on top of multi-tenant tables and add their own columns to the views."},"5920":{"id":"/docs/single-page-2246","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#multi-tenant-tables","content":"Multi-tenant tables in Phoenix are regular tables declared with the MULTI_TENANT=true DDL property. They work in conjunction with tenant-specific connections (detailed below) to ensure tenants only see their own data in these tables. The first primary key column of a multi-tenant table identifies the tenant. For example:"},"5921":{"id":"/docs/single-page-2247","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#multi-tenant-tables","content":"The column that identifies the tenant may have any name, but it must be of type VARCHAR or CHAR. Regular Phoenix connections work with these tables without tenant constraints, including access across tenant boundaries."},"5922":{"id":"/docs/single-page-2248","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#tenant-specific-connections","content":"Tenants are identified by the presence or absence of the TenantId property at JDBC connection time. A connection with a non-null TenantId is tenant-specific. A connection with an unspecified or null TenantId is a regular connection. A tenant-specific connection may query only:"},"5923":{"id":"/docs/single-page-2249","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#tenant-specific-connections","content":"all data in non-multi-tenant (global) tables, that is, tables created with a regular connection without MULTI_TENANT=true."},"5924":{"id":"/docs/single-page-2250","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#tenant-specific-connections","content":"their own data in multi-tenant tables."},"5925":{"id":"/docs/single-page-2251","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#tenant-specific-connections","content":"their own schema, meaning it sees only tenant-specific views created by that tenant (detailed below)."},"5926":{"id":"/docs/single-page-2252","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#tenant-specific-connections","content":"For example, a tenant-specific connection is established like this:"},"5927":{"id":"/docs/single-page-2253","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#tenant-specific-views-optional","content":"Tenant-specific views may only be created using tenant-specific connections. They are created the same way as views, however the base table must be a multi-tenant table or another view that eventually points to one. Tenant-specific views are typically used when new columns and/or filter criteria, specific to that tenant, are required. Otherwise the base table may be used directly through a tenant-specific connection as described above."},"5928":{"id":"/docs/single-page-2254","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#tenant-specific-views-optional","content":"For example, a tenant-specific view may be defined as follows:"},"5929":{"id":"/docs/single-page-2255","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#tenant-specific-views-optional","content":"The tenant_id column is neither visible nor accessible from a tenant-specific view. Any reference to it causes a ColumnNotFoundException. As with any Phoenix view, whether the view is updatable follows the rules described here. In addition, indexes may be added to tenant-specific views just like regular tables and views (with these limitations)."},"5930":{"id":"/docs/single-page-2256","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#tenant-data-isolation","content":"Any DML or query performed on multi-tenant tables using a tenant-specific connection is automatically constrained to that tenant’s data. For UPSERT, Phoenix automatically populates the tenant_id column with the tenant ID specified at connection time. For query and DELETE operations, a WHERE clause is transparently added so operations only see data for the current tenant."},"5931":{"id":"/docs/single-page-2257","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#dynamic-columns","content":"Sometimes defining a static schema up front is not feasible. Instead, a subset of columns may be specified at table create time while the rest are specified at query time. As of Phoenix 1.2, dynamic columns are supported by allowing column definitions in parentheses after the table name in the FROM clause of a SELECT statement. Although this is not standard SQL, it is useful for leveraging the late-binding capability of HBase."},"5932":{"id":"/docs/single-page-2258","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#dynamic-columns","content":"For example:"},"5933":{"id":"/docs/single-page-2259","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#dynamic-columns","content":"You might define only a subset of event columns at create time, because each event type can have different properties:"},"5934":{"id":"/docs/single-page-2260","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#dynamic-columns","content":"To upsert a row with dynamic columns:"},"5935":{"id":"/docs/single-page-2261","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#varbinary-encoded","content":"VARBINARY_ENCODED is the safe choice whenever you need a variable-length binary\ncolumn that participates in ordering: a non-trailing column of a composite primary\nkey, a secondary-index key, or a row value constructor used for paged queries.\nIntroduced in Phoenix 5.3.0\n(PHOENIX-7357)."},"5936":{"id":"/docs/single-page-2262","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#varbinary-encoded-when","content":"Pick VARBINARY_ENCODED over VARBINARY when any of the following is true:"},"5937":{"id":"/docs/single-page-2263","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#varbinary-encoded-when","content":"The column is part of a multi-column primary key and is not the last PK column."},"5938":{"id":"/docs/single-page-2264","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#varbinary-encoded-when","content":"The column is used as part of an index key."},"5939":{"id":"/docs/single-page-2265","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#varbinary-encoded-when","content":"You scan with row value constructors (e.g., WHERE (a, b) > (?, ?) for keyset\npagination) and one of the columns is binary."},"5940":{"id":"/docs/single-page-2266","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#varbinary-encoded-when","content":"The binary value can contain 0x00 bytes and you cannot guarantee it never will."},"5941":{"id":"/docs/single-page-2267","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#varbinary-encoded-when","content":"Stick with VARBINARY only when the column is purely a payload — i.e. it's never used\nin a WHERE, ORDER BY, index, or non-trailing PK position."},"5942":{"id":"/docs/single-page-2268","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#varbinary-encoded-when","content":"The reason: VARBINARY uses 0x00 as a separator between columns in the encoded row\nkey, so an embedded 0x00 byte in an earlier PK column collides with the separator and\nbreaks ordering. VARBINARY_ENCODED escapes zero bytes during encoding so the\nbyte-by-byte sort order of the encoded form matches the lexicographic order of the\noriginal bytes. The transform is reversed on read, so application code keeps seeing the\noriginal bytes."},"5943":{"id":"/docs/single-page-2269","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#varbinary-encoded-defining","content":"Use it like any other column type — including in any position of a composite key:"},"5944":{"id":"/docs/single-page-2270","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#varbinary-encoded-defining","content":"Literals use the standard hex form x'...' in both UPSERT and WHERE:"},"5945":{"id":"/docs/single-page-2271","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#varbinary-encoded-paging","content":"The intended use case for VARBINARY_ENCODED in a composite key is keyset pagination\nthat resumes from the last seen row. Because the type orders correctly, you can drive\nthis with a row value constructor without any application-level encoding:"},"5946":{"id":"/docs/single-page-2272","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#varbinary-encoded-paging","content":"Bind the two parameters to the last row seen by the previous page; Phoenix turns the\npredicate into an efficient seek directly to the resume point. See\nPaged Queries for the broader pattern."},"5947":{"id":"/docs/single-page-2273","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#varbinary-encoded-sizing","content":"The encoded form is at most 1 extra byte per 0x00 byte in the value. For typical\ninputs (random IDs, hashes, opaque tokens) the overhead is effectively zero. Plan a bit\nof headroom only when values are known to contain many zero bytes (e.g. fixed-width\nintegers stored raw with a lot of high-order zeros — in which case a fixed-width\nUNSIGNED_* type is usually a better choice anyway)."},"5948":{"id":"/docs/single-page-2274","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#varbinary-encoded-migrating","content":"Phoenix does not support changing a column's type in place via ALTER TABLE, so\nmoving an existing VARBINARY column to VARBINARY_ENCODED is a copy-and-switch\noperation:"},"5949":{"id":"/docs/single-page-2275","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#varbinary-encoded-migrating","content":"Create a new table with the same schema but with the affected columns declared as\nVARBINARY_ENCODED."},"5950":{"id":"/docs/single-page-2276","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#varbinary-encoded-migrating","content":"Backfill: UPSERT INTO new_table SELECT ... FROM old_table; (Phoenix re-encodes\nthe values into the new physical layout for you)."},"5951":{"id":"/docs/single-page-2277","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#varbinary-encoded-migrating","content":"Cut over reads and writes to the new table, then drop the old one."},"5952":{"id":"/docs/single-page-2278","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#varbinary-encoded-migrating","content":"For a brand-new column that you're adding to an existing table, you can declare it as\nVARBINARY_ENCODED directly with ALTER TABLE ... ADD ...."},"5953":{"id":"/docs/single-page-2279","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bson","content":"BSON is a native column type for storing schemaless document data alongside your\nrelational columns. Documents are stored in Binary JSON — a\ncompact, length-prefixed format that is cheap to parse server-side and supports the\nfull set of value types (strings, numbers, dates, binary, booleans, nulls, arrays,\nnested objects). Introduced in Phoenix 5.3.0\n(PHOENIX-7330)."},"5954":{"id":"/docs/single-page-2280","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bson","content":"The point of the type is not just to hold documents — it's that Phoenix can read,\nfilter, and mutate individual fields on the server without the client ever\ndeserializing the whole document."},"5955":{"id":"/docs/single-page-2281","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bson-when","content":"Use case"},"5956":{"id":"/docs/single-page-2282","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bson-when","content":"Recommended type"},"5957":{"id":"/docs/single-page-2283","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bson-when","content":"Schema is well-known and stable"},"5958":{"id":"/docs/single-page-2284","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bson-when","content":"Regular relational columns"},"5959":{"id":"/docs/single-page-2285","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bson-when","content":"A few optional/sparse fields on otherwise relational rows"},"5960":{"id":"/docs/single-page-2286","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bson-when","content":"Dynamic Columns"},"5961":{"id":"/docs/single-page-2287","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bson-when","content":"Variable-shape documents per row, server-side reads/filters/updates needed"},"5962":{"id":"/docs/single-page-2288","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bson-when","content":"BSON"},"5963":{"id":"/docs/single-page-2289","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bson-when","content":"Variable-shape documents but the server never inspects them"},"5964":{"id":"/docs/single-page-2290","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bson-when","content":"VARCHAR (raw JSON) or VARBINARY"},"5965":{"id":"/docs/single-page-2291","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bson-when","content":"Common cases for BSON:"},"5966":{"id":"/docs/single-page-2292","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bson-when","content":"DynamoDB-style application objects backed by Phoenix."},"5967":{"id":"/docs/single-page-2293","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bson-when","content":"Customer / configuration / preferences documents that vary per row."},"5968":{"id":"/docs/single-page-2294","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bson-when","content":"Event payloads where downstream queries need to filter or project specific fields."},"5969":{"id":"/docs/single-page-2295","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bson-when","content":"Counters and per-field updates that must be atomic without rewriting the whole row."},"5970":{"id":"/docs/single-page-2296","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bson-defining","content":"You may pass a JSON string literal as shown — Phoenix parses and converts it to BSON on\nwrite — or bind a pre-built BSON document via JDBC."},"5971":{"id":"/docs/single-page-2297","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bson-defining","content":"A BSON column may also serve as a primary-key column. In a composite primary key it\nmust be the last column of the key (so the row-key encoding stays bounded for the\npreceding columns)."},"5972":{"id":"/docs/single-page-2298","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bson-paths","content":"All three BSON functions address fields with a small path syntax:"},"5973":{"id":"/docs/single-page-2299","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bson-paths","content":"name — top-level field"},"5974":{"id":"/docs/single-page-2300","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bson-paths","content":"addresses[0] — first element of an array"},"5975":{"id":"/docs/single-page-2301","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bson-paths","content":"addresses[0].city — nested field"},"5976":{"id":"/docs/single-page-2302","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bson-paths","content":"preferences.theme — nested field on a sub-document"},"5977":{"id":"/docs/single-page-2303","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bson-value","content":"BSON_VALUE(bson_column, field_path, target_type [, default]) projects a single field\nout of a document and returns it as the requested Phoenix data type. Returns NULL if\nthe path is missing — or the supplied default if you provide one."},"5978":{"id":"/docs/single-page-2304","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bson-value","content":"BSON_VALUE can also return a sub-document (use 'BSON' as the target type) and\nreturn raw binary fields as VARBINARY_ENCODED. A companion function\nBSON_VALUE_TYPE(bson_column, field_path) returns the BSON type of the field as a\nstring (e.g. 'STRING', 'INT32', 'DOCUMENT', 'ARRAY')."},"5979":{"id":"/docs/single-page-2305","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bson-condition-expression","content":"BSON_CONDITION_EXPRESSION(bson_column, expression) evaluates a boolean expression\nover a document and returns TRUE or FALSE. Use it in a WHERE clause when you\nwant to filter on multiple document fields at once, or test for the existence/shape\nof fields, without the verbosity of stacking multiple BSON_VALUE calls."},"5980":{"id":"/docs/single-page-2306","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bson-condition-expression","content":"The expression language is intentionally small and DynamoDB-flavored:"},"5981":{"id":"/docs/single-page-2307","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bson-condition-expression","content":"Comparisons: =, <> (or !=), <, <=, >, >="},"5982":{"id":"/docs/single-page-2308","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bson-condition-expression","content":"Boolean composition: AND, OR, NOT, parentheses"},"5983":{"id":"/docs/single-page-2309","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bson-condition-expression","content":"Ranges and sets: BETWEEN ... AND ..., IN (...), IS NULL"},"5984":{"id":"/docs/single-page-2310","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bson-condition-expression","content":"Field presence: field_exists(name), field_not_exists(name)"},"5985":{"id":"/docs/single-page-2311","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bson-condition-expression","content":"String/array helpers: begins_with(field, value), contains(field, value)"},"5986":{"id":"/docs/single-page-2312","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bson-condition-expression","content":"Type and size: field_type(field, 'STRING' | 'NUMBER' | ...), size(field)"},"5987":{"id":"/docs/single-page-2313","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bson-condition-expression","content":"The expression is evaluated server-side, so rows are filtered before they cross the\nnetwork."},"5988":{"id":"/docs/single-page-2314","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bson-update-expression","content":"BSON_UPDATE_EXPRESSION(bson_column, expression) returns a new BSON document with\nthe requested mutations applied. The intended use is inside an\natomic upsert so an entire family of per-field updates\nruns under the row lock in a single round-trip:"},"5989":{"id":"/docs/single-page-2315","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bson-update-expression","content":"Supported update verbs follow the DynamoDB convention:"},"5990":{"id":"/docs/single-page-2316","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bson-update-expression","content":"SET path = value — write a field (or nested path)."},"5991":{"id":"/docs/single-page-2317","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bson-update-expression","content":"REMOVE path[, path ...] — delete a field."},"5992":{"id":"/docs/single-page-2318","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bson-update-expression","content":"ADD path number — atomic numeric increment / decrement on a single field."},"5993":{"id":"/docs/single-page-2319","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bson-update-expression","content":"DELETE path value — remove a value from an array/set field."},"5994":{"id":"/docs/single-page-2320","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bson-update-expression","content":"if_not_exists(path, default) — read-then-write helper for conditional defaults."},"5995":{"id":"/docs/single-page-2321","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bson-update-expression","content":"Because the update runs on the server under the row lock, this is the right primitive\nfor things like per-document counters, idempotent flag flips, and DynamoDB-style\nconditional writes (combine with BSON_CONDITION_EXPRESSION in a WHERE clause)."},"5996":{"id":"/docs/single-page-2322","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bson-indexing","content":"To make a BSON-field filter fast, create a functional index on the projection:"},"5997":{"id":"/docs/single-page-2323","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bson-indexing","content":"Combine with INCLUDE (...) to cover other projected columns, or rely on\nuncovered indexes when you only\nfilter on the indexed field."},"5998":{"id":"/docs/single-page-2324","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bson-end-to-end","content":"Putting the pieces together — a customer-preferences scenario backed entirely by a\nsingle BSON column:"},"5999":{"id":"/docs/single-page-2325","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bson-limitations","content":"A BSON column in a composite primary key must be the last PK column."},"6000":{"id":"/docs/single-page-2326","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bson-limitations","content":"The condition/update expression language is intentionally a small document-focused\nDSL, not full SQL. Combine it with regular SQL predicates on relational columns when\nyou need joins, aggregations, or expressions across multiple rows."},"6001":{"id":"/docs/single-page-2327","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bson-limitations","content":"Functional indexes on BSON_VALUE(...) are scoped to one specific path/type pair —\nyou'll typically want an index per hot field rather than a generic \"BSON index\"."},"6002":{"id":"/docs/single-page-2328","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#change-data-capture","content":"Change Data Capture turns a Phoenix table into a stream of change events that\ndownstream consumers can read using regular SQL. Once enabled, a CDC object behaves\nlike a queryable Phoenix table: every insert, update, and delete on the underlying\ndata table produces a row containing the affected primary key, an event timestamp,\nand a JSON payload describing what changed. Available in Phoenix 5.3.0\n(PHOENIX-7001)."},"6003":{"id":"/docs/single-page-2329","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cdc-when","content":"Reach for CDC when something downstream needs to react to row-level changes:"},"6004":{"id":"/docs/single-page-2330","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cdc-when","content":"Replication or mirroring to another store (Kafka, search index, data warehouse)."},"6005":{"id":"/docs/single-page-2331","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cdc-when","content":"Audit logs and change history."},"6006":{"id":"/docs/single-page-2332","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cdc-when","content":"Cache invalidation and event-driven workflows."},"6007":{"id":"/docs/single-page-2333","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cdc-when","content":"Materialized projections / fan-out tables maintained by an external process."},"6008":{"id":"/docs/single-page-2334","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cdc-when","content":"CDC captures the actual mutations as they happen — including TTL-driven row\ndeletes — so consumers don't need to poll the data table or compute diffs."},"6009":{"id":"/docs/single-page-2335","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cdc-enable","content":"Use CREATE CDC to enable change capture on an existing table:"},"6010":{"id":"/docs/single-page-2336","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cdc-enable","content":"The INCLUDE clause sets the default scopes that appear in the JSON payload.\nAvailable scopes:"},"6011":{"id":"/docs/single-page-2337","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cdc-enable","content":"Scope"},"6012":{"id":"/docs/single-page-2338","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cdc-enable","content":"Meaning"},"6013":{"id":"/docs/single-page-2339","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cdc-enable","content":"PRE"},"6014":{"id":"/docs/single-page-2340","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cdc-enable","content":"Row image before the mutation."},"6015":{"id":"/docs/single-page-2341","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cdc-enable","content":"POST"},"6016":{"id":"/docs/single-page-2342","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cdc-enable","content":"Row image after the mutation."},"6017":{"id":"/docs/single-page-2343","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cdc-enable","content":"CHANGE"},"6018":{"id":"/docs/single-page-2344","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cdc-enable","content":"Just the changed columns (diff)."},"6019":{"id":"/docs/single-page-2345","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cdc-enable","content":"Standard CREATE INDEX–style table properties on CREATE CDC (SALT_BUCKETS,\nUPDATE_CACHE_FREQUENCY, COLUMN_ENCODED_BYTES, etc.) are forwarded to the\nunderlying CDC index."},"6020":{"id":"/docs/single-page-2346","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cdc-enable","content":"To remove CDC from a table:"},"6021":{"id":"/docs/single-page-2347","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cdc-read","content":"Each CDC object behaves like a Phoenix table whose columns are:"},"6022":{"id":"/docs/single-page-2348","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cdc-read","content":"The data table's primary-key columns (so you know which row changed)."},"6023":{"id":"/docs/single-page-2349","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cdc-read","content":"A payload column literally named \"CDC JSON\" (case-sensitive, must be quoted).\nProject it whenever you need the change payload; omit it for lightweight queries\nthat only care about which rows changed or for topology lookups. SELECT *\nincludes it automatically."},"6024":{"id":"/docs/single-page-2350","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cdc-read","content":"Two helpers come along for the ride:"},"6025":{"id":"/docs/single-page-2351","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cdc-read","content":"PHOENIX_ROW_TIMESTAMP() — the event's timestamp; use it for ordering and time-\nbounded reads."},"6026":{"id":"/docs/single-page-2352","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cdc-read","content":"PARTITION_ID() — the partition the event came from; useful for sharding consumer\nworkers."},"6027":{"id":"/docs/single-page-2353","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cdc-read","content":"A typical read query that wants the full payload looks like this:"},"6028":{"id":"/docs/single-page-2354","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cdc-read","content":"The CDC_INCLUDE(...) query hint overrides the default scopes set at CREATE\nCDC time — so the same CDC object can serve different downstream consumers, each\nasking for only the scope they need. Without the hint, the payload uses the\nINCLUDE scopes from the CREATE CDC statement."},"6029":{"id":"/docs/single-page-2355","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#time-bounded--incremental-reads","content":"Use PHOENIX_ROW_TIMESTAMP() predicates to pull only events within a window —\nconsumers typically remember the last timestamp they processed and bind it as the\nlower bound on the next call:"},"6030":{"id":"/docs/single-page-2356","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#per-partition-reads","content":"Partitions track HBase regions of the data table, so you can shard a consumer pool\nacross them. Discover partitions with:"},"6031":{"id":"/docs/single-page-2357","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#per-partition-reads","content":"Then issue per-partition reads:"},"6032":{"id":"/docs/single-page-2358","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cdc-lineage","content":"A CDC stream is logically a set of partitions, each carrying a totally-ordered\nsequence of change events. A partition isn't an abstract shard — it corresponds to a\nspecific HBase region of the data table at a point in time, and it has a finite\nlifetime: it's born when the region is created (or as the result of a split/merge)\nand it's closed when that region itself splits or merges into something new. New\nchild partitions take over from there."},"6033":{"id":"/docs/single-page-2359","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cdc-lineage","content":"Phoenix tracks this topology in SYSTEM.CDC_STREAM. The schema makes the lineage\nexplicit — every partition row points at its parent partition(s):"},"6034":{"id":"/docs/single-page-2360","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cdc-lineage","content":"Column"},"6035":{"id":"/docs/single-page-2361","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cdc-lineage","content":"Notes"},"6036":{"id":"/docs/single-page-2362","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cdc-lineage","content":"TABLE_NAME"},"6037":{"id":"/docs/single-page-2363","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cdc-lineage","content":"The data table whose changes are streamed."},"6038":{"id":"/docs/single-page-2364","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cdc-lineage","content":"STREAM_NAME"},"6039":{"id":"/docs/single-page-2365","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cdc-lineage","content":"The CDC stream (each CREATE CDC produces a uniquely-named stream)."},"6040":{"id":"/docs/single-page-2366","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cdc-lineage","content":"PARTITION_ID"},"6041":{"id":"/docs/single-page-2367","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cdc-lineage","content":"This partition's id — same value PARTITION_ID() returns on a CDC row."},"6042":{"id":"/docs/single-page-2368","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cdc-lineage","content":"PARENT_PARTITION_ID"},"6043":{"id":"/docs/single-page-2369","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cdc-lineage","content":"The parent partition's id (empty/null for the initial partitions present when CDC was first enabled)."},"6044":{"id":"/docs/single-page-2370","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cdc-lineage","content":"PARTITION_START_TIME"},"6045":{"id":"/docs/single-page-2371","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cdc-lineage","content":"When this partition began."},"6046":{"id":"/docs/single-page-2372","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cdc-lineage","content":"PARTITION_END_TIME"},"6047":{"id":"/docs/single-page-2373","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cdc-lineage","content":"When it was closed (a split or merge ended it). NULL while still active."},"6048":{"id":"/docs/single-page-2374","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cdc-lineage","content":"PARTITION_START_KEY / _END_KEY"},"6049":{"id":"/docs/single-page-2375","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cdc-lineage","content":"The HBase region's row-key bounds at the time, stored as VARBINARY_ENCODED."},"6050":{"id":"/docs/single-page-2376","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cdc-lineage","content":"PARENT_PARTITION_START_TIME"},"6051":{"id":"/docs/single-page-2377","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cdc-lineage","content":"The parent partition's PARTITION_START_TIME, embedded so consumers can walk parent → child without an extra join."},"6052":{"id":"/docs/single-page-2378","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cdc-lineage","content":"Two important shapes fall out of this model:"},"6053":{"id":"/docs/single-page-2379","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cdc-lineage","content":"A split produces two child rows that share the same PARENT_PARTITION_ID (the\nregion that just split). Their key ranges together cover the parent's range."},"6054":{"id":"/docs/single-page-2380","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cdc-lineage","content":"A merge produces one child partition with multiple rows in SYSTEM.CDC_STREAM —\none row per parent — sharing the same PARTITION_ID and differing only in\nPARENT_PARTITION_ID. Together those rows record every parent that fed the merge."},"6055":{"id":"/docs/single-page-2381","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#consuming-events-in-parent--child-order","content":"Because events from a parent partition causally precede events from any of its\nchildren, a correct consumer must drain the parent before reading children that\ndescend from it. The pattern is:"},"6056":{"id":"/docs/single-page-2382","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#consuming-events-in-parent--child-order","content":"Discover the topology by reading SYSTEM.CDC_STREAM for your table and\nstream. Build a DAG keyed by PARTITION_ID, with edges drawn from\nPARENT_PARTITION_ID → child PARTITION_ID. Roots are partitions with no\nparent (the regions present when CDC was first enabled)."},"6057":{"id":"/docs/single-page-2383","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#consuming-events-in-parent--child-order","content":"Process roots first, then walk forward through the DAG. A child partition is\nready to be consumed once all of its parents have been fully drained — for\nmerges, that means all rows in SYSTEM.CDC_STREAM with the same child\nPARTITION_ID have had their parent partitions processed."},"6058":{"id":"/docs/single-page-2384","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#consuming-events-in-parent--child-order","content":"For each partition, query the CDC object scoped to that partition and the\ntime window the partition was live:"},"6059":{"id":"/docs/single-page-2385","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#consuming-events-in-parent--child-order","content":"Re-poll the topology periodically. New rows appear in SYSTEM.CDC_STREAM\nwhen regions split or merge; consumers refresh their DAG to pick up the new\nchildren before existing partitions close."},"6060":{"id":"/docs/single-page-2386","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#consuming-events-in-parent--child-order","content":"This is the same shard-lineage model used by DynamoDB Streams — if you're porting a\nDynamoDB Streams consumer, the bookkeeping translates almost directly."},"6061":{"id":"/docs/single-page-2387","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cdc-special-events","content":"TTL-driven deletes (rows aged out by time-based or\nconditional TTL) produce CDC events alongside\napplication-issued mutations, so consumers don't have to reconcile retention-driven\nremovals separately."},"6062":{"id":"/docs/single-page-2388","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cdc-special-events","content":"ARRAY and JSON columns in the data table are serialized as simple values\ninside the \"CDC JSON\" payload."},"6063":{"id":"/docs/single-page-2389","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cdc-special-events","content":"Case-sensitive identifiers on the data table and its primary-key columns are\npreserved end to end in events."},"6064":{"id":"/docs/single-page-2390","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cdc-ops","content":"When the underlying data table is dropped, its CDC stream metadata in\nSYSTEM.CDC_STREAM is cleaned up automatically — you don't have to drop the CDC\nobject first."},"6065":{"id":"/docs/single-page-2391","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cdc-ops","content":"The CDC object is internally backed by a partitioned secondary index on the data\ntable, but it's not used to satisfy regular queries against the data table —\nthere's no read penalty on the data table from enabling CDC."},"6066":{"id":"/docs/single-page-2392","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cdc-ops","content":"Re-creating CDC after a drop produces a distinct stream (the stream name is\naugmented with creation time), so consumers can detect the boundary and reset\ntheir offsets cleanly."},"6067":{"id":"/docs/single-page-2393","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bulk-loading","content":"Phoenix provides two methods for bulk loading data into Phoenix tables:"},"6068":{"id":"/docs/single-page-2394","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bulk-loading","content":"Single-threaded client loading tool for CSV-formatted data via the psql command"},"6069":{"id":"/docs/single-page-2395","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bulk-loading","content":"MapReduce-based bulk load tool for CSV and JSON-formatted data"},"6070":{"id":"/docs/single-page-2396","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bulk-loading","content":"The psql tool is typically appropriate for tens of megabytes, while the MapReduce-based loader is typically better for larger load volumes."},"6071":{"id":"/docs/single-page-2397","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#sample-data","content":"For the following examples, assume we have a CSV file named data.csv with this content:"},"6072":{"id":"/docs/single-page-2398","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#sample-data","content":"We will use a table with the following structure:"},"6073":{"id":"/docs/single-page-2399","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#loading-via-psql","content":"The psql command is invoked via psql.py in the Phoenix bin directory. To load CSV data, provide connection information for your HBase cluster, the target table name, and one or more CSV file paths. All CSV files must use the .csv extension (because arbitrary SQL scripts with the .sql extension can also be supplied on the psql command line)."},"6074":{"id":"/docs/single-page-2400","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#loading-via-psql","content":"To load the example data above into HBase running locally:"},"6075":{"id":"/docs/single-page-2401","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#loading-via-psql","content":"The following parameters can be used for loading data with psql:"},"6076":{"id":"/docs/single-page-2402","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#loading-via-psql","content":"Parameter"},"6077":{"id":"/docs/single-page-2403","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#loading-via-psql","content":"Description"},"6078":{"id":"/docs/single-page-2404","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#loading-via-psql","content":"-t"},"6079":{"id":"/docs/single-page-2405","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#loading-via-psql","content":"Provide the target table name. By default, the table name is taken from the CSV file name. This parameter is case-sensitive."},"6080":{"id":"/docs/single-page-2406","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#loading-via-psql","content":"-h"},"6081":{"id":"/docs/single-page-2407","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#loading-via-psql","content":"Override the column names to which CSV data maps (case-sensitive). A special value of in-line indicates that the first line of the CSV file determines column mapping."},"6082":{"id":"/docs/single-page-2408","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#loading-via-psql","content":"-s"},"6083":{"id":"/docs/single-page-2409","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#loading-via-psql","content":"Run in strict mode, throwing an error on CSV parsing errors."},"6084":{"id":"/docs/single-page-2410","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#loading-via-psql","content":"-d"},"6085":{"id":"/docs/single-page-2411","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#loading-via-psql","content":"Supply one or more custom delimiters for CSV parsing."},"6086":{"id":"/docs/single-page-2412","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#loading-via-psql","content":"-q"},"6087":{"id":"/docs/single-page-2413","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#loading-via-psql","content":"Supply a custom phrase delimiter (defaults to the double quote character)."},"6088":{"id":"/docs/single-page-2414","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#loading-via-psql","content":"-e"},"6089":{"id":"/docs/single-page-2415","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#loading-via-psql","content":"Supply a custom escape character (default is backslash)."},"6090":{"id":"/docs/single-page-2416","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#loading-via-psql","content":"-a"},"6091":{"id":"/docs/single-page-2417","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#loading-via-psql","content":"Supply an array delimiter (explained in more detail below)."},"6092":{"id":"/docs/single-page-2418","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#loading-via-mapreduce","content":"For higher-throughput loading distributed across the cluster, the MapReduce loader can be used. This loader first converts data into HFiles, then provides the created HFiles to HBase after HFile creation completes."},"6093":{"id":"/docs/single-page-2419","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#loading-via-mapreduce","content":"The CSV MapReduce loader is launched using the hadoop command with the Phoenix client JAR:"},"6094":{"id":"/docs/single-page-2420","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#loading-via-mapreduce","content":"When using Phoenix 4.0 and above, there is a known HBase issue (\"Notice to MapReduce users of HBase 0.96.1 and above\" in the HBase Reference Guide). You should use:"},"6095":{"id":"/docs/single-page-2421","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#loading-via-mapreduce","content":"Or:"},"6096":{"id":"/docs/single-page-2422","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#loading-via-mapreduce","content":"The JSON MapReduce loader is launched similarly:"},"6097":{"id":"/docs/single-page-2423","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#loading-via-mapreduce","content":"The input file must be present on HDFS (not the local filesystem where the command is run)."},"6098":{"id":"/docs/single-page-2424","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#loading-via-mapreduce","content":"The following parameters can be used with the MapReduce loader:"},"6099":{"id":"/docs/single-page-2425","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#loading-via-mapreduce","content":"Parameter"},"6100":{"id":"/docs/single-page-2426","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#loading-via-mapreduce","content":"Description"},"6101":{"id":"/docs/single-page-2427","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#loading-via-mapreduce","content":"-i,--input"},"6102":{"id":"/docs/single-page-2428","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#loading-via-mapreduce","content":"Input CSV path (mandatory)"},"6103":{"id":"/docs/single-page-2429","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#loading-via-mapreduce","content":"-t,--table"},"6104":{"id":"/docs/single-page-2430","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#loading-via-mapreduce","content":"Phoenix table name (mandatory)"},"6105":{"id":"/docs/single-page-2431","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#loading-via-mapreduce","content":"-a,--array-delimiter"},"6106":{"id":"/docs/single-page-2432","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#loading-via-mapreduce","content":"Array element delimiter (optional)"},"6107":{"id":"/docs/single-page-2433","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#loading-via-mapreduce","content":"-c,--import-columns"},"6108":{"id":"/docs/single-page-2434","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#loading-via-mapreduce","content":"Comma-separated list of columns to import"},"6109":{"id":"/docs/single-page-2435","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#loading-via-mapreduce","content":"-d,--delimiter"},"6110":{"id":"/docs/single-page-2436","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#loading-via-mapreduce","content":"Input delimiter (defaults to comma)"},"6111":{"id":"/docs/single-page-2437","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#loading-via-mapreduce","content":"-g,--ignore-errors"},"6112":{"id":"/docs/single-page-2438","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#loading-via-mapreduce","content":"Ignore input errors"},"6113":{"id":"/docs/single-page-2439","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#loading-via-mapreduce","content":"-o,--output"},"6114":{"id":"/docs/single-page-2440","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#loading-via-mapreduce","content":"Output path for temporary HFiles (optional)"},"6115":{"id":"/docs/single-page-2441","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#loading-via-mapreduce","content":"-s,--schema"},"6116":{"id":"/docs/single-page-2442","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#loading-via-mapreduce","content":"Phoenix schema name (optional)"},"6117":{"id":"/docs/single-page-2443","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#loading-via-mapreduce","content":"-z,--zookeeper"},"6118":{"id":"/docs/single-page-2444","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#loading-via-mapreduce","content":"ZooKeeper quorum to connect to (optional)"},"6119":{"id":"/docs/single-page-2445","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#loading-via-mapreduce","content":"-it,--index-table"},"6120":{"id":"/docs/single-page-2446","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#loading-via-mapreduce","content":"Index table name to load (optional)"},"6121":{"id":"/docs/single-page-2447","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#notes-on-the-mapreduce-importer","content":"The current MR-based bulk loader runs one MR job to load your data table and one MR job per index table to populate indexes. Use -it to load only one index table."},"6122":{"id":"/docs/single-page-2448","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#permission-issues-when-uploading-hfiles","content":"There can be issues due to file permissions on created HFiles in the final stage of a bulk load, when HFiles are handed over to HBase. HBase must be able to move the created HFiles, which means it needs write access to the directories where files were written. If not, HFile upload may hang for a long time before failing."},"6123":{"id":"/docs/single-page-2449","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#permission-issues-when-uploading-hfiles","content":"Two common workarounds are:"},"6124":{"id":"/docs/single-page-2450","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#permission-issues-when-uploading-hfiles","content":"Run the bulk load process as the hbase user."},"6125":{"id":"/docs/single-page-2451","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#permission-issues-when-uploading-hfiles","content":"Create output files readable/writable for all users."},"6126":{"id":"/docs/single-page-2452","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#permission-issues-when-uploading-hfiles","content":"The first option can be done by running:"},"6127":{"id":"/docs/single-page-2453","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#permission-issues-when-uploading-hfiles","content":"Creating output files readable by all can be done by setting fs.permissions.umask-mode to 000. This can be set in Hadoop config on the submit host, or only for job submission:"},"6128":{"id":"/docs/single-page-2454","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#loading-array-data","content":"Both PSQL and MapReduce loaders support array values with -a. Arrays in CSV are represented by a field that uses a different delimiter than the main CSV delimiter. For example, this file represents an id field and an array of integers:"},"6129":{"id":"/docs/single-page-2455","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#loading-array-data","content":"To load this file, use the default CSV delimiter (comma) and pass colon as the array delimiter via -a ':'."},"6130":{"id":"/docs/single-page-2456","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#a-note-on-separator-characters","content":"The default separator for both loaders is comma (,). A common separator for input files is tab, which can be tricky to pass on the command line. A common mistake is:"},"6131":{"id":"/docs/single-page-2457","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#a-note-on-separator-characters","content":"This does not work because the shell passes two characters (backslash and t) to Phoenix."},"6132":{"id":"/docs/single-page-2458","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#a-note-on-separator-characters","content":"Two working approaches:"},"6133":{"id":"/docs/single-page-2459","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#a-note-on-separator-characters","content":"Prefix the string representation of tab with $:"},"6134":{"id":"/docs/single-page-2460","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#a-note-on-separator-characters","content":"Enter the separator as Ctrl+v and then press tab:"},"6135":{"id":"/docs/single-page-2461","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#a-note-on-lowercase-tableschema-names","content":"Table names in Phoenix are case-insensitive (generally uppercase), but users may need to map an existing lowercase HBase table name into Phoenix. In this case, double quotes around the table name (for example, \"tablename\") preserve case sensitivity."},"6136":{"id":"/docs/single-page-2462","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#a-note-on-lowercase-tableschema-names","content":"This support was extended to bulk load options. However, due to how Apache Commons CLI parses command-line options (CLI-275), pass the argument as \\\"\\\"tablename\\\"\\\" instead of just \"tablename\" for CsvBulkLoadTool."},"6137":{"id":"/docs/single-page-2463","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#a-note-on-lowercase-tableschema-names","content":"Example:"},"6138":{"id":"/docs/single-page-2464","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#query-server","content":"The Phoenix Query Server provides an alternative means for interaction with\nPhoenix and HBase."},"6139":{"id":"/docs/single-page-2465","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#query-server-overview","content":"Phoenix 4.4 introduces a stand-alone server that exposes Phoenix to \"thin\"\nclients. It is based on the Avatica component of\nApache Calcite. The query server is comprised of a Java server that\nmanages Phoenix Connections on the clients' behalf."},"6140":{"id":"/docs/single-page-2466","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#query-server-overview","content":"With the introduction of the\nProtobuf transport, Avatica is moving towards backwards compatibility with the\nprovided thin JDBC driver. There are no such backwards compatibility guarantees\nfor the JSON API."},"6141":{"id":"/docs/single-page-2467","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#query-server-overview","content":"To repeat, there is no guarantee of backwards compatibility with the JSON transport;\nhowever, compatibility with the Protobuf transport is stabilizing (although, not\ntested thoroughly enough to be stated as \"guaranteed\")."},"6142":{"id":"/docs/single-page-2468","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#clients","content":"The primary client implementation\nis currently a JDBC driver with minimal dependencies. The default and\nprimary transport mechanism since Phoenix 4.7 is Protobuf, the older JSON mechanism can still\nbe enabled.\nThe distribution includes the sqlline-thin.py CLI client that uses the JDBC thin client."},"6143":{"id":"/docs/single-page-2469","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#clients","content":"The Phoenix project also maintains the Python driver\nphoenixdb."},"6144":{"id":"/docs/single-page-2470","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#clients","content":"The Avatica Go client\ncan also be used."},"6145":{"id":"/docs/single-page-2471","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#clients","content":"Proprietary ODBC drivers are also available for Windows and Linux."},"6146":{"id":"/docs/single-page-2472","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#query-server-installation","content":"In the 4.4-4.14 and 5.0 releases the query server and its JDBC client are part of the standard Phoenix\ndistribution. They require no additional dependencies or installation."},"6147":{"id":"/docs/single-page-2473","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#query-server-installation","content":"After the 4.15 and 5.1 release, the query server has been unbundled into the phoenix-queryserver\nrepository, and its version number has been reset to 6.0."},"6148":{"id":"/docs/single-page-2474","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#query-server-installation","content":"Download the latest source or binary release from the\nDownload page,\nor check out the development version from\nGitHub."},"6149":{"id":"/docs/single-page-2475","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#query-server-installation","content":"Either unpack the binary distribution, or build it from source. See BUILDING.md\nin the source distribution on how to build."},"6150":{"id":"/docs/single-page-2476","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#server","content":"The standalone Query Server distribution does not contain the necessary\nPhoenix (thick) client library by default."},"6151":{"id":"/docs/single-page-2477","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#server","content":"If using the standalone library you will either need to rebuild it from source to include the\nclient library (See BUILDING.md), or manually copy the phoenix thick client library\ninto the installation directory."},"6152":{"id":"/docs/single-page-2478","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#server","content":"The server component is managed through bin/queryserver.py. Its usage is as\nfollows"},"6153":{"id":"/docs/single-page-2479","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#server","content":"When invoked with no arguments, the query server is launched in the foreground,\nwith logging directed to the console."},"6154":{"id":"/docs/single-page-2480","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#server","content":"The first argument is an optional start or stop command to the daemon. When\neither of these are provided, it will take appropriate action on a daemon\nprocess, if it exists."},"6155":{"id":"/docs/single-page-2481","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#server","content":"Any subsequent arguments are passed to the main class for interpretation."},"6156":{"id":"/docs/single-page-2482","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#server","content":"The server is packaged in a standalone jar,\nphoenix-queryserver-<version>.jar. This jar, the phoenix-client.jar and HBASE_CONF_DIR on the\nclasspath are all that is required to launch the server."},"6157":{"id":"/docs/single-page-2483","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#client","content":"Phoenix provides two mechanisms for interacting with the query server. A JDBC\ndriver is provided in the standalone\nphoenix-queryserver-client-<version>.jar. The script\nbin/sqlline-thin.py is available for the command line."},"6158":{"id":"/docs/single-page-2484","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#client","content":"The JDBC connection string is composed as follows:"},"6159":{"id":"/docs/single-page-2485","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#client","content":"<scheme> specifies the transport protocol (http or https) used when communicating with the\nserver."},"6160":{"id":"/docs/single-page-2486","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#client","content":"<server-hostname> is the name of the host offering the service."},"6161":{"id":"/docs/single-page-2487","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#client","content":"<port> is the port number on which the host is listening. Default is 8765,\nthough this is configurable (see below)."},"6162":{"id":"/docs/single-page-2488","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#client","content":"The full list of options that can be provided via the JDBC URL string is available\nin the Avatica documentation."},"6163":{"id":"/docs/single-page-2489","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#client","content":"The script bin/sqlline-thin.py is intended to behave identically to its\nsibling script bin/sqlline.py. It supports the following usage options."},"6164":{"id":"/docs/single-page-2490","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#client","content":"The first optional argument is a connection URL, as described previously. When\nnot provided, scheme defaults to http, host to localhost, and port to\n8765."},"6165":{"id":"/docs/single-page-2491","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#client","content":"The second optional parameter is a sql file from which to read commands."},"6166":{"id":"/docs/single-page-2492","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#wire-api-documentation","content":"The API itself is documented in the Apache Calcite project as it is the Avatica\nAPI -- there is no wire API defined in Phoenix itself."},"6167":{"id":"/docs/single-page-2493","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#wire-api-documentation","content":"JSON API"},"6168":{"id":"/docs/single-page-2494","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#wire-api-documentation","content":"Protocol Buffer API"},"6169":{"id":"/docs/single-page-2495","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#wire-api-documentation","content":"For more information in building clients in other languages that work with\nAvatica, please feel free to reach out to the Apache Calcite dev mailing list."},"6170":{"id":"/docs/single-page-2496","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#impersonation","content":"By default, the Phoenix Query Server executes queries on behalf of the end-user. HBase permissions\nare enforced given the end-user, not the Phoenix Query Server's identity. In some cases, it may\nbe desirable to execute the query as some other user -- this is referred to as \"impersonation\".\nThis can enable workflows where a trusted user has the privilege to run queries for other users."},"6171":{"id":"/docs/single-page-2497","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#impersonation","content":"This can be enabled by setting the configuration property phoenix.queryserver.withRemoteUserExtractor\nto true. The URL of the Query Server can be modified to include the required request parameter.\nFor example, to let \"bob\" to run a query as \"alice\", the following JDBC URL could be used:"},"6172":{"id":"/docs/single-page-2498","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#impersonation","content":"The standard Hadoop \"proxyuser\" configuration keys are checked to validate if the \"real\" remote user\nis allowed to impersonate the \"doAs\" user. See the Hadoop documentation\nfor more information on how to configure these rules."},"6173":{"id":"/docs/single-page-2499","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#impersonation","content":"As a word of warning: there is no end-to-end test coverage for the HBase 0.98 and 1.1 Phoenix releases\nbecause of missing test-related code in those HBase releases. While we expect no issues on these\nPhoenix release lines, we recommend additional testing by the user to verify that there are no issues."},"6174":{"id":"/docs/single-page-2500","page_id":"/doc