gle-page"],"type":"text","url":"/docs/single-page#last_values","content":"Example"},"6628":{"id":"/docs/single-page-2954","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#nth_value","content":"The nth value in each distinct group ordered according to the ORDER BY specification."},"6629":{"id":"/docs/single-page-2955","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#nth_value","content":"Example"},"6630":{"id":"/docs/single-page-2956","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#stddev_pop","content":"The population standard deviation of all values. Aggregates are only allowed in select statements. The returned value is of decimal data type."},"6631":{"id":"/docs/single-page-2957","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#stddev_pop","content":"Example"},"6632":{"id":"/docs/single-page-2958","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#stddev_samp","content":"The sample standard deviation of all values. Aggregates are only allowed in select statements. The returned value is of decimal data type."},"6633":{"id":"/docs/single-page-2959","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#stddev_samp","content":"Example"},"6634":{"id":"/docs/single-page-2960","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#round","content":"Rounds the numeric or timestamp expression to the nearest scale or time unit specified. If the expression is a numeric type, then the second argument is the scale to be used for rounding off the number, defaulting to zero. If the expression is a date/time type, then the second argument may be one of the time units listed to determine the remaining precision of the date/time. A default of MILLISECONDS is used if not present. The multiplier is only applicable for a date/time type and is used to round to a multiple of a time unit (i.e. 10 minute) and defaults to 1 if not specified. This method returns the same type as its first argument."},"6635":{"id":"/docs/single-page-2961","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#round","content":"Example"},"6636":{"id":"/docs/single-page-2962","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#ceil","content":"Same as ROUND, except it rounds any fractional value up to the next even multiple."},"6637":{"id":"/docs/single-page-2963","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#ceil","content":"Example"},"6638":{"id":"/docs/single-page-2964","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#floor","content":"Same as ROUND, except it rounds any fractional value down to the previous even multiple."},"6639":{"id":"/docs/single-page-2965","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#floor","content":"Example"},"6640":{"id":"/docs/single-page-2966","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#trunc","content":"Same as FLOOR"},"6641":{"id":"/docs/single-page-2967","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#trunc","content":"Example"},"6642":{"id":"/docs/single-page-2968","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#to_number","content":"Formats a string or date/time type as a number, optionally accepting a format string. For details on the format, see java.text.DecimalFormat. For date, time, and timeStamp terms, the result is the time in milliseconds since the epoch. This method returns a decimal number."},"6643":{"id":"/docs/single-page-2969","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#to_number","content":"Example"},"6644":{"id":"/docs/single-page-2970","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#rand","content":"Function that produces a random, uniformly distributed double value between 0.0 (inclusive) and 1.0 (exclusive). If a seed is provided, then the the returned value is identical across each invocation for the same row. If a seed is not provided, then the returned value is different for each invocation. The seed must be a constant."},"6645":{"id":"/docs/single-page-2971","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#rand","content":"Example"},"6646":{"id":"/docs/single-page-2972","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#substr","content":"Returns a substring of a string starting at the one-based position. If zero is used, the position is zero-based. If the start index is negative, then the start index is relative to the end of the string. The length is optional and if not supplied, the rest of the string will be returned."},"6647":{"id":"/docs/single-page-2973","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#substr","content":"Example"},"6648":{"id":"/docs/single-page-2974","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#instr","content":"Returns the one-based position of the initial occurrence of the second argument in the first argument. If the second argument is not contained in the first argument, then zero is returned."},"6649":{"id":"/docs/single-page-2975","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#instr","content":"Example"},"6650":{"id":"/docs/single-page-2976","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#trim","content":"Removes leading and trailing spaces from the input string."},"6651":{"id":"/docs/single-page-2977","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#trim","content":"Example"},"6652":{"id":"/docs/single-page-2978","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#ltrim","content":"Removes leading spaces from the input string."},"6653":{"id":"/docs/single-page-2979","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#ltrim","content":"Example"},"6654":{"id":"/docs/single-page-2980","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#rtrim","content":"Removes trailing spaces from the input string."},"6655":{"id":"/docs/single-page-2981","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#rtrim","content":"Example"},"6656":{"id":"/docs/single-page-2982","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#lpad","content":"Pads the string expression with the specific pad character (space by default) up to the length argument."},"6657":{"id":"/docs/single-page-2983","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#lpad","content":"Example"},"6658":{"id":"/docs/single-page-2984","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#length","content":"Returns the length of the string in characters."},"6659":{"id":"/docs/single-page-2985","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#length","content":"Example"},"6660":{"id":"/docs/single-page-2986","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#regexp_substr","content":"Returns a substring of a string by applying a regular expression start from the offset of a one-based position. Just like with SUBSTR, if the start index is negative, then it is relative to the end of the string. If not specified, the start index defaults to 1."},"6661":{"id":"/docs/single-page-2987","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#regexp_substr","content":"Example"},"6662":{"id":"/docs/single-page-2988","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#regexp_replace","content":"Returns a string by applying a regular expression and replacing the matches with the replacement string. If the replacement string is not specified, it defaults to an empty string."},"6663":{"id":"/docs/single-page-2989","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#regexp_replace","content":"Example"},"6664":{"id":"/docs/single-page-2990","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#regexp_split","content":"Splits a string into a VARCHAR ARRAY using a regular expression. If characters that have a special meaning in regular expressions are to be used as a regular delimiter in the pattern string, they must be escaped with backslashes."},"6665":{"id":"/docs/single-page-2991","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#regexp_split","content":"Example"},"6666":{"id":"/docs/single-page-2992","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#upper","content":"Returns upper case string of the string argument. If localeString (available in Phoenix 4.14) is provided, it identifies the locale whose rules are used for the conversion. If localeString is not provided, the default locale is used. The localeString must be of the form returned by the Java 6 implementation of java.util.Locale.toString() e.g. 'zh_TW_STROKE' or 'en_US' or 'fr_FR'."},"6667":{"id":"/docs/single-page-2993","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#upper","content":"Example"},"6668":{"id":"/docs/single-page-2994","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#lower","content":"Returns lower case string of the string argument. If localeString (available in Phoenix 4.14) is provided, it identifies the locale whose rules are used for the conversion. If localeString is not provided, the default locale is used. The localeString must be of the form returned by the Java 6 implementation of java.util.Locale.toString() e.g. 'zh_TW_STROKE' or 'en_US' or 'fr_FR'."},"6669":{"id":"/docs/single-page-2995","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#lower","content":"Example"},"6670":{"id":"/docs/single-page-2996","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#reverse","content":"Returns reversed string of the string argument."},"6671":{"id":"/docs/single-page-2997","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#reverse","content":"Example"},"6672":{"id":"/docs/single-page-2998","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#to_char","content":"Formats a date, time, timestamp, or number as a string. The default date format is \"yyyy-MM-dd HH:mm:ss\" and the default number format is \"#,##0.###\". For details, see java.text.SimpleDateFormat for date/time values and java.text.DecimalFormat for numbers. This method returns a string."},"6673":{"id":"/docs/single-page-2999","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#to_char","content":"Example"},"6674":{"id":"/docs/single-page-3000","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#collation_key","content":"Calculates a collation key that can be used to sort strings in a natural-language-aware way. The localeString must be of the form returned by the Java 6 implementation of java.util.Locale.toString() e.g. 'zh_TW_STROKE' or 'en_US' or 'fr_FR'. The third, fourth and fifth arguments are optional and determine respectively whether to use a special upper-case collator, the strength value of the collator, and the decomposition value of the collator. (See java.text.Collator to learn about strength and decomposition)."},"6675":{"id":"/docs/single-page-3001","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#collation_key","content":"Example"},"6676":{"id":"/docs/single-page-3002","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#array_elem","content":"Alternative to using array subscript notation to access an array element. Returns the element in the array at the given position. The position is one-based."},"6677":{"id":"/docs/single-page-3003","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#array_elem","content":"Example"},"6678":{"id":"/docs/single-page-3004","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#array_length","content":"Returns the current length of the array."},"6679":{"id":"/docs/single-page-3005","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#array_length","content":"Example"},"6680":{"id":"/docs/single-page-3006","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#array_append","content":"Appends the given element to the end of the array."},"6681":{"id":"/docs/single-page-3007","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#array_append","content":"Example"},"6682":{"id":"/docs/single-page-3008","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#array_prepend","content":"Appends the given element to the beginning of the array."},"6683":{"id":"/docs/single-page-3009","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#array_prepend","content":"Example"},"6684":{"id":"/docs/single-page-3010","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#array_cat","content":"Concatenates the input arrays and returns the result."},"6685":{"id":"/docs/single-page-3011","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#array_cat","content":"Example"},"6686":{"id":"/docs/single-page-3012","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#array_fill","content":"Returns an array initialized with supplied value and length."},"6687":{"id":"/docs/single-page-3013","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#array_fill","content":"Example"},"6688":{"id":"/docs/single-page-3014","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#array_to_string","content":"Concatenates array elements using supplied delimiter and optional null string and returns the resulting string. If the nullString parameter is omitted or NULL, any null elements in the array are simply skipped and not represented in the output string."},"6689":{"id":"/docs/single-page-3015","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#array_to_string","content":"Example"},"6690":{"id":"/docs/single-page-3016","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#any","content":"Used on the right-hand side of a comparison expression to test that any array element satisfies the comparison expression against the left-hand side."},"6691":{"id":"/docs/single-page-3017","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#any","content":"Example"},"6692":{"id":"/docs/single-page-3018","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#all","content":"Used on the right-hand side of a comparison expression to test that all array elements satisfy the comparison expression against the left-hand side. of the array."},"6693":{"id":"/docs/single-page-3019","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#all","content":"Example"},"6694":{"id":"/docs/single-page-3020","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#md5","content":"Computes the MD5 hash of the argument, returning the result as a BINARY(16)."},"6695":{"id":"/docs/single-page-3021","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#md5","content":"Example"},"6696":{"id":"/docs/single-page-3022","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#invert","content":"Inverts the bits of the argument. The return type will be the same as the argument."},"6697":{"id":"/docs/single-page-3023","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#invert","content":"Example"},"6698":{"id":"/docs/single-page-3024","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#encode","content":"Encodes the expression according to the encoding format provided and returns the resulting string. For 'BASE62', converts the given base 10 number to a base 62 number and returns a string representing the number."},"6699":{"id":"/docs/single-page-3025","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#encode","content":"Example"},"6700":{"id":"/docs/single-page-3026","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#decode","content":"Decodes the expression according to the encoding format provided and returns the resulting value as a VARBINARY. For 'HEX', converts the hex string expression to its binary representation, providing a mechanism for inputting binary data through the console."},"6701":{"id":"/docs/single-page-3027","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#decode","content":"Example"},"6702":{"id":"/docs/single-page-3028","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#coalesce","content":"Returns the value of the first argument if not null and the second argument otherwise. Useful to guarantee that a column in an UPSERT SELECT command will evaluate to a non null value."},"6703":{"id":"/docs/single-page-3029","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#coalesce","content":"Example"},"6704":{"id":"/docs/single-page-3030","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#get_bit","content":"Retrieves the bit at the given index in the given binary value."},"6705":{"id":"/docs/single-page-3031","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#get_bit","content":"Example"},"6706":{"id":"/docs/single-page-3032","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#get_byte","content":"Retrieves the byte at the given index in the given binary value."},"6707":{"id":"/docs/single-page-3033","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#get_byte","content":"Example"},"6708":{"id":"/docs/single-page-3034","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#octet_length","content":"Returns the number of bytes in a binary value."},"6709":{"id":"/docs/single-page-3035","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#octet_length","content":"Example"},"6710":{"id":"/docs/single-page-3036","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#set_bit","content":"Replaces the bit at the given index in the binary value with the provided newValue."},"6711":{"id":"/docs/single-page-3037","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#set_bit","content":"Example"},"6712":{"id":"/docs/single-page-3038","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#set_byte","content":"Replaces the byte at the given index in the binary value with the provided newValue."},"6713":{"id":"/docs/single-page-3039","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#set_byte","content":"Example"},"6714":{"id":"/docs/single-page-3040","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#to_date","content":"Parses a string and returns a date. Note that the returned date is internally represented as the number of milliseconds since the java epoch. The most important format characters are: y year, M month, d day, H hour, m minute, s second. The default format string is \"yyyy-MM-dd HH:mm:ss\". For details of the format, see java.text.SimpleDateFormat. By default, GMT will be used as the time zone when parsing the date. However, a time zone id can also be supplied. This is a time zone id such as 'GMT+1'. If 'local' is provided as the time zone id, the local time zone will be used for parsing. The configuration setting \"phoenix.query.dateFormatTimeZone\" can also be set to a time zone id, which will cause the default of GMT to be overridden with the configured time zone id. Please see the Data Type reference guide about how Apache Phoenix presently defines the DATE datatype. Additionally, Phoenix supports the ANSI SQL \"date\" literal which acts similarly to the single-argument \"TO_DATE\" function."},"6715":{"id":"/docs/single-page-3041","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#to_date","content":"Example"},"6716":{"id":"/docs/single-page-3042","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#current_date","content":"Returns the current server-side date, bound at the start of the execution of a query based on the current time on the region server owning the metadata of the table being queried. Please see the Data Type reference guide about how Apache Phoenix presently defines the DATE datatype."},"6717":{"id":"/docs/single-page-3043","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#current_date","content":"Example"},"6718":{"id":"/docs/single-page-3044","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#to_time","content":"Converts the given string into a TIME instance. When a date format is not provided it defaults to \"yyyy-MM-dd HH:mm:ss.SSS\" or whatever is defined by the configuration property phoenix.query.dateFormat. The configuration setting phoenix.query.dateFormatTimeZone can also be set to a time zone id, which will cause the default of GMT to be overridden with the configured time zone id. Additionally, Phoenix supports the ANSI SQL \"time\" literal which acts similarly to the single-argument \"TO_TIME\" function."},"6719":{"id":"/docs/single-page-3045","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#to_time","content":"Example"},"6720":{"id":"/docs/single-page-3046","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#to_timestamp","content":"Converts the given string into a TIMESTAMP instance. When a date format is not provided it defaults to \"yyyy-MM-dd HH:mm:ss.SSS\" or whatever is defined by the configuration property phoenix.query.dateFormat. The configuration setting phoenix.query.dateFormatTimeZone can also be set to a time zone id, which will cause the default of GMT to be overridden with the configured time zone id. Additionally, Phoenix supports the ANSI SQL \"timestamp\" literal which acts similarly to the single-argument \"TO_TIMESTAMP\" function."},"6721":{"id":"/docs/single-page-3047","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#to_timestamp","content":"Example"},"6722":{"id":"/docs/single-page-3048","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#current_time","content":"Same as CURRENT_DATE(), except returns a value of type TIME. In either case, the underlying representation is the epoch time as a long value. Please see the Data Type reference guide about how Apache Phoenix presently defines the TIME datatype."},"6723":{"id":"/docs/single-page-3049","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#current_time","content":"Example"},"6724":{"id":"/docs/single-page-3050","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#convert_tz","content":"Converts date/time from one time zone to another returning the shifted date/time value."},"6725":{"id":"/docs/single-page-3051","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#convert_tz","content":"Example"},"6726":{"id":"/docs/single-page-3052","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#timezone_offset","content":"Returns offset (shift in minutes) of a time zone at particular date/time in minutes."},"6727":{"id":"/docs/single-page-3053","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#timezone_offset","content":"Example"},"6728":{"id":"/docs/single-page-3054","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#now","content":"Returns the current date, bound at the start of the execution of a query based on the current time on the region server owning the metadata of the table being queried."},"6729":{"id":"/docs/single-page-3055","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#now","content":"Example"},"6730":{"id":"/docs/single-page-3056","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#year","content":"Returns the year of the specified date."},"6731":{"id":"/docs/single-page-3057","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#year","content":"Example"},"6732":{"id":"/docs/single-page-3058","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#month","content":"Returns the month of the specified date."},"6733":{"id":"/docs/single-page-3059","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#month","content":"Example"},"6734":{"id":"/docs/single-page-3060","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#week","content":"Returns the week of the specified date."},"6735":{"id":"/docs/single-page-3061","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#week","content":"Example"},"6736":{"id":"/docs/single-page-3062","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#dayofyear","content":"Returns the day of the year of the specified date."},"6737":{"id":"/docs/single-page-3063","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#dayofyear","content":"Example"},"6738":{"id":"/docs/single-page-3064","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#dayofmonth","content":"Returns the day of the month of the specified date."},"6739":{"id":"/docs/single-page-3065","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#dayofmonth","content":"Example"},"6740":{"id":"/docs/single-page-3066","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#dayofweek","content":"Returns the day of the week of the specified date."},"6741":{"id":"/docs/single-page-3067","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#dayofweek","content":"Example"},"6742":{"id":"/docs/single-page-3068","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hour","content":"Returns the hour of the specified date."},"6743":{"id":"/docs/single-page-3069","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hour","content":"Example"},"6744":{"id":"/docs/single-page-3070","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#minute","content":"Returns the minute of the specified date."},"6745":{"id":"/docs/single-page-3071","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#minute","content":"Example"},"6746":{"id":"/docs/single-page-3072","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#second","content":"Returns the second of the specified date."},"6747":{"id":"/docs/single-page-3073","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#second","content":"Example"},"6748":{"id":"/docs/single-page-3074","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#sign","content":"Returns the signum function of the given numeric expression as an INTEGER. The return value is -1 if the given numeric expression is negative; 0 if the given numeric expression is zero; and 1 if the given numeric expression is positive."},"6749":{"id":"/docs/single-page-3075","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#sign","content":"Example"},"6750":{"id":"/docs/single-page-3076","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#abs","content":"Returns the absolute value of the given numeric expression maintaining the same type."},"6751":{"id":"/docs/single-page-3077","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#abs","content":"Example"},"6752":{"id":"/docs/single-page-3078","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#sqrt","content":"Returns the correctly rounded square root of the given non-negative numeric expression as a DOUBLE."},"6753":{"id":"/docs/single-page-3079","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#sqrt","content":"Example"},"6754":{"id":"/docs/single-page-3080","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cbrt","content":"Returns the cube root of the given numeric expression as a DOUBLE."},"6755":{"id":"/docs/single-page-3081","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cbrt","content":"Example"},"6756":{"id":"/docs/single-page-3082","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#exp","content":"Returns Euler's number e raised to the power of the given numeric value as a DOUBLE."},"6757":{"id":"/docs/single-page-3083","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#exp","content":"Example"},"6758":{"id":"/docs/single-page-3084","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#power","content":"Returns the value of the first argument raised to the power of the second argument as a DOUBLE."},"6759":{"id":"/docs/single-page-3085","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#power","content":"Example"},"6760":{"id":"/docs/single-page-3086","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#ln","content":"Returns the natural logarithm (base e) of the given positive expression as a DOUBLE."},"6761":{"id":"/docs/single-page-3087","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#ln","content":"Example"},"6762":{"id":"/docs/single-page-3088","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#log","content":"Returns the logarithm of the first argument computed at the base of the second argument as a DOUBLE. If omitted, a base of 10 will be used for the second argument."},"6763":{"id":"/docs/single-page-3089","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#log","content":"Example"},"6764":{"id":"/docs/single-page-3090","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#integer-type","content":"Possible values: -2147483648 to 2147483647."},"6765":{"id":"/docs/single-page-3091","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#integer-type","content":"Mapped to java.lang.Integer. The binary representation is a 4 byte integer with the sign bit flipped (so that negative values sorts before positive values)."},"6766":{"id":"/docs/single-page-3092","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#integer-type","content":"Example"},"6767":{"id":"/docs/single-page-3093","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#unsigned_int-type","content":"Possible values: 0 to 2147483647. Mapped to java.lang.Integer. The binary representation is a 4 byte integer, matching the Bytes.toBytes(int) method. The purpose of this type is to map to existing HBase data that was serialized using this HBase utility method. If that is not the case, use the regular signed type instead."},"6768":{"id":"/docs/single-page-3094","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#unsigned_int-type","content":"Example"},"6769":{"id":"/docs/single-page-3095","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bigint-type","content":"Possible values: -9223372036854775808 to 9223372036854775807. Mapped to java.lang.Long. The binary representation is an 8 byte long with the sign bit flipped (so that negative values sorts before positive values)."},"6770":{"id":"/docs/single-page-3096","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bigint-type","content":"Example"},"6771":{"id":"/docs/single-page-3097","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#unsigned_long-type","content":"Possible values: 0 to 9223372036854775807. Mapped to java.lang.Long. The binary representation is an 8 byte integer, matching the Bytes.toBytes(long) method. The purpose of this type is to map to existing HBase data that was serialized using this HBase utility method. If that is not the case, use the regular signed type instead."},"6772":{"id":"/docs/single-page-3098","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#unsigned_long-type","content":"Example"},"6773":{"id":"/docs/single-page-3099","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#tinyint-type","content":"Possible values: -128 to 127. Mapped to java.lang.Byte. The binary representation is a single byte, with the sign bit flipped (so that negative values sorts before positive values)."},"6774":{"id":"/docs/single-page-3100","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#tinyint-type","content":"Example"},"6775":{"id":"/docs/single-page-3101","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#unsigned_tinyint-type","content":"Possible values: 0 to 127. Mapped to java.lang.Byte. The binary representation is a single byte, matching the Bytes.toBytes(byte) method. The purpose of this type is to map to existing HBase data that was serialized using this HBase utility method. If that is not the case, use the regular signed type instead."},"6776":{"id":"/docs/single-page-3102","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#unsigned_tinyint-type","content":"Example"},"6777":{"id":"/docs/single-page-3103","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#smallint-type","content":"Possible values: -32768 to 32767. Mapped to java.lang.Short. The binary representation is a 2 byte short with the sign bit flipped (so that negative values sort before positive values)."},"6778":{"id":"/docs/single-page-3104","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#smallint-type","content":"Example"},"6779":{"id":"/docs/single-page-3105","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#unsigned_smallint-type","content":"Possible values: 0 to 32767. Mapped to java.lang.Short. The binary representation is an 2 byte integer, matching the Bytes.toBytes(short) method. The purpose of this type is to map to existing HBase data that was serialized using this HBase utility method. If that is not the case, use the regular signed type instead."},"6780":{"id":"/docs/single-page-3106","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#unsigned_smallint-type","content":"Example"},"6781":{"id":"/docs/single-page-3107","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#float-type","content":"Possible values: -3.402823466 E + 38 to 3.402823466 E + 38. Mapped to java.lang.Float. The binary representation is an 4 byte float with the sign bit flipped (so that negative values sort before positive values)."},"6782":{"id":"/docs/single-page-3108","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#float-type","content":"Example"},"6783":{"id":"/docs/single-page-3109","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#unsigned_float-type","content":"Possible values: 0 to 3.402823466 E + 38. Mapped to java.lang.Float. The binary representation is an 4 byte float matching the Bytes.toBytes(float) method. The purpose of this type is to map to existing HBase data that was serialized using this HBase utility method. If that is not the case, use the regular signed type instead."},"6784":{"id":"/docs/single-page-3110","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#unsigned_float-type","content":"Example"},"6785":{"id":"/docs/single-page-3111","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#double-type","content":"Possible values: -1.7976931348623158 E + 308 to 1.7976931348623158 E + 308. Mapped to java.lang.Double. The binary representation is an 8 byte double with the sign bit flipped (so that negative values sort before positive value)."},"6786":{"id":"/docs/single-page-3112","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#double-type","content":"Example"},"6787":{"id":"/docs/single-page-3113","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#unsigned_double-type","content":"Possible values: 0 to  1.7976931348623158 E + 308. Mapped to java.lang.Double. The binary representation is an 8 byte double matching the Bytes.toBytes(double) method. The purpose of this type is to map to existing HBase data that was serialized using this HBase utility method. If that is not the case, use the regular signed type instead."},"6788":{"id":"/docs/single-page-3114","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#unsigned_double-type","content":"Example"},"6789":{"id":"/docs/single-page-3115","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#decimal-type","content":"Data type with fixed precision and scale. A user can specify precision and scale by expression DECIMAL(precision,scale) in a DDL statement, for example, DECIMAL(10,2). The maximum precision is 38 digits. Mapped to java.math.BigDecimal. The binary representation is binary comparable, variable length format. When used in a row key, it is terminated with a null byte unless it is the last column."},"6790":{"id":"/docs/single-page-3116","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#decimal-type","content":"Example"},"6791":{"id":"/docs/single-page-3117","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#boolean-type","content":"Possible values: TRUE and FALSE."},"6792":{"id":"/docs/single-page-3118","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#boolean-type","content":"Mapped to java.lang.Boolean. The binary representation is a single byte with 0 for false and 1 for true"},"6793":{"id":"/docs/single-page-3119","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#boolean-type","content":"Example"},"6794":{"id":"/docs/single-page-3120","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#time-type","content":"The time data type. The format is yyyy-MM-dd hh:mm:ss, with both the date and time parts maintained. Mapped to java.sql.Time. The binary representation is an 8 byte long (the number of milliseconds from the epoch), making it possible (although not necessarily recommended) to store more information within a TIME column than what is provided by \"java.sql.Time\". Note that the internal representation is based on a number of milliseconds since the epoch (which is based on a time in GMT), while \"java.sql.Time\" will format times based on the client's local time zone. Please note that this TIME type is different than the TIME type as defined by the SQL 92 standard in that it includes year, month, and day components. As such, it is not in compliance with the JDBC APIs. As the underlying data is still stored as a long, only the presentation of the value is incorrect."},"6795":{"id":"/docs/single-page-3121","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#time-type","content":"Example"},"6796":{"id":"/docs/single-page-3122","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#date-type","content":"The date data type. The format is yyyy-MM-dd hh:mm:ss, with both the date and time parts maintained to a millisecond accuracy. Mapped to java.sql.Date. The binary representation is an 8 byte long (the number of milliseconds from the epoch), making it possible (although not necessarily recommended) to store more information within a DATE column than what is provided by \"java.sql.Date\". Note that the internal representation is based on a number of milliseconds since the epoch (which is based on a time in GMT), while \"java.sql.Date\" will format dates based on the client's local time zone. Please note that this DATE type is different than the DATE type as defined by the SQL 92 standard in that it includes a time component. As such, it is not in compliance with the JDBC APIs. As the underlying data is still stored as a long, only the presentation of the value is incorrect."},"6797":{"id":"/docs/single-page-3123","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#date-type","content":"Example"},"6798":{"id":"/docs/single-page-3124","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#timestamp-type","content":"The timestamp data type. The format is yyyy-MM-dd hh:mm:ss[.nnnnnnnnn]. Mapped to java.sql.Timestamp with an internal representation of the number of nanos from the epoch. The binary representation is 12 bytes: an 8 byte long for the epoch time plus a 4 byte integer for the nanos. Note that the internal representation is based on a number of milliseconds since the epoch (which is based on a time in GMT), while \"java.sql.Timestamp\" will format timestamps based on the client's local time zone."},"6799":{"id":"/docs/single-page-3125","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#timestamp-type","content":"Example"},"6800":{"id":"/docs/single-page-3126","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#unsigned_time-type","content":"The unsigned time data type. The format is yyyy-MM-dd hh:mm:ss, with both the date and time parts maintained to the millisecond accuracy. Mapped to java.sql.Time. The binary representation is an 8 byte long (the number of milliseconds from the epoch) matching the HBase.toBytes(long) method. The purpose of this type is to map to existing HBase data that was serialized using this HBase utility method. If that is not the case, use the regular signed type instead."},"6801":{"id":"/docs/single-page-3127","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#unsigned_time-type","content":"Example"},"6802":{"id":"/docs/single-page-3128","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#unsigned_date-type","content":"The unsigned date data type. The format is yyyy-MM-dd hh:mm:ss, with both the date and time parts maintained to a millisecond accuracy. Mapped to java.sql.Date. The binary representation is an 8 byte long (the number of milliseconds from the epoch) matching the HBase.toBytes(long) method. The purpose of this type is to map to existing HBase data that was serialized using this HBase utility method. If that is not the case, use the regular signed type instead."},"6803":{"id":"/docs/single-page-3129","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#unsigned_date-type","content":"Example"},"6804":{"id":"/docs/single-page-3130","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#unsigned_timestamp-type","content":"The timestamp data type. The format is yyyy-MM-dd hh:mm:ss[.nnnnnnnnn]. Mapped to java.sql.Timestamp with an internal representation of the number of nanos from the epoch. The binary representation is 12 bytes: an 8 byte long for the epoch time plus a 4 byte integer for the nanos with the long serialized through the HBase.toBytes(long) method. The purpose of this type is to map to existing HBase data that was serialized using this HBase utility method. If that is not the case, use the regular signed type instead."},"6805":{"id":"/docs/single-page-3131","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#unsigned_timestamp-type","content":"Example"},"6806":{"id":"/docs/single-page-3132","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#varchar-type","content":"A variable length String with an optional max byte length. The binary representation is UTF8 matching the Bytes.toBytes(String) method. When used in a row key, it is terminated with a null byte unless it is the last column."},"6807":{"id":"/docs/single-page-3133","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#varchar-type","content":"Mapped to java.lang.String."},"6808":{"id":"/docs/single-page-3134","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#varchar-type","content":"Example"},"6809":{"id":"/docs/single-page-3135","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#char-type","content":"A fixed length String with single-byte characters. The binary representation is UTF8 matching the Bytes.toBytes(String) method."},"6810":{"id":"/docs/single-page-3136","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#char-type","content":"Mapped to java.lang.String."},"6811":{"id":"/docs/single-page-3137","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#char-type","content":"Example"},"6812":{"id":"/docs/single-page-3138","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#binary-type","content":"Raw fixed length byte array."},"6813":{"id":"/docs/single-page-3139","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#binary-type","content":"Mapped to byte[]."},"6814":{"id":"/docs/single-page-3140","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#binary-type","content":"Example"},"6815":{"id":"/docs/single-page-3141","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#varbinary-type","content":"Raw variable length byte array."},"6816":{"id":"/docs/single-page-3142","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#varbinary-type","content":"Mapped to byte[]."},"6817":{"id":"/docs/single-page-3143","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#varbinary-type","content":"Example"},"6818":{"id":"/docs/single-page-3144","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#varbinary_encoded-type","content":"Variable length byte array that escapes embedded 0x00 bytes so its sort order matches the lexicographic order of the original bytes. Use it anywhere ordering matters: a non-trailing column of a composite primary key, an index key, or a row value constructor over binary data."},"6819":{"id":"/docs/single-page-3145","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#varbinary_encoded-type","content":"Mapped to byte[]. See VARBINARY_ENCODED for details."},"6820":{"id":"/docs/single-page-3146","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#varbinary_encoded-type","content":"Example"},"6821":{"id":"/docs/single-page-3147","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#array","content":"Mapped to java.sql.Array. Every primitive type except for VARBINARY may be declared as an ARRAY. Only single dimensional arrays are supported."},"6822":{"id":"/docs/single-page-3148","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#array","content":"Example"},"6823":{"id":"/docs/single-page-3149","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bson-type","content":"Native binary JSON document column for schemaless data. Phoenix can read individual fields with BSON_VALUE, filter rows with BSON_CONDITION_EXPRESSION, and atomically update fields with BSON_UPDATE_EXPRESSION — all evaluated server-side."},"6824":{"id":"/docs/single-page-3150","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bson-type","content":"Stored as BSON bytes; returned as org.bson.RawBsonDocument. See Document Data: BSON for details."},"6825":{"id":"/docs/single-page-3151","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bson-type","content":"Example"},"6826":{"id":"/docs/single-page-3152","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#array-type","content":"Apache Phoenix 3.0/4.0 introduced support for the JDBC ARRAY type. Any primitive type may be used in an ARRAY. Here is an example of declaring an array type when creating a table:"},"6827":{"id":"/docs/single-page-3153","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#array-type","content":"or alternately:"},"6828":{"id":"/docs/single-page-3154","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#array-type","content":"Insertion into the array may be done entirely through a SQL statement:"},"6829":{"id":"/docs/single-page-3155","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#array-type","content":"or programmatically through JDBC:"},"6830":{"id":"/docs/single-page-3156","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#array-type","content":"The entire array may be selected:"},"6831":{"id":"/docs/single-page-3157","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#array-type","content":"or an individual element in the array may be accessed via a subscript notation. The subscript is one-based, so the following would select the first element:"},"6832":{"id":"/docs/single-page-3158","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#array-type","content":"Use of the array subscript notation is supported in other expressions as well, for example in a WHERE clause:"},"6833":{"id":"/docs/single-page-3159","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#array-type","content":"The array length grows dynamically as needed and can be accessed through the built-in ARRAY_LENGTH function:"},"6834":{"id":"/docs/single-page-3160","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#array-type","content":"Attempts to access an array element beyond the current length will evaluate to null."},"6835":{"id":"/docs/single-page-3161","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#array-type","content":"For searching in an array, built-in functions like ANY and ALL are provided. For example,"},"6836":{"id":"/docs/single-page-3162","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#array-type","content":"The built-in function ANY checks if any array element satisfies the condition and is equivalent to an OR condition:"},"6837":{"id":"/docs/single-page-3163","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#array-type","content":"The built-in function ALL checks if all array elements satisfy the condition and is equivalent to an AND condition:"},"6838":{"id":"/docs/single-page-3164","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#array-type-limitations","content":"Only one-dimensional arrays are currently supported."},"6839":{"id":"/docs/single-page-3165","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#array-type-limitations","content":"For an array of fixed width types, null elements occurring in the middle of an array are not tracked."},"6840":{"id":"/docs/single-page-3166","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#array-type-limitations","content":"The declaration of an array length at DDL time is not enforced currently, but maybe in the future. Note that it is persisted with the table metadata."},"6841":{"id":"/docs/single-page-3167","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#array-type-limitations","content":"An array may only be used as the last column in a primary key constraint."},"6842":{"id":"/docs/single-page-3168","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#array-type-limitations","content":"Partial update of an array is currently not possible. Instead, the array may be manipulated on the client-side and then upserted back in its entirety."},"6843":{"id":"/docs/single-page-3169","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#sequences","content":"Sequences are a standard SQL feature that generate monotonically increasing numbers, typically used to create IDs. To create a sequence, use:"},"6844":{"id":"/docs/single-page-3170","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#sequences","content":"This creates a sequence named my_schema.my_sequence with an initial value of 1, incremented by 1 each time, with no cycle, minimum value, or maximum value, and 100 sequence values cached in your session (controlled by the phoenix.sequence.cacheSize config parameter). The complete syntax of CREATE SEQUENCE is documented here."},"6845":{"id":"/docs/single-page-3171","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#sequences","content":"Caching sequence values on your session improves performance, as we don't need to ask the server for more sequence values until we run out of cached values. The tradeoff is that you may end up with gaps in your sequence values when other sessions also use the same sequence."},"6846":{"id":"/docs/single-page-3172","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#sequences","content":"All of these parameters can be overridden when the sequence is created like this:"},"6847":{"id":"/docs/single-page-3173","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#sequences","content":"Phoenix 3.1/4.1 added support for defining minimum and maximum values using MINVALUE and MAXVALUE, and for controlling cycling with the CYCLE keyword. Specifying CYCLE means the sequence continues generating values after reaching either boundary. For ascending sequences, after the maximum it returns to the minimum. For descending sequences, after the minimum it returns to the maximum. For example:"},"6848":{"id":"/docs/single-page-3174","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#sequences","content":"will cause the sequence to cycle continuously from 1 to 100."},"6849":{"id":"/docs/single-page-3175","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#sequences","content":"Sequences are incremented using the NEXT VALUE FOR <sequence_name> expression in UPSERT VALUES, UPSERT SELECT, or SELECT statements:"},"6850":{"id":"/docs/single-page-3176","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#sequences","content":"This will allocate a BIGINT based on the next value from the sequence (beginning with the START WITH value and incrementing from there based on the INCREMENT BY amount)."},"6851":{"id":"/docs/single-page-3177","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#sequences","content":"When used in an UPSERT SELECT or SELECT statement, each row returned by the statement would have a unique value associated with it. For example:"},"6852":{"id":"/docs/single-page-3178","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#sequences","content":"This allocates a new sequence value for each row returned from the SELECT expression. A sequence is incremented only once per statement, so multiple references to the same sequence by NEXT VALUE FOR produce the same value. For example, in the statement below, my_table.col1 and my_table.col2 would end up with the same value:"},"6853":{"id":"/docs/single-page-3179","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#sequences","content":"You may also access the last sequence value allocated using a CURRENT VALUE FOR expression as shown below:"},"6854":{"id":"/docs/single-page-3180","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#sequences","content":"This would evaluate to the last sequence value allocated from the previous NEXT VALUE FOR expression for your session (i.e. all connections on the same JVM for the same client machine). If no NEXT VALUE FOR expression had been previously called, this would produce an exception. If in a given statement a CURRENT VALUE FOR expression is used together with a NEXT VALUE FOR expression for the same sequence, then both would evaluate to the value produced by the NEXT VALUE FOR expression."},"6855":{"id":"/docs/single-page-3181","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#sequences","content":"The NEXT VALUE FOR and CURRENT VALUE FOR expressions may only be used as SELECT expressions or in the UPSERT VALUES statement. Use in WHERE, GROUP BY, HAVING, or ORDER BY will produce an exception. In addition, they cannot be used as the argument to an aggregate function."},"6856":{"id":"/docs/single-page-3182","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#sequences","content":"To drop a sequence, issue the following command:"},"6857":{"id":"/docs/single-page-3183","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#sequences","content":"To discover all sequences that have been created, you may query the SYSTEM.SEQUENCE table as shown here:"},"6858":{"id":"/docs/single-page-3184","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#sequences","content":"Note that only read-only access to the SYSTEM.SEQUENCE table is supported."},"6859":{"id":"/docs/single-page-3185","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#joins","content":"The standard SQL join syntax (with some limitations) is now supported by Phoenix to combine records from two or more tables based on their fields having common values."},"6860":{"id":"/docs/single-page-3186","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#joins","content":"For example, we have the following tables to store our order records, our customer information and the item information we sell in those orders."},"6861":{"id":"/docs