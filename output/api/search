e-page-698","page_id":"/docs/single-page","type":"heading","tags":["single-page"],"url":"/docs/single-page#building-phoenix-project-website","content":"Building Phoenix Project Website"},"4373":{"id":"/docs/single-page-699","page_id":"/docs/single-page","type":"heading","tags":["single-page"],"url":"/docs/single-page#publishing-website-artifact","content":"Publishing Website Artifact"},"4374":{"id":"/docs/single-page-700","page_id":"/docs/single-page","type":"heading","tags":["single-page"],"url":"/docs/single-page#local-testing-during-development","content":"Local Testing During Development"},"4375":{"id":"/docs/single-page-701","page_id":"/docs/single-page","type":"heading","tags":["single-page"],"url":"/docs/single-page#how-to-release","content":"How to Release"},"4376":{"id":"/docs/single-page-702","page_id":"/docs/single-page","type":"heading","tags":["single-page"],"url":"/docs/single-page#contributing-how-to-release","content":"How to Release"},"4377":{"id":"/docs/single-page-703","page_id":"/docs/single-page","type":"heading","tags":["single-page"],"url":"/docs/single-page#pre-reqs","content":"Pre-Reqs"},"4378":{"id":"/docs/single-page-704","page_id":"/docs/single-page","type":"heading","tags":["single-page"],"url":"/docs/single-page#do-a-dry-run","content":"Do a dry run"},"4379":{"id":"/docs/single-page-705","page_id":"/docs/single-page","type":"heading","tags":["single-page"],"url":"/docs/single-page#create-real-rc","content":"Create real RC"},"4380":{"id":"/docs/single-page-706","page_id":"/docs/single-page","type":"heading","tags":["single-page"],"url":"/docs/single-page#close-the-staging-repository","content":"Close the staging repository"},"4381":{"id":"/docs/single-page-707","page_id":"/docs/single-page","type":"heading","tags":["single-page"],"url":"/docs/single-page#voting","content":"Voting"},"4382":{"id":"/docs/single-page-708","page_id":"/docs/single-page","type":"heading","tags":["single-page"],"url":"/docs/single-page#release","content":"Release"},"4383":{"id":"/docs/single-page-709","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#overview","content":"OLTP and operational analytics for Apache Hadoop"},"4384":{"id":"/docs/single-page-710","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#overview","content":"Download latest Apache Phoenix binary and source release artifacts"},"4385":{"id":"/docs/single-page-711","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#overview","content":"Browse Apache Phoenix JIRAs"},"4386":{"id":"/docs/single-page-712","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#overview","content":"Sync and build Apache Phoenix from source code"},"4387":{"id":"/docs/single-page-713","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#overview","content":"type: info"},"4388":{"id":"/docs/single-page-714","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#overview","content":"News: Phoenix 5.3.0 has been released and is available for\ndownload here. Follow Apache Phoenix on\nX/Twitter."},"4389":{"id":"/docs/single-page-715","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#overview","content":"Apache Phoenix enables OLTP and operational analytics in Hadoop for low-latency applications by combining:"},"4390":{"id":"/docs/single-page-716","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#overview","content":"the power of standard SQL and JDBC APIs, with full ACID transaction capabilities"},"4391":{"id":"/docs/single-page-717","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#overview","content":"the flexibility of late-bound, schema-on-read capabilities from the NoSQL world by leveraging HBase as its backing store"},"4392":{"id":"/docs/single-page-718","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#overview","content":"Apache Phoenix is fully integrated with other Hadoop products such as Spark, Hive, Pig, Flume, and MapReduce."},"4393":{"id":"/docs/single-page-719","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#overview","content":"Who is using Apache Phoenix? Read more here."},"4394":{"id":"/docs/single-page-720","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#mission","content":"Become the trusted data platform for OLTP and operational analytics for Hadoop through well-defined, industry-standard APIs."},"4395":{"id":"/docs/single-page-721","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#index-quick-start","content":"Tired of reading and just want to get started? Take a look at our FAQs, listen to the Apache Phoenix talk from Hadoop Summit 2015, review the overview presentation, and jump to our quick start guide here."},"4396":{"id":"/docs/single-page-722","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#sql-support","content":"Apache Phoenix takes your SQL query, compiles it into a series of HBase scans, and orchestrates those scans to produce regular JDBC result sets. Direct use of the HBase API, along with coprocessors and custom filters, results in performance on the order of milliseconds for small queries, or seconds for tens of millions of rows."},"4397":{"id":"/docs/single-page-723","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#sql-support","content":"To see a complete list of what is supported, go to our language reference. All standard SQL query constructs are supported, including SELECT, FROM, WHERE, GROUP BY, HAVING, ORDER BY, etc. It also supports a full set of DML commands, as well as table creation and versioned incremental alterations through DDL commands."},"4398":{"id":"/docs/single-page-724","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#sql-support","content":"Here is a list of what is currently not supported:"},"4399":{"id":"/docs/single-page-725","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#sql-support","content":"Relational operators: INTERSECT, MINUS"},"4400":{"id":"/docs/single-page-726","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#sql-support","content":"Miscellaneous built-in functions: these are easy to add — read this blog for step-by-step instructions."},"4401":{"id":"/docs/single-page-727","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#connection","content":"Use JDBC to get a connection to an HBase cluster:"},"4402":{"id":"/docs/single-page-728","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#connection","content":"Where props are optional properties that may include Phoenix and HBase configuration values."},"4403":{"id":"/docs/single-page-729","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#connection","content":"The JDBC connection string is composed as:"},"4404":{"id":"/docs/single-page-730","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#connection","content":"For omitted parts, values are taken from hbase-site.xml (hbase.zookeeper.quorum, hbase.zookeeper.property.clientPort, and zookeeper.znode.parent)."},"4405":{"id":"/docs/single-page-731","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#connection","content":"The optional principal and keytab file may be used to connect to a Kerberos-secured cluster. If only principal is specified, each distinct user gets a dedicated HBase connection (HConnection), allowing multiple different connections with different configuration properties on the same JVM."},"4406":{"id":"/docs/single-page-732","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#connection","content":"For example, for longer-running queries:"},"4407":{"id":"/docs/single-page-733","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#connection","content":"And for shorter-running queries:"},"4408":{"id":"/docs/single-page-734","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#connection","content":"See the relevant FAQ entry for example URLs."},"4409":{"id":"/docs/single-page-735","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#connection","content":"Phoenix also supports connecting to HBase without ZooKeeper."},"4410":{"id":"/docs/single-page-736","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#index-transactions","content":"To enable full ACID transactions (beta in 4.7.0), set phoenix.transactions.enabled=true. In this case, you also need to run the transaction manager included in the distribution. Once enabled, a table may optionally be declared as transactional (see transactions)."},"4411":{"id":"/docs/single-page-737","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#index-transactions","content":"Commits over transactional tables are all-or-none: either all data is committed (including secondary index updates) or none is committed (and an exception is thrown). Both cross-table and cross-row transactions are supported. Transactional tables also see their own uncommitted data when querying. An optimistic concurrency model is used to detect row-level conflicts with first-commit-wins semantics."},"4412":{"id":"/docs/single-page-738","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#index-transactions","content":"Non-transactional tables have no guarantees beyond HBase row-level atomicity (see HBase ACID semantics). Also, non-transactional tables do not see updates until commit occurs."},"4413":{"id":"/docs/single-page-739","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#index-transactions","content":"Phoenix DML commands (UPSERT VALUES, UPSERT SELECT, DELETE) batch pending changes on the client side. Changes are sent to server on commit and discarded on rollback. If auto-commit is enabled, Phoenix will execute the entire DML command server-side via coprocessors whenever possible for better performance."},"4414":{"id":"/docs/single-page-740","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#timestamps","content":"Most applications let HBase manage timestamps. In cases where timestamps must be controlled, the CurrentSCN property can be set at connection time to control timestamps for DDL, DML, and queries. This also enables snapshot queries against prior row values because Phoenix uses this property as scan max timestamp."},"4415":{"id":"/docs/single-page-741","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#timestamps","content":"Timestamps cannot be controlled for transactional tables. Instead, the transaction manager assigns timestamps that become HBase cell timestamps on commit. They still correspond to wall-clock time, but are multiplied by 1,000,000 to ensure enough granularity for uniqueness across the cluster."},"4416":{"id":"/docs/single-page-742","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#schema","content":"Apache Phoenix supports table creation and versioned incremental alterations through DDL commands. Table metadata is stored in an HBase table and versioned, so snapshot queries over prior versions automatically use the correct schema."},"4417":{"id":"/docs/single-page-743","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#schema","content":"A Phoenix table can be created through CREATE TABLE and can either be:"},"4418":{"id":"/docs/single-page-744","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#schema","content":"Built from scratch: HBase table and column families are created automatically."},"4419":{"id":"/docs/single-page-745","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#schema","content":"Mapped to an existing HBase table: either as a read-write TABLE or a read-only VIEW, with the caveat that row key/key-value binary representation must match Phoenix data types (see Data Types)."},"4420":{"id":"/docs/single-page-746","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#schema","content":"For a read-write TABLE, column families are created automatically if absent. An empty key value is added to the first column family of each existing row to minimize projection size for queries."},"4421":{"id":"/docs/single-page-747","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#schema","content":"For a read-only VIEW, all column families must already exist. The only change is adding Phoenix coprocessors for query processing. The primary use case is transferring existing data into Phoenix; DML is not allowed on a VIEW, and query performance may be lower than with a TABLE."},"4422":{"id":"/docs/single-page-748","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#schema","content":"All schema is versioned (up to 1000 versions kept). Snapshot queries over older data pick up the correct schema based on connection time via CurrentSCN."},"4423":{"id":"/docs/single-page-749","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#altering","content":"A Phoenix table may be altered via ALTER TABLE. When a SQL statement references a table, Phoenix checks with the server by default to ensure metadata and statistics are up to date."},"4424":{"id":"/docs/single-page-750","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#altering","content":"If table structure is known to be stable, this RPC may be unnecessary. UPDATE_CACHE_FREQUENCY (added in 4.7) lets users define how often the server is checked for metadata/statistics updates. Possible values: ALWAYS (default), NEVER, or a millisecond value."},"4425":{"id":"/docs/single-page-751","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#altering","content":"For example, this DDL creates table FOO and tells clients to check for updates every 15 minutes:"},"4426":{"id":"/docs/single-page-752","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#index-views","content":"Phoenix supports updatable views on top of tables, with the unique capability of adding columns by leveraging HBase schemaless behavior. All views share the same underlying HBase table and may be indexed independently. Read more here."},"4427":{"id":"/docs/single-page-753","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#index-multi-tenancy","content":"Built on top of view support, Phoenix also supports multi-tenancy. As with views, a multi-tenant view can add columns defined solely for that user."},"4428":{"id":"/docs/single-page-754","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#schema-at-read-time","content":"Another schema-related feature allows columns to be defined dynamically at query time. This is useful when not all columns are known at create time. More details here."},"4429":{"id":"/docs/single-page-755","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#mapping-to-an-existing-hbase-table","content":"Phoenix supports mapping to an existing HBase table through CREATE TABLE and CREATE VIEW. In both cases, HBase metadata remains as-is, except that with CREATE TABLE, KEEP_DELETED_CELLS is enabled so flashback queries work correctly."},"4430":{"id":"/docs/single-page-756","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#mapping-to-an-existing-hbase-table","content":"For CREATE TABLE, missing HBase metadata (table/column families) is created if needed. Table and column family names are case-sensitive at HBase level; Phoenix uppercases names by default. To preserve case sensitivity, wrap names in double quotes:"},"4431":{"id":"/docs/single-page-757","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#mapping-to-an-existing-hbase-table","content":"For CREATE TABLE, an empty key value is added per row so queries behave as expected without projecting all columns during scans. For CREATE VIEW, this is not done and no HBase metadata is created. Existing HBase metadata must match DDL metadata, or ERROR 505 (42000): Table is read only is thrown."},"4432":{"id":"/docs/single-page-758","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#mapping-to-an-existing-hbase-table","content":"Another caveat: bytes serialized in HBase must match Phoenix serialization expectations."},"4433":{"id":"/docs/single-page-759","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#mapping-to-an-existing-hbase-table","content":"For VARCHAR, CHAR, and UNSIGNED_* types, Phoenix uses HBase Bytes utility methods."},"4434":{"id":"/docs/single-page-760","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#mapping-to-an-existing-hbase-table","content":"CHAR expects only single-byte characters."},"4435":{"id":"/docs/single-page-761","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#mapping-to-an-existing-hbase-table","content":"UNSIGNED_* expects non-negative values."},"4436":{"id":"/docs/single-page-762","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#mapping-to-an-existing-hbase-table","content":"Composite row keys are formed by concatenating values, with a zero byte separator after variable-length types. For more on type system details, see Data Types."},"4437":{"id":"/docs/single-page-763","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#index-salting","content":"Tables can be declared salted to avoid HBase region hotspotting. Declare a salt bucket count and Phoenix manages salting transparently. See details here, and write-throughput comparison here."},"4438":{"id":"/docs/single-page-764","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#apis","content":"Catalog metadata (tables, columns, primary keys, and types) can be retrieved through Java SQL metadata interfaces: DatabaseMetaData, ParameterMetaData, and ResultSetMetaData."},"4439":{"id":"/docs/single-page-765","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#apis","content":"For schema/table/column retrieval via DatabaseMetaData, schema pattern, table pattern, and column pattern are LIKE-style expressions (% and _, escaped by \\)."},"4440":{"id":"/docs/single-page-766","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#apis","content":"In metadata APIs, table catalog argument is used to filter by tenant ID for multi-tenant tables."},"4441":{"id":"/docs/single-page-767","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#what-is-this-new-phoenix-thing-ive-been-hearing-about","content":"Phoenix is an open source SQL skin for HBase. You use the standard JDBC APIs instead of the regular HBase client APIs to create tables, insert data, and query your HBase data."},"4442":{"id":"/docs/single-page-768","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#doesnt-putting-an-extra-layer-between-my-application-and-hbase-just-slow-things-down","content":"Actually, no. Phoenix achieves as good or likely better performance than if you hand-coded it yourself (not to mention with a heck of a lot less code) by:"},"4443":{"id":"/docs/single-page-769","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#doesnt-putting-an-extra-layer-between-my-application-and-hbase-just-slow-things-down","content":"compiling your SQL queries to native HBase scans"},"4444":{"id":"/docs/single-page-770","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#doesnt-putting-an-extra-layer-between-my-application-and-hbase-just-slow-things-down","content":"determining the optimal start and stop for your scan key"},"4445":{"id":"/docs/single-page-771","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#doesnt-putting-an-extra-layer-between-my-application-and-hbase-just-slow-things-down","content":"orchestrating the parallel execution of your scans"},"4446":{"id":"/docs/single-page-772","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#doesnt-putting-an-extra-layer-between-my-application-and-hbase-just-slow-things-down","content":"bringing the computation to the data by"},"4447":{"id":"/docs/single-page-773","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#doesnt-putting-an-extra-layer-between-my-application-and-hbase-just-slow-things-down","content":"pushing the predicates in your where clause to a server-side filter"},"4448":{"id":"/docs/single-page-774","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#doesnt-putting-an-extra-layer-between-my-application-and-hbase-just-slow-things-down","content":"executing aggregate queries through server-side hooks (called co-processors)"},"4449":{"id":"/docs/single-page-775","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#doesnt-putting-an-extra-layer-between-my-application-and-hbase-just-slow-things-down","content":"secondary indexes to improve performance for queries on non row key columns"},"4450":{"id":"/docs/single-page-776","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#doesnt-putting-an-extra-layer-between-my-application-and-hbase-just-slow-things-down","content":"stats gathering to improve parallelization and guide choices between optimizations"},"4451":{"id":"/docs/single-page-777","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#doesnt-putting-an-extra-layer-between-my-application-and-hbase-just-slow-things-down","content":"skip scan filter to optimize IN, LIKE, and OR queries"},"4452":{"id":"/docs/single-page-778","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#doesnt-putting-an-extra-layer-between-my-application-and-hbase-just-slow-things-down","content":"optional salting of row keys to evenly distribute write load"},"4453":{"id":"/docs/single-page-779","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#ok-so-its-fast-but-why-sql-its-so-1970s","content":"Well, that's kind of the point: give folks something with which they're already familiar. What better way to spur the adoption of HBase? On top of that, using JDBC and SQL:"},"4454":{"id":"/docs/single-page-780","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#ok-so-its-fast-but-why-sql-its-so-1970s","content":"Reduces the amount of code users need to write"},"4455":{"id":"/docs/single-page-781","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#ok-so-its-fast-but-why-sql-its-so-1970s","content":"Allows for performance optimizations transparent to the user"},"4456":{"id":"/docs/single-page-782","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#ok-so-its-fast-but-why-sql-its-so-1970s","content":"Opens the door for leveraging and integrating lots of existing tooling"},"4457":{"id":"/docs/single-page-783","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#but-how-can-sql-support-my-favorite-hbase-technique-of-xyz","content":"Didn't make it to the last HBase Meetup did you? SQL is just a way of expressing what you want to get not how you want to get it. Check out my presentation for various existing and to-be-done Phoenix features to support your favorite HBase trick. Have ideas of your own? We'd love to hear about them: file an issue for us and/or join our mailing list."},"4458":{"id":"/docs/single-page-784","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#blah-blah-blah---i-just-want-to-get-started","content":"Ok, great! Just follow our install instructions:"},"4459":{"id":"/docs/single-page-785","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#blah-blah-blah---i-just-want-to-get-started","content":"download and expand our installation binary tar corresponding to your HBase version"},"4460":{"id":"/docs/single-page-786","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#blah-blah-blah---i-just-want-to-get-started","content":"copy the phoenix server jar into the lib directory of every region server and master"},"4461":{"id":"/docs/single-page-787","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#blah-blah-blah---i-just-want-to-get-started","content":"restart HBase"},"4462":{"id":"/docs/single-page-788","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#blah-blah-blah---i-just-want-to-get-started","content":"add the phoenix client jar to the classpath of your JDBC client or application"},"4463":{"id":"/docs/single-page-789","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#blah-blah-blah---i-just-want-to-get-started","content":"We have detailed instructions for setting up SQuirreL SQL as your SQL client"},"4464":{"id":"/docs/single-page-790","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#i-dont-want-to-download-and-setup-anything-else","content":"Ok, fair enough - you can create your own SQL scripts and execute them using our command line tools instead. Let's walk through an example now. Begin by navigating to the bin/ directory of your Phoenix install location."},"4465":{"id":"/docs/single-page-791","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#start-the-interactive-sql-client","content":"and issue a query"},"4466":{"id":"/docs/single-page-792","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#start-the-interactive-sql-client","content":"Congratulations! You've just created your first Phoenix table, inserted data into it, and executed an aggregate query with just a few lines of code in 15 minutes or less!"},"4467":{"id":"/docs/single-page-793","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#big-deal---10-rows-what-else-you-got","content":"Ok, ok - tough crowd. Check out our bin/performance.py script to create as many rows as you want, for any schema you come up with, and run timed queries against it."},"4468":{"id":"/docs/single-page-794","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#why-is-it-called-phoenix-anyway-did-s