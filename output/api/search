ilding-15","page_id":"/docs/fundamentals/building","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/building#branches","content":"5.x works with HBase 2 and Hadoop 3"},"2198":{"id":"/docs/fundamentals/building-16","page_id":"/docs/fundamentals/building","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/building#branches","content":"See Downloads and BUILDING.md for exact version compatibility by release."},"2199":{"id":"/docs/fundamentals/building-17","page_id":"/docs/fundamentals/building","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/building#branches","content":"See also:"},"2200":{"id":"/docs/fundamentals/building-18","page_id":"/docs/fundamentals/building","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/building#branches","content":"Building Project Website"},"2201":{"id":"/docs/fundamentals/building-19","page_id":"/docs/fundamentals/building","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/building#branches","content":"How to Release"},"2202":{"id":"/docs/fundamentals/client-classpath-and-jdbc-url","page_id":"/docs/fundamentals/client-classpath-and-jdbc-url","type":"page","content":"Client Classpath and JDBC URL","breadcrumbs":["Docs","Multi-Page Documentation","Development","Fundamentals"],"tags":["multi-page"],"url":"/docs/fundamentals/client-classpath-and-jdbc-url"},"2203":{"id":"/docs/fundamentals/client-classpath-and-jdbc-url-0","page_id":"/docs/fundamentals/client-classpath-and-jdbc-url","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/client-classpath-and-jdbc-url","content":"Configure Phoenix thick-client classpath and JDBC URLs."},"2204":{"id":"/docs/fundamentals/client-classpath-and-jdbc-url-1","page_id":"/docs/fundamentals/client-classpath-and-jdbc-url","type":"heading","tags":["multi-page"],"url":"/docs/fundamentals/client-classpath-and-jdbc-url#using-the-phoenix-jdbc-driver","content":"Using the Phoenix JDBC Driver"},"2205":{"id":"/docs/fundamentals/client-classpath-and-jdbc-url-2","page_id":"/docs/fundamentals/client-classpath-and-jdbc-url","type":"heading","tags":["multi-page"],"url":"/docs/fundamentals/client-classpath-and-jdbc-url#the-phoenix-classpath","content":"The Phoenix classpath"},"2206":{"id":"/docs/fundamentals/client-classpath-and-jdbc-url-3","page_id":"/docs/fundamentals/client-classpath-and-jdbc-url","type":"heading","tags":["multi-page"],"url":"/docs/fundamentals/client-classpath-and-jdbc-url#phoenix-driver-jar","content":"Phoenix driver JAR"},"2207":{"id":"/docs/fundamentals/client-classpath-and-jdbc-url-4","page_id":"/docs/fundamentals/client-classpath-and-jdbc-url","type":"heading","tags":["multi-page"],"url":"/docs/fundamentals/client-classpath-and-jdbc-url#hbase--hadoop-configuration-files","content":"HBase / Hadoop configuration files"},"2208":{"id":"/docs/fundamentals/client-classpath-and-jdbc-url-5","page_id":"/docs/fundamentals/client-classpath-and-jdbc-url","type":"heading","tags":["multi-page"],"url":"/docs/fundamentals/client-classpath-and-jdbc-url#the-phoenix-jdbc-url","content":"The Phoenix JDBC URL"},"2209":{"id":"/docs/fundamentals/client-classpath-and-jdbc-url-6","page_id":"/docs/fundamentals/client-classpath-and-jdbc-url","type":"heading","tags":["multi-page"],"url":"/docs/fundamentals/client-classpath-and-jdbc-url#default-connection","content":"Default connection"},"2210":{"id":"/docs/fundamentals/client-classpath-and-jdbc-url-7","page_id":"/docs/fundamentals/client-classpath-and-jdbc-url","type":"heading","tags":["multi-page"],"url":"/docs/fundamentals/client-classpath-and-jdbc-url#the-jdbcphoenix-protocol-variant","content":"The jdbc:phoenix: protocol variant"},"2211":{"id":"/docs/fundamentals/client-classpath-and-jdbc-url-8","page_id":"/docs/fundamentals/client-classpath-and-jdbc-url","type":"heading","tags":["multi-page"],"url":"/docs/fundamentals/client-classpath-and-jdbc-url#the-jdbcphoenixzk-protocol-variant","content":"The jdbc:phoenix+zk: protocol variant"},"2212":{"id":"/docs/fundamentals/client-classpath-and-jdbc-url-9","page_id":"/docs/fundamentals/client-classpath-and-jdbc-url","type":"heading","tags":["multi-page"],"url":"/docs/fundamentals/client-classpath-and-jdbc-url#the-jdbcphoenixmaster-protocol-variant","content":"The jdbc:phoenix+master: protocol variant"},"2213":{"id":"/docs/fundamentals/client-classpath-and-jdbc-url-10","page_id":"/docs/fundamentals/client-classpath-and-jdbc-url","type":"heading","tags":["multi-page"],"url":"/docs/fundamentals/client-classpath-and-jdbc-url#the-jdbcphoenixrpc-protocol-variant","content":"The jdbc:phoenix+rpc: protocol variant"},"2214":{"id":"/docs/fundamentals/client-classpath-and-jdbc-url-11","page_id":"/docs/fundamentals/client-classpath-and-jdbc-url","type":"heading","tags":["multi-page"],"url":"/docs/fundamentals/client-classpath-and-jdbc-url#client-classpath-and-jdbc-url-notes","content":"Notes"},"2215":{"id":"/docs/fundamentals/client-classpath-and-jdbc-url-12","page_id":"/docs/fundamentals/client-classpath-and-jdbc-url","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/client-classpath-and-jdbc-url#using-the-phoenix-jdbc-driver","content":"This page is about using the Phoenix thick client."},"2216":{"id":"/docs/fundamentals/client-classpath-and-jdbc-url-13","page_id":"/docs/fundamentals/client-classpath-and-jdbc-url","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/client-classpath-and-jdbc-url#using-the-phoenix-jdbc-driver","content":"The thin client for Phoenix Query Server is described on its own page."},"2217":{"id":"/docs/fundamentals/client-classpath-and-jdbc-url-14","page_id":"/docs/fundamentals/client-classpath-and-jdbc-url","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/client-classpath-and-jdbc-url#the-phoenix-classpath","content":"To use Phoenix, both the JDBC driver JAR and hbase-site.xml must be added to the application classpath."},"2218":{"id":"/docs/fundamentals/client-classpath-and-jdbc-url-15","page_id":"/docs/fundamentals/client-classpath-and-jdbc-url","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/client-classpath-and-jdbc-url#phoenix-driver-jar","content":"The Phoenix JDBC client is built on top of the HBase client, and has an unusually high number of dependencies.\nTo make this manageable, Phoenix provides a single shaded uberjar that can be added to the classpath."},"2219":{"id":"/docs/fundamentals/client-classpath-and-jdbc-url-16","page_id":"/docs/fundamentals/client-classpath-and-jdbc-url","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/client-classpath-and-jdbc-url#phoenix-driver-jar","content":"Phoenix uses some private and semi-public HBase APIs, which may change between HBase versions, and provides separate binary distributions for different HBase versions."},"2220":{"id":"/docs/fundamentals/client-classpath-and-jdbc-url-17","page_id":"/docs/fundamentals/client-classpath-and-jdbc-url","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/client-classpath-and-jdbc-url#phoenix-driver-jar","content":"Choose the binary distribution or Maven artifact corresponding to the HBase version on your cluster."},"2221":{"id":"/docs/fundamentals/client-classpath-and-jdbc-url-18","page_id":"/docs/fundamentals/client-classpath-and-jdbc-url","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/client-classpath-and-jdbc-url#phoenix-driver-jar","content":"Copy the driver JAR from the binary distribution."},"2222":{"id":"/docs/fundamentals/client-classpath-and-jdbc-url-19","page_id":"/docs/fundamentals/client-classpath-and-jdbc-url","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/client-classpath-and-jdbc-url#phoenix-driver-jar","content":"Copy the corresponding phoenix-client-embedded-hbase-[hbase.profile]-[phoenix.version].jar to the application classpath."},"2223":{"id":"/docs/fundamentals/client-classpath-and-jdbc-url-20","page_id":"/docs/fundamentals/client-classpath-and-jdbc-url","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/client-classpath-and-jdbc-url#phoenix-driver-jar","content":"Add the dependency via Maven."},"2224":{"id":"/docs/fundamentals/client-classpath-and-jdbc-url-21","page_id":"/docs/fundamentals/client-classpath-and-jdbc-url","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/client-classpath-and-jdbc-url#hbase--hadoop-configuration-files","content":"As Phoenix is built on top of the HBase client, it needs the HBase configuration files for correct operation.\nFor some configurations, it may also need other Hadoop / HDFS config files like core-site.xml."},"2225":{"id":"/docs/fundamentals/client-classpath-and-jdbc-url-22","page_id":"/docs/fundamentals/client-classpath-and-jdbc-url","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/client-classpath-and-jdbc-url#hbase--hadoop-configuration-files","content":"Download the correct hbase-site.xml (the client one, usually in /etc/hbase/conf) from the cluster, and copy it to a directory on the classpath.\nIt is important to add the directory containing hbase-site.xml, and not the full file path, to the classpath."},"2226":{"id":"/docs/fundamentals/client-classpath-and-jdbc-url-23","page_id":"/docs/fundamentals/client-classpath-and-jdbc-url","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/client-classpath-and-jdbc-url#hbase--hadoop-configuration-files","content":"Alternatively, package hbase-site.xml into the root directory of a JAR file and add that JAR to the classpath."},"2227":{"id":"/docs/fundamentals/client-classpath-and-jdbc-url-24","page_id":"/docs/fundamentals/client-classpath-and-jdbc-url","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/client-classpath-and-jdbc-url#hbase--hadoop-configuration-files","content":"If hbase-site.xml changes on the cluster, make sure to copy the updated file to your application classpath."},"2228":{"id":"/docs/fundamentals/client-classpath-and-jdbc-url-25","page_id":"/docs/fundamentals/client-classpath-and-jdbc-url","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/client-classpath-and-jdbc-url#hbase--hadoop-configuration-files","content":"For some development clusters that use default configuration Phoenix may work without this, but not having the correct hbase-site.xml on the\nclasspath is almost guaranteed to cause problems."},"2229":{"id":"/docs/fundamentals/client-classpath-and-jdbc-url-26","page_id":"/docs/fundamentals/client-classpath-and-jdbc-url","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/client-classpath-and-jdbc-url#the-phoenix-jdbc-url","content":"The Phoenix URL contains two main parts. The first describes the connection to HBase; the second specifies extra Phoenix options."},"2230":{"id":"/docs/fundamentals/client-classpath-and-jdbc-url-27","page_id":"/docs/fundamentals/client-classpath-and-jdbc-url","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/client-classpath-and-jdbc-url#the-phoenix-jdbc-url","content":"protocol variant: The HBase connection registry to use (details below)."},"2231":{"id":"/docs/fundamentals/client-classpath-and-jdbc-url-28","page_id":"/docs/fundamentals/client-classpath-and-jdbc-url","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/client-classpath-and-jdbc-url#the-phoenix-jdbc-url","content":"server list: A comma-separated list of hostnames or IPv4 addresses.\nIt is also possible to specify per-host ports, as defined in HBASE-12706. In this case : characters must be escaped with \\. You may need to escape again in Java source strings."},"2232":{"id":"/docs/fundamentals/client-classpath-and-jdbc-url-29","page_id":"/docs/fundamentals/client-classpath-and-jdbc-url","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/client-classpath-and-jdbc-url#the-phoenix-jdbc-url","content":"port: An integer port number. Ports specified in server list take precedence."},"2233":{"id":"/docs/fundamentals/client-classpath-and-jdbc-url-30","page_id":"/docs/fundamentals/client-classpath-and-jdbc-url","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/client-classpath-and-jdbc-url#the-phoenix-jdbc-url","content":"zk root node: The root znode for HBase. Must be empty for non-ZK registries."},"2234":{"id":"/docs/fundamentals/client-classpath-and-jdbc-url-31","page_id":"/docs/fundamentals/client-classpath-and-jdbc-url","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/client-classpath-and-jdbc-url#the-phoenix-jdbc-url","content":"principal: The Kerberos principal used for authentication.If only principal is specified, this defines a distinct user identity with its own dedicated HBase connection (HConnection) and allows multiple differently configured connections in the same JVM."},"2235":{"id":"/docs/fundamentals/client-classpath-and-jdbc-url-32","page_id":"/docs/fundamentals/client-classpath-and-jdbc-url","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/client-classpath-and-jdbc-url#the-phoenix-jdbc-url","content":"keytab: Kerberos keytab used for authentication. Must be specified together with principal."},"2236":{"id":"/docs/fundamentals/client-classpath-and-jdbc-url-33","page_id":"/docs/fundamentals/client-classpath-and-jdbc-url","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/client-classpath-and-jdbc-url#the-phoenix-jdbc-url","content":"option: A connection option."},"2237":{"id":"/docs/fundamentals/client-classpath-and-jdbc-url-34","page_id":"/docs/fundamentals/client-classpath-and-jdbc-url","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/client-classpath-and-jdbc-url#the-phoenix-jdbc-url","content":"value: A connection option value."},"2238":{"id":"/docs/fundamentals/client-classpath-and-jdbc-url-35","page_id":"/docs/fundamentals/client-classpath-and-jdbc-url","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/client-classpath-and-jdbc-url#the-phoenix-jdbc-url","content":"Parameters from end of the connection definition can be omitted.\nUse empty strings for missing parameters in the middle of the URL.\nFor example, the jdbc:phoenix::::principal:/home/user/keytab URL can be used to specify the kerberos principal and keytab, while using the default connection specified in hbase-site.xml."},"2239":{"id":"/docs/fundamentals/client-classpath-and-jdbc-url-36","page_id":"/docs/fundamentals/client-classpath-and-jdbc-url","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/client-classpath-and-jdbc-url#default-connection","content":"The underlying HBase client identifies the cluster based on parameters in hbase-site.xml.\nWhile Phoenix allows overriding this, it is usually best to use the cluster definition from hbase-site.xml.\nThe only time the connection should be directly specified is when switching between otherwise identically configured HBase instances, like a production and a disaster recovery cluster."},"2240":{"id":"/docs/fundamentals/client-classpath-and-jdbc-url-37","page_id":"/docs/fundamentals/client-classpath-and-jdbc-url","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/client-classpath-and-jdbc-url#default-connection","content":"To use the defaults from hbase-site.xml, use the jdbc:phoenix URL or jdbc:phoenix;option=value if additional options are needed."},"2241":{"id":"/docs/fundamentals/client-classpath-and-jdbc-url-38","page_id":"/docs/fundamentals/client-classpath-and-jdbc-url","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/client-classpath-and-jdbc-url#default-connection","content":"See HBase documentation for how each registry is configured in hbase-site.xml."},"2242":{"id":"/docs/fundamentals/client-classpath-and-jdbc-url-39","page_id":"/docs/fundamentals/client-classpath-and-jdbc-url","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/client-classpath-and-jdbc-url#the-jdbcphoenix-protocol-variant","content":"If this protocol variant is specified, Phoenix will select the registry based on the value of hbase.client.registry.impl."},"2243":{"id":"/docs/fundamentals/client-classpath-and-jdbc-url-40","page_id":"/docs/fundamentals/client-classpath-and-jdbc-url","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/client-classpath-and-jdbc-url#the-jdbcphoenix-protocol-variant","content":"If hbase.client.registry.impl is not defined, Phoenix chooses a default based on the HBase client version it includes."},"2244":{"id":"/docs/fundamentals/client-classpath-and-jdbc-url-41","page_id":"/docs/fundamentals/client-classpath-and-jdbc-url","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/client-classpath-and-jdbc-url#the-jdbcphoenixzk-protocol-variant","content":"This uses the original ZooKeeper-based HBase connection registry. The server list and port specify the ZK quorum. HBASE-12706 is supported; : characters must be escaped with \\."},"2245":{"id":"/docs/fundamentals/client-classpath-and-jdbc-url-42","page_id":"/docs/fundamentals/client-classpath-and-jdbc-url","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/client-classpath-and-jdbc-url#the-jdbcphoenixzk-protocol-variant","content":"Examples:"},"2246":{"id":"/docs/fundamentals/client-classpath-and-jdbc-url-43","page_id":"/docs/fundamentals/client-classpath-and-jdbc-url","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/client-classpath-and-jdbc-url#the-jdbcphoenixzk-protocol-variant","content":"jdbc:phoenix+zk:localhost:2181:/hbase:principal:keytab - fully specified"},"2247":{"id":"/docs/fundamentals/client-classpath-and-jdbc-url-44","page_id":"/docs/fundamentals/client-classpath-and-jdbc-url","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/client-classpath-and-jdbc-url#the-jdbcphoenixzk-protocol-variant","content":"jdbc:phoenix+zk:host1\\:2181,host1\\:2182,host2\\:2183 - heterogeneous ports, default ZK root node"},"2248":{"id":"/docs/fundamentals/client-classpath-and-jdbc-url-45","page_id":"/docs/fundamentals/client-classpath-and-jdbc-url","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/client-classpath-and-jdbc-url#the-jdbcphoenixzk-protocol-variant","content":"jdbc:phoenix+zk - use default ZK parameters from hbase-site.xml (using jdbc:phoenix is preferred in most cases)"},"2249":{"id":"/docs/fundamentals/client-classpath-and-jdbc-url-46","page_id":"/docs/fundamentals/client-classpath-and-jdbc-url","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/client-classpath-and-jdbc-url#the-jdbcphoenixmaster-protocol-variant","content":"This uses the Master based connection registry added in HBASE-18095, and is available from HBase 2.3.0.\nThe zk root node parameter must never be specified."},"2250":{"id":"/docs/fundamentals/client-classpath-and-jdbc-url-47","page_id":"/docs/fundamentals/client-classpath-and-jdbc-url","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/client-classpath-and-jdbc-url#the-jdbcphoenixmaster-protocol-variant","content":"Examples:"},"2251":{"id":"/docs/fundamentals/client-classpath-and-jdbc-url-48","page_id":"/docs/fundamentals/client-classpath-and-jdbc-url","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/client-classpath-and-jdbc-url#the-jdbcphoenixmaster-protocol-variant","content":"jdbc:phoenix+master:master1\\:16001,master2\\:16002::principal:/path/to/keytab - fully specified"},"2252":{"id":"/docs/fundamentals/client-classpath-and-jdbc-url-49","page_id":"/docs/fundamentals/client-classpath-and-jdbc-url","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/client-classpath-and-jdbc-url#the-jdbcphoenixmaster-protocol-variant","content":"jdbc:phoenix+master:master1,master2 - use default master port for both hosts"},"2253":{"id":"/docs/fundamentals/client-classpath-and-jdbc-url-50","page_id":"/docs/fundamentals/client-classpath-and-jdbc-url","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/client-classpath-and-jdbc-url#the-jdbcphoenixrpc-protocol-variant","content":"This uses the Master based connection registry added in HBASE-26150, and is available from HBase 2.5.0.\nThis is very similar to the phoenix+master variant, but also allows specifying RegionServers in the host list.\nThere is no built-in default port for this registry, the port must always be specified together with the host list."},"2254":{"id":"/docs/fundamentals/client-classpath-and-jdbc-url-51","page_id":"/docs/fundamentals/client-classpath-and-jdbc-url","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/client-classpath-and-jdbc-url#the-jdbcphoenixrpc-protocol-variant","content":"Examples:"},"2255":{"id":"/docs/fundamentals/client-classpath-and-jdbc-url-52","page_id":"/docs/fundamentals/client-classpath-and-jdbc-url","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/client-classpath-and-jdbc-url#the-jdbcphoenixrpc-protocol-variant","content":"jdbc:phoenix+rpc:server1\\:16001,server2\\:16002::principal:/path/to/keytab - fully specified"},"2256":{"id":"/docs/fundamentals/client-classpath-and-jdbc-url-53","page_id":"/docs/fundamentals/client-classpath-and-jdbc-url","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/client-classpath-and-jdbc-url#the-jdbcphoenixrpc-protocol-variant","content":"jdbc:phoenix+rpc - use values from hbase-site.xml"},"2257":{"id":"/docs/fundamentals/client-classpath-and-jdbc-url-54","page_id":"/docs/fundamentals/client-classpath-and-jdbc-url","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/client-classpath-and-jdbc-url#client-classpath-and-jdbc-url-notes","content":"type: warning"},"2258":{"id":"/docs/fundamentals/client-classpath-and-jdbc-url-55","page_id":"/docs/fundamentals/client-classpath-and-jdbc-url","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/client-classpath-and-jdbc-url#client-classpath-and-jdbc-url-notes","content":"Support for master and rpc registries is only available in Phoenix 5.1.4+\nand 5.2.0+."},"2259":{"id":"/docs/fundamentals/client-classpath-and-jdbc-url-56","page_id":"/docs/fundamentals/client-classpath-and-jdbc-url","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/client-classpath-and-jdbc-url#client-classpath-and-jdbc-url-notes","content":"Earlier versions support only the jdbc:phoenix: protocol variant implementing the original HBase ZooKeeper connection registry."},"2260":{"id":"/docs/fundamentals/client-classpath-and-jdbc-url-57","page_id":"/docs/fundamentals/client-classpath-and-jdbc-url","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/client-classpath-and-jdbc-url#client-classpath-and-jdbc-url-notes","content":"Support for registry variants is only available for HBase versions that support them.\nPhoenix will throw an error if a variant that the HBase client version doesn't support is specified."},"2261":{"id":"/docs/fundamentals/client-classpath-and-jdbc-url-58","page_id":"/docs/fundamentals/client-classpath-and-jdbc-url","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/client-classpath-and-jdbc-url#client-classpath-and-jdbc-url-notes","content":"Phoenix 5.2 also supports High Availability connections. Documentation for that is only available in the JIRA ticket."},"2262":{"id":"/docs/fundamentals/configuration","page_id":"/docs/fundamentals/configuration","type":"page","content":"Configuration","breadcrumbs":["Docs","Multi-Page Documentation","Development","Fundamentals"],"tags":["multi-page"],"url":"/docs/fundamentals/configuration"},"2263":{"id":"/docs/fundamentals/configuration-0","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration","content":"Phoenix configuration properties and tuning defaults."},"2264":{"id":"/docs/fundamentals/configuration-1","page_id":"/docs/fundamentals/configuration","type":"heading","tags":["multi-page"],"url":"/docs/fundamentals/configuration#configuration-configuration","content":"Configuration"},"2265":{"id":"/docs/fundamentals/configuration-2","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"Phoenix provides many different knobs and dials to configure and tune the system to run more optimally on your cluster. The configuration is done through a series of Phoenix-specific properties specified both on client and server-side hbase-site.xml files. In addition to these properties, there are of course all the HBase configuration properties with the most important ones documented here."},"2266":{"id":"/docs/fundamentals/configuration-3","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"The table below outlines the full set of Phoenix-specific configuration properties and their defaults."},"2267":{"id":"/docs/fundamentals/configuration-4","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"Property"},"2268":{"id":"/docs/fundamentals/configuration-5","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"Description"},"2269":{"id":"/docs/fundamentals/configuration-6","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"Default"},"2270":{"id":"/docs/fundamentals/configuration-7","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"data.tx.snapshot.dir"},"2271":{"id":"/docs/fundamentals/configuration-8","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"Server-side property specifying the HDFS directory used to store snapshots of the transaction state. No default value."},"2272":{"id":"/docs/fundamentals/configuration-9","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"None"},"2273":{"id":"/docs/fundamentals/configuration-10","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"data.tx.timeout"},"2274":{"id":"/docs/fundamentals/configuration-11","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"Server-side property specifying the timeout in seconds for a transaction to complete. Default is 30 seconds."},"2275":{"id":"/docs/fundamentals/configuration-12","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"30"},"2276":{"id":"/docs/fundamentals/configuration-13","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"phoenix.query.timeoutMs"},"2277":{"id":"/docs/fundamentals/configuration-14","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"Client-side property specifying the number of milliseconds after which a query will timeout on the client. Default is 10 min."},"2278":{"id":"/docs/fundamentals/configuration-15","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"600000"},"2279":{"id":"/docs/fundamentals/configuration-16","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"phoenix.query.keepAliveMs"},"2280":{"id":"/docs/fundamentals/configuration-17","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"Maximum time in milliseconds that excess idle threads will wait for new tasks before terminating when the number of threads is greater than the cores in the client side thread pool executor. Default is 60 sec."},"2281":{"id":"/docs/fundamentals/configuration-18","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"60000"},"2282":{"id":"/docs/fundamentals/configuration-19","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"phoenix.query.threadPoolSize"},"2283":{"id":"/docs/fundamentals/configuration-20","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"Number of threads in client side thread pool executor. As the number of machines/cores in the cluster grows, this value should be increased."},"2284":{"id":"/docs/fundamentals/configuration-21","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"128"},"2285":{"id":"/docs/fundamentals/configuration-22","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"phoenix.query.queueSize"},"2286":{"id":"/docs/fundamentals/configuration-23","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"Max queue depth of the bounded round robin backing the client side thread pool executor, beyond which an attempt to queue additional work is rejected. If zero, a SynchronousQueue is used instead of the bounded round robin queue. The default value is 5000."},"2287":{"id":"/docs/fundamentals/configuration-24","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"5000"},"2288":{"id":"/docs/fundamentals/configuration-25","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"phoenix.stats.guidepost.width"},"2289":{"id":"/docs/fundamentals/configuration-26","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"Server-side parameter that specifies the number of bytes between guideposts. A smaller amount increases parallelization, but also increases the number of chunks which must be merged on the client side. The default value is 100 MB."},"2290":{"id":"/docs/fundamentals/configuration-27","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"104857600"},"2291":{"id":"/docs/fundamentals/configuration-28","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"phoenix.stats.guidepost.per.region"},"2292":{"id":"/docs/fundamentals/configuration-29","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"Server-side parameter that specifies the number of guideposts per region. If set to a value greater than zero, then the guidepost width is determined by MAX_FILE_SIZE of table / phoenix.stats.guidepost.per.region. Otherwise, if not set, then the phoenix.stats.guidepost.width parameter is used. No default value."},"2293":{"id":"/docs/fundamentals/configuration-30","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"None"},"2294":{"id":"/docs/fundamentals/configuration-31","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"phoenix.stats.updateFrequency"},"2295":{"id":"/docs/fundamentals/configuration-32","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"Server-side parameter that determines the frequency in milliseconds for which statistics will be refreshed from the statistics table and subsequently used by the client. The default value is 15 min."},"2296":{"id":"/docs/fundamentals/configuration-33","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"900000"},"2297":{"id":"/docs/fundamentals/configuration-34","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"phoenix.stats.minUpdateFrequency"},"2298":{"id":"/docs/fundamentals/configuration-35","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"Client-side parameter that determines the minimum amount of time in milliseconds that must pass before statistics may again be manually collected through another UPDATE STATISTICS call. The default value is phoenix.stats.updateFrequency / 2."},"2299":{"id":"/docs/fundamentals/configuration-36","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"450000"},"2300":{"id":"/docs/fundamentals/configuration-37","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"phoenix.stats.useCurrentTime"},"2301":{"id":"/docs/fundamentals/configuration-38","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"Server-side parameter that if true causes the current time on the server-side to be used as the timestamp of rows in the statistics table when background tasks such as compactions or splits occur. If false, then the max timestamp found while traversing the table over which statistics are being collected is used as the timestamp. Unless your client is controlling the timestamps while reading and writing data, this parameter should be left alone. The default value is true."},"2302":{"id":"/docs/fundamentals/configuration-39","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"true"},"2303":{"id":"/docs/fundamentals/configuration-40","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"phoenix.query.spoolThresholdBytes"},"2304":{"id":"/docs/fundamentals/configuration-41","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"Threshold size in bytes after which results from parallelly executed query results are spooled to disk. Default is 20 mb."},"2305":{"id":"/docs/fundamentals/configuration-42","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"20971520"},"2306":{"id":"/docs/fundamentals/configuration-43","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"phoenix.query.maxSpoolToDiskBytes"},"2307":{"id":"/docs/fundamentals/configuration-44","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"Threshold size in bytes up to which results from parallelly executed query results are spooled to disk above which the query will fail. Default is 1 GB."},"2308":{"id":"/docs/fundamentals/configuration-45","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"1024000000"},"2309":{"id":"/docs/fundamentals/configuration-46","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"phoenix.query.maxGlobalMemoryPercentage"},"2310":{"id":"/docs/fundamentals/configuration-47","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"Percentage of total heap memory (i.e. Runtime.getRuntime().maxMemory()) that all threads may use. Only coarse-grained memory usage is tracked, mainly accounting for memory usage in the intermediate map built during group by aggregation. When this limit is reached clients block while attempting to get more memory, essentially throttling memory usage. Defaults to 15%"},"2311":{"id":"/docs/fundamentals/configuration-48","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"15"},"2312":{"id":"/docs/fundamentals/configuration-49","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"phoenix.query.maxGlobalMemorySize"},"2313":{"id":"/docs/fundamentals/configuration-50","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"Max size in bytes of total tracked memory usage. By default not specified, however, if present, the lower of this parameter and phoenix.query.maxGlobalMemoryPercentage will be used."},"2314":{"id":"/docs/fundamentals/configuration-51","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"phoenix.query.maxGlobalMemoryWaitMs"},"2315":{"id":"/docs/fundamentals/configuration-52","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"Maximum amount of time that a client will block while waiting for more memory to become available. After this amount of time, an InsufficientMemoryException is thrown. Default is 10 sec."},"2316":{"id":"/docs/fundamentals/configuration-53","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"10000"},"2317":{"id":"/docs/fundamentals/configuration-54","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"phoenix.query.maxTenantMemoryPercentage"},"2318":{"id":"/docs/fundamentals/configuration-55","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"Maximum percentage of phoenix.query.maxGlobalMemoryPercentage that any one tenant is allowed to consume. After this percentage, an InsufficientMemoryException is thrown. Default is 100%"},"2319":{"id":"/docs/fundamentals/configuration-56","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"100"},"2320":{"id":"/docs/fundamentals/configuration-57","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"phoenix.query.dateFormat"},"2321":{"id":"/docs/fundamentals/configuration-58","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"Default pattern to use for conversion of a date to/from a string, whether through the TO_CHAR(&lt;date&gt;) or TO_DATE(&lt;date-string&gt;) functions, or through resultSet.getString(&lt;date-column&gt;). Default is yyyy-MM-dd HH:mm:ss.SSS"},"2322":{"id":"/docs/fundamentals/configuration-59","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"yyyy-MM-dd HH:mm:ss.SSS"},"2323":{"id":"/docs/fundamentals/configuration-60","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"phoenix.query.dateFormatTimeZone"},"2324":{"id":"/docs/fundamentals/configuration-61","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"A timezone id that specifies the default time zone in which date, time, and timestamp literals should be interpreted when interpreting string literals or using the TO_DATE function. A time zone id can be a timezone abbreviation such as \"PST\", or a full name such as \"America/Los_Angeles\", or a custom offset such as \"GMT-9:00\". The time zone id \"LOCAL\" can also be used to interpret all date, time, and timestamp literals as being in the current timezone of the client."},"2325":{"id":"/docs/fundamentals/configuration-62","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"GMT"},"2326":{"id":"/docs/fundamentals/configuration-63","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"phoenix.query.timeFormat"},"2327":{"id":"/docs/fundamentals/configuration-64","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"Default pattern to use for conversion of TIME to/from a string, whether through the TO_CHAR(&lt;time&gt;) or TO_TIME(&lt;time-string&gt;) functions, or through resultSet.getString(&lt;time-column&gt;). Default is yyyy-MM-dd HH:mm:ss.SSS"},"2328":{"id":"/docs/fundamentals/configuration-65","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"yyyy-MM-dd HH:mm:ss.SSS"},"2329":{"id":"/docs/fundamentals/configuration-66","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"phoenix.query.timestampFormat"},"2330":{"id":"/docs/fundamentals/configuration-67","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"Default pattern to use for conversion of TIMESTAMP to/from a string, whether through the TO_CHAR(&lt;timestamp&gt;) or TO_TIMESTAMP(&lt;timestamp-string&gt;) functions, or through resultSet.getString(&lt;timestamp-column&gt;). Default is yyyy-MM-dd HH:mm:ss.SSS"},"2331":{"id":"/docs/fundamentals/configuration-68","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"yyyy-MM-dd HH:mm:ss.SSS"},"2332":{"id":"/docs/fundamentals/configuration-69","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"phoenix.query.numberFormat"},"2333":{"id":"/docs/fundamentals/configuration-70","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"Default pattern to use for conversion of a decimal number to/from a string, whether through the TO_CHAR(&lt;decimal-number&gt;) or TO_NUMBER(&lt;decimal-string&gt;) functions, or through resultSet.getString(&lt;decimal-column&gt;). Default is #,##0.###"},"2334":{"id":"/docs/fundamentals/configuration-71","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"#,##0.###"},"2335":{"id":"/docs/fundamentals/configuration-72","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"phoenix.mutate.maxSize"},"2336":{"id":"/docs/fundamentals/configuration-73","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"The maximum number of rows that may be batched on the client before a commit or rollback must be called."},"2337":{"id":"/docs/fundamentals/configuration-74","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"500000"},"2338":{"id":"/docs/fundamentals/configuration-75","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"phoenix.mutate.batchSize"},"2339":{"id":"/docs/fundamentals/configuration-76","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"The number of rows that are batched together and automatically committed during the execution of an UPSERT SELECT or DELETE statement. This property may be overridden at connection time by specifying the UpsertBatchSize property value. Note that the connection property value does not affect the batch size used by the coprocessor when these statements are executed completely on the server side."},"2340":{"id":"/docs/fundamentals/configuration-77","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"1000"},"2341":{"id":"/docs/fundamentals/configuration-78","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"phoenix.query.maxServerCacheBytes"},"2342":{"id":"/docs/fundamentals/configuration-79","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","content":"Maximum size (in bytes) of a single sub-query result (usually the filtered result of a table) before compression and conversion to a hash map. Attempting to hash an intermediate sub-query result of a size bigger than this setting will result in a MaxServerCacheSizeExceededException. Default 100MB."},"2343":{"id":"/docs/fundamentals/configuration-80","page_id":"/docs/fundamentals/configuration","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/configuration#configuration-configuration","c