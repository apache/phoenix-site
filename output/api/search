grammar-69","page_id":"/docs/grammar","type":"heading","tags":["multi-page"],"url":"/docs/grammar#case","content":"Case"},"2730":{"id":"/docs/grammar-70","page_id":"/docs/grammar","type":"heading","tags":["multi-page"],"url":"/docs/grammar#case-when","content":"Case When"},"2731":{"id":"/docs/grammar-71","page_id":"/docs/grammar","type":"heading","tags":["multi-page"],"url":"/docs/grammar#name","content":"Name"},"2732":{"id":"/docs/grammar-72","page_id":"/docs/grammar","type":"heading","tags":["multi-page"],"url":"/docs/grammar#quoted-name","content":"Quoted Name"},"2733":{"id":"/docs/grammar-73","page_id":"/docs/grammar","type":"heading","tags":["multi-page"],"url":"/docs/grammar#alias","content":"Alias"},"2734":{"id":"/docs/grammar-74","page_id":"/docs/grammar","type":"heading","tags":["multi-page"],"url":"/docs/grammar#null","content":"Null"},"2735":{"id":"/docs/grammar-75","page_id":"/docs/grammar","type":"heading","tags":["multi-page"],"url":"/docs/grammar#data-type","content":"Data Type"},"2736":{"id":"/docs/grammar-76","page_id":"/docs/grammar","type":"heading","tags":["multi-page"],"url":"/docs/grammar#sql-data-type","content":"SQL Data Type"},"2737":{"id":"/docs/grammar-77","page_id":"/docs/grammar","type":"heading","tags":["multi-page"],"url":"/docs/grammar#hbase-data-type","content":"HBase Data Type"},"2738":{"id":"/docs/grammar-78","page_id":"/docs/grammar","type":"heading","tags":["multi-page"],"url":"/docs/grammar#string","content":"String"},"2739":{"id":"/docs/grammar-79","page_id":"/docs/grammar","type":"heading","tags":["multi-page"],"url":"/docs/grammar#boolean","content":"Boolean"},"2740":{"id":"/docs/grammar-80","page_id":"/docs/grammar","type":"heading","tags":["multi-page"],"url":"/docs/grammar#numeric","content":"Numeric"},"2741":{"id":"/docs/grammar-81","page_id":"/docs/grammar","type":"heading","tags":["multi-page"],"url":"/docs/grammar#int","content":"Int"},"2742":{"id":"/docs/grammar-82","page_id":"/docs/grammar","type":"heading","tags":["multi-page"],"url":"/docs/grammar#long","content":"Long"},"2743":{"id":"/docs/grammar-83","page_id":"/docs/grammar","type":"heading","tags":["multi-page"],"url":"/docs/grammar#decimal","content":"Decimal"},"2744":{"id":"/docs/grammar-84","page_id":"/docs/grammar","type":"heading","tags":["multi-page"],"url":"/docs/grammar#number","content":"Number"},"2745":{"id":"/docs/grammar-85","page_id":"/docs/grammar","type":"heading","tags":["multi-page"],"url":"/docs/grammar#comments","content":"Comments"},"2746":{"id":"/docs/grammar-86","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#select","content":"Selects data from one or more tables. UNION ALL combines rows from multiple select statements. ORDER BY sorts the result based on the given expressions. LIMIT (or FETCH FIRST) limits the number of rows returned by the query with no limit applied if unspecified or specified as null or less than zero. The LIMIT (or FETCH FIRST) clause is executed after the ORDER BY clause to support top-N type queries. OFFSET clause skips that many rows before beginning to return rows. An optional hint may be used to override decisions made by the query optimizer."},"2747":{"id":"/docs/grammar-87","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#select","content":"Example"},"2748":{"id":"/docs/grammar-88","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#upsert-values","content":"Inserts if not present and updates otherwise the value in the table. The list of columns is optional and if not present, the values will map to the column in the order they are declared in the schema. The values must evaluate to constants."},"2749":{"id":"/docs/grammar-89","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#upsert-values","content":"Use the ON DUPLICATE KEY clause (available in Phoenix 4.9) if you need the UPSERT to be atomic. Performance will be slower in this case as the row needs to be read on the server side when the commit is done. Use IGNORE if you do not want the UPSERT performed if the row already exists. Otherwise, with UPDATE, the expression will be evaluated and the result used to set the column, for example to perform an atomic increment. An UPSERT to the same row in the same commit batch will be processed in the order of execution."},"2750":{"id":"/docs/grammar-90","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#upsert-values","content":"Example"},"2751":{"id":"/docs/grammar-91","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#upsert-select","content":"Inserts if not present and updates otherwise rows in the table based on the results of running another query. The values are set based on their matching position between the source and target tables. The list of columns is optional and if not present will map to the column in the order they are declared in the schema. If auto commit is on, and both a) the target table matches the source table, and b) the select performs no aggregation, then the population of the target table will be done completely on the server-side (with constraint violations logged, but otherwise ignored). Otherwise, data is buffered on the client and, if auto commit is on, committed in row batches as specified by the UpsertBatchSize connection property (or the phoenix.mutate.upsertBatchSize HBase config property which defaults to 10000 rows)"},"2752":{"id":"/docs/grammar-92","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#upsert-select","content":"Example"},"2753":{"id":"/docs/grammar-93","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#delete","content":"Deletes the rows selected by the where clause. If auto commit is on, the deletion is performed completely server-side."},"2754":{"id":"/docs/grammar-94","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#delete","content":"Example"},"2755":{"id":"/docs/grammar-95","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#declare-cursor","content":"Creates a cursor for the select statement"},"2756":{"id":"/docs/grammar-96","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#declare-cursor","content":"Example"},"2757":{"id":"/docs/grammar-97","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#open-cursor","content":"Opens already declared cursor to perform FETCH operations"},"2758":{"id":"/docs/grammar-98","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#open-cursor","content":"Example"},"2759":{"id":"/docs/grammar-99","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#fetch-next","content":"Retrieves next or next n rows from already opened cursor"},"2760":{"id":"/docs/grammar-100","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#fetch-next","content":"Example"},"2761":{"id":"/docs/grammar-101","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#close","content":"Closes an already open cursor"},"2762":{"id":"/docs/grammar-102","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#close","content":"Example"},"2763":{"id":"/docs/grammar-103","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#create-table","content":"Creates a new table. The HBase table and any column families referenced are created if they don't already exist. All table, column family and column names are uppercased unless they are double quoted in which case they are case sensitive. Column families that exist in the HBase table but are not listed are ignored. At create time, to improve query performance, an empty key value is added to the first column family of any existing rows or the default column family if no column families are explicitly defined. Upserts will also add this empty key value. This improves query performance by having a key value column we can guarantee always being there and thus minimizing the amount of data that must be projected and subsequently returned back to the client. HBase table and column configuration options may be passed through as key/value pairs to configure the HBase table as desired. Note that when using the IF NOT EXISTS clause, if a table already exists, then no change will be made to it. Additionally, no validation is done to check whether the existing table metadata matches the proposed table metadata. so it's better to use DROP TABLE followed by CREATE TABLE if the table metadata may be changing."},"2764":{"id":"/docs/grammar-104","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#create-table","content":"Example"},"2765":{"id":"/docs/grammar-105","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#drop-table","content":"Drops a table. The optional CASCADE keyword causes any views on the table to be dropped as well. When dropping a table, by default the underlying HBase data and index tables are dropped. The phoenix.schema.dropMetaData may be used to override this and keep the HBase table for point-in-time queries."},"2766":{"id":"/docs/grammar-106","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#drop-table","content":"Example"},"2767":{"id":"/docs/grammar-107","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#create-function","content":"Creates a new function. The function name is uppercased unless they are double quoted in which case they are case sensitive. The function accepts zero or more arguments. The class name and jar path should be in single quotes. The jar path is optional and if not specified then the class name will be loaded from the jars present in directory configured for hbase.dynamic.jars.dir."},"2768":{"id":"/docs/grammar-108","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#create-function","content":"Example"},"2769":{"id":"/docs/grammar-109","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#drop-function","content":"Drops a function."},"2770":{"id":"/docs/grammar-110","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#drop-function","content":"Example"},"2771":{"id":"/docs/grammar-111","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#create-view","content":"Creates a new view over an existing HBase or Phoenix table. As expected, the WHERE expression is always automatically applied to any query run against the view. As with CREATE TABLE, the table, column family, and column names are uppercased unless they are double quoted. The newTableRef may refer directly to an HBase table, in which case, the table, column family, and column names must match the existing metadata exactly or an exception will occur. When a view is mapped directly to an HBase table, no empty key value will be added to rows and the view will be read-only. A view will be updatable (i.e. referenceable in a DML statement such as UPSERT or DELETE) if its WHERE clause expression contains only simple equality expressions separated by ANDs. Updatable views are not required to set the columns which appear in the equality expressions, as the equality expressions define the default values for those columns. If they are set, then they must match the value used in the WHERE clause, or an error will occur. All columns from the existingTableRef are included as columns in the new view as are columns defined in the columnDef list. An ALTER VIEW statement may be issued against a view to remove or add columns, however, no changes may be made to the primary key constraint. In addition, columns referenced in the WHERE clause are not allowed to be removed. Once a view is created for a table, that table may no longer altered or dropped until all of its views have been dropped."},"2772":{"id":"/docs/grammar-112","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#create-view","content":"Example"},"2773":{"id":"/docs/grammar-113","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#drop-view","content":"Drops a view. The optional CASCADE keyword causes any views derived from the view to be dropped as well. When dropping a view, the actual table data is not affected. However, index data for the view will be deleted."},"2774":{"id":"/docs/grammar-114","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#drop-view","content":"Example"},"2775":{"id":"/docs/grammar-115","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#create-sequence","content":"Creates a monotonically increasing sequence. START controls the initial sequence value while INCREMENT controls by how much the sequence is incremented after each call to NEXT VALUE FOR. By default, the sequence will start with 1 and be incremented by 1. Specify CYCLE to indicate that the sequence should continue to generate values after reaching either its MINVALUE or MAXVALUE. After an ascending sequence reaches its MAXVALUE, it generates its MINVALUE. After a descending sequence reaches its MINVALUE, it generates its MAXVALUE. CACHE controls how many sequence values will be reserved from the server, cached on the client, and doled out as need by subsequent NEXT VALUE FOR calls for that client connection to the cluster to save on RPC calls. If not specified, the phoenix.sequence.cacheSize config parameter defaulting to 100 will be used for the CACHE value."},"2776":{"id":"/docs/grammar-116","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#create-sequence","content":"Example"},"2777":{"id":"/docs/grammar-117","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#drop-sequence","content":"Drops a sequence."},"2778":{"id":"/docs/grammar-118","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#drop-sequence","content":"Example"},"2779":{"id":"/docs/grammar-119","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#alter","content":"Alters an existing table by adding or removing columns or updating table options. When a column is dropped from a table, the data in that column is deleted as well. PK columns may not be dropped, and only nullable PK columns may be added. For a view, the data is not affected when a column is dropped. Note that creating or dropping columns only affects subsequent queries and data modifications. Snapshot queries that are connected at an earlier timestamp will still use the prior schema that was in place when the data was written."},"2780":{"id":"/docs/grammar-120","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#alter","content":"Example"},"2781":{"id":"/docs/grammar-121","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#create-index","content":"Creates a new secondary index on a table or view. The index will be automatically kept in sync with the table as the data changes. At query time, the optimizer will use the index if it contains all columns referenced in the query and produces the most efficient execution plan. If a table has rows that are write-once and append-only, then the table may set the IMMUTABLE_ROWS property to true (either up-front in the CREATE TABLE statement or afterwards in an ALTER TABLE statement). This reduces the overhead at write time to maintain the index. Otherwise, if this property is not set on the table, then incremental index maintenance will be performed on the server side when the data changes. As of the 4.3 release, functional indexes are supported which allow arbitrary expressions rather than solely column names to be indexed. As of the 4.4.0 release, you can specify the ASYNC keyword to create the index using a map reduce job."},"2782":{"id":"/docs/grammar-122","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#create-index","content":"Example"},"2783":{"id":"/docs/grammar-123","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#drop-index","content":"Drops an index from a table. When dropping an index, the data in the index is deleted. Note that since metadata is versioned, snapshot queries connecting at an earlier time stamp may still use the index, as the HBase table backing the index is not deleted."},"2784":{"id":"/docs/grammar-124","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#drop-index","content":"Example"},"2785":{"id":"/docs/grammar-125","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#alter-index","content":"Alters the state of an existing index.  DISABLE will cause the no further index maintenance to be performed on the index and it will no longer be considered for use in queries. REBUILD will completely rebuild the index and upon completion will enable the index to be used in queries again. UNUSABLE will cause the index to no longer be considered for use in queries, however index maintenance will continue to be performed. USABLE will cause the index to again be considered for use in queries. Note that a disabled index must be rebuild and cannot be set as USABLE."},"2786":{"id":"/docs/grammar-126","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#alter-index","content":"Example"},"2787":{"id":"/docs/grammar-127","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#explain","content":"Computes the logical steps necessary to execute the given command. Each step is represented as a string in a single column result set row."},"2788":{"id":"/docs/grammar-128","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#explain","content":"Example"},"2789":{"id":"/docs/grammar-129","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#update-statistics","content":"Updates the statistics on the table and by default all of its associated index tables. To only update the table, use the COLUMNS option and to only update the INDEX, use the INDEX option. The statistics for a single index may also be updated by using its full index name for the tableRef. The default guidepost properties may be overridden by specifying their values after the SET keyword. Note that when a major compaction occurs, the default guidepost properties will be used again."},"2790":{"id":"/docs/grammar-130","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#update-statistics","content":"Example"},"2791":{"id":"/docs/grammar-131","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#create-schema","content":"creates a schema and corresponding name-space in hbase. To enable namespace mapping, see namespace mapping"},"2792":{"id":"/docs/grammar-132","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#create-schema","content":"User that execute this command should have admin permissions to create namespace in HBase."},"2793":{"id":"/docs/grammar-133","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#create-schema","content":"Example"},"2794":{"id":"/docs/grammar-134","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#use","content":"Sets a default schema for the connection and is used as a target schema for all statements issued from the connection that do not specify schema name explicitly. USE DEFAULT unset the schema for the connection so that no schema will be used for the statements issued from the connection."},"2795":{"id":"/docs/grammar-135","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#use","content":"schemaName should already be existed for the USE SCHEMA statement to succeed. see CREATE SCHEMA for creating schema."},"2796":{"id":"/docs/grammar-136","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#use","content":"Example"},"2797":{"id":"/docs/grammar-137","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#drop-schema","content":"Drops a schema and corresponding name-space from hbase. To enable namespace mapping, see namespace mapping"},"2798":{"id":"/docs/grammar-138","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#drop-schema","content":"This statement succeed only when schema doesn't hold any tables."},"2799":{"id":"/docs/grammar-139","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#drop-schema","content":"Example"},"2800":{"id":"/docs/grammar-140","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#grant","content":"Grant permissions at table, schema or user level. Permissions are managed by HBase in hbase:acl table, hence access controls need to be enabled. This feature will be available from Phoenix 4.14 version onwards."},"2801":{"id":"/docs/grammar-141","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#grant","content":"Possible permissions are R - Read, W - Write, X - Execute, C - Create and A - Admin. To enable/disable access controls, see https://hbase.apache.org/docs/security/data-access#how-it-works"},"2802":{"id":"/docs/grammar-142","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#grant","content":"Permissions should be granted on base tables. It will be propagated to all its indexes and views. Group permissions are applicable to all users in the group and schema permissions are applicable to all tables with that schema. Grant statements without table/schema specified are assigned at GLOBAL level."},"2803":{"id":"/docs/grammar-143","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#grant","content":"Phoenix doesn't expose Execute('X') functionality to end users. However, it is required for mutable tables with secondary indexes."},"2804":{"id":"/docs/grammar-144","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#grant","content":"Important Note:"},"2805":{"id":"/docs/grammar-145","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#grant","content":"Every user requires 'RX' permissions on all Phoenix SYSTEM tables in order to work correctly. Users also require 'RWX' permissions on SYSTEM.SEQUENCE table for using SEQUENCES."},"2806":{"id":"/docs/grammar-146","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#grant","content":"Example"},"2807":{"id":"/docs/grammar-147","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#revoke","content":"Revoke permissions at table, schema or user level. Permissions are managed by HBase in hbase:acl table, hence access controls need to be enabled. This feature will be available from Phoenix 4.14 version onwards."},"2808":{"id":"/docs/grammar-148","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#revoke","content":"To enable/disable access controls, see https://hbase.apache.org/docs/security/data-access#how-it-works"},"2809":{"id":"/docs/grammar-149","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#revoke","content":"Group permissions are applicable to all users in the group and schema permissions are applicable to all tables with that schema. Permissions should be revoked on base tables. It will be propagated to all its indexes and views. Revoke statements without table/schema specified are assigned at GLOBAL level."},"2810":{"id":"/docs/grammar-150","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#revoke","content":"Revoke removes all the permissions at that level."},"2811":{"id":"/docs/grammar-151","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#revoke","content":"Important Note:"},"2812":{"id":"/docs/grammar-152","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#revoke","content":"Revoke permissions needs to be exactly at the same level as permissions assigned via GRANT permissions statement. Level refers to table, schema or user. Revoking any of 'RX' permissions on any Phoenix SYSTEM tables will cause exceptions. Revoking any of 'RWX' permissions on SYSTEM.SEQUENCE will cause exceptions while accessing sequences."},"2813":{"id":"/docs/grammar-153","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#revoke","content":"The examples below are for revoking permissions granted using the examples from GRANT statement above."},"2814":{"id":"/docs/grammar-154","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#revoke","content":"Example"},"2815":{"id":"/docs/grammar-155","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#constraint","content":"Defines a multi-part primary key constraint. Each column may be declared to be sorted in ascending or descending ordering. The default is ascending. One primary key column can also be designated as ROW_TIMESTAMP provided it is of one of the types: BIGINT, UNSIGNED_LONG, DATE, TIME and TIMESTAMP."},"2816":{"id":"/docs/grammar-156","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#constraint","content":"Example"},"2817":{"id":"/docs/grammar-157","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#options","content":"Sets a built-in Phoenix table property or an HBase table or column descriptor metadata attribute. The name is case insensitive. If the name is a known HColumnDescriptor attribute, then the value is applied to the specified column family or, if omitted, to all column families. Otherwise, the HBase metadata attribute value is applied to the HTableDescriptor. Note that no validation is performed on the property name or value, so unknown or misspelled options will end up as adhoc metadata attributes values on the HBase table."},"2818":{"id":"/docs/grammar-158","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#options","content":"Built-in Phoenix table options include:"},"2819":{"id":"/docs/grammar-159","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#options","content":"SALT_BUCKETS numeric property causes an extra byte to be transparently prepended to every row key to ensure an evenly distributed read and write load across all region servers. This is especially useful when your row key is always monotonically increasing and causing hot spotting on a single region server. However, even if it's not, it often improves performance by ensuring an even distribution of data across your cluster.  The byte is determined by hashing the row key and modding it with the SALT_BUCKETS value. The value may be from 0 to 256, with 0 being a special means of turning salting off for an index in which the data table is salted (since by default an index has the same number of salt buckets as its data table). If split points are not defined for the table, the table will automatically be pre-split at each possible salt bucket value. For more information, see salted tables"},"2820":{"id":"/docs/grammar-160","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#options","content":"DISABLE_WAL boolean option when true causes HBase not to write data to the write-ahead-log, thus making updates faster at the expense of potentially losing data in the event of a region server failure. This option is useful when updating a table which is not the source-of-truth and thus making the lose of data acceptable."},"2821":{"id":"/docs/grammar-161","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#options","content":"IMMUTABLE_ROWS boolean option when true declares that your table has rows which are write-once, append-only (i.e. the same row is never updated). With this option set, indexes added to the table are managed completely on the client-side, with no need to perform incremental index maintenance, thus improving performance. Deletes of rows in immutable tables are allowed with some restrictions if there are indexes on the table. Namely, the WHERE clause may not filter on columns not contained by every index. Upserts are expected to never update an existing row (failure to follow this will result in invalid indexes). For more information, see secondary indexing"},"2822":{"id":"/docs/grammar-162","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#options","content":"MULTI_TENANT boolean option when true enables views to be created over the table across different tenants. This option is useful to share the same physical HBase table across many different tenants. For more information, see multi-tenancy"},"2823":{"id":"/docs/grammar-163","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#options","content":"DEFAULT_COLUMN_FAMILY string option determines the column family used used when none is specified. The value is case sensitive. If this option is not present, a column family name of '0' is used."},"2824":{"id":"/docs/grammar-164","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#options","content":"STORE_NULLS boolean option (available as of Phoenix 4.3) determines whether or not null values should be explicitly stored in HBase. This option is generally only useful if a table is configured to store multiple versions in order to facilitate doing flashback queries (i.e. queries to look at the state of a record in the past)."},"2825":{"id":"/docs/grammar-165","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#options","content":"TRANSACTIONAL option (available as of Phoenix 4.7) determines whether a table (and its secondary indexes) are tranactional. The default value is FALSE, but may be overridden with the phoenix.table.istransactional.default property. A table may be altered to become transactional, but it cannot be transitioned back to be non transactional. For more information on transactions, see transactions"},"2826":{"id":"/docs/grammar-166","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#options","content":"UPDATE_CACHE_FREQUENCY option (available as of Phoenix 4.7) determines how often the server will be checked for meta data updates (for example, the addition or removal of a table column or the updates of table statistics). Possible values are ALWAYS (the default), NEVER, and a millisecond numeric value. An ALWAYS value will cause the client to check with the server each time a statement is executed that references a table (or once per commit for an UPSERT VALUES statement).  A millisecond value indicates how long the client will hold on to its cached version of the metadata before checking back with the server for updates."},"2827":{"id":"/docs/grammar-167","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#options","content":"APPEND_ONLY_SCHEMA boolean option (available as of Phoenix 4.8) when true declares that columns will only be added but never removed from a table. With this option set we can prevent the RPC from the client to the server to fetch the table metadata when the client already has all columns declared in a CREATE TABLE/VIEW IF NOT EXISTS statement."},"2828":{"id":"/docs/grammar-168","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#options","content":"AUTO_PARTITION_SEQ string option (available as of Phoenix 4.8) when set on a base table determines the sequence used to automatically generate a WHERE clause with the first PK column and the unique identifier from the sequence for child views. With this option set, we prevent allocating a sequence in the event that the view already exists."},"2829":{"id":"/docs/grammar-169","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#options","content":"The GUIDE_POSTS_WIDTH option (available as of Phoenix 4.9) enables specifying a different guidepost width per table. The guidepost width determines the byte sized chunk of work over which a query will be parallelized. A value of 0 means that no guideposts should be collected for the table. A value of null removes any table specific guidepost setting, causing the global server-side phoenix.stats.guidepost.width config parameter to be used again. For more information, see the Statistics Collection page."},"2830":{"id":"/docs/grammar-170","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#options","content":"Example"},"2831":{"id":"/docs/grammar-171","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#hint","content":"An advanced features that overrides default query processing behavior for decisions such as whether to use a range scan versus skip scan and an index versus no index. Note that strict parsing is not done on hints. If hints are misspelled or invalid, they are silently ignored."},"2832":{"id":"/docs/grammar-172","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#hint","content":"Example"},"2833":{"id":"/docs/grammar-173","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#scan-hint","content":"Use the SKIP_SCAN hint to force a skip scan to be performed on the query when it otherwise would not be. This option may improve performance if a query does not include the leading primary key column, but does include other, very selective primary key columns."},"2834":{"id":"/docs/grammar-174","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#scan-hint","content":"Use the RANGE_SCAN hint to force a range scan to be performed on the query. This option may improve performance if a query filters on a range for non selective leading primary key column along with other primary key columns"},"2835":{"id":"/docs/grammar-175","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#scan-hint","content":"Example"},"2836":{"id":"/docs/grammar-176","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#cache-hint","content":"Use the NO_CACHE hint to prevent the results of the query from populating the HBase block cache. This is useful in situation where you're doing a full table scan and know that it's unlikely that the rows being returned will be queried again."},"2837":{"id":"/docs/grammar-177","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#cache-hint","content":"Example"},"2838":{"id":"/docs/grammar-178","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#index-hint","content":"Use the INDEX(<table_name> <index_name>...) to suggest which index to use for a given query. Double quotes may be used to surround a table_name and/or index_name to make them case sensitive. As of the 4.3 release, this will force an index to be used, even if it doesn't contain all referenced columns, by joining back to the data table to retrieve any columns not contained by the index."},"2839":{"id":"/docs/grammar-179","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#index-hint","content":"Use the NO_INDEX hint to force the data table to be used for a query."},"2840":{"id":"/docs/grammar-180","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#index-hint","content":"Use the USE_INDEX_OVER_DATA_TABLE hint to act as a tiebreaker for choosing the index table over the data table when all other criteria are equal. Note that this is the default optimizer decision."},"2841":{"id":"/docs/grammar-181","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#index-hint","content":"Use the USE_DATA_OVER_INDEX_TABLE hint to act as a tiebreaker for choosing the data table over the index table when all other criteria are equal."},"2842":{"id":"/docs/grammar-182","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#index-hint","content":"Example"},"2843":{"id":"/docs/grammar-183","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#small-hint","content":"Use the SMALL hint to reduce the number of RPCs done between the client and server when a query is executed. Generally, if the query is a point lookup or returns data that is likely in a single data block (64 KB by default), performance may improve when using this hint."},"2844":{"id":"/docs/grammar-184","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#small-hint","content":"Example"},"2845":{"id":"/docs/grammar-185","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#seek-to-column-hint","content":"Use the SEEK_TO_COLUMN hint to force the server to seek to navigate between columns instead of doing a next. If there are many versions of the same column value or if there are many columns between the columns that are projected, then this may be more efficient."},"2846":{"id":"/docs/grammar-186","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#seek-to-column-hint","content":"Use the NO_SEEK_TO_COLUMN hint to force the server to do a next to navigate between columns instead of a seek. If there are few versions of the same column value or if the columns that are projected are adjacent to each other, then this may be more efficient."},"2847":{"id":"/docs/grammar-187","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#seek-to-column-hint","content":"Example"},"2848":{"id":"/docs/grammar-188","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#join-hint","content":"Use the USE_SORT_MERGE_JOIN hint to force the optimizer to use a sort merge join instead of a broadcast hash join when both sides of the join are bigger than will fit in the server-side memory. Currently the optimizer will not make this determination itself, so this hint is required to override the default behavior of using a hash join."},"2849":{"id":"/docs/grammar-189","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#join-hint","content":"Use the NO_STAR_JOIN hint to prevent the optimizer from using the star join query to broadcast the results of the querying one common table to all region servers. This is useful when the results of the querying the one common table is too large and would likely be substantially filtered when joined against one or more of the other joined tables."},"2850":{"id":"/docs/grammar-190","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#join-hint","content":"Use the NO_CHILD_PARENT_JOIN_OPTIMIZATION hint to prevent the optimizer from doing point lookups between a child table (such as a secondary index) and a parent table (such as the data table) for a correlated subquery."},"2851":{"id":"/docs/grammar-191","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#join-hint","content":"Example"},"2852":{"id":"/docs/grammar-192","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#serial-hint","content":"Use the SERIAL hint to force a query to be executed serially as opposed to being parallelized along the guideposts and region boundaries."},"2853":{"id":"/docs/grammar-193","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#serial-hint","content":"Example"},"2854":{"id":"/docs/grammar-194","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#column-def","content":"Define a new primary key column. The column name is case insensitive by default and case sensitive if double quoted. The sort order of a primary key may be ascending (ASC) or descending (DESC). The default is ascending. You may also specify a default value (Phoenix 4.9 or above) for the column with a constant expression. If the column is the only column that forms the primary key, then it can be designated as ROW_TIMESTAMP column provided its data type is one of these: BIGINT, UNSIGNED_LONG, DATE, TIME and TIMESTAMP."},"2855":{"id":"/docs/grammar-195","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#column-def","content":"Example"},"2856":{"id":"/docs/grammar-196","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#table-ref","content":"References a table or view with an optional schema name qualifier"},"2857":{"id":"/docs/grammar-197","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#table-ref","content":"Example"},"2858":{"id":"/docs/grammar-198","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#sequence-ref","content":"References a sequence with an optional schema name qualifier"},"2859":{"id":"/docs/grammar-199","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#sequence-ref","content":"Example"},"2860":{"id":"/docs/grammar-200","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#column-ref","content":"References a column with an optional family name qualifier"},"2861":{"id":"/docs/grammar-201","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#column-ref","content":"Example"},"2862":{"id":"/docs/grammar-202","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#select-expression","content":"An expression in a SELECT statement. All columns in a table may be selected using , and all columns in a column family may be selected using <familyName>.."},"2863":{"id":"/docs/grammar-203","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#select-expression","content":"Example"},"2864":{"id":"/docs/grammar-204","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#select-statement","content":"Selects data from a table. DISTINCT filters out duplicate results while ALL, the default, includes all results. FROM identifies the table being queried. Columns may be dynamically defined in parenthesis after the table name and then used in the query. Joins are processed in reverse order through a broadcast hash join mechanism. For best performance, order tables from largest to smallest in terms of how many rows you expect to be used from each table. GROUP BY groups the result by the given expression(s). HAVING filters rows after grouping. An optional hint may be used to override decisions made by the query optimizer."},"2865":{"id":"/docs/grammar-205","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#select-statement","content":"Example"},"2866":{"id":"/docs/grammar-206","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#split-point","content":"Defines a split point for a table. Use a bind parameter with preparedStatement.setBinary(int,byte[]) to supply arbitrary bytes."},"2867":{"id":"/docs/grammar-207","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#split-point","content":"Example"},"2868":{"id":"/docs/grammar-208","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#table-spec","content":"An optionally aliased table reference, or an optionally aliased select statement in paranthesis."},"2869":{"id":"/docs/grammar-209","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#table-spec","content":"Example"},"2870":{"id":"/docs/grammar-210","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#aliased-table-ref","content":"A reference to an optionally aliased table optionally followed by dynamic column definitions."},"2871":{"id":"/docs/grammar-211","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#aliased-table-ref","content":"Example"},"2872":{"id":"/docs/grammar-212","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#join-type","content":"The type of join"},"2873":{"id":"/docs/grammar-213","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#join-type","content":"Example"},"2874":{"id":"/docs/grammar-214","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#func-argument","content":"The function argument is sql data type. It can be constant and also we can provide default,min and max values for the argument in single quotes."},"2875":{"id":"/docs/grammar-215","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#func-argument","content":"Example"},"2876":{"id":"/docs/grammar-216","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#class-name","content":"Canonical class name in single quotes."},"2877":{"id":"/docs/grammar-217","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#class-name","content":"Example"},"2878":{"id":"/docs/grammar-218","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#jar-path","content":"Hdfs path of jar in single quotes."},"2879":{"id":"/docs/grammar-219","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#jar-path","content":"Example"},"2880":{"id":"/docs/grammar-220","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#order","content":"Sorts the result by an expression."},"2881":{"id":"/docs/grammar-221","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#order","content":"Example"},"2882":{"id":"/docs/grammar-222","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#expression","content":"Value or condition."},"2883":{"id":"/docs/grammar-223","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#expression","content":"Example"},"2884":{"id":"/docs/grammar-224","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#and-condition","content":"Condition separated by AND."},"2885":{"id":"/docs/grammar-225","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#and-condition","content":"Example"},"2886":{"id":"/docs/grammar-226","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#boolean-condition","content":"Boolean condition."},"2887":{"id":"/docs/grammar-227","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#boolean-condition","content":"Example"},"2888":{"id":"/docs/grammar-228","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#condition","content":"Boolean value or condition. When comparing with LIKE, the wildcards characters are \"\" (any one character) and \"%\" (any characters). ILIKE is the same, but the search is case insensitive. To search for the characters \"%\" and \"\", the characters need to be escaped. The escape character is \" \\ \" (backslash). Patterns that end with an escape character are invalid and the expression returns NULL. BETWEEN does an inclusive comparison for both operands."},"2889":{"id":"/docs/grammar-229","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#condition","content":"Example"},"2890":{"id":"/docs/grammar-230","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#rhs-operand","content":"Right-hand side operand"},"2891":{"id":"/docs/grammar-231","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#rhs-operand","content":"Example"},"2892":{"id":"/docs/grammar-232","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#operand","content":"A string concatenation."},"2893":{"id":"/docs/grammar-233","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#operand","content":"Example"},"2894":{"id":"/docs/grammar-234","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#summand","content":"An addition or subtraction of numeric or date type values"},"2895":{"id":"/docs/grammar-235","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#summand","content":"Example"},"2896":{"id":"/docs/grammar-236","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#factor","content":"A multiplication, division, or modulus of numeric type values."},"2897":{"id":"/docs/grammar-237","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#factor","content":"Example"},"2898":{"id":"/docs/grammar-238","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#term","content":"A term which may use subscript notation if it's an array."},"2899":{"id":"/docs/grammar-239","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#term","content":"Example"},"2900":{"id":"/docs/grammar-240","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#array-constructor","content":"Constructs an ARRAY out of the list of expressions."},"2901":{"id":"/docs/grammar-241","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#array-constructor","content":"Example"},"2902":{"id":"/docs/grammar-242","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#sequence","content":"Gets the CURRENT or NEXT value for a sequence, a monotonically incrementing BIGINT value. Each call to NEXT VALUE FOR increments the sequence value and returns the current value. The NEXT <n> VALUES syntax may be used to reserve <n> consecutive sequence values. A sequence is only increment once for a given statement, so multiple references to the same sequence by NEXT VALUE FOR produce the same value. Use CURRENT VALUE FOR to access the last sequence allocated with NEXT VALUE FOR for cluster connection of your client. If no NEXT VALUE FOR had been previously called, an error will occur. These calls are only allowed in the SELECT expressions or UPSERT VALUES expressions."},"2903":{"id":"/docs/grammar-243","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#sequence","content":"Example"},"2904":{"id":"/docs/grammar-244","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#cast","content":"The CAST operator coerces the given expression to a different dataType. This is useful, for example, to convert a BIGINT or INTEGER to a DECIMAL or DOUBLE to prevent truncation to a whole number during arithmetic operations. It is also useful to coerce from a more precise type to a less precise type since this type of coercion will not automatically occur, for example from a TIMESTAMP to a DATE. If the coercion is not possible, an error will occur."},"2905":{"id":"/docs/grammar-245","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#cast","content":"Example"},"2906":{"id":"/docs/grammar-246","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#row-value-constructor","content":"A row value constructor is a list of other terms which are treated together as a kind of composite structure. They may be compared to each other or to other other terms. The main use case is 1) to enable efficiently stepping through a set of rows in support of query-more type functionality, or 2) to allow IN clause to perform point gets on composite row keys."},"2907":{"id":"/docs/grammar-247","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#row-value-constructor","content":"Example"},"2908":{"id":"/docs/grammar-248","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#bind-parameter","content":"A parameters can be indexed, for example \":1\" meaning the first parameter."},"2909":{"id":"/docs/grammar-249","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#bind-parameter","content":"Example"},"2910":{"id":"/docs/grammar-250","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#value","content":"A literal value of any data type, or null."},"2911":{"id":"/docs/grammar-251","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#value","content":"Example"},"2912":{"id":"/docs/grammar-252","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#case","content":"Returns the first expression where the value is equal to the test expression. If no else part is specified, return NULL."},"2913":{"id":"/docs/grammar-253","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#case","content":"Example"},"2914":{"id":"/docs/grammar-254","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#case-when","content":"Returns the first expression where the condition is true. If no else part is specified, return NULL."},"2915":{"id":"/docs/grammar-255","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#case-when","content":"Example"},"2916":{"id":"/docs/grammar-256","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#name","content":"Unquoted names are not case sensitive. There is no maximum name length."},"2917":{"id":"/docs/grammar-257","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#name","content":"Example"},"2918":{"id":"/docs/grammar-258","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#quoted-name","content":"Quoted names are case sensitive, and can contain spaces. There is no maximum name length. Two double quotes can be used to create a single double quote inside an identifier."},"2919":{"id":"/docs/grammar-259","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#quoted-name","content":"Example"},"2920":{"id":"/docs/grammar-260","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#alias","content":"An alias is a name that is only valid in the context of the statement."},"2921":{"id":"/docs/grammar-261","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#alias","content":"Example"},"2922":{"id":"/docs/grammar-262","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#null","content":"NULL is a value without data type and means 'unknown value'."},"2923":{"id":"/docs/grammar-263","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#null","content":"Example"},"2924":{"id":"/docs/grammar-264","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#data-type","content":"A type name optionally declared as an array. An array is mapped to \"java.sql.Array\". Only single dimension arrays are supported and varbinary arrays are not allowed."},"2925":{"id":"/docs/grammar-265","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#data-type","content":"Example"},"2926":{"id":"/docs/grammar-266","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#sql-data-type","content":"A standard SQL data type."},"2927":{"id":"/docs/grammar-267","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#sql-data-type","content":"Example"},"2928":{"id":"/docs/grammar-268","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#hbase-data-type","content":"A type that maps to a native primitive HBase value serialized through the Bytes.toBytes() utility methods. Only positive values are allowed."},"2929":{"id":"/docs/grammar-269","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#hbase-data-type","content":"Example"},"2930":{"id":"/docs/grammar-270","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#string","content":"A string starts and ends with a single quote. Two single quotes can be used to create a single quote inside a string."},"2931":{"id":"/docs/grammar-271","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#string","content":"Example"},"2932":{"id":"/docs/grammar-272","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#boolean","content":"A boolean value."},"2933":{"id":"/docs/grammar-273","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#boolean","content":"Example"},"2934":{"id":"/docs/grammar-274","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#numeric","content":"The data type of a numeric value is always the lowest possible for the given value. If the number contains a dot this is decimal; otherwise it is int, long, or decimal (depending on the value)."},"2935":{"id":"/docs/grammar-275","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#numeric","content":"Example"},"2936":{"id":"/docs/grammar-276","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#int","content":"The maximum integer number is 2147483647, the minimum is -2147483648."},"2937":{"id":"/docs/grammar-277","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#int","content":"Example"},"2938":{"id":"/docs/grammar-278","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#long","content":"Long numbers are between -9223372036854775808 and 9223372036854775807."},"2939":{"id":"/docs/grammar-279","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#long","content":"Example"},"2940":{"id":"/docs/grammar-280","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#decimal","content":"A decimal number with fixed precision and scale. Internally, java.lang.BigDecimal is used."},"2941":{"id":"/docs/grammar-281","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#decimal","content":"Example"},"2942":{"id":"/docs/grammar-282","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#number","content":"The maximum length of the number depends on the data type used."},"2943":{"id":"/docs/grammar-283","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#number","content":"Example"},"2944":{"id":"/docs/grammar-284","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#comments","content":"Comments can be used anywhere in a command and are ignored by the database. Line comments end with a newline. Block comments cannot be nested, but can be multiple lines long."},"2945":{"id":"/docs/grammar-285","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar#comments","content":"Example"},"2946":{"id":"/docs","page_id":"/docs","type":"page","content":"Overview","breadcrumbs":["Docs","Multi-Page Documentation","Getting Started"],"tags":["multi-page"],"url":"/docs"},"2947":{"id":"/docs-0","page_id":"/docs","tags":["multi-page"],"type":"text","url":"/docs","content":"OLTP and operational analytics for Apache Hadoop."},"2948":{"id":"/docs-1","page_id":"/docs","type":"heading","tags":["multi-page"],"url":"/docs#mission","content":"Mission"},"2949":{"id":"/docs-2","page_id":"/docs","type":"heading","tags":["multi-page"],"url":"/docs#index-quick-start","content":"Quick Start"},"2950":{"id":"/docs-3","page_id":"/docs","type":"heading","tags":["multi-page"],"url":"/docs#sql-support","content":"SQL Support"},"2951":{"id":"/docs-4","page_id":"/docs","type":"heading","tags":["multi-page"],"url":"/docs#connection","content":"Connection"},"2952":{"id":"/docs-5","page_id":"/docs","type":"heading","tags":["multi-page"],"url":"/docs#index-transactions","content":"Transactions"},"2953":{"id":"/docs-6","page_id":"/docs","type":"heading","tags":["multi-page"],"url":"/docs#timestamps","content":"Timestamps"},"2954":{"id":"/docs-7","page_id":"/docs","type":"heading","tags":["multi-page"],"url":"/docs#schema","content":"Schema"},"2955":{"id":"/docs-8","page_id":"/docs","type":"heading","tags":["multi-page"],"url":"/docs#altering","content":"Altering"},"2956":{"id":"/docs-9","page_id":"/docs","type":"heading","tags":["multi-page"],"url":"/docs#index-views","content":"Views"},"2957":{"id":"/docs-10","page_id":"/docs","type":"heading","tags":["multi-page"],"url":"/docs#index-multi-tenancy","content":"Multi-tenancy"},"2958":{"id":"/docs-11","page_id":"/docs","type":"heading","tags":["multi-page"],"url":"/docs#schema-at-read-time","content":"Schema at read time"},"2959":{"id":"/docs-12","page_id":"/docs","type":"heading","tags":["multi-page"],"url":"/docs#mapping-to-an-existing-hbase-table","content":"Mapping to an Existing HBase Table"},"2960":{"id":"/docs-13","page_id":"/docs","type":"heading","tags":["multi-page"],"url":"/docs#index-salting","content":"Salting"},"2961":{"id":"/docs-14","page_id":"/docs","type":"heading","tags":["multi-page"],"url":"/docs#apis","content":"APIs"},"2962":{"id":"/docs-15","page_id":"/docs","tags":["multi-page"],"type":"text","url":"/docs","content":"OLTP and operational analytics for Apache Hadoop"},"2963":{"id":"/docs-16","page_id":"/docs","tags":["multi-page"],"type":"text","url":"/docs","content":"Download latest Apache Phoenix binary and source release artifacts"},"2964":{"id":"/docs-17","page_id":"/docs","tags":["multi-page"],"type":"text","url":"/docs","content":"Browse Apache Phoenix JIRAs"},"2965":{"id":"/docs-18","page_id":"/docs","tags":["multi-page"],"type":"text","url":"/docs","content":"Sync and build Apache Phoenix from source code"},"2966":{"id":"/docs-19","page_id":"/docs","tags":["multi-page"],"type":"text","url":"/docs","content":"type: info"},"2967":{"id":"/docs-20","page_id":"/docs","tags":["multi-page"],"type":"text","url":"/docs","content":"News: Phoenix 5.3.0 has been released and is available for\ndownload here. Follow Apache Phoenix on\nX/Twitter."},"2968":{"id":"/docs-21","page_id":"/docs","tags":["multi-page"],"type":"text","url":"/docs","content":"Apache Phoenix enables OLTP and operational analytics in Hadoop for low-latency applications by combining:"},"2969":{"id":"/docs-22","page_id":"/docs","tags":["multi-page"],"type":"text","url":"/docs","content":"the power of standard SQL and JDBC APIs, with full ACID transaction capabilities"},"2970":{"id":"/docs-23","page_id":"/docs","tags":["multi-page"],"type":"text","url":"/docs","content":"the flexibility of late-bound, schema-on-read capabilities from the NoSQL world by leveraging HBase as its backing store"},"2971":{"id":"/docs-24","page_id":"/docs","tags":["multi-page"],"type":"text","url":"/docs","content":"Apache Phoenix is fully integrated with other Hadoop products such as Spark, Hive, Pig, Flume, and MapReduce."},"2972":{"id":"/docs-25","page_id":"/docs","tags":["multi-page"],"type":"text","url":"/docs","content":"Who is using Apache Phoenix? Read more here."},"2973":{"id":"/docs-26","page_id":"/docs","tags":["multi-page"],"type":"text","url":"/docs#mission","content":"Become the trusted data platform for OLTP and operational analytics for Hadoop through well-defined, industry-standard APIs."},"2974":{"id":"/docs-27","page_id":"/docs","tags":["multi-page"],"type":"text","url":"/docs#index-quick-start","content":"Tired of reading and just want to get started? Take a look at our FAQs, listen to the Apache Phoenix talk from Hadoop Summit 2015, review the overview presentation, and jump to our quick start guide here."},"2975":{"id":"/docs-28","page_id":"/docs","tags":["multi-page"],"type":"text","url":"/docs#sql-support","content":"Apache Phoenix takes your SQL query, compiles it into a series of HBase scans, and orchestrates those scans to produce regular JDBC result sets. Direct use of the HBase API, along with coprocessors and custom filters, results in performance on the order of milliseconds for small queries, or seconds for tens of millions of rows."},"2976":{"id":"/docs-29","page_id":"/docs","tags":["multi-page"],"type":"text","url":"/docs#sql-support","content":"To see a complete list of what is supported, go to our language reference. All standard SQL query constructs are supported, including SELECT, FROM, WHERE, GROUP BY, HAVING, ORDER BY, etc. It also supports a full set of DML commands, as well as table creation and versioned incremental alterations through DDL commands."},"2977":{"id":"/docs-30","page_id":"/docs","tags":["multi-page"],"type":"text","url":"/docs#sql-support","content":"Here is a list of what is currently not supported:"},"2978":{"id":"/docs-31","page_id":"/docs","tags":["multi-page"],"type":"text","url":"/docs#sql-support","content":"Relational operators: INTERSECT, MINUS"},"2979":{"id":"/docs-32","page_id":"/docs","tags":["multi-page"],"type":"text","url":"/docs#sql-support","content":"Miscellaneous built-in functions: these are easy to add — read this blog for step-by-step instructions."},"2980":{"id":"/docs-33","page_id":"/docs","tags":["multi-page"],"type":"text","url":"/docs#connection","content":"Use JDBC to get a connection to an HBase cluster:"},"2981":{"id":"/docs-34","page_id":"/docs","tags":["multi-page"],"type":"text","url":"/docs#connection","content":"Where props are optional properties that may include Phoenix and HBase configuration values."},"2982":{"id":"/docs-35","page_id":"/docs","tags":["multi-page"],"type":"text","url":"/docs#connection","content":"The JDBC connection string is composed as:"},"2983":{"id":"/docs-36","page_id":"/docs","tags":["multi-page"],"type":"text","url":"/docs#connection","content":"For omitted parts, values are taken from hbase-site.xml (hbase.zookeeper.quorum, hbase.zookeeper.property.clientPort, and zookeeper.znode.parent)."},"2984":{"id":"/docs-37","page_id":"/docs","tags":["multi-page"],"type":"text","url":"/docs#connection","content":"The optional principal and keytab file may be used to connect to a Kerberos-secured cluster. If only principal is specified, each distinct user gets a dedicated HBase connection (HConnection), allowing multiple different connections with different configuration properties on the same JVM."},"2985":{"id":"/docs-38","page_id":"/docs","tags":["multi-page"],"type":"text","url":"/docs#connection","content":"For example, for longer-running queries:"},"2986":{"id":"/docs-39","page_id":"/docs","tags":["multi-page"],"type":"text","url":"/docs#connection","content":"And for shorter-running queries:"},"2987":{"id":"/docs-40","page_id":"/docs","tags":["multi-page"],"type":"text","url":"/docs#connection","content":"See the relevant FAQ entry for example URLs."},"2988":{"id":"/docs-41","page_id":"/docs","tags":["multi-page"],"type":"text","url":"/docs#connection","content":"Phoenix also supports connecting to HBase without ZooKeeper."},"2989":{"id":"/docs-42","page_id":"/docs","tags":["multi-page"],"type":"text","url":"/docs#index-transactions","content":"To enable full ACID transactions (beta in 4.7.0), set phoenix.transactions.enabled=true. In this case, you also need to run the transaction manager included in the distribution. Once enabled, a table may optionally be declared as transactional (see transactions)."},"2990":{"id":"/docs-43","page_id":"/docs","tags":["multi-page"],"type":"text","url":"/docs#index-transactions","content":"Commits over transactional tables are all-or-none: either all data is committed (including secondary index updates) or none is committed (and an exception is thrown). Both cross-table and cross-row transactions are supported. Transactional tables also see their own uncommitted data when querying. An optimistic concurrency model is used to detect row-level conflicts with first-commit-wins semantics."},"2991":{"id":"/docs-44","page_id":"/docs","tags":["multi-page"],"type":"text","url":"/docs#index-transactions","content":"Non-transactional tables have no guarantees beyond HBase row-level atomicity (see HBase ACID semantics). Also, non-transactional tables do not see updates until commit occurs."},"2992":{"id":"/docs-45","page_id":"/docs","tags":["multi-page"],"type":"text","url":"/docs#index-transactions","content":"Phoenix DML commands (UPSERT VALUES, UPSERT SELECT, DELETE) batch pending changes on the client side. Changes are sent to server on commit and discarded on rollback. If auto-commit is enabled, Phoenix will execute the entire DML command server-side via coprocessors whenever possible for better performance."},"2993":{"id":"/docs-46","page_id":"/docs","tags":["multi-page"],"type":"text","url":"/docs#timestamps","content":"Most applications let HBase manage timestamps. In cases where timestamps must be controlled, the CurrentSCN property can be set at connection time to control timestamps for DDL, DML, and queries. This also enables snapshot queries against prior row values because Phoenix uses this property as scan max timestamp."},"2994":{"id":"/docs-47","page_id":"/docs","tags":["multi-page"],"type":"text","url":"/docs#timestamps","content":"Timestamps cannot be controlled for transactional tables. Instead, the transaction manager assigns timestamps that become HBase cell timestamps on commit. They still correspond to wall-clock time, but are multiplied by 1,000,000 to ensure enough granularity for uniqueness across the cluster."},"2995":{"id":"/docs-48","page_id":"/docs","tags":["multi-page"],"type":"text","url":"/docs#schema","content":"Apache Phoenix supports table creation and versioned incremental alterations through DDL commands. Table metadata is stored in an HBase table and versioned, so snapshot queries over prior versions automatically use the correct schema."},"2996":{"id":"/docs-49","page_id":"/docs","tags":["multi-page"],"type":"text","url":"/docs#schema","content":"A Phoenix table can be created through CREATE TABLE and can either be:"},"2997":{"id":"/docs-50","page_id":"/docs","tags":["multi-page"],"type":"text","url":"/docs#schema","content":"Built from scratch: HBase table and column families are created automatically."},"2998":{"id":"/docs-51","page_id":"/docs","tags":["multi-page"],"type":"text","url":"/docs#schema","content":"Mapped to an existing HBase table: either as a read-write TABLE or a read-only VIEW, with the caveat that row key/key-value binary representation must match Phoenix data types (see Data Types)."},"2999":{"id":"/docs-52","page_id":"/docs","tags":["multi-page"],"type":"text","url":"/docs#schema","content":"For a read-write TABLE, column families are created automatically if absent. An empty key value is added to the first column family of each existing row to minimize projection size for queries."},"3000":{"id":"/docs-53","page_id":"/docs","tags":["multi-page"],"type":"text","url":"/docs#schema","content":"For a read-only VIEW, all column families must already exist. The only change is adding Phoenix coprocessors for query processing. The primary use case is transferring existing data into Phoenix; DML is not allowed on a VIEW, and query performance may be lower than with a TABLE."},"3001":{"id":"/docs-54","page_id":"/docs","tags":["multi-page"],"type":"text","url":"/docs#schema","content":"All schema is versioned (up to 1000 versions kept). Snapshot queries over older data pick up the correct schema based on connection time via CurrentSCN."},"3002":{"id":"/docs-55","page_id":"/docs","tags":["multi-page"],"type":"text","url":"/docs#altering","content":"A Phoenix table may be altered via ALTER TABLE. When a SQL statement references a table, Phoenix checks with the server by default to ensure metadata and statistics are up to date."},"3003":{"id":"/docs-56","page_id":"/docs","tags":["multi-page"],"type":"text","url":"/docs#altering","content":"If table structure is known to be stable, this RPC may be unnecessary. UPDATE_CACHE_FREQUENCY (added in 4.7) lets users define how often the server is checked for metadata/statistics updates. Possible values: ALWAYS (default), NEVER, or a millisecond value."},"3004":{"id":"/docs-57","page_id":"/docs","tags":["multi-page"],"type":"text","url":"/docs#altering","content":"For example, this DDL creates table FOO and tells clients to check for updates every 15 minutes:"},"3005":{"id":"/docs-58","page_id":"/docs","tags":["multi-page"],"type":"text","url":"/docs#index-views","content":"Phoenix supports updatable views on top of tables, with the unique capability of adding columns by leveraging HBase schemaless behavior. All views share the same underlying HBase table and may be indexed independently. Read more here."},"3006":{"id":"/docs-59","page_id":"/docs","tags":["multi-page"],"type":"text","url":"/docs#index-multi-tenancy","content":"Built on top of view support, Phoenix also supports multi-tenancy. As with views, a multi-tenant view can add columns defined solely for that user."},"3007":{"id":"/docs-60","page_id":"/docs","tags":["multi-page"],"type":"text","url":"/docs#schema-at-read-time","content":"Another schema-related feature allows columns to be defined dynamically at query time. This is useful when not all columns are known at create time. More details here."},"3008":{"id":"/docs-61","page_id":"/docs","tags":["multi-page"],"type":"text","url":"/docs#mapping-to-an-existing-hbase-table","content":"Phoenix supports mapping to an existing HBase table through CREATE TABLE and CREATE VIEW. In both cases, HBase metadata remains as-is, except that with CREATE TABLE, KEEP_DELETED_CELLS is enabled so flashback queries work correctly."},"3009":{"id":"/docs-62","page_id":"/docs","tags":["multi-page"],"type":"text","url":"/docs#mapping-to-an-existing-hbase-table","content":"For CREATE TABLE, missing HBase metadata (table/column families) is created if needed. Table and column family names are case-sensitive at HBase level; Phoenix uppercases names by default. To preserve case sensitivity, wrap names in double quotes:"},"3010":{"id":"/docs-63","page_id":"/docs","tags":["multi-page"],"type":"text","url":"/docs#mapping-to-an-existing-hbase-table","content":"For CREATE TABLE, an empty key value is added per row so queries behave as expected without projecting all columns during scans. For CREATE VIEW, this is not done and no HBase metadata is created. Existing HBase metadata must match DDL metadata, or ERROR 505 (42000): Table is read only is thrown."},"3011":{"id":"/docs-64","page_id":"/docs","tags":["multi-page"],"type":"text","url":"/docs#mapping-to-an-existing-hbase-table","content":"Another caveat: bytes serialized in HBase must match Phoenix serialization expectations."},"3012":{"id":"/docs-65","page_id":"/docs","tags":["multi-page"],"type":"text","url":"/docs#mapping-to-an-existing-hbase-table","content":"For VARCHAR, CHAR, and UNSIGNED_* types, Phoenix uses HBase Bytes utility methods."},"3013":{"id":"/docs-66","page_id":"/docs","tags":["multi-page"],"type":"text","url":"/docs#mapping-to-an-existing-hbase-table","content":"CHAR expects only single-byte characters."},"3014":{"id":"/docs-67","page_id":"/docs","tags":["multi-page"],"type":"text","url":"/docs#mapping-to-an-existing-hbase-table","content":"UNSIGNED_* expects non-negative values."},"3015":{"id":"/docs-68","page_id":"/docs","tags":["multi-page"],"type":"text","url":"/docs#mapping-to-an-existing-hbase-table","content":"Composite row keys are formed by concatenating values, with a zero byte separator after variable-length types. For more on type system details, see Data Types."},"3016":{"id":"/docs-69","page_id":"/docs","tags":["multi-page"],"type":"text","url":"/docs#index-salting","content":"Tables can be declared salted to avoid HBase region hotspotting. Declare a salt bucket count and Phoenix manages salting transparently. See details here, and write-throughput comparison here."},"3017":{"id":"/docs-70","page_id":"/docs","tags":["multi-page"],"type":"text","url":"/docs#apis","content":"Catalog metadata (tables, columns, primary keys, and types) can be retrieved through Java SQL metadata interfaces: DatabaseMetaData, ParameterMetaData, and ResultSetMetaData."},"3018":{"id":"/docs-71","page_id":"/docs","tags":["multi-page"],"type":"text","url":"/docs#apis","content":"For schema/table/column retrieval via DatabaseMetaData, schema pattern, table pattern, and column pattern are LIKE-style expressions (% and _, escaped by \\)."},"3019":{"id":"/docs-72","page_id":"/docs","tags":["multi-page"],"type":"text","url":"/docs#apis","content":"In metadata APIs, table catalog argument is used to filter by tenant ID for multi-tenant tables."},"3020":{"id":"/docs/installation","page_id":"/docs/installation","type":"page","content":"Installation","breadcrumbs":["Docs","Multi-Page Documentation","Getting Started"],"tags":["multi-page"],"url":"/docs/installation"},"3021":{"id":"/docs/installation-0","page_id":"/docs/installation","tags":["multi-page"],"type":"text","url":"/docs/installation","content":"Install and configure Apache Phoenix clients and server components."},"3022":{"id":"/docs/installation-1","page_id":"/docs/installation","type":"heading","tags":["multi-page"],"url":"/docs/installation#installation-installation","content":"Installation"},"3023":{"id":"/docs/installation-2","page_id":"/docs/installation","type":"heading","tags":["multi