":"heading","tags":["multi-page"],"url":"/docs/datatypes#double-type","content":"DOUBLE Type"},"322":{"id":"/docs/datatypes-13","page_id":"/docs/datatypes","type":"heading","tags":["multi-page"],"url":"/docs/datatypes#unsigned_double-type","content":"UNSIGNED_DOUBLE Type"},"323":{"id":"/docs/datatypes-14","page_id":"/docs/datatypes","type":"heading","tags":["multi-page"],"url":"/docs/datatypes#decimal-type","content":"DECIMAL Type"},"324":{"id":"/docs/datatypes-15","page_id":"/docs/datatypes","type":"heading","tags":["multi-page"],"url":"/docs/datatypes#boolean-type","content":"BOOLEAN Type"},"325":{"id":"/docs/datatypes-16","page_id":"/docs/datatypes","type":"heading","tags":["multi-page"],"url":"/docs/datatypes#time-type","content":"TIME Type"},"326":{"id":"/docs/datatypes-17","page_id":"/docs/datatypes","type":"heading","tags":["multi-page"],"url":"/docs/datatypes#date-type","content":"DATE Type"},"327":{"id":"/docs/datatypes-18","page_id":"/docs/datatypes","type":"heading","tags":["multi-page"],"url":"/docs/datatypes#timestamp-type","content":"TIMESTAMP Type"},"328":{"id":"/docs/datatypes-19","page_id":"/docs/datatypes","type":"heading","tags":["multi-page"],"url":"/docs/datatypes#unsigned_time-type","content":"UNSIGNED_TIME Type"},"329":{"id":"/docs/datatypes-20","page_id":"/docs/datatypes","type":"heading","tags":["multi-page"],"url":"/docs/datatypes#unsigned_date-type","content":"UNSIGNED_DATE Type"},"330":{"id":"/docs/datatypes-21","page_id":"/docs/datatypes","type":"heading","tags":["multi-page"],"url":"/docs/datatypes#unsigned_timestamp-type","content":"UNSIGNED_TIMESTAMP Type"},"331":{"id":"/docs/datatypes-22","page_id":"/docs/datatypes","type":"heading","tags":["multi-page"],"url":"/docs/datatypes#varchar-type","content":"VARCHAR Type"},"332":{"id":"/docs/datatypes-23","page_id":"/docs/datatypes","type":"heading","tags":["multi-page"],"url":"/docs/datatypes#char-type","content":"CHAR Type"},"333":{"id":"/docs/datatypes-24","page_id":"/docs/datatypes","type":"heading","tags":["multi-page"],"url":"/docs/datatypes#binary-type","content":"BINARY Type"},"334":{"id":"/docs/datatypes-25","page_id":"/docs/datatypes","type":"heading","tags":["multi-page"],"url":"/docs/datatypes#varbinary-type","content":"VARBINARY Type"},"335":{"id":"/docs/datatypes-26","page_id":"/docs/datatypes","type":"heading","tags":["multi-page"],"url":"/docs/datatypes#varbinary_encoded-type","content":"VARBINARY_ENCODED Type"},"336":{"id":"/docs/datatypes-27","page_id":"/docs/datatypes","type":"heading","tags":["multi-page"],"url":"/docs/datatypes#array","content":"ARRAY"},"337":{"id":"/docs/datatypes-28","page_id":"/docs/datatypes","type":"heading","tags":["multi-page"],"url":"/docs/datatypes#bson-type","content":"BSON Type"},"338":{"id":"/docs/datatypes-29","page_id":"/docs/datatypes","tags":["multi-page"],"type":"text","url":"/docs/datatypes#integer-type","content":"Possible values: -2147483648 to 2147483647."},"339":{"id":"/docs/datatypes-30","page_id":"/docs/datatypes","tags":["multi-page"],"type":"text","url":"/docs/datatypes#integer-type","content":"Mapped to java.lang.Integer. The binary representation is a 4 byte integer with the sign bit flipped (so that negative values sorts before positive values)."},"340":{"id":"/docs/datatypes-31","page_id":"/docs/datatypes","tags":["multi-page"],"type":"text","url":"/docs/datatypes#integer-type","content":"Example"},"341":{"id":"/docs/datatypes-32","page_id":"/docs/datatypes","tags":["multi-page"],"type":"text","url":"/docs/datatypes#unsigned_int-type","content":"Possible values: 0 to 2147483647. Mapped to java.lang.Integer. The binary representation is a 4 byte integer, matching the Bytes.toBytes(int) method. The purpose of this type is to map to existing HBase data that was serialized using this HBase utility method. If that is not the case, use the regular signed type instead."},"342":{"id":"/docs/datatypes-33","page_id":"/docs/datatypes","tags":["multi-page"],"type":"text","url":"/docs/datatypes#unsigned_int-type","content":"Example"},"343":{"id":"/docs/datatypes-34","page_id":"/docs/datatypes","tags":["multi-page"],"type":"text","url":"/docs/datatypes#bigint-type","content":"Possible values: -9223372036854775808 to 9223372036854775807. Mapped to java.lang.Long. The binary representation is an 8 byte long with the sign bit flipped (so that negative values sorts before positive values)."},"344":{"id":"/docs/datatypes-35","page_id":"/docs/datatypes","tags":["multi-page"],"type":"text","url":"/docs/datatypes#bigint-type","content":"Example"},"345":{"id":"/docs/datatypes-36","page_id":"/docs/datatypes","tags":["multi-page"],"type":"text","url":"/docs/datatypes#unsigned_long-type","content":"Possible values: 0 to 9223372036854775807. Mapped to java.lang.Long. The binary representation is an 8 byte integer, matching the Bytes.toBytes(long) method. The purpose of this type is to map to existing HBase data that was serialized using this HBase utility method. If that is not the case, use the regular signed type instead."},"346":{"id":"/docs/datatypes-37","page_id":"/docs/datatypes","tags":["multi-page"],"type":"text","url":"/docs/datatypes#unsigned_long-type","content":"Example"},"347":{"id":"/docs/datatypes-38","page_id":"/docs/datatypes","tags":["multi-page"],"type":"text","url":"/docs/datatypes#tinyint-type","content":"Possible values: -128 to 127. Mapped to java.lang.Byte. The binary representation is a single byte, with the sign bit flipped (so that negative values sorts before positive values)."},"348":{"id":"/docs/datatypes-39","page_id":"/docs/datatypes","tags":["multi-page"],"type":"text","url":"/docs/datatypes#tinyint-type","content":"Example"},"349":{"id":"/docs/datatypes-40","page_id":"/docs/datatypes","tags":["multi-page"],"type":"text","url":"/docs/datatypes#unsigned_tinyint-type","content":"Possible values: 0 to 127. Mapped to java.lang.Byte. The binary representation is a single byte, matching the Bytes.toBytes(byte) method. The purpose of this type is to map to existing HBase data that was serialized using this HBase utility method. If that is not the case, use the regular signed type instead."},"350":{"id":"/docs/datatypes-41","page_id":"/docs/datatypes","tags":["multi-page"],"type":"text","url":"/docs/datatypes#unsigned_tinyint-type","content":"Example"},"351":{"id":"/docs/datatypes-42","page_id":"/docs/datatypes","tags":["multi-page"],"type":"text","url":"/docs/datatypes#smallint-type","content":"Possible values: -32768 to 32767. Mapped to java.lang.Short. The binary representation is a 2 byte short with the sign bit flipped (so that negative values sort before positive values)."},"352":{"id":"/docs/datatypes-43","page_id":"/docs/datatypes","tags":["multi-page"],"type":"text","url":"/docs/datatypes#smallint-type","content":"Example"},"353":{"id":"/docs/datatypes-44","page_id":"/docs/datatypes","tags":["multi-page"],"type":"text","url":"/docs/datatypes#unsigned_smallint-type","content":"Possible values: 0 to 32767. Mapped to java.lang.Short. The binary representation is an 2 byte integer, matching the Bytes.toBytes(short) method. The purpose of this type is to map to existing HBase data that was serialized using this HBase utility method. If that is not the case, use the regular signed type instead."},"354":{"id":"/docs/datatypes-45","page_id":"/docs/datatypes","tags":["multi-page"],"type":"text","url":"/docs/datatypes#unsigned_smallint-type","content":"Example"},"355":{"id":"/docs/datatypes-46","page_id":"/docs/datatypes","tags":["multi-page"],"type":"text","url":"/docs/datatypes#float-type","content":"Possible values: -3.402823466 E + 38 to 3.402823466 E + 38. Mapped to java.lang.Float. The binary representation is an 4 byte float with the sign bit flipped (so that negative values sort before positive values)."},"356":{"id":"/docs/datatypes-47","page_id":"/docs/datatypes","tags":["multi-page"],"type":"text","url":"/docs/datatypes#float-type","content":"Example"},"357":{"id":"/docs/datatypes-48","page_id":"/docs/datatypes","tags":["multi-page"],"type":"text","url":"/docs/datatypes#unsigned_float-type","content":"Possible values: 0 to 3.402823466 E + 38. Mapped to java.lang.Float. The binary representation is an 4 byte float matching the Bytes.toBytes(float) method. The purpose of this type is to map to existing HBase data that was serialized using this HBase utility method. If that is not the case, use the regular signed type instead."},"358":{"id":"/docs/datatypes-49","page_id":"/docs/datatypes","tags":["multi-page"],"type":"text","url":"/docs/datatypes#unsigned_float-type","content":"Example"},"359":{"id":"/docs/datatypes-50","page_id":"/docs/datatypes","tags":["multi-page"],"type":"text","url":"/docs/datatypes#double-type","content":"Possible values: -1.7976931348623158 E + 308 to 1.7976931348623158 E + 308. Mapped to java.lang.Double. The binary representation is an 8 byte double with the sign bit flipped (so that negative values sort before positive value)."},"360":{"id":"/docs/datatypes-51","page_id":"/docs/datatypes","tags":["multi-page"],"type":"text","url":"/docs/datatypes#double-type","content":"Example"},"361":{"id":"/docs/datatypes-52","page_id":"/docs/datatypes","tags":["multi-page"],"type":"text","url":"/docs/datatypes#unsigned_double-type","content":"Possible values: 0 to  1.7976931348623158 E + 308. Mapped to java.lang.Double. The binary representation is an 8 byte double matching the Bytes.toBytes(double) method. The purpose of this type is to map to existing HBase data that was serialized using this HBase utility method. If that is not the case, use the regular signed type instead."},"362":{"id":"/docs/datatypes-53","page_id":"/docs/datatypes","tags":["multi-page"],"type":"text","url":"/docs/datatypes#unsigned_double-type","content":"Example"},"363":{"id":"/docs/datatypes-54","page_id":"/docs/datatypes","tags":["multi-page"],"type":"text","url":"/docs/datatypes#decimal-type","content":"Data type with fixed precision and scale. A user can specify precision and scale by expression DECIMAL(precision,scale) in a DDL statement, for example, DECIMAL(10,2). The maximum precision is 38 digits. Mapped to java.math.BigDecimal. The binary representation is binary comparable, variable length format. When used in a row key, it is terminated with a null byte unless it is the last column."},"364":{"id":"/docs/datatypes-55","page_id":"/docs/datatypes","tags":["multi-page"],"type":"text","url":"/docs/datatypes#decimal-type","content":"Example"},"365":{"id":"/docs/datatypes-56","page_id":"/docs/datatypes","tags":["multi-page"],"type":"text","url":"/docs/datatypes#boolean-type","content":"Possible values: TRUE and FALSE."},"366":{"id":"/docs/datatypes-57","page_id":"/docs/datatypes","tags":["multi-page"],"type":"text","url":"/docs/datatypes#boolean-type","content":"Mapped to java.lang.Boolean. The binary representation is a single byte with 0 for false and 1 for true"},"367":{"id":"/docs/datatypes-58","page_id":"/docs/datatypes","tags":["multi-page"],"type":"text","url":"/docs/datatypes#boolean-type","content":"Example"},"368":{"id":"/docs/datatypes-59","page_id":"/docs/datatypes","tags":["multi-page"],"type":"text","url":"/docs/datatypes#time-type","content":"The time data type. The format is yyyy-MM-dd hh:mm:ss, with both the date and time parts maintained. Mapped to java.sql.Time. The binary representation is an 8 byte long (the number of milliseconds from the epoch), making it possible (although not necessarily recommended) to store more information within a TIME column than what is provided by \"java.sql.Time\". Note that the internal representation is based on a number of milliseconds since the epoch (which is based on a time in GMT), while \"java.sql.Time\" will format times based on the client's local time zone. Please note that this TIME type is different than the TIME type as defined by the SQL 92 standard in that it includes year, month, and day components. As such, it is not in compliance with the JDBC APIs. As the underlying data is still stored as a long, only the presentation of the value is incorrect."},"369":{"id":"/docs/datatypes-60","page_id":"/docs/datatypes","tags":["multi-page"],"type":"text","url":"/docs/datatypes#time-type","content":"Example"},"370":{"id":"/docs/datatypes-61","page_id":"/docs/datatypes","tags":["multi-page"],"type":"text","url":"/docs/datatypes#date-type","content":"The date data type. The format is yyyy-MM-dd hh:mm:ss, with both the date and time parts maintained to a millisecond accuracy. Mapped to java.sql.Date. The binary representation is an 8 byte long (the number of milliseconds from the epoch), making it possible (although not necessarily recommended) to store more information within a DATE column than what is provided by \"java.sql.Date\". Note that the internal representation is based on a number of milliseconds since the epoch (which is based on a time in GMT), while \"java.sql.Date\" will format dates based on the client's local time zone. Please note that this DATE type is different than the DATE type as defined by the SQL 92 standard in that it includes a time component. As such, it is not in compliance with the JDBC APIs. As the underlying data is still stored as a long, only the presentation of the value is incorrect."},"371":{"id":"/docs/datatypes-62","page_id":"/docs/datatypes","tags":["multi-page"],"type":"text","url":"/docs/datatypes#date-type","content":"Example"},"372":{"id":"/docs/datatypes-63","page_id":"/docs/datatypes","tags":["multi-page"],"type":"text","url":"/docs/datatypes#timestamp-type","content":"The timestamp data type. The format is yyyy-MM-dd hh:mm:ss[.nnnnnnnnn]. Mapped to java.sql.Timestamp with an internal representation of the number of nanos from the epoch. The binary representation is 12 bytes: an 8 byte long for the epoch time plus a 4 byte integer for the nanos. Note that the internal representation is based on a number of milliseconds since the epoch (which is based on a time in GMT), while \"java.sql.Timestamp\" will format timestamps based on the client's local time zone."},"373":{"id":"/docs/datatypes-64","page_id":"/docs/datatypes","tags":["multi-page"],"type":"text","url":"/docs/datatypes#timestamp-type","content":"Example"},"374":{"id":"/docs/datatypes-65","page_id":"/docs/datatypes","tags":["multi-page"],"type":"text","url":"/docs/datatypes#unsigned_time-type","content":"The unsigned time data type. The format is yyyy-MM-dd hh:mm:ss, with both the date and time parts maintained to the millisecond accuracy. Mapped to java.sql.Time. The binary representation is an 8 byte long (the number of milliseconds from the epoch) matching the HBase.toBytes(long) method. The purpose of this type is to map to existing HBase data that was serialized using this HBase utility method. If that is not the case, use the regular signed type instead."},"375":{"id":"/docs/datatypes-66","page_id":"/docs/datatypes","tags":["multi-page"],"type":"text","url":"/docs/datatypes#unsigned_time-type","content":"Example"},"376":{"id":"/docs/datatypes-67","page_id":"/docs/datatypes","tags":["multi-page"],"type":"text","url":"/docs/datatypes#unsigned_date-type","content":"The unsigned date data type. The format is yyyy-MM-dd hh:mm:ss, with both the date and time parts maintained to a millisecond accuracy. Mapped to java.sql.Date. The binary representation is an 8 byte long (the number of milliseconds from the epoch) matching the HBase.toBytes(long) method. The purpose of this type is to map to existing HBase data that was serialized using this HBase utility method. If that is not the case, use the regular signed type instead."},"377":{"id":"/docs/datatypes-68","page_id":"/docs/datatypes","tags":["multi-page"],"type":"text","url":"/docs/datatypes#unsigned_date-type","content":"Example"},"378":{"id":"/docs/datatypes-69","page_id":"/docs/datatypes","tags":["multi-page"],"type":"text","url":"/docs/datatypes#unsigned_timestamp-type","content":"The timestamp data type. The format is yyyy-MM-dd hh:mm:ss[.nnnnnnnnn]. Mapped to java.sql.Timestamp with an internal representation of the number of nanos from the epoch. The binary representation is 12 bytes: an 8 byte long for the epoch time plus a 4 byte integer for the nanos with the long serialized through the HBase.toBytes(long) method. The purpose of this type is to map to existing HBase data that was serialized using this HBase utility method. If that is not the case, use the regular signed type instead."},"379":{"id":"/docs/datatypes-70","page_id":"/docs/datatypes","tags":["multi-page"],"type":"text","url":"/docs/datatypes#unsigned_timestamp-type","content":"Example"},"380":{"id":"/docs/datatypes-71","page_id":"/docs/datatypes","tags":["multi-page"],"type":"text","url":"/docs/datatypes#varchar-type","content":"A variable length String with an optional max byte length. The binary representation is UTF8 matching the Bytes.toBytes(String) method. When used in a row key, it is terminated with a null byte unless it is the last column."},"381":{"id":"/docs/datatypes-72","page_id":"/docs/datatypes","tags":["multi-page"],"type":"text","url":"/docs/datatypes#varchar-type","content":"Mapped to java.lang.String."},"382":{"id":"/docs/datatypes-73","page_id":"/docs/datatypes","tags":["multi-page"],"type":"text","url":"/docs/datatypes#varchar-type","content":"Example"},"383":{"id":"/docs/datatypes-74","page_id":"/docs/datatypes","tags":["multi-page"],"type":"text","url":"/docs/datatypes#char-type","content":"A fixed length String with single-byte characters. The binary representation is UTF8 matching the Bytes.toBytes(String) method."},"384":{"id":"/docs/datatypes-75","page_id":"/docs/datatypes","tags":["multi-page"],"type":"text","url":"/docs/datatypes#char-type","content":"Mapped to java.lang.String."},"385":{"id":"/docs/datatypes-76","page_id":"/docs/datatypes","tags":["multi-page"],"type":"text","url":"/docs/datatypes#char-type","content":"Example"},"386":{"id":"/docs/datatypes-77","page_id":"/docs/datatypes","tags":["multi-page"],"type":"text","url":"/docs/datatypes#binary-type","content":"Raw fixed length byte array."},"387":{"id":"/docs/datatypes-78","page_id":"/docs/datatypes","tags":["multi-page"],"type":"text","url":"/docs/datatypes#binary-type","content":"Mapped to byte[]."},"388":{"id":"/docs/datatypes-79","page_id":"/docs/datatypes","tags":["multi-page"],"type":"text","url":"/docs/datatypes#binary-type","content":"Example"},"389":{"id":"/docs/datatypes-80","page_id":"/docs/datatypes","tags":["multi-page"],"type":"text","url":"/docs/datatypes#varbinary-type","content":"Raw variable length byte array."},"390":{"id":"/docs/datatypes-81","page_id":"/docs/datatypes","tags":["multi-page"],"type":"text","url":"/docs/datatypes#varbinary-type","content":"Mapped to byte[]."},"391":{"id":"/docs/datatypes-82","page_id":"/docs/datatypes","tags":["multi-page"],"type":"text","url":"/docs/datatypes#varbinary-type","content":"Example"},"392":{"id":"/docs/datatypes-83","page_id":"/docs/datatypes","tags":["multi-page"],"type":"text","url":"/docs/datatypes#varbinary_encoded-type","content":"Variable length byte array that escapes embedded 0x00 bytes so its sort order matches the lexicographic order of the original bytes. Use it anywhere ordering matters: a non-trailing column of a composite primary key, an index key, or a row value constructor over binary data."},"393":{"id":"/docs/datatypes-84","page_id":"/docs/datatypes","tags":["multi-page"],"type":"text","url":"/docs/datatypes#varbinary_encoded-type","content":"Mapped to byte[]. See VARBINARY_ENCODED for details."},"394":{"id":"/docs/datatypes-85","page_id":"/docs/datatypes","tags":["multi-page"],"type":"text","url":"/docs/datatypes#varbinary_encoded-type","content":"Example"},"395":{"id":"/docs/datatypes-86","page_id":"/docs/datatypes","tags":["multi-page"],"type":"text","url":"/docs/datatypes#array","content":"Mapped to java.sql.Array. Every primitive type except for VARBINARY may be declared as an ARRAY. Only single dimensional arrays are supported."},"396":{"id":"/docs/datatypes-87","page_id":"/docs/datatypes","tags":["multi-page"],"type":"text","url":"/docs/datatypes#array","content":"Example"},"397":{"id":"/docs/datatypes-88","page_id":"/docs/datatypes","tags":["multi-page"],"type":"text","url":"/docs/datatypes#bson-type","content":"Native binary JSON document column for schemaless data. Phoenix can read individual fields with BSON_VALUE, filter rows with BSON_CONDITION_EXPRESSION, and atomically update fields with BSON_UPDATE_EXPRESSION — all evaluated server-side."},"398":{"id":"/docs/datatypes-89","page_id":"/docs/datatypes","tags":["multi-page"],"type":"text","url":"/docs/datatypes#bson-type","content":"Stored as BSON bytes; returned as org.bson.RawBsonDocument. See Document Data: BSON for details."},"399":{"id":"/docs/datatypes-90","page_id":"/docs/datatypes","tags":["multi-page"],"type":"text","url":"/docs/datatypes#bson-type","content":"Example"},"400":{"id":"/docs/explain-plan","page_id":"/docs/explain-plan","type":"page","content":"Explain Plan","breadcrumbs":["Docs","Multi-Page Documentation","Reference"],"tags":["multi-page"],"url":"/docs/explain-plan"},"401":{"id":"/docs/explain-plan-0","page_id":"/docs/explain-plan","tags":["multi-page"],"type":"text","url":"/docs/explain-plan","content":"How to read and use EXPLAIN plans in Apache Phoenix."},"402":{"id":"/docs/explain-plan-1","page_id":"/docs/explain-plan","type":"heading","tags":["multi-page"],"url":"/docs/explain-plan#explain-plan-overview","content":"Explain Plan"},"403":{"id":"/docs/explain-plan-2","page_id":"/docs/explain-plan","type":"heading","tags":["multi-page"],"url":"/docs/explain-plan#anatomy-of-an-explain-plan","content":"Anatomy of an Explain Plan"},"404":{"id":"/docs/explain-plan-3","page_id":"/docs/explain-plan","type":"heading","tags":["multi-page"],"url":"/docs/explain-plan#explain-plan-example","content":"Example"},"405":{"id":"/docs/explain-plan-4","page_id":"/docs/explain-plan","type":"heading","tags":["multi-page"],"url":"/docs/explain-plan#jdbc-explain-plan-api-and-estimates","content":"JDBC Explain Plan API and Estimates"},"406":{"id":"/docs/explain-plan-5","page_id":"/docs/explain-plan","tags":["multi-page"],"type":"text","url":"/docs/explain-plan#explain-plan-overview","content":"An EXPLAIN plan tells you a lot about how a query will be run:"},"407":{"id":"/docs/explain-plan-6","page_id":"/docs/explain-plan","tags":["multi-page"],"type":"text","url":"/docs/explain-plan#explain-plan-overview","content":"All the HBase range queries that will be executed"},"408":{"id":"/docs/explain-plan-7","page_id":"/docs/explain-plan","tags":["multi-page"],"type":"text","url":"/docs/explain-plan#explain-plan-overview","content":"An estimate of the number of bytes that will be scanned"},"409":{"id":"/docs/explain-plan-8","page_id":"/docs/explain-plan","tags":["multi-page"],"type":"text","url":"/docs/explain-plan#explain-plan-overview","content":"An estimate of the number of rows that will be traversed"},"410":{"id":"/docs/explain-plan-9","page_id":"/docs/explain-plan","tags":["multi-page"],"type":"text","url":"/docs/explain-plan#explain-plan-overview","content":"Time at which the above estimate information was collected"},"411":{"id":"/docs/explain-plan-10","page_id":"/docs/explain-plan","tags":["multi-page"],"type":"text","url":"/docs/explain-plan#explain-plan-overview","content":"Which HBase table will be used for each scan"},"412":{"id":"/docs/explain-plan-11","page_id":"/docs/explain-plan","tags":["multi-page"],"type":"text","url":"/docs/explain-plan#explain-plan-overview","content":"Which operations (sort, merge, scan, limit) are executed on the client versus the server"},"413":{"id":"/docs/explain-plan-12","page_id":"/docs/explain-plan","tags":["multi-page"],"type":"text","url":"/docs/explain-plan#explain-plan-overview","content":"Use an EXPLAIN plan to check how a query will run, and consider rewriting queries to meet the following goals:"},"414":{"id":"/docs/explain-plan-13","page_id":"/docs/explain-plan","tags":["multi-page"],"type":"text","url":"/docs/explain-plan#explain-plan-overview","content":"Emphasize operations on the server rather than the client. Server operations are distributed across the cluster and operate in parallel, while client operations execute within the single client JDBC driver."},"415":{"id":"/docs/explain-plan-14","page_id":"/docs/explain-plan","tags":["multi-page"],"type":"text","url":"/docs/explain-plan#explain-plan-overview","content":"Use RANGE SCAN or SKIP SCAN whenever possible rather than TABLE SCAN."},"416":{"id":"/docs/explain-plan-15","page_id":"/docs/explain-plan","tags":["multi-page"],"type":"text","url":"/docs/explain-plan#explain-plan-overview","content":"Filter against leading columns in the primary key constraint. This assumes you have designed the primary key to lead with frequently-accessed or frequently-filtered columns as described in “Primary Keys,” above."},"417":{"id":"/docs/explain-plan-16","page_id":"/docs/explain-plan","tags":["multi-page"],"type":"text","url":"/docs/explain-plan#explain-plan-overview","content":"If necessary, introduce a local index or a global index that covers your query."},"418":{"id":"/docs/explain-plan-17","page_id":"/docs/explain-plan","tags":["multi-page"],"type":"text","url":"/docs/explain-plan#explain-plan-overview","content":"If you have an index that covers your query but the optimizer is not detecting it, try hinting the query:\nSELECT /*+ INDEX() */ …"},"419":{"id":"/docs/explain-plan-18","page_id":"/docs/explain-plan","tags":["multi-page"],"type":"text","url":"/docs/explain-plan#explain-plan-overview","content":"See also: SQL Language Reference - EXPLAIN"},"420":{"id":"/docs/explain-plan-19","page_id":"/docs/explain-plan","tags":["multi-page"],"type":"text","url":"/docs/explain-plan#anatomy-of-an-explain-plan","content":"An explain plan consists of lines of text that describe operations that Phoenix will perform during a query, using the following terms:"},"421":{"id":"/docs/explain-plan-20","page_id":"/docs/explain-plan","tags":["multi-page"],"type":"text","url":"/docs/explain-plan#anatomy-of-an-explain-plan","content":"AGGREGATE INTO ORDERED DISTINCT ROWS — aggregates the returned rows using an operation such as addition. When ORDERED is used, the GROUP BY operation is applied to the leading part of the primary key constraint, which allows the aggregation to be done in place rather than keeping all distinct groups in memory on the server side."},"422":{"id":"/docs/explain-plan-21","page_id":"/docs/explain-plan","tags":["multi-page"],"type":"text","url":"/docs/explain-plan#anatomy-of-an-explain-plan","content":"AGGREGATE INTO SINGLE ROW — aggregates the results into a single row using an aggregate function with no GROUP BY clause. For example, the count() statement returns one row with the total number of rows that match the query."},"423":{"id":"/docs/explain-plan-22","page_id":"/docs/explain-plan","tags":["multi-page"],"type":"text","url":"/docs/explain-plan#anatomy-of-an-explain-plan","content":"CLIENT — the operation will be performed on the client side. It's faster to perform most operations on the server side, so you should consider whether there's a way to rewrite the query to give the server more of the work to do."},"424":{"id":"/docs/explain-plan-23","page_id":"/docs/explain-plan","tags":["multi-page"],"type":"text","url":"/docs/explain-plan#anatomy-of-an-explain-plan","content":"FILTER BY expression—returns only results that match the expression."},"425":{"id":"/docs/explain-plan-24","page_id":"/docs/explain-plan","tags":["multi-page"],"type":"text","url":"/docs/explain-plan#anatomy-of-an-explain-plan","content":"FULL SCAN OVER tableName—the operation will scan every row in the specified table."},"426":{"id":"/docs/explain-plan-25","page_id":"/docs/explain-plan","tags":["multi-page"],"type":"text","url":"/docs/explain-plan#anatomy-of-an-explain-plan","content":"INNER-JOIN — the operation will join multiple tables on rows where the join condition is met."},"427":{"id":"/docs/explain-plan-26","page_id":"/docs/explain-plan","tags":["multi-page"],"type":"text","url":"/docs/explain-plan#anatomy-of-an-explain-plan","content":"MERGE SORT — performs a merge sort on the results."},"428":{"id":"/docs/explain-plan-27","page_id":"/docs/explain-plan","tags":["multi-page"],"type":"text","url":"/docs/explain-plan#anatomy-of-an-explain-plan","content":"RANGE SCAN OVER tableName [ ... ] — The information in the square brackets indicates the start and stop for each primary key that's used in the query."},"429":{"id":"/docs/explain-plan-28","page_id":"/docs/explain-plan","tags":["multi-page"],"type":"text","url":"/docs/explain-plan#anatomy-of-an-explain-plan","content":"ROUND ROBIN — when the query doesn't contain ORDER BY and therefore the rows can be returned in any order, ROUND ROBIN order maximizes parallelization on the client side."},"430":{"id":"/docs/explain-plan-29","page_id":"/docs/explain-plan","tags":["multi-page"],"type":"text","url":"/docs/explain-plan#anatomy-of-an-explain-plan","content":"<x>-CHUNK — describes how many threads will be used for the operation. The maximum parallelism is limited to the number of threads in the thread pool. The minimum parallelization corresponds to the number of regions the table has between the start and stop rows of the scan. The number of chunks will increase with a lower guidepost width, as there is more than one chunk per region."},"431":{"id":"/docs/explain-plan-30","page_id":"/docs/explain-plan","tags":["multi-page"],"type":"text","url":"/docs/explain-plan#anatomy-of-an-explain-plan","content":"PARALLEL <x>-WAY — describes how many parallel scans will be merge sorted during the operation."},"432":{"id":"/docs/explain-plan-31","page_id":"/docs/explain-plan","tags":["multi-page"],"type":"text","url":"/docs/explain-plan#anatomy-of-an-explain-plan","content":"SERIAL — some queries run serially. For example, a single row lookup or a query that filters on the leading part of the primary key and limits the results below a configurable threshold."},"433":{"id":"/docs/explain-plan-32","page_id":"/docs/explain-plan","tags":["multi-page"],"type":"text","url":"/docs/explain-plan#anatomy-of-an-explain-plan","content":"EST_BYTES_READ - provides an estimate of the total number of bytes that will be scanned as part of executing the query."},"434":{"id":"/docs/explain-plan-33","page_id":"/docs/explain-plan","tags":["multi-page"],"type":"text","url":"/docs/explain-plan#anatomy-of-an-explain-plan","content":"EST_ROWS_READ - provides an estimate of the total number of rows that will be scanned as part of executing the query."},"435":{"id":"/docs/explain-plan-34","page_id":"/docs/explain-plan","tags":["multi-page"],"type":"text","url":"/docs/explain-plan#anatomy-of-an-explain-plan","content":"EST_INFO_TS - epoch time in milliseconds at which the estimate information was collected."},"436":{"id":"/docs/explain-plan-35","page_id":"/docs/explain-plan","tags":["multi-page"],"type":"text","url":"/docs/explain-plan#jdbc-explain-plan-api-and-estimates","content":"The information displayed in the explain plan API can also be accessed programmatically through the standard JDBC interfaces. When statistics collection\nis enabled for a table, the explain plan also gives an estimate of number of rows and bytes a query is going to scan. To get hold of the info, you can\nuse corresponding columns in the result set returned by the explain plan statement. When stats collection is not enabled or if for some reason\nPhoenix cannot provide the estimate information, the columns return null. Below is an example:"},"437":{"id":"/docs/faq","page_id":"/docs/faq","type":"page","content":"FAQ","breadcrumbs":["Docs","Multi-Page Documentation","Getting Started"],"tags":["multi-page"],"url":"/docs/faq"},"438":{"id":"/docs/faq-0","page_id":"/docs/faq","tags":["multi-page"],"type":"text","url":"/docs/faq","content":"Frequently asked question abo