formance-testing#csv-results","content":"CSV results"},"2448":{"id":"/docs/fundamentals/performance-testing-13","page_id":"/docs/fundamentals/performance-testing","type":"heading","tags":["multi-page"],"url":"/docs/fundamentals/performance-testing#testing","content":"Testing"},"2449":{"id":"/docs/fundamentals/performance-testing-14","page_id":"/docs/fundamentals/performance-testing","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance-testing#performance-testing-overview","content":"Pherf is a standalone tool for performance and functional testing through Phoenix. Pherf can be used both to generate highly customized datasets and to measure SQL performance against that data."},"2450":{"id":"/docs/fundamentals/performance-testing-15","page_id":"/docs/fundamentals/performance-testing","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance-testing#running","content":"Edit config/env.sh to include the required property values."},"2451":{"id":"/docs/fundamentals/performance-testing-16","page_id":"/docs/fundamentals/performance-testing","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance-testing#running","content":"bin/pherf-standalone.py -h"},"2452":{"id":"/docs/fundamentals/performance-testing-17","page_id":"/docs/fundamentals/performance-testing","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance-testing#running","content":"Example: bin/pherf-standalone.py -drop all -l -q -z [zookeeper] -schemaFile .*user_defined_schema.sql -scenarioFile .*user_defined_scenario.xml"},"2453":{"id":"/docs/fundamentals/performance-testing-18","page_id":"/docs/fundamentals/performance-testing","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance-testing#pherf-arguments","content":"-h Help"},"2454":{"id":"/docs/fundamentals/performance-testing-19","page_id":"/docs/fundamentals/performance-testing","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance-testing#pherf-arguments","content":"-l Apply schema and load data"},"2455":{"id":"/docs/fundamentals/performance-testing-20","page_id":"/docs/fundamentals/performance-testing","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance-testing#pherf-arguments","content":"-q Executes multi-threaded query sets and writes results"},"2456":{"id":"/docs/fundamentals/performance-testing-21","page_id":"/docs/fundamentals/performance-testing","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance-testing#pherf-arguments","content":"-z [quorum] ZooKeeper quorum"},"2457":{"id":"/docs/fundamentals/performance-testing-22","page_id":"/docs/fundamentals/performance-testing","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance-testing#pherf-arguments","content":"-m Enable monitor for statistics"},"2458":{"id":"/docs/fundamentals/performance-testing-23","page_id":"/docs/fundamentals/performance-testing","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance-testing#pherf-arguments","content":"-monitorFrequency [frequency in ms] Frequency at which the monitor will snapshot stats to log file"},"2459":{"id":"/docs/fundamentals/performance-testing-24","page_id":"/docs/fundamentals/performance-testing","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance-testing#pherf-arguments","content":"-drop [pattern] Regex drop all tables with schema name as PHERF. Example drop Event tables: -drop .*(EVENT).*. Drop all: -drop .* or -drop all"},"2460":{"id":"/docs/fundamentals/performance-testing-25","page_id":"/docs/fundamentals/performance-testing","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance-testing#pherf-arguments","content":"-scenarioFile Regex or file name of a specific scenario file to run"},"2461":{"id":"/docs/fundamentals/performance-testing-26","page_id":"/docs/fundamentals/performance-testing","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance-testing#pherf-arguments","content":"-schemaFile Regex or file name of a specific schema file to run"},"2462":{"id":"/docs/fundamentals/performance-testing-27","page_id":"/docs/fundamentals/performance-testing","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance-testing#pherf-arguments","content":"-export Exports query results to CSV files in CSV_EXPORT directory"},"2463":{"id":"/docs/fundamentals/performance-testing-28","page_id":"/docs/fundamentals/performance-testing","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance-testing#pherf-arguments","content":"-diff Compares results with previously exported results"},"2464":{"id":"/docs/fundamentals/performance-testing-29","page_id":"/docs/fundamentals/performance-testing","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance-testing#pherf-arguments","content":"-hint Executes all queries with specified hint. Example: SMALL"},"2465":{"id":"/docs/fundamentals/performance-testing-30","page_id":"/docs/fundamentals/performance-testing","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance-testing#pherf-arguments","content":"-rowCountOverride"},"2466":{"id":"/docs/fundamentals/performance-testing-31","page_id":"/docs/fundamentals/performance-testing","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance-testing#pherf-arguments","content":"-rowCountOverride [number of rows] Specify number of rows to be upserted rather than using row count specified in schema"},"2467":{"id":"/docs/fundamentals/performance-testing-32","page_id":"/docs/fundamentals/performance-testing","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance-testing#adding-rules-for-data-creation","content":"Review test_scenario.xml\nfor syntax examples."},"2468":{"id":"/docs/fundamentals/performance-testing-33","page_id":"/docs/fundamentals/performance-testing","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance-testing#adding-rules-for-data-creation","content":"Rules are defined as <columns /> and are applied in the order they appear in file."},"2469":{"id":"/docs/fundamentals/performance-testing-34","page_id":"/docs/fundamentals/performance-testing","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance-testing#adding-rules-for-data-creation","content":"Rules of the same type override the values of a prior rule of the same type. If <userDefined>true</userDefined> is\nset, rule will only\napply override when type and name match the column name in Phoenix."},"2470":{"id":"/docs/fundamentals/performance-testing-35","page_id":"/docs/fundamentals/performance-testing","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance-testing#adding-rules-for-data-creation","content":"<prefix> tag is set at the column level. It can be used to define a constant string appended to the beginning of\nCHAR and VARCHAR data type values."},"2471":{"id":"/docs/fundamentals/performance-testing-36","page_id":"/docs/fundamentals/performance-testing","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance-testing#adding-rules-for-data-creation","content":"Required field Supported Phoenix types: VARCHAR, CHAR, DATE, DECIMAL, INTEGER"},"2472":{"id":"/docs/fundamentals/performance-testing-37","page_id":"/docs/fundamentals/performance-testing","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance-testing#adding-rules-for-data-creation","content":"denoted by the <type> tag"},"2473":{"id":"/docs/fundamentals/performance-testing-38","page_id":"/docs/fundamentals/performance-testing","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance-testing#adding-rules-for-data-creation","content":"User defined true changes rule matching to use both name and type fields to determine equivalence."},"2474":{"id":"/docs/fundamentals/performance-testing-39","page_id":"/docs/fundamentals/performance-testing","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance-testing#adding-rules-for-data-creation","content":"Default is false if not specified and equivalence will be determined by type only. An important note here is that you can still override rules without the user defined flag, but they will change the rule globally and not just for a specified column."},"2475":{"id":"/docs/fundamentals/performance-testing-40","page_id":"/docs/fundamentals/performance-testing","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance-testing#adding-rules-for-data-creation","content":"Required field Supported Data Sequences"},"2476":{"id":"/docs/fundamentals/performance-testing-41","page_id":"/docs/fundamentals/performance-testing","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance-testing#adding-rules-for-data-creation","content":"RANDOM: Random value which can be bound by other fields such as length."},"2477":{"id":"/docs/fundamentals/performance-testing-42","page_id":"/docs/fundamentals/performance-testing","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance-testing#adding-rules-for-data-creation","content":"SEQUENTIAL: Monotonically increasing long prepended to random strings."},"2478":{"id":"/docs/fundamentals/performance-testing-43","page_id":"/docs/fundamentals/performance-testing","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance-testing#adding-rules-for-data-creation","content":"Only supported on VARCHAR and CHAR types"},"2479":{"id":"/docs/fundamentals/performance-testing-44","page_id":"/docs/fundamentals/performance-testing","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance-testing#adding-rules-for-data-creation","content":"LIST: Means pick values from predefined list of values"},"2480":{"id":"/docs/fundamentals/performance-testing-45","page_id":"/docs/fundamentals/performance-testing","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance-testing#adding-rules-for-data-creation","content":"Required field Length defines boundary for random values for CHAR and VARCHAR types."},"2481":{"id":"/docs/fundamentals/performance-testing-46","page_id":"/docs/fundamentals/performance-testing","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance-testing#adding-rules-for-data-creation","content":"denoted by the <length> tag"},"2482":{"id":"/docs/fundamentals/performance-testing-47","page_id":"/docs/fundamentals/performance-testing","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance-testing#adding-rules-for-data-creation","content":"Column level Min/Max value defines boundaries for numerical values. For DATEs, these values supply a range between\nwhich values are generated. At the column level the granularity is a year. At a specific data value level, the\ngranularity is down to the Ms."},"2483":{"id":"/docs/fundamentals/performance-testing-48","page_id":"/docs/fundamentals/performance-testing","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance-testing#adding-rules-for-data-creation","content":"denoted by the <minValue> tag"},"2484":{"id":"/docs/fundamentals/performance-testing-49","page_id":"/docs/fundamentals/performance-testing","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance-testing#adding-rules-for-data-creation","content":"denoted by the <maxValue> tag"},"2485":{"id":"/docs/fundamentals/performance-testing-50","page_id":"/docs/fundamentals/performance-testing","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance-testing#adding-rules-for-data-creation","content":"Null chance denotes the probability of generating a null value. From [0-100]. The higher the number, the more likely\nthe value will be null. Denoted by <nullChance>."},"2486":{"id":"/docs/fundamentals/performance-testing-51","page_id":"/docs/fundamentals/performance-testing","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance-testing#adding-rules-for-data-creation","content":"Name can either be any text or the actual column name in the Phoenix table."},"2487":{"id":"/docs/fundamentals/performance-testing-52","page_id":"/docs/fundamentals/performance-testing","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance-testing#adding-rules-for-data-creation","content":"denoted by the <name> tag"},"2488":{"id":"/docs/fundamentals/performance-testing-53","page_id":"/docs/fundamentals/performance-testing","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance-testing#adding-rules-for-data-creation","content":"Value List is used in conjunction with LIST data sequences. Each entry is a DataValue with a specified value to be\nused when generating data."},"2489":{"id":"/docs/fundamentals/performance-testing-54","page_id":"/docs/fundamentals/performance-testing","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance-testing#adding-rules-for-data-creation","content":"Denoted by the <valueList><datavalue><value/></datavalue></valueList> tags"},"2490":{"id":"/docs/fundamentals/performance-testing-55","page_id":"/docs/fundamentals/performance-testing","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance-testing#adding-rules-for-data-creation","content":"If the distribution attribute on the datavalue is set, values will be created according to\nthat probability."},"2491":{"id":"/docs/fundamentals/performance-testing-56","page_id":"/docs/fundamentals/performance-testing","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance-testing#adding-rules-for-data-creation","content":"When distribution is used, values must add up to 100%."},"2492":{"id":"/docs/fundamentals/performance-testing-57","page_id":"/docs/fundamentals/performance-testing","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance-testing#adding-rules-for-data-creation","content":"If distribution is not used, values will be randomly picked from the list with equal distribution."},"2493":{"id":"/docs/fundamentals/performance-testing-58","page_id":"/docs/fundamentals/performance-testing","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance-testing#defining-scenario","content":"A scenario can have multiple querySets. Consider the following example: concurrency of 1-4 means that each query will be\nexecuted starting with concurrency level of 1 and reach up to maximum concurrency of 4. Per thread, query would be\nexecuted to a minimum of 10 times or 10 seconds (whichever comes first). QuerySet by default is executed serially but you\ncan change executionType to PARALLEL so queries are executed concurrently. Each Query may have an optional timeoutDuration\nfield that defines the amount of time (in milliseconds) before execution for that Query is cancelled. Scenarios are defined\nin XML files stored in the resource directory."},"2494":{"id":"/docs/fundamentals/performance-testing-59","page_id":"/docs/fundamentals/performance-testing","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance-testing#results","content":"Results are written real time in results directory. Open the result that is saved in .jpg format for real time\nvisualization. Results are written using DataModelResult objects, which are modified over the course of each Pherf\nrun."},"2495":{"id":"/docs/fundamentals/performance-testing-60","page_id":"/docs/fundamentals/performance-testing","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance-testing#xml-results","content":"Pherf XML results have a similar format to the corresponding scenario.xml file used for the Pherf run, but also include\nadditional information, such as the execution time of queries, whether queries timed out, and result row count."},"2496":{"id":"/docs/fundamentals/performance-testing-61","page_id":"/docs/fundamentals/performance-testing","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance-testing#csv-results","content":"Each row in a CSV result file represents a single execution of a query and provides details about a query execution's\nruntime, timeout status, result row count, and more. The header file format can be found in Header.java."},"2497":{"id":"/docs/fundamentals/performance-testing-62","page_id":"/docs/fundamentals/performance-testing","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance-testing#testing","content":"Default quorum is localhost. If you want to override set the system variable."},"2498":{"id":"/docs/fundamentals/performance-testing-63","page_id":"/docs/fundamentals/performance-testing","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance-testing#testing","content":"Run unit tests: mvn test -DZK_QUORUM=localhostRun a specific method: mvn -Dtest=ClassName#methodName test"},"2499":{"id":"/docs/fundamentals/performance-testing-64","page_id":"/docs/fundamentals/performance-testing","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance-testing#testing","content":"More to come..."},"2500":{"id":"/docs/fundamentals/performance","page_id":"/docs/fundamentals/performance","type":"page","content":"Performance","breadcrumbs":["Docs","Multi-Page Documentation","Development","Fundamentals"],"tags":["multi-page"],"url":"/docs/fundamentals/performance"},"2501":{"id":"/docs/fundamentals/performance-0","page_id":"/docs/fundamentals/performance","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance","content":"Historical Phoenix performance comparisons and feature-level improvements for scans, salting, and query execution."},"2502":{"id":"/docs/fundamentals/performance-1","page_id":"/docs/fundamentals/performance","type":"heading","tags":["multi-page"],"url":"/docs/fundamentals/performance#phoenix-vs-related-products","content":"Phoenix vs related products"},"2503":{"id":"/docs/fundamentals/performance-2","page_id":"/docs/fundamentals/performance","type":"heading","tags":["multi-page"],"url":"/docs/fundamentals/performance#phoenix-vs-hive-running-over-hdfs-and-hbase","content":"Phoenix vs Hive (running over HDFS and HBase)"},"2504":{"id":"/docs/fundamentals/performance-3","page_id":"/docs/fundamentals/performance","type":"heading","tags":["multi-page"],"url":"/docs/fundamentals/performance#phoenix-vs-impala-running-over-hbase","content":"Phoenix vs Impala (running over HBase)"},"2505":{"id":"/docs/fundamentals/performance-4","page_id":"/docs/fundamentals/performance","type":"heading","tags":["multi-page"],"url":"/docs/fundamentals/performance#latest-automated-performance-run","content":"Latest Automated Performance Run"},"2506":{"id":"/docs/fundamentals/performance-5","page_id":"/docs/fundamentals/performance","type":"heading","tags":["multi-page"],"url":"/docs/fundamentals/performance#performance-improvements-in-phoenix-12","content":"Performance improvements in Phoenix 1.2"},"2507":{"id":"/docs/fundamentals/performance-6","page_id":"/docs/fundamentals/performance","type":"heading","tags":["multi-page"],"url":"/docs/fundamentals/performance#essential-column-family","content":"Essential Column Family"},"2508":{"id":"/docs/fundamentals/performance-7","page_id":"/docs/fundamentals/performance","type":"heading","tags":["multi-page"],"url":"/docs/fundamentals/performance#performance-skip-scan","content":"Skip Scan"},"2509":{"id":"/docs/fundamentals/performance-8","page_id":"/docs/fundamentals/performance","type":"heading","tags":["multi-page"],"url":"/docs/fundamentals/performance#performance-salting","content":"Salting"},"2510":{"id":"/docs/fundamentals/performance-9","page_id":"/docs/fundamentals/performance","type":"heading","tags":["multi-page"],"url":"/docs/fundamentals/performance#top-n","content":"Top-N"},"2511":{"id":"/docs/fundamentals/performance-10","page_id":"/docs/fundamentals/performance","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance","content":"type: warning"},"2512":{"id":"/docs/fundamentals/performance-11","page_id":"/docs/fundamentals/performance","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance","content":"This page has not been updated recently and may not reflect the current state\nof the project."},"2513":{"id":"/docs/fundamentals/performance-12","page_id":"/docs/fundamentals/performance","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance","content":"Phoenix follows the philosophy of bringing the computation to the data by using:"},"2514":{"id":"/docs/fundamentals/performance-13","page_id":"/docs/fundamentals/performance","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance","content":"coprocessors to perform operations on the server-side thus minimizing client/server data transfer"},"2515":{"id":"/docs/fundamentals/performance-14","page_id":"/docs/fundamentals/performance","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance","content":"custom filters to prune data as close to the source as possible."},"2516":{"id":"/docs/fundamentals/performance-15","page_id":"/docs/fundamentals/performance","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance","content":"In addition, to minimize startup costs, Phoenix uses native HBase APIs rather than going through the MapReduce framework."},"2517":{"id":"/docs/fundamentals/performance-16","page_id":"/docs/fundamentals/performance","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance#phoenix-vs-related-products","content":"Below are charts showing relative performance between Phoenix and some other related products."},"2518":{"id":"/docs/fundamentals/performance-17","page_id":"/docs/fundamentals/performance","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance#phoenix-vs-hive-running-over-hdfs-and-hbase","content":"Query: SELECT COUNT(1) from a table over 10M and 100M rows. Data has 5 narrow columns. Number of region\nservers: 4 (HBase heap: 10GB, processor: 6 cores @ 3.3GHz Xeon)."},"2519":{"id":"/docs/fundamentals/performance-18","page_id":"/docs/fundamentals/performance","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance#phoenix-vs-impala-running-over-hbase","content":"Query: SELECT COUNT(1) from a table over 1M and 5M rows. Data has 3 narrow columns. Number of region servers: 1 (virtual machine, HBase heap: 2GB, processor: 2 cores @ 3.3GHz Xeon)."},"2520":{"id":"/docs/fundamentals/performance-19","page_id":"/docs/fundamentals/performance","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance#latest-automated-performance-run","content":"Latest Automated Performance Run |\nAutomated Performance Runs History"},"2521":{"id":"/docs/fundamentals/performance-20","page_id":"/docs/fundamentals/performance","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance#essential-column-family","content":"The Phoenix 1.2 query filter leverages the HBase Filter Essential Column Family feature. This improves performance when Phoenix filters data split across multiple column families (CFs) by loading only essential CFs first. In a second pass, all CFs are loaded as needed."},"2522":{"id":"/docs/fundamentals/performance-21","page_id":"/docs/fundamentals/performance","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance#essential-column-family","content":"Consider the following schema in which data is split into two CFs:\nCREATE TABLE t (k VARCHAR NOT NULL PRIMARY KEY, a.c1 INTEGER, b.c2 VARCHAR, b.c3 VARCHAR, b.c4 VARCHAR)."},"2523":{"id":"/docs/fundamentals/performance-22","page_id":"/docs/fundamentals/performance","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance#essential-column-family","content":"Running a query similar to the following shows significant performance gains when a subset of rows matches the filter:\nSELECT COUNT(c2) FROM t WHERE c1 = ?"},"2524":{"id":"/docs/fundamentals/performance-23","page_id":"/docs/fundamentals/performance","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance#essential-column-family","content":"The following chart shows in-memory query performance for the query above with 10M rows on 4 region servers, when 10% of rows match the filter. Note: cf-a is approximately 8 bytes and cf-b is approximately 400 bytes wide."},"2525":{"id":"/docs/fundamentals/performance-24","page_id":"/docs/fundamentals/performance","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance#performance-skip-scan","content":"Skip Scan Filter leverages HBase filter SEEK_NEXT_USING_HINT (docs). It significantly improves point queries over key columns."},"2526":{"id":"/docs/fundamentals/performance-25","page_id":"/docs/fundamentals/performance","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance#performance-skip-scan","content":"Consider the following schema in which data is split into two CFs:\nCREATE TABLE t (k VARCHAR NOT NULL PRIMARY KEY, a.c1 INTEGER, b.c2 VARCHAR, b.c3 VARCHAR)."},"2527":{"id":"/docs/fundamentals/performance-26","page_id":"/docs/fundamentals/performance","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance#performance-skip-scan","content":"Running a query similar to the following shows significant performance gains when a subset of rows matches the filter:\nSELECT COUNT(c1) FROM t WHERE k IN (1% random k's)"},"2528":{"id":"/docs/fundamentals/performance-27","page_id":"/docs/fundamentals/performance","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance#performance-skip-scan","content":"The following chart shows in-memory query performance of the query above with 10M rows on 4 region servers when 1% random keys over the full key range are passed in the IN clause. Note: all VARCHAR columns are approximately 15 bytes."},"2529":{"id":"/docs/fundamentals/performance-28","page_id":"/docs/fundamentals/performance","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance#performance-salting","content":"Salting in Phoenix 1.2 improves both read and write performance by adding an extra hash byte at the start of the key and pre-splitting data into regions. This reduces hotspotting on one or a few region servers. Read more about this feature here."},"2530":{"id":"/docs/fundamentals/performance-29","page_id":"/docs/fundamentals/performance","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance#performance-salting","content":"Consider the following schema:"},"2531":{"id":"/docs/fundamentals/performance-30","page_id":"/docs/fundamentals/performance","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance#performance-salting","content":"CREATE TABLE T (HOST CHAR(2) NOT NULL,DOMAIN VARCHAR NOT NULL,\nFEATURE VARCHAR NOT NULL,DATE DATE NOT NULL,USAGE.CORE BIGINT,USAGE.DB BIGINT,STATS.ACTIVE_VISITOR\nINTEGER CONSTRAINT PK PRIMARY KEY (HOST, DOMAIN, FEATURE, DATE)) SALT_BUCKETS = 4."},"2532":{"id":"/docs/fundamentals/performance-31","page_id":"/docs/fundamentals/performance","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance#performance-salting","content":"The following chart shows write performance with and without salting, where the table is split into 4 regions on a 4-region-server cluster (note: for optimal performance, salt bucket count should match region server count)."},"2533":{"id":"/docs/fundamentals/performance-32","page_id":"/docs/fundamentals/performance","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance#performance-salting","content":"The following chart shows in-memory query performance for a 10M-row table where host='NA' matches 3.3M rows."},"2534":{"id":"/docs/fundamentals/performance-33","page_id":"/docs/fundamentals/performance","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance#performance-salting","content":"select count(1) from t where host='NA'"},"2535":{"id":"/docs/fundamentals/performance-34","page_id":"/docs/fundamentals/performance","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance#top-n","content":"The following chart shows in-memory query time for a Top-N query over 10M rows using Phoenix 1.2 and Hive over HBase."},"2536":{"id":"/docs/fundamentals/performance-35","page_id":"/docs/fundamentals/performance","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/performance#top-n","content":"select core from t order by core desc limit 10"},"2537":{"id":"/docs/fundamentals/tuning-guide","page_id":"/docs/fundamentals/tuning-guide","type":"page","content":"Tuning Guide","breadcrumbs":["Docs","Multi-Page Documentation","Development","Fundamentals"],"tags":["multi-page"],"url":"/docs/fundamentals/tuning-guide"},"2538":{"id":"/docs/fundamentals/tuning-guide-0","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide","content":"Best practices for tuning Phoenix schema, indexes, queries, and write paths for read/write performance."},"2539":{"id":"/docs/fundamentals/tuning-guide-1","page_id":"/docs/fundamentals/tuning-guide","type":"heading","tags":["multi-page"],"url":"/docs/fundamentals/tuning-guide#primary-keys","content":"Primary Keys"},"2540":{"id":"/docs/fundamentals/tuning-guide-2","page_id":"/docs/fundamentals/tuning-guide","type":"heading","tags":["multi-page"],"url":"/docs/fundamentals/tuning-guide#monotonically-increasing-primary-keys","content":"Monotonically increasing Primary keys"},"2541":{"id":"/docs/fundamentals/tuning-guide-3","page_id":"/docs/fundamentals/tuning-guide","type":"heading","tags":["multi-page"],"url":"/docs/fundamentals/tuning-guide#general-tips","content":"General Tips"},"2542":{"id":"/docs/fundamentals/tuning-guide-4","page_id":"/docs/fundamentals/tuning-guide","type":"heading","tags":["multi-page"],"url":"/docs/fundamentals/tuning-guide#is-the-data-random-access","content":"Is the Data Random-Access?"},"2543":{"id":"/docs/fundamentals/tuning-guide-5","page_id":"/docs/fundamentals/tuning-guide","type":"heading","tags":["multi-page"],"url":"/docs/fundamentals/tuning-guide#is-the-data-read-heavy-or-write-heavy","content":"Is the data read-heavy or write-heavy?"},"2544":{"id":"/docs/fundamentals/tuning-guide-6","page_id":"/docs/fundamentals/tuning-guide","type":"heading","tags":["multi-page"],"url":"/docs/fundamentals/tuning-guide#which-columns-will-be-accessed-often","content":"Which columns will be accessed often?"},"2545":{"id":"/docs/fundamentals/tuning-guide-7","page_id":"/docs/fundamentals/tuning-guide","type":"heading","tags":["multi-page"],"url":"/docs/fundamentals/tuning-guide#can-the-data-be-append-only-immutable","content":"Can the data be append-only (immutable)?"},"2546":{"id":"/docs/fundamentals/tuning-guide-8","page_id":"/docs/fundamentals/tuning-guide","type":"heading","tags":["multi-page"],"url":"/docs/fundamentals/tuning-guide#is-the-table-very-large","content":"Is the table very large?"},"2547":{"id":"/docs/fundamentals/tuning-guide-9","page_id":"/docs/fundamentals/tuning-guide","type":"heading","tags":["multi-page"],"url":"/docs/fundamentals/tuning-guide#is-transactionality-required","content":"Is transactionality required?"},"2548":{"id":"/docs/fundamentals/tuning-guide-10","page_id":"/docs/fundamentals/tuning-guide","type":"heading","tags":["multi-page"],"url":"/docs/fundamentals/tuning-guide#block-encoding","content":"Block Encoding"},"2549":{"id":"/docs/fundamentals/tuning-guide-11","page_id":"/docs/fundamentals/tuning-guide","type":"heading","tags":["multi-page"],"url":"/docs/fundamentals/tuning-guide#schema-design","content":"Schema Design"},"2550":{"id":"/docs/fundamentals/tuning-guide-12","page_id":"/docs/fundamentals/tuning-guide","type":"heading","tags":["multi-page"],"url":"/docs/fundamentals/tuning-guide#phoenix-and-the-hbase-data-model","content":"Phoenix and the HBase data model"},"2551":{"id":"/docs/fundamentals/tuning-guide-13","page_id":"/docs/fundamentals/tuning-guide","type":"heading","tags":["multi-page"],"url":"/docs/fundamentals/tuning-guide#column-families","content":"Column Families"},"2552":{"id":"/docs/fundamentals/tuning-guide-14","page_id":"/docs/fundamentals/tuning-guide","type":"heading","tags":["multi-page"],"url":"/docs/fundamentals/tuning-guide#columns","content":"Columns"},"2553":{"id":"/docs/fundamentals/tuning-guide-15","page_id":"/docs/fundamentals/tuning-guide","type":"heading","tags":["multi-page"],"url":"/docs/fundamentals/tuning-guide#indexes","content":"Indexes"},"2554":{"id":"/docs/fundamentals/tuning-guide-16","page_id":"/docs/fundamentals/tuning-guide","type":"heading","tags":["multi-page"],"url":"/docs/fundamentals/tuning-guide#tuning-guide-secondary-indexes","content":"Secondary indexes"},"2555":{"id":"/docs/fundamentals/tuning-guide-17","page_id":"/docs/fundamentals/tuning-guide","type":"heading","tags":["multi-page"],"url":"/docs/fundamentals/tuning-guide#queries","content":"Queries"},"2556":{"id":"/docs/fundamentals/tuning-guide-18","page_id":"/docs/fundamentals/tuning-guide","type":"heading","tags":["multi-page"],"url":"/docs/fundamentals/tuning-guide#reading","content":"Reading"},"2557":{"id":"/docs/fundamentals/tuning-guide-19","page_id":"/docs/fundamentals/tuning-guide","type":"heading","tags":["multi-page"],"url":"/docs/fundamentals/tuning-guide#range-queries","content":"Range Queries"},"2558":{"id":"/docs/fundamentals/tuning-guide-20","page_id":"/docs/fundamentals/tuning-guide","type":"heading","tags":["multi-page"],"url":"/docs/fundamentals/tuning-guide#large-range-queries","content":"Large Range Queries"},"2559":{"id":"/docs/fundamentals/tuning-guide-21","page_id":"/docs/fundamentals/tuning-guide","type":"heading","tags":["multi-page"],"url":"/docs/fundamentals/tuning-guide#point-lookups","content":"Point Lookups"},"2560":{"id":"/docs/fundamentals/tuning-guide-22","page_id":"/docs/fundamentals/tuning-guide","type":"heading","tags":["multi-page"],"url":"/docs/fundamentals/tuning-guide#hints","content":"Hints"},"2561":{"id":"/docs/fundamentals/tuning-guide-23","page_id":"/docs/fundamentals/tuning-guide","type":"heading","tags":["multi-page"],"url":"/docs/fundamentals/tuning-guide#explain-plans","content":"Explain plans"},"2562":{"id":"/docs/fundamentals/tuning-guide-24","page_id":"/docs/fundamentals/tuning-guide","type":"heading","tags":["multi-page"],"url":"/docs/fundamentals/tuning-guide#tuning-guide-parallelization","content":"Parallelization"},"2563":{"id":"/docs/fundamentals/tuning-guide-25","page_id":"/docs/fundamentals/tuning-guide","type":"heading","tags":["multi-page"],"url":"/docs/fundamentals/tuning-guide#writing","content":"Writing"},"2564":{"id":"/docs/fundamentals/tuning-guide-26","page_id":"/docs/fundamentals/tuning-guide","type":"heading","tags":["multi-page"],"url":"/docs/fundamentals/tuning-guide#updating-data-with-upsert-values","content":"Updating data with UPSERT VALUES"},"2565":{"id":"/docs/fundamentals/tuning-guide-27","page_id":"/docs/fundamentals/tuning-guide","type":"heading","tags":["multi-page"],"url":"/docs/fundamentals/tuning-guide#updating-data-with-upsert-select","content":"Updating data with UPSERT SELECT"},"2566":{"id":"/docs/fundamentals/tuning-guide-28","page_id":"/docs/fundamentals/tuning-guide","type":"heading","tags":["multi-page"],"url":"/docs/fundamentals/tuning-guide#deleting-data","content":"Deleting data"},"2567":{"id":"/docs/fundamentals/tuning-guide-29","page_id":"/docs/fundamentals/tuning-guide","type":"heading","tags":["multi-page"],"url":"/docs/fundamentals/tuning-guide#reducing-rpc-traffic","content":"Reducing RPC traffic"},"2568":{"id":"/docs/fundamentals/tuning-guide-30","page_id":"/docs/fundamentals/tuning-guide","type":"heading","tags":["multi-page"],"url":"/docs/fundamentals/tuning-guide#using-local-indexes","content":"Using local indexes"},"2569":{"id":"/docs/fundamentals/tuning-guide-31","page_id":"/docs/fundamentals/tuning-guide","type":"heading","tags":["multi-page"],"url":"/docs/fundamentals/tuning-guide#further-tuning","content":"Further tuning"},"2570":{"id":"/docs/fundamentals/tuning-guide-32","page_id":"/docs/fundamentals/tuning-guide","type":"heading","tags":["multi-page"],"url":"/docs/fundamentals/tuning-guide#special-cases","content":"Special Cases"},"2571":{"id":"/docs/fundamentals/tuning-guide-33","page_id":"/docs/fundamentals/tuning-guide","type":"heading","tags":["multi-page"],"url":"/docs/fundamentals/tuning-guide#for-applications-where-failing-quickly-is-better-than-waiting","content":"For applications where failing quickly is better than waiting"},"2572":{"id":"/docs/fundamentals/tuning-guide-34","page_id":"/docs/fundamentals/tuning-guide","type":"heading","tags":["multi-page"],"url":"/docs/fundamentals/tuning-guide#for-applications-that-can-tolerate-slightly-out-of-date-information","content":"For applications that can tolerate slightly out of date information"},"2573":{"id":"/docs/fundamentals/tuning-guide-35","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide","content":"Tuning Phoenix can be complex, but with a little knowledge of how it works you can make significant improvements to read and write performance. The most important factor is schema design, especially how it affects underlying HBase row keys. See \"General Tips\" below for design guidance based on anticipated data access patterns. Subsequent sections describe how to use secondary indexes, hints, and explain plans."},"2574":{"id":"/docs/fundamentals/tuning-guide-36","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide","content":"Note: Phoenix and HBase work well when your application does point lookups and small range scans. This can be achieved by good primary key design (see below). If you find that your application requires many full table scans, then Phoenix and HBase are likely not the best tool for the job. Instead, look at using other tools that write to HDFS directly using columnar representations such as Parquet."},"2575":{"id":"/docs/fundamentals/tuning-guide-37","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#primary-keys","content":"The underlying row key design is the single most important factor in Phoenix performance, and it's important to get it right at design time because you cannot change it later without re-writing the data and index tables."},"2576":{"id":"/docs/fundamentals/tuning-guide-38","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#primary-keys","content":"The Phoenix primary keys are concatenated to create the underlying row key in Apache HBase. Choose and order primary key columns to align with common query patterns. The leading key column has the greatest performance impact. For example, if you lead with a column containing org IDs, it is easy to select all rows for a specific org. You can also add the HBase row timestamp to the primary key to improve scan efficiency by skipping rows outside the queried time range."},"2577":{"id":"/docs/fundamentals/tuning-guide-39","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#primary-keys","content":"Every primary key imposes a cost because the entire row key is appended to every piece of data in memory and on disk. The larger the row key, the greater the storage overhead. Find ways to store information compactly in columns you plan to use for primary keys — store deltas instead of complete time stamps, for example."},"2578":{"id":"/docs/fundamentals/tuning-guide-40","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#primary-keys","content":"To sum up, the best practice is to design primary keys to add up to a row key that lets you scan the smallest amount of data."},"2579":{"id":"/docs/fundamentals/tuning-guide-41","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#primary-keys","content":"Tip: When choosing primary keys, lead with the column you filter most frequently across the queries that are most important to optimize. If you use ORDER BY, make sure your PK columns match expressions in the ORDER BY clause."},"2580":{"id":"/docs/fundamentals/tuning-guide-42","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#monotonically-increasing-primary-keys","content":"If your primary keys are monotonically increasing, use salting to help distribute writes across the cluster and improve parallelization. Example:"},"2581":{"id":"/docs/fundamentals/tuning-guide-43","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#monotonically-increasing-primary-keys","content":"CREATE TABLE … ( … ) SALT_BUCKETS = N"},"2582":{"id":"/docs/fundamentals/tuning-guide-44","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#monotonically-increasing-primary-keys","content":"For optimal performance the number of salt buckets should approximately equal the number of region servers. Do not salt automatically. Use salting only when experiencing hotspotting. The downside of salting is that it imposes a cost on read because when you want to query the data you have to run multiple queries to do a range scan."},"2583":{"id":"/docs/fundamentals/tuning-guide-45","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#general-tips","content":"The following sections provide a few general tips for different access scenarios."},"2584":{"id":"/docs/fundamentals/tuning-guide-46","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#is-the-data-random-access","content":"As with any random read workloads, SSDs can improve performance because of their faster random seek time."},"2585":{"id":"/docs/fundamentals/tuning-guide-47","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#is-the-data-read-heavy-or-write-heavy","content":"For read-heavy data:"},"2586":{"id":"/docs/fundamentals/tuning-guide-48","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#is-the-data-read-heavy-or-write-heavy","content":"Create global indexes. This will affect write speed depending on the number of columns included in an index because each index writes to its own separate table."},"2587":{"id":"/docs/fundamentals/tuning-guide-49","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#is-the-data-read-heavy-or-write-heavy","content":"Use multiple indexes to provide fast access to common queries."},"2588":{"id":"/docs/fundamentals/tuning-guide-50","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#is-the-data-read-heavy-or-write-heavy","content":"When specifying machines for HBase, do not skimp on cores; HBase needs them."},"2589":{"id":"/docs/fundamentals/tuning-guide-51","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#is-the-data-read-heavy-or-write-heavy","content":"For write-heavy data:"},"2590":{"id":"/docs/fundamentals/tuning-guide-52","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#is-the-data-read-heavy-or-write-heavy","content":"Pre-split the table. It can be helpful to split the table into predefined regions, or if keys are monotonically increasing, use salting to avoid creating write hotspots on a small number of nodes. Use real data types rather than raw byte data."},"2591":{"id":"/docs/fundamentals/tuning-guide-53","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#is-the-data-read-heavy-or-write-heavy","content":"Create local indexes. Reads from local indexes have a performance penalty, so it's important to do performance testing. See the Pherf tool."},"2592":{"id":"/docs/fundamentals/tuning-guide-54","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#which-columns-will-be-accessed-often","content":"Choose commonly-queried columns as primary keys. For more information, see “Primary Keys” below."},"2593":{"id":"/docs/fundamentals/tuning-guide-55","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#which-columns-will-be-accessed-often","content":"Create additional indexes to support common query patterns, including heavily accessed fields that are not in the primary key."},"2594":{"id":"/docs/fundamentals/tuning-guide-56","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#can-the-data-be-append-only-immutable","content":"If the data is immutable or append-only, declare the table and its indexes as immutable using the IMMUTABLE_ROWS option at creation time to reduce the write-time cost. If you need to make an existing table immutable, you can do so with ALTER TABLE trans.event SET IMMUTABLE_ROWS=true after creation time."},"2595":{"id":"/docs/fundamentals/tuning-guide-57","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#can-the-data-be-append-only-immutable","content":"If speed is more important than data integrity, you can use the DISABLE_WAL option. Note: it is possible to lose data with DISABLE_WAL if a region server fails."},"2596":{"id":"/docs/fundamentals/tuning-guide-58","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#can-the-data-be-append-only-immutable","content":"Set the UPDATE_CACHE_FREQUENCY option to 15 minutes or so if your metadata doesn't change very often. This property determines how often an RPC is done to ensure you're seeing the latest schema."},"2597":{"id":"/docs/fundamentals/tuning-guide-59","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#can-the-data-be-append-only-immutable","content":"If the data is not sparse (over 50% of the cells have values), use the SINGLE_CELL_ARRAY_WITH_OFFSETS data encoding scheme introduced in Phoenix 4.10, which obtains faster performance by reducing the size of the data. For more information, see “Column Mapping and Immutable Data Encoding” on the Apache Phoenix blog."},"2598":{"id":"/docs/fundamentals/tuning-guide-60","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#is-the-table-very-large","content":"Use the ASYNC keyword with your CREATE INDEX call to create the index asynchronously via MapReduce job. You'll need to manually start the job; see Index Population for details."},"2599":{"id":"/docs/fundamentals/tuning-guide-61","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#is-the-table-very-large","content":"If the data is too large to scan the table completely, use primary keys to create an underlying composite row key that makes it easy to return a subset of the data or facilitates skip-scanning — Phoenix can jump directly to matching keys when the query includes key sets in the predicate."},"2600":{"id":"/docs/fundamentals/tuning-guide-62","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#is-transactionality-required","content":"A transaction is a data operation that is atomic — that is, guaranteed to succeed completely or not at all. For example, if you need to make cross-row updates to a data table, then you should consider your data transactional."},"2601":{"id":"/docs/fundamentals/tuning-guide-63","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#is-transactionality-required","content":"If you need transactionality, use the TRANSACTIONAL option. (See also Transactions)"},"2602":{"id":"/docs/fundamentals/tuning-guide-64","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#block-encoding","content":"Using compression or encoding is a must. Both SNAPPY and FAST_DIFF are good all around options."},"2603":{"id":"/docs/fundamentals/tuning-guide-65","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#block-encoding","content":"FAST_DIFF encoding is automatically enabled on all Phoenix tables by default, and almost always improves overall read latencies and throughput by allowing more data to fit into blockcache. Note: FAST_DIFF encoding can increase garbage produced during request processing."},"2604":{"id":"/docs/fundamentals/tuning-guide-66","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#block-encoding","content":"Set encoding at table creation time. Example:\n CREATE TABLE … ( … ) DATA_BLOCK_ENCODING=‘FAST_DIFF’"},"2605":{"id":"/docs/fundamentals/tuning-guide-67","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#schema-design","content":"Because the schema affects the way the data is written to the underlying HBase layer, Phoenix performance relies on the design of your tables, indexes, and primary keys."},"2606":{"id":"/docs/fundamentals/tuning-guide-68","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#phoenix-and-the-hbase-data-model","content":"HBase stores data in tables, which in turn contain columns grouped in column families. A row in an HBase table consists of versioned cells associated with one or more columns. An HBase row is a collection of many key-value pairs in which the rowkey attribute of the keys are equal. Data in an HBase table is sorted by the rowkey, and all access is via the rowkey.\nPhoenix creates a relational data model on top of HBase, enforcing a PRIMARY KEY constraint whose columns are concatenated to form the row key for the underlying HBase table. For this reason, it's important to be cognizant of the size and number of the columns you include in the PK constraint, because a copy of the row key is included with every cell in the underlying HBase table."},"2607":{"id":"/docs/fundamentals/tuning-guide-69","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#column-families","content":"If some columns are accessed more frequently than others, create multiple column families to separate the frequently-accessed columns from rarely-accessed columns. This improves performance because HBase reads only the column families specified in the query."},"2608":{"id":"/docs/fundamentals/tuning-guide-70","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#columns","content":"Here are a few tips that apply to columns in general, whether they are indexed or not:"},"2609":{"id":"/docs/fundamentals/tuning-guide-71","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#columns","content":"Keep VARCHAR columns under 1MB or so due to I/O costs. When processing queries, HBase materializes cells in full before sending them over to the client, and the client receives them in full before handing them off to the application code."},"2610":{"id":"/docs/fundamentals/tuning-guide-72","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#columns","content":"For structured objects, don't use JSON, which is not very compact. Use a format such as protobuf, Avro, msgpack, or BSON."},"2611":{"id":"/docs/fundamentals/tuning-guide-73","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#columns","content":"Consider compressing data before storage using a fast LZ variant to cut latency and I/O costs."},"2612":{"id":"/docs/fundamentals/tuning-guide-74","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#columns","content":"Use the column mapping feature (added in Phoenix 4.10), which uses numerical HBase column qualifiers for non-PK columns instead of directly using column names. This improves performance when looking for a cell in the sorted list of cells returned by HBase, adds further across-the-board performance by reducing the disk size used by tables, and speeds up DDL operations like column rename and metadata-level column drops. For more information, see “Column Mapping and Immutable Data Encoding” on the Apache Phoenix blog."},"2613":{"id":"/docs/fundamentals/tuning-guide-75","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#indexes","content":"A Phoenix index is a physical table that stores a pivoted copy of some or all of the data in the main table to serve specific query patterns. When you issue a query, Phoenix automatically selects the best index. The primary index is created automatically based on selected primary keys. You can create secondary indexes by specifying included columns based on expected query patterns."},"2614":{"id":"/docs/fundamentals/tuning-guide-76","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#indexes","content":"See also:\nSecondary Indexing"},"2615":{"id":"/docs/fundamentals/tuning-guide-77","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#tuning-guide-secondary-indexes","content":"Secondary indexes can improve read performance by turning what would normally be a full table scan into a point lookup (at the cost of storage space and write speed). Secondary indexes can be added or removed after table creation and don't require changes to existing queries – queries simply run faster. A small number of secondary indexes is often sufficient. Depending on your needs, consider creating covered indexes or functional indexes, or both."},"2616":{"id":"/docs/fundamentals/tuning-guide-78","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#tuning-guide-secondary-indexes","content":"If your table is large, use ASYNC with CREATE INDEX to create indexes asynchronously. In this case, index build runs through MapReduce, so client restarts will not impact index creation and jobs can be retried automatically if needed. You still need to start the job manually, and then monitor it like any other MapReduce job."},"2617":{"id":"/docs/fundamentals/tuning-guide-79","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#tuning-guide-secondary-indexes","content":"Example:"},"2618":{"id":"/docs/fundamentals/tuning-guide-80","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#tuning-guide-secondary-indexes","content":"See Index Population for details."},"2619":{"id":"/docs/fundamentals/tuning-guide-81","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#tuning-guide-secondary-indexes","content":"If you cannot create the index asynchronously, increase query timeout (phoenix.query.timeoutMs) to exceed expected index build time. If CREATE INDEX times out or the client goes down before completion, the build stops and must be run again. You can monitor the index table during creation: new regions appear as splits occur. You can query SYSTEM.STATS (populated by splits/compactions), or run COUNT(*) against the index table (higher load because it requires a full scan)."},"2620":{"id":"/docs/fundamentals/tuning-guide-82","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#tuning-guide-secondary-indexes","content":"Tips:"},"2621":{"id":"/docs/fundamentals/tuning-guide-83","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#tuning-guide-secondary-indexes","content":"Create local indexes for write-heavy use cases."},"2622":{"id":"/docs/fundamentals/tuning-guide-84","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#tuning-guide-secondary-indexes","content":"Create global indexes for read-heavy use cases. To save read-time overhead, consider creating covered indexes."},"2623":{"id":"/docs/fundamentals/tuning-guide-85","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#tuning-guide-secondary-indexes","content":"If the primary key is monotonically increasing, create salt buckets. The salt buckets can't be changed later, so design them to handle future growth. Salt buckets help avoid write hotspots, but can decrease overall throughput due to the additional scans needed on read."},"2624":{"id":"/docs/fundamentals/tuning-guide-86","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#tuning-guide-secondary-indexes","content":"Set up a cron job to build indexes. Use ASYNC with CREATE INDEX to avoid blocking."},"2625":{"id":"/docs/fundamentals/tuning-guide-87","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#tuning-guide-secondary-indexes","content":"Only create the indexes you need."},"2626":{"id":"/docs/fundamentals/tuning-guide-88","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#tuning-guide-secondary-indexes","content":"Limit the number of indexes on frequently updated tables."},"2627":{"id":"/docs/fundamentals/tuning-guide-89","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#tuning-guide-secondary-indexes","content":"Use covered indexes to convert table scans into efficient point lookups or range queries over the index table instead of the primary table:"},"2628":{"id":"/docs/fundamentals/tuning-guide-90","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#queries","content":"It's important to know which queries execute on the server side versus client side, because this affects performance due to network I/O and other bottlenecks. If you're querying a billion-row table, you want as much computation as possible on the server side instead of transmitting rows to the client. Some queries must still execute on the client. Sorting data that resides on multiple region servers, for example, requires aggregation and re-sort on the client."},"2629":{"id":"/docs/fundamentals/tuning-guide-91","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#reading","content":"Avoid joins unless one side is small, especially on frequent queries. For larger joins, see “Hints,” below."},"2630":{"id":"/docs/fundamentals/tuning-guide-92","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#reading","content":"In the WHERE clause, filter leading columns in the primary key constraint."},"2631":{"id":"/docs/fundamentals/tuning-guide-93","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#reading","content":"Filtering the first leading column with IN or OR in the WHERE clause enables skip scan optimizations."},"2632":{"id":"/docs/fundamentals/tuning-guide-94","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#reading","content":"Equality or comparisons (< or >) in the WHERE clause enable range-scan optimizations."},"2633":{"id":"/docs/fundamentals/tuning-guide-95","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#reading","content":"Let Phoenix optimize query parallelism using statistics. This provides an automatic benefit if using Phoenix 4.2 or greater in production."},"2634":{"id":"/docs/fundamentals/tuning-guide-96","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#reading","content":"See also: Joins"},"2635":{"id":"/docs/fundamentals/tuning-guide-97","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#range-queries","content":"If you regularly scan large data sets from spinning disk, you're best off with GZIP (but watch write speed). Use a lot of cores for a scan to utilize the available memory bandwidth. Apache Phoenix makes it easy to utilize many cores to increase scan performance."},"2636":{"id":"/docs/fundamentals/tuning-guide-98","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#range-queries","content":"For range queries, the HBase block cache does not provide much advantage."},"2637":{"id":"/docs/fundamentals/tuning-guide-99","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#large-range-queries","content":"For large range queries, consider setting Scan.setCacheBlocks(false) even if the whole scan could fit into the block cache."},"2638":{"id":"/docs/fundamentals/tuning-guide-100","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#large-range-queries","content":"If you mostly perform large range queries you might even want to consider running HBase with a much smaller heap and size the block cache down, to only rely on the OS Cache. This will alleviate some garbage collection related issues."},"2639":{"id":"/docs/fundamentals/tuning-guide-101","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#point-lookups","content":"For point lookups it is quite important to have your data set cached, and you should use the HBase block cache."},"2640":{"id":"/docs/fundamentals/tuning-guide-102","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#hints","content":"Hints let you override default query processing behavior and specify such factors as which index to use, what type of scan to perform, and what type of join to use."},"2641":{"id":"/docs/fundamentals/tuning-guide-103","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#hints","content":"During the query, Hint global index if you want to force it when query includes a column not in the index."},"2642":{"id":"/docs/fundamentals/tuning-guide-104","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#hints","content":"If necessary, you can do bigger joins with the /*+ USE_SORT_MERGE_JOIN */ hint, but a big join will be an expensive operation over huge numbers of rows."},"2643":{"id":"/docs/fundamentals/tuning-guide-105","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#hints","content":"If the overall size of all right-hand-side tables would exceed the memory size limit, use the /*+ NO_STAR_JOIN */ hint."},"2644":{"id":"/docs/fundamentals/tuning-guide-106","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#hints","content":"See also: Hint."},"2645":{"id":"/docs/fundamentals/tuning-guide-107","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#explain-plans","content":"An EXPLAIN plan tells you a lot about how a query will be run. To generate an explain plan run this query and to interpret the plan, see this reference."},"2646":{"id":"/docs/fundamentals/tuning-guide-108","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#tuning-guide-parallelization","content":"You can improve parallelization with the UPDATE STATISTICS command. This command subdivides each region by determining keys called guideposts that are equidistant from each other, then uses these guideposts to break up queries into multiple parallel scans.\nStatistics are turned on by default. With Phoenix 4.9, the user can set guidepost width for each table. Optimal guidepost width depends on a number of factors such as cluster size, cluster usage, number of cores per node, table size, and disk I/O."},"2647":{"id":"/docs/fundamentals/tuning-guide-109","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#tuning-guide-parallelization","content":"In Phoenix 4.12, configuration phoenix.use.stats.parallelization was added to control whether statistics are used to drive parallelization. Stats collection can still run regardless. Collected information is also used to estimate bytes and rows scanned when generating EXPLAIN."},"2648":{"id":"/docs/fundamentals/tuning-guide-110","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#updating-data-with-upsert-values","content":"When using UPSERT VALUES to write a large number of records, turn off autocommit and batch records in reasonably small batches (try 100 rows and adjust from there to fine-tune performance)."},"2649":{"id":"/docs/fundamentals/tuning-guide-111","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#updating-data-with-upsert-values","content":"Note: With the default fat driver, executeBatch() does not provide benefit. Instead, update multiple rows by executing UPSERT VALUES multiple times and then use commit() to submit the batch. With the thin driver, however, use executeBatch() to minimize RPCs between the client and query server."},"2650":{"id":"/docs/fundamentals/tuning-guide-112","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#updating-data-with-upsert-values","content":"Note: Because the Phoenix client keeps uncommitted rows in memory, be careful not to set commitSize too high."},"2651":{"id":"/docs/fundamentals/tuning-guide-113","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#updating-data-with-upsert-select","content":"When using UPSERT SELECT to write many rows in a single statement, turn on autocommit and the rows will be automatically batched according to the phoenix.mutate.batchSize. This will minimize the amount of data returned back to the client and is the most efficient means of updating many rows."},"2652":{"id":"/docs/fundamentals/tuning-guide-114","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#deleting-data","content":"When deleting a large data set, turn on autoCommit before issuing the DELETE query so that the client does not need to remember the row keys of all the keys as they are deleted. This prevents the client from buffering the rows affected by the DELETE so that Phoenix can delete them directly on the region servers without the expense of returning them to the client."},"2653":{"id":"/docs/fundamentals/tuning-guide-115","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#reducing-rpc-traffic","content":"To reduce RPC traffic, set UPDATE_CACHE_FREQUENCY (4.7 or above) on your tables and indexes when creating them (or via ALTER TABLE/ALTER INDEX). See Altering."},"2654":{"id":"/docs/fundamentals/tuning-guide-116","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#using-local-indexes","content":"If using 4.8, consider using local indexes to minimize the write time. In this case, the writes for the secondary index will be to the same region server as your base table. This approach does involve a performance hit on the read side, though, so make sure to quantify both write speed improvement and read speed reduction."},"2655":{"id":"/docs/fundamentals/tuning-guide-117","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#further-tuning","content":"For advice about tuning the underlying HBase and JVM layers, see Operational and Performance Configuration Options in the Apache HBase™ Reference Guide."},"2656":{"id":"/docs/fundamentals/tuning-guide-118","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#special-cases","content":"The following sections provide Phoenix-specific additions to the tuning recommendations in the Apache HBase™ Reference Guide section referenced above."},"2657":{"id":"/docs/fundamentals/tuning-guide-119","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#for-applications-where-failing-quickly-is-better-than-waiting","content":"In addition to the HBase tuning referenced above, set phoenix.query.timeoutMs in hbase-site.xml on the client side to the maximum tolerable wait time in milliseconds."},"2658":{"id":"/docs/fundamentals/tuning-guide-120","page_id":"/docs/fundamentals/tuning-guide","tags":["multi-page"],"type":"text","url":"/docs/fundamentals/tuning-guide#for-applications-that-can-tolerate-slightly-out-of-date-information","content":"In addition to the HBase tuning referenced above, set phoenix.connection.consistency = timeline in hbase-site.xml on the client side for all connections."},"2659":{"id":"/docs/grammar","page_id":"/docs/grammar","type":"page","content":"SQL Grammar","breadcrumbs":["Docs","Multi-Page Documentation","Reference"],"tags":["multi-page"],"url":"/docs/grammar"},"2660":{"id":"/docs/grammar-0","page_id":"/docs/grammar","tags":["multi-page"],"type":"text","url":"/docs/grammar","content":"SQL command and grammar reference for Apache Phoenix — SELECT, UPSERT, CREATE TABLE, indexes, and more."},"2661":{"id":"/docs/grammar-1","page_id":"/docs/grammar","type":"heading","tags":["multi-page"],"url":"/docs/grammar#commands","content":"Commands"},"2662":{"id":"/docs/grammar-2","page_id":"/docs/grammar","type":"heading","tags":["multi-page"],"url":"/docs/grammar#select","content":"SELECT"},"2663":{"id":"/docs/grammar-3","page_id":"/docs/grammar","type":"heading","tags":["multi-page"],"url":"/docs/grammar#upsert-values","content":"UPSERT VALUES"},"2664":{"id":"/docs/grammar-4","page_id":"/docs/grammar","type":"heading","tags":[