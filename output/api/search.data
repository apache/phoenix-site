,[45429],"/docs/single-page#hbase--hadoop-configuration-files",{"_11741":3685,"_45071":3624,"_5":45533,"_17054":97726,"_23491":97727,"_7185":93150},[45429],"/docs/single-page#the-phoenix-jdbc-url",{"_11741":3686,"_45071":3624,"_5":45533,"_17054":97729,"_23491":97730,"_7185":93154},[45429],"/docs/single-page#default-connection",{"_11741":3687,"_45071":3624,"_5":45533,"_17054":97732,"_23491":97733,"_7185":93158},[45429],"/docs/single-page#the-jdbcphoenix-protocol-variant",{"_11741":3688,"_45071":3624,"_5":45533,"_17054":97735,"_23491":97736,"_7185":93162},[45429],"/docs/single-page#the-jdbcphoenixzk-protocol-variant",{"_11741":3689,"_45071":3624,"_5":45533,"_17054":97738,"_23491":97739,"_7185":93166},[45429],"/docs/single-page#the-jdbcphoenixmaster-protocol-variant",{"_11741":3690,"_45071":3624,"_5":45533,"_17054":97741,"_23491":97742,"_7185":93170},[45429],"/docs/single-page#the-jdbcphoenixrpc-protocol-variant",{"_11741":3691,"_45071":3624,"_5":45533,"_17054":97744,"_23491":97745,"_7185":88985},[45429],"/docs/single-page#client-classpath-and-jdbc-url-notes",{"_11741":3692,"_45071":3624,"_5":45533,"_17054":97747,"_23491":97748,"_7185":94102},[45429],"/docs/single-page#tuning-guide",{"_11741":3693,"_45071":3624,"_5":45533,"_17054":97750,"_23491":97751,"_7185":94111},[45429],"/docs/single-page#primary-keys",{"_11741":3694,"_45071":3624,"_5":45533,"_17054":97753,"_23491":97754,"_7185":94115},[45429],"/docs/single-page#monotonically-increasing-primary-keys",{"_11741":3695,"_45071":3624,"_5":45533,"_17054":97756,"_23491":97757,"_7185":94119},[45429],"/docs/single-page#general-tips",{"_11741":3696,"_45071":3624,"_5":45533,"_17054":97759,"_23491":97760,"_7185":94123},[45429],"/docs/single-page#is-the-data-random-access",{"_11741":3697,"_45071":3624,"_5":45533,"_17054":97762,"_23491":97763,"_7185":94127},[45429],"/docs/single-page#is-the-data-read-heavy-or-write-heavy",{"_11741":3698,"_45071":3624,"_5":45533,"_17054":97765,"_23491":97766,"_7185":94131},[45429],"/docs/single-p