_21301":11,"_6528":79090},[41736],"The Apache Omid podling has recently decided to graduate as a sub-project of Apache Phoenix.",{"_15044":14,"_41288":11,"_15362":79092,"_5":14925,"_21301":11,"_6528":79093},[41736],"This graduation process is currently ongoing. Please follow the Apache Phoenix mailing lists\nfor more information about this effort.",{"_15044":15,"_41288":15,"_5":10980,"_6528":79095,"_41707":79096,"_15362":79097,"_21301":15},"Phoenix ORM library",[79080,79081,79082,79083],[41736],{"_15044":16,"_41288":15,"_15362":79099,"_5":14925,"_21301":15,"_6528":79100},[41736],"Guide to PHO (Phoenix-HBase ORM) for entity mapping, query building, execution, and configuration.",{"_15044":17,"_41288":15,"_5":41704,"_15362":79102,"_21301":79103,"_6528":79104},[41736],"/docs/addons/phoenix-orm-library#entity-class","Entity Class",{"_15044":18,"_41288":15,"_5":41704,"_15362":79106,"_21301":79107,"_6528":79108},[41736],"/docs/addons/phoenix-orm-library#query-building","Query Building",{"_15044":19,"_41288":15,"_5":41704,"_15362":79110,"_21301":79111,"_6528":79112},[41736],"/docs/addons/phoenix-orm-library#simple-queries","Simple queries",{"_15044":20,"_41288":15,"_5":41704,"_15362":79114,"_21301":79115,"_6528":79116},[41736],"/docs/addons/phoenix-orm-library#compound-queries","Compound queries",{"_15044":21,"_41288":15,"_5":41704,"_15362":79118,"_21301":79119,"_6528":79120},[41736],"/docs/addons/phoenix-orm-library#query-interface","Query Interface",{"_15044":22,"_41288":15,"_5":41704,"_15362":79122,"_21301":79123,"_6528":79124},[41736],"/docs/addons/phoenix-orm-library#resolving-entity-and-property-names","Resolving Entity and Property Names",{"_15044":23,"_41288":15,"_5":41704,"_15362":79126,"_21301":79127,"_6528":79128},[41736],"/docs/addons/phoenix-orm-library#query-execution","Query Execution",{"_15044":24,"_41288":15,"_5":41704,"_15362":79130,"_21301":79131,"_6528":79132},[41736],"/docs/addons/phoenix-orm-library#phoenix-orm-library-configuration","Configuration",{"_15044":25,"_41288":15,"_5":41704,"_15362":79134,"_21301":79135,"_6528":79136},[41736],"/docs/addons/phoenix-orm-library#hbase","HBase",{"_15044":26,"_41288":15,"_15362":79138,"_5":14925,"_21301":15,"_6528":79139},[41736],"PHO is an Object Relational Mapping (ORM) library for building and executing queries on HBase using Apache Phoenix.\nIt provides ORM-style mappings and DSL-style query building. Initially developed and open sourced by eHarmony, it is available on GitHub.",{"_15044":27,"_41288":15,"_15362":79141,"_5":14925,"_21301":15,"_6528":79142},[41736],"Its interfaces and generic annotations make it possible to switch data store APIs in the future without changing query definitions.\nCurrently, it supports HBase integration through Apache Phoenix, and can be extended with other implementations.",{"_15044":28,"_41288":15,"_15362":79144,"_5":14925,"_21301":79103,"_6528":79145},[41736],"Suppose we have the following TestClass we want to query in our data store:",{"_15044":29,"_41288":15,"_15362":79147,"_5":14925,"_21301":79107,"_6528":79148},[41736],"Query building can be done in DSL style. More advanced query building is under development, but for now we will use a combination of QueryBuilder and static, Hibernate-style Restrictions methods to construct queries.",{"_15044":30,"_41288":15,"_15362":79150,"_5":14925,"_21301":79111,"_6528":79151},[41736],"Construct a query to find all user matches delivered in the past two days and not in a closed state.",{"_15044":31,"_41288":15,"_15362":79153,"_5":14925,"_21301":79115,"_6528":79154},[41736],"Construct a more complex query where we find items older than one day, include multiple status values, order by deliveryDate, and limit result size to 10.",{"_15044":32,"_41288":15,"_15362":79156,"_5":14925,"_21301":79115,"_6528":79157},[41736],"By default, expressions are combined with AND when added separately.",{"_15044":33,"_41288":15,"_15362":79159,"_5":14925,"_21301":79119,"_6528":79160},[41736],"The following query components are supported:",{"_15044":34,"_41288":15,"_15362":79162,"_5":14925,"_21301":79123,"_6528":79163},[41736],"Always use the property names of your Java objects in your queries.\nIf these names differ from those used in your datastore, use annotations to provide mappings.\nEntity resolvers are configured to map entity classes to table or collection names.\nProperty resolvers are configured to map object variable names to column or field names.",{"_15044":35,"_41288":15,"_15362":79165,"_5":14925,"_21301":79123,"_6528":79166},[41736],"The following annotations are currently supported for the indicated data store type.\nCustom EntityResolvers and PropertyResolvers are straightforward to configure and create.",{"_15044":36,"_41288":15,"_15362":79168,"_5":14925,"_21301":79123,"_6528":79169},[41736],"See Morphia annotations for entity class annotation mappings.",{"_15044":37,"_41288":15,"_15362":79171,"_5":14925,"_21301":79127,"_6528":79172},[41736],"The QueryExecutor interface supports the following operations:",{"_15044":38,"_41288":15,"_15362":79174,"_5":14925,"_21301":79131,"_6528":79175},[41736],"Here are some example Spring configuration files for HBase using Apache Phoenix.",{"_15044":39,"_41288":15,"_15362":79177,"_5":14925,"_21301":79135,"_6528":79178},[41736],"Configuration properties:",{"_15044":40,"_41288":40,"_5":10980,"_6528":79180,"_41707":79181,"_15362":79182,"_21301":40},"Phoenix Tephra Transaction Manager",[79080,79081,79082,79083],[41736],{"_15044":41,"_41288":40,"_15362":79184,"_5":14925,"_21301":40,"_6528":79185},[41736],"Status update for Apache Tephra graduation as an Apache Phoenix sub-project.",{"_15044":42,"_41288":40,"_15362":79187,"_5":14925,"_21301":40,"_6528":79188},[41736],"The Apache Tephra podling has recently decided to graduate as a sub-project of Apache Phoenix.",{"_15044":43,"_41288":40,"_15362":79190,"_5":14925,"_21301":40,"_6528":79093},[41736],{"_15044":44,"_41288":44,"_5":10980,"_6528":79192,"_41707":79193,"_15362":79195,"_21301":44},"Array Type",[79080,79081,79194],"Reference",[41736],{"_15044":45,"_41288":44,"_15362":79197,"_5":14925,"_21301":44,"_6528":79198},[41736],"Use JDBC ARRAY columns in Phoenix, including DDL, inserts, indexing syntax, and built-in array functions.",{"_15044":46,"_41288":44,"_5":41704,"_15362":79200,"_21301":79201,"_6528":79202},[41736],"/docs/array-type#array-type-limitations","Limitations",{"_15044":47,"_41288":44,"_15362":79204,"_5":14925,"_21301":44,"_6528":79205},[41736],"Apache Phoenix 3.0/4.0 introduced support for the JDBC ARRAY type. Any primitive type may be used in an ARRAY. Here is an example of declaring an array type when creating a table:",{"_15044":48,"_41288":44,"_15362":79207,"_5":14925,"_21301":44,"_6528":79208},[41736],"or alternately:",{"_15044":49,"_41288":44,"_15362":79210,"_5":14925,"_21301":44,"_6528":79211},[41736],"Insertion into the array may be done entirely through a SQL statement:",{"_15044":50,"_41288":44,"_15362":79213,"_5":14925,"_21301":44,"_6528":79214},[41736],"or programmatically through JDBC:",{"_15044":51,"_41288":44,"_15362":79216,"_5":14925,"_21301":44,"_6528":79217},[41736],"The entire array may be selected:",{"_15044":52,"_41288":44,"_15362":79219,"_5":14925,"_21301":44,"_6528":79220},[41736],"or an individual element in the array may be accessed via a subscript notation. The subscript is one-based, so the following would select the first element:",{"_15044":53,"_41288":44,"_15362":79222,"_5":14925,"_21301":44,"_6528":79223},[41736],"Use of the array subscript notation is supported in other expressions as well, for example in a WHERE clause:",{"_15044":54,"_41288":44,"_15362":79225,"_5":14925,"_21301":44,"_6528":79226},[41736],"The array length grows dynamically as needed and can be accessed through the built-in ARRAY_LENGTH function:",{"_15044":55,"_41288":44,"_15362":79228,"_5":14925,"_21301":44,"_6528":79229},[41736],"Attempts to access an array element beyond the current length will evaluate to null.",{"_15044":56,"_41288":44,"_15362":79231,"_5":14925,"_21301":44,"_6528":79232},[41736],"For searching in an array, built-in functions like ANY and ALL are provided. For example,",{"_15044":57,"_41288":44,"_15362":79234,"_5":14925,"_21301":44,"_6528":79235},[41736],"The built-in function ANY checks if any array element satisfies the condition and is equivalent to an OR condition:",{"_15044":58,"_41288":44,"_15362":79237,"_5":14925,"_21301":44,"_6528":79238},[41736],"The built-in function ALL checks if all array elements satisfy the condition and is equivalent to an AND condition:",{"_15044":59,"_41288":44,"_15362":79240,"_5":14925,"_21301":79201,"_6528":79241},[41736],"Only one-dimensional arrays are currently supported.",{"_15044":60,"_41288":44,"_15362":79243,"_5":14925,"_21301":79201,"_6528":79244},[41736],"For an array of fixed width types, null elements occurring in the middle of an array are not tracked.",{"_15044":61,"_41288":44,"_15362":79246,"_5":14925,"_21301":79201,"_6528":79247},[41736],"The declaration of an array length at DDL time is not enforced currently, but maybe in the future. Note that it is persisted with the table metadata.",{"_15044":62,"_41288":44,"_15362":79249,"_5":14925,"_21301":79201,"_6528":79250},[41736],"An array may only be used as the last column in a primary key constraint.",{"_15044":63,"_41288":44,"_15362":79252,"_5":14925,"_21301":79201,"_6528":79253},[41736],"Partial update of an array is currently not possible. Instead, the array may be manipulated on the client-side and then upserted back in its entirety.",{"_15044":64,"_41288":64,"_5":10980,"_6528":79255,"_41707":79256,"_15362":79258,"_21301":64},"Building Website",[79080,79081,79082,79257],"Contributing",[41736],{"_15044":65,"_41288":64,"_15362":79260,"_5":14925,"_21301":64,"_6528":79261},[41736],"Build and test the Apache Phoenix website locally with the current React + TypeScript workflow.",{"_15044":66,"_41288":64,"_5":41704,"_15362":79263,"_21301":79264,"_6528":79265},[41736],"/docs/contributing/building-website#building-website-prerequisites","Prerequisites",{"_15044":67,"_41288":64,"_5":41704,"_15362":79267,"_21301":79268,"_6528":79269},[41736],"/docs/contributing/building-website#building-phoenix-project-website","Building Phoenix Project Website",{"_15044":68,"_41288":64,"_5":41704,"_15362":79271,"_21301":79272,"_6528":79273},[41736],"/docs/contributing/building-website#publishing-website-artifact","Publishing Website Artifact",{"_15044":69,"_41288":64,"_5":41704,"_15362":79275,"_21301":79276,"_6528":79277},[41736],"/docs/contributing/building-website#local-testing-during-development","Local Testing During Development",{"_15044":70,"_41288":64,"_15362":79279,"_5":14925,"_21301":79264,"_6528":79280},[41736],"Node.js 22.x (minimum 22.12.0)",{"_15044":71,"_41288":64,"_15362":79282,"_5":14925,"_21301":79264,"_6528":79283},[41736],"npm (bundled with Node.js)",{"_15044":72,"_41288":64,"_15362":79285,"_5":14925,"_21301":79268,"_6528":79286},[41736],"Clone the repository:",{"_15044":73,"_41288":64,"_15362":79288,"_5":14925,"_21301":79268,"_6528":79289},[41736],"During development, install dependencies:",{"_15044":74,"_41288":64,"_15362":79291,"_5":14925,"_21301":79268,"_6528":79292},[41736],"For local iteration, run checks/build directly when needed:",{"_15044":75,"_41288":64,"_15362":79294,"_5":14925,"_21301":79268,"_6528":79295},[41736],"Before opening a pull request, run the mandatory build script:",{"_15044":76,"_41288":64,"_15362":79297,"_5":14925,"_21301":79268,"_6528":79298},[41736],"build.sh is required for all contributors. It:",{"_15044":77,"_41288":64,"_15362":79300,"_5":14925,"_21301":79268,"_6528":79301},[41736],"ensures Node/npm are available",{"_15044":78,"_41288":64,"_15362":79303,"_5":14925,"_21301":79268,"_6528":79304},[41736],"runs a clean install (npm ci)",{"_15044":79,"_41288":64,"_15362":79306,"_5":14925,"_21301":79268,"_6528":79307},[41736],"runs full validation/build (npm run ci)",{"_15044":80,"_41288":64,"_15362":79309,"_5":14925,"_21301":79268,"_6528":79310},[41736],"copies build/client/ into output/",{"_15044":81,"_41288":64,"_15362":79312,"_5":14925,"_21301":79268,"_6528":79313},[41736],"There is no remote CI/CD runner currently executing this script. The generated output/ directory is a build artifact that must be committed and pushed with your PR.",{"_15044":82,"_41288":64,"_15362":79315,"_5":14925,"_21301":79272,"_6528":79316},[41736],"Current publishing flow:",{"_15044":83,"_41288":64,"_15362":79318,"_5":14925,"_21301":79272,"_6528":79319},[41736],"Run ./build.sh locally",{"_15044":84,"_41288":64,"_15362":79321,"_5":14925,"_21301":79272,"_6528":79322},[41736],"Commit both source changes and updated output/",{"_15044":85,"_41288":64,"_15362":79324,"_5":14925,"_21301":79272,"_6528":79325},[41736],"Push your branch and open a PR",{"_15044":86,"_41288":64,"_15362":79327,"_5":14925,"_21301":79272,"_6528":79328},[41736],"After merge, output/ is used as the website artifact for deployment.",{"_15044":87,"_41288":64,"_15362":79330,"_5":14925,"_21301":79276,"_6528":79331},[41736],"Start the development server with hot reload:",{"_15044":88,"_41288":64,"_15362":79333,"_5":14925,"_21301":79276,"_6528":79334},[41736],"By default, the website is available at:",{"_15044":89,"_41288":64,"_15362":79336,"_5":14925,"_21301":79276,"_6528":79337},[41736],"To test the production build locally:",{"_15044":90,"_41288":90,"_5":10980,"_6528":79339,"_41707":79340,"_15362":79341,"_21301":90},"Developing Phoenix",[79080,79081,79082,79257],[41736],{"_15044":91,"_41288":90,"_15362":79343,"_5":14925,"_21301":90,"_6528":79344},[41736],"Set up a local Apache Phoenix development environment, IDE preferences, and contribution workflow.",{"_15044":92,"_41288":90,"_5":41704,"_15362":79346,"_21301":79347,"_6528":79348},[41736],"/docs/contributing/develop#develop-getting-started","Getting Started",{"_15044":93,"_41288":90,"_5":41704,"_15362":79350,"_21301":79351,"_6528":79352},[41736],"/docs/contributing/develop#other-phoenix-subprojects","Other Phoenix Subprojects",{"_15044":94,"_41288":90,"_5":41704,"_15362":79354,"_21301":79355,"_6528":79356},[41736],"/docs/contributing/develop#setup-local-git-repository","Setup Local Git Repository",{"_15044":95,"_41288":90,"_5":41704,"_15362":79358,"_21301":79359,"_6528":79360},[41736],"/docs/contributing/develop#for-eclipse-ide-for-java-developers-luna","For Eclipse IDE for Java Developers (Luna)",{"_15044":96,"_41288":90,"_5":41704,"_15362":79362,"_21301":79363,"_6528":79364},[41736],"/docs/contributing/develop#get-settings-and-preferences-correct","Get Settings and Preferences Correct",{"_15044":97,"_41288":90,"_5":41704,"_15362":79366,"_21301":79367,"_6528":79368},[41736],"/docs/contributing/develop#connecting-to-jira","Connecting to Jira",{"_15044":98,"_41288":90,"_5":41704,"_15362":79370,"_21301":79371,"_6528":79372},[41736],"/docs/contributing/develop#commit","Commit",{"_15044":99,"_41288":90,"_5":41704,"_15362":79374,"_21301":79375,"_6528":79376},[41736],"/docs/contributing/develop#for-intellij","For Intellij",{"_15044":100,"_41288":90,"_5":41704,"_15362":79378,"_21301":79379,"_6528":79380},[41736],"/docs/contributing/develop#if-you-dont-have-a-local-git-repository-setup","If you don't have a local git repository setup",{"_15044":101,"_41288":90,"_5":41704,"_15362":79382,"_21301":79383,"_6528":79384},[41736],"/docs/contributing/develop#if-you-already-have-a-local-git-repository-setup","If you already have a local git repository setup",{"_15044":102,"_41288":90,"_5":41704,"_15362":79386,"_21301":79387,"_6528":79364},[41736],"/docs/contributing/develop#get-settings-and-preferences-correct-1",{"_15044":103,"_41288":90,"_5":41704,"_15362":79389,"_21301":79390,"_6528":79368},[41736],"/docs/contributing/develop#connecting-to-jira-1",{"_15044":104,"_41288":90,"_5":41704,"_15362":79392,"_21301":79393,"_6528":79372},[41736],"/docs/contributing/develop#commit-1",{"_15044":105,"_41288":90,"_5":41704,"_15362":79395,"_21301":79396,"_6528":79397},[41736],"/docs/contributing/develop#contributing-finished-work","Contributing finished work",{"_15044":106,"_41288":90,"_5":41704,"_15362":79399,"_21301":79400,"_6528":79401},[41736],"/docs/contributing/develop#create-pull-request","Create pull request",{"_15044":107,"_41288":90,"_15362":79403,"_5":14925,"_21301":79347,"_6528":79404},[41736],"Review the How to Contribute documentation.",{"_15044":108,"_41288":90,"_15362":79406,"_5":14925,"_21301":79347,"_6528":79407},[41736],"Sign up for a GitHub account if you do not have one.",{"_15044":109,"_41288":90,"_15362":79409,"_5":14925,"_21301":79347,"_6528":79410},[41736],"Go to the Phoenix GitHub repository and create a fork, which creates {username}/phoenix.",{"_15044":110,"_41288":90,"_15362":79412,"_5":14925,"_21301":79347,"_6528":79413},[41736],"Set up Git locally.",{"_15044":111,"_41288":90,"_15362":79415,"_5":14925,"_21301":79347,"_6528":79416},[41736],"Instructions",{"_15044":112,"_41288":90,"_15362":79418,"_5":14925,"_21301":79347,"_6528":79419},[41736],"Download",{"_15044":113,"_41288":90,"_15362":79421,"_5":14925,"_21301":79347,"_6528":79422},[41736],"Make sure you have a JDK (Phoenix historically required JDK 7).",{"_15044":114,"_41288":90,"_15362":79424,"_5":14925,"_21301":79347,"_6528":79425},[41736],"Make sure you have Maven 3+ installed.",{"_15044":115,"_41288":90,"_15362":79427,"_5":14925,"_21301":79347,"_6528":79428},[41736],"Add the following to your .bashrc or equivalent to ensure Maven and Java are configured correctly for command-line usage.",{"_15044":116,"_41288":90,"_15362":79430,"_5":14925,"_21301":79351,"_6528":79431},[41736],"The instructions here are for the main Phoenix project. For the other subprojects, use the corresponding repository and JIRA project.",{"_15044":117,"_41288":90,"_15362":79433,"_5":14925,"_21301":79351,"_6528":79434},[41736],"The Eclipse and IntelliJ setup instructions may not necessarily work well for the other projects.",{"_15044":118,"_41288":90,"_15362":79436,"_5":14925,"_21301":79355,"_6528":79437},[41736],"You may find it easier to clone from your IDE of choice, especially with IntelliJ.",{"_15044":119,"_41288":90,"_15362":79439,"_5":14925,"_21301":79355,"_6528":79440},[41736],"Create a local clone of your new forked repository",{"_15044":120,"_41288":90,"_15362":79442,"_5":14925,"_21301":79355,"_6528":79443},[41736],"Configure your local repository to be able to sync with the apache/phoenix repository",{"_15044":121,"_41288":90,"_15362":79445,"_5":14925,"_21301":79355,"_6528":79446},[41736],"Setup your development environment",{"_15044":122,"_41288":90,"_15362":79448,"_5":14925,"_21301":79359,"_6528":79449},[41736],"Download Eclipse",{"_15044":123,"_41288":90,"_15362":79451,"_5":14925,"_21301":79359,"_6528":79452},[41736],"You will want 'Eclipse IDE for Java Developers' unless you want to install the following tools by hand",{"_15044":124,"_41288":90,"_15362":79454,"_5":14925,"_21301":79359,"_6528":17278},[41736],{"_15044":125,"_41288":90,"_15362":79456,"_5":14925,"_21301":79359,"_6528":36191},[41736],{"_15044":126,"_41288":90,"_15362":79458,"_5":14925,"_21301":79359,"_6528":79459},[41736],"Configure Eclipse to handle Maven Issues appropriately so you don't see unnecessary errors.",{"_15044":127,"_41288":90,"_15362":79461,"_5":14925,"_21301":79359,"_6528":79462},[41736],"Window -> Preferences -> Maven -> Errors/Warnings",{"_15044":128,"_41288":90,"_15362":79464,"_5":14925,"_21301":79359,"_6528":79465},[41736],"Choose Ignore option for 'Plugin execution not covered by lifecycle configuration' -> Ok",{"_15044":129,"_41288":90,"_15362":79467,"_5":14925,"_21301":79359,"_6528":79468},[41736],"Add the local Git repository to Eclipse",{"_15044":130,"_41288":90,"_15362":79470,"_5":14925,"_21301":79359,"_6528":79471},[41736],"Window -> Show View -> Other... -> Git | Git Repositories -> Ok",{"_15044":131,"_41288":90,"_15362":79473,"_5":14925,"_21301":79359,"_6528":79474},[41736],"Click 'Add an existing local Git Repository to this view'",{"_15044":132,"_41288":90,"_15362":79476,"_5":14925,"_21301":79359,"_6528":79477},[41736],"Search for appropriate git repository",{"_15044":133,"_41288":90,"_15362":79479,"_5":14925,"_21301":79359,"_6528":79480},[41736],"Finish",{"_15044":134,"_41288":90,"_15362":79482,"_5":14925,"_21301":79359,"_6528":79483},[41736],"Import Maven Projects",{"_15044":135,"_41288":90,"_15362":79485,"_5":14925,"_21301":79359,"_6528":79486},[41736],"File -> Import -> Maven -> Existing Maven Projects",{"_15044":136,"_41288":90,"_15362":79488,"_5":14925,"_21301":79359,"_6528":79489},[41736],"Choose Root directory where phoenix git repository is located",{"_15044":137,"_41288":90,"_15362":79491,"_5":14925,"_21301":79359,"_6528":79492},[41736],"Select All",{"_15044":138,"_41288":90,"_15362":79494,"_5":14925,"_21301":79359,"_6528":79480},[41736],{"_15044":139,"_41288":90,"_15362":79496,"_5":14925,"_21301":79359,"_6528":79497},[41736],"Generate Lexer and Parser Files",{"_15044":140,"_41288":90,"_15362":79499,"_5":14925,"_21301":79359,"_6528":79500},[41736],"Select phoenix-core project",{"_15044":141,"_41288":90,"_15362":79502,"_5":14925,"_21301":79359,"_6528":79503},[41736],"Run -> Run As -> Maven generate-sources",{"_15044":142,"_41288":90,"_15362":79505,"_5":14925,"_21301":79359,"_6528":79506},[41736],"Make sure you are setup to develop now.",{"_15044":143,"_41288":90,"_15362":79508,"_5":14925,"_21301":79359,"_6528":79509},[41736],"Open IndexUtilTest.Java",{"_15044":144,"_41288":90,"_15362":79511,"_5":14925,"_21301":79359,"_6528":79512},[41736],"Run -> Run As -> JUnit Test",{"_15044":145,"_41288":90,"_15362":79514,"_5":14925,"_21301":79363,"_6528":79515},[41736],"Import General Preferences",{"_15044":146,"_41288":90,"_15362":79517,"_5":14925,"_21301":79363,"_6528":79518},[41736],"File -> Import... -> General -> Preferences",{"_15044":147,"_41288":90,"_15362":79520,"_5":14925,"_21301":79363,"_6528":79521},[41736],"From - {repository}/dev/eclipse_prefs_phoenix.epf",{"_15044":148,"_41288":90,"_15362":79523,"_5":14925,"_21301":79363,"_6528":79524},[41736],"Import All",{"_15044":149,"_41288":90,"_15362":79526,"_5":14925,"_21301":79363,"_6528":79480},[41736],{"_15044":150,"_41288":90,"_15362":79528,"_5":14925,"_21301":79363,"_6528":79529},[41736],"Import Code Templates",{"_15044":151,"_41288":90,"_15362":79531,"_5":14925,"_21301":79363,"_6528":79532},[41736],"Window -> Preferences -> Java -> Code Style -> Code Templates -> Import...",{"_15044":152,"_41288":90,"_15362":79534,"_5":14925,"_21301":79363,"_6528":79535},[41736],"Navigate to {repository}/dev/PhoenixCodeTemplate.xml -> Ok",{"_15044":153,"_41288":90,"_15362":79537,"_5":14925,"_21301":79363,"_6528":79538},[41736],"Import Formatter",{"_15044":154,"_41288":90,"_15362":79540,"_5":14925,"_21301":79363,"_6528":79541},[41736],"Window -> Preferences -> Java -> Code Style -> Formatter-> Import...",{"_15044":155,"_41288":90,"_15362":79543,"_5":14925,"_21301":79363,"_6528":79535},[41736],{"_15044":156,"_41288":90,"_15362":79545,"_5":14925,"_21301":79363,"_6528":79546},[41736],"Import correct import order settings",{"_15044":157,"_41288":90,"_15362":79548,"_5":14925,"_21301":79363,"_6528":79549},[41736],"Window -> Preferences -> Java -> Code Style -> Organize Imports -> Import...",{"_15044":158,"_41288":90,"_15362":79551,"_5":14925,"_21301":79363,"_6528":79552},[41736],"Navigate to {repository}/dev/phoenix.importorder -> Ok",{"_15044":159,"_41288":90,"_15362":79554,"_5":14925,"_21301":79363,"_6528":79555},[41736],"Make sure you use space for tabs",{"_15044":160,"_41288":90,"_15362":79557,"_5":14925,"_21301":79363,"_6528":79558},[41736],"Window -> Preferences -> General -> Editors -> Text Editors",{"_15044":161,"_41288":90,"_15362":79560,"_5":14925,"_21301":79363,"_6528":79561},[41736],"Select 'Insert Spaces for tabs' -> Ok",{"_15044":162,"_41288":90,"_15362":79563,"_5":14925,"_21301":79367,"_6528":79564},[41736],"Install Connector for Jira",{"_15044":163,"_41288":90,"_15362":79566,"_5":14925,"_21301":79367,"_6528":79567},[41736],"Help -> Install New Software -> Add",{"_15044":164,"_41288":90,"_15362":79569,"_5":14925,"_21301":79367,"_6528":79570},[41736],"Location - https://update.atlassian.com/atlassian-eclipse-plugin/rest/e3.7 -> Atlassian Connector",{"_15044":165,"_41288":90,"_15362":79572,"_5":14925,"_21301":79367,"_6528":79480},[41736],{"_15044":166,"_41288":90,"_15362":79574,"_5":14925,"_21301":79367,"_6528":79575},[41736],"Add Task Repository",{"_15044":167,"_41288":90,"_15362":79577,"_5":14925,"_21301":79367,"_6528":79578},[41736],"Window -> Show View -> Mylyn -> Task Repositories -> Add Task Repository",{"_15044":168,"_41288":90,"_15362":79580,"_5":14925,"_21301":79367,"_6528":79581},[41736],"JIRA -> Next -> Server - https://issues.apache.org/jira -> Validate Settings",{"_15044":169,"_41288":90,"_15362":79583,"_5":14925,"_21301":79367,"_6528":79480},[41736],{"_15044":170,"_41288":90,"_15362":79585,"_5":14925,"_21301":79367,"_6528":79586},[41736],"Add Filter Of All JIRAs assigned to you",{"_15044":171,"_41288":90,"_15362":79588,"_5":14925,"_21301":79367,"_6528":79589},[41736],"Right Click on Repository You added -> New Query... -> Predefined Filter",{"_15044":172,"_41288":90,"_15362":79591,"_5":14925,"_21301":79367,"_6528":79592},[41736],"Select Phoenix Project -> Select Assigned to me",{"_15044":173,"_41288":90,"_15362":79594,"_5":14925,"_21301":79367,"_6528":79480},[41736],{"_15044":174,"_41288":90,"_15362":79596,"_5":14925,"_21301":79371,"_6528":79597},[41736],"Commit Changes and Push to Github with appropriate Message",{"_15044":175,"_41288":90,"_15362":79599,"_5":14925,"_21301":79371,"_6528":79600},[41736],"CTRL-# -> Set Commit message to include jira number at beginning PHOENIX-####",{"_15044":176,"_41288":90,"_15362":79602,"_5":14925,"_21301":79371,"_6528":79603},[41736],"Commit and Push",{"_15044":177,"_41288":90,"_15362":79605,"_5":14925,"_21301":79375,"_6528":79606},[41736],"Download IntelliJ",{"_15044":178,"_41288":90,"_15362":79608,"_5":14925,"_21301":79379,"_6528":79609},[41736],"This will automatically create the local clone of your repository for you. You will still want to add the remote upstream repository from above afterwards.",{"_15044":179,"_41288":90,"_15362":79611,"_5":14925,"_21301":79379,"_6528":79612},[41736],"Clone Github project and Import Maven Projects to IDE",{"_15044":180,"_41288":90,"_15362":79614,"_5":14925,"_21301":79379,"_6528":79615},[41736],"Check out from Version Control -> GitHub -> Enter your GitHub Login Info",{"_15044":181,"_41288":90,"_15362":79617,"_5":14925,"_21301":79379,"_6528":79618},[41736],"https://github.com/{username}/phoenix.git -> Check out from Version Control | Yes",{"_15044":182,"_41288":90,"_15362":79620,"_5":14925,"_21301":79379,"_6528":79621},[41736],"Generate Parser and Lexer Files",{"_15044":183,"_41288":90,"_15362":79623,"_5":14925,"_21301":79379,"_6528":79624},[41736],"Maven Projects -> Phoenix Core -> Lifecycle -> compile",{"_15044":184,"_41288":90,"_15362":79626,"_5":14925,"_21301":79379,"_6528":79627},[41736],"Compile Project",{"_15044":185,"_41288":90,"_15362":79629,"_5":14925,"_21301":79379,"_6528":79630},[41736],"Build -> Make Project",{"_15044":186,"_41288":90,"_15362":79632,"_5":14925,"_21301":79379,"_6528":79506},[41736],{"_15044":187,"_41288":90,"_15362":79634,"_5":14925,"_21301":79379,"_6528":79635},[41736],"Open IndexUtilTest.Java -> Run -> Run IndexUtilTest",{"_15044":188,"_41288":90,"_15362":79637,"_5":14925,"_21301":79383,"_6528":79638},[41736],"Import Projects",{"_15044":189,"_41288":90,"_15362":79640,"_5":14925,"_21301":79383,"_6528":79641},[41736],"Import Project",{"_15044":190,"_41288":90,"_15362":79643,"_5":14925,"_21301":79383,"_6528":79644},[41736],"Select Directory of your local repository -> Next",{"_15044":191,"_41288":90,"_15362":79646,"_5":14925,"_21301":79383,"_6528":79647},[41736],"Import project from external model -> Maven -> Next",{"_15044":192,"_41288":90,"_15362":79649,"_5":14925,"_21301":79383,"_6528":79650},[41736],"Select 'Import Maven project automatically'",{"_15044":193,"_41288":90,"_15362":79652,"_5":14925,"_21301":79383,"_6528":79653},[41736],"Select 'Create IntelliJ IDEA modules for aggregator projects'",{"_15044":194,"_41288":90,"_15362":79655,"_5":14925,"_21301":79383,"_6528":79656},[41736],"Select 'Keep source and test folders on reimport'",{"_15044":195,"_41288":90,"_15362":79658,"_5":14925,"_21301":79383,"_6528":79659},[41736],"Select 'Exclude build directory'",{"_15044":196,"_41288":90,"_15362":79661,"_5":14925,"_21301":79383,"_6528":79662},[41736],"Select 'Use Maven output directories' -> Next",{"_15044":197,"_41288":90,"_15362":79664,"_5":14925,"_21301":79383,"_6528":79665},[41736],"Select maven-3 -> Next",{"_15044":198,"_41288":90,"_15362":79667,"_5":14925,"_21301":79383,"_6528":79668},[41736],"Next a whole bunch",{"_15044":199,"_41288":90,"_15362":79670,"_5":14925,"_21301":79383,"_6528":79621},[41736],{"_15044":200,"_41288":90,"_15362":79672,"_5":14925,"_21301":79383,"_6528":79624},[41736],{"_15044":201,"_41288":90,"_15362":79674,"_5":14925,"_21301":79383,"_6528":79627},[41736],{"_15044":202,"_41288":90,"_15362":79676,"_5":14925,"_21301":79383,"_6528":79630},[41736],{"_15044":203,"_41288":90,"_15362":79678,"_5":14925,"_21301":79383,"_6528":79506},[41736],{"_15044":204,"_41288":90,"_15362":79680,"_5":14925,"_21301":79383,"_6528":79635},[41736],{"_15044":205,"_41288":90,"_15362":79682,"_5":14925,"_21301":79387,"_6528":79683},[41736],"Import Settings from eclipse profile",{"_15044":206,"_41288":90,"_15362":79685,"_5":14925,"_21301":79387,"_6528":79686},[41736],"File -> Settings -> Editor -> Code Style -> Java",{"_15044":207,"_41288":90,"_15362":79688,"_5":14925,"_21301":79387,"_6528":79689},[41736],"Set From... -> Import... -> Eclipse XML Profile -> {repository}/dev/PhoenixCodeTemplate.xml",{"_15044":208,"_41288":90,"_15362":79691,"_5":14925,"_21301":79390,"_6528":79692},[41736],"Create Connection to Apache Jira",{"_15044":209,"_41288":90,"_15362":79694,"_5":14925,"_21301":79390,"_6528":79695},[41736],"Tools -> Tasks and Contexts -> Configure Servers -> + -> Jira ->",{"_15044":210,"_41288":90,"_15362":79697,"_5":14925,"_21301":79390,"_6528":79698},[41736],"Server Url: https://issues.apache.org/jira",{"_15044":211,"_41288":90,"_15362":79700,"_5":14925,"_21301":79390,"_6528":79701},[41736],"Query: 'project=Phoenix and ...'",{"_15044":212,"_41288":90,"_15362":79703,"_5":14925,"_21301":79390,"_6528":79704},[41736],"Switch Easily between Tasks",{"_15044":213,"_41288":90,"_15362":79706,"_5":14925,"_21301":79390,"_6528":79707},[41736],"Tools-> Tasks and Contexts -> Open Task->PHOENIX-####",{"_15044":214,"_41288":90,"_15362":79709,"_5":14925,"_21301":79390,"_6528":79710},[41736],"Select Create branch PHOENIX-#### from master->OK",{"_15044":215,"_41288":90,"_15362":79712,"_5":14925,"_21301":79393,"_6528":79597},[41736],{"_15044":216,"_41288":90,"_15362":79714,"_5":14925,"_21301":79393,"_6528":79715},[41736],"VCS -> Commit -> Set Commit message to include jira number PHOENIX-####",{"_15044":217,"_41288":90,"_15362":79717,"_5":14925,"_21301":79393,"_6528":79603},[41736],{"_15044":218,"_41288":90,"_15362":79719,"_5":14925,"_21301":79400,"_6528":79404},[41736],{"_15044":219,"_41288":90,"_15362":79721,"_5":14925,"_21301":79400,"_6528":79722},[41736],"Navigate to branch: https://github.com/{username}/phoenix/tree/{branchname}",{"_15044":220,"_41288":90,"_15362":79724,"_5":14925,"_21301":79400,"_6528":79725},[41736],"Click Pull Request",{"_15044":221,"_41288":90,"_15362":79727,"_5":14925,"_21301":79400,"_6528":79728},[41736],"Confirm that you see apache:master ... {username}:{branchname}",{"_15044":222,"_41288":90,"_15362":79730,"_5":14925,"_21301":79400,"_6528":79731},[41736],"Make sure the pull request title begins with the JIRA key, for example PHOENIX-####.",{"_15044":223,"_41288":90,"_15362":79733,"_5":14925,"_21301":79400,"_6528":79734},[41736],"Click Create pull request.",{"_15044":224,"_41288":224,"_5":10980,"_6528":79736,"_41707":79737,"_15362":79738,"_21301":224},"How to Release",[79080,79081,79082,79257],[41736],{"_15044":225,"_41288":224,"_15362":79740,"_5":14925,"_21301":224,"_6528":79741},[41736],"Apache Phoenix release process, release candidates, and voting workflow.",{"_15044":226,"_41288":224,"_5":41704,"_15362":79743,"_21301":79744,"_6528":79736},[41736],"/docs/contributing/how-to-release#contributing-how-to-release",{"_15044":227,"_41288":224,"_5":41704,"_15362":79746,"_21301":79747,"_6528":79748},[41736],"/docs/contributing/how-to-release#pre-reqs","Pre-Reqs",{"_15044":228,"_41288":224,"_5":41704,"_15362":79750,"_21301":79751,"_6528":79752},[41736],"/docs/contributing/how-to-release#do-a-dry-run","Do a dry run",{"_15044":229,"_41288":224,"_5":41704,"_15362":79754,"_21301":79755,"_6528":79756},[41736],"/docs/contributing/how-to-release#create-real-rc","Create real RC",{"_15044":230,"_41288":224,"_5":41704,"_15362":79758,"_21301":79759,"_6528":79760},[41736],"/docs/contributing/how-to-release#close-the-staging-repository","Close the staging repository",{"_15044":231,"_41288":224,"_5":41704,"_15362":79762,"_21301":79763,"_6528":79764},[41736],"/docs/contributing/how-to-release#voting","Voting",{"_15044":232,"_41288":224,"_5":41704,"_15362":79766,"_21301":79767,"_6528":79768},[41736],"/docs/contributing/how-to-release#release","Release",{"_15044":233,"_41288":224,"_15362":79770,"_5":14925,"_21301":79744,"_6528":79771},[41736],"Phoenix has several repos: phoenix-thirdparty, phoenix-omid, phoenix-tephra, phoenix, phoenix-connectors, and phoenix-queryserver.\nThe create-release scripts provide a unified script to handle the release from each repo.\nThe create-release scripts are in the master branch of the phoenix repo, in the dev/create-release directory.",{"_15044":234,"_41288":224,"_15362":79773,"_5":14925,"_21301":79747,"_6528":79774},[41736],"Make sure that the JIRAs included in the release have their fix-version and release notes fields set correctly, and are resolved.The script will query them and create the CHANGES and RELEASE_NOTES files from that information.Use dev/misc_utils/git_jira_fix_version_check.py to find discrepancies between commits and JIRAs.",{"_15044":235,"_41288":224,"_15362":79776,"_5":14925,"_21301":79747,"_6528":79777},[41736],"Make sure you have set up your user for release signing. Details: http://www.apache.org/dev/release-signing.html.",{"_15044":236,"_41288":224,"_15362":79779,"_5":14925,"_21301":79747,"_6528":79780},[41736],"Make sure you have set up Maven for deploying to the ASF repo. Details: https://infra.apache.org/publishing-maven-artifacts.html.",{"_15044":237,"_41288":224,"_15362":79782,"_5":14925,"_21301":79747,"_6528":79783},[41736],"Clone the Phoenix master branch locally (the script will download the actual repo to release itself).",{"_15044":238,"_41288":224,"_15362":79785,"_5":14925,"_21301":79747,"_6528":79786},[41736],"Make sure Docker is running locally.",{"_15044":239,"_41288":224,"_15362":79788,"_5":14925,"_21301":79747,"_6528":79789},[41736],"Note that Docker Desktop for Mac works, but will be slow (several hours for a Phoenix core release). Running on a native Linux machine is much faster because you avoid filesystem translation layer overhead.",{"_15044":240,"_41288":224,"_15362":79791,"_5":14925,"_21301":79751,"_6528":79792},[41736],"Read /dev/create_release/README.txt to understand what the script does and how to set up gpg-agent for signing.",{"_15044":241,"_41288":224,"_15362":79794,"_5":14925,"_21301":79751,"_6528":79795},[41736],"Run the dev/create-release/do-release-docker.sh -d <workdir> -p <project> command, where",{"_15044":242,"_41288":224,"_15362":79797,"_5":14925,"_21301":79751,"_6528":79798},[41736],"<project> is the repo name you're releasing from (i.e. phoenix)",{"_15044":243,"_41288":224,"_15362":79800,"_5":14925,"_21301":79751,"_6528":79801},[41736],"<workdir> is any existing directory that can be deleted",{"_15044":244,"_41288":224,"_15362":79803,"_5":14925,"_21301":79751,"_6528":79804},[41736],"The script will ask a number of questions. Some of them will have intelligent default, but make sure you check them all:",{"_15044":245,"_41288":224,"_15362":79806,"_5":14925,"_21301":79751,"_6528":79807},[41736],"PROJECT: the repo to release (default specified by -p on the command line)",{"_15044":246,"_41288":224,"_15362":79809,"_5":14925,"_21301":79751,"_6528":79810},[41736],"GIT_BRANCH: the git branch to use for release. This can be master, or a pre-created release branch.",{"_15044":247,"_41288":224,"_15362":79812,"_5":14925,"_21301":79751,"_6528":79813},[41736],"RC_COUNT: the RC number, starting from 0",{"_15044":248,"_41288":224,"_15362":79815,"_5":14925,"_21301":79751,"_6528":79816},[41736],"RELEASE_TAG: the git tag the script will tag the RC commit with.",{"_15044":249,"_41288":224,"_15362":79818,"_5":14925,"_21301":79751,"_6528":79819},[41736],"ASF_USERNAME: your ASF username, for publishing the release artifacts.",{"_15044":250,"_41288":224,"_15362":79821,"_5":14925,"_21301":79751,"_6528":79822},[41736],"ASF_PASSWORD: your ASF password, only for non-dry runs",{"_15044":251,"_41288":224,"_15362":79824,"_5":14925,"_21301":79751,"_6528":79825},[41736],"GIT_NAME/GIT_EMAIL: will be used for the RC commit",{"_15044":252,"_41288":224,"_15362":79827,"_5":14925,"_21301":79751,"_6528":79828},[41736],"GPG_KEY: ID for your GPG key. The script will offer a GPG secret key from your key ring, double-check that it is your code-signing key, and correct it if it is not.",{"_15044":253,"_41288":224,"_15362":79830,"_5":14925,"_21301":79751,"_6528":79831},[41736],"The dry-run will generate the signed release files into <workdir>/output directory.\nThe Maven artifacts will be in <workdir>/output/phoenix-repo-XXXX local Maven repo, in the usual structure.",{"_15044":254,"_41288":224,"_15362":79833,"_5":14925,"_21301":79755,"_6528":79834},[41736],"If the dry-run release artifacts (source, binary, and Maven) check out, then publish a real RC to ASF.",{"_15044":255,"_41288":224,"_15362":79836,"_5":14925,"_21301":79755,"_6528":79837},[41736],"Repeat the dry run process, but add the -f switch to the do-release-docker.sh command.",{"_15044":256,"_41288":224,"_15362":79839,"_5":14925,"_21301":79755,"_6528":79840},[41736],"The script will upload the source and binary release artifacts to a directory under https://dist.apache.org/repos/dist/dev/phoenix/.\nThe script will also deploy the Maven artifacts to https://repository.apache.org/#stagingRepositories.\nCheck that these are present.",{"_15044":257,"_41288":224,"_15362":79842,"_5":14925,"_21301":79759,"_6528":79843},[41736],"The published staging repository is in the \"open\" state. Open staging repositories\nare aggressively cleaned up, and may be removed by the time the vote passes.\nTo avoid this, close\n(but DO NOT release) the staging repository immediately after deployment.",{"_15044":258,"_41288":224,"_15362":79845,"_5":14925,"_21301":79763,"_6528":79846},[41736],"Initiate the vote email. See example here, or use the <workdir>/output/vote.txt template generated by the script.",{"_15044":259,"_41288":224,"_15362":79848,"_5":14925,"_21301":79763,"_6528":79849},[41736],"In case the RC (Release Candidate) is rejected via the vote, you will have to repeat the above process and re-initiate the vote for the next RC (RC0, RC1, etc.).",{"_15044":260,"_41288":224,"_15362":79851,"_5":14925,"_21301":79767,"_6528":79852},[41736],"Once voting is successful (say for RC1), copy artifacts to https://dist.apache.org/repos/dist/release/phoenix:",{"_15044":261,"_41288":224,"_15362":79854,"_5":14925,"_21301":79767,"_6528":79855},[41736],"Set release tag and commit:",{"_15044":262,"_41288":224,"_15362":79857,"_5":14925,"_21301":79767,"_6528":79858},[41736],"Remove any obsolete releases on https://dist.apache.org/repos/dist/release/phoenix given the current release.",{"_15044":263,"_41288":224,"_15362":79860,"_5":14925,"_21301":79767,"_6528":79861},[41736],"Go to https://repository.apache.org/#stagingRepositories and release the staged artifacts (this takes a while so you may need to refresh multiple times).",{"_15044":264,"_41288":224,"_15362":79863,"_5":14925,"_21301":79767,"_6528":79864},[41736],"Create new branch based on current release if needed, for ex: 4.15 branches in this case.",{"_15044":265,"_41288":224,"_15362":79866,"_5":14925,"_21301":79767,"_6528":79867},[41736],"Set version to the upcoming SNAPSHOT and commit:",{"_15044":266,"_41288":224,"_15362":79869,"_5":14925,"_21301":79767,"_6528":79870},[41736],"If releasing Phoenix (core) Create a JIRA to update PHOENIX_MAJOR_VERSION, PHOENIX_MINOR_VERSION and PHOENIX_PATCH_NUMBER in MetaDataProtocol.java appropriately to next version (4, 16, 0 respectively in this case) and compatible_client_versions.json file with the client versions that are compatible against the next version (in this case 4.14.3 and 4.15.0 would be the backward compatible clients for 4.16.0). This JIRA should be committed/marked with fixVersion of the next release candidate.",{"_15044":267,"_41288":224,"_15362":79872,"_5":14925,"_21301":79767,"_6528":79873},[41736],"Add documentation of released version to the downloads page and wiki.",{"_15044":268,"_41288":224,"_15362":79875,"_5":14925,"_21301":79767,"_6528":79876},[41736],"Update the Apache Committee Report Helper DB",{"_15044":269,"_41288":224,"_15362":79878,"_5":14925,"_21301":79767,"_6528":79879},[41736],"Send out an announcement email. See example here.",{"_15044":270,"_41288":224,"_15362":79881,"_5":14925,"_21301":79767,"_6528":79882},[41736],"Bulk close JIRAs that were marked for the release fixVersion.",{"_15044":271,"_41288":224,"_15362":79884,"_5":14925,"_21301":79767,"_6528":79885},[41736],"Congratulations!",{"_15044":272,"_41288":272,"_5":10980,"_6528":79257,"_41707":79887,"_15362":79888,"_21301":272},[79080,79081,79082,79257],[41736],{"_15044":273,"_41288":272,"_15362":79890,"_5":14925,"_21301":272,"_6528":79891},[41736],"Contribution workflow for Apache Phoenix, including JIRA, patch/PR submission, and committer practices.",{"_15044":274,"_41288":272,"_5":41704,"_15362":79893,"_21301":79894,"_6528":79895},[41736],"/docs/contributing#general-process","General process",{"_15044":275,"_41288":272,"_5":41704,"_15362":79897,"_21301":79898,"_6528":79899},[41736],"/docs/contributing#discuss-on-the-mailing-list","Discuss on the mailing list",{"_15044":276,"_41288":272,"_5":41704,"_15362":79901,"_21301":79902,"_6528":79903},[41736],"/docs/contributing#log-a-jira-ticket","Log a JIRA ticket",{"_15044":277,"_41288":272,"_5":41704,"_15362":79905,"_21301":79906,"_6528":79907},[41736],"/docs/contributing#setup-development-environment","Setup development environment",{"_15044":278,"_41288":272,"_5":41704,"_15362":79909,"_21301":79910,"_6528":79911},[41736],"/docs/contributing#generate-a-patch","Generate a patch",{"_15044":279,"_41288":272,"_5":41704,"_15362":79913,"_21301":79914,"_6528":79915},[41736],"/docs/contributing#naming-convention-for-the-patch","Naming convention for the patch",{"_15044":280,"_41288":272,"_5":41704,"_15362":79917,"_21301":79918,"_6528":79919},[41736],"/docs/contributing#github-workflow","GitHub workflow",{"_15044":281,"_41288":272,"_5":41704,"_15362":79921,"_21301":79922,"_6528":79923},[41736],"/docs/contributing#local-git-workflow","Local Git workflow",{"_15044":282,"_41288":272,"_5":41704,"_15362":79925,"_21301":79926,"_6528":79927},[41736],"/docs/contributing#code-conventions","Code conventions",{"_15044":283,"_41288":272,"_5":41704,"_15362":79929,"_21301":79930,"_6528":79931},[41736],"/docs/contributing#committer-workflow","Committer workflow",{"_15044":284,"_41288":272,"_15362":79933,"_5":14925,"_21301":79894,"_6528":79934},[41736],"The general process for contributing code to Phoenix works as follows:",{"_15044":285,"_41288":272,"_15362":79936,"_5":14925,"_21301":79894,"_6528":79937},[41736],"Discuss your changes on the dev mailing list",{"_15044":286,"_41288":272,"_15362":79939,"_5":14925,"_21301":79894,"_6528":79940},[41736],"Create a JIRA issue unless there already is one",{"_15044":287,"_41288":272,"_15362":79942,"_5":14925,"_21301":79894,"_6528":79446},[41736],{"_15044":288,"_41288":272,"_15362":79944,"_5":14925,"_21301":79894,"_6528":79945},[41736],"Prepare a patch containing your changes",{"_15044":289,"_41288":272,"_15362":79947,"_5":14925,"_21301":79894,"_6528":79948},[41736],"Submit the patch",{"_15044":290,"_41288":272,"_15362":79950,"_5":14925,"_21301":79894,"_6528":79951},[41736],"These steps are explained in greater detail below.",{"_15044":291,"_41288":272,"_15362":79953,"_5":14925,"_21301":79894,"_6528":79954},[41736],"Note that the instructions below are for the main Phoenix project.\nUse the corresponding repository for the other subprojects.\nTephra and Omid also have their own JIRA projects.",{"_15044":292,"_41288":272,"_15362":79956,"_5":14925,"_21301":79898,"_6528":79957},[41736],"It's often best to discuss a change on the public mailing lists before creating and submitting a patch.",{"_15044":293,"_41288":272,"_15362":79959,"_5":14925,"_21301":79898,"_6528":79960},[41736],"If you're unsure whether certain behavior in Phoenix is a bug, please send a mail to the user mailing list to check.",{"_15044":294,"_41288":272,"_15362":79962,"_5":14925,"_21301":79898,"_6528":79963},[41736],"If you're considering adding major new functionality to Phoenix, it's a good idea to first discuss the idea on the developer mailing list to make sure that your plans are in line with others in the Phoenix community.",{"_15044":295,"_41288":272,"_15362":79965,"_5":14925,"_21301":79902,"_6528":79966},[41736],"The first step is to create a ticket on the Phoenix JIRA.",{"_15044":296,"_41288":272,"_15362":79968,"_5":14925,"_21301":79906,"_6528":79969},[41736],"To set up your development environment, see these directions.",{"_15044":297,"_41288":272,"_15362":79971,"_5":14925,"_21301":79910,"_6528":79972},[41736],"There are two general approaches for creating and submitting a patch: GitHub pull requests, or manual patch creation with Git. Both are explained below. Please make sure that the patch applies cleanly on all active branches, including master and the unified 4.x branch.",{"_15044":298,"_41288":272,"_15362":79974,"_5":14925,"_21301":79910,"_6528":79975},[41736],"Regardless of which approach is taken, please make sure to follow the Phoenix code conventions (more information below). Whenever possible, unit tests or integration tests should be included with patches.",{"_15044":299,"_41288":272,"_15362":79977,"_5":14925,"_21301":79910,"_6528":79978},[41736],"Please make sure that the patch contains only one commit, then click the \"Submit patch\" button to automatically trigger tests on the patch.",{"_15044":300,"_41288":272,"_15362":79980,"_5":14925,"_21301":79910,"_6528":79981},[41736],"The commit message should reference the JIRA ticket issue (which has the format\nPHOENIX-{NUMBER}:{JIRA-TITLE}).",{"_15044":301,"_41288":272,"_15362":79983,"_5":14925,"_21301":79910,"_6528":79984},[41736],"To effectively get the patch reviewed, please raise the pull request against an appropriate branch.",{"_15044":302,"_41288":272,"_15362":79986,"_5":14925,"_21301":79914,"_6528":79987},[41736],"When generating a patch, make sure the patch name uses the following format:\nPHOENIX-{NUMBER}.{BRANCH-NAME}.{VERSION}.patch",{"_15044":303,"_41288":272,"_15362":79989,"_5":14925,"_21301":79914,"_6528":79990},[41736],"Examples: PHOENIX-4872.master.v1.patch, PHOENIX-4872.master.v2.patch, PHOENIX-4872.4.x-HBase-1.3.v1.patch, etc.",{"_15044":304,"_41288":272,"_15362":79992,"_5":14925,"_21301":79918,"_6528":79993},[41736],"Create a pull request in GitHub for the mirror of the Phoenix Git repository.",{"_15044":305,"_41288":272,"_15362":79995,"_5":14925,"_21301":79918,"_6528":79996},[41736],"Generate a patch and attach it to JIRA so Hadoop QA runs automated tests.",{"_15044":306,"_41288":272,"_15362":79998,"_5":14925,"_21301":79918,"_6528":79999},[41736],"If you update the PR, generate a new patch with a different name so patch changes are detected and tests run for the new patch.",{"_15044":307,"_41288":272,"_15362":80001,"_5":14925,"_21301":79922,"_6528":80002},[41736],"Create a local branch:",{"_15044":308,"_41288":272,"_15362":80004,"_5":14925,"_21301":79922,"_6528":80005},[41736],"Make and commit changes",{"_15044":309,"_41288":272,"_15362":80007,"_5":14925,"_21301":79922,"_6528":80008},[41736],"Generate a patch based on the JIRA issue number:",{"_15044":310,"_41288":272,"_15362":80010,"_5":14925,"_21301":79922,"_6528":80011},[41736],"Attach the created patch file to the JIRA ticket.",{"_15044":311,"_41288":272,"_15362":80013,"_5":14925,"_21301":79926,"_6528":80014},[41736],"The Phoenix code conventions are similar to the Sun/Oracle Java Code Convention. We use 4 spaces (no tabs) for indentation and limit lines to 100 characters.",{"_15044":312,"_41288":272,"_15362":80016,"_5":14925,"_21301":79926,"_6528":80017},[41736],"Eclipse code formatting settings and import order settings (which can also be imported into Intellij IDEA) are available in the dev directory of the Phoenix codebase.",{"_15044":313,"_41288":272,"_15362":80019,"_5":14925,"_21301":79926,"_6528":80020},[41736],"All new source files should include the Apache license header.",{"_15044":314,"_41288":272,"_15362":80022,"_5":14925,"_21301":79930,"_6528":80023},[41736],"In general, the \"rebase\" workflow should be used with the Phoenix codebase (see this blog post for more information on the difference between \"merge\" and \"rebase\" workflows in Git).",{"_15044":315,"_41288":272,"_15362":80025,"_5":14925,"_21301":79930,"_6528":80026},[41736],"A patch file can be downloaded from a GitHub pull request by adding .patch to the end of the pull request URL, for example: https://github.com/apache/phoenix/pull/35.patch.",{"_15044":316,"_41288":272,"_15362":80028,"_5":14925,"_21301":79930,"_6528":80029},[41736],"When applying a user-contributed patch, use git am when a fully formatted patch file is available, as this preserves contributor contact information. Otherwise, add the contributor's name to the commit message.",{"_15044":317,"_41288":272,"_15362":80031,"_5":14925,"_21301":79930,"_6528":80032},[41736],"If a single ticket consists of a patch with multiple commits, the commits can be squashed into a single commit using git rebase.",{"_15044":318,"_41288":318,"_5":10980,"_6528":80034,"_41707":80035,"_15362":80036,"_21301":318},"Data Types",[79080,79081,79194],[41736],{"_15044":319,"_41288":318,"_15362":80038,"_5":14925,"_21301":318,"_6528":80039},[41736],"SQL data type reference for Apache Phoenix.",{"_15044":320,"_41288":318,"_5":41704,"_15362":80041,"_21301":80042,"_6528":80034},[41736],"/docs/datatypes#data-types",{"_15044":321,"_41288":318,"_5":41704,"_15362":80044,"_21301":80045,"_6528":80046},[41736],"/docs/datatypes#integer-type","INTEGER Type",{"_15044":322,"_41288":318,"_5":41704,"_15362":80048,"_21301":80049,"_6528":80050},[41736],"/docs/datatypes#unsigned_int-type","UNSIGNED_INT Type",{"_15044":323,"_41288":318,"_5":41704,"_15362":80052,"_21301":80053,"_6528":80054},[41736],"/docs/datatypes#bigint-type","BIGINT Type",{"_15044":324,"_41288":318,"_5":41704,"_15362":80056,"_21301":80057,"_6528":80058},[41736],"/docs/datatypes#unsigned_long-type","UNSIGNED_LONG Type",{"_15044":325,"_41288":318,"_5":41704,"_15362":80060,"_21301":80061,"_6528":80062},[41736],"/docs/datatypes#tinyint-type","TINYINT Type",{"_15044":326,"_41288":318,"_5":41704,"_15362":80064,"_21301":80065,"_6528":80066},[41736],"/docs/datatypes#unsigned_tinyint-type","UNSIGNED_TINYINT Type",{"_15044":327,"_41288":318,"_5":41704,"_15362":80068,"_21301":80069,"_6528":80070},[41736],"/docs/datatypes#smallint-type","SMALLINT Type",{"_15044":328,"_41288":318,"_5":41704,"_15362":80072,"_21301":80073,"_6528":80074},[41736],"/docs/datatypes#unsigned_smallint-type","UNSIGNED_SMALLINT Type",{"_15044":329,"_41288":318,"_5":41704,"_15362":80076,"_21301":80077,"_6528":80078},[41736],"/docs/datatypes#float-type","FLOAT Type",{"_15044":330,"_41288":318,"_5":41704,"_15362":80080,"_21301":80081,"_6528":80082},[41736],"/docs/datatypes#unsigned_float-type","UNSIGNED_FLOAT Type",{"_15044":331,"_41288":318,"_5":41704,"_15362":80084,"_21301":80085,"_6528":80086},[41736],"/docs/datatypes#double-type","DOUBLE Type",{"_15044":332,"_41288":318,"_5":41704,"_15362":80088,"_21301":80089,"_6528":80090},[41736],"/docs/datatypes#unsigned_double-type","UNSIGNED_DOUBLE Type",{"_15044":333,"_41288":318,"_5":41704,"_15362":80092,"_21301":80093,"_6528":80094},[41736],"/docs/datatypes#decimal-type","DECIMAL Type",{"_15044":334,"_41288":318,"_5":41704,"_15362":80096,"_21301":80097,"_6528":80098},[41736],"/docs/datatypes#boolean-type","BOOLEAN Type",{"_15044":335,"_41288":318,"_5":41704,"_15362":80100,"_21301":80101,"_6528":80102},[41736],"/docs/datatypes#time-type","TIME Type",{"_15044":336,"_41288":318,"_5":41704,"_15362":80104,"_21301":80105,"_6528":80106},[41736],"/docs/datatypes#date-type","DATE Type",{"_15044":337,"_41288":318,"_5":41704,"_15362":80108,"_21301":80109,"_6528":80110},[41736],"/docs/datatypes#timestamp-type","TIMESTAMP Type",{"_15044":338,"_41288":318,"_5":41704,"_15362":80112,"_21301":80113,"_6528":80114},[41736],"/docs/datatypes#unsigned_time-type","UNSIGNED_TIME Type",{"_15044":339,"_41288":318,"_5":41704,"_15362":80116,"_21301":80117,"_6528":80118},[41736],"/docs/datatypes#unsigned_date-type","UNSIGNED_DATE Type",{"_15044":340,"_41288":318,"_5":41704,"_15362":80120,"_21301":80121,"_6528":80122},[41736],"/docs/datatypes#unsigned_timestamp-type","UNSIGNED_TIMESTAMP Type",{"_15044":341,"_41288":318,"_5":41704,"_15362":80124,"_21301":80125,"_6528":80126},[41736],"/docs/datatypes#varchar-type","VARCHAR Type",{"_15044":342,"_41288":318,"_5":41704,"_15362":80128,"_21301":80129,"_6528":80130},[41736],"/docs/datatypes#char-type","CHAR Type",{"_15044":343,"_41288":318,"_5":41704,"_15362":80132,"_21301":80133,"_6528":80134},[41736],"/docs/datatypes#binary-type","BINARY Type",{"_15044":344,"_41288":318,"_5":41704,"_15362":80136,"_21301":80137,"_6528":80138},[41736],"/docs/datatypes#varbinary-type","VARBINARY Type",{"_15044":345,"_41288":318,"_5":41704,"_15362":80140,"_21301":80141,"_6528":80142},[41736],"/docs/datatypes#array","ARRAY",{"_15044":346,"_41288":318,"_15362":80144,"_5":14925,"_21301":80045,"_6528":80145},[41736],"Possible values: -2147483648 to 2147483647.",{"_15044":347,"_41288":318,"_15362":80147,"_5":14925,"_21301":80045,"_6528":80148},[41736],"Mapped to java.lang.Integer. The binary representation is a 4 byte integer with the sign bit flipped (so that negative values sorts before positive values).",{"_15044":348,"_41288":318,"_15362":80150,"_5":14925,"_21301":80045,"_6528":80151},[41736],"Example",{"_15044":349,"_41288":318,"_15362":80153,"_5":14925,"_21301":80049,"_6528":80154},[41736],"Possible values: 0 to 2147483647. Mapped to java.lang.Integer. The binary representation is a 4 byte integer, matching the Bytes.toBytes(int) method. The purpose of this type is to map to existing HBase data that was serialized using this HBase utility method. If that is not the case, use the regular signed type instead.",{"_15044":350,"_41288":318,"_15362":80156,"_5":14925,"_21301":80049,"_6528":80151},[41736],{"_15044":351,"_41288":318,"_15362":80158,"_5":14925,"_21301":80053,"_6528":80159},[41736],"Possible values: -9223372036854775808 to 9223372036854775807. Mapped to java.lang.Long. The binary representation is an 8 byte long with the sign bit flipped (so that negative values sorts before positive values).",{"_15044":352,"_41288":318,"_15362":80161,"_5":14925,"_21301":80053,"_6528":80151},[41736],{"_15044":353,"_41288":318,"_15362":80163,"_5":14925,"_21301":80057,"_6528":80164},[41736],"Possible values: 0 to 9223372036854775807. Mapped to java.lang.Long. The binary representation is an 8 byte integer, matching the Bytes.toBytes(long) method. The purpose of this type is to map to existing HBase data that was serialized using this HBase utility method. If that is not the case, use the regular signed type instead.",{"_15044":354,"_41288":318,"_15362":80166,"_5":14925,"_21301":80057,"_6528":80151},[41736],{"_15044":355,"_41288":318,"_15362":80168,"_5":14925,"_21301":80061,"_6528":80169},[41736],"Possible values: -128 to 127. Mapped to java.lang.Byte. The binary representation is a single byte, with the sign bit flipped (so that negative values sorts before positive values).",{"_15044":356,"_41288":318,"_15362":80171,"_5":14925,"_21301":80061,"_6528":80151},[41736],{"_15044":357,"_41288":318,"_15362":80173,"_5":14925,"_21301":80065,"_6528":80174},[41736],"Possible values: 0 to 127. Mapped to java.lang.Byte. The binary representation is a single byte, matching the Bytes.toBytes(byte) method. The purpose of this type is to map to existing HBase data that was serialized using this HBase utility method. If that is not the case, use the regular signed type instead.",{"_15044":358,"_41288":318,"_15362":80176,"_5":14925,"_21301":80065,"_6528":80151},[41736],{"_15044":359,"_41288":318,"_15362":80178,"_5":14925,"_21301":80069,"_6528":80179},[41736],"Possible values: -32768 to 32767. Mapped to java.lang.Short. The binary representation is a 2 byte short with the sign bit flipped (so that negative values sort before positive values).",{"_15044":360,"_41288":318,"_15362":80181,"_5":14925,"_21301":80069,"_6528":80151},[41736],{"_15044":361,"_41288":318,"_15362":80183,"_5":14925,"_21301":80073,"_6528":80184},[41736],"Possible values: 0 to 32767. Mapped to java.lang.Short. The binary representation is an 2 byte integer, matching the Bytes.toBytes(short) method. The purpose of this type is to map to existing HBase data that was serialized using this HBase utility method. If that is not the case, use the regular signed type instead.",{"_15044":362,"_41288":318,"_15362":80186,"_5":14925,"_21301":80073,"_6528":80151},[41736],{"_15044":363,"_41288":318,"_15362":80188,"_5":14925,"_21301":80077,"_6528":80189},[41736],"Possible values: -3.402823466 E + 38 to 3.402823466 E + 38. Mapped to java.lang.Float. The binary representation is an 4 byte float with the sign bit flipped (so that negative values sort before positive values).",{"_15044":364,"_41288":318,"_15362":80191,"_5":14925,"_21301":80077,"_6528":80151},[41736],{"_15044":365,"_41288":318,"_15362":80193,"_5":14925,"_21301":80081,"_6528":80194},[41736],"Possible values: 0 to 3.402823466 E + 38. Mapped to java.lang.Float. The binary representation is an 4 byte float matching the Bytes.toBytes(float) method. The purpose of this type is to map to existing HBase data that was serialized using this HBase utility method. If that is not the case, use the regular signed type instead.",{"_15044":366,"_41288":318,"_15362":80196,"_5":14925,"_21301":80081,"_6528":80151},[41736],{"_15044":367,"_41288":318,"_15362":80198,"_5":14925,"_21301":80085,"_6528":80199},[41736],"Possible values: -1.7976931348623158 E + 308 to 1.7976931348623158 E + 308. Mapped to java.lang.Double. The binary representation is an 8 byte double with the sign bit flipped (so that negative values sort before positive value).",{"_15044":368,"_41288":318,"_15362":80201,"_5":14925,"_21301":80085,"_6528":80151},[41736],{"_15044":369,"_41288":318,"_15362":80203,"_5":14925,"_21301":80089,"_6528":80204},[41736],"Possible values: 0 to  1.7976931348623158 E + 308. Mapped to java.lang.Double. The binary representation is an 8 byte double matching the Bytes.toBytes(double) method. The purpose of this type is to map to existing HBase data that was serialized using this HBase utility method. If that is not the case, use the regular signed type instead.",{"_15044":370,"_41288":318,"_15362":80206,"_5":14925,"_21301":80089,"_6528":80151},[41736],{"_15044":371,"_41288":318,"_15362":80208,"_5":14925,"_21301":80093,"_6528":80209},[41736],"Data type with fixed precision and scale. A user can specify precision and scale by expression DECIMAL(precision,scale) in a DDL statement, for example, DECIMAL(10,2). The maximum precision is 38 digits. Mapped to java.math.BigDecimal. The binary representation is binary comparable, variable length format. When used in a row key, it is terminated with a null byte unless it is the last column.",{"_15044":372,"_41288":318,"_15362":80211,"_5":14925,"_21301":80093,"_6528":80151},[41736],{"_15044":373,"_41288":318,"_15362":80213,"_5":14925,"_21301":80097,"_6528":80214},[41736],"Possible values: TRUE and FALSE.",{"_15044":374,"_41288":318,"_15362":80216,"_5":14925,"_21301":80097,"_6528":80217},[41736],"Mapped to java.lang.Boolean. The binary representation is a single byte with 0 for false and 1 for true",{"_15044":375,"_41288":318,"_15362":80219,"_5":14925,"_21301":80097,"_6528":80151},[41736],{"_15044":376,"_41288":318,"_15362":80221,"_5":14925,"_21301":80101,"_6528":80222},[41736],"The time data type. The format is yyyy-MM-dd hh:mm:ss, with both the date and time parts maintained. Mapped to java.sql.Time. The binary representation is an 8 byte long (the number of milliseconds from the epoch), making it possible (although not necessarily recommended) to store more information within a TIME column than what is provided by \"java.sql.Time\". Note that the internal representation is based on a number of milliseconds since the epoch (which is based on a time in GMT), while \"java.sql.Time\" will format times based on the client's local time zone. Please note that this TIME type is different than the TIME type as defined by the SQL 92 standard in that it includes year, month, and day components. As such, it is not in compliance with the JDBC APIs. As the underlying data is still stored as a long, only the presentation of the value is incorrect.",{"_15044":377,"_41288":318,"_15362":80224,"_5":14925,"_21301":80101,"_6528":80151},[41736],{"_15044":378,"_41288":318,"_15362":80226,"_5":14925,"_21301":80105,"_6528":80227},[41736],"The date data type. The format is yyyy-MM-dd hh:mm:ss, with both the date and time parts maintained to a millisecond accuracy. Mapped to java.sql.Date. The binary representation is an 8 byte long (the number of milliseconds from the epoch), making it possible (although not necessarily recommended) to store more information within a DATE column than what is provided by \"java.sql.Date\". Note that the internal representation is based on a number of milliseconds since the epoch (which is based on a time in GMT), while \"java.sql.Date\" will format dates based on the client's local time zone. Please note that this DATE type is different than the DATE type as defined by the SQL 92 standard in that it includes a time component. As such, it is not in compliance with the JDBC APIs. As the underlying data is still stored as a long, only the presentation of the value is incorrect.",{"_15044":379,"_41288":318,"_15362":80229,"_5":14925,"_21301":80105,"_6528":80151},[41736],{"_15044":380,"_41288":318,"_15362":80231,"_5":14925,"_21301":80109,"_6528":80232},[41736],"The timestamp data type. The format is yyyy-MM-dd hh:mm:ss[.nnnnnnnnn]. Mapped to java.sql.Timestamp with an internal representation of the number of nanos from the epoch. The binary representation is 12 bytes: an 8 byte long for the epoch time plus a 4 byte integer for the nanos. Note that the internal representation is based on a number of milliseconds since the epoch (which is based on a time in GMT), while \"java.sql.Timestamp\" will format timestamps based on the client's local time zone.",{"_15044":381,"_41288":318,"_15362":80234,"_5":14925,"_21301":80109,"_6528":80151},[41736],{"_15044":382,"_41288":318,"_15362":80236,"_5":14925,"_21301":80113,"_6528":80237},[41736],"The unsigned time data type. The format is yyyy-MM-dd hh:mm:ss, with both the date and time parts maintained to the millisecond accuracy. Mapped to java.sql.Time. The binary representation is an 8 byte long (the number of milliseconds from the epoch) matching the HBase.toBytes(long) method. The purpose of this type is to map to existing HBase data that was serialized using this HBase utility method. If that is not the case, use the regular signed type instead.",{"_15044":383,"_41288":318,"_15362":80239,"_5":14925,"_21301":80113,"_6528":80151},[41736],{"_15044":384,"_41288":318,"_15362":80241,"_5":14925,"_21301":80117,"_6528":80242},[41736],"The unsigned date data type. The format is yyyy-MM-dd hh:mm:ss, with both the date and time parts maintained to a millisecond accuracy. Mapped to java.sql.Date. The binary representation is an 8 byte long (the number of milliseconds from the epoch) matching the HBase.toBytes(long) method. The purpose of this type is to map to existing HBase data that was serialized using this HBase utility method. If that is not the case, use the regular signed type instead.",{"_15044":385,"_41288":318,"_15362":80244,"_5":14925,"_21301":80117,"_6528":80151},[41736],{"_15044":386,"_41288":318,"_15362":80246,"_5":14925,"_21301":80121,"_6528":80247},[41736],"The timestamp data type. The format is yyyy-MM-dd hh:mm:ss[.nnnnnnnnn]. Mapped to java.sql.Timestamp with an internal representation of the number of nanos from the epoch. The binary representation is 12 bytes: an 8 byte long for the epoch time plus a 4 byte integer for the nanos with the long serialized through the HBase.toBytes(long) method. The purpose of this type is to map to existing HBase data that was serialized using this HBase utility method. If that is not the case, use the regular signed type instead.",{"_15044":387,"_41288":318,"_15362":80249,"_5":14925,"_21301":80121,"_6528":80151},[41736],{"_15044":388,"_41288":318,"_15362":80251,"_5":14925,"_21301":80125,"_6528":80252},[41736],"A variable length String with an optional max byte length. The binary representation is UTF8 matching the Bytes.toBytes(String) method. When used in a row key, it is terminated with a null byte unless it is the last column.",{"_15044":389,"_41288":318,"_15362":80254,"_5":14925,"_21301":80125,"_6528":80255},[41736],"Mapped to java.lang.String.",{"_15044":390,"_41288":318,"_15362":80257,"_5":14925,"_21301":80125,"_6528":80151},[41736],{"_15044":391,"_41288":318,"_15362":80259,"_5":14925,"_21301":80129,"_6528":80260},[41736],"A fixed length String with single-byte characters. The binary representation is UTF8 matching the Bytes.toBytes(String) method.",{"_15044":392,"_41288":318,"_15362":80262,"_5":14925,"_21301":80129,"_6528":80255},[41736],{"_15044":393,"_41288":318,"_15362":80264,"_5":14925,"_21301":80129,"_6528":80151},[41736],{"_15044":394,"_41288":318,"_15362":80266,"_5":14925,"_21301":80133,"_6528":80267},[41736],"Raw fixed length byte array.",{"_15044":395,"_41288":318,"_15362":80269,"_5":14925,"_21301":80133,"_6528":80270},[41736],"Mapped to byte[].",{"_15044":396,"_41288":318,"_15362":80272,"_5":14925,"_21301":80133,"_6528":80151},[41736],{"_15044":397,"_41288":318,"_15362":80274,"_5":14925,"_21301":80137,"_6528":80275},[41736],"Raw variable length byte array.",{"_15044":398,"_41288":318,"_15362":80277,"_5":14925,"_21301":80137,"_6528":80270},[41736],{"_15044":399,"_41288":318,"_15362":80279,"_5":14925,"_21301":80137,"_6528":80151},[41736],{"_15044":400,"_41288":318,"_15362":80281,"_5":14925,"_21301":80141,"_6528":80282},[41736],"Mapped to java.sql.Array. Every primitive type except for VARBINARY may be declared as an ARRAY. Only single dimensional arrays are supported.",{"_15044":401,"_41288":318,"_15362":80284,"_5":14925,"_21301":80141,"_6528":80151},[41736],{"_15044":402,"_41288":402,"_5":10980,"_6528":80286,"_41707":80287,"_15362":80288,"_21301":402},"Explain Plan",[79080,79081,79194],[41736],{"_15044":403,"_41288":402,"_15362":80290,"_5":14925,"_21301":402,"_6528":80291},[41736],"How to read and use EXPLAIN plans in Apache Phoenix.",{"_15044":404,"_41288":402,"_5":41704,"_15362":80293,"_21301":80294,"_6528":80286},[41736],"/docs/explain-plan#explain-plan-overview",{"_15044":405,"_41288":402,"_5":41704,"_15362":80296,"_21301":80297,"_6528":80298},[41736],"/docs/explain-plan#anatomy-of-an-explain-plan","Anatomy of an Explain Plan",{"_15044":406,"_41288":402,"_5":41704,"_15362":80300,"_21301":80301,"_6528":80151},[41736],"/docs/explain-plan#explain-plan-example",{"_15044":407,"_41288":402,"_5":41704,"_15362":80303,"_21301":80304,"_6528":80305},[41736],"/docs/explain-plan#jdbc-explain-plan-api-and-estimates","JDBC Explain Plan API and Estimates",{"_15044":408,"_41288":402,"_15362":80307,"_5":14925,"_21301":80294,"_6528":80308},[41736],"An EXPLAIN plan tells you a lot about how a query will be run:",{"_15044":409,"_41288":402,"_15362":80310,"_5":14925,"_21301":80294,"_6528":80311},[41736],"All the HBase range queries that will be executed",{"_15044":410,"_41288":402,"_15362":80313,"_5":14925,"_21301":80294,"_6528":80314},[41736],"An estimate of the number of bytes that will be scanned",{"_15044":411,"_41288":402,"_15362":80316,"_5":14925,"_21301":80294,"_6528":80317},[41736],"An estimate of the number of rows that will be traversed",{"_15044":412,"_41288":402,"_15362":80319,"_5":14925,"_21301":80294,"_6528":80320},[41736],"Time at which the above estimate information was collected",{"_15044":413,"_41288":402,"_15362":80322,"_5":14925,"_21301":80294,"_6528":80323},[41736],"Which HBase table will be used for each scan",{"_15044":414,"_41288":402,"_15362":80325,"_5":14925,"_21301":80294,"_6528":80326},[41736],"Which operations (sort, merge, scan, limit) are executed on the client versus the server",{"_15044":415,"_41288":402,"_15362":80328,"_5":14925,"_21301":80294,"_6528":80329},[41736],"Use an EXPLAIN plan to check how a query will run, and consider rewriting queries to meet the following goals:",{"_15044":416,"_41288":402,"_15362":80331,"_5":14925,"_21301":80294,"_6528":80332},[41736],"Emphasize operations on the server rather than the client. Server operations are distributed across the cluster and operate in parallel, while client operations execute within the single client JDBC driver.",{"_15044":417,"_41288":402,"_15362":80334,"_5":14925,"_21301":80294,"_6528":80335},[41736],"Use RANGE SCAN or SKIP SCAN whenever possible rather than TABLE SCAN.",{"_15044":418,"_41288":402,"_15362":80337,"_5":14925,"_21301":80294,"_6528":80338},[41736],"Filter against leading columns in the primary key constraint. This assumes you have designed the primary key to lead with frequently-accessed or frequently-filtered columns as described in “Primary Keys,” above.",{"_15044":419,"_41288":402,"_15362":80340,"_5":14925,"_21301":80294,"_6528":80341},[41736],"If necessary, introduce a local index or a global index that covers your query.",{"_15044":420,"_41288":402,"_15362":80343,"_5":14925,"_21301":80294,"_6528":80344},[41736],"If you have an index that covers your query but the optimizer is not detecting it, try hinting the query:\nSELECT /*+ INDEX() */ …",{"_15044":421,"_41288":402,"_15362":80346,"_5":14925,"_21301":80294,"_6528":80347},[41736],"See also: SQL Language Reference - EXPLAIN",{"_15044":422,"_41288":402,"_15362":80349,"_5":14925,"_21301":80297,"_6528":80350},[41736],"An explain plan consists of lines of text that describe operations that Phoenix will perform during a query, using the following terms:",{"_15044":423,"_41288":402,"_15362":80352,"_5":14925,"_21301":80297,"_6528":80353},[41736],"AGGREGATE INTO ORDERED DISTINCT ROWS — aggregates the returned rows using an operation such as addition. When ORDERED is used, the GROUP BY operation is applied to the leading part of the primary key constraint, which allows the aggregation to be done in place rather than keeping all distinct groups in memory on the server side.",{"_15044":424,"_41288":402,"_15362":80355,"_5":14925,"_21301":80297,"_6528":80356},[41736],"AGGREGATE INTO SINGLE ROW — aggregates the results into a single row using an aggregate function with no GROUP BY clause. For example, the count() statement returns one row with the total number of rows that match the query.",{"_15044":425,"_41288":402,"_15362":80358,"_5":14925,"_21301":80297,"_6528":80359},[41736],"CLIENT — the operation will be performed on the client side. It's faster to perform most operations on the server side, so you should consider whether there's a way to rewrite the query to give the server more of the work to do.",{"_15044":426,"_41288":402,"_15362":80361,"_5":14925,"_21301":80297,"_6528":80362},[41736],"FILTER BY expression—returns only results that match the expression.",{"_15044":427,"_41288":402,"_15362":80364,"_5":14925,"_21301":80297,"_6528":80365},[41736],"FULL SCAN OVER tableName—the operation will scan every row in the specified table.",{"_15044":428,"_41288":402,"_15362":80367,"_5":14925,"_21301":80297,"_6528":80368},[41736],"INNER-JOIN — the operation will join multiple tables on rows where the join condition is met.",{"_15044":429,"_41288":402,"_15362":80370,"_5":14925,"_21301":80297,"_6528":80371},[41736],"MERGE SORT — performs a merge sort on the results.",{"_15044":430,"_41288":402,"_15362":80373,"_5":14925,"_21301":80297,"_6528":80374},[41736],"RANGE SCAN OVER tableName [ ... ] — The information in the square brackets indicates the start and stop for each primary key that's used in the query.",{"_15044":431,"_41288":402,"_15362":80376,"_5":14925,"_21301":80297,"_6528":80377},[41736],"ROUND ROBIN — when the query doesn't contain ORDER BY and therefore the rows can be returned in any order, ROUND ROBIN order maximizes parallelization on the client side.",{"_15044":432,"_41288":402,"_15362":80379,"_5":14925,"_21301":80297,"_6528":80380},[41736],"<x>-CHUNK — describes how many threads will be used for the operation. The maximum parallelism is limited to the number of threads in the thread pool. The minimum parallelization corresponds to the number of regions the table has between the start and stop rows of the scan. The number of chunks will increase with a lower guidepost width, as there is more than one chunk per region.",{"_15044":433,"_41288":402,"_15362":80382,"_5":14925,"_21301":80297,"_6528":80383},[41736],"PARALLEL <x>-WAY — describes how many parallel scans will be merge sorted during the operation.",{"_15044":434,"_41288":402,"_15362":80385,"_5":14925,"_21301":80297,"_6528":80386},[41736],"SERIAL — some queries run serially. For example, a single row lookup or a query that filters on the leading part of the primary key and limits the results below a configurable threshold.",{"_15044":435,"_41288":402,"_15362":80388,"_5":14925,"_21301":80297,"_6528":80389},[41736],"EST_BYTES_READ - provides an estimate of the total number of bytes that will be scanned as part of executing the query.",{"_15044":436,"_41288":402,"_15362":80391,"_5":14925,"_21301":80297,"_6528":80392},[41736],"EST_ROWS_READ - provides an estimate of the total number of rows that will be scanned as part of executing the query.",{"_15044":437,"_41288":402,"_15362":80394,"_5":14925,"_21301":80297,"_6528":80395},[41736],"EST_INFO_TS - epoch time in milliseconds at which the estimate information was collected.",{"_15044":438,"_41288":402,"_15362":80397,"_5":14925,"_21301":80304,"_6528":80398},[41736],"The information displayed in the explain plan API can also be accessed programmatically through the standard JDBC interfaces. When statistics collection\nis enabled for a table, the explain plan also gives an estimate of number of rows and bytes a query is going to scan. To get hold of the info, you can\nuse corresponding columns in the result set returned by the explain plan statement. When stats collection is not enabled or if for some reason\nPhoenix cannot provide the estimate information, the columns return null. Below is an example:",{"_15044":439,"_41288":439,"_5":10980,"_6528":80400,"_41707":80401,"_15362":80402,"_21301":439},"FAQ",[79080,79081,79348],[41736],{"_15044":440,"_41288":439,"_15362":80404,"_5":14925,"_21301":439,"_6528":80405},[41736],"Frequently asked question about Phoenix",{"_15044":441,"_41288":439,"_5":41704,"_15362":80407,"_21301":80408,"_6528":80409},[41736],"/docs/faq#questions-answered-in-this-page","Questions answered in this page:",{"_15044":442,"_41288":439,"_5":41704,"_15362":80411,"_21301":80412,"_6528":80413},[41736],"/docs/faq#i-want-to-get-started-is-there-a-phoenix-hello-world","I want to get started. Is there a Phoenix Hello World?",{"_15044":443,"_41288":439,"_5":41704,"_15362":80415,"_21301":80416,"_6528":80417},[41736],"/docs/faq#using-console","Using console",{"_15044":444,"_41288":439,"_5":41704,"_15362":80419,"_21301":80420,"_6528":80421},[41736],"/docs/faq#using-java","Using Java",{"_15044":445,"_41288":439,"_5":41704,"_15362":80423,"_21301":80424,"_6528":80425},[41736],"/docs/faq#what-is-the-phoenix-jdbc-url-syntax","What is the Phoenix JDBC URL syntax?",{"_15044":446,"_41288":439,"_5":41704,"_15362":80427,"_21301":80428,"_6528":80429},[41736],"/docs/faq#thick-driver","Thick Driver",{"_15044":447,"_41288":439,"_5":41704,"_15362":80431,"_21301":80432,"_6528":80433},[41736],"/docs/faq#thin-driver","Thin Driver",{"_15044":448,"_41288":439,"_5":41704,"_15362":80435,"_21301":80436,"_6528":80437},[41736],"/docs/faq#is-there-a-way-to-bulk-load-in-phoenix","Is there a way to bulk load in Phoenix?",{"_15044":449,"_41288":439,"_5":41704,"_15362":80439,"_21301":80440,"_6528":80441},[41736],"/docs/faq#map-reduce","Map Reduce",{"_15044":450,"_41288":439,"_5":41704,"_15362":80443,"_21301":80444,"_6528":80445},[41736],"/docs/faq#csv","CSV",{"_15044":451,"_41288":439,"_5":41704,"_15362":80447,"_21301":80448,"_6528":80449},[41736],"/docs/faq#how-i-map-phoenix-table-to-an-existing-hbase-table","How I map Phoenix table to an existing HBase table?",{"_15044":452,"_41288":439,"_5":41704,"_15362":80451,"_21301":80452,"_6528":80453},[41736],"/docs/faq#are-there-any-tips-for-optimizing-phoenix","Are there any tips for optimizing Phoenix?",{"_15044":453,"_41288":439,"_5":41704,"_15362":80455,"_21301":80456,"_6528":80457},[41736],"/docs/faq#how-do-i-create-secondary-index-on-a-table","How do I create Secondary Index on a table?",{"_15044":454,"_41288":439,"_5":41704,"_15362":80459,"_21301":80460,"_6528":80461},[41736],"/docs/faq#why-isnt-my-secondary-index-being-used","Why isn't my secondary index being used?",{"_15044":455,"_41288":439,"_5":41704,"_15362":80463,"_21301":80464,"_6528":80465},[41736],"/docs/faq#how-fast-is-phoenix-why-is-it-so-fast","How fast is Phoenix? Why is it so fast?",{"_15044":456,"_41288":439,"_5":41704,"_15362":80467,"_21301":80468,"_6528":80469},[41736],"/docs/faq#how-do-i-connect-to-secure-hbase-cluster","How do I connect to secure HBase cluster?",{"_15044":457,"_41288":439,"_5":41704,"_15362":80471,"_21301":80472,"_6528":80473},[41736],"/docs/faq#what-hbase-and-hadoop-versions-are-supported","What HBase and Hadoop versions are supported?",{"_15044":458,"_41288":439,"_5":41704,"_15362":80475,"_21301":80476,"_6528":80477},[41736],"/docs/faq#can-phoenix-work-on-tables-with-arbitrary-timestamp-as-flexible-as-hbase-api","Can phoenix work on tables with arbitrary timestamp as flexible as HBase API?",{"_15044":459,"_41288":439,"_5":41704,"_15362":80479,"_21301":80480,"_6528":80481},[41736],"/docs/faq#why-isnt-my-query-doing-a-range-scan","Why isn't my query doing a RANGE SCAN?",{"_15044":460,"_41288":439,"_5":41704,"_15362":80483,"_21301":80484,"_6528":80485},[41736],"/docs/faq#should-i-pool-phoenix-jdbc-connections","Should I pool Phoenix JDBC Connections?",{"_15044":461,"_41288":439,"_5":41704,"_15362":80487,"_21301":80488,"_6528":80489},[41736],"/docs/faq#why-does-phoenix-add-an-emptydummy-keyvalue-when-doing-an-upsert","Why does Phoenix add an empty/dummy KeyValue when doing an upsert?",{"_15044":462,"_41288":439,"_15362":80491,"_5":14925,"_21301":80408,"_6528":80413},[41736],{"_15044":463,"_41288":439,"_15362":80493,"_5":14925,"_21301":80408,"_6528":80425},[41736],{"_15044":464,"_41288":439,"_15362":80495,"_5":14925,"_21301":80408,"_6528":80437},[41736],{"_15044":465,"_41288":439,"_15362":80497,"_5":14925,"_21301":80408,"_6528":80449},[41736],{"_15044":466,"_41288":439,"_15362":80499,"_5":14925,"_21301":80408,"_6528":80453},[41736],{"_15044":467,"_41288":439,"_15362":80501,"_5":14925,"_21301":80408,"_6528":80457},[41736],{"_15044":468,"_41288":439,"_15362":80503,"_5":14925,"_21301":80408,"_6528":80461},[41736],{"_15044":469,"_41288":439,"_15362":80505,"_5":14925,"_21301":80408,"_6528":80465},[41736],{"_15044":470,"_41288":439,"_15362":80507,"_5":14925,"_21301":80408,"_6528":80469},[41736],{"_15044":471,"_41288":439,"_15362":80509,"_5":14925,"_21301":80408,"_6528":80473},[41736],{"_15044":472,"_41288":439,"_15362":80511,"_5":14925,"_21301":80408,"_6528":80477},[41736],{"_15044":473,"_41288":439,"_15362":80513,"_5":14925,"_21301":80408,"_6528":80481},[41736],{"_15044":474,"_41288":439,"_15362":80515,"_5":14925,"_21301":80408,"_6528":80485},[41736],{"_15044":475,"_41288":439,"_15362":80517,"_5":14925,"_21301":80408,"_6528":80518},[41736],"Why does Phoenix add an empty or dummy KeyValue when doing an upsert?",{"_15044":476,"_41288":439,"_15362":80520,"_5":14925,"_21301":80412,"_6528":80521},[41736],"Pre-requisite: Download and install the latest Phoenix.",{"_15044":477,"_41288":439,"_15362":80523,"_5":14925,"_21301":80416,"_6528":80524},[41736],"Start Sqlline:",{"_15044":478,"_41288":439,"_15362":80526,"_5":14925,"_21301":80416,"_6528":80527},[41736],"Execute the following statements when Sqlline connects:",{"_15044":479,"_41288":439,"_15362":80529,"_5":14925,"_21301":80416,"_6528":80530},[41736],"You should get the following output:",{"_15044":480,"_41288":439,"_15362":80532,"_5":14925,"_21301":80420,"_6528":80533},[41736],"Create test.java file with the following content:",{"_15044":481,"_41288":439,"_15362":80535,"_5":14925,"_21301":80420,"_6528":80536},[41736],"Compile and execute on command line",{"_15044":482,"_41288":439,"_15362":80538,"_5":14925,"_21301":80420,"_6528":80539},[41736],"You should get the following output",{"_15044":483,"_41288":439,"_15362":80541,"_5":14925,"_21301":80428,"_6528":80542},[41736],"See Using the Phoenix JDBC Driver for a more up-to-date description",{"_15044":484,"_41288":439,"_15362":80544,"_5":14925,"_21301":80428,"_6528":80545},[41736],"The Phoenix (Thick) Driver JDBC URL syntax is as follows (where elements in square brackets are optional):",{"_15044":485,"_41288":439,"_15362":80547,"_5":14925,"_21301":80428,"_6528":80548},[41736],"The simplest URL is:",{"_15044":486,"_41288":439,"_15362":80550,"_5":14925,"_21301":80428,"_6528":80551},[41736],"Whereas the most complicated URL is:",{"_15044":487,"_41288":439,"_15362":80553,"_5":14925,"_21301":80428,"_6528":80554},[41736],"Please note that each optional element in the URL requires all previous optional elements. For example, to specify the\nHBase root ZNode, the ZooKeeper port must also be specified.",{"_15044":488,"_41288":439,"_15362":80556,"_5":14925,"_21301":80428,"_6528":80557},[41736],"See also Connection String.",{"_15044":489,"_41288":439,"_15362":80559,"_5":14925,"_21301":80432,"_6528":80560},[41736],"The Phoenix Thin Driver (used with the Phoenix Query Server) JDBC URL syntax is as follows:",{"_15044":490,"_41288":439,"_15362":80562,"_5":14925,"_21301":80432,"_6528":80563},[41736],"There are a number of keys exposed for client-use. The most commonly-used keys are: url and serialization. The url\nkey is required to interact with the Phoenix Query Server.",{"_15044":491,"_41288":439,"_15362":80565,"_5":14925,"_21301":80432,"_6528":80548},[41736],{"_15044":492,"_41288":439,"_15362":80567,"_5":14925,"_21301":80432,"_6528":80568},[41736],"Where as very complicated URL is:",{"_15044":493,"_41288":439,"_15362":80570,"_5":14925,"_21301":80432,"_6528":80571},[41736],"Please refer to the Apache Avatica documentation for a full list of supported options in the Thin client JDBC URL,\nor see the Query Server documentation",{"_15044":494,"_41288":439,"_15362":80573,"_5":14925,"_21301":80440,"_6528":80574},[41736],"See the example here",{"_15044":495,"_41288":439,"_15362":80576,"_5":14925,"_21301":80444,"_6528":80577},[41736],"CSV data can be bulk loaded with built in utility named psql. Typical upsert rates are 20K - 50K rows per second (depends on how wide are the rows).",{"_15044":496,"_41288":439,"_15362":80579,"_5":14925,"_21301":80444,"_6528":80580},[41736],"Usage example:",{"_15044":497,"_41288":439,"_15362":80582,"_5":14925,"_21301":80444,"_6528":80583},[41736],"Create table using psql:",{"_15044":498,"_41288":439,"_15362":80585,"_5":14925,"_21301":80444,"_6528":80586},[41736],"Upsert CSV bulk data:",{"_15044":499,"_41288":439,"_15362":80588,"_5":14925,"_21301":80448,"_6528":80589},[41736],"You can create both a Phoenix table or view through the CREATE TABLE/CREATE VIEW DDL statement on a pre-existing HBase table. In both cases, we'll leave the HBase metadata as-is. For CREATE TABLE, we'll create any metadata (table, column families) that doesn't already exist. We'll also add an empty key value for each row so that queries behave as expected (without requiring all columns to be projected during scans).",{"_15044":500,"_41288":439,"_15362":80591,"_5":14925,"_21301":80448,"_6528":80592},[41736],"The other caveat is that the way the bytes were serialized must match the way the bytes are serialized by Phoenix. For VARCHAR, CHAR, and UNSIGNED_* types, we use the HBase Bytes methods. The CHAR type expects only single-byte characters and the UNSIGNED types expect values greater than or equal to zero. For signed types (TINYINT, SMALLINT, INTEGER and BIGINT), Phoenix will flip the first bit so that negative values will sort before positive values. Because HBase sorts row keys in lexicographical order and negative value's first bit is 1 while positive 0 so that negative value is 'greater than' positive value if we don't flip the first bit. So if you stored integers by HBase native API and want to access them by Phoenix, make sure that all your data types are UNSIGNED types.",{"_15044":501,"_41288":439,"_15362":80594,"_5":14925,"_21301":80448,"_6528":80595},[41736],"Our composite row keys are formed by simply concatenating the values together, with a zero byte character used as a separator after a variable length type.",{"_15044":502,"_41288":439,"_15362":80597,"_5":14925,"_21301":80448,"_6528":80598},[41736],"If you create an HBase table like this:",{"_15044":503,"_41288":439,"_15362":80600,"_5":14925,"_21301":80448,"_6528":80601},[41736],"then you have an HBase table with a name of t1 and a column family with a name of f1. Remember, in HBase, you don't model the possible KeyValues or the structure of the row key. This is the information you specify in Phoenix above and beyond the table and column family.",{"_15044":504,"_41288":439,"_15362":80603,"_5":14925,"_21301":80448,"_6528":80604},[41736],"So in Phoenix, you'd create a view like this:",{"_15044":505,"_41288":439,"_15362":80606,"_5":14925,"_21301":80448,"_6528":80607},[41736],"The pk column declares that your row key is a VARCHAR (i.e. a string) while the \"f1\".val column declares that your HBase table will contain KeyValues with a column family and column qualifier of \"f1\":VAL and that their value will be a VARCHAR.",{"_15044":506,"_41288":439,"_15362":80609,"_5":14925,"_21301":80448,"_6528":80610},[41736],"Note that you don't need the double quotes if you create your HBase table with all caps names (since this is how Phoenix normalizes strings, by upper casing them). For example, with:",{"_15044":507,"_41288":439,"_15362":80612,"_5":14925,"_21301":80448,"_6528":80613},[41736],"you could create this Phoenix view:",{"_15044":508,"_41288":439,"_15362":80615,"_5":14925,"_21301":80448,"_6528":80616},[41736],"Or if you're creating new HBase tables, just let Phoenix do everything for you like this (No need to use the HBase shell at all.):",{"_15044":509,"_41288":439,"_15362":80618,"_5":14925,"_21301":80452,"_6528":80619},[41736],"Use Salting to increase read/write performanceSalting can significantly increase read/write performance by pre-splitting the data into multiple regions. Although Salting will yield better performance in most scenarios.Example:",{"_15044":510,"_41288":439,"_15362":80621,"_5":14925,"_21301":80452,"_6528":80622},[41736],"Note: Ideally for a 16 region server cluster with quad-core CPUs, choose salt buckets between 32-64 for optimal performance.",{"_15044":511,"_41288":439,"_15362":80624,"_5":14925,"_21301":80452,"_6528":80625},[41736],"Pre-split tableSalting does automatic table splitting but in case you want to exactly control where table split occurs with out adding extra byte or change row key order then you can pre-split a table.Example:",{"_15044":512,"_41288":439,"_15362":80627,"_5":14925,"_21301":80452,"_6528":80628},[41736],"Use multiple column familiesColumn family contains related data in separate files. If you query use selected columns then it make sense to group those columns together in a column family to improve read performance.Example:Following create table DDL will create two column faimiles A and B.",{"_15044":513,"_41288":439,"_15362":80630,"_5":14925,"_21301":80452,"_6528":80631},[41736],"Use compressionOn disk compression improves performance on large tablesExample:",{"_15044":514,"_41288":439,"_15362":80633,"_5":14925,"_21301":80452,"_6528":80634},[41736],"Create indexes\nSee How do I connect to secure HBase cluster?",{"_15044":515,"_41288":439,"_15362":80636,"_5":14925,"_21301":80452,"_6528":80637},[41736],"Optimize cluster parameters\nSee http://hbase.apache.org/book/performance.html",{"_15044":516,"_41288":439,"_15362":80639,"_5":14925,"_21301":80452,"_6528":80640},[41736],"Optimize Phoenix parameters\nSee Configuration",{"_15044":517,"_41288":439,"_15362":80642,"_5":14925,"_21301":80456,"_6528":80643},[41736],"Starting with Phoenix version 2.1, Phoenix supports index over mutable and immutable data. Note that Phoenix 2.0.x only supports Index over immutable data. Index write performance index with immutable table is slightly faster than mutable table however data in immutable table cannot be updated.",{"_15044":518,"_41288":439,"_15362":80645,"_5":14925,"_21301":80456,"_6528":80646},[41736],"Example:",{"_15044":519,"_41288":439,"_15362":80648,"_5":14925,"_21301":80456,"_6528":80649},[41736],"Create tableImmutable table: create table test (mykey varchar primary key, col1 varchar, col2 varchar) IMMUTABLE_ROWS=true;Mutable table: create table test (mykey varchar primary key, col1 varchar, col2 varchar);",{"_15044":520,"_41288":439,"_15362":80651,"_5":14925,"_21301":80456,"_6528":80652},[41736],"Creating index on col2create index idx on test (col2)",{"_15044":521,"_41288":439,"_15362":80654,"_5":14925,"_21301":80456,"_6528":80655},[41736],"Creating index on col1 and a covered index on col2create index idx on test (col1) include (col2)Upsert rows in this test table and Phoenix query optimizer will choose correct index to use. You can see in explain plan if Phoenix is using the index table. You can also give a hint in Phoenix query to use a specific index.",{"_15044":522,"_41288":439,"_15362":80657,"_5":14925,"_21301":80456,"_6528":80658},[41736],"See Secondary Indexing for further information",{"_15044":523,"_41288":439,"_15362":80660,"_5":14925,"_21301":80460,"_6528":80661},[41736],"The secondary index won't be used unless all columns used in the query are in it ( as indexed or covered columns). All columns making up the primary key of the data table will automatically be included in the index.",{"_15044":524,"_41288":439,"_15362":80663,"_5":14925,"_21301":80460,"_6528":80664},[41736],"Example: DDL create table usertable (id varchar primary key, firstname varchar, lastname varchar); create index idx_name on usertable (firstname);",{"_15044":525,"_41288":439,"_15362":80666,"_5":14925,"_21301":80460,"_6528":80667},[41736],"Query: DDL select id, firstname, lastname from usertable where firstname = 'foo';",{"_15044":526,"_41288":439,"_15362":80669,"_5":14925,"_21301":80460,"_6528":80670},[41736],"Index would not be used in this case as lastname is not part of indexed or covered column. This can be verified by looking at the explain plan. To fix this create index that has either lastname part of index or covered column. Example: create idx_name on usertable (firstname) include (lastname);",{"_15044":527,"_41288":439,"_15362":80672,"_5":14925,"_21301":80460,"_6528":80673},[41736],"You can force Phoenix to use secondary for uncovered columns by specifying an index hint",{"_15044":528,"_41288":439,"_15362":80675,"_5":14925,"_21301":80464,"_6528":80676},[41736],"Phoenix is fast. Full table scan of 100M rows usually completes in 20 seconds (narrow table on a medium sized cluster). This time come down to few milliseconds if query contains filter on key columns. For filters on non-key columns or non-leading key columns, you can add index on these columns which leads to performance equivalent to filtering on key column by making copy of table with indexed column(s) part of key.",{"_15044":529,"_41288":439,"_15362":80678,"_5":14925,"_21301":80464,"_6528":80679},[41736],"Why is Phoenix fast even when doing full scan:",{"_15044":530,"_41288":439,"_15362":80681,"_5":14925,"_21301":80464,"_6528":80682},[41736],"Phoenix chunks up your query using the region boundaries and runs them in parallel on the client using a configurable number of threads.",{"_15044":531,"_41288":439,"_15362":80684,"_5":14925,"_21301":80464,"_6528":80685},[41736],"The aggregation will be done in a coprocessor on the server-side, collapsing the amount of data that gets returned back to the client rather than returning it all.",{"_15044":532,"_41288":439,"_15362":80687,"_5":14925,"_21301":80468,"_6528":80688},[41736],"Specify the principal and corresponding keytab in the JDBC URL as show above.\nFor ancient Phoenix versions heck out the excellent post by Anil Gupta",{"_15044":533,"_41288":439,"_15362":80690,"_5":14925,"_21301":80472,"_6528":80691},[41736],"Phoenix 4.x supports HBase 1.x running on Hadoop 2",{"_15044":534,"_41288":439,"_15362":80693,"_5":14925,"_21301":80472,"_6528":80694},[41736],"Phoenix 5.x supports HBase 2.x running on Hadoop 3",{"_15044":535,"_41288":439,"_15362":80696,"_5":14925,"_21301":80472,"_6528":80697},[41736],"See the release notes and BUILDING in recent releases for the exact versions supported,\nand on how to build Phoenix for specific HBase and Hadoop versions",{"_15044":536,"_41288":439,"_15362":80699,"_5":14925,"_21301":80476,"_6528":80700},[41736],"By default, Phoenix lets HBase manage the timestamps and just shows you the latest values for everything. However, Phoenix also allows arbitrary timestamps to be supplied by the user. To do that you'd specify a CurrentSCN at connection time, like this:",{"_15044":537,"_41288":439,"_15362":80702,"_5":14925,"_21301":80476,"_6528":80703},[41736],"The above is equivalent to doing this with the HBase API:",{"_15044":538,"_41288":439,"_15362":80705,"_5":14925,"_21301":80476,"_6528":80706},[41736],"By specifying a CurrentSCN, you're telling Phoenix that you want everything for that connection to be done at that timestamp. Note that this applies to queries done on the connection as well - for example, a query over myTable above would not see the data it just upserted, since it only sees data that was created before its CurrentSCN property. This provides a way of doing snapshot, flashback, or point-in-time queries.",{"_15044":539,"_41288":439,"_15362":80708,"_5":14925,"_21301":80476,"_6528":80709},[41736],"Keep in mind that creating a new connection is not an expensive operation. The same underlying HConnection is used for all connections to the same cluster, so it's more or less like instantiating a few objects.",{"_15044":540,"_41288":439,"_15362":80711,"_5":14925,"_21301":80480,"_6528":80712},[41736],"RANGE SCAN means that only a subset of the rows in your table will be scanned over. This occurs if you use one or more leading columns from your primary key constraint. Query that is not filtering on leading PK columns ex. select * from test where pk2='x' and pk3='y'; will result in full scan whereas the following query will result in range scan select * from test where pk1='x' and pk2='y';. Note that you can add a secondary index on your pk2 and pk3 columns and that would cause a range scan to be done for the first query (over the index table).",{"_15044":541,"_41288":439,"_15362":80714,"_5":14925,"_21301":80480,"_6528":80715},[41736],"DEGENERATE SCAN means that a query can't possibly return any rows. If we can determine that at compile time, then we don't bother to even run the scan.",{"_15044":542,"_41288":439,"_15362":80717,"_5":14925,"_21301":80480,"_6528":80718},[41736],"FULL SCAN means that all rows of the table will be scanned over (potentially with a filter applied if you have a WHERE clause)",{"_15044":543,"_41288":439,"_15362":80720,"_5":14925,"_21301":80480,"_6528":80721},[41736],"SKIP SCAN means that either a subset or all rows in your table will be scanned over, however it will skip large groups of rows depending on the conditions in your filter. See this blog for more detail. We don't do a SKIP SCAN if you have no filter on the leading primary key columns, but you can force a SKIP SCAN by using the /*+ SKIP_SCAN */ hint. Under some conditions, namely when the cardinality of your leading primary key columns is low, it will be more efficient than a FULL SCAN.",{"_15044":544,"_41288":439,"_15362":80723,"_5":14925,"_21301":80484,"_6528":80724},[41736],"No, it is not necessary to pool Phoenix JDBC Connections.",{"_15044":545,"_41288":439,"_15362":80726,"_5":14925,"_21301":80484,"_6528":80727},[41736],"Phoenix's Connection objects are different from most other JDBC Connections due to the underlying HBase connection. The Phoenix Connection object is designed to be a thin object that is inexpensive to create. If Phoenix Connections are reused, it is possible that the underlying HBase connection is not always left in a healthy state by the previous user. It is better to create new Phoenix Connections to ensure that you avoid any potential issues.",{"_15044":546,"_41288":439,"_15362":80729,"_5":14925,"_21301":80484,"_6528":80730},[41736],"Implementing pooling for Phoenix could be done simply by creating a delegate Connection that instantiates a new Phoenix connection when retrieved from the pool and then closes the connection when returning it to the pool (see PHOENIX-2388).",{"_15044":547,"_41288":439,"_15362":80732,"_5":14925,"_21301":80488,"_6528":80733},[41736],"The empty or dummy KeyValue (with a column qualifier of _0) is needed to ensure that a given column is available\nfor all rows.",{"_15044":548,"_41288":439,"_15362":80735,"_5":14925,"_21301":80488,"_6528":80736},[41736],"As you may know, data is stored in HBase as KeyValues, meaning that\nthe full row key is stored for each column value. This also implies\nthat the row key is not stored at all unless there is at least one\ncolumn stored.",{"_15044":549,"_41288":439,"_15362":80738,"_5":14925,"_21301":80488,"_6528":80739},[41736],"Now consider JDBC row which has an integer primary key, and several\ncolumns which are all null. In order to be able to store the primary\nkey, a KeyValue needs to be stored to show that the row is present at\nall. This column is represented by the empty column that you've\nnoticed. This allows doing a SELECT * FROM TABLE and receiving\nrecords for all rows, even those whose non-pk columns are null.",{"_15044":550,"_41288":439,"_15362":80741,"_5":14925,"_21301":80488,"_6528":80742},[41736],"The same issue comes up even if only one column is null for some (or\nall) records. A scan over Phoenix will include the empty column to\nensure that rows that only consist of the primary key (and have null\nfor all non-key columns) will be included in a scan result.",{"_15044":551,"_41288":551,"_5":10980,"_6528":80744,"_41707":80745,"_15362":80747,"_21301":551},"Atomic Upsert",[79080,79081,79082,80746],"Features",[41736],{"_15044":552,"_41288":551,"_15362":80749,"_5":14925,"_21301":551,"_6528":80750},[41736],"Use UPSERT ... ON DUPLICATE KEY for atomic row-level updates in Phoenix, with examples and limitations.",{"_15044":553,"_41288":551,"_5":41704,"_15362":80752,"_21301":80753,"_6528":80754},[41736],"/docs/features/atomic-upsert#atomic-upsert-examples","Examples",{"_15044":554,"_41288":551,"_5":41704,"_15362":80756,"_21301":80757,"_6528":79202},[41736],"/docs/features/atomic-upsert#atomic-upsert-limitations",{"_15044":555,"_41288":551,"_15362":80759,"_5":14925,"_21301":551,"_6528":80760},[41736],"To support atomic upsert, an optional ON DUPLICATE KEY clause, similar to the MySQL syntax, has been\nincorporated into the UPSERT VALUES command as of Phoenix 4.9. The general syntax is described\nhere. This feature provides a superset of the HBase Increment and\nCheckAndPut functionality to enable atomic upserts. On the server-side, when the commit\nis processed, the row being updated will be locked while the current column values are read and the\nON DUPLICATE KEY clause is executed. Given that the row must be locked and read when the ON DUPLICATE KEY\nclause is used, there will be a performance penalty (much like there is for an HBase Put versus a CheckAndPut).",{"_15044":556,"_41288":551,"_15362":80762,"_5":14925,"_21301":551,"_6528":80763},[41736],"In the presence of the ON DUPLICATE KEY clause, if the row already exists, the VALUES specified will\nbe ignored and instead either:",{"_15044":557,"_41288":551,"_15362":80765,"_5":14925,"_21301":551,"_6528":80766},[41736],"the row will not be updated if ON DUPLICATE KEY IGNORE is specified or",{"_15044":558,"_41288":551,"_15362":80768,"_5":14925,"_21301":551,"_6528":80769},[41736],"the row will be updated (under lock) by executing the expressions following the ON DUPLICATE KEY UPDATE\nclause.",{"_15044":559,"_41288":551,"_15362":80771,"_5":14925,"_21301":551,"_6528":80772},[41736],"Multiple UPSERT statements for the same row in the same commit batch will be processed in the order of their\nexecution. Thus the same result will be produced when auto commit is on or off.",{"_15044":560,"_41288":551,"_15362":80774,"_5":14925,"_21301":80753,"_6528":80775},[41736],"For example, to atomically increment two counter columns, you would execute the following command:",{"_15044":561,"_41288":551,"_15362":80777,"_5":14925,"_21301":80753,"_6528":80778},[41736],"To only update a column if it doesn't yet exist:",{"_15044":562,"_41288":551,"_15362":80780,"_5":14925,"_21301":80753,"_6528":80781},[41736],"Note that arbitrarily complex expressions may be used in this new clause:",{"_15044":563,"_41288":551,"_15362":80783,"_5":14925,"_21301":80757,"_6528":80784},[41736],"The following limitations are enforced for the ON DUPLICATE KEY clause usage:",{"_15044":564,"_41288":551,"_15362":80786,"_5":14925,"_21301":80757,"_6528":80787},[41736],"Primary key columns may not be updated, since this would essentially be creating a new row.",{"_15044":565,"_41288":551,"_15362":80789,"_5":14925,"_21301":80757,"_6528":80790},[41736],"Transactional tables may not use this clause as atomic upserts are already possible through\nexception handling when a conflict occurs.",{"_15044":566,"_41288":551,"_15362":80792,"_5":14925,"_21301":80757,"_6528":80793},[41736],"Immutable tables may not use this clause as by definition there should be no updates to\nexisting rows.",{"_15044":567,"_41288":551,"_15362":80795,"_5":14925,"_21301":80757,"_6528":80796},[41736],"The CURRENT_SCN property may not be set on connection when this clause is used as HBase\ndoes not handle atomicity unless the latest value is being updated.",{"_15044":568,"_41288":551,"_15362":80798,"_5":14925,"_21301":80757,"_6528":80799},[41736],"The same column should not be updated more than once in the same statement.",{"_15044":569,"_41288":551,"_15362":80801,"_5":14925,"_21301":80757,"_6528":80802},[41736],"No aggregation or references to sequences are allowed within the clause.",{"_15044":570,"_41288":551,"_15362":80804,"_5":14925,"_21301":80757,"_6528":80805},[41736],"Global indexes on columns being atomically updated are not supported, as potentially a separate RPC across the wire would be made while the row is under lock to maintain the secondary index.",{"_15044":571,"_41288":571,"_5":10980,"_6528":80807,"_41707":80808,"_15362":80809,"_21301":571},"Bulk Loading",[79080,79081,79082,80746],[41736],{"_15044":572,"_41288":571,"_15362":80811,"_5":14925,"_21301":571,"_6528":80812},[41736],"Load Phoenix tables with PSQL and MapReduce-based CSV/JSON bulk loaders, including options, permissions, and tuning notes.",{"_15044":573,"_41288":571,"_5":41704,"_15362":80814,"_21301":80815,"_6528":80816},[41736],"/docs/features/bulk-loading#sample-data","Sample data",{"_15044":574,"_41288":571,"_5":41704,"_15362":80818,"_21301":80819,"_6528":80820},[41736],"/docs/features/bulk-loading#loading-via-psql","Loading via PSQL",{"_15044":575,"_41288":571,"_5":41704,"_15362":80822,"_21301":80823,"_6528":80824},[41736],"/docs/features/bulk-loading#loading-via-mapreduce","Loading via MapReduce",{"_15044":576,"_41288":571,"_5":41704,"_15362":80826,"_21301":80827,"_6528":80828},[41736],"/docs/features/bulk-loading#notes-on-the-mapreduce-importer","Notes on the MapReduce importer",{"_15044":577,"_41288":571,"_5":41704,"_15362":80830,"_21301":80831,"_6528":80832},[41736],"/docs/features/bulk-loading#permission-issues-when-uploading-hfiles","Permission issues when uploading HFiles",{"_15044":578,"_41288":571,"_5":41704,"_15362":80834,"_21301":80835,"_6528":80836},[41736],"/docs/features/bulk-loading#loading-array-data","Loading array data",{"_15044":579,"_41288":571,"_5":41704,"_15362":80838,"_21301":80839,"_6528":80840},[41736],"/docs/features/bulk-loading#a-note-on-separator-characters","A note on separator characters",{"_15044":580,"_41288":571,"_5":41704,"_15362":80842,"_21301":80843,"_6528":80844},[41736],"/docs/features/bulk-loading#a-note-on-lowercase-tableschema-names","A note on lowercase table/schema names",{"_15044":581,"_41288":571,"_15362":80846,"_5":14925,"_21301":571,"_6528":80847},[41736],"Phoenix provides two methods for bulk loading data into Phoenix tables:",{"_15044":582,"_41288":571,"_15362":80849,"_5":14925,"_21301":571,"_6528":80850},[41736],"Single-threaded client loading tool for CSV-formatted data via the psql command",{"_15044":583,"_41288":571,"_15362":80852,"_5":14925,"_21301":571,"_6528":80853},[41736],"MapReduce-based bulk load tool for CSV and JSON-formatted data",{"_15044":584,"_41288":571,"_15362":80855,"_5":14925,"_21301":571,"_6528":80856},[41736],"The psql tool is typically appropriate for tens of megabytes, while the MapReduce-based loader is typically better for larger load volumes.",{"_15044":585,"_41288":571,"_15362":80858,"_5":14925,"_21301":80815,"_6528":80859},[41736],"For the following examples, assume we have a CSV file named data.csv with this content:",{"_15044":586,"_41288":571,"_15362":80861,"_5":14925,"_21301":80815,"_6528":80862},[41736],"We will use a table with the following structure:",{"_15044":587,"_41288":571,"_15362":80864,"_5":14925,"_21301":80819,"_6528":80865},[41736],"The psql command is invoked via psql.py in the Phoenix bin directory. To load CSV data, provide connection information for your HBase cluster, the target table name, and one or more CSV file paths. All CSV files must use the .csv extension (because arbitrary SQL scripts with the .sql extension can also be supplied on the psql command line).",{"_15044":588,"_41288":571,"_15362":80867,"_5":14925,"_21301":80819,"_6528":80868},[41736],"To load the example data above into HBase running locally:",{"_15044":589,"_41288":571,"_15362":80870,"_5":14925,"_21301":80819,"_6528":80871},[41736],"The following parameters can be used for loading data with psql:",{"_15044":590,"_41288":571,"_15362":80873,"_5":14925,"_21301":80819,"_6528":80874},[41736],"Parameter",{"_15044":591,"_41288":571,"_15362":80876,"_5":14925,"_21301":80819,"_6528":80877},[41736],"Description",{"_15044":592,"_41288":571,"_15362":80879,"_5":14925,"_21301":80819,"_6528":40591},[41736],{"_15044":593,"_41288":571,"_15362":80881,"_5":14925,"_21301":80819,"_6528":80882},[41736],"Provide the target table name. By default, the table name is taken from the CSV file name. This parameter is case-sensitive.",{"_15044":594,"_41288":571,"_15362":80884,"_5":14925,"_21301":80819,"_6528":40617},[41736],{"_15044":595,"_41288":571,"_15362":80886,"_5":14925,"_21301":80819,"_6528":80887},[41736],"Override the column names to which CSV data maps (case-sensitive). A special value of in-line indicates that the first line of the CSV file determines column mapping.",{"_15044":596,"_41288":571,"_15362":80889,"_5":14925,"_21301":80819,"_6528":40631},[41736],{"_15044":597,"_41288":571,"_15362":80891,"_5":14925,"_21301":80819,"_6528":80892},[41736],"Run in strict mode, throwing an error on CSV parsing errors.",{"_15044":598,"_41288":571,"_15362":80894,"_5":14925,"_21301":80819,"_6528":40473},[41736],{"_15044":599,"_41288":571,"_15362":80896,"_5":14925,"_21301":80819,"_6528":80897},[41736],"Supply one or more custom delimiters for CSV parsing.",{"_15044":600,"_41288":571,"_15362":80899,"_5":14925,"_21301":80819,"_6528":40673},[41736],{"_15044":601,"_41288":571,"_15362":80901,"_5":14925,"_21301":80819,"_6528":80902},[41736],"Supply a custom phrase delimiter (defaults to the double quote character).",{"_15044":602,"_41288":571,"_15362":80904,"_5":14925,"_21301":80819,"_6528":40680},[41736],{"_15044":603,"_41288":571,"_15362":80906,"_5":14925,"_21301":80819,"_6528":80907},[41736],"Supply a custom escape character (default is backslash).",{"_15044":604,"_41288":571,"_15362":80909,"_5":14925,"_21301":80819,"_6528":40693},[41736],{"_15044":605,"_41288":571,"_15362":80911,"_5":14925,"_21301":80819,"_6528":80912},[41736],"Supply an array delimiter (explained in more detail below).",{"_15044":606,"_41288":571,"_15362":80914,"_5":14925,"_21301":80823,"_6528":80915},[41736],"For higher-throughput loading distributed across the cluster, the MapReduce loader can be used. This loader first converts data into HFiles, then provides the created HFiles to HBase after HFile creation completes.",{"_15044":607,"_41288":571,"_15362":80917,"_5":14925,"_21301":80823,"_6528":80918},[41736],"The CSV MapReduce loader is launched using the hadoop command with the Phoenix client JAR:",{"_15044":608,"_41288":571,"_15362":80920,"_5":14925,"_21301":80823,"_6528":80921},[41736],"When using Phoenix 4.0 and above, there is a known HBase issue (\"Notice to MapReduce users of HBase 0.96.1 and above\" in the HBase Reference Guide). You should use:",{"_15044":609,"_41288":571,"_15362":80923,"_5":14925,"_21301":80823,"_6528":80924},[41736],"Or:",{"_15044":610,"_41288":571,"_15362":80926,"_5":14925,"_21301":80823,"_6528":80927},[41736],"The JSON MapReduce loader is launched similarly:",{"_15044":611,"_41288":571,"_15362":80929,"_5":14925,"_21301":80823,"_6528":80930},[41736],"The input file must be present on HDFS (not the local filesystem where the command is run).",{"_15044":612,"_41288":571,"_15362":80932,"_5":14925,"_21301":80823,"_6528":80933},[41736],"The following parameters can be used with the MapReduce loader:",{"_15044":613,"_41288":571,"_15362":80935,"_5":14925,"_21301":80823,"_6528":80874},[41736],{"_15044":614,"_41288":571,"_15362":80937,"_5":14925,"_21301":80823,"_6528":80877},[41736],{"_15044":615,"_41288":571,"_15362":80939,"_5":14925,"_21301":80823,"_6528":80940},[41736],"-i,--input",{"_15044":616,"_41288":571,"_15362":80942,"_5":14925,"_21301":80823,"_6528":80943},[41736],"Input CSV path (mandatory)",{"_15044":617,"_41288":571,"_15362":80945,"_5":14925,"_21301":80823,"_6528":80946},[41736],"-t,--table",{"_15044":618,"_41288":571,"_15362":80948,"_5":14925,"_21301":80823,"_6528":80949},[41736],"Phoenix table name (mandatory)",{"_15044":619,"_41288":571,"_15362":80951,"_5":14925,"_21301":80823,"_6528":80952},[41736],"-a,--array-delimiter",{"_15044":620,"_41288":571,"_15362":80954,"_5":14925,"_21301":80823,"_6528":80955},[41736],"Array element delimiter (optional)",{"_15044":621,"_41288":571,"_15362":80957,"_5":14925,"_21301":80823,"_6528":80958},[41736],"-c,--import-columns",{"_15044":622,"_41288":571,"_15362":80960,"_5":14925,"_21301":80823,"_6528":80961},[41736],"Comma-separated list of columns to import",{"_15044":623,"_41288":571,"_15362":80963,"_5":14925,"_21301":80823,"_6528":80964},[41736],"-d,--delimiter",{"_15044":624,"_41288":571,"_15362":80966,"_5":14925,"_21301":80823,"_6528":80967},[41736],"Input delimiter (defaults to comma)",{"_15044":625,"_41288":571,"_15362":80969,"_5":14925,"_21301":80823,"_6528":80970},[41736],"-g,--ignore-errors",{"_15044":626,"_41288":571,"_15362":80972,"_5":14925,"_21301":80823,"_6528":80973},[41736],"Ignore input errors",{"_15044":627,"_41288":571,"_15362":80975,"_5":14925,"_21301":80823,"_6528":80976},[41736],"-o,--output",{"_15044":628,"_41288":571,"_15362":80978,"_5":14925,"_21301":80823,"_6528":80979},[41736],"Output path for temporary HFiles (optional)",{"_15044":629,"_41288":571,"_15362":80981,"_5":14925,"_21301":80823,"_6528":80982},[41736],"-s,--schema",{"_15044":630,"_41288":571,"_15362":80984,"_5":14925,"_21301":80823,"_6528":80985},[41736],"Phoenix schema name (optional)",{"_15044":631,"_41288":571,"_15362":80987,"_5":14925,"_21301":80823,"_6528":80988},[41736],"-z,--zookeeper",{"_15044":632,"_41288":571,"_15362":80990,"_5":14925,"_21301":80823,"_6528":80991},[41736],"ZooKeeper quorum to connect to (optional)",{"_15044":633,"_41288":571,"_15362":80993,"_5":14925,"_21301":80823,"_6528":80994},[41736],"-it,--index-table",{"_15044":634,"_41288":571,"_15362":80996,"_5":14925,"_21301":80823,"_6528":80997},[41736],"Index table name to load (optional)",{"_15044":635,"_41288":571,"_15362":80999,"_5":14925,"_21301":80827,"_6528":81000},[41736],"The current MR-based bulk loader runs one MR job to load your data table and one MR job per index table to populate indexes. Use -it to load only one index table.",{"_15044":636,"_41288":571,"_15362":81002,"_5":14925,"_21301":80831,"_6528":81003},[41736],"There can be issues due to file permissions on created HFiles in the final stage of a bulk load, when HFiles are handed over to HBase. HBase must be able to move the created HFiles, which means it needs write access to the directories where files were written. If not, HFile upload may hang for a long time before failing.",{"_15044":637,"_41288":571,"_15362":81005,"_5":14925,"_21301":80831,"_6528":81006},[41736],"Two common workarounds are:",{"_15044":638,"_41288":571,"_15362":81008,"_5":14925,"_21301":80831,"_6528":81009},[41736],"Run the bulk load process as the hbase user.",{"_15044":639,"_41288":571,"_15362":81011,"_5":14925,"_21301":80831,"_6528":81012},[41736],"Create output files readable/writable for all users.",{"_15044":640,"_41288":571,"_15362":81014,"_5":14925,"_21301":80831,"_6528":81015},[41736],"The first option can be done by running:",{"_15044":641,"_41288":571,"_15362":81017,"_5":14925,"_21301":80831,"_6528":81018},[41736],"Creating output files readable by all can be done by setting fs.permissions.umask-mode to 000. This can be set in Hadoop config on the submit host, or only for job submission:",{"_15044":642,"_41288":571,"_15362":81020,"_5":14925,"_21301":80835,"_6528":81021},[41736],"Both PSQL and MapReduce loaders support array values with -a. Arrays in CSV are represented by a field that uses a different delimiter than the main CSV delimiter. For example, this file represents an id field and an array of integers:",{"_15044":643,"_41288":571,"_15362":81023,"_5":14925,"_21301":80835,"_6528":81024},[41736],"To load this file, use the default CSV delimiter (comma) and pass colon as the array delimiter via -a ':'.",{"_15044":644,"_41288":571,"_15362":81026,"_5":14925,"_21301":80839,"_6528":81027},[41736],"The default separator for both loaders is comma (,). A common separator for input files is tab, which can be tricky to pass on the command line. A common mistake is:",{"_15044":645,"_41288":571,"_15362":81029,"_5":14925,"_21301":80839,"_6528":81030},[41736],"This does not work because the shell passes two characters (backslash and t) to Phoenix.",{"_15044":646,"_41288":571,"_15362":81032,"_5":14925,"_21301":80839,"_6528":81033},[41736],"Two working approaches:",{"_15044":647,"_41288":571,"_15362":81035,"_5":14925,"_21301":80839,"_6528":81036},[41736],"Prefix the string representation of tab with $:",{"_15044":648,"_41288":571,"_15362":81038,"_5":14925,"_21301":80839,"_6528":81039},[41736],"Enter the separator as Ctrl+v and then press tab:",{"_15044":649,"_41288":571,"_15362":81041,"_5":14925,"_21301":80843,"_6528":81042},[41736],"Table names in Phoenix are case-insensitive (generally uppercase), but users may need to map an existing lowercase HBase table name into Phoenix. In this case, double quotes around the table name (for example, \"tablename\") preserve case sensitivity.",{"_15044":650,"_41288":571,"_15362":81044,"_5":14925,"_21301":80843,"_6528":81045},[41736],"This support was extended to bulk load options. However, due to how Apache Commons CLI parses command-line options (CLI-275), pass the argument as \\\"\\\"tablename\\\"\\\" instead of just \"tablename\" for CsvBulkLoadTool.",{"_15044":651,"_41288":571,"_15362":81047,"_5":14925,"_21301":80843,"_6528":80646},[41736],{"_15044":652,"_41288":652,"_5":10980,"_6528":81049,"_41707":81050,"_15362":81051,"_21301":652},"Cursor",[79080,79081,79082,80746],[41736],{"_15044":653,"_41288":652,"_15362":81053,"_5":14925,"_21301":652,"_6528":81054},[41736],"Use CURSOR statements in Phoenix to process query results in controlled row batches.",{"_15044":654,"_41288":652,"_5":41704,"_15362":81056,"_21301":81057,"_6528":81058},[41736],"/docs/features/cursor#using-a-cursor","Using a cursor",{"_15044":655,"_41288":652,"_15362":81060,"_5":14925,"_21301":652,"_6528":81061},[41736],"To work on a subset of rows from a query, Phoenix supports a CURSOR control structure. The sequence below shows how to use a cursor.",{"_15044":656,"_41288":652,"_15362":81063,"_5":14925,"_21301":81057,"_6528":81064},[41736],"Define a cursor for a query using the DECLARE statement.",{"_15044":657,"_41288":652,"_15362":81066,"_5":14925,"_21301":81057,"_6528":81067},[41736],"Open the cursor.",{"_15044":658,"_41288":652,"_15362":81069,"_5":14925,"_21301":81057,"_6528":81070},[41736],"Fetch a subset of rows to work with.",{"_15044":659,"_41288":652,"_15362":81072,"_5":14925,"_21301":81057,"_6528":81073},[41736],"Iterate through the fetched rows and process them as required.",{"_15044":660,"_41288":652,"_15362":81075,"_5":14925,"_21301":81057,"_6528":81076},[41736],"Fetch additional sets of rows as needed, and close the cursor when done.",{"_15044":661,"_41288":661,"_5":10980,"_6528":81078,"_41707":81079,"_15362":81080,"_21301":661},"Dynamic Columns",[79080,79081,79082,80746],[41736],{"_15044":662,"_41288":661,"_15362":81082,"_5":14925,"_21301":661,"_6528":81083},[41736],"Define and query late-bound dynamic columns in Phoenix when full schema cannot be declared upfront.",{"_15044":663,"_41288":661,"_15362":81085,"_5":14925,"_21301":661,"_6528":81086},[41736],"Sometimes defining a static schema up front is not feasible. Instead, a subset of columns may be specified at table create time while the rest are specified at query time. As of Phoenix 1.2, dynamic columns are supported by allowing column definitions in parentheses after the table name in the FROM clause of a SELECT statement. Although this is not standard SQL, it is useful for leveraging the late-binding capability of HBase.",{"_15044":664,"_41288":661,"_15362":81088,"_5":14925,"_21301":661,"_6528":81089},[41736],"For example:",{"_15044":665,"_41288":661,"_15362":81091,"_5":14925,"_21301":661,"_6528":81092},[41736],"You might define only a subset of event columns at create time, because each event type can have different properties:",{"_15044":666,"_41288":661,"_15362":81094,"_5":14925,"_21301":661,"_6528":81095},[41736],"To upsert a row with dynamic columns:",{"_15044":667,"_41288":667,"_5":10980,"_6528":81097,"_41707":81098,"_15362":81099,"_21301":667},"Metrics",[79080,79081,79082,80746],[41736],{"_15044":668,"_41288":667,"_15362":81101,"_5":14925,"_21301":667,"_6528":81102},[41736],"Request-level and global Phoenix client metrics, with practical usage patterns and Java examples.",{"_15044":669,"_41288":667,"_5":41704,"_15362":81104,"_21301":81105,"_6528":81106},[41736],"/docs/features/metrics#request-level-metrics","Request-level metrics",{"_15044":670,"_41288":667,"_5":41704,"_15362":81108,"_21301":81109,"_6528":81110},[41736],"/docs/features/metrics#mutation-metrics","Mutation metrics",{"_15044":671,"_41288":667,"_5":41704,"_15362":81112,"_21301":81113,"_6528":81114},[41736],"/docs/features/metrics#scan-task-metrics","Scan task metrics",{"_15044":672,"_41288":667,"_5":41704,"_15362":81116,"_21301":81117,"_6528":81118},[41736],"/docs/features/metrics#overall-query-metrics","Overall query metrics",{"_15044":673,"_41288":667,"_5":41704,"_15362":81120,"_21301":81121,"_6528":81122},[41736],"/docs/features/metrics#how-to-use-sql-statement-level-metrics","How to use SQL statement-level metrics",{"_15044":674,"_41288":667,"_15362":81124,"_5":14925,"_21301":667,"_6528":81125},[41736],"Phoenix surfaces various metrics that provide an insight into what is going on within the Phoenix client as it is executing various SQL statements. These metrics are collected within the client JVM in two ways:",{"_15044":675,"_41288":667,"_15362":81127,"_5":14925,"_21301":667,"_6528":81128},[41736],"Request level metrics - collected at an individual SQL statement level",{"_15044":676,"_41288":667,"_15362":81130,"_5":14925,"_21301":667,"_6528":81131},[41736],"Global metrics - collected at the client JVM level",{"_15044":677,"_41288":667,"_15362":81133,"_5":14925,"_21301":667,"_6528":81134},[41736],"Request level metrics are helpful for figuring out at a more granular level about the amount of work done by every SQL statement executed by Phoenix. These metrics can be classified into three categories:",{"_15044":678,"_41288":667,"_15362":81136,"_5":14925,"_21301":81109,"_6528":81137},[41736],"MUTATION_BATCH_SIZE - Batch sizes of mutations",{"_15044":679,"_41288":667,"_15362":81139,"_5":14925,"_21301":81109,"_6528":81140},[41736],"MUTATION_BYTES - Size of mutations in bytes",{"_15044":680,"_41288":667,"_15362":81142,"_5":14925,"_21301":81109,"_6528":81143},[41736],"MUTATION_COMMIT_TIME - Time it took to commit mutations",{"_15044":681,"_41288":667,"_15362":81145,"_5":14925,"_21301":81113,"_6528":81146},[41736],"NUM_PARALLEL_SCANS - Number of scans executed in parallel",{"_15044":682,"_41288":667,"_15362":81148,"_5":14925,"_21301":81113,"_6528":81149},[41736],"SCAN_BYTES - Number of bytes read by scans",{"_15044":683,"_41288":667,"_15362":81151,"_5":14925,"_21301":81113,"_6528":81152},[41736],"MEMORY_CHUNK_BYTES - Number of bytes allocated by the memory manager",{"_15044":684,"_41288":667,"_15362":81154,"_5":14925,"_21301":81113,"_6528":81155},[41736],"MEMORY_WAIT_TIME - Time in milliseconds threads needed to wait for memory to be allocated through memory manager",{"_15044":685,"_41288":667,"_15362":81157,"_5":14925,"_21301":81113,"_6528":81158},[41736],"SPOOL_FILE_SIZE - Size of spool files created in bytes",{"_15044":686,"_41288":667,"_15362":81160,"_5":14925,"_21301":81113,"_6528":81161},[41736],"SPOOL_FILE_COUNTER - Number of spool files created",{"_15044":687,"_41288":667,"_15362":81163,"_5":14925,"_21301":81113,"_6528":81164},[41736],"CACHE_REFRESH_SPLITS_COUNTER - Number of times Phoenix's metadata cache was refreshed because of splits",{"_15044":688,"_41288":667,"_15362":81166,"_5":14925,"_21301":81113,"_6528":81167},[41736],"TASK_QUEUE_WAIT_TIME - Time in milliseconds tasks had to wait in the queue of the thread pool executor",{"_15044":689,"_41288":667,"_15362":81169,"_5":14925,"_21301":81113,"_6528":81170},[41736],"TASK_END_TO_END_TIME - Time in milliseconds spent by tasks from creation to completion",{"_15044":690,"_41288":667,"_15362":81172,"_5":14925,"_21301":81113,"_6528":81173},[41736],"TASK_EXECUTION_TIME - Time in milliseconds tasks took to execute",{"_15044":691,"_41288":667,"_15362":81175,"_5":14925,"_21301":81113,"_6528":81176},[41736],"TASK_EXECUTED_COUNTER - Counter for number of tasks submitted to the thread pool executor",{"_15044":692,"_41288":667,"_15362":81178,"_5":14925,"_21301":81113,"_6528":81179},[41736],"TASK_REJECTED_COUNTER - Counter for number of tasks that were rejected by the thread pool executor",{"_15044":693,"_41288":667,"_15362":81181,"_5":14925,"_21301":81117,"_6528":81182},[41736],"QUERY_TIMEOUT_COUNTER - Number of times query timed out",{"_15044":694,"_41288":667,"_15362":81184,"_5":14925,"_21301":81117,"_6528":81185},[41736],"QUERY_FAILED_COUNTER - Number of times query failed",{"_15044":695,"_41288":667,"_15362":81187,"_5":14925,"_21301":81117,"_6528":81188},[41736],"WALL_CLOCK_TIME_MS - Wall clock time elapsed for the overall query execution",{"_15044":696,"_41288":667,"_15362":81190,"_5":14925,"_21301":81117,"_6528":81191},[41736],"RESULT_SET_TIME_MS - Wall clock time elapsed for reading all records using resultSet.next()",{"_15044":697,"_41288":667,"_15362":81193,"_5":14925,"_21301":81121,"_6528":81194},[41736],"Log and report query execution details which could be later used for analysis.",{"_15044":698,"_41288":667,"_15362":81196,"_5":14925,"_21301":81121,"_6528":81197},[41736],"Report top SQL queries by duration. Metric to use: WALL_CLOCK_TIME_MS.",{"_15044":699,"_41288":667,"_15362":81199,"_5":14925,"_21301":81121,"_6528":81200},[41736],"Check if the query is failing because it is timing out. Metric to use: QUERY_TIMEOUT_COUNTER > 0.",{"_15044":700,"_41288":667,"_15362":81202,"_5":14925,"_21301":81121,"_6528":81203},[41736],"Monitor the amount of bytes being written to or read from HBase for a SQL statement. Metrics to use: MUTATION_BYTES and SCAN_BYTES.",{"_15044":701,"_41288":667,"_15362":81205,"_5":14925,"_21301":81121,"_6528":81206},[41736],"Check if the query is doing too much work or needs tuning. Possible metrics to use: TASK_EXECUTED_COUNTER, TASK_QUEUE_WAIT_TIME, WALL_CLOCK_TIME_MS.",{"_15044":702,"_41288":667,"_15362":81208,"_5":14925,"_21301":81121,"_6528":81209},[41736],"Check if a successful query is facing thread starvation, i.e., number of threads in the thread pool likely needs to be increased. This is characterized by a relatively large difference between TASK_EXECUTION_TIME and TASK_END_TO_END_TIME.",{"_15044":703,"_41288":667,"_15362":81211,"_5":14925,"_21301":81121,"_6528":81212},[41736],"Request level metrics can be turned on/off for every Phoenix JDBC connection. Below is an example of how you can do that:",{"_15044":704,"_41288":667,"_15362":81214,"_5":14925,"_21301":81121,"_6528":81215},[41736],"A typical pattern for how one could get hold of read metrics for queries:",{"_15044":705,"_41288":667,"_15362":81217,"_5":14925,"_21301":81121,"_6528":81218},[41736],"One could also get hold of write related metrics (collected per table) for DML statements by doing something like this:",{"_15044":706,"_41288":667,"_15362":81220,"_5":14925,"_21301":81121,"_6528":81221},[41736],"Global metrics on the other hand are collected at the Phoenix client’s JVM level. These metrics could be used for building out a trend and seeing what is going on within Phoenix from client’s perspective over time. Other than the metrics reported above for request level metrics, the global metrics also includes the following counters:",{"_15044":707,"_41288":667,"_15362":81223,"_5":14925,"_21301":81121,"_6528":81224},[41736],"MUTATION_SQL_COUNTER - Counter for number of mutation SQL statements",{"_15044":708,"_41288":667,"_15362":81226,"_5":14925,"_21301":81121,"_6528":81227},[41736],"SELECT_SQL_COUNTER - Counter for number of SQL queries",{"_15044":709,"_41288":667,"_15362":81229,"_5":14925,"_21301":81121,"_6528":81230},[41736],"OPEN_PHOENIX_CONNECTIONS_COUNTER - Number of open Phoenix connections",{"_15044":710,"_41288":667,"_15362":81232,"_5":14925,"_21301":81121,"_6528":81233},[41736],"Global metrics could be helpful in monitoring and tuning various aspects of the execution environment. For example: an increase in TASK_REJECTED_COUNTER is probably a symptom of too much work being submitted, or that the Phoenix thread pool queue depth or number of threads (or both) needs to be increased. Similarly, a spike in TASK_EXECUTION_TIME for a time frame could be symptomatic of several things including overloaded region servers, a network glitch, or client/region servers undergoing garbage collection.",{"_15044":711,"_41288":667,"_15362":81235,"_5":14925,"_21301":81121,"_6528":81236},[41736],"Collection of global client metrics can be turned on/off (on by default) by setting the attribute phoenix.query.global.metrics.enabled to true/false in the client side hbase-site.xml.\nBelow is a code snippet showing how to log/report global metrics by using a scheduled job that runs periodically:",{"_15044":712,"_41288":712,"_5":10980,"_6528":81238,"_41707":81239,"_15362":81240,"_21301":712},"Multi-tenancy",[79080,79081,79082,80746],[41736],{"_15044":713,"_41288":712,"_15362":81242,"_5":14925,"_21301":712,"_6528":81243},[41736],"Use multi-tenant tables, tenant-specific connections, and tenant views to isolate tenant data in Phoenix.",{"_15044":714,"_41288":712,"_5":41704,"_15362":81245,"_21301":81246,"_6528":81247},[41736],"/docs/features/multi-tenancy#highlights","Highlights",{"_15044":715,"_41288":712,"_5":41704,"_15362":81249,"_21301":81250,"_6528":81251},[41736],"/docs/features/multi-tenancy#multi-tenant-tables","Multi-tenant tables",{"_15044":716,"_41288":712,"_5":41704,"_15362":81253,"_21301":81254,"_6528":81255},[41736],"/docs/features/multi-tenancy#tenant-specific-connections","Tenant-specific connections",{"_15044":717,"_41288":712,"_5":41704,"_15362":81257,"_21301":81258,"_6528":81259},[41736],"/docs/features/multi-tenancy#tenant-specific-views-optional","Tenant-specific views (optional)",{"_15044":718,"_41288":712,"_5":41704,"_15362":81261,"_21301":81262,"_6528":81263},[41736],"/docs/features/multi-tenancy#tenant-data-isolation","Tenant data isolation",{"_15044":719,"_41288":712,"_15362":81265,"_5":14925,"_21301":81246,"_6528":81266},[41736],"Multi-tenancy in Phoenix works via a combination of multi-tenant tables and tenant-specific connections (detailed below).",{"_15044":720,"_41288":712,"_15362":81268,"_5":14925,"_21301":81246,"_6528":81269},[41736],"Tenants open tenant-specific connections to Phoenix. These connections can only access data that belongs to the tenant.",{"_15044":721,"_41288":712,"_15362":81271,"_5":14925,"_21301":81246,"_6528":81272},[41736],"Tenants only see their own data in multi-tenant tables and can see all data in regular tables.",{"_15044":722,"_41288":712,"_15362":81274,"_5":14925,"_21301":81246,"_6528":81275},[41736],"In order to add their own columns, tenants create tenant-specific views on top of multi-tenant tables and add their own columns to the views.",{"_15044":723,"_41288":712,"_15362":81277,"_5":14925,"_21301":81250,"_6528":81278},[41736],"Multi-tenant tables in Phoenix are regular tables declared with the MULTI_TENANT=true DDL property. They work in conjunction with tenant-specific connections (detailed below) to ensure tenants only see their own data in these tables. The first primary key column of a multi-tenant table identifies the tenant. For example:",{"_15044":724,"_41288":712,"_15362":81280,"_5":14925,"_21301":81250,"_6528":81281},[41736],"The column that identifies the tenant may have any name, but it must be of type VARCHAR or CHAR. Regular Phoenix connections work with these tables without tenant constraints, including access across tenant boundaries.",{"_15044":725,"_41288":712,"_15362":81283,"_5":14925,"_21301":81254,"_6528":81284},[41736],"Tenants are identified by the presence or absence of the TenantId property at JDBC connection time. A connection with a non-null TenantId is tenant-specific. A connection with an unspecified or null TenantId is a regular connection. A tenant-specific connection may query only:",{"_15044":726,"_41288":712,"_15362":81286,"_5":14925,"_21301":81254,"_6528":81287},[41736],"all data in non-multi-tenant (global) tables, that is, tables created with a regular connection without MULTI_TENANT=true.",{"_15044":727,"_41288":712,"_15362":81289,"_5":14925,"_21301":81254,"_6528":81290},[41736],"their own data in multi-tenant tables.",{"_15044":728,"_41288":712,"_15362":81292,"_5":14925,"_21301":81254,"_6528":81293},[41736],"their own schema, meaning it sees only tenant-specific views created by that tenant (detailed below).",{"_15044":729,"_41288":712,"_15362":81295,"_5":14925,"_21301":81254,"_6528":81296},[41736],"For example, a tenant-specific connection is established like this:",{"_15044":730,"_41288":712,"_15362":81298,"_5":14925,"_21301":81258,"_6528":81299},[41736],"Tenant-specific views may only be created using tenant-specific connections. They are created the same way as views, however the base table must be a multi-tenant table or another view that eventually points to one. Tenant-specific views are typically used when new columns and/or filter criteria, specific to that tenant, are required. Otherwise the base table may be used directly through a tenant-specific connection as described above.",{"_15044":731,"_41288":712,"_15362":81301,"_5":14925,"_21301":81258,"_6528":81302},[41736],"For example, a tenant-specific view may be defined as follows:",{"_15044":732,"_41288":712,"_15362":81304,"_5":14925,"_21301":81258,"_6528":81305},[41736],"The tenant_id column is neither visible nor accessible from a tenant-specific view. Any reference to it causes a ColumnNotFoundException. As with any Phoenix view, whether the view is updatable follows the rules described here. In addition, indexes may be added to tenant-specific views just like regular tables and views (with these limitations).",{"_15044":733,"_41288":712,"_15362":81307,"_5":14925,"_21301":81262,"_6528":81308},[41736],"Any DML or query performed on multi-tenant tables using a tenant-specific connection is automatically constrained to that tenant’s data. For UPSERT, Phoenix automatically populates the tenant_id column with the tenant ID specified at connection time. For query and DELETE operations, a WHERE clause is transparently added so operations only see data for the current tenant.",{"_15044":734,"_41288":734,"_5":10980,"_6528":81310,"_41707":81311,"_15362":81312,"_21301":734},"Namespace Mapping",[79080,79081,79082,80746],[41736],{"_15044":735,"_41288":734,"_15362":81314,"_5":14925,"_21301":734,"_6528":81315},[41736],"Enable Phoenix schema-to-namespace mapping in HBase, including configuration, migration, and behavior by table type.",{"_15044":736,"_41288":734,"_5":41704,"_15362":81317,"_21301":81318,"_6528":79132},[41736],"/docs/features/namespace-mapping#namespace-mapping-configuration",{"_15044":737,"_41288":734,"_5":41704,"_15362":81320,"_21301":81321,"_6528":81322},[41736],"/docs/features/namespace-mapping#grammar-available","Grammar available",{"_15044":738,"_41288":734,"_5":41704,"_15362":81324,"_21301":81325,"_6528":80400},[41736],"/docs/features/namespace-mapping#namespace-mapping-faq",{"_15044":739,"_41288":734,"_5":41704,"_15362":81327,"_21301":81328,"_6528":81329},[41736],"/docs/features/namespace-mapping#how-to-migrate-existing-tables-with-schema-to-namespace","How to migrate existing tables with schema to namespace",{"_15044":740,"_41288":734,"_5":41704,"_15362":81331,"_21301":81332,"_6528":81333},[41736],"/docs/features/namespace-mapping#how-are-system-tables-migrated","How are system tables migrated",{"_15044":741,"_41288":734,"_5":41704,"_15362":81335,"_21301":81336,"_6528":81337},[41736],"/docs/features/namespace-mapping#what-permissions-are-required-to-create-and-drop-schema","What permissions are required to CREATE and DROP SCHEMA",{"_15044":742,"_41288":734,"_5":41704,"_15362":81339,"_21301":81340,"_6528":81341},[41736],"/docs/features/namespace-mapping#how-are-schemas-mapped-for-different-table-types","How are schemas mapped for different table types",{"_15044":743,"_41288":734,"_5":41704,"_15362":81343,"_21301":81344,"_6528":81345},[41736],"/docs/features/namespace-mapping#what-is-a-namespace-and-what-are-the-benefits-of-mapping-tables-to-namespaces","What is a namespace and what are the benefits of mapping tables to namespaces",{"_15044":744,"_41288":734,"_5":41704,"_15362":81347,"_21301":81348,"_6528":81349},[41736],"/docs/features/namespace-mapping#namespace-mapping-resources","Resources",{"_15044":745,"_41288":734,"_15362":81351,"_5":14925,"_21301":734,"_6528":81352},[41736],"From v4.8.0 onward, users can map Phoenix schemas to HBase namespaces so that any table created with a schema is created in the corresponding HBase namespace.",{"_15044":746,"_41288":734,"_15362":81354,"_5":14925,"_21301":734,"_6528":81355},[41736],"Earlier, every table (with or without schema) was created in the default namespace.",{"_15044":747,"_41288":734,"_15362":81357,"_5":14925,"_21301":81318,"_6528":81358},[41736],"Parameters to enable namespace mapping:",{"_15044":748,"_41288":734,"_15362":81360,"_5":14925,"_21301":81318,"_6528":81361},[41736],"Property",{"_15044":749,"_41288":734,"_15362":81363,"_5":14925,"_21301":81318,"_6528":80877},[41736],{"_15044":750,"_41288":734,"_15362":81365,"_5":14925,"_21301":81318,"_6528":81366},[41736],"Default",{"_15044":751,"_41288":734,"_15362":81368,"_5":14925,"_21301":81318,"_6528":81369},[41736],"phoenix.schema.isNamespaceMappingEnabled",{"_15044":752,"_41288":734,"_15362":81371,"_5":14925,"_21301":81318,"_6528":81372},[41736],"If enabled, tables created with a schema are mapped to the corresponding namespace. This must be set on both client and server. Once enabled, it should not be rolled back. Older clients will not work after this property is enabled.",{"_15044":753,"_41288":734,"_15362":81374,"_5":14925,"_21301":81318,"_6528":22152},[41736],{"_15044":754,"_41288":734,"_15362":81376,"_5":14925,"_21301":81318,"_6528":81377},[41736],"phoenix.schema.mapSystemTablesToNamespace",{"_15044":755,"_41288":734,"_15362":81379,"_5":14925,"_21301":81318,"_6528":81380},[41736],"This takes effect when phoenix.schema.isNamespaceMappingEnabled is also set to true. If enabled, existing SYSTEM tables are automatically migrated to the SYSTEM namespace. If disabled, system tables are created only in the default namespace. This must be set on both client and server.",{"_15044":756,"_41288":734,"_15362":81382,"_5":14925,"_21301":81318,"_6528":13787},[41736],{"_15044":757,"_41288":734,"_15362":81384,"_5":14925,"_21301":81321,"_6528":81385},[41736],"The following DDL statements can be used to interact with schemas:",{"_15044":758,"_41288":734,"_15362":81387,"_5":14925,"_21301":81321,"_6528":81388},[41736],"CREATE SCHEMA",{"_15044":759,"_41288":734,"_15362":81390,"_5":14925,"_21301":81321,"_6528":81391},[41736],"USE SCHEMA",{"_15044":760,"_41288":734,"_15362":81393,"_5":14925,"_21301":81321,"_6528":81394},[41736],"DROP SCHEMA",{"_15044":761,"_41288":734,"_15362":81396,"_5":14925,"_21301":81325,"_6528":81397},[41736],"How to migrate existing tables with schema to namespace?",{"_15044":762,"_41288":734,"_15362":81399,"_5":14925,"_21301":81325,"_6528":81400},[41736],"How are system tables migrated?",{"_15044":763,"_41288":734,"_15362":81402,"_5":14925,"_21301":81325,"_6528":81403},[41736],"What permissions are required to CREATE and DROP SCHEMA?",{"_15044":764,"_41288":734,"_15362":81405,"_5":14925,"_21301":81325,"_6528":81406},[41736],"How are schemas mapped for different table types?",{"_15044":765,"_41288":734,"_15362":81408,"_5":14925,"_21301":81325,"_6528":81409},[41736],"What is a namespace and what are the benefits of mapping tables to namespaces?",{"_15044":766,"_41288":734,"_15362":81411,"_5":14925,"_21301":81328,"_6528":81412},[41736],"For a Kerberized environment, run with a user that has sufficient permission (admin) to create a namespace.",{"_15044":767,"_41288":734,"_15362":81414,"_5":14925,"_21301":81328,"_6528":81415},[41736],"A table is mapped only to a namespace with the same name as the schema (schema_name). Currently, migrating an existing table to a different schema or namespace is not supported.",{"_15044":768,"_41288":734,"_15362":81417,"_5":14925,"_21301":81328,"_6528":80580},[41736],{"_15044":769,"_41288":734,"_15362":81419,"_5":14925,"_21301":81328,"_6528":81420},[41736],"Move table_name to the namespace named schema_name:",{"_15044":770,"_41288":734,"_15362":81422,"_5":14925,"_21301":81332,"_6528":81423},[41736],"SYSTEM tables are migrated automatically during the first connection after enabling phoenix.schema.mapSystemTablesToNamespace along with phoenix.schema.isNamespaceMappingEnabled.",{"_15044":771,"_41288":734,"_15362":81425,"_5":14925,"_21301":81336,"_6528":81426},[41736],"Users must have admin permission in HBase to execute CREATE SCHEMA and DROP SCHEMA, since these commands internally create or delete namespaces.",{"_15044":772,"_41288":734,"_15362":81428,"_5":14925,"_21301":81336,"_6528":81429},[41736],"Details for ACL management in HBase can be found here.",{"_15044":773,"_41288":734,"_15362":81431,"_5":14925,"_21301":81340,"_6528":81432},[41736],"Schema support in Phoenix is similar to other databases.",{"_15044":774,"_41288":734,"_15362":81434,"_5":14925,"_21301":81340,"_6528":81435},[41736],"The table below describes how physical tables map to Phoenix objects:",{"_15044":775,"_41288":734,"_15362":81437,"_5":14925,"_21301":81340,"_6528":81438},[41736],"DDL",{"_15044":776,"_41288":734,"_15362":81440,"_5":14925,"_21301":81340,"_6528":81441},[41736],"Table Type",{"_15044":777,"_41288":734,"_15362":81443,"_5":14925,"_21301":81340,"_6528":81444},[41736],"Physical Table",{"_15044":778,"_41288":734,"_15362":81446,"_5":14925,"_21301":81340,"_6528":80877},[41736],{"_15044":779,"_41288":734,"_15362":81448,"_5":14925,"_21301":81340,"_6528":81449},[41736],"CREATE TABLE S.T (ID INTEGER PRIMARY KEY)",{"_15044":780,"_41288":734,"_15362":81451,"_5":14925,"_21301":81340,"_6528":81452},[41736],"TABLE",{"_15044":781,"_41288":734,"_15362":81454,"_5":14925,"_21301":81340,"_6528":81455},[41736],"S:T",{"_15044":782,"_41288":734,"_15362":81457,"_5":14925,"_21301":81340,"_6528":81458},[41736],"Table T is created in namespace S.",{"_15044":783,"_41288":734,"_15362":81460,"_5":14925,"_21301":81340,"_6528":81461},[41736],"CREATE INDEX IDX ON S.T(ID)",{"_15044":784,"_41288":734,"_15362":81463,"_5":14925,"_21301":81340,"_6528":81464},[41736],"INDEX",{"_15044":785,"_41288":734,"_15362":81466,"_5":14925,"_21301":81340,"_6528":81467},[41736],"S:IDX",{"_15044":786,"_41288":734,"_15362":81469,"_5":14925,"_21301":81340,"_6528":81470},[41736],"Indexes inherit schema and namespace from the base table.",{"_15044":787,"_41288":734,"_15362":81472,"_5":14925,"_21301":81340,"_6528":81473},[41736],"CREATE VIEW V AS SELECT * FROM S.T",{"_15044":788,"_41288":734,"_15362":81475,"_5":14925,"_21301":81340,"_6528":81476},[41736],"VIEW with default schema",{"_15044":789,"_41288":734,"_15362":81478,"_5":14925,"_21301":81340,"_6528":81455},[41736],{"_15044":790,"_41288":734,"_15362":81480,"_5":14925,"_21301":81340,"_6528":81481},[41736],"View does not inherit schema from the parent table and can use the default schema.",{"_15044":791,"_41288":734,"_15362":81483,"_5":14925,"_21301":81340,"_6528":81484},[41736],"CREATE VIEW X.V AS SELECT * FROM S.T",{"_15044":792,"_41288":734,"_15362":81486,"_5":14925,"_21301":81340,"_6528":81487},[41736],"VIEW with different schema than physical table",{"_15044":793,"_41288":734,"_15362":81489,"_5":14925,"_21301":81340,"_6528":81455},[41736],{"_15044":794,"_41288":734,"_15362":81491,"_5":14925,"_21301":81340,"_6528":81492},[41736],"View uses the parent physical table and can have a different (or same) schema.",{"_15044":795,"_41288":734,"_15362":81494,"_5":14925,"_21301":81340,"_6528":81495},[41736],"CREATE VIEW S.V AS SELECT * FROM S.T",{"_15044":796,"_41288":734,"_15362":81497,"_5":14925,"_21301":81340,"_6528":81498},[41736],"VIEW with same schema as physical table",{"_15044":797,"_41288":734,"_15362":81500,"_5":14925,"_21301":81340,"_6528":81455},[41736],{"_15044":798,"_41288":734,"_15362":81502,"_5":14925,"_21301":81340,"_6528":81492},[41736],{"_15044":799,"_41288":734,"_15362":81504,"_5":14925,"_21301":81340,"_6528":81505},[41736],"CREATE INDEX IDX ON S.V(ID)",{"_15044":800,"_41288":734,"_15362":81507,"_5":14925,"_21301":81340,"_6528":81508},[41736],"VIEW INDEX",{"_15044":801,"_41288":734,"_15362":81510,"_5":14925,"_21301":81340,"_6528":81511},[41736],"S:_IDX_T",{"_15044":802,"_41288":734,"_15362":81513,"_5":14925,"_21301":81340,"_6528":81514},[41736],"View indexes inherit schema and map to the corresponding namespace.",{"_15044":803,"_41288":734,"_15362":81516,"_5":14925,"_21301":81344,"_6528":81517},[41736],"A namespace is a logical grouping of tables, analogous to a database in relational database systems. This abstraction lays the groundwork for multi-tenancy-related features:",{"_15044":804,"_41288":734,"_15362":81519,"_5":14925,"_21301":81344,"_6528":81520},[41736],"Quota Management - Restrict the amount of resources (i.e. regions, tables) a namespace can consume.",{"_15044":805,"_41288":734,"_15362":81522,"_5":14925,"_21301":81344,"_6528":81523},[41736],"Namespace Security Administration - Provide another level of security administration for tenants.",{"_15044":806,"_41288":734,"_15362":81525,"_5":14925,"_21301":81344,"_6528":81526},[41736],"Region server groups - A namespace/table can be pinned to a subset of RegionServers, guaranteeing a coarse level of isolation.",{"_15044":807,"_41288":734,"_15362":81528,"_5":14925,"_21301":81344,"_6528":81529},[41736],"Details about namespace management can be read here.",{"_15044":808,"_41288":734,"_15362":81531,"_5":14925,"_21301":81348,"_6528":81532},[41736],"PHOENIX-1311: Implementation details and discussion for the namespace mapping feature.",{"_15044":809,"_41288":809,"_5":10980,"_6528":81534,"_41707":81535,"_15362":81536,"_21301":809},"Paged Queries",[79080,79081,79082,80746],[41736],{"_15044":810,"_41288":809,"_15362":81538,"_5":14925,"_21301":809,"_6528":81539},[41736],"Use row value constructors and OFFSET/LIMIT for efficient paged query patterns in Phoenix.",{"_15044":811,"_41288":809,"_5":41704,"_15362":81541,"_21301":81542,"_6528":81543},[41736],"/docs/features/paged-queries#row-value-constructors-rvc","Row Value Constructors (RVC)",{"_15044":812,"_41288":809,"_5":41704,"_15362":81545,"_21301":81546,"_6528":81547},[41736],"/docs/features/paged-queries#offset-with-limit","OFFSET with LIMIT",{"_15044":813,"_41288":809,"_15362":81549,"_5":14925,"_21301":809,"_6528":81550},[41736],"Phoenix supports standard SQL constructs to enable paged queries:",{"_15044":814,"_41288":809,"_15362":81552,"_5":14925,"_21301":809,"_6528":81543},[41736],{"_15044":815,"_41288":809,"_15362":81554,"_5":14925,"_21301":809,"_6528":81547},[41736],{"_15044":816,"_41288":809,"_15362":81556,"_5":14925,"_21301":81542,"_6528":81557},[41736],"A row value constructor is an ordered sequence of values delimited by parentheses. For example:",{"_15044":817,"_41288":809,"_15362":81559,"_5":14925,"_21301":81542,"_6528":81560},[41736],"Just like regular values, row value constructors may be used in comparison expressions:",{"_15044":818,"_41288":809,"_15362":81562,"_5":14925,"_21301":81542,"_6528":81563},[41736],"Row value constructors are compared by conceptually concatenating the values together and comparing them against each other, with the leftmost part being most significant. Section 8.2 (comparison predicates) of the SQL-92 standard explains this in detail, but here are a few examples of predicates that would evaluate to true:",{"_15044":819,"_41288":809,"_15362":81565,"_5":14925,"_21301":81542,"_6528":81566},[41736],"Row value constructors may also be used in an IN list expression to efficiently query for a set of rows given the composite primary key columns. For example, the following would be optimized to be a point get of three rows:",{"_15044":820,"_41288":809,"_15362":81568,"_5":14925,"_21301":81542,"_6528":81569},[41736],"Another primary use case for row value constructors is to support query-more type functionality by enabling an ordered set of rows to be incrementally stepped through. For example, the following query would step through a set of rows, 20 rows at a time:",{"_15044":821,"_41288":809,"_15362":81571,"_5":14925,"_21301":81542,"_6528":81572},[41736],"Assuming that the client binds the three bind variables to the values of the last row processed, the next invocation would find the next 20 rows that match the query. If the columns you supply in your row value constructor match in order the columns from your primary key (or from a secondary index), then Phoenix will be able to turn the row value constructor expression into the start row of your scan. This enables a very efficient mechanism to locate at or after a row.",{"_15044":822,"_41288":809,"_15362":81574,"_5":14925,"_21301":81546,"_6528":81575},[41736],"Use OFFSET to specify the starting row offset into the result set returned by your query and LIMIT to specify the page size.",{"_15044":823,"_41288":809,"_15362":81577,"_5":14925,"_21301":81546,"_6528":81578},[41736],"For example, if page size is 10, then to select the second page, the following query can be used (rows 11 to 20 are returned):",{"_15044":824,"_41288":809,"_15362":81580,"_5":14925,"_21301":81546,"_6528":81581},[41736],"OFFSET reads and skips rows on either the server or client depending on query type, whereas RVC is more effective for queries on the primary key axis because it can start directly from the provided key.",{"_15044":825,"_41288":825,"_5":10980,"_6528":81583,"_41707":81584,"_15362":81585,"_21301":825},"Query Server",[79080,79081,79082,80746],[41736],{"_15044":826,"_41288":825,"_15362":81587,"_5":14925,"_21301":825,"_6528":81588},[41736],"Deploy and use Phoenix Query Server (PQS), including client access, impersonation, metrics, and load-balancing configuration.",{"_15044":827,"_41288":825,"_5":41704,"_15362":81590,"_21301":81591,"_6528":81592},[41736],"/docs/features/query-server#query-server-overview","Overview",{"_15044":828,"_41288":825,"_5":41704,"_15362":81594,"_21301":81595,"_6528":81596},[41736],"/docs/features/query-server#clients","Clients",{"_15044":829,"_41288":825,"_5":41704,"_15362":81598,"_21301":81599,"_6528":81600},[41736],"/docs/features/query-server#query-server-installation","Installation",{"_15044":830,"_41288":825,"_5":41704,"_15362":81602,"_21301":81603,"_6528":81604},[41736],"/docs/features/query-server#query-server-usage","Usage",{"_15044":831,"_41288":825,"_5":41704,"_15362":81606,"_21301":81607,"_6528":81608},[41736],"/docs/features/query-server#server","Server",{"_15044":832,"_41288":825,"_5":41704,"_15362":81610,"_21301":81611,"_6528":81612},[41736],"/docs/features/query-server#client","Client",{"_15044":833,"_41288":825,"_5":41704,"_15362":81614,"_21301":81615,"_6528":81616},[41736],"/docs/features/query-server#wire-api-documentation","Wire API documentation",{"_15044":834,"_41288":825,"_5":41704,"_15362":81618,"_21301":81619,"_6528":81620},[41736],"/docs/features/query-server#impersonation","Impersonation",{"_15044":835,"_41288":825,"_5":41704,"_15362":81622,"_21301":81623,"_6528":81097},[41736],"/docs/features/query-server#query-server-metrics",{"_15044":836,"_41288":825,"_5":41704,"_15362":81625,"_21301":81626,"_6528":79132},[41736],"/docs/features/query-server#query-server-configuration",{"_15044":837,"_41288":825,"_5":41704,"_15362":81628,"_21301":81629,"_6528":81630},[41736],"/docs/features/query-server#server-instantiation","Server Instantiation",{"_15044":838,"_41288":825,"_5":41704,"_15362":81632,"_21301":81633,"_6528":81634},[41736],"/docs/features/query-server#https","HTTPS",{"_15044":839,"_41288":825,"_5":41704,"_15362":81636,"_21301":81637,"_6528":81638},[41736],"/docs/features/query-server#secure-cluster-connection","Secure Cluster Connection",{"_15044":840,"_41288":825,"_5":41704,"_15362":81640,"_21301":81641,"_6528":81642},[41736],"/docs/features/query-server#server-connection-cache","Server Connection Cache",{"_15044":841,"_41288":825,"_5":41704,"_15362":81644,"_21301":81645,"_6528":81646},[41736],"/docs/features/query-server#server-statement-cache","Server Statement Cache",{"_15044":842,"_41288":825,"_5":41704,"_15362":81648,"_21301":81649,"_6528":81620},[41736],"/docs/features/query-server#impersonation-1",{"_15044":843,"_41288":825,"_5":41704,"_15362":81651,"_21301":81652,"_6528":81097},[41736],"/docs/features/query-server#query-server-metrics-config",{"_15044":844,"_41288":825,"_5":41704,"_15362":81654,"_21301":81655,"_6528":81656},[41736],"/docs/features/query-server#query-server-additions","Query Server Additions",{"_15044":845,"_41288":825,"_5":41704,"_15362":81658,"_21301":81659,"_6528":81660},[41736],"/docs/features/query-server#load-balancing","Load balancing",{"_15044":846,"_41288":825,"_15362":81662,"_5":14925,"_21301":825,"_6528":81663},[41736],"The Phoenix Query Server provides an alternative means for interaction with\nPhoenix and HBase.",{"_15044":847,"_41288":825,"_15362":81665,"_5":14925,"_21301":81591,"_6528":81666},[41736],"Phoenix 4.4 introduces a stand-alone server that exposes Phoenix to \"thin\"\nclients. It is based on the Avatica component of\nApache Calcite. The query server is comprised of a Java server that\nmanages Phoenix Connections on the clients' behalf.",{"_15044":848,"_41288":825,"_15362":81668,"_5":14925,"_21301":81591,"_6528":81669},[41736],"With the introduction of the\nProtobuf transport, Avatica is moving towards backwards compatibility with the\nprovided thin JDBC driver. There are no such backwards compatibility guarantees\nfor the JSON API.",{"_15044":849,"_41288":825,"_15362":81671,"_5":14925,"_21301":81591,"_6528":81672},[41736],"To repeat, there is no guarantee of backwards compatibility with the JSON transport;\nhowever, compatibility with the Protobuf transport is stabilizing (although, not\ntested thoroughly enough to be stated as \"guaranteed\").",{"_15044":850,"_41288":825,"_15362":81674,"_5":14925,"_21301":81595,"_6528":81675},[41736],"The primary client implementation\nis currently a JDBC driver with minimal dependencies. The default and\nprimary transport mechanism since Phoenix 4.7 is Protobuf, the older JSON mechanism can still\nbe enabled.\nThe distribution includes the sqlline-thin.py CLI client that uses the JDBC thin client.",{"_15044":851,"_41288":825,"_15362":81677,"_5":14925,"_21301":81595,"_6528":81678},[41736],"The Phoenix project also maintains the Python driver\nphoenixdb.",{"_15044":852,"_41288":825,"_15362":81680,"_5":14925,"_21301":81595,"_6528":81681},[41736],"The Avatica Go client\ncan also be used.",{"_15044":853,"_41288":825,"_15362":81683,"_5":14925,"_21301":81595,"_6528":81684},[41736],"Proprietary ODBC drivers are also available for Windows and Linux.",{"_15044":854,"_41288":825,"_15362":81686,"_5":14925,"_21301":81599,"_6528":81687},[41736],"In the 4.4-4.14 and 5.0 releases the query server and its JDBC client are part of the standard Phoenix\ndistribution. They require no additional dependencies or installation.",{"_15044":855,"_41288":825,"_15362":81689,"_5":14925,"_21301":81599,"_6528":81690},[41736],"After the 4.15 and 5.1 release, the query server has been unbundled into the phoenix-queryserver\nrepository, and its version number has been reset to 6.0.",{"_15044":856,"_41288":825,"_15362":81692,"_5":14925,"_21301":81599,"_6528":81693},[41736],"Download the latest source or binary release from the\nDownload page,\nor check out the development version from\nGitHub.",{"_15044":857,"_41288":825,"_15362":81695,"_5":14925,"_21301":81599,"_6528":81696},[41736],"Either unpack the binary distribution, or build it from source. See BUILDING.md\nin the source distribution on how to build.",{"_15044":858,"_41288":825,"_15362":81698,"_5":14925,"_21301":81607,"_6528":81699},[41736],"The standalone Query Server distribution does not contain the necessary\nPhoenix (thick) client library by default.",{"_15044":859,"_41288":825,"_15362":81701,"_5":14925,"_21301":81607,"_6528":81702},[41736],"If using the standalone library you will either need to rebuild it from source to include the\nclient library (See BUILDING.md), or manually copy the phoenix thick client library\ninto the installation directory.",{"_15044":860,"_41288":825,"_15362":81704,"_5":14925,"_21301":81607,"_6528":81705},[41736],"The server component is managed through bin/queryserver.py. Its usage is as\nfollows",{"_15044":861,"_41288":825,"_15362":81707,"_5":14925,"_21301":81607,"_6528":81708},[41736],"When invoked with no arguments, the query server is launched in the foreground,\nwith logging directed to the console.",{"_15044":862,"_41288":825,"_15362":81710,"_5":14925,"_21301":81607,"_6528":81711},[41736],"The first argument is an optional start or stop command to the daemon. When\neither of these are provided, it will take appropriate action on a daemon\nprocess, if it exists.",{"_15044":863,"_41288":825,"_15362":81713,"_5":14925,"_21301":81607,"_6528":81714},[41736],"Any subsequent arguments are passed to the main class for interpretation.",{"_15044":864,"_41288":825,"_15362":81716,"_5":14925,"_21301":81607,"_6528":81717},[41736],"The server is packaged in a standalone jar,\nphoenix-queryserver-<version>.jar. This jar, the phoenix-client.jar and HBASE_CONF_DIR on the\nclasspath are all that is required to launch the server.",{"_15044":865,"_41288":825,"_15362":81719,"_5":14925,"_21301":81611,"_6528":81720},[41736],"Phoenix provides two mechanisms for interacting with the query server. A JDBC\ndriver is provided in the standalone\nphoenix-queryserver-client-<version>.jar. The script\nbin/sqlline-thin.py is available for the command line.",{"_15044":866,"_41288":825,"_15362":81722,"_5":14925,"_21301":81611,"_6528":81723},[41736],"The JDBC connection string is composed as follows:",{"_15044":867,"_41288":825,"_15362":81725,"_5":14925,"_21301":81611,"_6528":81726},[41736],"<scheme> specifies the transport protocol (http or https) used when communicating with the\nserver.",{"_15044":868,"_41288":825,"_15362":81728,"_5":14925,"_21301":81611,"_6528":81729},[41736],"<server-hostname> is the name of the host offering the service.",{"_15044":869,"_41288":825,"_15362":81731,"_5":14925,"_21301":81611,"_6528":81732},[41736],"<port> is the port number on which the host is listening. Default is 8765,\nthough this is configurable (see below).",{"_15044":870,"_41288":825,"_15362":81734,"_5":14925,"_21301":81611,"_6528":81735},[41736],"The full list of options that can be provided via the JDBC URL string is available\nin the Avatica documentation.",{"_15044":871,"_41288":825,"_15362":81737,"_5":14925,"_21301":81611,"_6528":81738},[41736],"The script bin/sqlline-thin.py is intended to behave identically to its\nsibling script bin/sqlline.py. It supports the following usage options.",{"_15044":872,"_41288":825,"_15362":81740,"_5":14925,"_21301":81611,"_6528":81741},[41736],"The first optional argument is a connection URL, as described previously. When\nnot provided, scheme defaults to http, host to localhost, and port to\n8765.",{"_15044":873,"_41288":825,"_15362":81743,"_5":14925,"_21301":81611,"_6528":81744},[41736],"The second optional parameter is a sql file from which to read commands.",{"_15044":874,"_41288":825,"_15362":81746,"_5":14925,"_21301":81615,"_6528":81747},[41736],"The API itself is documented in the Apache Calcite project as it is the Avatica\nAPI -- there is no wire API defined in Phoenix itself.",{"_15044":875,"_41288":825,"_15362":81749,"_5":14925,"_21301":81615,"_6528":81750},[41736],"JSON API",{"_15044":876,"_41288":825,"_15362":81752,"_5":14925,"_21301":81615,"_6528":81753},[41736],"Protocol Buffer API",{"_15044":877,"_41288":825,"_15362":81755,"_5":14925,"_21301":81615,"_6528":81756},[41736],"For more information in building clients in other languages that work with\nAvatica, please feel free to reach out to the Apache Calcite dev mailing list.",{"_15044":878,"_41288":825,"_15362":81758,"_5":14925,"_21301":81619,"_6528":81759},[41736],"By default, the Phoenix Query Server executes queries on behalf of the end-user. HBase permissions\nare enforced given the end-user, not the Phoenix Query Server's identity. In some cases, it may\nbe desirable to execute the query as some other user -- this is referred to as \"impersonation\".\nThis can enable workflows where a trusted user has the privilege to run queries for other users.",{"_15044":879,"_41288":825,"_15362":81761,"_5":14925,"_21301":81619,"_6528":81762},[41736],"This can be enabled by setting the configuration property phoenix.queryserver.withRemoteUserExtractor\nto true. The URL of the Query Server can be modified to include the required request parameter.\nFor example, to let \"bob\" to run a query as \"alice\", the following JDBC URL could be used:",{"_15044":880,"_41288":825,"_15362":81764,"_5":14925,"_21301":81619,"_6528":81765},[41736],"The standard Hadoop \"proxyuser\" configuration keys are checked to validate if the \"real\" remote user\nis allowed to impersonate the \"doAs\" user. See the Hadoop documentation\nfor more information on how to configure these rules.",{"_15044":881,"_41288":825,"_15362":81767,"_5":14925,"_21301":81619,"_6528":81768},[41736],"As a word of warning: there is no end-to-end test coverage for the HBase 0.98 and 1.1 Phoenix releases\nbecause of missing test-related code in those HBase releases. While we expect no issues on these\nPhoenix release lines, we recommend additional testing by the user to verify that there are no issues.",{"_15044":882,"_41288":825,"_15362":81770,"_5":14925,"_21301":81623,"_6528":81771},[41736],"By default, the Phoenix Query Server exposes various Phoenix global client metrics via JMX (for HBase versions 1.3 and up).\nThe list of metrics are available here.",{"_15044":883,"_41288":825,"_15362":81773,"_5":14925,"_21301":81623,"_6528":81774},[41736],"PQS Metrics use Hadoop Metrics 2 internally for metrics publishing. Hence it publishes various JVM related metrics. Metrics can be filtered based on certain tags, which can be configured by the property specified in hbase-site.xml on the classpath. Further details are provided in Configuration section.",{"_15044":884,"_41288":825,"_15362":81776,"_5":14925,"_21301":81626,"_6528":81777},[41736],"Server components are spread across a number of java packages, so effective\nlogging configuration requires updating multiple packages. The default server\nlogging configuration sets the following log levels:",{"_15044":885,"_41288":825,"_15362":81779,"_5":14925,"_21301":81626,"_6528":81780},[41736],"As of the time of writing, the underlying Avatica component respects the\nfollowing configuration options exposed via hbase-site.xml.",{"_15044":886,"_41288":825,"_15362":81782,"_5":14925,"_21301":81629,"_6528":81361},[41736],{"_15044":887,"_41288":825,"_15362":81784,"_5":14925,"_21301":81629,"_6528":80877},[41736],{"_15044":888,"_41288":825,"_15362":81786,"_5":14925,"_21301":81629,"_6528":81366},[41736],{"_15044":889,"_41288":825,"_15362":81788,"_5":14925,"_21301":81629,"_6528":81789},[41736],"phoenix.queryserver.http.port",{"_15044":890,"_41288":825,"_15362":81791,"_5":14925,"_21301":81629,"_6528":81792},[41736],"Port the server listens on.",{"_15044":891,"_41288":825,"_15362":81794,"_5":14925,"_21301":81629,"_6528":41050},[41736],{"_15044":892,"_41288":825,"_15362":81796,"_5":14925,"_21301":81629,"_6528":81797},[41736],"phoenix.queryserver.metafactory.class",{"_15044":893,"_41288":825,"_15362":81799,"_5":14925,"_21301":81629,"_6528":81800},[41736],"Avatica Meta.Factory implementation class.",{"_15044":894,"_41288":825,"_15362":81802,"_5":14925,"_21301":81629,"_6528":81803},[41736],"org.apache.phoenix.queryserver.server.PhoenixMetaFactoryImpl",{"_15044":895,"_41288":825,"_15362":81805,"_5":14925,"_21301":81629,"_6528":81806},[41736],"phoenix.queryserver.serialization",{"_15044":896,"_41288":825,"_15362":81808,"_5":14925,"_21301":81629,"_6528":81809},[41736],"Transport/serialization format (PROTOBUF or JSON).",{"_15044":897,"_41288":825,"_15362":81811,"_5":14925,"_21301":81629,"_6528":81812},[41736],"PROTOBUF",{"_15044":898,"_41288":825,"_15362":81814,"_5":14925,"_21301":81633,"_6528":81815},[41736],"HTTPS support is only available in unbundled phoenix-queryserver versions.",{"_15044":899,"_41288":825,"_15362":81817,"_5":14925,"_21301":81633,"_6528":81361},[41736],{"_15044":900,"_41288":825,"_15362":81819,"_5":14925,"_21301":81633,"_6528":80877},[41736],{"_15044":901,"_41288":825,"_15362":81821,"_5":14925,"_21301":81633,"_6528":81366},[41736],{"_15044":902,"_41288":825,"_15362":81823,"_5":14925,"_21301":81633,"_6528":81824},[41736],"phoenix.queryserver.tls.enabled",{"_15044":903,"_41288":825,"_15362":81826,"_5":14925,"_21301":81633,"_6528":81827},[41736],"Enables HTTPS transport. When enabled, keystore/truststore files and passwords are also required.",{"_15044":904,"_41288":825,"_15362":81829,"_5":14925,"_21301":81633,"_6528":22152},[41736],{"_15044":905,"_41288":825,"_15362":81831,"_5":14925,"_21301":81633,"_6528":81832},[41736],"phoenix.queryserver.tls.keystore",{"_15044":906,"_41288":825,"_15362":81834,"_5":14925,"_21301":81633,"_6528":81835},[41736],"Keystore file containing the HTTPS private key.",{"_15044":907,"_41288":825,"_15362":81837,"_5":14925,"_21301":81633,"_6528":21174},[41736],{"_15044":908,"_41288":825,"_15362":81839,"_5":14925,"_21301":81633,"_6528":81840},[41736],"phoenix.queryserver.tls.keystore.password",{"_15044":909,"_41288":825,"_15362":81842,"_5":14925,"_21301":81633,"_6528":81843},[41736],"Password for HTTPS keystore.",{"_15044":910,"_41288":825,"_15362":81845,"_5":14925,"_21301":81633,"_6528":81846},[41736],"empty string",{"_15044":911,"_41288":825,"_15362":81848,"_5":14925,"_21301":81633,"_6528":81849},[41736],"phoenix.queryserver.tls.truststore",{"_15044":912,"_41288":825,"_15362":81851,"_5":14925,"_21301":81633,"_6528":81852},[41736],"Keystore file containing the HTTPS certificate.",{"_15044":913,"_41288":825,"_15362":81854,"_5":14925,"_21301":81633,"_6528":21174},[41736],{"_15044":914,"_41288":825,"_15362":81856,"_5":14925,"_21301":81633,"_6528":81857},[41736],"phoenix.queryserver.tls.truststore.password",{"_15044":915,"_41288":825,"_15362":81859,"_5":14925,"_21301":81633,"_6528":81860},[41736],"Password for HTTPS truststore.",{"_15044":916,"_41288":825,"_15362":81862,"_5":14925,"_21301":81633,"_6528":81846},[41736],{"_15044":917,"_41288":825,"_15362":81864,"_5":14925,"_21301":81637,"_6528":81361},[41736],{"_15044":918,"_41288":825,"_15362":81866,"_5":14925,"_21301":81637,"_6528":80877},[41736],{"_15044":919,"_41288":825,"_15362":81868,"_5":14925,"_21301":81637,"_6528":81366},[41736],{"_15044":920,"_41288":825,"_15362":81870,"_5":14925,"_21301":81637,"_6528":81871},[41736],"hbase.security.authentication",{"_15044":921,"_41288":825,"_15362":81873,"_5":14925,"_21301":81637,"_6528":81874},[41736],"When set to kerberos, server logs in before initiating Phoenix connections.",{"_15044":922,"_41288":825,"_15362":81876,"_5":14925,"_21301":81637,"_6528":81877},[41736],"specified in hbase-default.xml",{"_15044":923,"_41288":825,"_15362":81879,"_5":14925,"_21301":81637,"_6528":81880},[41736],"phoenix.queryserver.keytab.file",{"_15044":924,"_41288":825,"_15362":81882,"_5":14925,"_21301":81637,"_6528":81883},[41736],"Key for keytab file lookup.",{"_15044":925,"_41288":825,"_15362":81885,"_5":14925,"_21301":81637,"_6528":21174},[41736],{"_15044":926,"_41288":825,"_15362":81887,"_5":14925,"_21301":81637,"_6528":81888},[41736],"phoenix.queryserver.kerberos.principal",{"_15044":927,"_41288":825,"_15362":81890,"_5":14925,"_21301":81637,"_6528":81891},[41736],"Kerberos principal for authentication; also used for SPNEGO if HTTP principal is not configured.",{"_15044":928,"_41288":825,"_15362":81893,"_5":14925,"_21301":81637,"_6528":21174},[41736],{"_15044":929,"_41288":825,"_15362":81895,"_5":14925,"_21301":81637,"_6528":81896},[41736],"phoenix.queryserver.http.keytab.file",{"_15044":930,"_41288":825,"_15362":81898,"_5":14925,"_21301":81637,"_6528":81899},[41736],"Keytab for SPNEGO auth; required if phoenix.queryserver.kerberos.http.principal is set; falls back to phoenix.queryserver.keytab.file.",{"_15044":931,"_41288":825,"_15362":81901,"_5":14925,"_21301":81637,"_6528":21174},[41736],{"_15044":932,"_41288":825,"_15362":81903,"_5":14925,"_21301":81637,"_6528":81904},[41736],"phoenix.queryserver.http.kerberos.principal",{"_15044":933,"_41288":825,"_15362":81906,"_5":14925,"_21301":81637,"_6528":81907},[41736],"Kerberos principal for SPNEGO auth; falls back to phoenix.queryserver.kerberos.principal.",{"_15044":934,"_41288":825,"_15362":81909,"_5":14925,"_21301":81637,"_6528":21174},[41736],{"_15044":935,"_41288":825,"_15362":81911,"_5":14925,"_21301":81637,"_6528":81912},[41736],"phoenix.queryserver.kerberos.http.principal",{"_15044":936,"_41288":825,"_15362":81914,"_5":14925,"_21301":81637,"_6528":81915},[41736],"Deprecated; use phoenix.queryserver.http.kerberos.principal.",{"_15044":937,"_41288":825,"_15362":81917,"_5":14925,"_21301":81637,"_6528":21174},[41736],{"_15044":938,"_41288":825,"_15362":81919,"_5":14925,"_21301":81637,"_6528":81920},[41736],"phoenix.queryserver.kerberos.allowed.realms",{"_15044":939,"_41288":825,"_15362":81922,"_5":14925,"_21301":81637,"_6528":81923},[41736],"Additional Kerberos realms allowed for SPNEGO auth.",{"_15044":940,"_41288":825,"_15362":81925,"_5":14925,"_21301":81637,"_6528":21174},[41736],{"_15044":941,"_41288":825,"_15362":81927,"_5":14925,"_21301":81637,"_6528":81928},[41736],"phoenix.queryserver.dns.nameserver",{"_15044":942,"_41288":825,"_15362":81930,"_5":14925,"_21301":81637,"_6528":81931},[41736],"DNS hostname.",{"_15044":943,"_41288":825,"_15362":81933,"_5":14925,"_21301":81637,"_6528":25060},[41736],{"_15044":944,"_41288":825,"_15362":81935,"_5":14925,"_21301":81637,"_6528":81936},[41736],"phoenix.queryserver.dns.interface",{"_15044":945,"_41288":825,"_15362":81938,"_5":14925,"_21301":81637,"_6528":81939},[41736],"Network interface name for DNS queries.",{"_15044":946,"_41288":825,"_15362":81941,"_5":14925,"_21301":81637,"_6528":25060},[41736],{"_15044":947,"_41288":825,"_15362":81943,"_5":14925,"_21301":81641,"_6528":81361},[41736],{"_15044":948,"_41288":825,"_15362":81945,"_5":14925,"_21301":81641,"_6528":80877},[41736],{"_15044":949,"_41288":825,"_15362":81947,"_5":14925,"_21301":81641,"_6528":81366},[41736],{"_15044":950,"_41288":825,"_15362":81949,"_5":14925,"_21301":81641,"_6528":81950},[41736],"avatica.connectioncache.concurrency",{"_15044":951,"_41288":825,"_15362":81952,"_5":14925,"_21301":81641,"_6528":81953},[41736],"Connection cache concurrency level.",{"_15044":952,"_41288":825,"_15362":81955,"_5":14925,"_21301":81641,"_6528":8004},[41736],{"_15044":953,"_41288":825,"_15362":81957,"_5":14925,"_21301":81641,"_6528":81958},[41736],"avatica.connectioncache.initialcapacity",{"_15044":954,"_41288":825,"_15362":81960,"_5":14925,"_21301":81641,"_6528":81961},[41736],"Connection cache initial capacity.",{"_15044":955,"_41288":825,"_15362":81963,"_5":14925,"_21301":81641,"_6528":38941},[41736],{"_15044":956,"_41288":825,"_15362":81965,"_5":14925,"_21301":81641,"_6528":81966},[41736],"avatica.connectioncache.maxcapacity",{"_15044":957,"_41288":825,"_15362":81968,"_5":14925,"_21301":81641,"_6528":81969},[41736],"Connection cache maximum capacity; LRU eviction begins near this point.",{"_15044":958,"_41288":825,"_15362":81971,"_5":14925,"_21301":81641,"_6528":38972},[41736],{"_15044":959,"_41288":825,"_15362":81973,"_5":14925,"_21301":81641,"_6528":81974},[41736],"avatica.connectioncache.expiryduration",{"_15044":960,"_41288":825,"_15362":81976,"_5":14925,"_21301":81641,"_6528":81977},[41736],"Connection cache expiration duration.",{"_15044":961,"_41288":825,"_15362":81979,"_5":14925,"_21301":81641,"_6528":8004},[41736],{"_15044":962,"_41288":825,"_15362":81981,"_5":14925,"_21301":81641,"_6528":81982},[41736],"avatica.connectioncache.expiryunit",{"_15044":963,"_41288":825,"_15362":81984,"_5":14925,"_21301":81641,"_6528":81985},[41736],"Time unit for avatica.connectioncache.expiryduration.",{"_15044":964,"_41288":825,"_15362":81987,"_5":14925,"_21301":81641,"_6528":81988},[41736],"MINUTES",{"_15044":965,"_41288":825,"_15362":81990,"_5":14925,"_21301":81645,"_6528":81361},[41736],{"_15044":966,"_41288":825,"_15362":81992,"_5":14925,"_21301":81645,"_6528":80877},[41736],{"_15044":967,"_41288":825,"_15362":81994,"_5":14925,"_21301":81645,"_6528":81366},[41736],{"_15044":968,"_41288":825,"_15362":81996,"_5":14925,"_21301":81645,"_6528":81997},[41736],"avatica.statementcache.concurrency",{"_15044":969,"_41288":825,"_15362":81999,"_5":14925,"_21301":81645,"_6528":82000},[41736],"Statement cache concurrency level.",{"_15044":970,"_41288":825,"_15362":82002,"_5":14925,"_21301":81645,"_6528":38941},[41736],{"_15044":971,"_41288":825,"_15362":82004,"_5":14925,"_21301":81645,"_6528":82005},[41736],"avatica.statementcache.initialcapacity",{"_15044":972,"_41288":825,"_15362":82007,"_5":14925,"_21301":81645,"_6528":82008},[41736],"Statement cache initial capacity.",{"_15044":973,"_41288":825,"_15362":82010,"_5":14925,"_21301":81645,"_6528":38972},[41736],{"_15044":974,"_41288":825,"_15362":82012,"_5":14925,"_21301":81645,"_6528":82013},[41736],"avatica.statementcache.maxcapacity",{"_15044":975,"_41288":825,"_15362":82015,"_5":14925,"_21301":81645,"_6528":82016},[41736],"Statement cache maximum capacity; LRU eviction begins near this point.",{"_15044":976,"_41288":825,"_15362":82018,"_5":14925,"_21301":81645,"_6528":38987},[41736],{"_15044":977,"_41288":825,"_15362":82020,"_5":14925,"_21301":81645,"_6528":82021},[41736],"avatica.statementcache.expiryduration",{"_15044":978,"_41288":825,"_15362":82023,"_5":14925,"_21301":81645,"_6528":82024},[41736],"Statement cache expiration duration.",{"_15044":979,"_41288":825,"_15362":82026,"_5":14925,"_21301":81645,"_6528":8159},[41736],{"_15044":980,"_41288":825,"_15362":82028,"_5":14925,"_21301":81645,"_6528":82029},[41736],"avatica.statementcache.expiryunit",{"_15044":981,"_41288":825,"_15362":82031,"_5":14925,"_21301":81645,"_6528":82032},[41736],"Time unit for avatica.statementcache.expiryduration.",{"_15044":982,"_41288":825,"_15362":82034,"_5":14925,"_21301":81645,"_6528":81988},[41736],{"_15044":983,"_41288":825,"_15362":82036,"_5":14925,"_21301":81649,"_6528":81361},[41736],{"_15044":984,"_41288":825,"_15362":82038,"_5":14925,"_21301":81649,"_6528":80877},[41736],{"_15044":985,"_41288":825,"_15362":82040,"_5":14925,"_21301":81649,"_6528":81366},[41736],{"_15044":986,"_41288":825,"_15362":82042,"_5":14925,"_21301":81649,"_6528":82043},[41736],"phoenix.queryserver.withRemoteUserExtractor",{"_15044":987,"_41288":825,"_15362":82045,"_5":14925,"_21301":81649,"_6528":82046},[41736],"If true, extracts impersonated user from request param instead of authenticated HTTP user.",{"_15044":988,"_41288":825,"_15362":82048,"_5":14925,"_21301":81649,"_6528":22152},[41736],{"_15044":989,"_41288":825,"_15362":82050,"_5":14925,"_21301":81649,"_6528":82051},[41736],"phoenix.queryserver.remoteUserExtractor.param",{"_15044":990,"_41288":825,"_15362":82053,"_5":14925,"_21301":81649,"_6528":82054},[41736],"HTTP request parameter name for impersonated user.",{"_15044":991,"_41288":825,"_15362":82056,"_5":14925,"_21301":81649,"_6528":82057},[41736],"doAs",{"_15044":992,"_41288":825,"_15362":82059,"_5":14925,"_21301":81652,"_6528":81361},[41736],{"_15044":993,"_41288":825,"_15362":82061,"_5":14925,"_21301":81652,"_6528":80877},[41736],{"_15044":994,"_41288":825,"_15362":82063,"_5":14925,"_21301":81652,"_6528":81366},[41736],{"_15044":995,"_41288":825,"_15362":82065,"_5":14925,"_21301":81652,"_6528":82066},[41736],"phoenix.client.metrics.tag",{"_15044":996,"_41288":825,"_15362":82068,"_5":14925,"_21301":81652,"_6528":82069},[41736],"Tag for filtering Phoenix global client metrics emitted by PQS in hadoop-metrics2.properties.",{"_15044":997,"_41288":825,"_15362":82071,"_5":14925,"_21301":81652,"_6528":82072},[41736],"FAT_CLIENT",{"_15044":998,"_41288":825,"_15362":82074,"_5":14925,"_21301":81655,"_6528":82075},[41736],"The Phoenix Query Server is meant to be horizontally scalable which means that it\nis a natural fit for add-on features like service discovery and load balancing.",{"_15044":999,"_41288":825,"_15362":82077,"_5":14925,"_21301":81659,"_6528":82078},[41736],"The Query Server can use off-the-shelf HTTP load balancers such as the Apache HTTP Server,\nnginx, or HAProxy. The primary requirement of\nusing these load balancers is that the implementation must implement \"sticky session\" (when a client\ncommunicates with a backend server, that client continues to talk to that backend server). The Query Server also\nprovides some bundled functionality for load balancing using ZooKeeper.",{"_15044":1000,"_41288":825,"_15362":82080,"_5":14925,"_21301":81659,"_6528":82081},[41736],"The ZooKeeper-based load balancer functions by automatically registering PQS instances in\nZooKeeper and then allows clients to query the list of available servers. This implementation, unlike\nthe others mentioned above, requires that client use the advertised information to make a routing decision.\nIn this regard, this ZooKeeper-based approach is more akin to a service-discovery layer than a traditional\nload balancer. This load balancer implementation does not support SASL-based (Kerberos) ACLs in\nZooKeeper (see PHOENIX-4085).",{"_15044":1001,"_41288":825,"_15362":82083,"_5":14925,"_21301":81659,"_6528":82084},[41736],"The following properties configure this load balancer:",{"_15044":1002,"_41288":825,"_15362":82086,"_5":14925,"_21301":81659,"_6528":81361},[41736],{"_15044":1003,"_41288":825,"_15362":82088,"_5":14925,"_21301":81659,"_6528":80877},[41736],{"_15044":1004,"_41288":825,"_15362":82090,"_5":14925,"_21301":81659,"_6528":81366},[41736],{"_15044":1005,"_41288":825,"_15362":82092,"_5":14925,"_21301":81659,"_6528":82093},[41736],"phoenix.queryserver.loadbalancer.enabled",{"_15044":1006,"_41288":825,"_15362":82095,"_5":14925,"_21301":81659,"_6528":82096},[41736],"If true, PQS registers itself in ZooKeeper for load balancing.",{"_15044":1007,"_41288":825,"_15362":82098,"_5":14925,"_21301":81659,"_6528":22152},[41736],{"_15044":1008,"_41288":825,"_15362":82100,"_5":14925,"_21301":81659,"_6528":82101},[41736],"phoenix.queryserver.base.path",{"_15044":1009,"_41288":825,"_15362":82103,"_5":14925,"_21301":81659,"_6528":82104},[41736],"Root znode where PQS instances register themselves.",{"_15044":1010,"_41288":825,"_15362":82106,"_5":14925,"_21301":81659,"_6528":82107},[41736],"/phoenix",{"_15044":1011,"_41288":825,"_15362":82109,"_5":14925,"_21301":81659,"_6528":82110},[41736],"phoenix.queryserver.service.name",{"_15044":1012,"_41288":825,"_15362":82112,"_5":14925,"_21301":81659,"_6528":82113},[41736],"Unique name to identify this PQS instance.",{"_15044":1013,"_41288":825,"_15362":82115,"_5":14925,"_21301":81659,"_6528":7951},[41736],{"_15044":1014,"_41288":825,"_15362":82117,"_5":14925,"_21301":81659,"_6528":82118},[41736],"phoenix.queryserver.zookeeper.acl.username",{"_15044":1015,"_41288":825,"_15362":82120,"_5":14925,"_21301":81659,"_6528":82121},[41736],"Username for optional DIGEST ZooKeeper ACL.",{"_15044":1016,"_41288":825,"_15362":82123,"_5":14925,"_21301":81659,"_6528":6566},[41736],{"_15044":1017,"_41288":825,"_15362":82125,"_5":14925,"_21301":81659,"_6528":82126},[41736],"phoenix.queryserver.zookeeper.acl.password",{"_15044":1018,"_41288":825,"_15362":82128,"_5":14925,"_21301":81659,"_6528":82129},[41736],"Password for optional DIGEST ZooKeeper ACL.",{"_15044":1019,"_41288":825,"_15362":82131,"_5":14925,"_21301":81659,"_6528":6566},[41736],{"_15044":1020,"_41288":1020,"_5":10980,"_6528":82133,"_41707":82134,"_15362":82135,"_21301":1020},"Row Timestamp Column",[79080,79081,79082,80746],[41736],{"_15044":1021,"_41288":1020,"_15362":82137,"_5":14925,"_21301":1020,"_6528":82138},[41736],"Map HBase row timestamps to a Phoenix primary-key column and use ROW_TIMESTAMP in table design and upserts.",{"_15044":1022,"_41288":1020,"_5":41704,"_15362":82140,"_21301":82141,"_6528":82142},[41736],"/docs/features/row-timestamp-column#sample-schema","Sample schema",{"_15044":1023,"_41288":1020,"_15362":82144,"_5":14925,"_21301":1020,"_6528":82145},[41736],"Phoenix 4.6 provides a way to map HBase’s native row timestamp to a Phoenix column. This helps you take advantage of HBase optimizations for time ranges in store files, along with query optimizations built into Phoenix.",{"_15044":1024,"_41288":1020,"_15362":82147,"_5":14925,"_21301":1020,"_6528":82148},[41736],"For a column to be designated as ROW_TIMESTAMP, certain constraints need to be followed:",{"_15044":1025,"_41288":1020,"_15362":82150,"_5":14925,"_21301":1020,"_6528":82151},[41736],"Only a primary key column of type TIME, DATE, TIMESTAMP, BIGINT, or UNSIGNED_LONG can be designated as ROW_TIMESTAMP.",{"_15044":1026,"_41288":1020,"_15362":82153,"_5":14925,"_21301":1020,"_6528":82154},[41736],"Only one primary key column can be designated as ROW_TIMESTAMP.",{"_15044":1027,"_41288":1020,"_15362":82156,"_5":14925,"_21301":1020,"_6528":82157},[41736],"The column value cannot be NULL (because it maps directly to the HBase row timestamp). This also means a column can be declared as ROW_TIMESTAMP only when creating the table.",{"_15044":1028,"_41288":1020,"_15362":82159,"_5":14925,"_21301":1020,"_6528":82160},[41736],"A ROW_TIMESTAMP column value cannot be negative. For DATE/TIME/TIMESTAMP, the corresponding epoch time in milliseconds cannot be less than zero.",{"_15044":1029,"_41288":1020,"_15362":82162,"_5":14925,"_21301":1020,"_6528":82163},[41736],"When upserting rows for a table with a row timestamp column (using UPSERT VALUES or UPSERT SELECT), you can explicitly provide the row timestamp value or let Phoenix set it automatically. When not specified, Phoenix sets the row timestamp column value to server-side time. The value also becomes the timestamp of the corresponding row in HBase.",{"_15044":1030,"_41288":1020,"_15362":82165,"_5":14925,"_21301":82141,"_6528":82166},[41736],"This sets CREATED_DATE to the value specified in the corresponding bind parameter.",{"_15044":1031,"_41288":1020,"_15362":82168,"_5":14925,"_21301":82141,"_6528":82169},[41736],"This sets CREATED_DATE to server-side time.",{"_15044":1032,"_41288":1020,"_15362":82171,"_5":14925,"_21301":82141,"_6528":82172},[41736],"This sets CREATED_DATE to the DATE selected from SOURCE_METRICS_TABLE.",{"_15044":1033,"_41288":1020,"_15362":82174,"_5":14925,"_21301":82141,"_6528":82175},[41736],"This sets CREATED_DATE in the destination table to the server timestamp.",{"_15044":1034,"_41288":1020,"_15362":82177,"_5":14925,"_21301":82141,"_6528":82178},[41736],"When querying with filters on the row timestamp column, Phoenix performs its usual row-key optimizations and can also set scan min/max time ranges appropriately. Using this time range information, HBase can skip store files that do not fall in the target time range, which significantly improves performance, especially for tail-end data queries.",{"_15044":1035,"_41288":1035,"_5":10980,"_6528":82180,"_41707":82181,"_15362":82182,"_21301":1035},"Salted Tables",[79080,79081,79082,80746],[41736],{"_15044":1036,"_41288":1035,"_15362":82184,"_5":14925,"_21301":1035,"_6528":82185},[41736],"Use SALT_BUCKETS to reduce HBase hotspotting and understand scan, split, and ordering behavior for salted tables.",{"_15044":1037,"_41288":1035,"_5":41704,"_15362":82187,"_21301":82188,"_6528":82189},[41736],"/docs/features/salted-tables#sequential-scan","Sequential scan",{"_15044":1038,"_41288":1035,"_5":41704,"_15362":82191,"_21301":82192,"_6528":82193},[41736],"/docs/features/salted-tables#splitting","Splitting",{"_15044":1039,"_41288":1035,"_5":41704,"_15362":82195,"_21301":82196,"_6528":82197},[41736],"/docs/features/salted-tables#row-key-ordering","Row key ordering",{"_15044":1040,"_41288":1035,"_5":41704,"_15362":82199,"_21301":82200,"_6528":82201},[41736],"/docs/features/salted-tables#salted-tables-performance","Performance",{"_15044":1041,"_41288":1035,"_15362":82203,"_5":14925,"_21301":1035,"_6528":82204},[41736],"Sequential writes in HBase may suffer from region server hotspotting if your row key is monotonically increasing. Salting the row key helps mitigate this problem. See this article for details.",{"_15044":1042,"_41288":1035,"_15362":82206,"_5":14925,"_21301":1035,"_6528":82207},[41736],"Phoenix provides a way to transparently salt the row key with a salting byte for a table. Specify this at table creation time with the SALT_BUCKETS table property, using a value from 1 to 256:",{"_15044":1043,"_41288":1035,"_15362":82209,"_5":14925,"_21301":1035,"_6528":82210},[41736],"There are some behavior differences and cautions to be aware of when using a salted table.",{"_15044":1044,"_41288":1035,"_15362":82212,"_5":14925,"_21301":82188,"_6528":82213},[41736],"Since a salted table does not store data in natural key sequence, a strict sequential scan does not return data in natural sorted order. Clauses that force sequential scan behavior (for example, LIMIT) may return rows differently compared to a non-salted table.",{"_15044":1045,"_41288":1035,"_15362":82215,"_5":14925,"_21301":82192,"_6528":82216},[41736],"If no split points are specified, a salted table is pre-split on salt-byte boundaries to ensure load distribution across region servers, including during initial table growth. If split points are provided manually, they must include the salt byte.",{"_15044":1046,"_41288":1035,"_15362":82218,"_5":14925,"_21301":82196,"_6528":82219},[41736],"Pre-splitting also ensures that entries in each region start with the same salt byte and are therefore locally sorted. During a parallel scan across regions, Phoenix can use this property to perform a client-side merge sort. The resulting scan can still be returned sequentially, as if from a normal table.",{"_15044":1047,"_41288":1035,"_15362":82221,"_5":14925,"_21301":82196,"_6528":82222},[41736],"This row-key ordered scan can be enabled by setting phoenix.query.rowKeyOrderSaltedTable=true in hbase-site.xml. When enabled, user-specified split points on salted tables are disallowed to ensure each bucket contains only entries with the same salt byte. With this property enabled, a salted table behaves more like a normal table for scans and returns items in row-key order.",{"_15044":1048,"_41288":1035,"_15362":82224,"_5":14925,"_21301":82200,"_6528":82225},[41736],"Using salted tables with pre-splitting helps distribute write workload uniformly across region servers, which improves write performance. Our performance evaluation shows that salted tables can achieve up to 80% higher write throughput than non-salted tables.",{"_15044":1049,"_41288":1035,"_15362":82227,"_5":14925,"_21301":82200,"_6528":82228},[41736],"Reads from salted tables can also benefit from more uniform data distribution. Our performance evaluation shows improved read performance for queries focused on subsets of data.",{"_15044":1050,"_41288":1050,"_5":10980,"_6528":82230,"_41707":82231,"_15362":82232,"_21301":1050},"Secondary Indexes",[79080,79081,79082,80746],[41736],{"_15044":1051,"_41288":1050,"_15362":82234,"_5":14925,"_21301":1050,"_6528":82235},[41736],"Concepts, setup, consistency guarantees, and tooling for Phoenix secondary indexes.",{"_15044":1052,"_41288":1050,"_5":41704,"_15362":82237,"_21301":82238,"_6528":82239},[41736],"/docs/features/secondary-indexes#covered-indexes","Covered Indexes",{"_15044":1053,"_41288":1050,"_5":41704,"_15362":82241,"_21301":82242,"_6528":82243},[41736],"/docs/features/secondary-indexes#functional-indexes","Functional Indexes",{"_15044":1054,"_41288":1050,"_5":41704,"_15362":82245,"_21301":82246,"_6528":82247},[41736],"/docs/features/secondary-indexes#global-indexes","Global Indexes",{"_15044":1055,"_41288":1050,"_5":41704,"_15362":82249,"_21301":82250,"_6528":82251},[41736],"/docs/features/secondary-indexes#local-indexes","Local Indexes",{"_15044":1056,"_41288":1050,"_5":41704,"_15362":82253,"_21301":82254,"_6528":82255},[41736],"/docs/features/secondary-indexes#index-population","Index Population",{"_15044":1057,"_41288":1050,"_5":41704,"_15362":82257,"_21301":82258,"_6528":82259},[41736],"/docs/features/secondary-indexes#async-index-threshold","ASYNC Index threshold",{"_15044":1058,"_41288":1050,"_5":41704,"_15362":82261,"_21301":82262,"_6528":82263},[41736],"/docs/features/secondary-indexes#index-usage","Index Usage",{"_15044":1059,"_41288":1050,"_5":41704,"_15362":82265,"_21301":82266,"_6528":82267},[41736],"/docs/features/secondary-indexes#index-removal","Index Removal",{"_15044":1060,"_41288":1050,"_5":41704,"_15362":82269,"_21301":82270,"_6528":82271},[41736],"/docs/features/secondary-indexes#index-properties","Index Properties",{"_15044":1061,"_41288":1050,"_5":41704,"_15362":82273,"_21301":82274,"_6528":82275},[41736],"/docs/features/secondary-indexes#consistency-guarantees","Consistency Guarantees",{"_15044":1062,"_41288":1050,"_5":41704,"_15362":82277,"_21301":82278,"_6528":82251},[41736],"/docs/features/secondary-indexes#local-indexes-1",{"_15044":1063,"_41288":1050,"_5":41704,"_15362":82280,"_21301":82281,"_6528":82282},[41736],"/docs/features/secondary-indexes#global-indexes-on-transactional-tables","Global Indexes on Transactional Tables",{"_15044":1064,"_41288":1050,"_5":41704,"_15362":82284,"_21301":82285,"_6528":82286},[41736],"/docs/features/secondary-indexes#global-indexes-on-immutable-tables","Global Indexes on Immutable Tables",{"_15044":1065,"_41288":1050,"_5":41704,"_15362":82288,"_21301":82289,"_6528":82290},[41736],"/docs/features/secondary-indexes#immutable-table-indexes-for-415-and-51-and-newer-versions","Immutable table indexes for 4.15 (and 5.1) and newer versions",{"_15044":1066,"_41288":1050,"_5":41704,"_15362":82292,"_21301":82293,"_6528":82294},[41736],"/docs/features/secondary-indexes#immutable-table-indexes-for-414-and-50-and-older-versions","Immutable table indexes for 4.14 (and 5.0) and older versions",{"_15044":1067,"_41288":1050,"_5":41704,"_15362":82296,"_21301":82297,"_6528":82298},[41736],"/docs/features/secondary-indexes#global-indexes-on-mutable-tables","Global Indexes on Mutable Tables",{"_15044":1068,"_41288":1050,"_5":41704,"_15362":82300,"_21301":82301,"_6528":82302},[41736],"/docs/features/secondary-indexes#mutable-table-indexes-for-415-and-51-and-newer-versions","Mutable table indexes for 4.15 (and 5.1) and newer versions",{"_15044":1069,"_41288":1050,"_5":41704,"_15362":82304,"_21301":82305,"_6528":82306},[41736],"/docs/features/secondary-indexes#mutable-table-indexes-for-414-and-50-and-older-versions","Mutable table indexes for 4.14 (and 5.0) and older versions",{"_15044":1070,"_41288":1050,"_5":41704,"_15362":82308,"_21301":82309,"_6528":82310},[41736],"/docs/features/secondary-indexes#bulkload-tool-limitation","BulkLoad Tool Limitation",{"_15044":1071,"_41288":1050,"_5":41704,"_15362":82312,"_21301":82313,"_6528":82314},[41736],"/docs/features/secondary-indexes#setup","Setup",{"_15044":1072,"_41288":1050,"_5":41704,"_15362":82316,"_21301":82317,"_6528":82318},[41736],"/docs/features/secondary-indexes#for-phoenix-412-and-later","For Phoenix 4.12 and later",{"_15044":1073,"_41288":1050,"_5":41704,"_15362":82320,"_21301":82321,"_6528":82322},[41736],"/docs/features/secondary-indexes#for-phoenix-48---411","For Phoenix 4.8 - 4.11",{"_15044":1074,"_41288":1050,"_5":41704,"_15362":82324,"_21301":82325,"_6528":82326},[41736],"/docs/features/secondary-indexes#for-phoenix-versions-47-and-below","For Phoenix versions 4.7 and below",{"_15044":1075,"_41288":1050,"_5":41704,"_15362":82328,"_21301":82329,"_6528":82330},[41736],"/docs/features/secondary-indexes#upgrading-local-indexes-created-before-480","Upgrading Local Indexes created before 4.8.0",{"_15044":1076,"_41288":1050,"_5":41704,"_15362":82332,"_21301":82333,"_6528":82334},[41736],"/docs/features/secondary-indexes#secondary-indexes-tuning","Tuning",{"_15044":1077,"_41288":1050,"_5":41704,"_15362":82336,"_21301":82337,"_6528":82201},[41736],"/docs/features/secondary-indexes#secondary-indexes-performance",{"_15044":1078,"_41288":1050,"_5":41704,"_15362":82339,"_21301":82340,"_6528":82341},[41736],"/docs/features/secondary-indexes#index-scrutiny-tool","Index Scrutiny Tool",{"_15044":1079,"_41288":1050,"_5":41704,"_15362":82343,"_21301":82344,"_6528":79202},[41736],"/docs/features/secondary-indexes#secondary-indexes-limitations",{"_15044":1080,"_41288":1050,"_5":41704,"_15362":82346,"_21301":82347,"_6528":82348},[41736],"/docs/features/secondary-indexes#index-upgrade-tool","Index Upgrade Tool",{"_15044":1081,"_41288":1050,"_5":41704,"_15362":82350,"_21301":82351,"_6528":81349},[41736],"/docs/features/secondary-indexes#secondary-indexes-resources",{"_15044":1082,"_41288":1050,"_15362":82353,"_5":14925,"_21301":1050,"_6528":82354},[41736],"Secondary indexes are an orthogonal way to access data from its primary access path. In HBase, you have a single\nindex that is lexicographically sorted on the primary row key. Access to records in any way other than through\nthe primary row requires scanning over potentially all the rows in the table to test them against your filter.\nWith secondary indexing, the columns or expressions you index form an alternate row key to allow point lookups\nand range scans along this new axis.",{"_15044":1083,"_41288":1050,"_15362":82356,"_5":14925,"_21301":82238,"_6528":82357},[41736],"Phoenix is particularly powerful in that we provide covered indexes -\nwe do not need to go back to the primary table once we have found the index entry. Instead, we bundle the data\nwe care about right in the index rows, saving read-time overhead.",{"_15044":1084,"_41288":1050,"_15362":82359,"_5":14925,"_21301":82238,"_6528":82360},[41736],"For example, the following would create an index on the v1 and v2 columns and\ninclude the v3 column in the index as well to prevent having to get it from the data table:",{"_15044":1085,"_41288":1050,"_15362":82362,"_5":14925,"_21301":82242,"_6528":82363},[41736],"Functional indexes (available in 4.3 and above) allow you to create\nan index not just on columns, but on an arbitrary expressions. Then when a query uses that expression, the index\nmay be used to retrieve the results instead of the data table. For example, you could create an index on UPPER(FIRST_NAME||' '||LAST_NAME)\nto allow you to do case insensitive searches on the combined first name and last name of a person.",{"_15044":1086,"_41288":1050,"_15362":82365,"_5":14925,"_21301":82242,"_6528":82366},[41736],"For example, the following would create this functional index:",{"_15044":1087,"_41288":1050,"_15362":82368,"_5":14925,"_21301":82242,"_6528":82369},[41736],"With this index in place, when the following query is issued, the index would be used instead of the data table to retrieve the results:",{"_15044":1088,"_41288":1050,"_15362":82371,"_5":14925,"_21301":82242,"_6528":82372},[41736],"Phoenix supports two types of indexing techniques: global and local indexing.\nEach are useful in different scenarios and have their own failure profiles and performance characteristics.",{"_15044":1089,"_41288":1050,"_15362":82374,"_5":14925,"_21301":82246,"_6528":82375},[41736],"Global indexing targets read heavy uses cases. With global indexes, all the performance penalties for indexes occur at write time. We intercept the data table updates on write (DELETE, UPSERT VALUES and UPSERT SELECT), build the index update and then sent any necessary updates to all interested index tables. At read time, Phoenix will select the index table to use that will produce the fastest query time and directly scan it just like any other HBase table. An index will not be used for a query that references a column that isn't part of the index.",{"_15044":1090,"_41288":1050,"_15362":82377,"_5":14925,"_21301":82250,"_6528":82378},[41736],"Local indexing targets write heavy, space constrained use cases. Just like with global indexes, Phoenix will automatically select whether or not to use a local index at query-time. With local indexes, index data and table data co-reside on same server preventing any network overhead during writes. Local indexes can be used even when the query isn't fully covered (i.e. Phoenix automatically retrieve the columns not in the index through point gets against the data table). Unlike global indexes, all local indexes of a table are stored in a single, separate shared table prior to 4.8.0 version. From 4.8.0 onwards we are storing all local index data in the separate shadow column families in the same data table. At read time when the local index is used, every region must be examined for the data as the exact region location of index data cannot be predetermined. Thus some overhead occurs at read-time.",{"_15044":1091,"_41288":1050,"_15362":82380,"_5":14925,"_21301":82254,"_6528":82381},[41736],"By default, when an index is created, it is populated synchronously during the CREATE INDEX call. This may not be feasible depending on the current size of the data table. As of 4.5, initially population of an index may be done asynchronously by including the ASYNC keyword in the index creation DDL statement:",{"_15044":1092,"_41288":1050,"_15362":82383,"_5":14925,"_21301":82254,"_6528":82384},[41736],"The map reduce job that populates the index table must be kicked off separately through the HBase command line like this:",{"_15044":1093,"_41288":1050,"_15362":82386,"_5":14925,"_21301":82254,"_6528":82387},[41736],"Only when the map reduce job is complete will the index be activated and start to be used in queries. The job is resilient to the client being exited. The output-path option is used to specify a HDFS directory that is used for writing HFiles to.",{"_15044":1094,"_41288":1050,"_15362":82389,"_5":14925,"_21301":82254,"_6528":82390},[41736],"You can also start index population for all indexes in BUILDING (\"b\") state with the following HBase command line:",{"_15044":1095,"_41288":1050,"_15362":82392,"_5":14925,"_21301":82258,"_6528":82393},[41736],"As of 4.16 (and 5.1), setting the phoenix.index.async.threshold property to a positive number will disallow synchronous index creation if the estimated indexed data size exceeds phoenix.index.async.threshold (in bytes).",{"_15044":1096,"_41288":1050,"_15362":82395,"_5":14925,"_21301":82262,"_6528":82396},[41736],"Indexes are automatically used by Phoenix to service a query when it's determined more efficient to do so. However, a global index will not be used unless all of the columns referenced in the query are contained in the index. For example, the following query would not use the index, because v2 is referenced in the query but not included in the index:",{"_15044":1097,"_41288":1050,"_15362":82398,"_5":14925,"_21301":82262,"_6528":82399},[41736],"There are two means of getting an index to be used in this case:",{"_15044":1098,"_41288":1050,"_15362":82401,"_5":14925,"_21301":82262,"_6528":82402},[41736],"Create a covered index by including v2 in the index:",{"_15044":1099,"_41288":1050,"_15362":82404,"_5":14925,"_21301":82262,"_6528":82405},[41736],"This will cause the v2 column value to be copied into the index and kept in synch as it changes. This will obviously increase the size of the index.",{"_15044":1100,"_41288":1050,"_15362":82407,"_5":14925,"_21301":82262,"_6528":82408},[41736],"Create a local index:",{"_15044":1101,"_41288":1050,"_15362":82410,"_5":14925,"_21301":82262,"_6528":82411},[41736],"Unlike global indexes, local indexes will use an index even when all columns referenced in the query are not contained in the index. This is done by default for local indexes because we know that the table and index data coreside on the same region server thus ensuring the lookup is local.",{"_15044":1102,"_41288":1050,"_15362":82413,"_5":14925,"_21301":82266,"_6528":82414},[41736],"To drop an index, you'd issue the following statement:",{"_15044":1103,"_41288":1050,"_15362":82416,"_5":14925,"_21301":82266,"_6528":82417},[41736],"If an indexed column is dropped in the data table, the index will automatically be dropped. In addition, if a covered column is dropped in the data table, it will be automatically dropped from the index as well.",{"_15044":1104,"_41288":1050,"_15362":82419,"_5":14925,"_21301":82270,"_6528":82420},[41736],"Just like with the CREATE TABLE statement, the CREATE INDEX statement may pass through properties to apply to the underlying HBase table, including the ability to salt it:",{"_15044":1105,"_41288":1050,"_15362":82422,"_5":14925,"_21301":82270,"_6528":82423},[41736],"Note that if the primary table is salted, then the index is automatically salted in the same way for global indexes. In addition, the MAX_FILESIZE for the index is adjusted down, relative to the size of the primary versus index table. For more on salting see here. With local indexes, on the other hand, specifying SALT_BUCKETS is not allowed.",{"_15044":1106,"_41288":1050,"_15362":82425,"_5":14925,"_21301":82274,"_6528":82426},[41736],"On successful return to the client after a commit, all data is guaranteed to be written to all interested indexes and the\nprimary table. In other words, index updates are synchronous with the same strong consistency guarantees provided by HBase.",{"_15044":1107,"_41288":1050,"_15362":82428,"_5":14925,"_21301":82274,"_6528":82429},[41736],"However, since indexes are stored in separate tables than the data table, depending on the properties of the table and the\ntype of index, the consistency between your table and index varies in the event that a commit fails due to a server-side\ncrash. This is an important design consideration driven by your requirements and use case.",{"_15044":1108,"_41288":1050,"_15362":82431,"_5":14925,"_21301":82274,"_6528":82432},[41736],"Outlined below are the different options with various levels of consistency guarantees.",{"_15044":1109,"_41288":1050,"_15362":82434,"_5":14925,"_21301":82278,"_6528":82435},[41736],"Since Phoenix 4.8 local indexes are always guaranteed to be consistent.",{"_15044":1110,"_41288":1050,"_15362":82437,"_5":14925,"_21301":82281,"_6528":82438},[41736],"By declaring your table as transactional, you achieve the highest level of consistency guarantee\nbetween your table and index. In this case, your commit of your table mutations and related index updates are atomic\nwith strong ACID guarantees. If the commit fails, then none of your data (table\nor index) is updated, thus ensuring that your table and index are always in sync.",{"_15044":1111,"_41288":1050,"_15362":82440,"_5":14925,"_21301":82281,"_6528":82441},[41736],"Why not just always declare your tables as transactional? This may be fine, especially if your\ntable is declared as immutable, since the transactional overhead is very small in this case. However, if your data\nis mutable, make sure that the overhead associated with the conflict detection that occurs with transactional tables\nand the operational overhead of running the transaction manager is acceptable. Additionally, transactional tables\nwith secondary indexes potentially lowers your availability of being able to write to your data table, as both the\ndata table and its secondary index tables must be availalbe as otherwise the write will fail.",{"_15044":1112,"_41288":1050,"_15362":82443,"_5":14925,"_21301":82285,"_6528":82444},[41736],"For a table in which the data is only written once and never updated in-place, certain optimizations may be made to reduce the write-time overhead for incremental maintenance.\nThis is common with time-series data such as log or event data, where once a row is written, it will never be updated.\nTo take advantage of these optimizations, declare your table as immutable by adding the IMMUTABLE_ROWS=true property to your DDL statement:",{"_15044":1113,"_41288":1050,"_15362":82446,"_5":14925,"_21301":82285,"_6528":82447},[41736],"All indexes on a table declared with IMMUTABLE_ROWS=true are considered immutable (note that by default, tables are considered mutable).\nFor global immutable indexes, the index is maintained entirely on the client-side with the index table being generated as changes to the data table occur.\nLocal immutable indexes, on the other hand, are maintained on the server-side.\nNote that no safeguards are in-place to enforce that a table declared as immutable doesn't actually mutate data (as that would negate the performance gain achieved).\nIf that was to occur, the index would no longer be in sync with the table.",{"_15044":1114,"_41288":1050,"_15362":82449,"_5":14925,"_21301":82285,"_6528":82450},[41736],"If you have an existing table that you'd like to switch from immutable indexing to mutable indexing, use the ALTER TABLE command as show below:",{"_15044":1115,"_41288":1050,"_15362":82452,"_5":14925,"_21301":82285,"_6528":82453},[41736],"Global Indexing for Immutable tables has been completely rewritten for version 4.15 (and 5.1)",{"_15044":1116,"_41288":1050,"_15362":82455,"_5":14925,"_21301":82289,"_6528":82456},[41736],"Immutable index updates go through the same three phase writes as mutable index updates do except that deleting or un-verifying existing index rows is not applicable to immutable indexes.\nThis guarantees that the index tables are always in sync with the data tables.",{"_15044":1117,"_41288":1050,"_15362":82458,"_5":14925,"_21301":82293,"_6528":82459},[41736],"Indexes on non transactional, immutable tables have no mechanism in place to automatically deal with a commit failure. Maintaining\nconsistency between the table and index is left to the client to handle. Because the updates are idempotent, the simplest\nsolution is for the client to continue retrying the batch of mutations until they succeed.",{"_15044":1118,"_41288":1050,"_15362":82461,"_5":14925,"_21301":82297,"_6528":82462},[41736],"Global Indexing for Mutable tables has been completely rewritten for version 4.15 (and 5.1)",{"_15044":1119,"_41288":1050,"_15362":82464,"_5":14925,"_21301":82301,"_6528":82465},[41736],"The new Strongly Consistent Global Indexing feature uses a three-phase indexing algorithm to guarantee that the index tables are always in sync with the data tables.",{"_15044":1120,"_41288":1050,"_15362":82467,"_5":14925,"_21301":82301,"_6528":82468},[41736],"The implementation uses a shadow column to track the status of index rows:",{"_15044":1121,"_41288":1050,"_15362":82470,"_5":14925,"_21301":82301,"_6528":82471},[41736],"Write:",{"_15044":1122,"_41288":1050,"_15362":82473,"_5":14925,"_21301":82301,"_6528":82474},[41736],"Set the status of existing index rows to unverified and write the new index rows with the unverified status",{"_15044":1123,"_41288":1050,"_15362":82476,"_5":14925,"_21301":82301,"_6528":82477},[41736],"Write the data table rows",{"_15044":1124,"_41288":1050,"_15362":82479,"_5":14925,"_21301":82301,"_6528":82480},[41736],"Delete the existing index rows and set the status of new rows to verified",{"_15044":1125,"_41288":1050,"_15362":82482,"_5":14925,"_21301":82301,"_6528":82483},[41736],"Read:",{"_15044":1126,"_41288":1050,"_15362":82485,"_5":14925,"_21301":82301,"_6528":82486},[41736],"Read the index rows and check their status",{"_15044":1127,"_41288":1050,"_15362":82488,"_5":14925,"_21301":82301,"_6528":82489},[41736],"The unverified rows are repaired from the data table",{"_15044":1128,"_41288":1050,"_15362":82491,"_5":14925,"_21301":82301,"_6528":82492},[41736],"Delete:",{"_15044":1129,"_41288":1050,"_15362":82494,"_5":14925,"_21301":82301,"_6528":82495},[41736],"Set the index table rows with the unverified status",{"_15044":1130,"_41288":1050,"_15362":82497,"_5":14925,"_21301":82301,"_6528":82498},[41736],"Delete the data table rows",{"_15044":1131,"_41288":1050,"_15362":82500,"_5":14925,"_21301":82301,"_6528":82501},[41736],"Delete index table rows",{"_15044":1132,"_41288":1050,"_15362":82503,"_5":14925,"_21301":82301,"_6528":82504},[41736],"See resources for more in-depth information.",{"_15044":1133,"_41288":1050,"_15362":82506,"_5":14925,"_21301":82301,"_6528":82507},[41736],"All newly created tables use the new indexing algorithm.",{"_15044":1134,"_41288":1050,"_15362":82509,"_5":14925,"_21301":82301,"_6528":82510},[41736],"Indexes created with older Phoenix versions will continue to use the old implementation, until upgraded with IndexUpgradeTool",{"_15044":1135,"_41288":1050,"_15362":82512,"_5":14925,"_21301":82305,"_6528":82513},[41736],"For non transactional mutable tables, we maintain index update durability by adding the index updates to the Write-Ahead-Log (WAL) entry of the primary table row.\nOnly after the WAL entry is successfully synced to disk do we attempt to make the index/primary table updates. We write the\nindex updates in parallel by default, leading to very high throughput. If the server crashes while we are writing the index\nupdates, we replay the all the index updates to the index tables in the WAL recovery process and rely on the idempotence of\nthe updates to ensure correctness. Therefore, indexes on non transactional mutable tables are only ever a single batch of\nedits behind the primary table.",{"_15044":1136,"_41288":1050,"_15362":82515,"_5":14925,"_21301":82305,"_6528":82516},[41736],"It's important to note several points:",{"_15044":1137,"_41288":1050,"_15362":82518,"_5":14925,"_21301":82305,"_6528":82519},[41736],"For non transactional tables, you could see the index table out of sync with the primary table.",{"_15044":1138,"_41288":1050,"_15362":82521,"_5":14925,"_21301":82305,"_6528":82522},[41736],"As noted above, this is ok as we are only a very small bit behind and out of sync for very short periods",{"_15044":1139,"_41288":1050,"_15362":82524,"_5":14925,"_21301":82305,"_6528":82525},[41736],"Each data row and its index row(s) are guaranteed to to be written or lost - we never see partial updates as this is part of the atomicity guarantees of HBase.",{"_15044":1140,"_41288":1050,"_15362":82527,"_5":14925,"_21301":82305,"_6528":82528},[41736],"Data is first written to the table followed by the index tables (the reverse is true if the WAL is disabled).",{"_15044":1141,"_41288":1050,"_15362":82530,"_5":14925,"_21301":82305,"_6528":82531},[41736],"Singular Write Path",{"_15044":1142,"_41288":1050,"_15362":82533,"_5":14925,"_21301":82305,"_6528":82534},[41736],"There is a single write path that guarantees the failure properties. All writes to the HRegion get intercepted by our\ncoprocessor. We then build the index updates based on the pending update (or updates, in the case of the batch).\nThese update are then appended to the WAL entry for the original update.",{"_15044":1143,"_41288":1050,"_15362":82536,"_5":14925,"_21301":82305,"_6528":82537},[41736],"If we get any failure up to this point, we return the failure to the client and no data is persisted or made visible\nto the client.",{"_15044":1144,"_41288":1050,"_15362":82539,"_5":14925,"_21301":82305,"_6528":82540},[41736],"Once the WAL is written, we ensure that the index and primary table data will become visible, even in the case of a failure.",{"_15044":1145,"_41288":1050,"_15362":82542,"_5":14925,"_21301":82305,"_6528":82543},[41736],"If the server does crash, we then replay the index updates with the usual WAL replay mechanism",{"_15044":1146,"_41288":1050,"_15362":82545,"_5":14925,"_21301":82305,"_6528":82546},[41736],"If the server does not crash, we just insert the index updates to their respective tables.",{"_15044":1147,"_41288":1050,"_15362":82548,"_5":14925,"_21301":82305,"_6528":82549},[41736],"If the index updates fail, the various means of maintaining consistency are outlined below.",{"_15044":1148,"_41288":1050,"_15362":82551,"_5":14925,"_21301":82305,"_6528":82552},[41736],"If the Phoenix system catalog table cannot be reached when a failure occurs, we force the server to be immediately aborted and failing this, call System.exit on the JVM, forcing the server to die. By killing the server, we ensure that the WAL will be replayed on recovery, replaying the index updates to their appropriate tables. This ensures that a secondary index is not continued to be used when it's in a know, invalid state.",{"_15044":1149,"_41288":1050,"_15362":82554,"_5":14925,"_21301":82305,"_6528":82555},[41736],"Disallow table writes until mutable index is consistent",{"_15044":1150,"_41288":1050,"_15362":82557,"_5":14925,"_21301":82305,"_6528":82558},[41736],"The highest level of maintaining consistency between your non transactional table and index is to declare that writes to the\ndata table should be temporarily disallowed in the event of a failure to update the index. In this consistency\nmode, the table and index will be held at the timestamp before the failure occurred, with writes to the data\ntable being disallowed until the index is back online and in-sync with the data table. The index will\nremain active and continue to be used by queries as usual.",{"_15044":1151,"_41288":1050,"_15362":82560,"_5":14925,"_21301":82305,"_6528":82561},[41736],"The following server-side configurations control this behavior:",{"_15044":1152,"_41288":1050,"_15362":82563,"_5":14925,"_21301":82305,"_6528":82564},[41736],"phoenix.index.failure.block.write must be true to enable a writes to the data table to fail\nin the event of a commit failure until the index can be caught up with the data table.",{"_15044":1153,"_41288":1050,"_15362":82566,"_5":14925,"_21301":82305,"_6528":82567},[41736],"phoenix.index.failure.handling.rebuild must be true (the default) to enable a mutable index to\nbe rebuilt in the background in the event of a commit failure.",{"_15044":1154,"_41288":1050,"_15362":82569,"_5":14925,"_21301":82305,"_6528":82570},[41736],"Disable mutable indexes on write failure until consistency restored",{"_15044":1155,"_41288":1050,"_15362":82572,"_5":14925,"_21301":82305,"_6528":82573},[41736],"The default behavior with mutable indexes is to mark the index as disabled if a write to them fails at commit time,\npartially rebuild them in the background, and then mark them as active again once consistency is restored. In this\nconsistency mode, writes to the data table will not be blocked while the secondary index is being rebuilt. However,\nthe secondary index will not be used by queries while the rebuild is happening.",{"_15044":1156,"_41288":1050,"_15362":82575,"_5":14925,"_21301":82305,"_6528":82561},[41736],{"_15044":1157,"_41288":1050,"_15362":82577,"_5":14925,"_21301":82305,"_6528":82567},[41736],{"_15044":1158,"_41288":1050,"_15362":82579,"_5":14925,"_21301":82305,"_6528":82580},[41736],"phoenix.index.failure.handling.rebuild.interval controls the millisecond frequency at which the server\nchecks whether or not a mutable index needs to be partially rebuilt to catch up with updates to the data\ntable. The default is 10000 or 10 seconds.",{"_15044":1159,"_41288":1050,"_15362":82582,"_5":14925,"_21301":82305,"_6528":82583},[41736],"phoenix.index.failure.handling.rebuild.overlap.time controls how many milliseconds to go back from the timestamp\nat which the failure occurred to go back when a partial rebuild is performed. The default is 1.",{"_15044":1160,"_41288":1050,"_15362":82585,"_5":14925,"_21301":82305,"_6528":82586},[41736],"Disable mutable index on write failure with manual rebuild required",{"_15044":1161,"_41288":1050,"_15362":82588,"_5":14925,"_21301":82305,"_6528":82589},[41736],"This is the lowest level of consistency for mutable secondary indexes. In this case, when a write to a secondary\nindex fails, the index will be marked as disabled with a manual\nrebuild of the index required to enable it to be used\nonce again by queries.",{"_15044":1162,"_41288":1050,"_15362":82591,"_5":14925,"_21301":82305,"_6528":82561},[41736],{"_15044":1163,"_41288":1050,"_15362":82593,"_5":14925,"_21301":82305,"_6528":82594},[41736],"phoenix.index.failure.handling.rebuild must be set to false to disable a mutable index from being\nrebuilt in the background in the event of a commit failure.",{"_15044":1164,"_41288":1050,"_15362":82596,"_5":14925,"_21301":82309,"_6528":82597},[41736],"The BulkLoadTools (e.g. CSVBulkLoadTool and JSONBulkLoadTool) cannot presently generate correct updates to mutable\nsecondary indexes when pre-existing records are being updated. In the normal mutable secondary index write path, we can\nsafely calculate a Delete (for the old record) and a Put (for the new record) for each secondary index while holding a\nrow-lock to prevent concurrent updates. In the context of a MapReduce job, we cannot effectively execute this same logic\nbecause we are specifically doing this \"out of band\" from the HBase RegionServers. As such, while these Tools generate\nHFiles for the index tables with the proper updates for the data being loaded, any previous index records corresponding\nto the same record in the table are not deleted. This net-effect of this limitation is: if you use these Tools to re-ingest\nthe same records to an index table, that index table will have duplicate records in it which will result in incorrect\nquery results from that index table.",{"_15044":1165,"_41288":1050,"_15362":82599,"_5":14925,"_21301":82309,"_6528":82600},[41736],"To perform incremental loads of data using the BulkLoadTools which may update existing records, you must\ndrop and re-create all index tables after the data table is loaded. Re-creating the index with the ASYNC option and\nusing IndexTool to populate and enable that index is likely a must for tables of non-trivial size.",{"_15044":1166,"_41288":1050,"_15362":82602,"_5":14925,"_21301":82309,"_6528":82603},[41736],"To perform incremental loading of CSV datasets that do not require any manual index intervention, the psql tool can\nbe used in place of the BulkLoadTools. Additionally, a MapReduce job could be written to parse CSV/JSON data and write\nit directly to Phoenix; although, such a tool is not currently provided by Phoenix for users.",{"_15044":1167,"_41288":1050,"_15362":82605,"_5":14925,"_21301":82313,"_6528":82606},[41736],"Non transactional, mutable indexing requires special configuration options on the region server and master to run - Phoenix ensures that they are setup correctly when you enable mutable indexing on the table; if the correct properties are not set, you will not be able to use secondary indexing. After adding these settings to your hbase-site.xml, you'll need to do a rolling restart of your cluster.",{"_15044":1168,"_41288":1050,"_15362":82608,"_5":14925,"_21301":82313,"_6528":82609},[41736],"As Phoenix matures, it needs less and less manual configuration. For older Phoenix versions you'll need to add the properties listed for that version, as well as the properties listed for the later versions.",{"_15044":1169,"_41288":1050,"_15362":82611,"_5":14925,"_21301":82317,"_6528":82612},[41736],"You will need to add the following parameters to hbase-site.xml on each region server:",{"_15044":1170,"_41288":1050,"_15362":82614,"_5":14925,"_21301":82317,"_6528":82615},[41736],"The above property enables custom WAL edits to be written, ensuring proper writing/replay of the index updates. This codec supports the usual host of WALEdit options, most notably WALEdit compression.",{"_15044":1171,"_41288":1050,"_15362":82617,"_5":14925,"_21301":82321,"_6528":82618},[41736],"The following configuration changes are also required to the server-side hbase-site.xml on the master and regions server nodes:",{"_15044":1172,"_41288":1050,"_15362":82620,"_5":14925,"_21301":82321,"_6528":82621},[41736],"The above properties prevent deadlocks from occurring during index maintenance for global indexes (HBase 0.98.4+ and Phoenix 4.3.1+) by ensuring index updates are processed with a higher priority than data updates. It also prevents deadlocks by ensuring metadata rpc calls are processed with a higher priority than data rpc calls.",{"_15044":1173,"_41288":1050,"_15362":82623,"_5":14925,"_21301":82325,"_6528":82618},[41736],{"_15044":1174,"_41288":1050,"_15362":82625,"_5":14925,"_21301":82325,"_6528":82626},[41736],"The above properties are required to use local indexing.",{"_15044":1175,"_41288":1050,"_15362":82628,"_5":14925,"_21301":82329,"_6528":82629},[41736],"While upgrading the Phoenix to 4.8.0+ version at server remove above three local indexing related configurations from hbase-site.xml if present. From client we are supporting both online(while initializing the connection from phoenix client of 4.8.0+ versions) and offline(using psql tool) upgrade of local indexes created before 4.8.0. As part of upgrade we recreate the local indexes in ASYNC mode. After upgrade user need to build the indexes using IndexTool",{"_15044":1176,"_41288":1050,"_15362":82631,"_5":14925,"_21301":82329,"_6528":82632},[41736],"Following client side configuration used in the upgrade.",{"_15044":1177,"_41288":1050,"_15362":82634,"_5":14925,"_21301":82329,"_6528":82635},[41736],"phoenix.client.localIndexUpgradeThe value of it is true means online upgrade and false means offline upgrade.Default: true",{"_15044":1178,"_41288":1050,"_15362":82637,"_5":14925,"_21301":82329,"_6528":82638},[41736],"Command to run offline upgrade using psql:",{"_15044":1179,"_41288":1050,"_15362":82640,"_5":14925,"_21301":82333,"_6528":82641},[41736],"Out the box, indexing is pretty fast. However, to optimize for your particular environment and workload, there are several properties you can tune.",{"_15044":1180,"_41288":1050,"_15362":82643,"_5":14925,"_21301":82333,"_6528":82644},[41736],"All the following parameters must be set in hbase-site.xml - they are true for the entire cluster and all index tables, as well as across all regions on the same server (so, for instance, a single server would not write to too many different index tables at once).",{"_15044":1181,"_41288":1050,"_15362":82646,"_5":14925,"_21301":82333,"_6528":82647},[41736],"index.builder.threads.max",{"_15044":1182,"_41288":1050,"_15362":82649,"_5":14925,"_21301":82333,"_6528":82650},[41736],"Number of threads to used to build the index update from the primary table update",{"_15044":1183,"_41288":1050,"_15362":82652,"_5":14925,"_21301":82333,"_6528":82653},[41736],"Increasing this value overcomes the bottleneck of reading the current row state from the underlying HRegion. Tuning this value too high will just bottleneck at the HRegion as it will not be able to handle too many concurrent scan requests as well as general thread-swapping concerns.",{"_15044":1184,"_41288":1050,"_15362":82655,"_5":14925,"_21301":82333,"_6528":82656},[41736],"Default: 10",{"_15044":1185,"_41288":1050,"_15362":82658,"_5":14925,"_21301":82333,"_6528":82659},[41736],"index.builder.threads.keepalivetime",{"_15044":1186,"_41288":1050,"_15362":82661,"_5":14925,"_21301":82333,"_6528":82662},[41736],"Amount of time in seconds after we expire threads in the builder thread pool.",{"_15044":1187,"_41288":1050,"_15362":82664,"_5":14925,"_21301":82333,"_6528":82665},[41736],"Unused threads are immediately released after this amount of time and not core threads are retained (though this last is a small concern as tables are expected to sustain a fairly constant write load), but simultaneously allows us to drop threads if we are not seeing the expected load.",{"_15044":1188,"_41288":1050,"_15362":82667,"_5":14925,"_21301":82333,"_6528":82668},[41736],"Default: 60",{"_15044":1189,"_41288":1050,"_15362":82670,"_5":14925,"_21301":82333,"_6528":82671},[41736],"index.writer.threads.max",{"_15044":1190,"_41288":1050,"_15362":82673,"_5":14925,"_21301":82333,"_6528":82674},[41736],"Number of threads to use when writing to the target index tables.",{"_15044":1191,"_41288":1050,"_15362":82676,"_5":14925,"_21301":82333,"_6528":82677},[41736],"The first level of parallelization, on a per-table basis - it should roughly correspond to the number of index tables",{"_15044":1192,"_41288":1050,"_15362":82679,"_5":14925,"_21301":82333,"_6528":82656},[41736],{"_15044":1193,"_41288":1050,"_15362":82681,"_5":14925,"_21301":82333,"_6528":82682},[41736],"index.writer.threads.keepalivetime",{"_15044":1194,"_41288":1050,"_15362":82684,"_5":14925,"_21301":82333,"_6528":82685},[41736],"Amount of time in seconds after we expire threads in the writer thread pool.",{"_15044":1195,"_41288":1050,"_15362":82687,"_5":14925,"_21301":82333,"_6528":82665},[41736],{"_15044":1196,"_41288":1050,"_15362":82689,"_5":14925,"_21301":82333,"_6528":82668},[41736],{"_15044":1197,"_41288":1050,"_15362":82691,"_5":14925,"_21301":82333,"_6528":82692},[41736],"hbase.htable.threads.max",{"_15044":1198,"_41288":1050,"_15362":82694,"_5":14925,"_21301":82333,"_6528":82695},[41736],"Number of threads each index HTable can use for writes.",{"_15044":1199,"_41288":1050,"_15362":82697,"_5":14925,"_21301":82333,"_6528":82698},[41736],"Increasing this allows more concurrent index updates (for instance across batches), leading to high overall throughput.",{"_15044":1200,"_41288":1050,"_15362":82700,"_5":14925,"_21301":82333,"_6528":82701},[41736],"Default: 2,147,483,647",{"_15044":1201,"_41288":1050,"_15362":82703,"_5":14925,"_21301":82333,"_6528":82704},[41736],"hbase.htable.threads.keepalivetime",{"_15044":1202,"_41288":1050,"_15362":82706,"_5":14925,"_21301":82333,"_6528":82707},[41736],"Amount of time in seconds after we expire threads in the HTable's thread pool.",{"_15044":1203,"_41288":1050,"_15362":82709,"_5":14925,"_21301":82333,"_6528":82710},[41736],"Using the \"direct handoff\" approach, new threads will only be created if it is necessary and will grow unbounded. This could be bad but HTables only create as many Runnables as there are region servers; therefore, it also scales when new region servers are added.",{"_15044":1204,"_41288":1050,"_15362":82712,"_5":14925,"_21301":82333,"_6528":82668},[41736],{"_15044":1205,"_41288":1050,"_15362":82714,"_5":14925,"_21301":82333,"_6528":82715},[41736],"index.tablefactory.cache.size",{"_15044":1206,"_41288":1050,"_15362":82717,"_5":14925,"_21301":82333,"_6528":82718},[41736],"Number of index HTables we should keep in cache.",{"_15044":1207,"_41288":1050,"_15362":82720,"_5":14925,"_21301":82333,"_6528":82721},[41736],"Increasing this number ensures that we do not need to recreate an HTable for each attempt to write to an index table. Conversely, you could see memory pressure if this value is set too high.",{"_15044":1208,"_41288":1050,"_15362":82723,"_5":14925,"_21301":82333,"_6528":82656},[41736],{"_15044":1209,"_41288":1050,"_15362":82725,"_5":14925,"_21301":82333,"_6528":82726},[41736],"org.apache.phoenix.regionserver.index.priority.min",{"_15044":1210,"_41288":1050,"_15362":82728,"_5":14925,"_21301":82333,"_6528":82729},[41736],"Value to specify to bottom (inclusive) of the range in which index priority may lie.",{"_15044":1211,"_41288":1050,"_15362":82731,"_5":14925,"_21301":82333,"_6528":82732},[41736],"Default: 1000",{"_15044":1212,"_41288":1050,"_15362":82734,"_5":14925,"_21301":82333,"_6528":82735},[41736],"org.apache.phoenix.regionserver.index.priority.max",{"_15044":1213,"_41288":1050,"_15362":82737,"_5":14925,"_21301":82333,"_6528":82738},[41736],"Value to specify to top (exclusive) of the range in which index priority may lie.",{"_15044":1214,"_41288":1050,"_15362":82740,"_5":14925,"_21301":82333,"_6528":82741},[41736],"Higher priorites within the index min/max range do not means updates are processed sooner.",{"_15044":1215,"_41288":1050,"_15362":82743,"_5":14925,"_21301":82333,"_6528":82744},[41736],"Default: 1050",{"_15044":1216,"_41288":1050,"_15362":82746,"_5":14925,"_21301":82333,"_6528":82747},[41736],"org.apache.phoenix.regionserver.index.handler.count",{"_15044":1217,"_41288":1050,"_15362":82749,"_5":14925,"_21301":82333,"_6528":82750},[41736],"Number of threads to use when serving index write requests for global index maintenance.",{"_15044":1218,"_41288":1050,"_15362":82752,"_5":14925,"_21301":82333,"_6528":82753},[41736],"Though the actual number of threads is dictated by the Max(number of call queues, handler count), where the number of call queues is determined by standard HBase configuration. To further tune the queues, you can adjust the standard rpc queue length parameters (currently, there are no special knobs for the index queues), specifically ipc.server.max.callqueue.length and ipc.server.callqueue.handler.factor. See the HBase Reference Guide for more details.",{"_15044":1219,"_41288":1050,"_15362":82755,"_5":14925,"_21301":82333,"_6528":82756},[41736],"Default: 30",{"_15044":1220,"_41288":1050,"_15362":82758,"_5":14925,"_21301":82337,"_6528":82759},[41736],"We track secondary index performance via our performance framework. This is a generic test of performance based on defaults - your results will vary based on hardware specs as well as you individual configuration.",{"_15044":1221,"_41288":1050,"_15362":82761,"_5":14925,"_21301":82337,"_6528":82762},[41736],"That said, we have seen secondary indexing (both immutable and mutable) go as quickly as < 2x the regular write path on a small, (3 node) desktop-based cluster. This is actually pretty reasonable as we have to write to multiple tables as well as build the index update.",{"_15044":1222,"_41288":1050,"_15362":82764,"_5":14925,"_21301":82340,"_6528":82765},[41736],"With Phoenix 4.12, there is now a tool to run a MapReduce job to verify that an index table is valid against its data table. The only way to find orphaned rows in either table is to scan over all rows in the table and do a lookup in the other table for the corresponding row. For that reason, the tool can run with either the data or index table as the \"source\" table, and the other as the \"target\" table. The tool writes all invalid rows it finds either to file or to an output table PHOENIX_INDEX_SCRUTINY. An invalid row is a source row that either has no corresponding row in the target table, or has an incorrect value in the target table (i.e. covered column value).",{"_15044":1223,"_41288":1050,"_15362":82767,"_5":14925,"_21301":82340,"_6528":82768},[41736],"The tool has job counters that track its status. VALID_ROW_COUNT, INVALID_ROW_COUNT, BAD_COVERED_COL_VAL_COUNT. Note that invalid rows - bad col val rows = number of orphaned rows. These counters are written to the table PHOENIX_INDEX_SCRUTINY_METADATA, along with other job metadata.",{"_15044":1224,"_41288":1050,"_15362":82770,"_5":14925,"_21301":82340,"_6528":82771},[41736],"The Index Scrutiny Tool can be launched via the hbase command (in hbase/bin) as follows:",{"_15044":1225,"_41288":1050,"_15362":82773,"_5":14925,"_21301":82340,"_6528":82774},[41736],"It can also be run from Hadoop using either the phoenix-core or phoenix-server jar as follows:",{"_15044":1226,"_41288":1050,"_15362":82776,"_5":14925,"_21301":82340,"_6528":82777},[41736],"By default two mapreduce jobs are launched, one with the data table as the source table and one with the index table as the source table.",{"_15044":1227,"_41288":1050,"_15362":82779,"_5":14925,"_21301":82340,"_6528":82780},[41736],"The following parameters can be used with the Index Scrutiny Tool:",{"_15044":1228,"_41288":1050,"_15362":82782,"_5":14925,"_21301":82340,"_6528":80874},[41736],{"_15044":1229,"_41288":1050,"_15362":82784,"_5":14925,"_21301":82340,"_6528":80877},[41736],{"_15044":1230,"_41288":1050,"_15362":82786,"_5":14925,"_21301":82340,"_6528":82787},[41736],"-dt,--data-table",{"_15044":1231,"_41288":1050,"_15362":82789,"_5":14925,"_21301":82340,"_6528":82790},[41736],"Data table name (mandatory)",{"_15044":1232,"_41288":1050,"_15362":82792,"_5":14925,"_21301":82340,"_6528":80994},[41736],{"_15044":1233,"_41288":1050,"_15362":82794,"_5":14925,"_21301":82340,"_6528":82795},[41736],"Index table name (mandatory)",{"_15044":1234,"_41288":1050,"_15362":82797,"_5":14925,"_21301":82340,"_6528":80982},[41736],{"_15044":1235,"_41288":1050,"_15362":82799,"_5":14925,"_21301":82340,"_6528":80985},[41736],{"_15044":1236,"_41288":1050,"_15362":82801,"_5":14925,"_21301":82340,"_6528":82802},[41736],"-src,--source",{"_15044":1237,"_41288":1050,"_15362":82804,"_5":14925,"_21301":82340,"_6528":82805},[41736],"DATA_TABLE_SOURCE, INDEX_TABLE_SOURCE, or BOTH. Defaults to BOTH",{"_15044":1238,"_41288":1050,"_15362":82807,"_5":14925,"_21301":82340,"_6528":80976},[41736],{"_15044":1239,"_41288":1050,"_15362":82809,"_5":14925,"_21301":82340,"_6528":82810},[41736],"Whether to output invalid rows. Off by default",{"_15044":1240,"_41288":1050,"_15362":82812,"_5":14925,"_21301":82340,"_6528":82813},[41736],"-of,--output-format",{"_15044":1241,"_41288":1050,"_15362":82815,"_5":14925,"_21301":82340,"_6528":82816},[41736],"TABLE or FILE output format. Defaults to TABLE",{"_15044":1242,"_41288":1050,"_15362":82818,"_5":14925,"_21301":82340,"_6528":82819},[41736],"-om,--output-max",{"_15044":1243,"_41288":1050,"_15362":82821,"_5":14925,"_21301":82340,"_6528":82822},[41736],"Maximum number of invalid rows to output per mapper. Defaults to 1M",{"_15044":1244,"_41288":1050,"_15362":82824,"_5":14925,"_21301":82340,"_6528":82825},[41736],"-op,--output-path",{"_15044":1245,"_41288":1050,"_15362":82827,"_5":14925,"_21301":82340,"_6528":82828},[41736],"For FILE output format, the HDFS directory where files are written",{"_15044":1246,"_41288":1050,"_15362":82830,"_5":14925,"_21301":82340,"_6528":82831},[41736],"-t,--time",{"_15044":1247,"_41288":1050,"_15362":82833,"_5":14925,"_21301":82340,"_6528":82834},[41736],"Timestamp in millis at which to run the scrutiny. This is important so that incoming writes don't throw off the scrutiny. Defaults to current time minus 60 seconds",{"_15044":1248,"_41288":1050,"_15362":82836,"_5":14925,"_21301":82340,"_6528":82837},[41736],"-b,--batch-size",{"_15044":1249,"_41288":1050,"_15362":82839,"_5":14925,"_21301":82340,"_6528":82840},[41736],"Number of rows to compare at a time",{"_15044":1250,"_41288":1050,"_15362":82842,"_5":14925,"_21301":82344,"_6528":82843},[41736],"If rows are actively being updated or deleted while the scrutiny is running, the tool may give you false positives for inconsistencies (PHOENIX-4277).",{"_15044":1251,"_41288":1050,"_15362":82845,"_5":14925,"_21301":82344,"_6528":82846},[41736],"Snapshot reads are not supported by the scrutiny tool (PHOENIX-4270).",{"_15044":1252,"_41288":1050,"_15362":82848,"_5":14925,"_21301":82347,"_6528":82849},[41736],"IndexUpgradeTool updates global indexes created by Phoenix 4.14 and earlier (or 5.0) to use the new Strongly Consistent Global Indexes implementation.",{"_15044":1253,"_41288":1050,"_15362":82851,"_5":14925,"_21301":82347,"_6528":82852},[41736],"It accepts following parameters:",{"_15044":1254,"_41288":1050,"_15362":82854,"_5":14925,"_21301":82347,"_6528":80874},[41736],{"_15044":1255,"_41288":1050,"_15362":82856,"_5":14925,"_21301":82347,"_6528":80877},[41736],{"_15044":1256,"_41288":1050,"_15362":82858,"_5":14925,"_21301":82347,"_6528":82859},[41736],"only in version",{"_15044":1257,"_41288":1050,"_15362":82861,"_5":14925,"_21301":82347,"_6528":82862},[41736],"-o,--operation",{"_15044":1258,"_41288":1050,"_15362":82864,"_5":14925,"_21301":82347,"_6528":82865},[41736],"upgrade or rollback (mandatory)",{"_15044":1259,"_41288":1050,"_15362":82867,"_5":14925,"_21301":82347,"_6528":82868},[41736],"-tb,--tables",{"_15044":1260,"_41288":1050,"_15362":82870,"_5":14925,"_21301":82347,"_6528":82871},[41736],"[table1,table2,table3] (-tb or -f mandatory)",{"_15044":1261,"_41288":1050,"_15362":82873,"_5":14925,"_21301":82347,"_6528":82874},[41736],"-f,--file",{"_15044":1262,"_41288":1050,"_15362":82876,"_5":14925,"_21301":82347,"_6528":82877},[41736],"Csv file with above format (-tb or -f mandatory)",{"_15044":1263,"_41288":1050,"_15362":82879,"_5":14925,"_21301":82347,"_6528":82880},[41736],"-d,--dry-run",{"_15044":1264,"_41288":1050,"_15362":82882,"_5":14925,"_21301":82347,"_6528":82883},[41736],"If passed this will just output steps that will be executed; like a dry run",{"_15044":1265,"_41288":1050,"_15362":82885,"_5":14925,"_21301":82347,"_6528":82886},[41736],"-h,--help",{"_15044":1266,"_41288":1050,"_15362":82888,"_5":14925,"_21301":82347,"_6528":82889},[41736],"Help on how to use the tool",{"_15044":1267,"_41288":1050,"_15362":82891,"_5":14925,"_21301":82347,"_6528":82892},[41736],"-lf,--logfile",{"_15044":1268,"_41288":1050,"_15362":82894,"_5":14925,"_21301":82347,"_6528":82895},[41736],"File location to dump the logs",{"_15044":1269,"_41288":1050,"_15362":82897,"_5":14925,"_21301":82347,"_6528":82898},[41736],"-sr,--index-sync-rebuild",{"_15044":1270,"_41288":1050,"_15362":82900,"_5":14925,"_21301":82347,"_6528":82901},[41736],"whether or not synchronously rebuild the indexes; default rebuild asynchronous",{"_15044":1271,"_41288":1050,"_15362":82903,"_5":14925,"_21301":82347,"_6528":82904},[41736],"4.15",{"_15044":1272,"_41288":1050,"_15362":82906,"_5":14925,"_21301":82347,"_6528":82907},[41736],"-rb,--index-rebuild",{"_15044":1273,"_41288":1050,"_15362":82909,"_5":14925,"_21301":82347,"_6528":82910},[41736],"Rebuild the indexes. Set -tool to pass options to IndexTool",{"_15044":1274,"_41288":1050,"_15362":82912,"_5":14925,"_21301":82347,"_6528":82913},[41736],"4.16+, 5.1+",{"_15044":1275,"_41288":1050,"_15362":82915,"_5":14925,"_21301":82347,"_6528":82916},[41736],"-tool,--index-tool",{"_15044":1276,"_41288":1050,"_15362":82918,"_5":14925,"_21301":82347,"_6528":82919},[41736],"Options to pass to indexTool when rebuilding indexes",{"_15044":1277,"_41288":1050,"_15362":82921,"_5":14925,"_21301":82347,"_6528":82913},[41736],{"_15044":1278,"_41288":1050,"_15362":82923,"_5":14925,"_21301":82347,"_6528":82924},[41736],"For 4.16+/5.1+ either specifying the -rb option, or manually rebuilding the indexes with IndexTool after the upgrade is recommended, otherwise the first access of every index row will trigger an index row repair.",{"_15044":1279,"_41288":1050,"_15362":82926,"_5":14925,"_21301":82347,"_6528":82927},[41736],"Depending on whether index is mutable, it will remove Indexer coprocessor from a data table and load new coprocessor IndexRegionObserver. For both immutable and mutable, it will load GlobalIndexChecker coprocessor on Index table. During this process, data table and index table are disabled-loaded/unloaded with coproc-enabled within short time span. At the end, it does an asynchronous index rebuilds. Index reads are not blocked while index-rebuild is still ongoing, however, they may be a bit slower for rows written prior to upgrade.",{"_15044":1280,"_41288":1050,"_15362":82929,"_5":14925,"_21301":82347,"_6528":82930},[41736],"IndexUpgradeTool doesn't make any distinction between view-index and table-index. When a table is passed, it will perform the upgrade-operation on all the 'children' indexes of the given table.",{"_15044":1281,"_41288":1050,"_15362":82932,"_5":14925,"_21301":82351,"_6528":82933},[41736],"There have been several presentations given on how secondary indexing works in Phoenix that have a more in-depth look at how indexing works (with pretty pictures!):",{"_15044":1282,"_41288":1050,"_15362":82935,"_5":14925,"_21301":82351,"_6528":82936},[41736],"Slides for Strongly Consistent Global Indexes for Apache Phoenix, 2019 Distributed SQL Summit",{"_15044":1283,"_41288":1050,"_15362":82938,"_5":14925,"_21301":82351,"_6528":82939},[41736],"Recording of Strongly Consistent Global Indexes for Apache Phoenix, 2019 Distributed SQL Summit",{"_15044":1284,"_41288":1050,"_15362":82941,"_5":14925,"_21301":82351,"_6528":82942},[41736],"Slides for Local Secondary Indexes in Apache Phoenix, 2017 PhoenixCon",{"_15044":1285,"_41288":1050,"_15362":82944,"_5":14925,"_21301":82351,"_6528":82945},[41736],"These older resources refer to obsolete implementations in some cases",{"_15044":1286,"_41288":1050,"_15362":82947,"_5":14925,"_21301":82351,"_6528":82948},[41736],"Los Anglees HBase Meetup - Sept, 4th, 2013",{"_15044":1287,"_41288":1050,"_15362":82950,"_5":14925,"_21301":82351,"_6528":82951},[41736],"Local Indexes by Huawei",{"_15044":1288,"_41288":1050,"_15362":82953,"_5":14925,"_21301":82351,"_6528":82954},[41736],"PHOENIX-938 and HBASE-11513 for deadlock prevention during global index maintenance.",{"_15044":1289,"_41288":1050,"_15362":82956,"_5":14925,"_21301":82351,"_6528":82957},[41736],"PHOENIX-1112: Atomically rebuild index partially when index update fails",{"_15044":1290,"_41288":1290,"_5":10980,"_6528":82959,"_41707":82960,"_15362":82961,"_21301":1290},"Skip Scan",[79080,79081,79082,80746],[41736],{"_15044":1291,"_41288":1290,"_15362":82963,"_5":14925,"_21301":1290,"_6528":82964},[41736],"How Phoenix Skip Scan uses key-range hints to efficiently skip non-matching row-key regions.",{"_15044":1292,"_41288":1290,"_15362":82966,"_5":14925,"_21301":1290,"_6528":82967},[41736],"Phoenix uses Skip Scan for intra-row scanning which allows for significant performance improvement over Range Scan when rows are retrieved based on a given set of keys.",{"_15044":1293,"_41288":1290,"_15362":82969,"_5":14925,"_21301":1290,"_6528":82970},[41736],"Skip Scan leverages SEEK_NEXT_USING_HINT in HBase filters. It stores information about which key sets or key ranges are being searched for in each column. During filter evaluation, it checks whether a key is in one of the valid combinations or ranges. If not, it computes the next highest key to jump to.",{"_15044":1294,"_41288":1290,"_15362":82972,"_5":14925,"_21301":1290,"_6528":82973},[41736],"Input to SkipScanFilter is a List<List<KeyRange>> where the top-level list represents each row-key column (that is, each primary key part), and the inner list represents OR-ed byte-array boundaries.",{"_15044":1295,"_41288":1290,"_15362":82975,"_5":14925,"_21301":1290,"_6528":82976},[41736],"Consider the following query:",{"_15044":1296,"_41288":1290,"_15362":82978,"_5":14925,"_21301":1290,"_6528":82979},[41736],"For the query above, the List<List<KeyRange>> passed to SkipScanFilter would look like:",{"_15044":1297,"_41288":1290,"_15362":82981,"_5":14925,"_21301":1290,"_6528":82982},[41736],"Here, [[a - b], [d - e]] represents ranges for KEY1, and [1, 2] represents the keys for KEY2.",{"_15044":1298,"_41288":1290,"_15362":82984,"_5":14925,"_21301":1290,"_6528":82985},[41736],"The following diagram illustrates graphically how the skip scan is able to jump around the key space:",{"_15044":1299,"_41288":1299,"_5":10980,"_6528":82987,"_41707":82988,"_15362":82989,"_21301":1299},"Statistics Collection",[79080,79081,79082,80746],[41736],{"_15044":1300,"_41288":1299,"_15362":82991,"_5":14925,"_21301":1299,"_6528":82992},[41736],"How Phoenix collects and uses guidepost statistics for query parallelization, with commands and configuration.",{"_15044":1301,"_41288":1299,"_5":41704,"_15362":82994,"_21301":82995,"_6528":82996},[41736],"/docs/features/statistics-collection#statistics-collection-parallelization","Parallelization",{"_15044":1302,"_41288":1299,"_5":41704,"_15362":82998,"_21301":82999,"_6528":80754},[41736],"/docs/features/statistics-collection#statistics-collection-examples",{"_15044":1303,"_41288":1299,"_5":41704,"_15362":83001,"_21301":83002,"_6528":83003},[41736],"/docs/features/statistics-collection#known-issues","Known issues",{"_15044":1304,"_41288":1299,"_5":41704,"_15362":83005,"_21301":83006,"_6528":79132},[41736],"/docs/features/statistics-collection#statistics-collection-configuration",{"_15044":1305,"_41288":1299,"_15362":83008,"_5":14925,"_21301":1299,"_6528":83009},[41736],"The UPDATE STATISTICS command updates the statistics collected on a table.\nThis command collects a set of keys per region per column family that\nare equal byte distanced from each other. These collected keys are called guideposts\nand they act as hints/guides to improve the parallelization of queries on a given\ntarget region.",{"_15044":1306,"_41288":1299,"_15362":83011,"_5":14925,"_21301":1299,"_6528":83012},[41736],"Statistics are also automatically collected during major compactions and region splits so\nmanually running this command may not be necessary.",{"_15044":1307,"_41288":1299,"_15362":83014,"_5":14925,"_21301":82995,"_6528":83015},[41736],"Phoenix breaks up queries into multiple scans and runs them in parallel to reduce latency.\nParallelization in Phoenix is driven by statistics-related configuration parameters.\nEach chunk of data between guideposts will be run in parallel in a separate scan to improve\nquery performance. The chunk size is determined by the GUIDE_POSTS_WIDTH table property (Phoenix 4.9+)\nor the global server-side phoenix.stats.guidepost.width parameter if the table property is\nnot set. As the size of the chunks decrease,\nyou'll want to increase phoenix.query.queueSize as more work will be queued in that\ncase. Note that at a minimum, separate scans will be run for each table region. Statistics in Phoenix\nprovides a means of gaining intraregion parallelization. In addition to the guidepost width specification,\nthe client-side phoenix.query.threadPoolSize and phoenix.query.queueSize parameters\nand the server-side hbase.regionserver.handler.count parameter have an impact on the amount\nof parallelization.",{"_15044":1308,"_41288":1299,"_15362":83017,"_5":14925,"_21301":82999,"_6528":83018},[41736],"To update the statistics for a given table my_table, execute the following command:",{"_15044":1309,"_41288":1299,"_15362":83020,"_5":14925,"_21301":82999,"_6528":83021},[41736],"The above syntax would collect the statistics for the table my_table and all the index tables,\nviews and view index tables associated with the table my_table.",{"_15044":1310,"_41288":1299,"_15362":83023,"_5":14925,"_21301":82999,"_6528":83024},[41736],"The equivalent syntax is:",{"_15044":1311,"_41288":1299,"_15362":83026,"_5":14925,"_21301":82999,"_6528":83027},[41736],"To collect statistics on the index table only:",{"_15044":1312,"_41288":1299,"_15362":83029,"_5":14925,"_21301":82999,"_6528":83030},[41736],"To collect statistics on the table only:",{"_15044":1313,"_41288":1299,"_15362":83032,"_5":14925,"_21301":82999,"_6528":83033},[41736],"To modify the guidepost width to 10MB for a table, execute the following command:",{"_15044":1314,"_41288":1299,"_15362":83035,"_5":14925,"_21301":82999,"_6528":83036},[41736],"To remove the guidepost width, set the property to null:",{"_15044":1315,"_41288":1299,"_15362":83038,"_5":14925,"_21301":83002,"_6528":83039},[41736],"Duplicated records (SQL count shows more rows than HBase row_count) can occur in Phoenix versions earlier than 4.12.",{"_15044":1316,"_41288":1299,"_15362":83041,"_5":14925,"_21301":83002,"_6528":83042},[41736],"This may happen for tables with several regions where guideposts were not generated for the last region(s) because the region size is smaller than the guidepost width.\nIn that case, parallel scans for those regions may start with the latest guidepost instead of the region start key.\nThis was fixed in 4.12 as part of PHOENIX-4007.",{"_15044":1317,"_41288":1299,"_15362":83044,"_5":14925,"_21301":83006,"_6528":83045},[41736],"The configuration parameters controlling statistics collection include:",{"_15044":1318,"_41288":1299,"_15362":83047,"_5":14925,"_21301":83006,"_6528":83048},[41736],"phoenix.stats.guidepost.width",{"_15044":1319,"_41288":1299,"_15362":83050,"_5":14925,"_21301":83006,"_6528":83051},[41736],"A server-side parameter that specifies the number of bytes between guideposts.\nA smaller amount increases parallelization, but also increases the number of\nchunks which must be merged on the client side.",{"_15044":1320,"_41288":1299,"_15362":83053,"_5":14925,"_21301":83006,"_6528":83054},[41736],"The default value is 104857600 (100 MB).",{"_15044":1321,"_41288":1299,"_15362":83056,"_5":14925,"_21301":83006,"_6528":83057},[41736],"phoenix.stats.updateFrequency",{"_15044":1322,"_41288":1299,"_15362":83059,"_5":14925,"_21301":83006,"_6528":83060},[41736],"A server-side parameter that determines the frequency in milliseconds for which statistics\nwill be refreshed from the statistics table and subsequently used by the client.",{"_15044":1323,"_41288":1299,"_15362":83062,"_5":14925,"_21301":83006,"_6528":83063},[41736],"The default value is 900000 (15 mins).",{"_15044":1324,"_41288":1299,"_15362":83065,"_5":14925,"_21301":83006,"_6528":83066},[41736],"phoenix.stats.minUpdateFrequency - A client-side parameter that determines the minimum amount of time in milliseconds that\nmust pass before statistics may again be manually collected through another UPDATE\nSTATISTICS call. - The default value is phoenix.stats.updateFrequency divided by two (7.5 mins).",{"_15044":1325,"_41288":1299,"_15362":83068,"_5":14925,"_21301":83006,"_6528":83069},[41736],"phoenix.stats.useCurrentTime",{"_15044":1326,"_41288":1299,"_15362":83071,"_5":14925,"_21301":83006,"_6528":83072},[41736],"An advanced server-side parameter that, if true, causes the current time on the server-side\nto be used as the timestamp of rows in the statistics table when background tasks such as\ncompactions or splits occur. If false, then the max timestamp found while traversing the\ntable over which statistics are being collected is used as the timestamp. Unless your\nclient is controlling the timestamps while reading and writing data, this parameter\nshould be left alone.",{"_15044":1327,"_41288":1299,"_15362":83074,"_5":14925,"_21301":83006,"_6528":83075},[41736],"The default value is true.",{"_15044":1328,"_41288":1299,"_15362":83077,"_5":14925,"_21301":83006,"_6528":83078},[41736],"phoenix.use.stats.parallelization",{"_15044":1329,"_41288":1299,"_15362":83080,"_5":14925,"_21301":83006,"_6528":83081},[41736],"This configuration is available starting in Phoenix 4.12. It controls whether statistical information\non the data should be used to drive query parallelization.",{"_15044":1330,"_41288":1299,"_15362":83083,"_5":14925,"_21301":83006,"_6528":83075},[41736],{"_15044":1331,"_41288":1331,"_5":10980,"_6528":83085,"_41707":83086,"_15362":83087,"_21301":1331},"Storage Formats",[79080,79081,79082,80746],[41736],{"_15044":1332,"_41288":1331,"_15362":83089,"_5":14925,"_21301":1331,"_6528":83090},[41736],"Configure Phoenix column mapping and immutable storage encoding for better storage efficiency and performance.",{"_15044":1333,"_41288":1331,"_5":41704,"_15362":83092,"_21301":83093,"_6528":83094},[41736],"/docs/features/storage-formats#how-to-use-column-mapping","How to use column mapping",{"_15044":1334,"_41288":1331,"_5":41704,"_15362":83096,"_21301":83097,"_6528":83098},[41736],"/docs/features/storage-formats#how-to-use-immutable-data-encoding","How to use immutable data encoding",{"_15044":1335,"_41288":1331,"_5":41704,"_15362":83100,"_21301":83101,"_6528":83102},[41736],"/docs/features/storage-formats#how-to-disable-column-mapping","How to disable column mapping",{"_15044":1336,"_41288":1331,"_15362":83104,"_5":14925,"_21301":1331,"_6528":83105},[41736],"As part of Phoenix 4.10, we have reduced on-disk storage size to improve overall performance by implementing the following enhancements:",{"_15044":1337,"_41288":1331,"_15362":83107,"_5":14925,"_21301":1331,"_6528":83108},[41736],"Introduce a layer of indirection between Phoenix column names and the corresponding HBase column qualifiers.",{"_15044":1338,"_41288":1331,"_15362":83110,"_5":14925,"_21301":1331,"_6528":83111},[41736],"Support a new encoding scheme for immutable tables that packs all values into a single cell per column family.",{"_15044":1339,"_41288":1331,"_15362":83113,"_5":14925,"_21301":1331,"_6528":83114},[41736],"For more details on column mapping and immutable data encoding, see this blog.",{"_15044":1340,"_41288":1331,"_15362":83116,"_5":14925,"_21301":83093,"_6528":83117},[41736],"You can set the column mapping property only when creating a table. Before deciding to use column mapping, think about how many columns your table and view hierarchy will require over their lifecycle. The following limits apply for each mapping scheme:",{"_15044":1341,"_41288":1331,"_15362":83119,"_5":14925,"_21301":83093,"_6528":83120},[41736],"Config/Property Value",{"_15044":1342,"_41288":1331,"_15362":83122,"_5":14925,"_21301":83093,"_6528":83123},[41736],"Max # of columns",{"_15044":1343,"_41288":1331,"_15362":83125,"_5":14925,"_21301":83093,"_6528":8001},[41736],{"_15044":1344,"_41288":1331,"_15362":83127,"_5":14925,"_21301":83093,"_6528":40155},[41736],{"_15044":1345,"_41288":1331,"_15362":83129,"_5":14925,"_21301":83093,"_6528":8030},[41736],{"_15044":1346,"_41288":1331,"_15362":83131,"_5":14925,"_21301":83093,"_6528":41269},[41736],{"_15044":1347,"_41288":1331,"_15362":83133,"_5":14925,"_21301":83093,"_6528":8057},[41736],{"_15044":1348,"_41288":1331,"_15362":83135,"_5":14925,"_21301":83093,"_6528":39128},[41736],{"_15044":1349,"_41288":1331,"_15362":83137,"_5":14925,"_21301":83093,"_6528":7980},[41736],{"_15044":1350,"_41288":1331,"_15362":83139,"_5":14925,"_21301":83093,"_6528":40049},[41736],{"_15044":1351,"_41288":1331,"_15362":83141,"_5":14925,"_21301":83093,"_6528":83142},[41736],"NONE",{"_15044":1352,"_41288":1331,"_15362":83144,"_5":14925,"_21301":83093,"_6528":83145},[41736],"no limit (theoretically)",{"_15044":1353,"_41288":1331,"_15362":83147,"_5":14925,"_21301":83093,"_6528":83148},[41736],"For mutable tables, this limit applies to columns in all column families. For immutable tables, the limit applies per column family. By default, new Phoenix tables use column mapping. These defaults can be overridden by setting the following config value in hbase-site.xml.",{"_15044":1354,"_41288":1331,"_15362":83150,"_5":14925,"_21301":83093,"_6528":83151},[41736],"Table type",{"_15044":1355,"_41288":1331,"_15362":83153,"_5":14925,"_21301":83093,"_6528":83154},[41736],"Default Column mapping",{"_15044":1356,"_41288":1331,"_15362":83156,"_5":14925,"_21301":83093,"_6528":83157},[41736],"Config",{"_15044":1357,"_41288":1331,"_15362":83159,"_5":14925,"_21301":83093,"_6528":83160},[41736],"Mutable/Immutable",{"_15044":1358,"_41288":1331,"_15362":83162,"_5":14925,"_21301":83093,"_6528":83163},[41736],"2 byte qualifiers",{"_15044":1359,"_41288":1331,"_15362":83165,"_5":14925,"_21301":83093,"_6528":83166},[41736],"phoenix.default.column.encoded.bytes.attrib",{"_15044":1360,"_41288":1331,"_15362":83168,"_5":14925,"_21301":83093,"_6528":83169},[41736],"This config controls global defaults that apply to all tables. If you want a different mapping scheme than the global default, use the COLUMN_ENCODED_BYTES table property.",{"_15044":1361,"_41288":1331,"_15362":83171,"_5":14925,"_21301":83097,"_6528":83172},[41736],"Like column mapping, immutable data encoding can only be set when creating a table. Through performance testing, SINGLE_CELL_ARRAY_WITH_OFFSETS generally provides strong performance and space savings. Below are some scenarios where ONE_CELL_PER_COLUMN encoding may be a better fit.",{"_15044":1362,"_41288":1331,"_15362":83174,"_5":14925,"_21301":83097,"_6528":83175},[41736],"Data is sparse, i.e. less than 50% of the columns have values.",{"_15044":1363,"_41288":1331,"_15362":83177,"_5":14925,"_21301":83097,"_6528":83178},[41736],"Size of data within a column family gets too big. With default HBase block size of 64K, if data within a column family grows beyond 50K then SINGLE_CELL_ARRAY_WITH_OFFSETS is generally not recommended.",{"_15044":1364,"_41288":1331,"_15362":83180,"_5":14925,"_21301":83097,"_6528":83181},[41736],"Immutable tables that are expected to have views on them.",{"_15044":1365,"_41288":1331,"_15362":83183,"_5":14925,"_21301":83097,"_6528":83184},[41736],"By default, immutable non-multitenant tables are created using two-byte column mapping and SINGLE_CELL_ARRAY_WITH_OFFSETS data encoding. Immutable multi-tenant tables are created with two-byte column mapping and ONE_CELL_PER_COLUMN data encoding. This is because users often create tenant-specific views on base multi-tenant tables, and as noted above this is more suitable for ONE_CELL_PER_COLUMN. Like column mapping, you can change these global defaults by setting the following configs in hbase-site.xml.",{"_15044":1366,"_41288":1331,"_15362":83186,"_5":14925,"_21301":83097,"_6528":83187},[41736],"Immutable Table type",{"_15044":1367,"_41288":1331,"_15362":83189,"_5":14925,"_21301":83097,"_6528":83190},[41736],"Immutable storage scheme",{"_15044":1368,"_41288":1331,"_15362":83192,"_5":14925,"_21301":83097,"_6528":83157},[41736],{"_15044":1369,"_41288":1331,"_15362":83194,"_5":14925,"_21301":83097,"_6528":83195},[41736],"Multi-tenant",{"_15044":1370,"_41288":1331,"_15362":83197,"_5":14925,"_21301":83097,"_6528":83198},[41736],"ONE_CELL_PER_COLUMN",{"_15044":1371,"_41288":1331,"_15362":83200,"_5":14925,"_21301":83097,"_6528":83201},[41736],"phoenix.default.multitenant.immutable.storage.scheme",{"_15044":1372,"_41288":1331,"_15362":83203,"_5":14925,"_21301":83097,"_6528":83204},[41736],"Non multi-tenant",{"_15044":1373,"_41288":1331,"_15362":83206,"_5":14925,"_21301":83097,"_6528":83207},[41736],"SINGLE_CELL_ARRAY_WITH_OFFSETS",{"_15044":1374,"_41288":1331,"_15362":83209,"_5":14925,"_21301":83097,"_6528":83210},[41736],"phoenix.default.immutable.storage.scheme",{"_15044":1375,"_41288":1331,"_15362":83212,"_5":14925,"_21301":83097,"_6528":83213},[41736],"You can also provide specific immutable storage and column mapping schemes with the IMMUTABLE_STORAGE_SCHEME and COLUMN_ENCODED_BYTES table properties. For example:",{"_15044":1376,"_41288":1331,"_15362":83215,"_5":14925,"_21301":83097,"_6528":83216},[41736],"You can choose not to use SINGLE_CELL_ARRAY_WITH_OFFSETS while still using numeric column mapping. For example:",{"_15044":1377,"_41288":1331,"_15362":83218,"_5":14925,"_21301":83097,"_6528":83219},[41736],"When using SINGLE_CELL_ARRAY_WITH_OFFSETS, you must use a numeric column mapping scheme. Attempting to use SINGLE_CELL_ARRAY_WITH_OFFSETS with COLUMN_ENCODED_BYTES = NONE throws an error.",{"_15044":1378,"_41288":1331,"_15362":83221,"_5":14925,"_21301":83101,"_6528":83222},[41736],"To disable column mapping across all new tables, set phoenix.default.column.encoded.bytes.attrib to 0. You can also keep it enabled globally and disable it selectively for a table by setting COLUMN_ENCODED_BYTES = 0 in the CREATE TABLE statement.",{"_15044":1379,"_41288":1379,"_5":10980,"_6528":83224,"_41707":83225,"_15362":83226,"_21301":1379},"Table Sampling",[79080,79081,79082,80746],[41736],{"_15044":1380,"_41288":1379,"_15362":83228,"_5":14925,"_21301":1379,"_6528":83229},[41736],"Use TABLESAMPLE in Phoenix for Bernoulli-style sampling, with performance notes, repeatability behavior, and tuning guidance.",{"_15044":1381,"_41288":1379,"_5":41704,"_15362":83231,"_21301":83232,"_6528":82201},[41736],"/docs/features/table-sampling#table-sampling-performance",{"_15044":1382,"_41288":1379,"_5":41704,"_15362":83234,"_21301":83235,"_6528":83236},[41736],"/docs/features/table-sampling#repeatable","Repeatable",{"_15044":1383,"_41288":1379,"_5":41704,"_15362":83238,"_21301":83239,"_6528":80754},[41736],"/docs/features/table-sampling#table-sampling-examples",{"_15044":1384,"_41288":1379,"_5":41704,"_15362":83241,"_21301":83242,"_6528":82334},[41736],"/docs/features/table-sampling#table-sampling-tuning",{"_15044":1385,"_41288":1379,"_15362":83244,"_5":14925,"_21301":1379,"_6528":83245},[41736],"To support table sampling (similar to PostgreSQL and T-SQL syntax), a TABLESAMPLE clause was incorporated into aliased table references as of Phoenix 4.12. The general syntax is described here. This feature limits the number of rows returned from a table to a percentage of rows. See PHOENIX-153 for implementation details.",{"_15044":1386,"_41288":1379,"_15362":83247,"_5":14925,"_21301":1379,"_6528":83248},[41736],"This feature is implemented with a Bernoulli trial and a consistent-hashing-based table sampler to achieve Bernoulli sampling on a given row population. Given a sampling rate, it leverages Phoenix statistics and HBase region distribution to perform table sampling.",{"_15044":1387,"_41288":1379,"_15362":83250,"_5":14925,"_21301":1379,"_6528":83251},[41736],"As part of statistics collection, a guidepost (a row reference) is created at equidistant byte intervals. When sampling is required, a Bernoulli trial process is applied repeatedly on each guidepost in each region with a probability proportional to the sampling rate. An included guidepost results in all rows between it and the next guidepost being included in the sample population.",{"_15044":1388,"_41288":1379,"_15362":83253,"_5":14925,"_21301":83232,"_6528":83254},[41736],"Sampling on a table with a sampling rate of 100% costs roughly the same computational resources as a query without sampling.\nResource consumption drops quickly as sampling rate decreases. In general, the amortized complexity of the sampling process is O(k + mn), where:",{"_15044":1389,"_41288":1379,"_15362":83256,"_5":14925,"_21301":83232,"_6528":83257},[41736],"n is the number of regions in the sampled HBase table.",{"_15044":1390,"_41288":1379,"_15362":83259,"_5":14925,"_21301":83232,"_6528":83260},[41736],"m is the number of guideposts.",{"_15044":1391,"_41288":1379,"_15362":83262,"_5":14925,"_21301":83232,"_6528":83263},[41736],"k is the sampled population size.",{"_15044":1392,"_41288":1379,"_15362":83265,"_5":14925,"_21301":83235,"_6528":83266},[41736],"Repeatable means repeated sampling on the same table returns the same sampled result.",{"_15044":1393,"_41288":1379,"_15362":83268,"_5":14925,"_21301":83235,"_6528":83269},[41736],"Repeatability is enabled by applying a consistent-hashing process to the binary representation of the start row key of each guidepost in each region during sampling. By default, an FNV1 implementation with lazy modulo is used. See FNV1.",{"_15044":1394,"_41288":1379,"_15362":83271,"_5":14925,"_21301":83239,"_6528":83272},[41736],"To sample a table, execute a query such as the following. The sampling rate is a numeric value between 0 and 100, inclusive.",{"_15044":1395,"_41288":1379,"_15362":83274,"_5":14925,"_21301":83239,"_6528":83275},[41736],"More examples:",{"_15044":1396,"_41288":1379,"_15362":83277,"_5":14925,"_21301":83239,"_6528":83278},[41736],"To use with aggregation:",{"_15044":1397,"_41288":1379,"_15362":83280,"_5":14925,"_21301":83239,"_6528":83281},[41736],"To explain a sampled query:",{"_15044":1398,"_41288":1379,"_15362":83283,"_5":14925,"_21301":83242,"_6528":83284},[41736],"Due to the sampling process, TABLESAMPLE should be used with caution. For example, a join of two tables is likely to return a match for each row in both tables; however, when sampling is applied to one or both tables, join results may differ from non-sampled expectations.",{"_15044":1399,"_41288":1379,"_15362":83286,"_5":14925,"_21301":83242,"_6528":83287},[41736],"Statistics should be collected to achieve the best sampling accuracy. To turn on statistics collection, refer to Statistics Collection.",{"_15044":1400,"_41288":1379,"_15362":83289,"_5":14925,"_21301":83242,"_6528":83290},[41736],"A denser guidepost setting improves sampling accuracy, but may reduce performance. A comparison is shown below.",{"_15044":1401,"_41288":1401,"_5":10980,"_6528":83292,"_41707":83293,"_15362":83294,"_21301":1401},"Tracing",[79080,79081,79082,80746],[41736],{"_15044":1402,"_41288":1401,"_15362":83296,"_5":14925,"_21301":1401,"_6528":83297},[41736],"Configure, enable, collect, and inspect Phoenix tracing data, including metrics sinks and tracing web app usage.",{"_15044":1403,"_41288":1401,"_5":41704,"_15362":83299,"_21301":83300,"_6528":79132},[41736],"/docs/features/tracing#tracing-configuration",{"_15044":1404,"_41288":1401,"_5":41704,"_15362":83302,"_21301":83303,"_6528":83304},[41736],"/docs/features/tracing#hadoop-metrics2-phoenixproperties","hadoop-metrics2-phoenix.properties",{"_15044":1405,"_41288":1401,"_5":41704,"_15362":83306,"_21301":83307,"_6528":83308},[41736],"/docs/features/tracing#hadoop-metrics2-hbaseproperties","hadoop-metrics2-hbase.properties",{"_15044":1406,"_41288":1401,"_5":41704,"_15362":83310,"_21301":83311,"_6528":83312},[41736],"/docs/features/tracing#disabling-tracing","Disabling tracing",{"_15044":1407,"_41288":1401,"_5":41704,"_15362":83314,"_21301":83315,"_6528":81604},[41736],"/docs/features/tracing#tracing-usage",{"_15044":1408,"_41288":1401,"_5":41704,"_15362":83317,"_21301":83318,"_6528":83319},[41736],"/docs/features/tracing#client-property","Client Property",{"_15044":1409,"_41288":1401,"_5":41704,"_15362":83321,"_21301":83322,"_6528":83323},[41736],"/docs/features/tracing#hbase-sitexml","hbase-site.xml",{"_15044":1410,"_41288":1401,"_5":41704,"_15362":83325,"_21301":83326,"_6528":83327},[41736],"/docs/features/tracing#reading-traces","Reading Traces",{"_15044":1411,"_41288":1401,"_5":41704,"_15362":83329,"_21301":83330,"_6528":83331},[41736],"/docs/features/tracing#phoenix-tracing-web-application","Phoenix Tracing Web Application",{"_15044":1412,"_41288":1401,"_5":41704,"_15362":83333,"_21301":83334,"_6528":83335},[41736],"/docs/features/tracing#how-to-start-the-tracing-web-application","How to start the tracing web application",{"_15044":1413,"_41288":1401,"_5":41704,"_15362":83337,"_21301":83338,"_6528":83339},[41736],"/docs/features/tracing#changing-the-web-app-port-number","Changing the web app port number",{"_15044":1414,"_41288":1401,"_5":41704,"_15362":83341,"_21301":83342,"_6528":83343},[41736],"/docs/features/tracing#feature-list","Feature list",{"_15044":1415,"_41288":1401,"_5":41704,"_15362":83345,"_21301":83346,"_6528":83347},[41736],"/docs/features/tracing#list","List",{"_15044":1416,"_41288":1401,"_5":41704,"_15362":83349,"_21301":83350,"_6528":83351},[41736],"/docs/features/tracing#dependency-tree","Dependency tree",{"_15044":1417,"_41288":1401,"_5":41704,"_15362":83353,"_21301":83354,"_6528":83355},[41736],"/docs/features/tracing#trace-count","Trace count",{"_15044":1418,"_41288":1401,"_5":41704,"_15362":83357,"_21301":83358,"_6528":83359},[41736],"/docs/features/tracing#trace-distribution","Trace distribution",{"_15044":1419,"_41288":1401,"_5":41704,"_15362":83361,"_21301":83362,"_6528":83363},[41736],"/docs/features/tracing#timeline","Timeline",{"_15044":1420,"_41288":1401,"_15362":83365,"_5":14925,"_21301":1401,"_6528":83366},[41736],"As of Phoenix 4.1.0, Phoenix supports collecting per-request traces. This allows you to see each important step in a query or insertion, all the way from the client through HBase and back again.",{"_15044":1421,"_41288":1401,"_15362":83368,"_5":14925,"_21301":1401,"_6528":83369},[41736],"Phoenix leverages Cloudera's HTrace library to integrate with HBase tracing utilities. Trace metrics are then deposited into a Hadoop Metrics2 sink that writes them into a Phoenix table.",{"_15044":1422,"_41288":1401,"_15362":83371,"_5":14925,"_21301":1401,"_6528":83372},[41736],"Writing traces to a Phoenix table is not supported on Hadoop 1.",{"_15044":1423,"_41288":1401,"_15362":83374,"_5":14925,"_21301":83300,"_6528":83375},[41736],"There are two key configuration files that you will need to update.",{"_15044":1424,"_41288":1401,"_15362":83377,"_5":14925,"_21301":83300,"_6528":83304},[41736],{"_15044":1425,"_41288":1401,"_15362":83379,"_5":14925,"_21301":83300,"_6528":83308},[41736],{"_15044":1426,"_41288":1401,"_15362":83381,"_5":14925,"_21301":83300,"_6528":83382},[41736],"They contain the properties you need to set on the client and server, respectively, as well as information on how the Metrics2 system uses the configuration files.",{"_15044":1427,"_41288":1401,"_15362":83384,"_5":14925,"_21301":83300,"_6528":83385},[41736],"Put these files on their respective classpaths and restart the process to pick up the new configurations.",{"_15044":1428,"_41288":1401,"_15362":83387,"_5":14925,"_21301":83303,"_6528":83388},[41736],"This file will configure the Hadoop Metrics2 system for Phoenix clients.",{"_15044":1429,"_41288":1401,"_15362":83390,"_5":14925,"_21301":83303,"_6528":83391},[41736],"The default properties you should set are:",{"_15044":1430,"_41288":1401,"_15362":83393,"_5":14925,"_21301":83303,"_6528":83394},[41736],"This enables standard Phoenix metrics sink (which collects the trace information) and writer (writes the traces to the Phoenix SYSTEM.TRACING_STATS table). You can modify this to set your own custom classes as well, if you have them.",{"_15044":1431,"_41288":1401,"_15362":83396,"_5":14925,"_21301":83303,"_6528":83397},[41736],"See the properties file in the source (phoenix-hadoop2-compat/bin) for more information on setting custom sinks and writers.",{"_15044":1432,"_41288":1401,"_15362":83399,"_5":14925,"_21301":83307,"_6528":83400},[41736],"A default HBase deployment already includes a Metrics2 configuration, so Phoenix Metrics2 config can either replace the existing file (if you do not have custom settings) or be merged into your existing Metrics2 configuration file.",{"_15044":1433,"_41288":1401,"_15362":83402,"_5":14925,"_21301":83307,"_6528":83403},[41736],"These are essentially the same properties as in hadoop-metrics2-phoenix.properties, but prefixed with hbase instead of phoenix so they are loaded with the rest of HBase metrics.",{"_15044":1434,"_41288":1401,"_15362":83405,"_5":14925,"_21301":83311,"_6528":83406},[41736],"You can disable tracing for client requests by creating a new connection without the tracing property enabled (see below).",{"_15044":1435,"_41288":1401,"_15362":83408,"_5":14925,"_21301":83311,"_6528":83409},[41736],"However, on the server side, once the metrics sink is enabled you cannot turn off trace collection and writing unless you remove the Phoenix Metrics2 configuration and restart the region server. This is enforced by the Metrics2 framework, which assumes server metrics should always be collected.",{"_15044":1436,"_41288":1401,"_15362":83411,"_5":14925,"_21301":83315,"_6528":83412},[41736],"There are only a couple small things you need to do to enable tracing a given request with Phoenix.",{"_15044":1437,"_41288":1401,"_15362":83414,"_5":14925,"_21301":83318,"_6528":83415},[41736],"The frequency of tracing is determined by the following client-side Phoenix property:",{"_15044":1438,"_41288":1401,"_15362":83417,"_5":14925,"_21301":83318,"_6528":83418},[41736],"There are three possible tracing frequencies you can use:",{"_15044":1439,"_41288":1401,"_15362":83420,"_5":14925,"_21301":83318,"_6528":37926},[41736],{"_15044":1440,"_41288":1401,"_15362":83422,"_5":14925,"_21301":83318,"_6528":83423},[41736],"This is the default",{"_15044":1441,"_41288":1401,"_15362":83425,"_5":14925,"_21301":83318,"_6528":23392},[41736],{"_15044":1442,"_41288":1401,"_15362":83427,"_5":14925,"_21301":83318,"_6528":83428},[41736],"Every request will be traced",{"_15044":1443,"_41288":1401,"_15362":83430,"_5":14925,"_21301":83318,"_6528":9687},[41736],{"_15044":1444,"_41288":1401,"_15362":83432,"_5":14925,"_21301":83318,"_6528":83433},[41736],"Take traces with a probabilistic frequency",{"_15044":1445,"_41288":1401,"_15362":83435,"_5":14925,"_21301":83318,"_6528":83436},[41736],"probability threshold is set by phoenix.trace.probability.threshold with a default of 0.05 (5%).",{"_15044":1446,"_41288":1401,"_15362":83438,"_5":14925,"_21301":83318,"_6528":83439},[41736],"As with other configuration properties, this property may be specified at JDBC connection time as a connection property.\nEnabling one of these properties only turns on trace collection. Trace data still needs to be deposited somewhere.",{"_15044":1447,"_41288":1401,"_15362":83441,"_5":14925,"_21301":83318,"_6528":80646},[41736],{"_15044":1448,"_41288":1401,"_15362":83443,"_5":14925,"_21301":83322,"_6528":83444},[41736],"You can also enable tracing via hbase-site.xml. However, only always and never are currently supported.",{"_15044":1449,"_41288":1401,"_15362":83446,"_5":14925,"_21301":83326,"_6528":83447},[41736],"Once the traces are deposited into the tracing table, by default SYSTEM.TRACING_STATS, but it is configurable in the HBase configuration via:",{"_15044":1450,"_41288":1401,"_15362":83449,"_5":14925,"_21301":83326,"_6528":83450},[41736],"The tracing table is initialized via the DDL:",{"_15044":1451,"_41288":1401,"_15362":83452,"_5":14925,"_21301":83326,"_6528":83453},[41736],"The tracing table also contains a number of dynamic columns for each trace. A trace is identified by trace ID (request ID), parent ID (parent span ID), and span ID (individual segment ID), and may have multiple tags and annotations. Once you know the number of tags and annotations, you can retrieve them from the table with a query like:",{"_15044":1452,"_41288":1401,"_15362":83455,"_5":14925,"_21301":83326,"_6528":83456},[41736],"Where columns is either annotations.aX or tags.tX, where X is the index of the dynamic column to look up.",{"_15044":1453,"_41288":1401,"_15362":83458,"_5":14925,"_21301":83326,"_6528":83459},[41736],"For more usage examples, see TraceReader, which can programmatically read traces from the tracing results table.",{"_15044":1454,"_41288":1401,"_15362":83461,"_5":14925,"_21301":83326,"_6528":83462},[41736],"Custom annotations can also be passed into Phoenix to be added to traces. Phoenix looks for connection properties whose names start with phoenix.annotation. and adds them as annotations to client-side traces. For example, a connection property phoenix.annotation.myannotation=abc results in an annotation with key myannotation and value abc. Use this to link traces to other request identifiers in your system, such as user or session IDs.",{"_15044":1455,"_41288":1401,"_15362":83464,"_5":14925,"_21301":83334,"_6528":83465},[41736],"Enable tracing for Apache Phoenix as above",{"_15044":1456,"_41288":1401,"_15362":83467,"_5":14925,"_21301":83334,"_6528":83468},[41736],"Start the web app:",{"_15044":1457,"_41288":1401,"_15362":83470,"_5":14925,"_21301":83334,"_6528":83471},[41736],"Open this URL in your browser: http://localhost:8864/webapp/",{"_15044":1458,"_41288":1401,"_15362":83473,"_5":14925,"_21301":83334,"_6528":83474},[41736],"Stop the tracing web app:",{"_15044":1459,"_41288":1401,"_15362":83476,"_5":14925,"_21301":83338,"_6528":83477},[41736],"Execute the command below:",{"_15044":1460,"_41288":1401,"_15362":83479,"_5":14925,"_21301":83342,"_6528":83480},[41736],"The tracing web app for Apache Phoenix includes: feature list, dependency tree, trace count, trace distribution, and timeline.",{"_15044":1461,"_41288":1401,"_15362":83482,"_5":14925,"_21301":83346,"_6528":83483},[41736],"The most recent traces are listed down. The limiting value entered on the textbox is used to determine the trace count displayed. With each trace, there is a link to view either the dependency tree or the timeline.",{"_15044":1462,"_41288":1401,"_15362":83485,"_5":14925,"_21301":83350,"_6528":83486},[41736],"The dependency tree shows traces for a given trace ID in a tree view. Parent-child relationships are displayed clearly. Tooltip data includes host name, parent ID, span ID, start time, end time, description, and duration. Each node is collapsible and expandable. The SQL query is shown for each tree rendering. Clear is used to remove the tree from view.",{"_15044":1463,"_41288":1401,"_15362":83488,"_5":14925,"_21301":83354,"_6528":83489},[41736],"The trace list is categorized by description. The trace count chart can be viewed as pie, line, bar, or area chart. The chart selector is collapsible and can be hidden.",{"_15044":1464,"_41288":1401,"_15362":83491,"_5":14925,"_21301":83358,"_6528":83492},[41736],"The trace distribution chart shows traces across Phoenix hosts on which they are running. Chart types include pie, line, bar, and area. The chart selector is collapsible and can be hidden.",{"_15044":1465,"_41288":1401,"_15362":83494,"_5":14925,"_21301":83362,"_6528":83495},[41736],"The traces can be viewed along the time axis for a given trace id. Traces can be added or cleared from the timeline. There should be a minimum of two traces starting at two different times for the system to draw its timeline. This feature helps the user to easily compare execution times between traces and within the same trace.",{"_15044":1466,"_41288":1466,"_5":10980,"_6528":83497,"_41707":83498,"_15362":83499,"_21301":1466},"Transactions",[79080,79081,79082,80746],[41736],{"_15044":1467,"_41288":1466,"_15362":83501,"_5":14925,"_21301":1466,"_6528":83502},[41736],"Configure and use transactional tables in Phoenix with Tephra, including setup steps and limitations.",{"_15044":1468,"_41288":1466,"_5":41704,"_15362":83504,"_21301":83505,"_6528":79202},[41736],"/docs/features/transactions#transactions-limitations",{"_15044":1469,"_41288":1466,"_15362":83507,"_5":14925,"_21301":1466,"_6528":83508},[41736],"Transactions (beta). Above and beyond the row-level transactional semantics of HBase, Phoenix adds cross row and cross table transaction support with full ACID semantics by integrating with Tephra, now an Apache incubator project. Tephra provides snapshot isolation of concurrent transactions by implementing multi-versioned concurrency control.",{"_15044":1470,"_41288":1466,"_15362":83510,"_5":14925,"_21301":1466,"_6528":83511},[41736],"Set up a system to use transactions in Phoenix with the following steps:",{"_15044":1471,"_41288":1466,"_15362":83513,"_5":14925,"_21301":1466,"_6528":83514},[41736],"Add the following config to your client-side hbase-site.xml file to enable transactions:",{"_15044":1472,"_41288":1466,"_15362":83516,"_5":14925,"_21301":1466,"_6528":83517},[41736],"Add the following config to your server-side hbase-site.xml file to configure the transaction manager.\nThe \"Transaction Server Configuration\" section of Tephra describes the available configuration options.",{"_15044":1473,"_41288":1466,"_15362":83519,"_5":14925,"_21301":1466,"_6528":83520},[41736],"Also set the transaction timeout (time after which open transactions become invalid) to a reasonable value:",{"_15044":1474,"_41288":1466,"_15362":83522,"_5":14925,"_21301":1466,"_6528":83523},[41736],"Set $HBASE_HOME and start the transaction manager:",{"_15044":1475,"_41288":1466,"_15362":83525,"_5":14925,"_21301":1466,"_6528":83526},[41736],"The transaction manager would typically be configured to run on one or more of the master nodes in your HBase cluster.",{"_15044":1476,"_41288":1466,"_15362":83528,"_5":14925,"_21301":1466,"_6528":83529},[41736],"Once this setup is done, transactions may then be enabled on a table by table basis by using the TRANSACTIONAL=true property when you create your table:",{"_15044":1477,"_41288":1466,"_15362":83531,"_5":14925,"_21301":1466,"_6528":83532},[41736],"An existing table may also be altered to be transactional, but be careful because you cannot switch a transactional table back to being non transactional:",{"_15044":1478,"_41288":1466,"_15362":83534,"_5":14925,"_21301":1466,"_6528":83535},[41736],"A transaction is started implicitly through the execution of a statement on a transactional table and then finished through either a commit or rollback. Once started, the statements will not see any data committed by other transactions until the transaction is complete. They will, however, see their own uncommitted data. For example:",{"_15044":1479,"_41288":1466,"_15362":83537,"_5":14925,"_21301":1466,"_6528":83538},[41736],"An exception is thrown if a transaction tries to commit a row that conflicts with other overlapping transaction that already committed. For example:",{"_15044":1480,"_41288":1466,"_15362":83540,"_5":14925,"_21301":1466,"_6528":83541},[41736],"In a second transaction perform a commit for the same row.",{"_15044":1481,"_41288":1466,"_15362":83543,"_5":14925,"_21301":1466,"_6528":83544},[41736],"Now if you try to commit the first transaction you will get an exception",{"_15044":1482,"_41288":1466,"_15362":83546,"_5":14925,"_21301":1466,"_6528":83547},[41736],"Queries are only able to view commits that completed before the current transaction started and are not able to view the in progress changes of other transactions.",{"_15044":1483,"_41288":1466,"_15362":83549,"_5":14925,"_21301":1466,"_6528":83550},[41736],"Indexes added to a transactional table are transactional as well with regard to their incremental maintenance. For example, the following index added to my_table will be kept transactional consistent with its data table as mutations are made:",{"_15044":1484,"_41288":1466,"_15362":83552,"_5":14925,"_21301":1466,"_6528":83553},[41736],"During a commit, if either the index or data table write fails, an exception is thrown and the client can either roll back or retry.\nIf the commit fails both the index and data table rows are not visible.",{"_15044":1485,"_41288":1466,"_15362":83555,"_5":14925,"_21301":1466,"_6528":83556},[41736],"An external Tephra transaction that has already been started can be used with Phoenix by setting the transaction context of the Phoenix connection:",{"_15044":1486,"_41288":1466,"_15362":83558,"_5":14925,"_21301":83505,"_6528":83559},[41736],"Starting a transaction on a connection with an SCN set is not allowed.",{"_15044":1487,"_41288":1466,"_15362":83561,"_5":14925,"_21301":83505,"_6528":83562},[41736],"Setting the maximum number of versions property while creating a transactional table limits the number of snapshots available for concurrent transactions.",{"_15044":1488,"_41288":1466,"_15362":83564,"_5":14925,"_21301":83505,"_6528":83565},[41736],"When a transaction times out or if it cannot be rolled back by the client, it is added to an invalid list. This list can potentially grow if there are a lot of failed or timed out transactions.\nFor now, an administrator can manually clear transactions from this list after a major compaction has occurred. TEPHRA-35 describes ongoing work to automatically remove transactions from the invalid list once all data associated with the transaction has been removed.",{"_15044":1489,"_41288":1466,"_15362":83567,"_5":14925,"_21301":83505,"_6528":83568},[41736],"If adding an index asynchronously to an existing transactional table, make sure to run a major compaction before issuing the CREATE INDEX ASYNC command as otherwise invalid and/or uncommitted transactions may appear in your index PHOENIX-2154.",{"_15044":1490,"_41288":1490,"_5":10980,"_6528":83570,"_41707":83571,"_15362":83572,"_21301":1490},"User-defined Functions",[79080,79081,79082,80746],[41736],{"_15044":1491,"_41288":1490,"_15362":83574,"_5":14925,"_21301":1490,"_6528":83575},[41736],"Create, deploy, and manage custom Phoenix UDFs with configuration, implementation steps, and known limitations.",{"_15044":1492,"_41288":1490,"_5":41704,"_15362":83577,"_21301":83578,"_6528":81592},[41736],"/docs/features/user-defined-functions#user-defined-functions-overview",{"_15044":1493,"_41288":1490,"_5":41704,"_15362":83580,"_21301":83581,"_6528":79132},[41736],"/docs/features/user-defined-functions#user-defined-functions-configuration",{"_15044":1494,"_41288":1490,"_5":41704,"_15362":83583,"_21301":83584,"_6528":83585},[41736],"/docs/features/user-defined-functions#creating-custom-udfs","Creating Custom UDFs",{"_15044":1495,"_41288":1490,"_5":41704,"_15362":83587,"_21301":83588,"_6528":83589},[41736],"/docs/features/user-defined-functions#dropping-the-udfs","Dropping the UDFs",{"_15044":1496,"_41288":1490,"_5":41704,"_15362":83591,"_21301":83592,"_6528":83593},[41736],"/docs/features/user-defined-functions#how-to-write-custom-udf","How to write custom UDF",{"_15044":1497,"_41288":1490,"_5":41704,"_15362":83595,"_21301":83596,"_6528":79202},[41736],"/docs/features/user-defined-functions#user-defined-functions-limitations",{"_15044":1498,"_41288":1490,"_15362":83598,"_5":14925,"_21301":1490,"_6528":83599},[41736],"As of Phoenix 4.4.0 we have added the ability to allow users to create and deploy\ntheir own custom or domain-specific UDFs to the cluster.",{"_15044":1499,"_41288":1490,"_15362":83601,"_5":14925,"_21301":83578,"_6528":83602},[41736],"Users can create temporary or permanent user-defined (domain-specific) scalar functions.\nUDFs can be used like built-in functions in queries such as SELECT, UPSERT, DELETE, and when creating functional indexes.\nTemporary functions are session-scoped and are not accessible from other sessions.\nPermanent function metadata is stored in the SYSTEM.FUNCTION table.\nPhoenix also supports tenant-specific functions. Functions created in one tenant-specific connection are not visible to other tenant-specific connections.\nOnly global tenant (no-tenant) functions are visible to all connections.",{"_15044":1500,"_41288":1490,"_15362":83604,"_5":14925,"_21301":83578,"_6528":83605},[41736],"Phoenix leverages the HBase dynamic class loader to load UDF JARs from HDFS at the Phoenix client and region server without restarting services.",{"_15044":1501,"_41288":1490,"_15362":83607,"_5":14925,"_21301":83581,"_6528":83608},[41736],"Add the following parameters to hbase-site.xml on the Phoenix client:",{"_15044":1502,"_41288":1490,"_15362":83610,"_5":14925,"_21301":83581,"_6528":83611},[41736],"The last two configuration values should match the HBase server-side configuration.",{"_15044":1503,"_41288":1490,"_15362":83613,"_5":14925,"_21301":83581,"_6528":83614},[41736],"As with other configuration properties, phoenix.functions.allowUserDefinedFunctions\nmay be specified at JDBC connection time as a connection property.",{"_15044":1504,"_41288":1490,"_15362":83616,"_5":14925,"_21301":83581,"_6528":80646},[41736],{"_15044":1505,"_41288":1490,"_15362":83618,"_5":14925,"_21301":83581,"_6528":83619},[41736],"The following optional parameter is used by the dynamic class loader to copy JARs from HDFS into the local filesystem:",{"_15044":1506,"_41288":1490,"_15362":83621,"_5":14925,"_21301":83584,"_6528":83622},[41736],"Implement your custom UDF by following How to write custom\nUDF.",{"_15044":1507,"_41288":1490,"_15362":83624,"_5":14925,"_21301":83584,"_6528":83625},[41736],"Compile your code into a JAR, then deploy the JAR to HDFS. It is recommended\nto add the JAR to the HDFS directory configured by hbase.dynamic.jars.dir.",{"_15044":1508,"_41288":1490,"_15362":83627,"_5":14925,"_21301":83588,"_6528":83628},[41736],"You can drop functions using the DROP FUNCTION query.\nDropping a function deletes the metadata for that function from Phoenix.",{"_15044":1509,"_41288":1490,"_15362":83630,"_5":14925,"_21301":83592,"_6528":83631},[41736],"You can follow these steps to write your UDF (for more detail, see this blog post):",{"_15044":1510,"_41288":1490,"_15362":83633,"_5":14925,"_21301":83592,"_6528":83634},[41736],"Create a new class derived from org.apache.phoenix.expression.function.ScalarFunction.",{"_15044":1511,"_41288":1490,"_15362":83636,"_5":14925,"_21301":83592,"_6528":83637},[41736],"Implement getDataType() to determine the function return type.",{"_15044":1512,"_41288":1490,"_15362":83639,"_5":14925,"_21301":83592,"_6528":83640},[41736],"Implement evaluate() to calculate the result for each row.\nThe method receives org.apache.phoenix.schema.tuple.Tuple with the current row state and an org.apache.hadoop.hbase.io.ImmutableBytesWritable to populate with the function result.\nThe method returns false if there is not enough information to calculate the result (usually because one argument is unknown), and true otherwise.",{"_15044":1513,"_41288":1490,"_15362":83642,"_5":14925,"_21301":83592,"_6528":83643},[41736],"Below are additional optimization-related steps.",{"_15044":1514,"_41288":1490,"_15362":83645,"_5":14925,"_21301":83592,"_6528":83646},[41736],"To contribute to scan start/stop key formation, custom functions need to override the following two methods from ScalarFunction:",{"_15044":1515,"_41288":1490,"_15362":83648,"_5":14925,"_21301":83592,"_6528":83649},[41736],"Additionally, to enable ORDER BY optimization or in-place GROUP BY, override:",{"_15044":1516,"_41288":1490,"_15362":83651,"_5":14925,"_21301":83596,"_6528":83652},[41736],"The JAR containing UDFs must be manually added to and deleted from HDFS. There is ongoing work to add SQL statements for JAR add/remove (PHOENIX-1890).",{"_15044":1517,"_41288":1490,"_15362":83654,"_5":14925,"_21301":83596,"_6528":83655},[41736],"The dynamic class loader copies UDF JARs to {hbase.local.dir}/jars at the Phoenix client and region server when a UDF is used in queries. These JARs must be deleted manually when a function is deleted.",{"_15044":1518,"_41288":1490,"_15362":83657,"_5":14925,"_21301":83596,"_6528":83658},[41736],"Functional indexes must be rebuilt manually if the function implementation changes (PHOENIX-1907).",{"_15044":1519,"_41288":1490,"_15362":83660,"_5":14925,"_21301":83596,"_6528":83661},[41736],"Once loaded, a JAR is not unloaded. Use a different JAR for modified implementations to avoid restarting the cluster (PHOENIX-1907).",{"_15044":1520,"_41288":1490,"_15362":83663,"_5":14925,"_21301":83596,"_6528":83664},[41736],"To list functions, query the SYSTEM.\"FUNCTION\" table (PHOENIX-1921).",{"_15044":1521,"_41288":1521,"_5":10980,"_6528":83666,"_41707":83667,"_15362":83668,"_21301":1521},"Views",[79080,79081,79082,80746],[41736],{"_15044":1522,"_41288":1521,"_15362":83670,"_5":14925,"_21301":1521,"_6528":83671},[41736],"Define updatable and read-only Phoenix views over shared HBase tables, including indexing behavior and limitations.",{"_15044":1523,"_41288":1521,"_5":41704,"_15362":83673,"_21301":83674,"_6528":83675},[41736],"/docs/features/views#updatable-views","Updatable Views",{"_15044":1524,"_41288":1521,"_5":41704,"_15362":83677,"_21301":83678,"_6528":83679},[41736],"/docs/features/views#read-only-views","Read-only Views",{"_15044":1525,"_41288":1521,"_5":41704,"_15362":83681,"_21301":83682,"_6528":83683},[41736],"/docs/features/views#indexes-on-views","Indexes on Views",{"_15044":1526,"_41288":1521,"_5":41704,"_15362":83685,"_21301":83686,"_6528":79202},[41736],"/docs/features/views#views-limitations",{"_15044":1527,"_41288":1521,"_15362":83688,"_5":14925,"_21301":1521,"_6528":83689},[41736],"The standard SQL view syntax (with some limitations) is now supported by Phoenix to enable multiple virtual tables to all share the same underlying physical HBase table. This is important in HBase as there are limits to the number of regions which HBase can manage. Limiting the number of tables can help limit the number of regions in a cluster.",{"_15044":1528,"_41288":1521,"_15362":83691,"_5":14925,"_21301":1521,"_6528":83692},[41736],"For example, given the following table definition that defines a base table to collect product metrics:",{"_15044":1529,"_41288":1521,"_15362":83694,"_5":14925,"_21301":1521,"_6528":83695},[41736],"You may define the following view:",{"_15044":1530,"_41288":1521,"_15362":83697,"_5":14925,"_21301":1521,"_6528":83698},[41736],"In this case, the same underlying physical HBase table (i.e. PRODUCT_METRICS) stores all of the data.\nNotice that unlike with standard SQL views, you may define additional columns for your view. The view inherits all of the columns from its base table, in addition to being able to optionally add new KeyValue columns. You may also add these columns after-the-fact with an ALTER VIEW statement.",{"_15044":1531,"_41288":1521,"_15362":83700,"_5":14925,"_21301":1521,"_6528":83701},[41736],"NOTE: Phoenix 4.15.0 onwards contains PHOENIX-4810 which introduces a new endpoint coprocessor on the SYSTEM.CHILD_LINK table for adding parent->child links, whenever a view is created. Thus, when namespace mapping is enabled, users that wish to create views will need to be granted EXEC permissions on SYSTEM.CHILD_LINK in order to be able to invoke this coprocessor.",{"_15044":1532,"_41288":1521,"_15362":83703,"_5":14925,"_21301":83674,"_6528":83704},[41736],"If your view uses only simple equality expressions in the WHERE clause, you are also allowed to issue DML against the view. These views are termed updatable views. For example, in this case you could issue the following UPSERT statement:",{"_15044":1533,"_41288":1521,"_15362":83706,"_5":14925,"_21301":83674,"_6528":83707},[41736],"In this case, the row will be stored in the PRODUCT_METRICS HBase table and the metric_type column value will be inferred to be 'm' since the VIEW defines it as such.",{"_15044":1534,"_41288":1521,"_15362":83709,"_5":14925,"_21301":83674,"_6528":83710},[41736],"Also, queries done through the view will automatically apply the WHERE clause filter. For example:",{"_15044":1535,"_41288":1521,"_15362":83712,"_5":14925,"_21301":83674,"_6528":83713},[41736],"This would sum all the dropped_calls across all product_metrics with a metric_type of 'm' and a carrier of 'Verizon'.",{"_15044":1536,"_41288":1521,"_15362":83715,"_5":14925,"_21301":83678,"_6528":83716},[41736],"Views may also be defined with more complex WHERE clauses, but in that case you cannot issue DML against them as you'll get a ReadOnlyException. You are still allowed to query through them and their WHERE clauses will be in effect as with standard SQL views.",{"_15044":1537,"_41288":1521,"_15362":83718,"_5":14925,"_21301":83678,"_6528":83719},[41736],"As expected, you may create a VIEW on another VIEW as well to further filter the data set. The same rules as above apply: if only simple equality expressions are used in the VIEW and its parent VIEW(s), the new view is updatable as well, otherwise it's read-only.",{"_15044":1538,"_41288":1521,"_15362":83721,"_5":14925,"_21301":83678,"_6528":83722},[41736],"Note that the previous support for creating a read-only VIEW directly over an HBase table is still supported.",{"_15044":1539,"_41288":1521,"_15362":83724,"_5":14925,"_21301":83682,"_6528":83725},[41736],"In addition, you may create an INDEX over a VIEW, just as with a TABLE. This is particularly useful to improve query performance over newly added columns on a VIEW, since it provides a way of doing point lookups based on these column values. Note that until PHOENIX-1499 gets implemented, an INDEX over a VIEW is only maintained if the updates are made through the VIEW (as opposed to through the underlying TABLE).",{"_15044":1540,"_41288":1521,"_15362":83727,"_5":14925,"_21301":83686,"_6528":83728},[41736],"Views have the following restrictions:",{"_15044":1541,"_41288":1521,"_15362":83730,"_5":14925,"_21301":83686,"_6528":83731},[41736],"An INDEX over a VIEW is only maintained if the updates are made through the VIEW. Updates made through the underlying TABLE or the parent VIEW will not be reflected in the index (PHOENIX-1499).",{"_15044":1542,"_41288":1521,"_15362":83733,"_5":14925,"_21301":83686,"_6528":83734},[41736],"A primary key column may not be added to a VIEW when its base table has a primary key constraint that ends with a variable-length column (PHOENIX-2157).",{"_15044":1543,"_41288":1521,"_15362":83736,"_5":14925,"_21301":83686,"_6528":83737},[41736],"A VIEW may be defined over only a single table through a simple SELECT * query. You may not create a VIEW over multiple joined tables or over aggregations (PHOENIX-1505, PHOENIX-1506).",{"_15044":1544,"_41288":1521,"_15362":83739,"_5":14925,"_21301":83686,"_6528":83740},[41736],"When a column is added to a VIEW, the new column is not automatically added to child VIEWs (PHOENIX-2054). The workaround is to manually add the column to child VIEWs.",{"_15044":1545,"_41288":1521,"_15362":83742,"_5":14925,"_21301":83686,"_6528":83743},[41736],"All columns must be projected into a VIEW when it is created (that is, only CREATE VIEW ... AS SELECT * is supported). You may drop non-primary-key columns inherited from the base table after creation using ALTER VIEW. Providing a subset of columns or expressions in the SELECT clause is planned for a future release (PHOENIX-1507).",{"_15044":1546,"_41288":1546,"_5":10980,"_6528":83745,"_41707":83746,"_15362":83747,"_21301":1546},"SQL Functions",[79080,79081,79194],[41736],{"_15044":1547,"_41288":1546,"_15362":83749,"_5":14925,"_21301":1546,"_6528":83750},[41736],"Built-in SQL function reference for Apache Phoenix — aggregate, string, numeric, array, date/time, and general functions.",{"_15044":1548,"_41288":1546,"_5":41704,"_15362":83752,"_21301":83753,"_6528":83754},[41736],"/docs/functions#functions-aggregate","Functions (Aggregate)",{"_15044":1549,"_41288":1546,"_5":41704,"_15362":83756,"_21301":83757,"_6528":83758},[41736],"/docs/functions#avg","AVG",{"_15044":1550,"_41288":1546,"_5":41704,"_15362":83760,"_21301":83761,"_6528":83762},[41736],"/docs/functions#count","COUNT",{"_15044":1551,"_41288":1546,"_5":41704,"_15362":83764,"_21301":83765,"_6528":83766},[41736],"/docs/functions#approx_count_distinct","APPROX_COUNT_DISTINCT",{"_15044":1552,"_41288":1546,"_5":41704,"_15362":83768,"_21301":83769,"_6528":83770},[41736],"/docs/functions#max","MAX",{"_15044":1553,"_41288":1546,"_5":41704,"_15362":83772,"_21301":83773,"_6528":83774},[41736],"/docs/functions#min","MIN",{"_15044":1554,"_41288":1546,"_5":41704,"_15362":83776,"_21301":83777,"_6528":83778},[41736],"/docs/functions#sum","SUM",{"_15044":1555,"_41288":1546,"_5":41704,"_15362":83780,"_21301":83781,"_6528":83782},[41736],"/docs/functions#percentile_cont","PERCENTILE_CONT",{"_15044":1556,"_41288":1546,"_5":41704,"_15362":83784,"_21301":83785,"_6528":83786},[41736],"/docs/functions#percentile_disc","PERCENTILE_DISC",{"_15044":1557,"_41288":1546,"_5":41704,"_15362":83788,"_21301":83789,"_6528":83790},[41736],"/docs/functions#percent_rank","PERCENT_RANK",{"_15044":1558,"_41288":1546,"_5":41704,"_15362":83792,"_21301":83793,"_6528":83794},[41736],"/docs/functions#first_value","FIRST_VALUE",{"_15044":1559,"_41288":1546,"_5":41704,"_15362":83796,"_21301":83797,"_6528":83798},[41736],"/docs/functions#last_value","LAST_VALUE",{"_15044":1560,"_41288":1546,"_5":41704,"_15362":83800,"_21301":83801,"_6528":83802},[41736],"/docs/functions#first_values","FIRST_VALUES",{"_15044":1561,"_41288":1546,"_5":41704,"_15362":83804,"_21301":83805,"_6528":83806},[41736],"/docs/functions#last_values","LAST_VALUES",{"_15044":1562,"_41288":1546,"_5":41704,"_15362":83808,"_21301":83809,"_6528":83810},[41736],"/docs/functions#nth_value","NTH_VALUE",{"_15044":1563,"_41288":1546,"_5":41704,"_15362":83812,"_21301":83813,"_6528":83814},[41736],"/docs/functions#stddev_pop","STDDEV_POP",{"_15044":1564,"_41288":1546,"_5":41704,"_15362":83816,"_21301":83817,"_6528":83818},[41736],"/docs/functions#stddev_samp","STDDEV_SAMP",{"_15044":1565,"_41288":1546,"_5":41704,"_15362":83820,"_21301":83821,"_6528":83822},[41736],"/docs/functions#functions-numeric","Functions (Numeric)",{"_15044":1566,"_41288":1546,"_5":41704,"_15362":83824,"_21301":83825,"_6528":83826},[41736],"/docs/functions#round","ROUND",{"_15044":1567,"_41288":1546,"_5":41704,"_15362":83828,"_21301":83829,"_6528":83830},[41736],"/docs/functions#ceil","CEIL",{"_15044":1568,"_41288":1546,"_5":41704,"_15362":83832,"_21301":83833,"_6528":83834},[41736],"/docs/functions#floor","FLOOR",{"_15044":1569,"_41288":1546,"_5":41704,"_15362":83836,"_21301":83837,"_6528":83838},[41736],"/docs/functions#trunc","TRUNC",{"_15044":1570,"_41288":1546,"_5":41704,"_15362":83840,"_21301":83841,"_6528":83842},[41736],"/docs/functions#to_number","TO_NUMBER",{"_15044":1571,"_41288":1546,"_5":41704,"_15362":83844,"_21301":83845,"_6528":83846},[41736],"/docs/functions#rand","RAND",{"_15044":1572,"_41288":1546,"_5":41704,"_15362":83848,"_21301":83849,"_6528":83850},[41736],"/docs/functions#functions-string","Functions (String)",{"_15044":1573,"_41288":1546,"_5":41704,"_15362":83852,"_21301":83853,"_6528":83854},[41736],"/docs/functions#substr","SUBSTR",{"_15044":1574,"_41288":1546,"_5":41704,"_15362":83856,"_21301":83857,"_6528":83858},[41736],"/docs/functions#instr","INSTR",{"_15044":1575,"_41288":1546,"_5":41704,"_15362":83860,"_21301":83861,"_6528":83862},[41736],"/docs/functions#trim","TRIM",{"_15044":1576,"_41288":1546,"_5":41704,"_15362":83864,"_21301":83865,"_6528":83866},[41736],"/docs/functions#ltrim","LTRIM",{"_15044":1577,"_41288":1546,"_5":41704,"_15362":83868,"_21301":83869,"_6528":83870},[41736],"/docs/functions#rtrim","RTRIM",{"_15044":1578,"_41288":1546,"_5":41704,"_15362":83872,"_21301":83873,"_6528":83874},[41736],"/docs/functions#lpad","LPAD",{"_15044":1579,"_41288":1546,"_5":41704,"_15362":83876,"_21301":83877,"_6528":83878},[41736],"/docs/functions#length","LENGTH",{"_15044":1580,"_41288":1546,"_5":41704,"_15362":83880,"_21301":83881,"_6528":83882},[41736],"/docs/functions#regexp_substr","REGEXP_SUBSTR",{"_15044":1581,"_41288":1546,"_5":41704,"_15362":83884,"_21301":83885,"_6528":83886},[41736],"/docs/functions#regexp_replace","REGEXP_REPLACE",{"_15044":1582,"_41288":1546,"_5":41704,"_15362":83888,"_21301":83889,"_6528":83890},[41736],"/docs/functions#regexp_split","REGEXP_SPLIT",{"_15044":1583,"_41288":1546,"_5":41704,"_15362":83892,"_21301":83893,"_6528":83894},[41736],"/docs/functions#upper","UPPER",{"_15044":1584,"_41288":1546,"_5":41704,"_15362":83896,"_21301":83897,"_6528":83898},[41736],"/docs/functions#lower","LOWER",{"_15044":1585,"_41288":1546,"_5":41704,"_15362":83900,"_21301":83901,"_6528":83902},[41736],"/docs/functions#reverse","REVERSE",{"_15044":1586,"_41288":1546,"_5":41704,"_15362":83904,"_21301":83905,"_6528":83906},[41736],"/docs/functions#to_char","TO_CHAR",{"_15044":1587,"_41288":1546,"_5":41704,"_15362":83908,"_21301":83909,"_6528":83910},[41736],"/docs/functions#collation_key","COLLATION_KEY",{"_15044":1588,"_41288":1546,"_5":41704,"_15362":83912,"_21301":83913,"_6528":83914},[41736],"/docs/functions#functions-array","Functions (Array)",{"_15044":1589,"_41288":1546,"_5":41704,"_15362":83916,"_21301":83917,"_652