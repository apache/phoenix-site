,"_64342":104630,"_64344":104632,"_64346":104634,"_64348":104636,"_64350":104638,"_64352":104640,"_64354":104642,"_64356":104644,"_64358":104646,"_64360":104648,"_64362":104650,"_64364":104652,"_64366":104654,"_64368":104656,"_64370":104658,"_64372":104660,"_64374":104662,"_64376":104664,"_64378":104666,"_64380":104668,"_64382":104670,"_64384":104672,"_64386":104674,"_64388":104676,"_64390":104678,"_64392":104680,"_64394":104682,"_64396":104684,"_64398":104686,"_64400":104688,"_64402":104690,"_64404":104692,"_64406":104694,"_64408":104696,"_64410":104698,"_64412":104700,"_64414":104702,"_64416":104704,"_64418":104706,"_64420":104708,"_64422":104710,"_64424":104712,"_64426":104714,"_64428":104716,"_64430":104718,"_64432":104720,"_64434":104722,"_64436":104724,"_64438":104726,"_64440":104728,"_64442":104730,"_64444":104732,"_64446":104734,"_64448":104736,"_64450":104738,"_64452":104740,"_64454":104742,"_64456":104744,"_64458":104746,"_64460":104748,"_64462":104750,"_64464":104752,"_64466":104754,"_64468":104756,"_64470":104758,"_64472":104760,"_64474":104762,"_64476":104764,"_64478":104766,"_64480":104768,"_64482":104770,"_64484":104772,"_64486":104774,"_64488":104776,"_64490":104778,"_64492":104780,"_64494":104782,"_64496":104784,"_64498":104786,"_64500":104788,"_64502":104790,"_64504":104792,"_64506":104794,"_64508":104796,"_64510":104798,"_64512":104800,"_64514":104802,"_64516":104804,"_64518":104806,"_64520":104808,"_64522":104810,"_64524":104812,"_64526":104814,"_64528":104816,"_64530":104818,"_64532":104820,"_64534":104822,"_64536":104824,"_64538":104826,"_64540":104828,"_64542":104830,"_64544":104832,"_64546":104834,"_64548":104836,"_64550":104838,"_64552":104840,"_64554":104842,"_64556":104844,"_64558":104846,"_64560":104848,"_64562":104850,"_64564":104852,"_64566":104854,"_64568":104856,"_64570":104858,"_64572":104860,"_64574":104862,"_64576":104864,"_64578":104866,"_64580":104868,"_64582":104870,"_64584":104872,"_64586":104874,"_64588":104876,"_64590":104878,"_64592":104880,"_64594":104882,"_64596":104884,"_64598":104886,"_64600":104888,"_64602":104890,"_64604":104892,"_64606":104894,"_64608":104896,"_64610":104898,"_64612":104900,"_64614":104902,"_64616":104904,"_64618":104906,"_64620":104908,"_64622":104910,"_64624":104912,"_64626":104914,"_64628":104916,"_64630":104918,"_64632":104920,"_64634":104922,"_64636":104924,"_64638":104926,"_64640":104928,"_64642":104930,"_64644":104932,"_64646":104934,"_64648":104936,"_64650":104938,"_64652":104940,"_64654":104942,"_64656":104944,"_64658":104946,"_64660":104948,"_64662":104950,"_64664":104952,"_64666":104954,"_64668":104956,"_64670":104958,"_64672":104960,"_64674":104962,"_64676":104964,"_64678":104966,"_64680":104968,"_64682":104970,"_64684":104972,"_64686":104974,"_64688":104976,"_64690":104978,"_64692":104980,"_64694":104982,"_64696":104984,"_64698":104986,"_64700":104988,"_64702":104990,"_64704":104992,"_64706":104994,"_64708":104996,"_64710":104998,"_64712":105000,"_64714":105002,"_64716":105004,"_64718":105006,"_64720":105008,"_64722":105010,"_64724":105012,"_64726":105014,"_64728":105016,"_64730":105018,"_64732":105020,"_64734":105022,"_64736":105024,"_64738":105026,"_64740":105028,"_64742":105030,"_64744":105032,"_64746":105034,"_64748":105036,"_64750":105038,"_64752":105040,"_64754":105042,"_64756":105044,"_64758":105046,"_64760":105048,"_64762":105050,"_64764":105052,"_64766":105054,"_64768":105056,"_64770":105058,"_64772":105060,"_64774":105062,"_64776":105064,"_64778":105066,"_64780":105068,"_64782":105070,"_64784":105072,"_64786":105074,"_64788":105076,"_64790":105078,"_64792":105080,"_64794":105082,"_64796":105084,"_64798":105086,"_64800":105088,"_64802":105090,"_64804":105092,"_64806":105094,"_64808":105096,"_64810":105098,"_64812":105100},{"_11692":11,"_44950":11,"_5":12121,"_7169":86366,"_45415":86367,"_16990":86372,"_23412":11},"Phoenix Omid Transaction Manager",[86368,86369,86370,86371],"Docs","Multi-Page Documentation","Development","Addons",[45444],{"_11692":12,"_44950":11,"_16990":86374,"_5":16526,"_23412":11,"_7169":86375},[45444],"Status update for Apache Omid graduation as an Apache Phoenix sub-project.",{"_11692":13,"_44950":11,"_16990":86377,"_5":16526,"_23412":11,"_7169":86378},[45444],"The Apache Omid podling has recently decided to graduate as a sub-project of Apache Phoenix.",{"_11692":14,"_44950":11,"_16990":86380,"_5":16526,"_23412":11,"_7169":86381},[45444],"This graduation process is currently ongoing. Please follow the Apache Phoenix mailing lists\nfor more information about this effort.",{"_11692":15,"_44950":15,"_5":12121,"_7169":86383,"_45415":86384,"_16990":86385,"_23412":15},"Phoenix ORM library",[86368,86369,86370,86371],[45444],{"_11692":16,"_44950":15,"_16990":86387,"_5":16526,"_23412":15,"_7169":86388},[45444],"Guide to PHO (Phoenix-HBase ORM) for entity mapping, query building, execution, and configuration.",{"_11692":17,"_44950":15,"_5":45412,"_16990":86390,"_23412":86391,"_7169":86392},[45444],"/docs/addons/phoenix-orm-library#entity-class","Entity Class",{"_11692":18,"_44950":15,"_5":45412,"_16990":86394,"_23412":86395,"_7169":86396},[45444],"/docs/addons/phoenix-orm-library#query-building","Query Building",{"_11692":19,"_44950":15,"_5":45412,"_16990":86398,"_23412":86399,"_7169":86400},[45444],"/docs/addons/phoenix-orm-library#simple-queries","Simple queries",{"_11692":20,"_44950":15,"_5":45412,"_16990":86402,"_23412":86403,"_7169":86404},[45444],"/docs/addons/phoenix-orm-library#compound-queries","Compound queries",{"_11692":21,"_44950":15,"_5":45412,"_16990":86406,"_23412":86407,"_7169":86408},[45444],"/docs/addons/phoenix-orm-library#query-interface","Query Interface",{"_11692":22,"_44950":15,"_5":45412,"_16990":86410,"_23412":86411,"_7169":86412},[45444],"/docs/addons/phoenix-orm-library#resolving-entity-and-property-names","Resolving Entity and Property Names",{"_11692":23,"_44950":15,"_5":45412,"_16990":86414,"_23412":86415,"_7169":86416},[45444],"/docs/addons/phoenix-orm-library#query-execution","Query Execution",{"_11692":24,"_44950":15,"_5":45412,"_16990":86418,"_23412":86419,"_7169":86420},[45444],"/docs/addons/phoenix-orm-library#phoenix-orm-library-configuration","Configuration",{"_11692":25,"_44950":15,"_5":45412,"_16990":86422,"_23412":86423,"_7169":86424},[45444],"/docs/addons/phoenix-orm-library#hbase","HBase",{"_11692":26,"_44950":15,"_16990":86426,"_5":16526,"_23412":15,"_7169":86427},[45444],"PHO is an Object Relational Mapping (ORM) library for building and executing queries on HBase using Apache Phoenix.\nIt provides ORM-style mappings and DSL-style query building. Initially developed and open sourced by eHarmony, it is available on GitHub.",{"_11692":27,"_44950":15,"_16990":86429,"_5":16526,"_23412":15,"_7169":86430},[45444],"Its interfaces and generic annotations make it possible to switch data store APIs in the future without changing query definitions.\nCurrently, it supports HBase integration through Apache Phoenix, and can be extended with other implementations.",{"_11692":28,"_44950":15,"_16990":86432,"_5":16526,"_23412":86391,"_7169":86433},[45444],"Suppose we have the following TestClass we want to query in our data store:",{"_11692":29,"_44950":15,"_16990":86435,"_5":16526,"_23412":86395,"_7169":86436},[45444],"Query building can be done in DSL style. More advanced query building is under development, but for now we will use a combination of QueryBuilder and static, Hibernate-style Restrictions methods to construct queries.",{"_11692":30,"_44950":15,"_16990":86438,"_5":16526,"_23412":86399,"_7169":86439},[45444],"Construct a query to find all user matches delivered in the past two days and not in a closed state.",{"_11692":31,"_44950":15,"_16990":86441,"_5":16526,"_23412":86403,"_7169":86442},[45444],"Construct a more complex query where we find items older than one day, include multiple status values, order by deliveryDate, and limit result size to 10.",{"_11692":32,"_44950":15,"_16990":86444,"_5":16526,"_23412":86403,"_7169":86445},[45444],"By default, expressions are combined with AND when added separately.",{"_11692":33,"_44950":15,"_16990":86447,"_5":16526,"_23412":86407,"_7169":86448},[45444],"The following query components are supported:",{"_11692":34,"_44950":15,"_16990":86450,"_5":16526,"_23412":86411,"_7169":86451},[45444],"Always use the property names of your Java objects in your queries.\nIf these names differ from those used in your datastore, use annotations to provide mappings.\nEntity resolvers are configured to map entity classes to table or collection names.\nProperty resolvers are configured to map object variable names to column or field names.",{"_11692":35,"_44950":15,"_16990":86453,"_5":16526,"_23412":86411,"_7169":86454},[45444],"The following annotations are currently supported for the indicated data store type.\nCustom EntityResolvers and PropertyResolvers are straightforward to configure and create.",{"_11692":36,"_44950":15,"_16990":86456,"_5":16526,"_23412":86411,"_7169":86457},[45444],"See Morphia annotations for entity class annotation mappings.",{"_11692":37,"_44950":15,"_16990":86459,"_5":16526,"_23412":86415,"_7169":86460},[45444],"The QueryExecutor interface supports the following operations:",{"_11692":38,"_44950":15,"_16990":86462,"_5":16526,"_23412":86419,"_7169":86463},[45444],"Here are some example Spring configuration files for HBase using Apache Phoenix.",{"_11692":39,"_44950":15,"_16990":86465,"_5":16526,"_23412":86423,"_7169":86466},[45444],"Configuration properties:",{"_11692":40,"_44950":40,"_5":12121,"_7169":86468,"_45415":86469,"_16990":86470,"_23412":40},"Phoenix Tephra Transaction Manager",[86368,86369,86370,86371],[45444],{"_11692":41,"_44950":40,"_16990":86472,"_5":16526,"_23412":40,"_7169":86473},[45444],"Status update for Apache Tephra graduation as an Apache Phoenix sub-project.",{"_11692":42,"_44950":40,"_16990":86475,"_5":16526,"_23412":40,"_7169":86476},[45444],"The Apache Tephra podling has recently decided to graduate as a sub-project of Apache Phoenix.",{"_11692":43,"_44950":40,"_16990":86478,"_5":16526,"_23412":40,"_7169":86381},[45444],{"_11692":44,"_44950":44,"_5":12121,"_7169":86480,"_45415":86481,"_16990":86483,"_23412":44},"Array Type",[86368,86369,86482],"Reference",[45444],{"_11692":45,"_44950":44,"_16990":86485,"_5":16526,"_23412":44,"_7169":86486},[45444],"Use JDBC ARRAY columns in Phoenix, including DDL, inserts, indexing syntax, and built-in array functions.",{"_11692":46,"_44950":44,"_5":45412,"_16990":86488,"_23412":86489,"_7169":86490},[45444],"/docs/array-type#array-type-limitations","Limitations",{"_11692":47,"_44950":44,"_16990":86492,"_5":16526,"_23412":44,"_7169":86493},[45444],"Apache Phoenix 3.0/4.0 introduced support for the JDBC ARRAY type. Any primitive type may be used in an ARRAY. Here is an example of declaring an array type when creating a table:",{"_11692":48,"_44950":44,"_16990":86495,"_5":16526,"_23412":44,"_7169":86496},[45444],"or alternately:",{"_11692":49,"_44950":44,"_16990":86498,"_5":16526,"_23412":44,"_7169":86499},[45444],"Insertion into the array may be done entirely through a SQL statement:",{"_11692":50,"_44950":44,"_16990":86501,"_5":16526,"_23412":44,"_7169":86502},[45444],"or programmatically through JDBC:",{"_11692":51,"_44950":44,"_16990":86504,"_5":16526,"_23412":44,"_7169":86505},[45444],"The entire array may be selected:",{"_11692":52,"_44950":44,"_16990":86507,"_5":16526,"_23412":44,"_7169":86508},[45444],"or an individual element in the array may be accessed via a subscript notation. The subscript is one-based, so the following would select the first element:",{"_11692":53,"_44950":44,"_16990":86510,"_5":16526,"_23412":44,"_7169":86511},[45444],"Use of the array subscript notation is supported in other expressions as well, for example in a WHERE clause:",{"_11692":54,"_44950":44,"_16990":86513,"_5":16526,"_23412":44,"_7169":86514},[45444],"The array length grows dynamically as needed and can be accessed through the built-in ARRAY_LENGTH function:",{"_11692":55,"_44950":44,"_16990":86516,"_5":16526,"_23412":44,"_7169":86517},[45444],"Attempts to access an array element beyond the current length will evaluate to null.",{"_11692":56,"_44950":44,"_16990":86519,"_5":16526,"_23412":44,"_7169":86520},[45444],"For searching in an array, built-in functions like ANY and ALL are provided. For example,",{"_11692":57,"_44950":44,"_16990":86522,"_5":16526,"_23412":44,"_7169":86523},[45444],"The built-in function ANY checks if any array element satisfies the condition and is equivalent to an OR condition:",{"_11692":58,"_44950":44,"_16990":86525,"_5":16526,"_23412":44,"_7169":86526},[45444],"The built-in function ALL checks if all array elements satisfy the condition and is equivalent to an AND condition:",{"_11692":59,"_44950":44,"_16990":86528,"_5":16526,"_23412":86489,"_7169":86529},[45444],"Only one-dimensional arrays are currently supported.",{"_11692":60,"_44950":44,"_16990":86531,"_5":16526,"_23412":86489,"_7169":86532},[45444],"For an array of fixed width types, null elements occurring in the middle of an array are not tracked.",{"_11692":61,"_44950":44,"_16990":86534,"_5":16526,"_23412":86489,"_7169":86535},[45444],"The declaration of an array length at DDL time is not enforced currently, but maybe in the future. Note that it is persisted with the table metadata.",{"_11692":62,"_44950":44,"_16990":86537,"_5":16526,"_23412":86489,"_7169":86538},[45444],"An array may only be used as the last column in a primary key constraint.",{"_11692":63,"_44950":44,"_16990":86540,"_5":16526,"_23412":86489,"_7169":86541},[45444],"Partial update of an array is currently not possible. Instead, the array may be manipulated on the client-side and then upserted back in its entirety.",{"_11692":64,"_44950":64,"_5":12121,"_7169":86543,"_45415":86544,"_16990":86546,"_23412":64},"Building Website",[86368,86369,86370,86545],"Contributing",[45444],{"_11692":65,"_44950":64,"_16990":86548,"_5":16526,"_23412":64,"_7169":86549},[45444],"Build and test the Apache Phoenix website locally with the current React + TypeScript workflow.",{"_11692":66,"_44950":64,"_5":45412,"_16990":86551,"_23412":86552,"_7169":86553},[45444],"/docs/contributing/building-website#building-website-prerequisites","Prerequisites",{"_11692":67,"_44950":64,"_5":45412,"_16990":86555,"_23412":86556,"_7169":86557},[45444],"/docs/contributing/building-website#building-phoenix-project-website","Building Phoenix Project Website",{"_11692":68,"_44950":64,"_5":45412,"_16990":86559,"_23412":86560,"_7169":86561},[45444],"/docs/contributing/building-website#publishing-website-artifact","Publishing Website Artifact",{"_11692":69,"_44950":64,"_5":45412,"_16990":86563,"_23412":86564,"_7169":86565},[45444],"/docs/contributing/building-website#local-testing-during-development","Local Testing During Development",{"_11692":70,"_44950":64,"_16990":86567,"_5":16526,"_23412":86552,"_7169":86568},[45444],"Node.js 22.x (minimum 22.12.0)",{"_11692":71,"_44950":64,"_16990":86570,"_5":16526,"_23412":86552,"_7169":86571},[45444],"npm (bundled with Node.js)",{"_11692":72,"_44950":64,"_16990":86573,"_5":16526,"_23412":86556,"_7169":86574},[45444],"Clone the repository:",{"_11692":73,"_44950":64,"_16990":86576,"_5":16526,"_23412":86556,"_7169":86577},[45444],"During development, install dependencies:",{"_11692":74,"_44950":64,"_16990":86579,"_5":16526,"_23412":86556,"_7169":86580},[45444],"For local iteration, run checks/build directly when needed:",{"_11692":75,"_44950":64,"_16990":86582,"_5":16526,"_23412":86556,"_7169":86583},[45444],"Before opening a pull request, run the mandatory build script:",{"_11692":76,"_44950":64,"_16990":86585,"_5":16526,"_23412":86556,"_7169":86586},[45444],"build.sh is required for all contributors. It:",{"_11692":77,"_44950":64,"_16990":86588,"_5":16526,"_23412":86556,"_7169":86589},[45444],"ensures Node/npm are available",{"_11692":78,"_44950":64,"_16990":86591,"_5":16526,"_23412":86556,"_7169":86592},[45444],"runs a clean install (npm ci)",{"_11692":79,"_44950":64,"_16990":86594,"_5":16526,"_23412":86556,"_7169":86595},[45444],"runs full validation/build (npm run ci)",{"_11692":80,"_44950":64,"_16990":86597,"_5":16526,"_23412":86556,"_7169":86598},[45444],"copies build/client/ into output/",{"_11692":81,"_44950":64,"_16990":86600,"_5":16526,"_23412":86556,"_7169":86601},[45444],"There is no remote CI/CD runner currently executing this script. The generated output/ directory is a build artifact that must be committed and pushed with your PR.",{"_11692":82,"_44950":64,"_16990":86603,"_5":16526,"_23412":86560,"_7169":86604},[45444],"Current publishing flow:",{"_11692":83,"_44950":64,"_16990":86606,"_5":16526,"_23412":86560,"_7169":86607},[45444],"Run ./build.sh locally",{"_11692":84,"_44950":64,"_16990":86609,"_5":16526,"_23412":86560,"_7169":86610},[45444],"Commit both source changes and updated output/",{"_11692":85,"_44950":64,"_16990":86612,"_5":16526,"_23412":86560,"_7169":86613},[45444],"Push your branch and open a PR",{"_11692":86,"_44950":64,"_16990":86615,"_5":16526,"_23412":86560,"_7169":86616},[45444],"After merge, output/ is used as the website artifact for deployment.",{"_11692":87,"_44950":64,"_16990":86618,"_5":16526,"_23412":86564,"_7169":86619},[45444],"Start the development server with hot reload:",{"_11692":88,"_44950":64,"_16990":86621,"_5":16526,"_23412":86564,"_7169":86622},[45444],"By default, the website is available at:",{"_11692":89,"_44950":64,"_16990":86624,"_5":16526,"_23412":86564,"_7169":86625},[45444],"To test the production build locally:",{"_11692":90,"_44950":90,"_5":12121,"_7169":86627,"_45415":86628,"_16990":86629,"_23412":90},"Developing Phoenix",[86368,86369,86370,86545],[45444],{"_11692":91,"_44950":90,"_16990":86631,"_5":16526,"_23412":90,"_7169":86632},[45444],"Set up a local Apache Phoenix development environment, IDE preferences, and contribution workflow.",{"_11692":92,"_44950":90,"_5":45412,"_16990":86634,"_23412":86635,"_7169":86636},[45444],"/docs/contributing/develop#develop-getting-started","Getting Started",{"_11692":93,"_44950":90,"_5":45412,"_16990":86638,"_23412":86639,"_7169":86640},[45444],"/docs/contributing/develop#other-phoenix-subprojects","Other Phoenix Subprojects",{"_11692":94,"_44950":90,"_5":45412,"_16990":86642,"_23412":86643,"_7169":86644},[45444],"/docs/contributing/develop#setup-local-git-repository","Setup Local Git Repository",{"_11692":95,"_44950":90,"_5":45412,"_16990":86646,"_23412":86647,"_7169":86648},[45444],"/docs/contributing/develop#for-eclipse-ide-for-java-developers-luna","For Eclipse IDE for Java Developers (Luna)",{"_11692":96,"_44950":90,"_5":45412,"_16990":86650,"_23412":86651,"_7169":86652},[45444],"/docs/contributing/develop#get-settings-and-preferences-correct","Get Settings and Preferences Correct",{"_11692":97,"_44950":90,"_5":45412,"_16990":86654,"_23412":86655,"_7169":86656},[45444],"/docs/contributing/develop#connecting-to-jira","Connecting to Jira",{"_11692":98,"_44950":90,"_5":45412,"_16990":86658,"_23412":86659,"_7169":86660},[45444],"/docs/contributing/develop#commit","Commit",{"_11692":99,"_44950":90,"_5":45412,"_16990":86662,"_23412":86663,"_7169":86664},[45444],"/docs/contributing/develop#for-intellij","For Intellij",{"_11692":100,"_44950":90,"_5":45412,"_16990":86666,"_23412":86667,"_7169":86668},[45444],"/docs/contributing/develop#if-you-dont-have-a-local-git-repository-setup","If you don't have a local git repository setup",{"_11692":101,"_44950":90,"_5":45412,"_16990":86670,"_23412":86671,"_7169":86672},[45444],"/docs/contributing/develop#if-you-already-have-a-local-git-repository-setup","If you already have a local git repository setup",{"_11692":102,"_44950":90,"_5":45412,"_16990":86674,"_23412":86675,"_7169":86652},[45444],"/docs/contributing/develop#get-settings-and-preferences-correct-1",{"_11692":103,"_44950":90,"_5":45412,"_16990":86677,"_23412":86678,"_7169":86656},[45444],"/docs/contributing/develop#connecting-to-jira-1",{"_11692":104,"_44950":90,"_5":45412,"_16990":86680,"_23412":86681,"_7169":86660},[45444],"/docs/contributing/develop#commit-1",{"_11692":105,"_44950":90,"_5":45412,"_16990":86683,"_23412":86684,"_7169":86685},[45444],"/docs/contributing/develop#contributing-finished-work","Contributing finished work",{"_11692":106,"_44950":90,"_5":45412,"_16990":86687,"_23412":86688,"_7169":86689},[45444],"/docs/contributing/develop#create-pull-request","Create pull request",{"_11692":107,"_44950":90,"_16990":86691,"_5":16526,"_23412":86635,"_7169":86692},[45444],"Review the How to Contribute documentation.",{"_11692":108,"_44950":90,"_16990":86694,"_5":16526,"_23412":86635,"_7169":86695},[45444],"Sign up for a GitHub account if you do not have one.",{"_11692":109,"_44950":90,"_16990":86697,"_5":16526,"_23412":86635,"_7169":86698},[45444],"Go to the Phoenix GitHub repository and create a fork, which creates {username}/phoenix.",{"_11692":110,"_44950":90,"_16990":86700,"_5":16526,"_23412":86635,"_7169":86701},[45444],"Set up Git locally.",{"_11692":111,"_44950":90,"_16990":86703,"_5":16526,"_23412":86635,"_7169":86704},[45444],"Instructions",{"_11692":112,"_44950":90,"_16990":86706,"_5":16526,"_23412":86635,"_7169":86707},[45444],"Download",{"_11692":113,"_44950":90,"_16990":86709,"_5":16526,"_23412":86635,"_7169":86710},[45444],"Make sure you have a JDK (Phoenix historically required JDK 7).",{"_11692":114,"_44950":90,"_16990":86712,"_5":16526,"_23412":86635,"_7169":86713},[45444],"Make sure you have Maven 3+ installed.",{"_11692":115,"_44950":90,"_16990":86715,"_5":16526,"_23412":86635,"_7169":86716},[45444],"Add the following to your .bashrc or equivalent to ensure Maven and Java are configured correctly for command-line usage.",{"_11692":116,"_44950":90,"_16990":86718,"_5":16526,"_23412":86639,"_7169":86719},[45444],"The instructions here are for the main Phoenix project. For the other subprojects, use the corresponding repository and JIRA project.",{"_11692":117,"_44950":90,"_16990":86721,"_5":16526,"_23412":86639,"_7169":86722},[45444],"The Eclipse and IntelliJ setup instructions may not necessarily work well for the other projects.",{"_11692":118,"_44950":90,"_16990":86724,"_5":16526,"_23412":86643,"_7169":86725},[45444],"You may find it easier to clone from your IDE of choice, especially with IntelliJ.",{"_11692":119,"_44950":90,"_16990":86727,"_5":16526,"_23412":86643,"_7169":86728},[45444],"Create a local clone of your new forked repository",{"_11692":120,"_44950":90,"_16990":86730,"_5":16526,"_23412":86643,"_7169":86731},[45444],"Configure your local repository to be able to sync with the apache/phoenix repository",{"_11692":121,"_44950":90,"_16990":86733,"_5":16526,"_23412":86643,"_7169":86734},[45444],"Setup your development environment",{"_11692":122,"_44950":90,"_16990":86736,"_5":16526,"_23412":86647,"_7169":86737},[45444],"Download Eclipse",{"_11692":123,"_44950":90,"_16990":86739,"_5":16526,"_23412":86647,"_7169":86740},[45444],"You will want 'Eclipse IDE for Java Developers' unless you want to install the following tools by hand",{"_11692":124,"_44950":90,"_16990":86742,"_5":16526,"_23412":86647,"_7169":19061},[45444],{"_11692":125,"_44950":90,"_16990":86744,"_5":16526,"_23412":86647,"_7169":39411},[45444],{"_11692":126,"_44950":90,"_16990":86746,"_5":16526,"_23412":86647,"_7169":86747},[45444],"Configure Eclipse to handle Maven Issues appropriately so you don't see unnecessary errors.",{"_11692":127,"_44950":90,"_16990":86749,"_5":16526,"_23412":86647,"_7169":86750},[45444],"Window -> Preferences -> Maven -> Errors/Warnings",{"_11692":128,"_44950":90,"_16990":86752,"_5":16526,"_23412":86647,"_7169":86753},[45444],"Choose Ignore option for 'Plugin execution not covered by lifecycle configuration' -> Ok",{"_11692":129,"_44950":90,"_16990":86755,"_5":16526,"_23412":86647,"_7169":86756},[45444],"Add the local Git repository to Eclipse",{"_11692":130,"_44950":90,"_16990":86758,"_5":16526,"_23412":86647,"_7169":86759},[45444],"Window -> Show View -> Other... -> Git | Git Repositories -> Ok",{"_11692":131,"_44950":90,"_16990":86761,"_5":16526,"_23412":86647,"_7169":86762},[45444],"Click 'Add an existing local Git Repository to this view'",{"_11692":132,"_44950":90,"_16990":86764,"_5":16526,"_23412":86647,"_7169":86765},[45444],"Search for appropriate git repository",{"_11692":133,"_44950":90,"_16990":86767,"_5":16526,"_23412":86647,"_7169":86768},[45444],"Finish",{"_11692":134,"_44950":90,"_16990":86770,"_5":16526,"_23412":86647,"_7169":86771},[45444],"Import Maven Projects",{"_11692":135,"_44950":90,"_16990":86773,"_5":16526,"_23412":86647,"_7169":86774},[45444],"File -> Import -> Maven -> Existing Maven Projects",{"_11692":136,"_44950":90,"_16990":86776,"_5":16526,"_23412":86647,"_7169":86777},[45444],"Choose Root directory where phoenix git repository is located",{"_11692":137,"_44950":90,"_16990":86779,"_5":16526,"_23412":86647,"_7169":86780},[45444],"Select All",{"_11692":138,"_44950":90,"_16990":86782,"_5":16526,"_23412":86647,"_7169":86768},[45444],{"_11692":139,"_44950":90,"_16990":86784,"_5":16526,"_23412":86647,"_7169":86785},[45444],"Generate Lexer and Parser Files",{"_11692":140,"_44950":90,"_16990":86787,"_5":16526,"_23412":86647,"_7169":86788},[45444],"Select phoenix-core project",{"_11692":141,"_44950":90,"_16990":86790,"_5":16526,"_23412":86647,"_7169":86791},[45444],"Run -> Run As -> Maven generate-sources",{"_11692":142,"_44950":90,"_16990":86793,"_5":16526,"_23412":86647,"_7169":86794},[45444],"Make sure you are setup to develop now.",{"_11692":143,"_44950":90,"_16990":86796,"_5":16526,"_23412":86647,"_7169":86797},[45444],"Open IndexUtilTest.Java",{"_11692":144,"_44950":90,"_16990":86799,"_5":16526,"_23412":86647,"_7169":86800},[45444],"Run -> Run As -> JUnit Test",{"_11692":145,"_44950":90,"_16990":86802,"_5":16526,"_23412":86651,"_7169":86803},[45444],"Import General Preferences",{"_11692":146,"_44950":90,"_16990":86805,"_5":16526,"_23412":86651,"_7169":86806},[45444],"File -> Import... -> General -> Preferences",{"_11692":147,"_44950":90,"_16990":86808,"_5":16526,"_23412":86651,"_7169":86809},[45444],"From - {repository}/dev/eclipse_prefs_phoenix.epf",{"_11692":148,"_44950":90,"_16990":86811,"_5":16526,"_23412":86651,"_7169":86812},[45444],"Import All",{"_11692":149,"_44950":90,"_16990":86814,"_5":16526,"_23412":86651,"_7169":86768},[45444],{"_11692":150,"_44950":90,"_16990":86816,"_5":16526,"_23412":86651,"_7169":86817},[45444],"Import Code Templates",{"_11692":151,"_44950":90,"_16990":86819,"_5":16526,"_23412":86651,"_7169":86820},[45444],"Window -> Preferences -> Java -> Code Style -> Code Templates -> Import...",{"_11692":152,"_44950":90,"_16990":86822,"_5":16526,"_23412":86651,"_7169":86823},[45444],"Navigate to {repository}/dev/PhoenixCodeTemplate.xml -> Ok",{"_11692":153,"_44950":90,"_16990":86825,"_5":16526,"_23412":86651,"_7169":86826},[45444],"Import Formatter",{"_11692":154,"_44950":90,"_16990":86828,"_5":16526,"_23412":86651,"_7169":86829},[45444],"Window -> Preferences -> Java -> Code Style -> Formatter-> Import...",{"_11692":155,"_44950":90,"_16990":86831,"_5":16526,"_23412":86651,"_7169":86823},[45444],{"_11692":156,"_44950":90,"_16990":86833,"_5":16526,"_23412":86651,"_7169":86834},[45444],"Import correct import order settings",{"_11692":157,"_44950":90,"_16990":86836,"_5":16526,"_23412":86651,"_7169":86837},[45444],"Window -> Preferences -> Java -> Code Style -> Organize Imports -> Import...",{"_11692":158,"_44950":90,"_16990":86839,"_5":16526,"_23412":86651,"_7169":86840},[45444],"Navigate to {repository}/dev/phoenix.importorder -> Ok",{"_11692":159,"_44950":90,"_16990":86842,"_5":16526,"_23412":86651,"_7169":86843},[45444],"Make sure you use space for tabs",{"_11692":160,"_44950":90,"_16990":86845,"_5":16526,"_23412":86651,"_7169":86846},[45444],"Window -> Preferences -> General -> Editors -> Text Editors",{"_11692":161,"_44950":90,"_16990":86848,"_5":16526,"_23412":86651,"_7169":86849},[45444],"Select 'Insert Spaces for tabs' -> Ok",{"_11692":162,"_44950":90,"_16990":86851,"_5":16526,"_23412":86655,"_7169":86852},[45444],"Install Connector for Jira",{"_11692":163,"_44950":90,"_16990":86854,"_5":16526,"_23412":86655,"_7169":86855},[45444],"Help -> Install New Software -> Add",{"_11692":164,"_44950":90,"_16990":86857,"_5":16526,"_23412":86655,"_7169":86858},[45444],"Location - https://update.atlassian.com/atlassian-eclipse-plugin/rest/e3.7 -> Atlassian Connector",{"_11692":165,"_44950":90,"_16990":86860,"_5":16526,"_23412":86655,"_7169":86768},[45444],{"_11692":166,"_44950":90,"_16990":86862,"_5":16526,"_23412":86655,"_7169":86863},[45444],"Add Task Repository",{"_11692":167,"_44950":90,"_16990":86865,"_5":16526,"_23412":86655,"_7169":86866},[45444],"Window -> Show View -> Mylyn -> Task Repositories -> Add Task Repository",{"_11692":168,"_44950":90,"_16990":86868,"_5":16526,"_23412":86655,"_7169":86869},[45444],"JIRA -> Next -> Server - https://issues.apache.org/jira -> Validate Settings",{"_11692":169,"_44950":90,"_16990":86871,"_5":16526,"_23412":86655,"_7169":86768},[45444],{"_11692":170,"_44950":90,"_16990":86873,"_5":16526,"_23412":86655,"_7169":86874},[45444],"Add Filter Of All JIRAs assigned to you",{"_11692":171,"_44950":90,"_16990":86876,"_5":16526,"_23412":86655,"_7169":86877},[45444],"Right Click on Repository You added -> New Query... -> Predefined Filter",{"_11692":172,"_44950":90,"_16990":86879,"_5":16526,"_23412":86655,"_7169":86880},[45444],"Select Phoenix Project -> Select Assigned to me",{"_11692":173,"_44950":90,"_16990":86882,"_5":16526,"_23412":86655,"_7169":86768},[45444],{"_11692":174,"_44950":90,"_16990":86884,"_5":16526,"_23412":86659,"_7169":86885},[45444],"Commit Changes and Push to Github with appropriate Message",{"_11692":175,"_44950":90,"_16990":86887,"_5":16526,"_23412":86659,"_7169":86888},[45444],"CTRL-# -> Set Commit message to include jira number at beginning PHOENIX-####",{"_11692":176,"_44950":90,"_16990":86890,"_5":16526,"_23412":86659,"_7169":86891},[45444],"Commit and Push",{"_11692":177,"_44950":90,"_16990":86893,"_5":16526,"_23412":86663,"_7169":86894},[45444],"Download IntelliJ",{"_11692":178,"_44950":90,"_16990":86896,"_5":16526,"_23412":86667,"_7169":86897},[45444],"This will automatically create the local clone of your repository for you. You will still want to add the remote upstream repository from above afterwards.",{"_11692":179,"_44950":90,"_16990":86899,"_5":16526,"_23412":86667,"_7169":86900},[45444],"Clone Github project and Import Maven Projects to IDE",{"_11692":180,"_44950":90,"_16990":86902,"_5":16526,"_23412":86667,"_7169":86903},[45444],"Check out from Version Control -> GitHub -> Enter your GitHub Login Info",{"_11692":181,"_44950":90,"_16990":86905,"_5":16526,"_23412":86667,"_7169":86906},[45444],"https://github.com/{username}/phoenix.git -> Check out from Version Control | Yes",{"_11692":182,"_44950":90,"_16990":86908,"_5":16526,"_23412":86667,"_7169":86909},[45444],"Generate Parser and Lexer Files",{"_11692":183,"_44950":90,"_16990":86911,"_5":16526,"_23412":86667,"_7169":86912},[45444],"Maven Projects -> Phoenix Core -> Lifecycle -> compile",{"_11692":184,"_44950":90,"_16990":86914,"_5":16526,"_23412":86667,"_7169":86915},[45444],"Compile Project",{"_11692":185,"_44950":90,"_16990":86917,"_5":16526,"_23412":86667,"_7169":86918},[45444],"Build -> Make Project",{"_11692":186,"_44950":90,"_16990":86920,"_5":16526,"_23412":86667,"_7169":86794},[45444],{"_11692":187,"_44950":90,"_16990":86922,"_5":16526,"_23412":86667,"_7169":86923},[45444],"Open IndexUtilTest.Java -> Run -> Run IndexUtilTest",{"_11692":188,"_44950":90,"_16990":86925,"_5":16526,"_23412":86671,"_7169":86926},[45444],"Import Projects",{"_11692":189,"_44950":90,"_16990":86928,"_5":16526,"_23412":86671,"_7169":86929},[45444],"Import Project",{"_11692":190,"_44950":90,"_16990":86931,"_5":16526,"_23412":86671,"_7169":86932},[45444],"Select Directory of your local repository -> Next",{"_11692":191,"_44950":90,"_16990":86934,"_5":16526,"_23412":86671,"_7169":86935},[45444],"Import project from external model -> Maven -> Next",{"_11692":192,"_44950":90,"_16990":86937,"_5":16526,"_23412":86671,"_7169":86938},[45444],"Select 'Import Maven project automatically'",{"_11692":193,"_44950":90,"_16990":86940,"_5":16526,"_23412":86671,"_7169":86941},[45444],"Select 'Create IntelliJ IDEA modules for aggregator projects'",{"_11692":194,"_44950":90,"_16990":86943,"_5":16526,"_23412":86671,"_7169":86944},[45444],"Select 'Keep source and test folders on reimport'",{"_11692":195,"_44950":90,"_16990":86946,"_5":16526,"_23412":86671,"_7169":86947},[45444],"Select 'Exclude build directory'",{"_11692":196,"_44950":90,"_16990":86949,"_5":16526,"_23412":86671,"_7169":86950},[45444],"Select 'Use Maven output directories' -> Next",{"_11692":197,"_44950":90,"_16990":86952,"_5":16526,"_23412":86671,"_7169":86953},[45444],"Select maven-3 -> Next",{"_11692":198,"_44950":90,"_16990":86955,"_5":16526,"_23412":86671,"_7169":86956},[45444],"Next a whole bunch",{"_11692":199,"_44950":90,"_16990":86958,"_5":16526,"_23412":86671,"_7169":86909},[45444],{"_11692":200,"_44950":90,"_16990":86960,"_5":16526,"_23412":86671,"_7169":86912},[45444],{"_11692":201,"_44950":90,"_16990":86962,"_5":16526,"_23412":86671,"_7169":86915},[45444],{"_11692":202,"_44950":90,"_16990":86964,"_5":16526,"_23412":86671,"_7169":86918},[45444],{"_11692":203,"_44950":90,"_16990":86966,"_5":16526,"_23412":86671,"_7169":86794},[45444],{"_11692":204,"_44950":90,"_16990":86968,"_5":16526,"_23412":86671,"_7169":86923},[45444],{"_11692":205,"_44950":90,"_16990":86970,"_5":16526,"_23412":86675,"_7169":86971},[45444],"Import Settings from eclipse profile",{"_11692":206,"_44950":90,"_16990":86973,"_5":16526,"_23412":86675,"_7169":86974},[45444],"File -> Settings -> Editor -> Code Style -> Java",{"_11692":207,"_44950":90,"_16990":86976,"_5":16526,"_23412":86675,"_7169":86977},[45444],"Set From... -> Import... -> Eclipse XML Profile -> {repository}/dev/PhoenixCodeTemplate.xml",{"_11692":208,"_44950":90,"_16990":86979,"_5":16526,"_23412":86678,"_7169":86980},[45444],"Create Connection to Apache Jira",{"_11692":209,"_44950":90,"_16990":86982,"_5":16526,"_23412":86678,"_7169":86983},[45444],"Tools -> Tasks and Contexts -> Configure Servers -> + -> Jira ->",{"_11692":210,"_44950":90,"_16990":86985,"_5":16526,"_23412":86678,"_7169":86986},[45444],"Server Url: https://issues.apache.org/jira",{"_11692":211,"_44950":90,"_16990":86988,"_5":16526,"_23412":86678,"_7169":86989},[45444],"Query: 'project=Phoenix and ...'",{"_11692":212,"_44950":90,"_16990":86991,"_5":16526,"_23412":86678,"_7169":86992},[45444],"Switch Easily between Tasks",{"_11692":213,"_44950":90,"_16990":86994,"_5":16526,"_23412":86678,"_7169":86995},[45444],"Tools-> Tasks and Contexts -> Open Task->PHOENIX-####",{"_11692":214,"_44950":90,"_16990":86997,"_5":16526,"_23412":86678,"_7169":86998},[45444],"Select Create branch PHOENIX-#### from master->OK",{"_11692":215,"_44950":90,"_16990":87000,"_5":16526,"_23412":86681,"_7169":86885},[45444],{"_11692":216,"_44950":90,"_16990":87002,"_5":16526,"_23412":86681,"_7169":87003},[45444],"VCS -> Commit -> Set Commit message to include jira number PHOENIX-####",{"_11692":217,"_44950":90,"_16990":87005,"_5":16526,"_23412":86681,"_7169":86891},[45444],{"_11692":218,"_44950":90,"_16990":87007,"_5":16526,"_23412":86688,"_7169":86692},[45444],{"_11692":219,"_44950":90,"_16990":87009,"_5":16526,"_23412":86688,"_7169":87010},[45444],"Navigate to branch: https://github.com/{username}/phoenix/tree/{branchname}",{"_11692":220,"_44950":90,"_16990":87012,"_5":16526,"_23412":86688,"_7169":87013},[45444],"Click Pull Request",{"_11692":221,"_44950":90,"_16990":87015,"_5":16526,"_23412":86688,"_7169":87016},[45444],"Confirm that you see apache:master ... {username}:{branchname}",{"_11692":222,"_44950":90,"_16990":87018,"_5":16526,"_23412":86688,"_7169":87019},[45444],"Make sure the pull request title begins with the JIRA key, for example PHOENIX-####.",{"_11692":223,"_44950":90,"_16990":87021,"_5":16526,"_23412":86688,"_7169":87022},[45444],"Click Create pull request.",{"_11692":224,"_44950":224,"_5":12121,"_7169":87024,"_45415":87025,"_16990":87026,"_23412":224},"How to Release",[86368,86369,86370,86545],[45444],{"_11692":225,"_44950":224,"_16990":87028,"_5":16526,"_23412":224,"_7169":87029},[45444],"Apache Phoenix release process, release candidates, and voting workflow.",{"_11692":226,"_44950":224,"_5":45412,"_16990":87031,"_23412":87032,"_7169":87024},[45444],"/docs/contributing/how-to-release#contributing-how-to-release",{"_11692":227,"_44950":224,"_5":45412,"_16990":87034,"_23412":87035,"_7169":87036},[45444],"/docs/contributing/how-to-release#pre-reqs","Pre-Reqs",{"_11692":228,"_44950":224,"_5":45412,"_16990":87038,"_23412":87039,"_7169":87040},[45444],"/docs/contributing/how-to-release#do-a-dry-run","Do a dry run",{"_11692":229,"_44950":224,"_5":45412,"_16990":87042,"_23412":87043,"_7169":87044},[45444],"/docs/contributing/how-to-release#create-real-rc","Create real RC",{"_11692":230,"_44950":224,"_5":45412,"_16990":87046,"_23412":87047,"_7169":87048},[45444],"/docs/contributing/how-to-release#close-the-staging-repository","Close the staging repository",{"_11692":231,"_44950":224,"_5":45412,"_16990":87050,"_23412":87051,"_7169":87052},[45444],"/docs/contributing/how-to-release#voting","Voting",{"_11692":232,"_44950":224,"_5":45412,"_16990":87054,"_23412":87055,"_7169":87056},[45444],"/docs/contributing/how-to-release#release","Release",{"_11692":233,"_44950":224,"_16990":87058,"_5":16526,"_23412":87032,"_7169":87059},[45444],"Phoenix has several repos: phoenix-thirdparty, phoenix-omid, phoenix-tephra, phoenix, phoenix-connectors, and phoenix-queryserver.\nThe create-release scripts provide a unified script to handle the release from each repo.\nThe create-release scripts are in the master branch of the phoenix repo, in the dev/create-release directory.",{"_11692":234,"_44950":224,"_16990":87061,"_5":16526,"_23412":87035,"_7169":87062},[45444],"Make sure that the JIRAs included in the release have their fix-version and release notes fields set correctly, and are resolved.The script will query them and create the CHANGES and RELEASE_NOTES files from that information.Use dev/misc_utils/git_jira_fix_version_check.py to find discrepancies between commits and JIRAs.",{"_11692":235,"_44950":224,"_16990":87064,"_5":16526,"_23412":87035,"_7169":87065},[45444],"Make sure you have set up your user for release signing. Details: http://www.apache.org/dev/release-signing.html.",{"_11692":236,"_44950":224,"_16990":87067,"_5":16526,"_23412":87035,"_7169":87068},[45444],"Make sure you have set up Maven for deploying to the ASF repo. Details: https://infra.apache.org/publishing-maven-artifacts.html.",{"_11692":237,"_44950":224,"_16990":87070,"_5":16526,"_23412":87035,"_7169":87071},[45444],"Clone the Phoenix master branch locally (the script will download the actual repo to release itself).",{"_11692":238,"_44950":224,"_16990":87073,"_5":16526,"_23412":87035,"_7169":87074},[45444],"Make sure Docker is running locally.",{"_11692":239,"_44950":224,"_16990":87076,"_5":16526,"_23412":87035,"_7169":87077},[45444],"Note that Docker Desktop for Mac works, but will be slow (several hours for a Phoenix core release). Running on a native Linux machine is much faster because you avoid filesystem translation layer overhead.",{"_11692":240,"_44950":224,"_16990":87079,"_5":16526,"_23412":87039,"_7169":87080},[45444],"Read /dev/create_release/README.txt to understand what the script does and how to set up gpg-agent for signing.",{"_11692":241,"_44950":224,"_16990":87082,"_5":16526,"_23412":87039,"_7169":87083},[45444],"Run the dev/create-release/do-release-docker.sh -d <workdir> -p <project> command, where",{"_11692":242,"_44950":224,"_16990":87085,"_5":16526,"_23412":87039,"_7169":87086},[45444],"<project> is the repo name you're releasing from (i.e. phoenix)",{"_11692":243,"_44950":224,"_16990":87088,"_5":16526,"_23412":87039,"_7169":87089},[45444],"<workdir> is any existing directory that can be deleted",{"_11692":244,"_44950":224,"_16990":87091,"_5":16526,"_23412":87039,"_7169":87092},[45444],"The script will ask a number of questions. Some of them will have intelligent default, but make sure you check them all:",{"_11692":245,"_44950":224,"_16990":87094,"_5":16526,"_23412":87039,"_7169":87095},[45444],"PROJECT: the repo to release (default specified by -p on the command line)",{"_11692":246,"_44950":224,"_16990":87097,"_5":16526,"_23412":87039,"_7169":87098},[45444],"GIT_BRANCH: the git branch to use for release. This can be master, or a pre-created release branch.",{"_11692":247,"_44950":224,"_16990":87100,"_5":16526,"_23412":87039,"_7169":87101},[45444],"RC_COUNT: the RC number, starting from 0",{"_11692":248,"_44950":224,"_16990":87103,"_5":16526,"_23412":87039,"_7169":87104},[45444],"RELEASE_TAG: the git tag the script will tag the RC commit with.",{"_11692":249,"_44950":224,"_16990":87106,"_5":16526,"_23412":87039,"_7169":87107},[45444],"ASF_USERNAME: your ASF username, for publishing the release artifacts.",{"_11692":250,"_44950":224,"_16990":87109,"_5":16526,"_23412":87039,"_7169":87110},[45444],"ASF_PASSWORD: your ASF password, only for non-dry runs",{"_11692":251,"_44950":224,"_16990":87112,"_5":16526,"_23412":87039,"_7169":87113},[45444],"GIT_NAME/GIT_EMAIL: will be used for the RC commit",{"_11692":252,"_44950":224,"_16990":87115,"_5":16526,"_23412":87039,"_7169":87116},[45444],"GPG_KEY: ID for your GPG key. The script will offer a GPG secret key from your key ring, double-check that it is your code-signing key, and correct it if it is not.",{"_11692":253,"_44950":224,"_16990":87118,"_5":16526,"_23412":87039,"_7169":87119},[45444],"The dry-run will generate the signed release files into <workdir>/output directory.\nThe Maven artifacts will be in <workdir>/output/phoenix-repo-XXXX local Maven repo, in the usual structure.",{"_11692":254,"_44950":224,"_16990":87121,"_5":16526,"_23412":87043,"_7169":87122},[45444],"If the dry-run release artifacts (source, binary, and Maven) check out, then publish a real RC to ASF.",{"_11692":255,"_44950":224,"_16990":87124,"_5":16526,"_23412":87043,"_7169":87125},[45444],"Repeat the dry run process, but add the -f switch to the do-release-docker.sh command.",{"_11692":256,"_44950":224,"_16990":87127,"_5":16526,"_23412":87043,"_7169":87128},[45444],"The script will upload the source and binary release artifacts to a directory under https://dist.apache.org/repos/dist/dev/phoenix/.\nThe script will also deploy the Maven artifacts to https://repository.apache.org/#stagingRepositories.\nCheck that these are present.",{"_11692":257,"_44950":224,"_16990":87130,"_5":16526,"_23412":87047,"_7169":87131},[45444],"The published staging repository is in the \"open\" state. Open staging repositories\nare aggressively cleaned up, and may be removed by the time the vote passes.\nTo avoid this, close\n(but DO NOT release) the staging repository immediately after deployment.",{"_11692":258,"_44950":224,"_16990":87133,"_5":16526,"_23412":87051,"_7169":87134},[45444],"Initiate the vote email. See example here, or use the <workdir>/output/vote.txt template generated by the script.",{"_11692":259,"_44950":224,"_16990":87136,"_5":16526,"_23412":87051,"_7169":87137},[45444],"In case the RC (Release Candidate) is rejected via the vote, you will have to repeat the above process and re-initiate the vote for the next RC (RC0, RC1, etc.).",{"_11692":260,"_44950":224,"_16990":87139,"_5":16526,"_23412":87055,"_7169":87140},[45444],"Once voting is successful (say for RC1), copy artifacts to https://dist.apache.org/repos/dist/release/phoenix:",{"_11692":261,"_44950":224,"_16990":87142,"_5":16526,"_23412":87055,"_7169":87143},[45444],"Set release tag and commit:",{"_11692":262,"_44950":224,"_16990":87145,"_5":16526,"_23412":87055,"_7169":87146},[45444],"Remove any obsolete releases on https://dist.apache.org/repos/dist/release/phoenix given the current release.",{"_11692":263,"_44950":224,"_16990":87148,"_5":16526,"_23412":87055,"_7169":87149},[45444],"Go to https://repository.apache.org/#stagingRepositories and release the staged artifacts (this takes a while so you may need to refresh multiple times).",{"_11692":264,"_44950":224,"_16990":87151,"_5":16526,"_23412":87055,"_7169":87152},[45444],"Create new branch based on current release if needed, for ex: 4.15 branches in this case.",{"_11692":265,"_44950":224,"_16990":87154,"_5":16526,"_23412":87055,"_7169":87155},[45444],"Set version to the upcoming SNAPSHOT and commit:",{"_11692":266,"_44950":224,"_16990":87157,"_5":16526,"_23412":87055,"_7169":87158},[45444],"If releasing Phoenix (core) Create a JIRA to update PHOENIX_MAJOR_VERSION, PHOENIX_MINOR_VERSION and PHOENIX_PATCH_NUMBER in MetaDataProtocol.java appropriately to next version (4, 16, 0 respectively in this case) and compatible_client_versions.json file with the client versions that are compatible against the next version (in this case 4.14.3 and 4.15.0 would be the backward compatible clients for 4.16.0). This JIRA should be committed/marked with fixVersion of the next release candidate.",{"_11692":267,"_44950":224,"_16990":87160,"_5":16526,"_23412":87055,"_7169":87161},[45444],"Add documentation of released version to the downloads page and wiki.",{"_11692":268,"_44950":224,"_16990":87163,"_5":16526,"_23412":87055,"_7169":87164},[45444],"Update the Apache Committee Report Helper DB",{"_11692":269,"_44950":224,"_16990":87166,"_5":16526,"_23412":87055,"_7169":87167},[45444],"Send out an announcement email. See example here.",{"_11692":270,"_44950":224,"_16990":87169,"_5":16526,"_23412":87055,"_7169":87170},[45444],"Bulk close JIRAs that were marked for the release fixVersion.",{"_11692":271,"_44950":224,"_16990":87172,"_5":16526,"_23412":87055,"_7169":87173},[45444],"Congratulations!",{"_11692":272,"_44950":272,"_5":12121,"_7169":86545,"_45415":87175,"_16990":87176,"_23412":272},[86368,86369,86370,86545],[45444],{"_11692":273,"_44950":272,"_16990":87178,"_5":16526,"_23412":272,"_7169":87179},[45444],"Contribution workflow for Apache Phoenix, including JIRA, patch/PR submission, and committer practices.",{"_11692":274,"_44950":272,"_5":45412,"_16990":87181,"_23412":87182,"_7169":87183},[45444],"/docs/contributing#general-process","General process",{"_11692":275,"_44950":272,"_5":45412,"_16990":87185,"_23412":87186,"_7169":87187},[45444],"/docs/contributing#discuss-on-the-mailing-list","Discuss on the mailing list",{"_11692":276,"_44950":272,"_5":45412,"_16990":87189,"_23412":87190,"_7169":87191},[45444],"/docs/contributing#log-a-jira-ticket","Log a JIRA ticket",{"_11692":277,"_44950":272,"_5":45412,"_16990":87193,"_23412":87194,"_7169":87195},[45444],"/docs/contributing#setup-development-environment","Setup development environment",{"_11692":278,"_44950":272,"_5":45412,"_16990":87197,"_23412":87198,"_7169":87199},[45444],"/docs/contributing#generate-a-patch","Generate a patch",{"_11692":279,"_44950":272,"_5":45412,"_16990":87201,"_23412":87202,"_7169":87203},[45444],"/docs/contributing#naming-convention-for-the-patch","Naming convention for the patch",{"_11692":280,"_44950":272,"_5":45412,"_16990":87205,"_23412":87206,"_7169":87207},[45444],"/docs/contributing#github-workflow","GitHub workflow",{"_11692":281,"_44950":272,"_5":45412,"_16990":87209,"_23412":87210,"_7169":87211},[45444],"/docs/contributing#local-git-workflow","Local Git workflow",{"_11692":282,"_44950":272,"_5":45412,"_16990":87213,"_23412":87214,"_7169":87215},[45444],"/docs/contributing#code-conventions","Code conventions",{"_11692":283,"_44950":272,"_5":45412,"_16990":87217,"_23412":87218,"_7169":87219},[45444],"/docs/contributing#committer-workflow","Committer workflow",{"_11692":284,"_44950":272,"_16990":87221,"_5":16526,"_23412":87182,"_7169":87222},[45444],"The general process for contributing code to Phoenix works as follows:",{"_11692":285,"_44950":272,"_16990":87224,"_5":16526,"_23412":87182,"_7169":87225},[45444],"Discuss your changes on the dev mailing list",{"_11692":286,"_44950":272,"_16990":87227,"_5":16526,"_23412":87182,"_7169":87228},[45444],"Create a JIRA issue unless there already is one",{"_11692":287,"_44950":272,"_16990":87230,"_5":16526,"_23412":87182,"_7169":86734},[45444],{"_11692":288,"_44950":272,"_16990":87232,"_5":16526,"_23412":87182,"_7169":87233},[45444],"Prepare a patch containing your changes",{"_11692":289,"_44950":272,"_16990":87235,"_5":16526,"_23412":87182,"_7169":87236},[45444],"Submit the patch",{"_11692":290,"_44950":272,"_16990":87238,"_5":16526,"_23412":87182,"_7169":87239},[45444],"These steps are explained in greater detail below.",{"_11692":291,"_44950":272,"_16990":87241,"_5":16526,"_23412":87182,"_7169":87242},[45444],"Note that the instructions below are for the main Phoenix project.\nUse the corresponding repository for the other subprojects.\nTephra and Omid also have their own JIRA projects.",{"_11692":292,"_44950":272,"_16990":87244,"_5":16526,"_23412":87186,"_7169":87245},[45444],"It's often best to discuss a change on the public mailing lists before creating and submitting a patch.",{"_11692":293,"_44950":272,"_16990":87247,"_5":16526,"_23412":87186,"_7169":87248},[45444],"If you're unsure whether certain behavior in Phoenix is a bug, please send a mail to the user mailing list to check.",{"_11692":294,"_44950":272,"_16990":87250,"_5":16526,"_23412":87186,"_7169":87251},[45444],"If you're considering adding major new functionality to Phoenix, it's a good idea to first discuss the idea on the developer mailing list to make sure that your plans are in line with others in the Phoenix community.",{"_11692":295,"_44950":272,"_16990":87253,"_5":16526,"_23412":87190,"_7169":87254},[45444],"The first step is to create a ticket on the Phoenix JIRA.",{"_11692":296,"_44950":272,"_16990":87256,"_5":16526,"_23412":87194,"_7169":87257},[45444],"To set up your development environment, see these directions.",{"_11692":297,"_44950":272,"_16990":87259,"_5":16526,"_23412":87198,"_7169":87260},[45444],"There are two general approaches for creating and submitting a patch: GitHub pull requests, or manual patch creation with Git. Both are explained below. Please make sure that the patch applies cleanly on all active branches, including master and the unified 4.x branch.",{"_11692":298,"_44950":272,"_16990":87262,"_5":16526,"_23412":87198,"_7169":87263},[45444],"Regardless of which approach is taken, please make sure to follow the Phoenix code conventions (more information below). Whenever possible, unit tests or integration tests should be included with patches.",{"_11692":299,"_44950":272,"_16990":87265,"_5":16526,"_23412":87198,"_7169":87266},[45444],"Please make sure that the patch contains only one commit, then click the \"Submit patch\" button to automatically trigger tests on the patch.",{"_11692":300,"_44950":272,"_16990":87268,"_5":16526,"_23412":87198,"_7169":87269},[45444],"The commit message should reference the JIRA ticket issue (which has the format\nPHOENIX-{NUMBER}:{JIRA-TITLE}).",{"_11692":301,"_44950":272,"_16990":87271,"_5":16526,"_23412":87198,"_7169":87272},[45444],"To effectively get the patch reviewed, please raise the pull request against an appropriate branch.",{"_11692":302,"_44950":272,"_16990":87274,"_5":16526,"_23412":87202,"_7169":87275},[45444],"When generating a patch, make sure the patch name uses the following format:\nPHOENIX-{NUMBER}.{BRANCH-NAME}.{VERSION}.patch",{"_11692":303,"_44950":272,"_16990":87277,"_5":16526,"_23412":87202,"_7169":87278},[45444],"Examples: PHOENIX-4872.master.v1.patch, PHOENIX-4872.master.v2.patch, PHOENIX-4872.4.x-HBase-1.3.v1.patch, etc.",{"_11692":304,"_44950":272,"_16990":87280,"_5":16526,"_23412":87206,"_7169":87281},[45444],"Create a pull request in GitHub for the mirror of the Phoenix Git repository.",{"_11692":305,"_44950":272,"_16990":87283,"_5":16526,"_23412":87206,"_7169":87284},[45444],"Generate a patch and attach it to JIRA so Hadoop QA runs automated tests.",{"_11692":306,"_44950":272,"_16990":87286,"_5":16526,"_23412":87206,"_7169":87287},[45444],"If you update the PR, generate a new patch with a different name so patch changes are detected and tests run for the new patch.",{"_11692":307,"_44950":272,"_16990":87289,"_5":16526,"_23412":87210,"_7169":87290},[45444],"Create a local branch:",{"_11692":308,"_44950":272,"_16990":87292,"_5":16526,"_23412":87210,"_7169":87293},[45444],"Make and commit changes",{"_11692":309,"_44950":272,"_16990":87295,"_5":16526,"_23412":87210,"_7169":87296},[45444],"Generate a patch based on the JIRA issue number:",{"_11692":310,"_44950":272,"_16990":87298,"_5":16526,"_23412":87210,"_7169":87299},[45444],"Attach the created patch file to the JIRA ticket.",{"_11692":311,"_44950":272,"_16990":87301,"_5":16526,"_23412":87214,"_7169":87302},[45444],"The Phoenix code conventions are similar to the Sun/Oracle Java Code Convention. We use 4 spaces (no tabs) for indentation and limit lines to 100 characters.",{"_11692":312,"_44950":272,"_16990":87304,"_5":16526,"_23412":87214,"_7169":87305},[45444],"Eclipse code formatting settings and import order settings (which can also be imported into Intellij IDEA) are available in the dev directory of the Phoenix codebase.",{"_11692":313,"_44950":272,"_16990":87307,"_5":16526,"_23412":87214,"_7169":87308},[45444],"All new source files should include the Apache license header.",{"_11692":314,"_44950":272,"_16990":87310,"_5":16526,"_23412":87218,"_7169":87311},[45444],"In general, the \"rebase\" workflow should be used with the Phoenix codebase (see this blog post for more information on the difference between \"merge\" and \"rebase\" workflows in Git).",{"_11692":315,"_44950":272,"_16990":87313,"_5":16526,"_23412":87218,"_7169":87314},[45444],"A patch file can be downloaded from a GitHub pull request by adding .patch to the end of the pull request URL, for example: https://github.com/apache/phoenix/pull/35.patch.",{"_11692":316,"_44950":272,"_16990":87316,"_5":16526,"_23412":87218,"_7169":87317},[45444],"When applying a user-contributed patch, use git am when a fully formatted patch file is available, as this preserves contributor contact information. Otherwise, add the contributor's name to the commit message.",{"_11692":317,"_44950":272,"_16990":87319,"_5":16526,"_23412":87218,"_7169":87320},[45444],"If a single ticket consists of a patch with multiple commits, the commits can be squashed into a single commit using git rebase.",{"_11692":318,"_44950":318,"_5":12121,"_7169":87322,"_45415":87323,"_16990":87324,"_23412":318},"Data Types",[86368,86369,86482],[45444],{"_11692":319,"_44950":318,"_16990":87326,"_5":16526,"_23412":318,"_7169":87327},[45444],"SQL data type reference for Apache Phoenix.",{"_11692":320,"_44950":318,"_5":45412,"_16990":87329,"_23412":87330,"_7169":87322},[45444],"/docs/datatypes#data-types",{"_11692":321,"_44950":318,"_5":45412,"_16990":87332,"_23412":87333,"_7169":87334},[45444],"/docs/datatypes#integer-type","INTEGER Type",{"_11692":322,"_44950":318,"_5":45412,"_16990":87336,"_23412":87337,"_7169":87338},[45444],"/docs/datatypes#unsigned_int-type","UNSIGNED_INT Type",{"_11692":323,"_44950":318,"_5":45412,"_16990":87340,"_23412":87341,"_7169":87342},[45444],"/docs/datatypes#bigint-type","BIGINT Type",{"_11692":324,"_44950":318,"_5":45412,"_16990":87344,"_23412":87345,"_7169":87346},[45444],"/docs/datatypes#unsigned_long-type","UNSIGNED_LONG Type",{"_11692":325,"_44950":318,"_5":45412,"_16990":87348,"_23412":87349,"_7169":87350},[45444],"/docs/datatypes#tinyint-type","TINYINT Type",{"_11692":326,"_44950":318,"_5":45412,"_16990":87352,"_23412":87353,"_7169":87354},[45444],"/docs/datatypes#unsigned_tinyint-type","UNSIGNED_TINYINT Type",{"_11692":327,"_44950":318,"_5":45412,"_16990":87356,"_23412":87357,"_7169":87358},[45444],"/docs/datatypes#smallint-type","SMALLINT Type",{"_11692":328,"_44950":318,"_5":45412,"_16990":87360,"_23412":87361,"_7169":87362},[45444],"/docs/datatypes#unsigned_smallint-type","UNSIGNED_SMALLINT Type",{"_11692":329,"_44950":318,"_5":45412,"_16990":87364,"_23412":87365,"_7169":87366},[45444],"/docs/datatypes#float-type","FLOAT Type",{"_11692":330,"_44950":318,"_5":45412,"_16990":87368,"_23412":87369,"_7169":87370},[45444],"/docs/datatypes#unsigned_float-type","UNSIGNED_FLOAT Type",{"_11692":331,"_44950":318,"_5":45412,"_16990":87372,"_23412":87373,"_7169":87374},[45444],"/docs/datatypes#double-type","DOUBLE Type",{"_11692":332,"_44950":318,"_5":45412,"_16990":87376,"_23412":87377,"_7169":87378},[45444],"/docs/datatypes#unsigned_double-type","UNSIGNED_DOUBLE Type",{"_11692":333,"_44950":318,"_5":45412,"_16990":87380,"_23412":87381,"_7169":87382},[45444],"/docs/datatypes#decimal-type","DECIMAL Type",{"_11692":334,"_44950":318,"_5":45412,"_16990":87384,"_23412":87385,"_7169":87386},[45444],"/docs/datatypes#boolean-type","BOOLEAN Type",{"_11692":335,"_44950":318,"_5":45412,"_16990":87388,"_23412":87389,"_7169":87390},[45444],"/docs/datatypes#time-type","TIME Type",{"_11692":336,"_44950":318,"_5":45412,"_16990":87392,"_23412":87393,"_7169":87394},[45444],"/docs/datatypes#date-type","DATE Type",{"_11692":337,"_44950":318,"_5":45412,"_16990":87396,"_23412":87397,"_7169":87398},[45444],"/docs/datatypes#timestamp-type","TIMESTAMP Type",{"_11692":338,"_44950":318,"_5":45412,"_16990":87400,"_23412":87401,"_7169":87402},[45444],"/docs/datatypes#unsigned_time-type","UNSIGNED_TIME Type",{"_11692":339,"_44950":318,"_5":45412,"_16990":87404,"_23412":87405,"_7169":87406},[45444],"/docs/datatypes#unsigned_date-type","UNSIGNED_DATE Type",{"_11692":340,"_44950":318,"_5":45412,"_16990":87408,"_23412":87409,"_7169":87410},[45444],"/docs/datatypes#unsigned_timestamp-type","UNSIGNED_TIMESTAMP Type",{"_11692":341,"_44950":318,"_5":45412,"_16990":87412,"_23412":87413,"_7169":87414},[45444],"/docs/datatypes#varchar-type","VARCHAR Type",{"_11692":342,"_44950":318,"_5":45412,"_16990":87416,"_23412":87417,"_7169":87418},[45444],"/docs/datatypes#char-type","CHAR Type",{"_11692":343,"_44950":318,"_5":45412,"_16990":87420,"_23412":87421,"_7169":87422},[45444],"/docs/datatypes#binary-type","BINARY Type",{"_11692":344,"_44950":318,"_5":45412,"_16990":87424,"_23412":87425,"_7169":87426},[45444],"/docs/datatypes#varbinary-type","VARBINARY Type",{"_11692":345,"_44950":318,"_5":45412,"_16990":87428,"_23412":87429,"_7169":87430},[45444],"/docs/datatypes#varbinary_encoded-type","VARBINARY_ENCODED Type",{"_11692":346,"_44950":318,"_5":45412,"_16990":87432,"_23412":87433,"_7169":87434},[45444],"/docs/datatypes#array","ARRAY",{"_11692":347,"_44950":318,"_5":45412,"_16990":87436,"_23412":87437,"_7169":87438},[45444],"/docs/datatypes#bson-type","BSON Type",{"_11692":348,"_44950":318,"_16990":87440,"_5":16526,"_23412":87333,"_7169":87441},[45444],"Possible values: -2147483648 to 2147483647.",{"_11692":349,"_44950":318,"_16990":87443,"_5":16526,"_23412":87333,"_7169":87444},[45444],"Mapped to java.lang.Integer. The binary representation is a 4 byte integer with the sign bit flipped (so that negative values sorts before positive values).",{"_11692":350,"_44950":318,"_16990":87446,"_5":16526,"_23412":87333,"_7169":87447},[45444],"Example",{"_11692":351,"_44950":318,"_16990":87449,"_5":16526,"_23412":87337,"_7169":87450},[45444],"Possible values: 0 to 2147483647. Mapped to java.lang.Integer. The binary representation is a 4 byte integer, matching the Bytes.toBytes(int) method. The purpose of this type is to map to existing HBase data that was serialized using this HBase utility method. If that is not the case, use the regular signed type instead.",{"_11692":352,"_44950":318,"_16990":87452,"_5":16526,"_23412":87337,"_7169":87447},[45444],{"_11692":353,"_44950":318,"_16990":87454,"_5":16526,"_23412":87341,"_7169":87455},[45444],"Possible values: -9223372036854775808 to 9223372036854775807. Mapped to java.lang.Long. The binary representation is an 8 byte long with the sign bit flipped (so that negative values sorts before positive values).",{"_11692":354,"_44950":318,"_16990":87457,"_5":16526,"_23412":87341,"_7169":87447},[45444],{"_11692":355,"_44950":318,"_16990":87459,"_5":16526,"_23412":87345,"_7169":87460},[45444],"Possible values: 0 to 9223372036854775807. Mapped to java.lang.Long. The binary representation is an 8 byte integer, matching the Bytes.toBytes(long) method. The purpose of this type is to map to existing HBase data that was serialized using this HBase utility method. If that is not the case, use the regular signed type instead.",{"_11692":356,"_44950":318,"_16990":87462,"_5":16526,"_23412":87345,"_7169":87447},[45444],{"_11692":357,"_44950":318,"_16990":87464,"_5":16526,"_23412":87349,"_7169":87465},[45444],"Possible values: -128 to 127. Mapped to java.lang.Byte. The binary representation is a single byte, with the sign bit flipped (so that negative values sorts before positive values).",{"_11692":358,"_44950":318,"_16990":87467,"_5":16526,"_23412":87349,"_7169":87447},[45444],{"_11692":359,"_44950":318,"_16990":87469,"_5":16526,"_23412":87353,"_7169":87470},[45444],"Possible values: 0 to 127. Mapped to java.lang.Byte. The binary representation is a single byte, matching the Bytes.toBytes(byte) method. The purpose of this type is to map to existing HBase data that was serialized using this HBase utility method. If that is not the case, use the regular signed type instead.",{"_11692":360,"_44950":318,"_16990":87472,"_5":16526,"_23412":87353,"_7169":87447},[45444],{"_11692":361,"_44950":318,"_16990":87474,"_5":16526,"_23412":87357,"_7169":87475},[45444],"Possible values: -32768 to 32767. Mapped to java.lang.Short. The binary representation is a 2 byte short with the sign bit flipped (so that negative values sort before positive values).",{"_11692":362,"_44950":318,"_16990":87477,"_5":16526,"_23412":87357,"_7169":87447},[45444],{"_11692":363,"_44950":318,"_16990":87479,"_5":16526,"_23412":87361,"_7169":87480},[45444],"Possible values: 0 to 32767. Mapped to java.lang.Short. The binary representation is an 2 byte integer, matching the Bytes.toBytes(short) method. The purpose of this type is to map to existing HBase data that was serialized using this HBase utility method. If that is not the case, use the regular signed type instead.",{"_11692":364,"_44950":318,"_16990":87482,"_5":16526,"_23412":87361,"_7169":87447},[45444],{"_11692":365,"_44950":318,"_16990":87484,"_5":16526,"_23412":87365,"_7169":87485},[45444],"Possible values: -3.402823466 E + 38 to 3.402823466 E + 38. Mapped to java.lang.Float. The binary representation is an 4 byte float with the sign bit flipped (so that negative values sort before positive values).",{"_11692":366,"_44950":318,"_16990":87487,"_5":16526,"_23412":87365,"_7169":87447},[45444],{"_11692":367,"_44950":318,"_16990":87489,"_5":16526,"_23412":87369,"_7169":87490},[45444],"Possible values: 0 to 3.402823466 E + 38. Mapped to java.lang.Float. The binary representation is an 4 byte float matching the Bytes.toBytes(float) method. The purpose of this type is to map to existing HBase data that was serialized using this HBase utility method. If that is not the case, use the regular signed type instead.",{"_11692":368,"_44950":318,"_16990":87492,"_5":16526,"_23412":87369,"_7169":87447},[45444],{"_11692":369,"_44950":318,"_16990":87494,"_5":16526,"_23412":87373,"_7169":87495},[45444],"Possible values: -1.7976931348623158 E + 308 to 1.7976931348623158 E + 308. Mapped to java.lang.Double. The binary representation is an 8 byte double with the sign bit flipped (so that negative values sort before positive value).",{"_11692":370,"_44950":318,"_16990":87497,"_5":16526,"_23412":87373,"_7169":87447},[45444],{"_11692":371,"_44950":318,"_16990":87499,"_5":16526,"_23412":87377,"_7169":87500},[45444],"Possible values: 0 to  1.7976931348623158 E + 308. Mapped to java.lang.Double. The binary representation is an 8 byte double matching the Bytes.toBytes(double) method. The purpose of this type is to map to existing HBase data that was serialized using this HBase utility method. If that is not the case, use the regular signed type instead.",{"_11692":372,"_44950":318,"_16990":87502,"_5":16526,"_23412":87377,"_7169":87447},[45444],{"_11692":373,"_44950":318,"_16990":87504,"_5":16526,"_23412":87381,"_7169":87505},[45444],"Data type with fixed precision and scale. A user can specify precision and scale by expression DECIMAL(precision,scale) in a DDL statement, for example, DECIMAL(10,2). The maximum precision is 38 digits. Mapped to java.math.BigDecimal. The binary representation is binary comparable, variable length format. When used in a row key, it is terminated with a null byte unless it is the last column.",{"_11692":374,"_44950":318,"_16990":87507,"_5":16526,"_23412":87381,"_7169":87447},[45444],{"_11692":375,"_44950":318,"_16990":87509,"_5":16526,"_23412":87385,"_7169":87510},[45444],"Possible values: TRUE and FALSE.",{"_11692":376,"_44950":318,"_16990":87512,"_5":16526,"_23412":87385,"_7169":87513},[45444],"Mapped to java.lang.Boolean. The binary representation is a single byte with 0 for false and 1 for true",{"_11692":377,"_44950":318,"_16990":87515,"_5":16526,"_23412":87385,"_7169":87447},[45444],{"_11692":378,"_44950":318,"_16990":87517,"_5":16526,"_23412":87389,"_7169":87518},[45444],"The time data type. The format is yyyy-MM-dd hh:mm:ss, with both the date and time parts maintained. Mapped to java.sql.Time. The binary representation is an 8 byte long (the number of milliseconds from the epoch), making it possible (although not necessarily recommended) to store more information within a TIME column than what is provided by \"java.sql.Time\". Note that the internal representation is based on a number of milliseconds since the epoch (which is based on a time in GMT), while \"java.sql.Time\" will format times based on the client's local time zone. Please note that this TIME type is different than the TIME type as defined by the SQL 92 standard in that it includes year, month, and day components. As such, it is not in compliance with the JDBC APIs. As the underlying data is still stored as a long, only the presentation of the value is incorrect.",{"_11692":379,"_44950":318,"_16990":87520,"_5":16526,"_23412":87389,"_7169":87447},[45444],{"_11692":380,"_44950":318,"_16990":87522,"_5":16526,"_23412":87393,"_7169":87523},[45444],"The date data type. The format is yyyy-MM-dd hh:mm:ss, with both the date and time parts maintained to a millisecond accuracy. Mapped to java.sql.Date. The binary representation is an 8 byte long (the number of milliseconds from the epoch), making it possible (although not necessarily recommended) to store more information within a DATE column than what is provided by \"java.sql.Date\". Note that the internal representation is based on a number of milliseconds since the epoch (which is based on a time in GMT), while \"java.sql.Date\" will format dates based on the client's local time zone. Please note that this DATE type is different than the DATE type as defined by the SQL 92 standard in that it includes a time component. As such, it is not in compliance with the JDBC APIs. As the underlying data is still stored as a long, only the presentation of the value is incorrect.",{"_11692":381,"_44950":318,"_16990":87525,"_5":16526,"_23412":87393,"_7169":87447},[45444],{"_11692":382,"_44950":318,"_16990":87527,"_5":16526,"_23412":87397,"_7169":87528},[45444],"The timestamp data type. The format is yyyy-MM-dd hh:mm:ss[.nnnnnnnnn]. Mapped to java.sql.Timestamp with an internal representation of the number of nanos from the epoch. The binary representation is 12 bytes: an 8 byte long for the epoch time plus a 4 byte integer for the nanos. Note that the internal representation is based on a number of milliseconds since the epoch (which is based on a time in GMT), while \"java.sql.Timestamp\" will format timestamps based on the client's local time zone.",{"_11692":383,"_44950":318,"_16990":87530,"_5":16526,"_23412":87397,"_7169":87447},[45444],{"_11692":384,"_44950":318,"_16990":87532,"_5":16526,"_23412":87401,"_7169":87533},[45444],"The unsigned time data type. The format is yyyy-MM-dd hh:mm:ss, with both the date and time parts maintained to the millisecond accuracy. Mapped to java.sql.Time. The binary representation is an 8 byte long (the number of milliseconds from the epoch) matching the HBase.toBytes(long) method. The purpose of this type is to map to existing HBase data that was serialized using this HBase utility method. If that is not the case, use the regular signed type instead.",{"_11692":385,"_44950":318,"_16990":87535,"_5":16526,"_23412":87401,"_7169":87447},[45444],{"_11692":386,"_44950":318,"_16990":87537,"_5":16526,"_23412":87405,"_7169":87538},[45444],"The unsigned date data type. The format is yyyy-MM-dd hh:mm:ss, with both the date and time parts maintained to a millisecond accuracy. Mapped to java.sql.Date. The binary representation is an 8 byte long (the number of milliseconds from the epoch) matching the HBase.toBytes(long) method. The purpose of this type is to map to existing HBase data that was serialized using this HBase utility method. If that is not the case, use the regular signed type instead.",{"_11692":387,"_44950":318,"_16990":87540,"_5":16526,"_23412":87405,"_7169":87447},[45444],{"_11692":388,"_44950":318,"_16990":87542,"_5":16526,"_23412":87409,"_7169":87543},[45444],"The timestamp data type. The format is yyyy-MM-dd hh:mm:ss[.nnnnnnnnn]. Mapped to java.sql.Timestamp with an internal representation of the number of nanos from the epoch. The binary representation is 12 bytes: an 8 byte long for the epoch time plus a 4 byte integer for the nanos with the long serialized through the HBase.toBytes(long) method. The purpose of this type is to map to existing HBase data that was serialized using this HBase utility method. If that is not the case, use the regular signed type instead.",{"_11692":389,"_44950":318,"_16990":87545,"_5":16526,"_23412":87409,"_7169":87447},[45444],{"_11692":390,"_44950":318,"_16990":87547,"_5":16526,"_23412":87413,"_7169":87548},[45444],"A variable length String with an optional max byte length. The binary representation is UTF8 matching the Bytes.toBytes(String) method. When used in a row key, it is terminated with a null byte unless it is the last column.",{"_11692":391,"_44950":318,"_16990":87550,"_5":16526,"_23412":87413,"_7169":87551},[45444],"Mapped to java.lang.String.",{"_11692":392,"_44950":318,"_16990":87553,"_5":16526,"_23412":87413,"_7169":87447},[45444],{"_11692":393,"_44950":318,"_16990":87555,"_5":16526,"_23412":87417,"_7169":87556},[45444],"A fixed length String with single-byte characters. The binary representation is UTF8 matching the Bytes.toBytes(String) method.",{"_11692":394,"_44950":318,"_16990":87558,"_5":16526,"_23412":87417,"_7169":87551},[45444],{"_11692":395,"_44950":318,"_16990":87560,"_5":16526,"_23412":87417,"_7169":87447},[45444],{"_11692":396,"_44950":318,"_16990":87562,"_5":16526,"_23412":87421,"_7169":87563},[45444],"Raw fixed length byte array.",{"_11692":397,"_44950":318,"_16990":87565,"_5":16526,"_23412":87421,"_7169":87566},[45444],"Mapped to byte[].",{"_11692":398,"_44950":318,"_16990":87568,"_5":16526,"_23412":87421,"_7169":87447},[45444],{"_11692":399,"_44950":318,"_16990":87570,"_5":16526,"_23412":87425,"_7169":87571},[45444],"Raw variable length byte array.",{"_11692":400,"_44950":318,"_16990":87573,"_5":16526,"_23412":87425,"_7169":87566},[45444],{"_11692":401,"_44950":318,"_16990":87575,"_5":16526,"_23412":87425,"_7169":87447},[45444],{"_11692":402,"_44950":318,"_16990":87577,"_5":16526,"_23412":87429,"_7169":87578},[45444],"Variable length byte array that escapes embedded 0x00 bytes so its sort order matches the lexicographic order of the original bytes. Use it anywhere ordering matters: a non-trailing column of a composite primary key, an index key, or a row value constructor over binary data.",{"_11692":403,"_44950":318,"_16990":87580,"_5":16526,"_23412":87429,"_7169":87581},[45444],"Mapped to byte[]. See VARBINARY_ENCODED for details.",{"_11692":404,"_44950":318,"_16990":87583,"_5":16526,"_23412":87429,"_7169":87447},[45444],{"_11692":405,"_44950":318,"_16990":87585,"_5":16526,"_23412":87433,"_7169":87586},[45444],"Mapped to java.sql.Array. Every primitive type except for VARBINARY may be declared as an ARRAY. Only single dimensional arrays are supported.",{"_11692":406,"_44950":318,"_16990":87588,"_5":16526,"_23412":87433,"_7169":87447},[45444],{"_11692":407,"_44950":318,"_16990":87590,"_5":16526,"_23412":87437,"_7169":87591},[45444],"Native binary JSON document column for schemaless data. Phoenix can read individual fields with BSON_VALUE, filter rows with BSON_CONDITION_EXPRESSION, and atomically update fields with BSON_UPDATE_EXPRESSION — all evaluated server-side.",{"_11692":408,"_44950":318,"_16990":87593,"_5":16526,"_23412":87437,"_7169":87594},[45444],"Stored as BSON bytes; returned as org.bson.RawBsonDocument. See Document Data: BSON for details.",{"_11692":409,"_44950":318,"_16990":87596,"_5":16526,"_23412":87437,"_7169":87447},[45444],{"_11692":410,"_44950":410,"_5":12121,"_7169":87598,"_45415":87599,"_16990":87600,"_23412":410},"Explain Plan",[86368,86369,86482],[45444],{"_11692":411,"_44950":410,"_16990":87602,"_5":16526,"_23412":410,"_7169":87603},[45444],"How to read and use EXPLAIN plans in Apache Phoenix.",{"_11692":412,"_44950":410,"_5":45412,"_16990":87605,"_23412":87606,"_7169":87598},[45444],"/docs/explain-plan#explain-plan-overview",{"_11692":413,"_44950":410,"_5":45412,"_16990":87608,"_23412":87609,"_7169":87610},[45444],"/docs/explain-plan#anatomy-of-an-explain-plan","Anatomy of an Explain Plan",{"_11692":414,"_44950":410,"_5":45412,"_16990":87612,"_23412":87613,"_7169":87447},[45444],"/docs/explain-plan#explain-plan-example",{"_11692":415,"_44950":410,"_5":45412,"_16990":87615,"_23412":87616,"_7169":87617},[45444],"/docs/explain-plan#jdbc-explain-plan-api-and-estimates","JDBC Explain Plan API and Estimates",{"_11692":416,"_44950":410,"_16990":87619,"_5":16526,"_23412":87606,"_7169":87620},[45444],"An EXPLAIN plan tells you a lot about how a query will be run:",{"_11692":417,"_44950":410,"_16990":87622,"_5":16526,"_23412":87606,"_7169":87623},[45444],"All the HBase range queries that will be executed",{"_11692":418,"_44950":410,"_16990":87625,"_5":16526,"_23412":87606,"_7169":87626},[45444],"An estimate of the number of bytes that will be scanned",{"_11692":419,"_44950":410,"_16990":87628,"_5":16526,"_23412":87606,"_7169":87629},[45444],"An estimate of the number of rows that will be traversed",{"_11692":420,"_44950":410,"_16990":87631,"_5":16526,"_23412":87606,"_7169":87632},[45444],"Time at which the above estimate information was collected",{"_11692":421,"_44950":410,"_16990":87634,"_5":16526,"_23412":87606,"_7169":87635},[45444],"Which HBase table will be used for each scan",{"_11692":422,"_44950":410,"_16990":87637,"_5":16526,"_23412":87606,"_7169":87638},[45444],"Which operations (sort, merge, scan, limit) are executed on the client versus the server",{"_11692":423,"_44950":410,"_16990":87640,"_5":16526,"_23412":87606,"_7169":87641},[45444],"Use an EXPLAIN plan to check how a query will run, and consider rewriting queries to meet the following goals:",{"_11692":424,"_44950":410,"_16990":87643,"_5":16526,"_23412":87606,"_7169":87644},[45444],"Emphasize operations on the server rather than the client. Server operations are distributed across the cluster and operate in parallel, while client operations execute within the single client JDBC driver.",{"_11692":425,"_44950":410,"_16990":87646,"_5":16526,"_23412":87606,"_7169":87647},[45444],"Use RANGE SCAN or SKIP SCAN whenever possible rather than TABLE SCAN.",{"_11692":426,"_44950":410,"_16990":87649,"_5":16526,"_23412":87606,"_7169":87650},[45444],"Filter against leading columns in the primary key constraint. This assumes you have designed the primary key to lead with frequently-accessed or frequently-filtered columns as described in “Primary Keys,” above.",{"_11692":427,"_44950":410,"_16990":87652,"_5":16526,"_23412":87606,"_7169":87653},[45444],"If necessary, introduce a local index or a global index that covers your query.",{"_11692":428,"_44950":410,"_16990":87655,"_5":16526,"_23412":87606,"_7169":87656},[45444],"If you have an index that covers your query but the optimizer is not detecting it, try hinting the query:\nSELECT /*+ INDEX() */ …",{"_11692":429,"_44950":410,"_16990":87658,"_5":16526,"_23412":87606,"_7169":87659},[45444],"See also: SQL Language Reference - EXPLAIN",{"_11692":430,"_44950":410,"_16990":87661,"_5":16526,"_23412":87609,"_7169":87662},[45444],"An explain plan consists of lines of text that describe operations that Phoenix will perform during a query, using the following terms:",{"_11692":431,"_44950":410,"_16990":87664,"_5":16526,"_23412":87609,"_7169":87665},[45444],"AGGREGATE INTO ORDERED DISTINCT ROWS — aggregates the returned rows using an operation such as addition. When ORDERED is used, the GROUP BY operation is applied to the leading part of the primary key constraint, which allows the aggregation to be done in place rather than keeping all distinct groups in memory on the server side.",{"_11692":432,"_44950":410,"_16990":87667,"_5":16526,"_23412":87609,"_7169":87668},[45444],"AGGREGATE INTO SINGLE ROW — aggregates the results into a single row using an aggregate function with no GROUP BY clause. For example, the count() statement returns one row with the total number of rows that match the query.",{"_11692":433,"_44950":410,"_16990":87670,"_5":16526,"_23412":87609,"_7169":87671},[45444],"CLIENT — the operation will be performed on the client side. It's faster to perform most operations on the server side, so you should consider whether there's a way to rewrite the query to give the server more of the work to do.",{"_11692":434,"_44950":410,"_16990":87673,"_5":16526,"_23412":87609,"_7169":87674},[45444],"FILTER BY expression—returns only results that match the expression.",{"_11692":435,"_44950":410,"_16990":87676,"_5":16526,"_23412":87609,"_7169":87677},[45444],"FULL SCAN OVER tableName—the operation will scan every row in the specified table.",{"_11692":436,"_44950":410,"_16990":87679,"_5":16526,"_23412":87609,"_7169":87680},[45444],"INNER-JOIN — the operation will join multiple tables on rows where the join condition is met.",{"_11692":437,"_44950":410,"_16990":87682,"_5":16526,"_23412":87609,"_7169":87683},[45444],"MERGE SORT — performs a merge sort on the results.",{"_11692":438,"_44950":410,"_16990":87685,"_5":16526,"_23412":87609,"_7169":87686},[45444],"RANGE SCAN OVER tableName [ ... ] — The information in the square brackets indicates the start and stop for each primary key that's used in the query.",{"_11692":439,"_44950":410,"_16990":87688,"_5":16526,"_23412":87609,"_7169":87689},[45444],"ROUND ROBIN — when the query doesn't contain ORDER BY and therefore the rows can be returned in any order, ROUND ROBIN order maximizes parallelization on the client side.",{"_11692":440,"_44950":410,"_16990":87691,"_5":16526,"_23412":87609,"_7169":87692},[45444],"<x>-CHUNK — describes how many threads will be used for the operation. The maximum parallelism is limited to the number of threads in the thread pool. The minimum parallelization corresponds to the number of regions the table has between the start and stop rows of the scan. The number of chunks will increase with a lower guidepost width, as there is more than one chunk per region.",{"_11692":441,"_44950":410,"_16990":87694,"_5":16526,"_23412":87609,"_7169":87695},[45444],"PARALLEL <x>-WAY — describes how many parallel scans will be merge sorted during the operation.",{"_11692":442,"_44950":410,"_16990":87697,"_5":16526,"_23412":87609,"_7169":87698},[45444],"SERIAL — some queries run serially. For example, a single row lookup or a query that filters on the leading part of the primary key and limits the results below a configurable threshold.",{"_11692":443,"_44950":410,"_16990":87700,"_5":16526,"_23412":87609,"_7169":87701},[45444],"EST_BYTES_READ - provides an estimate of the total number of bytes that will be scanned as part of executing the query.",{"_11692":444,"_44950":410,"_16990":87703,"_5":16526,"_23412":87609,"_7169":87704},[45444],"EST_ROWS_READ - provides an estimate of the total number of rows that will be scanned as part of executing the query.",{"_11692":445,"_44950":410,"_16990":87706,"_5":16526,"_23412":87609,"_7169":87707},[45444],"EST_INFO_TS - epoch time in milliseconds at which the estimate information was collected.",{"_11692":446,"_44950":410,"_16990":87709,"_5":16526,"_23412":87616,"_7169":87710},[45444],"The information displayed in the explain plan API can also be accessed programmatically through the standard JDBC interfaces. When statistics collection\nis enabled for a table, the explain plan also gives an estimate of number of rows and bytes a query is going to scan. To get hold of the info, you can\nuse corresponding columns in the result set returned by the explain plan statement. When stats collection is not enabled or if for some reason\nPhoenix cannot provide the estimate information, the columns return null. Below is an example:",{"_11692":447,"_44950":447,"_5":12121,"_7169":87712,"_45415":87713,"_16990":87714,"_23412":447},"FAQ",[86368,86369,86636],[45444],{"_11692":448,"_44950":447,"_16990":87716,"_5":16526,"_23412":447,"_7169":87717},[45444],"Frequently asked question about Phoenix",{"_11692":449,"_44950":447,"_5":45412,"_16990":87719,"_23412":87720,"_7169":87721},[45444],"/docs/faq#questions-answered-in-this-page","Questions answered in this page:",{"_11692":450,"_44950":447,"_5":45412,"_16990":87723,"_23412":87724,"_7169":87725},[45444],"/docs/faq#i-want-to-get-started-is-there-a-phoenix-hello-world","I want to get started. Is there a Phoenix Hello World?",{"_11692":451,"_44950":447,"_5":45412,"_16990":87727,"_23412":87728,"_7169":87729},[45444],"/docs/faq#using-console","Using console",{"_11692":452,"_44950":447,"_5":45412,"_16990":87731,"_23412":87732,"_7169":87733},[45444],"/docs/faq#using-java","Using Java",{"_11692":453,"_44950":447,"_5":45412,"_16990":87735,"_23412":87736,"_7169":87737},[45444],"/docs/faq#what-is-the-phoenix-jdbc-url-syntax","What is the Phoenix JDBC URL syntax?",{"_11692":454,"_44950":447,"_5":45412,"_16990":87739,"_23412":87740,"_7169":87741},[45444],"/docs/faq#thick-driver","Thick Driver",{"_11692":455,"_44950":447,"_5":45412,"_16990":87743,"_23412":87744,"_7169":87745},[45444],"/docs/faq#thin-driver","Thin Driver",{"_11692":456,"_44950":447,"_5":45412,"_16990":87747,"_23412":87748,"_7169":87749},[45444],"/docs/faq#is-there-a-way-to-bulk-load-in-phoenix","Is there a way to bulk load in Phoenix?",{"_11692":457,"_44950":447,"_5":45412,"_16990":87751,"_23412":87752,"_7169":87753},[45444],"/docs/faq#map-reduce","Map Reduce",{"_11692":458,"_44950":447,"_5":45412,"_16990":87755,"_23412":87756,"_7169":87757},[45444],"/docs/faq#csv","CSV",{"_11692":459,"_44950":447,"_5":45412,"_16990":87759,"_23412":87760,"_7169":87761},[45444],"/docs/faq#how-i-map-phoenix-table-to-an-existing-hbase-table","How I map Phoenix table to an existing HBase table?",{"_11692":460,"_44950":447,"_5":45412,"_16990":87763,"_23412":87764,"_7169":87765},[45444],"/docs/faq#are-there-any-tips-for-optimizing-phoenix","Are there any tips for optimizing Phoenix?",{"_11692":461,"_44950":447,"_5":45412,"_16990":87767,"_23412":87768,"_7169":87769},[45444],"/docs/faq#how-do-i-create-secondary-index-on-a-table","How do I create Secondary Index on a table?",{"_11692":462,"_44950":447,"_5":45412,"_16990":87771,"_23412":87772,"_7169":87773},[45444],"/docs/faq#why-isnt-my-secondary-index-being-used","Why isn't my secondary index being used?",{"_11692":463,"_44950":447,"_5":45412,"_16990":87775,"_23412":87776,"_7169":87777},[45444],"/docs/faq#how-fast-is-phoenix-why-is-it-so-fast","How fast is Phoenix? Why is it so fast?",{"_11692":464,"_44950":447,"_5":45412,"_16990":87779,"_23412":87780,"_7169":87781},[45444],"/docs/faq#how-do-i-connect-to-secure-hbase-cluster","How do I connect to secure HBase cluster?",{"_11692":465,"_44950":447,"_5":45412,"_16990":87783,"_23412":87784,"_7169":87785},[45444],"/docs/faq#what-hbase-and-hadoop-versions-are-supported","What HBase and Hadoop versions are supported?",{"_11692":466,"_44950":447,"_5":45412,"_16990":87787,"_23412":87788,"_7169":87789},[45444],"/docs/faq#can-phoenix-work-on-tables-with-arbitrary-timestamp-as-flexible-as-hbase-api","Can phoenix work on tables with arbitrary timestamp as flexible as HBase API?",{"_11692":467,"_44950":447,"_5":45412,"_16990":87791,"_23412":87792,"_7169":87793},[45444],"/docs/faq#why-isnt-my-query-doing-a-range-scan","Why isn't my query doing a RANGE SCAN?",{"_11692":468,"_44950":447,"_5":45412,"_16990":87795,"_23412":87796,"_7169":87797},[45444],"/docs/faq#should-i-pool-phoenix-jdbc-connections","Should I pool Phoenix JDBC Connections?",{"_11692":469,"_44950":447,"_5":45412,"_16990":87799,"_23412":87800,"_7169":87801},[45444],"/docs/faq#why-does-phoenix-add-an-emptydummy-keyvalue-when-doing-an-upsert","Why does Phoenix add an empty/dummy KeyValue when doing an upsert?",{"_11692":470,"_44950":447,"_16990":87803,"_5":16526,"_23412":87720,"_7169":87725},[45444],{"_11692":471,"_44950":447,"_16990":87805,"_5":16526,"_23412":87720,"_7169":87737},[45444],{"_11692":472,"_44950":447,"_16990":87807,"_5":16526,"_23412":87720,"_7169":87749},[45444],{"_11692":473,"_44950":447,"_16990":87809,"_5":16526,"_23412":87720,"_7169":87761},[45444],{"_11692":474,"_44950":447,"_16990":87811,"_5":16526,"_23412":87720,"_7169":87765},[45444],{"_11692":475,"_44950":447,"_16990":87813,"_5":16526,"_23412":87720,"_7169":87769},[45444],{"_11692":476,"_44950":447,"_16990":87815,"_5":16526,"_23412":87720,"_7169":87773},[45444],{"_11692":477,"_44950":447,"_16990":87817,"_5":16526,"_23412":87720,"_7169":87777},[45444],{"_11692":478,"_44950":447,"_16990":87819,"_5":16526,"_23412":87720,"_7169":87781},[45444],{"_11692":479,"_44950":447,"_16990":87821,"_5":16526,"_23412":87720,"_7169":87785},[45444],{"_11692":480,"_44950":447,"_16990":87823,"_5":16526,"_23412":87720,"_7169":87789},[45444],{"_11692":481,"_44950":447,"_16990":87825,"_5":16526,"_23412":87720,"_7169":87793},[45444],{"_11692":482,"_44950":447,"_16990":87827,"_5":16526,"_23412":87720,"_7169":87797},[45444],{"_11692":483,"_44950":447,"_16990":87829,"_5":16526,"_23412":87720,"_7169":87830},[45444],"Why does Phoenix add an empty or dummy KeyValue when doing an upsert?",{"_11692":484,"_44950":447,"_16990":87832,"_5":16526,"_23412":87724,"_7169":87833},[45444],"Pre-requisite: Download and install the latest Phoenix.",{"_11692":485,"_44950":447,"_16990":87835,"_5":16526,"_23412":87728,"_7169":87836},[45444],"Start Sqlline:",{"_11692":486,"_44950":447,"_16990":87838,"_5":16526,"_23412":87728,"_7169":87839},[45444],"Execute the following statements when Sqlline connects:",{"_11692":487,"_44950":447,"_16990":87841,"_5":16526,"_23412":87728,"_7169":87842},[45444],"You should get the following output:",{"_11692":488,"_44950":447,"_16990":87844,"_5":16526,"_23412":87732,"_7169":87845},[45444],"Create test.java file with the following content:",{"_11692":489,"_44950":447,"_16990":87847,"_5":16526,"_23412":87732,"_7169":87848},[45444],"Compile and execute on command line",{"_11692":490,"_44950":447,"_16990":87850,"_5":16526,"_23412":87732,"_7169":87851},[45444],"You should get the following output",{"_11692":491,"_44950":447,"_16990":87853,"_5":16526,"_23412":87740,"_7169":87854},[45444],"See Using the Phoenix JDBC Driver for a more up-to-date description",{"_11692":492,"_44950":447,"_16990":87856,"_5":16526,"_23412":87740,"_7169":87857},[45444],"The Phoenix (Thick) Driver JDBC URL syntax is as follows (where elements in square brackets are optional):",{"_11692":493,"_44950":447,"_16990":87859,"_5":16526,"_23412":87740,"_7169":87860},[45444],"The simplest URL is:",{"_11692":494,"_44950":447,"_16990":87862,"_5":16526,"_23412":87740,"_7169":87863},[45444],"Whereas the most complicated URL is:",{"_11692":495,"_44950":447,"_16990":87865,"_5":16526,"_23412":87740,"_7169":87866},[45444],"Please note that each optional element in the URL requires all previous optional elements. For example, to specify the\nHBase root ZNode, the ZooKeeper port must also be specified.",{"_11692":496,"_44950":447,"_16990":87868,"_5":16526,"_23412":87740,"_7169":87869},[45444],"See also Connection String.",{"_11692":497,"_44950":447,"_16990":87871,"_5":16526,"_23412":87744,"_7169":87872},[45444],"The Phoenix Thin Driver (used with the Phoenix Query Server) JDBC URL syntax is as follows:",{"_11692":498,"_44950":447,"_16990":87874,"_5":16526,"_23412":87744,"_7169":87875},[45444],"There are a number of keys exposed for client-use. The most commonly-used keys are: url and serialization. The url\nkey is required to interact with the Phoenix Query Server.",{"_11692":499,"_44950":447,"_16990":87877,"_5":16526,"_23412":87744,"_7169":87860},[45444],{"_11692":500,"_44950":447,"_16990":87879,"_5":16526,"_23412":87744,"_7169":87880},[45444],"Where as very complicated URL is:",{"_11692":501,"_44950":447,"_16990":87882,"_5":16526,"_23412":87744,"_7169":87883},[45444],"Please refer to the Apache Avatica documentation for a full list of supported options in the Thin client JDBC URL,\nor see the Query Server documentation",{"_11692":502,"_44950":447,"_16990":87885,"_5":16526,"_23412":87752,"_7169":87886},[45444],"See the example here",{"_11692":503,"_44950":447,"_16990":87888,"_5":16526,"_23412":87756,"_7169":87889},[45444],"CSV data can be bulk loaded with built in utility named psql. Typical upsert rates are 20K - 50K rows per second (depends on how wide are the rows).",{"_11692":504,"_44950":447,"_16990":87891,"_5":16526,"_23412":87756,"_7169":87892},[45444],"Usage example:",{"_11692":505,"_44950":447,"_16990":87894,"_5":16526,"_23412":87756,"_7169":87895},[45444],"Create table using psql:",{"_11692":506,"_44950":447,"_16990":87897,"_5":16526,"_23412":87756,"_7169":87898},[45444],"Upsert CSV bulk data:",{"_11692":507,"_44950":447,"_16990":87900,"_5":16526,"_23412":87760,"_7169":87901},[45444],"You can create both a Phoenix table or view through the CREATE TABLE/CREATE VIEW DDL statement on a pre-existing HBase table. In both cases, we'll leave the HBase metadata as-is. For CREATE TABLE, we'll create any metadata (table, column families) that doesn't already exist. We'll also add an empty key value for each row so that queries behave as expected (without requiring all columns to be projected during scans).",{"_11692":508,"_44950":447,"_16990":87903,"_5":16526,"_23412":87760,"_7169":87904},[45444],"The other caveat is that the way the bytes were serialized must match the way the bytes are serialized by Phoenix. For VARCHAR, CHAR, and UNSIGNED_* types, we use the HBase Bytes methods. The CHAR type expects only single-byte characters and the UNSIGNED types expect values greater than or equal to zero. For signed types (TINYINT, SMALLINT, INTEGER and BIGINT), Phoenix will flip the first bit so that negative values will sort before positive values. Because HBase sorts row keys in lexicographical order and negative value's first bit is 1 while positive 0 so that negative value is 'greater than' positive value if we don't flip the first bit. So if you stored integers by HBase native API and want to access them by Phoenix, make sure that all your data types are UNSIGNED types.",{"_11692":509,"_44950":447,"_16990":87906,"_5":16526,"_23412":87760,"_7169":87907},[45444],"Our composite row keys are formed by simply concatenating the values together, with a zero byte character used as a separator after a variable length type.",{"_11692":510,"_44950":447,"_16990":87909,"_5":16526,"_23412":87760,"_7169":87910},[45444],"If you create an HBase table like this:",{"_11692":511,"_44950":447,"_16990":87912,"_5":16526,"_23412":87760,"_7169":87913},[45444],"then you have an HBase table with a name of t1 and a column family with a name of f1. Remember, in HBase, you don't model the possible KeyValues or the structure of the row key. This is the information you specify in Phoenix above and beyond the table and column family.",{"_11692":512,"_44950":447,"_16990":87915,"_5":16526,"_23412":87760,"_7169":87916},[45444],"So in Phoenix, you'd create a view like this:",{"_11692":513,"_44950":447,"_16990":87918,"_5":16526,"_23412":87760,"_7169":87919},[45444],"The pk column declares that your row key is a VARCHAR (i.e. a string) while the \"f1\".val column declares that your HBase table will contain KeyValues with a column family and column qualifier of \"f1\":VAL and that their value will be a VARCHAR.",{"_11692":514,"_44950":447,"_16990":87921,"_5":16526,"_23412":87760,"_7169":87922},[45444],"Note that you don't need the double quotes if you create your HBase table with all caps names (since this is how Phoenix normalizes strings, by upper casing them). For example, with:",{"_11692":515,"_44950":447,"_16990":87924,"_5":16526,"_23412":87760,"_7169":87925},[45444],"you could create this Phoenix view:",{"_11692":516,"_44950":447,"_16990":87927,"_5":16526,"_23412":87760,"_7169":87928},[45444],"Or if you're creating new HBase tables, just let Phoenix do everything for you like this (No need to use the HBase shell at all.):",{"_11692":517,"_44950":447,"_16990":87930,"_5":16526,"_23412":87764,"_7169":87931},[45444],"Use Salting to increase read/write performanceSalting can significantly increase read/write performance by pre-splitting the data into multiple regions. Although Salting will yield better performance in most scenarios.Example:",{"_11692":518,"_44950":447,"_16990":87933,"_5":16526,"_23412":87764,"_7169":87934},[45444],"Note: Ideally for a 16 region server cluster with quad-core CPUs, choose salt buckets between 32-64 for optimal performance.",{"_11692":519,"_44950":447,"_16990":87936,"_5":16526,"_23412":87764,"_7169":87937},[45444],"Pre-split tableSalting does automatic table splitting but in case you want to exactly control where table split occurs with out adding extra byte or change row key order then you can pre-split a table.Example:",{"_11692":520,"_44950":447,"_16990":87939,"_5":16526,"_23412":87764,"_7169":87940},[45444],"Use multiple column familiesColumn family contains related data in separate files. If you query use selected columns then it make sense to group those columns together in a column family to improve read performance.Example:Following create table DDL will create two column faimiles A and B.",{"_11692":521,"_44950":447,"_16990":87942,"_5":16526,"_23412":87764,"_7169":87943},[45444],"Use compressionOn disk compression improves performance on large tablesExample:",{"_11692":522,"_44950":447,"_16990":87945,"_5":16526,"_23412":87764,"_7169":87946},[45444],"Create indexes\nSee How do I connect to secure HBase cluster?",{"_11692":523,"_44950":447,"_16990":87948,"_5":16526,"_23412":87764,"_7169":87949},[45444],"Optimize cluster parameters\nSee https://hbase.apache.org/docs/performance",{"_11692":524,"_44950":447,"_16990":87951,"_5":16526,"_23412":87764,"_7169":87952},[45444],"Optimize Phoenix parameters\nSee Configuration",{"_11692":525,"_44950":447,"_16990":87954,"_5":16526,"_23412":87768,"_7169":87955},[45444],"Starting with Phoenix version 2.1, Phoenix supports index over mutable and immutable data. Note that Phoenix 2.0.x only supports Index over immutable data. Index write performance index with immutable table is slightly faster than mutable table however data in immutable table cannot be updated.",{"_11692":526,"_44950":447,"_16990":87957,"_5":16526,"_23412":87768,"_7169":87958},[45444],"Example:",{"_11692":527,"_44950":447,"_16990":87960,"_5":16526,"_23412":87768,"_7169":87961},[45444],"Create tableImmutable table: create table test (mykey varchar primary key, col1 varchar, col2 varchar) IMMUTABLE_ROWS=true;Mutable table: create table test (mykey varchar primary key, col1 varchar, col2 varchar);",{"_11692":528,"_44950":447,"_16990":87963,"_5":16526,"_23412":87768,"_7169":87964},[45444],"Creating index on col2create index idx on test (col2)",{"_11692":529,"_44950":447,"_16990":87966,"_5":16526,"_23412":87768,"_7169":87967},[45444],"Creating index on col1 and a covered index on col2create index idx on test (col1) include (col2)Upsert rows in this test table and Phoenix query optimizer will choose correct index to use. You can see in explain plan if Phoenix is using the index table. You can also give a hint in Phoenix query to use a specific index.",{"_11692":530,"_44950":447,"_16990":87969,"_5":16526,"_23412":87768,"_7169":87970},[45444],"See Secondary Indexing for further information",{"_11692":531,"_44950":447,"_16990":87972,"_5":16526,"_23412":87772,"_7169":87973},[45444],"The secondary index won't be used unless all columns used in the query are in it ( as indexed or covered columns). All columns making up the primary key of the data table will automatically be included in the index.",{"_11692":532,"_44950":447,"_16990":87975,"_5":16526,"_23412":87772,"_7169":87976},[45444],"Example: DDL create table usertable (id varchar primary key, firstname varchar, lastname varchar); create index idx_name on usertable (firstname);",{"_11692":533,"_44950":447,"_16990":87978,"_5":16526,"_23412":87772,"_7169":87979},[45444],"Query: DDL select id, firstname, lastname from usertable where firstname = 'foo';",{"_11692":534,"_44950":447,"_16990":87981,"_5":16526,"_23412":87772,"_7169":87982},[45444],"Index would not be used in this case as lastname is not part of indexed or covered column. This can be verified by looking at the explain plan. To fix this create index that has either lastname part of index or covered column. Example: create idx_name on usertable (firstname) include (lastname);",{"_11692":535,"_44950":447,"_16990":87984,"_5":16526,"_23412":87772,"_7169":87985},[45444],"You can force Phoenix to use secondary for uncovered columns by specifying an index hint",{"_11692":536,"_44950":447,"_16990":87987,"_5":16526,"_23412":87776,"_7169":87988},[45444],"Phoenix is fast. Full table scan of 100M rows usually completes in 20 seconds (narrow table on a medium sized cluster). This time come down to few milliseconds if query contains filter on key columns. For filters on non-key columns or non-leading key columns, you can add index on these columns which leads to performance equivalent to filtering on key column by making copy of table with indexed column(s) part of key.",{"_11692":537,"_44950":447,"_16990":87990,"_5":16526,"_23412":87776,"_7169":87991},[45444],"Why is Phoenix fast even when doing full scan:",{"_11692":538,"_44950":447,"_16990":87993,"_5":16526,"_23412":87776,"_7169":87994},[45444],"Phoenix chunks up your query using the region boundaries and runs them in parallel on the client using a configurable number of threads.",{"_11692":539,"_44950":447,"_16990":87996,"_5":16526,"_23412":87776,"_7169":87997},[45444],"The aggregation will be done in a coprocessor on the server-side, collapsing the amount of data that gets returned back to the client rather than returning it all.",{"_11692":540,"_44950":447,"_16990":87999,"_5":16526,"_23412":87780,"_7169":88000},[45444],"Specify the principal and corresponding keytab in the JDBC URL as show above.\nFor ancient Phoenix versions heck out the excellent post by Anil Gupta",{"_11692":541,"_44950":447,"_16990":88002,"_5":16526,"_23412":87784,"_7169":88003},[45444],"Phoenix 4.x supports HBase 1.x running on Hadoop 2",{"_11692":542,"_44950":447,"_16990":88005,"_5":16526,"_23412":87784,"_7169":88006},[45444],"Phoenix 5.x supports HBase 2.x running on Hadoop 3",{"_11692":543,"_44950":447,"_16990":88008,"_5":16526,"_23412":87784,"_7169":88009},[45444],"See the release notes and BUILDING in recent releases for the exact versions supported,\nand on how to build Phoenix for specific HBase and Hadoop versions",{"_11692":544,"_44950":447,"_16990":88011,"_5":16526,"_23412":87788,"_7169":88012},[45444],"By default, Phoenix lets HBase manage the timestamps and just shows you the latest values for everything. However, Phoenix also allows arbitrary timestamps to be supplied by the user. To do that you'd specify a CurrentSCN at connection time, like this:",{"_11692":545,"_44950":447,"_16990":88014,"_5":16526,"_23412":87788,"_7169":88015},[45444],"The above is equivalent to doing this with the HBase API:",{"_11692":546,"_44950":447,"_16990":88017,"_5":16526,"_23412":87788,"_7169":88018},[45444],"By specifying a CurrentSCN, you're telling Phoenix that you want everything for that connection to be done at that timestamp. Note that this applies to queries done on the connection as well - for example, a query over myTable above would not see the data it just upserted, since it only sees data that was created before its CurrentSCN property. This provides a way of doing snapshot, flashback, or point-in-time queries.",{"_11692":547,"_44950":447,"_16990":88020,"_5":16526,"_23412":87788,"_7169":88021},[45444],"Keep in mind that creating a new connection is not an expensive operation. The same underlying HConnection is used for all connections to the same cluster, so it's more or less like instantiating a few objects.",{"_11692":548,"_44950":447,"_16990":88023,"_5":16526,"_23412":87792,"_7169":88024},[45444],"RANGE SCAN means that only a subset of the rows in your table will be scanned over. This occurs if you use one or more leading columns from your primary key constraint. Query that is not filtering on leading PK columns ex. select * from test where pk2='x' and pk3='y'; will result in full scan whereas the following query will result in range scan select * from test where pk1='x' and pk2='y';. Note that you can add a secondary index on your pk2 and pk3 columns and that would cause a range scan to be done for the first query (over the index table).",{"_11692":549,"_44950":447,"_16990":88026,"_5":16526,"_23412":87792,"_7169":88027},[45444],"DEGENERATE SCAN means that a query can't possibly return any rows. If we can determine that at compile time, then we don't bother to even run the scan.",{"_11692":550,"_44950":447,"_16990":88029,"_5":16526,"_23412":87792,"_7169":88030},[45444],"FULL SCAN means that all rows of the table will be scanned over (potentially with a filter applied if you have a WHERE clause)",{"_11692":551,"_44950":447,"_16990":88032,"_5":16526,"_23412":87792,"_7169":88033},[45444],"SKIP SCAN means that either a subset or all rows in your table will be scanned over, however it will skip large groups of rows depending on the conditions in your filter. See this blog for more detail. We don't do a SKIP SCAN if you have no filter on the leading primary key columns, but you can force a SKIP SCAN by using the /*+ SKIP_SCAN */ hint. Under some conditions, namely when the cardinality of your leading primary key columns is low, it will be more efficient than a FULL SCAN.",{"_11692":552,"_44950":447,"_16990":88035,"_5":16526,"_23412":87796,"_7169":88036},[45444],"No, it is not necessary to pool Phoenix JDBC Connections.",{"_11692":553,"_44950":447,"_16990":88038,"_5":16526,"_23412":87796,"_7169":88039},[45444],"Phoenix's Connection objects are different from most other JDBC Connections due to the underlying HBase connection. The Phoenix Connection object is designed to be a thin object that is inexpensive to create. If Phoenix Connections are reused, it is possible that the underlying HBase connection is not always left in a healthy state by the previous user. It is better to create new Phoenix Connections to ensure that you avoid any potential issues.",{"_11692":554,"_44950":447,"_16990":88041,"_5":16526,"_23412":87796,"_7169":88042},[45444],"Implementing pooling for Phoenix could be done simply by creating a delegate Connection that instantiates a new Phoenix connection when retrieved from the pool and then closes the connection when returning it to the pool (see PHOENIX-2388).",{"_11692":555,"_44950":447,"_16990":88044,"_5":16526,"_23412":87800,"_7169":88045},[45444],"The empty or dummy KeyValue (with a column qualifier of _0) is needed to ensure that a given column is available\nfor all rows.",{"_11692":556,"_44950":447,"_16990":88047,"_5":16526,"_23412":87800,"_7169":88048},[45444],"As you may know, data is stored in HBase as KeyValues, meaning that\nthe full row key is stored for each column value. This also implies\nthat the row key is not stored at all unless there is at least one\ncolumn stored.",{"_11692":557,"_44950":447,"_16990":88050,"_5":16526,"_23412":87800,"_7169":88051},[45444],"Now consider JDBC row which has an integer primary key, and several\ncolumns which are all null. In order to be able to store the primary\nkey, a KeyValue needs to be stored to show that the row is present at\nall. This column is represented by the empty column that you've\nnoticed. This allows doing a SELECT * FROM TABLE and receiving\nrecords for all rows, even those whose non-pk columns are null.",{"_11692":558,"_44950":447,"_16990":88053,"_5":16526,"_23412":87800,"_7169":88054},[45444],"The same issue comes up even if only one column is null for some (or\nall) records. A scan over Phoenix will include the empty column to\nensure that rows that only consist of the primary key (and have null\nfor all non-key columns) will be included in a scan result.",{"_11692":559,"_44950":559,"_5":12121,"_7169":88056,"_45415":88057,"_16990":88059,"_23412":559},"Atomic Upsert",[86368,86369,86370,88058],"Features",[45444],{"_11692":560,"_44950":559,"_16990":88061,"_5":16526,"_23412":559,"_7169":88062},[45444],"Use UPSERT ... ON DUPLICATE KEY for atomic row-level updates in Phoenix, with examples and limitations.",{"_11692":561,"_44950":559,"_5":45412,"_16990":88064,"_23412":88065,"_7169":88066},[45444],"/docs/features/atomic-upsert#atomic-upsert-examples","Examples",{"_11692":562,"_44950":559,"_5":45412,"_16990":88068,"_23412":88069,"_7169":88070},[45444],"/docs/features/atomic-upsert#atomic-upsert-update-only","ON DUPLICATE KEY UPDATE_ONLY",{"_11692":563,"_44950":559,"_5":45412,"_16990":88072,"_23412":88073,"_7169":88074},[45444],"/docs/features/atomic-upsert#atomic-upsert-returning","Returning the affected row",{"_11692":564,"_44950":559,"_5":45412,"_16990":88076,"_23412":88077,"_7169":86490},[45444],"/docs/features/atomic-upsert#atomic-upsert-limitations",{"_11692":565,"_44950":559,"_16990":88079,"_5":16526,"_23412":559,"_7169":88080},[45444],"To support atomic upsert, an optional ON DUPLICATE KEY clause, similar to the MySQL syntax, has been\nincorporated into the UPSERT VALUES command as of Phoenix 4.9. The general syntax is described\nhere. This feature provides a superset of the HBase Increment and\nCheckAndPut functionality to enable atomic upserts. On the server-side, when the commit\nis processed, the row being updated will be locked while the current column values are read and the\nON DUPLICATE KEY clause is executed. Given that the row must be locked and read when the ON DUPLICATE KEY\nclause is used, there will be a performance penalty (much like there is for an HBase Put versus a CheckAndPut).",{"_11692":566,"_44950":559,"_16990":88082,"_5":16526,"_23412":559,"_7169":88083},[45444],"In the presence of the ON DUPLICATE KEY clause, if the row already exists, the VALUES specified will\nbe ignored and instead either:",{"_11692":567,"_44950":559,"_16990":88085,"_5":16526,"_23412":559,"_7169":88086},[45444],"the row will not be updated if ON DUPLICATE KEY IGNORE is specified or",{"_11692":568,"_44950":559,"_16990":88088,"_5":16526,"_23412":559,"_7169":88089},[45444],"the row will be updated (under lock) by executing the expressions following the ON DUPLICATE KEY UPDATE\nclause.",{"_11692":569,"_44950":559,"_16990":88091,"_5":16526,"_23412":559,"_7169":88092},[45444],"Multiple UPSERT statements for the same row in the same commit batch will be processed in the order of their\nexecution. Thus the same result will be produced when auto commit is on or off.",{"_11692":570,"_44950":559,"_16990":88094,"_5":16526,"_23412":88065,"_7169":88095},[45444],"For example, to atomically increment two counter columns, you would execute the following command:",{"_11692":571,"_44950":559,"_16990":88097,"_5":16526,"_23412":88065,"_7169":88098},[45444],"To only update a column if it doesn't yet exist:",{"_11692":572,"_44950":559,"_16990":88100,"_5":16526,"_23412":88065,"_7169":88101},[45444],"Note that arbitrarily complex expressions may be used in this new clause:",{"_11692":573,"_44950":559,"_16990":88103,"_5":16526,"_23412":88069,"_7169":88104},[45444],"UPDATE_ONLY is a third variant of the ON DUPLICATE KEY clause, available from\nPhoenix 5.3.0 (PHOENIX-7648).\nUnlike UPDATE, the VALUES are not inserted when the row is missing — the\nstatement is a no-op in that case. Use it when an UPSERT should behave purely as a\nconditional in-place update.",{"_11692":574,"_44950":559,"_16990":88106,"_5":16526,"_23412":88069,"_7169":88107},[45444],"If id = 'sku-42' already exists, its qty is decremented under the row lock.\nIf it doesn't, the supplied VALUES are discarded and nothing is written.",{"_11692":575,"_44950":559,"_16990":88109,"_5":16526,"_23412":88069,"_7169":88110},[45444],"The three forms compared:",{"_11692":576,"_44950":559,"_16990":88112,"_5":16526,"_23412":88069,"_7169":88113},[45444],"Clause",{"_11692":577,"_44950":559,"_16990":88115,"_5":16526,"_23412":88069,"_7169":88116},[45444],"Row missing",{"_11692":578,"_44950":559,"_16990":88118,"_5":16526,"_23412":88069,"_7169":88119},[45444],"Row present",{"_11692":579,"_44950":559,"_16990":88121,"_5":16526,"_23412":88069,"_7169":88122},[45444],"ON DUPLICATE KEY IGNORE",{"_11692":580,"_44950":559,"_16990":88124,"_5":16526,"_23412":88069,"_7169":88125},[45444],"Insert from VALUES",{"_11692":581,"_44950":559,"_16990":88127,"_5":16526,"_23412":88069,"_7169":88128},[45444],"No-op",{"_11692":582,"_44950":559,"_16990":88130,"_5":16526,"_23412":88069,"_7169":88131},[45444],"ON DUPLICATE KEY UPDATE ...",{"_11692":583,"_44950":559,"_16990":88133,"_5":16526,"_23412":88069,"_7169":88125},[45444],{"_11692":584,"_44950":559,"_16990":88135,"_5":16526,"_23412":88069,"_7169":88136},[45444],"Run the update",{"_11692":585,"_44950":559,"_16990":88138,"_5":16526,"_23412":88069,"_7169":88139},[45444],"ON DUPLICATE KEY UPDATE_ONLY ...",{"_11692":586,"_44950":559,"_16990":88141,"_5":16526,"_23412":88069,"_7169":88142},[45444],"No-op (VALUES discarded)",{"_11692":587,"_44950":559,"_16990":88144,"_5":16526,"_23412":88069,"_7169":88136},[45444],{"_11692":588,"_44950":559,"_16990":88146,"_5":16526,"_23412":88073,"_7169":88147},[45444],"A single-row UPSERT or DELETE can append RETURNING * to return the affected row\nas a JDBC ResultSet in the same round-trip, available from Phoenix 5.3.0\n(PHOENIX-7651). The returned\nrow reflects the server-side state after the mutation — including any values\ncomputed by an ON DUPLICATE KEY UPDATE clause under the row lock.",{"_11692":589,"_44950":559,"_16990":88149,"_5":16526,"_23412":88073,"_7169":88150},[45444],"This collapses two common patterns into one round-trip:",{"_11692":590,"_44950":559,"_16990":88152,"_5":16526,"_23412":88073,"_7169":88153},[45444],"Atomic read-modify-write counters — increment, then read the new value\nwithout a follow-up SELECT (and without risking a different writer slipping in\nbetween).",{"_11692":591,"_44950":559,"_16990":88155,"_5":16526,"_23412":88073,"_7169":88156},[45444],"Tombstoning / queue consumers — atomically delete a row and read the payload\nyou just removed, useful for idempotent replay and \"claim the next task\" patterns.",{"_11692":592,"_44950":559,"_16990":88158,"_5":16526,"_23412":88073,"_7169":88159},[45444],"The statement must affect a single row when RETURNING * is used. Drivers iterate\nthe returned ResultSet exactly like the result of a regular SELECT.",{"_11692":593,"_44950":559,"_16990":88161,"_5":16526,"_23412":88077,"_7169":88162},[45444],"The following limitations are enforced for the ON DUPLICATE KEY clause usage:",{"_11692":594,"_44950":559,"_16990":88164,"_5":16526,"_23412":88077,"_7169":88165},[45444],"Primary key columns may not be updated, since this would essentially be creating a new row.",{"_11692":595,"_44950":559,"_16990":88167,"_5":16526,"_23412":88077,"_7169":88168},[45444],"Transactional tables may not use this clause as atomic upserts are already possible through\nexception handling when a conflict occurs.",{"_11692":596,"_44950":559,"_16990":88170,"_5":16526,"_23412":88077,"_7169":88171},[45444],"Immutable tables may not use this clause as by definition there should be no updates to\nexisting rows.",{"_11692":597,"_44950":559,"_16990":88173,"_5":16526,"_23412":88077,"_7169":88174},[45444],"The CURRENT_SCN property may not be set on connection when this clause is used as HBase\ndoes not handle atomicity unless the latest value is being updated.",{"_11692":598,"_44950":559,"_16990":88176,"_5":16526,"_23412":88077,"_7169":88177},[45444],"The same column should not be updated more than once in the same statement.",{"_11692":599,"_44950":559,"_16990":88179,"_5":16526,"_23412":88077,"_7169":88180},[45444],"No aggregation or references to sequences are allowed within the clause.",{"_11692":600,"_44950":559,"_16990":88182,"_5":16526,"_23412":88077,"_7169":88183},[45444],"Global indexes on columns being atomically updated are not supported, as potentially a separate RPC across the wire would be made while the row is under lock to maintain the secondary index.",{"_11692":601,"_44950":601,"_5":12121,"_7169":88185,"_45415":88186,"_16990":88187,"_23412":601},"Document Data: BSON",[86368,86369,86370,88058],[45444],{"_11692":602,"_44950":601,"_16990":88189,"_5":16526,"_23412":601,"_7169":88190},[45444],"Store, query, filter, and atomically update Binary JSON (BSON) documents inside a Phoenix table — without round-tripping the document to the client.",{"_11692":603,"_44950":601,"_5":45412,"_16990":88192,"_23412":88193,"_7169":88194},[45444],"/docs/features/bson#bson-when","When to reach for BSON",{"_11692":604,"_44950":601,"_5":45412,"_16990":88196,"_23412":88197,"_7169":88198},[45444],"/docs/features/bson#bson-defining","Defining a BSON column",{"_11692":605,"_44950":601,"_5":45412,"_16990":88200,"_23412":88201,"_7169":88202},[45444],"/docs/features/bson#bson-paths","Field paths",{"_11692":606,"_44950":601,"_5":45412,"_16990":88204,"_23412":88205,"_7169":88206},[45444],"/docs/features/bson#bson-value","Reading fields: BSON_VALUE",{"_11692":607,"_44950":601,"_5":45412,"_16990":88208,"_23412":88209,"_7169":88210},[45444],"/docs/features/bson#bson-condition-expression","Filtering rows: BSON_CONDITION_EXPRESSION",{"_11692":608,"_44950":601,"_5":45412,"_16990":88212,"_23412":88213,"_7169":88214},[45444],"/docs/features/bson#bson-update-expression","Atomically updating fields: BSON_UPDATE_EXPRESSION",{"_11692":609,"_44950":601,"_5":45412,"_16990":88216,"_23412":88217,"_7169":88218},[45444],"/docs/features/bson#bson-indexing","Indexing individual fields",{"_11692":610,"_44950":601,"_5":45412,"_16990":88220,"_23412":88221,"_7169":88222},[45444],"/docs/features/bson#bson-end-to-end","End-to-end example",{"_11692":611,"_44950":601,"_5":45412,"_16990":88224,"_23412":88225,"_7169":86490},[45444],"/docs/features/bson#bson-limitations",{"_11692":612,"_44950":601,"_16990":88227,"_5":16526,"_23412":601,"_7169":88228},[45444],"BSON is a native column type for storing schemaless document data alongside your\nrelational columns. Documents are stored in Binary JSON — a\ncompact, length-prefixed format that is cheap to parse server-side and supports the\nfull set of value types (strings, numbers, dates, binary, booleans, nulls, arrays,\nnested objects). Introduced in Phoenix 5.3.0\n(PHOENIX-7330).",{"_11692":613,"_44950":601,"_16990":88230,"_5":16526,"_23412":601,"_7169":88231},[45444],"The point of the type is not just to hold documents — it's that Phoenix can read,\nfilter, and mutate individual fields on the server without the client ever\ndeserializing the whole document.",{"_11692":614,"_44950":601,"_16990":88233,"_5":16526,"_23412":88193,"_7169":88234},[45444],"Use case",{"_11692":615,"_44950":601,"_16990":88236,"_5":16526,"_23412":88193,"_7169":88237},[45444],"Recommended type",{"_11692":616,"_44950":601,"_16990":88239,"_5":16526,"_23412":88193,"_7169":88240},[45444],"Schema is well-known and stable",{"_11692":617,"_44950":601,"_16990":88242,"_5":16526,"_23412":88193,"_7169":88243},[45444],"Regular relational columns",{"_11692":618,"_44950":601,"_16990":88245,"_5":16526,"_23412":88193,"_7169":88246},[45444],"A few optional/sparse fields on otherwise relational rows",{"_11692":619,"_44950":601,"_16990":88248,"_5":16526,"_23412":88193,"_7169":88249},[45444],"Dynamic Columns",{"_11692":620,"_44950":601,"_16990":88251,"_5":16526,"_23412":88193,"_7169":88252},[45444],"Variable-shape documents per row, server-side reads/filters/updates needed",{"_11692":621,"_44950":601,"_16990":88254,"_5":16526,"_23412":88193,"_7169":88255},[45444],"BSON",{"_11692":622,"_44950":601,"_16990":88257,"_5":16526,"_23412":88193,"_7169":88258},[45444],"Variable-shape documents but the server never inspects them",{"_11692":623,"_44950":601,"_16990":88260,"_5":16526,"_23412":88193,"_7169":88261},[45444],"VARCHAR (raw JSON) or VARBINARY",{"_11692":624,"_44950":601,"_16990":88263,"_5":16526,"_23412":88193,"_7169":88264},[45444],"Common cases for BSON:",{"_11692":625,"_44950":601,"_16990":88266,"_5":16526,"_23412":88193,"_7169":88267},[45444],"DynamoDB-style application objects backed by Phoenix.",{"_11692":626,"_44950":601,"_16990":88269,"_5":16526,"_23412":88193,"_7169":88270},[45444],"Customer / configuration / preferences documents that vary per row.",{"_11692":627,"_44950":601,"_16990":88272,"_5":16526,"_23412":88193,"_7169":88273},[45444],"Event payloads where downstream queries need to filter or project specific fields.",{"_11692":628,"_44950":601,"_16990":88275,"_5":16526,"_23412":88193,"_7169":88276},[45444],"Counters and per-field updates that must be atomic without rewriting the whole row.",{"_11692":629,"_44950":601,"_16990":88278,"_5":16526,"_23412":88197,"_7169":88279},[45444],"You may pass a JSON string literal as shown — Phoenix parses and converts it to BSON on\nwrite — or bind a pre-built BSON document via JDBC.",{"_11692":630,"_44950":601,"_16990":88281,"_5":16526,"_23412":88197,"_7169":88282},[45444],"A BSON column may also serve as a primary-key column. In a composite primary key it\nmust be the last column of the key (so the row-key encoding stays bounded for the\npreceding columns).",{"_11692":631,"_44950":601,"_16990":88284,"_5":16526,"_23412":88201,"_7169":88285},[45444],"All three BSON functions address fields with a small path syntax:",{"_11692":632,"_44950":601,"_16990":88287,"_5":16526,"_23412":88201,"_7169":88288},[45444],"name — top-level field",{"_11692":633,"_44950":601,"_16990":88290,"_5":16526,"_23412":88201,"_7169":88291},[45444],"addresses[0] — first element of an array",{"_11692":634,"_44950":601,"_16990":88293,"_5":16526,"_23412":88201,"_7169":88294},[45444],"addresses[0].city — nested field",{"_11692":635,"_44950":601,"_16990":88296,"_5":16526,"_23412":88201,"_7169":88297},[45444],"preferences.theme — nested field on a sub-document",{"_11692":636,"_44950":601,"_16990":88299,"_5":16526,"_23412":88205,"_7169":88300},[45444],"BSON_VALUE(bson_column, field_path, target_type [, default]) projects a single field\nout of a document and returns it as the requested Phoenix data type. Returns NULL if\nthe path is missing — or the supplied default if you provide one.",{"_11692":637,"_44950":601,"_16990":88302,"_5":16526,"_23412":88205,"_7169":88303},[45444],"BSON_VALUE can also return a sub-document (use 'BSON' as the target type) and\nreturn raw binary fields as VARBINARY_ENCODED. A companion function\nBSON_VALUE_TYPE(bson_column, field_path) returns the BSON type of the field as a\nstring (e.g. 'STRING', 'INT32', 'DOCUMENT', 'ARRAY').",{"_11692":638,"_44950":601,"_16990":88305,"_5":16526,"_23412":88209,"_7169":88306},[45444],"BSON_CONDITION_EXPRESSION(bson_column, expression) evaluates a boolean expression\nover a document and returns TRUE or FALSE. Use it in a WHERE clause when you\nwant to filter on multiple document fields at once, or test for the existence/shape\nof fields, without the verbosity of stacking multiple BSON_VALUE calls.",{"_11692":639,"_44950":601,"_16990":88308,"_5":16526,"_23412":88209,"_7169":88309},[45444],"The expression language is intentionally small and DynamoDB-flavored:",{"_11692":640,"_44950":601,"_16990":88311,"_5":16526,"_23412":88209,"_7169":88312},[45444],"Comparisons: =, <> (or !=), <, <=, >, >=",{"_11692":641,"_44950":601,"_16990":88314,"_5":16526,"_23412":88209,"_7169":88315},[45444],"Boolean composition: AND, OR, NOT, parentheses",{"_11692":642,"_44950":601,"_16990":88317,"_5":16526,"_23412":88209,"_7169":88318},[45444],"Ranges and sets: BETWEEN ... AND ..., IN (...), IS NULL",{"_11692":643,"_44950":601,"_16990":88320,"_5":16526,"_23412":88209,"_7169":88321},[45444],"Field presence: field_exists(name), field_not_exists(name)",{"_11692":644,"_44950":601,"_16990":88323,"_5":16526,"_23412":88209,"_7169":88324},[45444],"String/array helpers: begins_with(field, value), contains(field, value)",{"_11692":645,"_44950":601,"_16990":88326,"_5":16526,"_23412":88209,"_7169":88327},[45444],"Type and size: field_type(field, 'STRING' | 'NUMBER' | ...), size(field)",{"_11692":646,"_44950":601,"_16990":88329,"_5":16526,"_23412":88209,"_7169":88330},[45444],"The expression is evaluated server-side, so rows are filtered before they cross the\nnetwork.",{"_11692":647,"_44950":601,"_16990":88332,"_5":16526,"_23412":88213,"_7169":88333},[45444],"BSON_UPDATE_EXPRESSION(bson_column, expression) returns a new BSON document with\nthe requested mutations applied. The intended use is inside an\natomic upsert so an entire family of per-field updates\nruns under the row lock in a single round-trip:",{"_11692":648,"_44950":601,"_16990":88335,"_5":16526,"_23412":88213,"_7169":88336},[45444],"Supported update verbs follow the DynamoDB convention:",{"_11692":649,"_44950":601,"_16990":88338,"_5":16526,"_23412":88213,"_7169":88339},[45444],"SET path = value — write a field (or nested path).",{"_11692":650,"_44950":601,"_16990":88341,"_5":16526,"_23412":88213,"_7169":88342},[45444],"REMOVE path[, path ...] — delete a field.",{"_11692":651,"_44950":601,"_16990":88344,"_5":16526,"_23412":88213,"_7169":88345},[45444],"ADD path number — atomic numeric increment / decrement on a single field.",{"_11692":652,"_44950":601,"_16990":88347,"_5":16526,"_23412":88213,"_7169":88348},[45444],"DELETE path value — remove a value from an array/set field.",{"_11692":653,"_44950":601,"_16990":88350,"_5":16526,"_23412":88213,"_7169":88351},[45444],"if_not_exists(path, default) — read-then-write helper for conditional defaults.",{"_11692":654,"_44950":601,"_16990":88353,"_5":16526,"_23412":88213,"_7169":88354},[45444],"Because the update runs on the server under the row lock, this is the right primitive\nfor things like per-document counters, idempotent flag flips, and DynamoDB-style\nconditional writes (combine with BSON_CONDITION_EXPRESSION in a WHERE clause).",{"_11692":655,"_44950":601,"_16990":88356,"_5":16526,"_23412":88217,"_7169":88357},[45444],"To make a BSON-field filter fast, create a functional index on the projection:",{"_11692":656,"_44950":601,"_16990":88359,"_5":16526,"_23412":88217,"_7169":88360},[45444],"Combine with INCLUDE (...) to cover other projected columns, or rely on\nuncovered indexes when you only\nfilter on the indexed field.",{"_11692":657,"_44950":601,"_16990":88362,"_5":16526,"_23412":88221,"_7169":88363},[45444],"Putting the pieces together — a customer-preferences scenario backed entirely by a\nsingle BSON column:",{"_11692":658,"_44950":601,"_16990":88365,"_5":16526,"_23412":88225,"_7169":88366},[45444],"A BSON column in a composite primary key must be the last PK column.",{"_11692":659,"_44950":601,"_16990":88368,"_5":16526,"_23412":88225,"_7169":88369},[45444],"The condition/update expression language is intentionally a small document-focused\nDSL, not full SQL. Combine it with regular SQL predicates on relational columns when\nyou need joins, aggregations, or expressions across multiple rows.",{"_11692":660,"_44950":601,"_16990":88371,"_5":16526,"_23412":88225,"_7169":88372},[45444],"Functional indexes on BSON_VALUE(...) are scoped to one specific path/type pair —\nyou'll typically want an index per hot field rather than a generic \"BSON index\".",{"_11692":661,"_44950":661,"_5":12121,"_7169":88374,"_45415":88375,"_16990":88376,"_23412":661},"Bulk Loading",[86368,86369,86370,88058],[45444],{"_11692":662,"_44950":661,"_16990":88378,"_5":16526,"_23412":661,"_7169":88379},[45444],"Load Phoenix tables with PSQL and MapReduce-based CSV/JSON bulk loaders, including options, permissions, and tuning notes.",{"_11692":663,"_44950":661,"_5":45412,"_16990":88381,"_23412":88382,"_7169":88383},[45444],"/docs/features/bulk-loading#sample-data","Sample data",{"_11692":664,"_44950":661,"_5":45412,"_16990":88385,"_23412":88386,"_7169":88387},[45444],"/docs/features/bulk-loading#loading-via-psql","Loading via PSQL",{"_11692":665,"_44950":661,"_5":45412,"_16990":88389,"_23412":88390,"_7169":88391},[45444],"/docs/features/bulk-loading#loading-via-mapreduce","Loading via MapReduce",{"_11692":666,"_44950":661,"_5":45412,"_16990":88393,"_23412":88394,"_7169":88395},[45444],"/docs/features/bulk-loading#notes-on-the-mapreduce-importer","Notes on the MapReduce importer",{"_11692":667,"_44950":661,"_5":45412,"_16990":88397,"_23412":88398,"_7169":88399},[45444],"/docs/features/bulk-loading#permission-issues-when-uploading-hfiles","Permission issues when uploading HFiles",{"_11692":668,"_44950":661,"_5":45412,"_16990":88401,"_23412":88402,"_7169":88403},[45444],"/docs/features/bulk-loading#loading-array-data","Loading array data",{"_11692":669,"_44950":661,"_5":45412,"_16990":88405,"_23412":88406,"_7169":88407},[45444],"/docs/features/bulk-loading#a-note-on-separator-characters","A note on separator characters",{"_11692":670,"_44950":661,"_5":45412,"_16990":88409,"_23412":88410,"_7169":88411},[45444],"/docs/features/bulk-loading#a-note-on-lowercase-tableschema-names","A note on lowercase table/schema names",{"_11692":671,"_44950":661,"_16990":88413,"_5":16526,"_23412":661,"_7169":88414},[45444],"Phoenix provides two methods for bulk loading data into Phoenix tables:",{"_11692":672,"_44950":661,"_16990":88416,"_5":16526,"_23412":661,"_7169":88417},[45444],"Single-threaded client loading tool for CSV-formatted data via the psql command",{"_11692":673,"_44950":661,"_16990":88419,"_5":16526,"_23412":661,"_7169":88420},[45444],"MapReduce-based bulk load tool for CSV and JSON-formatted data",{"_11692":674,"_44950":661,"_16990":88422,"_5":16526,"_23412":661,"_7169":88423},[45444],"The psql tool is typically appropriate for tens of megabytes, while the MapReduce-based loader is typically better for larger load volumes.",{"_11692":675,"_44950":661,"_16990":88425,"_5":16526,"_23412":88382,"_7169":88426},[45444],"For the following examples, assume we have a CSV file named data.csv with this content:",{"_11692":676,"_44950":661,"_16990":88428,"_5":16526,"_23412":88382,"_7169":88429},[45444],"We will use a table with the following structure:",{"_11692":677,"_44950":661,"_16990":88431,"_5":16526,"_23412":88386,"_7169":88432},[45444],"The psql command is invoked via psql.py in the Phoenix bin directory. To load CSV data, provide connection information for your HBase cluster, the target table name, and one or more CSV file paths. All CSV files must use the .csv extension (because arbitrary SQL scripts with the .sql extension can also be supplied on the psql command line).",{"_11692":678,"_44950":661,"_16990":88434,"_5":16526,"_23412":88386,"_7169":88435},[45444],"To load the example data above into HBase running locally:",{"_11692":679,"_44950":661,"_16990":88437,"_5":16526,"_23412":88386,"_7169":88438},[45444],"The following parameters can be used for loading data with psql:",{"_11692":680,"_44950":661,"_16990":88440,"_5":16526,"_23412":88386,"_7169":88441},[45444],"Parameter",{"_11692":681,"_44950":661,"_16990":88443,"_5":16526,"_23412":88386,"_7169":88444},[45444],"Description",{"_11692":682,"_44950":661,"_16990":88446,"_5":16526,"_23412":88386,"_7169":44244},[45444],{"_11692":683,"_44950":661,"_16990":88448,"_5":16526,"_23412":88386,"_7169":88449},[45444],"Provide the target table name. By default, the table name is taken from the CSV file name. This parameter is case-sensitive.",{"_11692":684,"_44950":661,"_16990":88451,"_5":16526,"_23412":88386,"_7169":44270},[45444],{"_11692":685,"_44950":661,"_16990":88453,"_5":16526,"_23412":88386,"_7169":88454},[45444],"Override the column names to which CSV data maps (case-sensitive). A special value of in-line indicates that the first line of the CSV file determines column mapping.",{"_11692":686,"_44950":661,"_16990":88456,"_5":16526,"_23412":88386,"_7169":44284},[45444],{"_11692":687,"_44950":661,"_16990":88458,"_5":16526,"_23412":88386,"_7169":88459},[45444],"Run in strict mode, throwing an error on CSV parsing errors.",{"_11692":688,"_44950":661,"_16990":88461,"_5":16526,"_23412":88386,"_7169":44126},[45444],{"_11692":689,"_44950":661,"_16990":88463,"_5":16526,"_23412":88386,"_7169":88464},[45444],"Supply one or more custom delimiters for CSV parsing.",{"_11692":690,"_44950":661,"_16990":88466,"_5":16526,"_23412":88386,"_7169":44326},[45444],{"_11692":691,"_44950":661,"_16990":88468,"_5":16526,"_23412":88386,"_7169":88469},[45444],"Supply a custom phrase delimiter (defaults to the double quote character).",{"_11692":692,"_44950":661,"_16990":88471,"_5":16526,"_23412":88386,"_7169":44333},[45444],{"_11692":693,"_44950":661,"_16990":88473,"_5":16526,"_23412":88386,"_7169":88474},[45444],"Supply a custom escape character (default is backslash).",{"_11692":694,"_44950":661,"_16990":88476,"_5":16526,"_23412":88386,"_7169":44346},[45444],{"_11692":695,"_44950":661,"_16990":88478,"_5":16526,"_23412":88386,"_7169":88479},[45444],"Supply an array delimiter (explained in more detail below).",{"_11692":696,"_44950":661,"_16990":88481,"_5":16526,"_23412":88390,"_7169":88482},[45444],"For higher-throughput loading distributed across the cluster, the MapReduce loader can be used. This loader first converts data into HFiles, then provides the created HFiles to HBase after HFile creation completes.",{"_11692":697,"_44950":661,"_16990":88484,"_5":16526,"_23412":88390,"_7169":88485},[45444],"The CSV MapReduce loader is launched using the hadoop command with the Phoenix client JAR:",{"_11692":698,"_44950":661,"_16990":88487,"_5":16526,"_23412":88390,"_7169":88488},[45444],"When using Phoenix 4.0 and above, there is a known HBase issue (\"Notice to MapReduce users of HBase 0.96.1 and above\" in the HBase Reference Guide). You should use:",{"_11692":699,"_44950":661,"_16990":88490,"_5":16526,"_23412":88390,"_7169":88491},[45444],"Or:",{"_11692":700,"_44950":661,"_16990":88493,"_5":16526,"_23412":88390,"_7169":88494},[45444],"The JSON MapReduce loader is launched similarly:",{"_11692":701,"_44950":661,"_16990":88496,"_5":16526,"_23412":88390,"_7169":88497},[45444],"The input file must be present on HDFS (not the local filesystem where the command is run).",{"_11692":702,"_44950":661,"_16990":88499,"_5":16526,"_23412":88390,"_7169":88500},[45444],"The following parameters can be used with the MapReduce loader:",{"_11692":703,"_44950":661,"_16990":88502,"_5":16526,"_23412":88390,"_7169":88441},[45444],{"_11692":704,"_44950":661,"_16990":88504,"_5":16526,"_23412":88390,"_7169":88444},[45444],{"_11692":705,"_44950":661,"_16990":88506,"_5":16526,"_23412":88390,"_7169":88507},[45444],"-i,--input",{"_11692":706,"_44950":661,"_16990":88509,"_5":16526,"_23412":88390,"_7169":88510},[45444],"Input CSV path (mandatory)",{"_11692":707,"_44950":661,"_16990":88512,"_5":16526,"_23412":88390,"_7169":88513},[45444],"-t,--table",{"_11692":708,"_44950":661,"_16990":88515,"_5":16526,"_23412":88390,"_7169":88516},[45444],"Phoenix table name (mandatory)",{"_11692":709,"_44950":661,"_16990":88518,"_5":16526,"_23412":88390,"_7169":88519},[45444],"-a,--array-delimiter",{"_11692":710,"_44950":661,"_16990":88521,"_5":16526,"_23412":88390,"_7169":88522},[45444],"Array element delimiter (optional)",{"_11692":711,"_44950":661,"_16990":88524,"_5":16526,"_23412":88390,"_7169":88525},[45444],"-c,--import-columns",{"_11692":712,"_44950":661,"_16990":88527,"_5":16526,"_23412":88390,"_7169":88528},[45444],"Comma-separated list of columns to import",{"_11692":713,"_44950":661,"_16990":88530,"_5":16526,"_23412":88390,"_7169":88531},[45444],"-d,--delimiter",{"_11692":714,"_44950":661,"_16990":88533,"_5":16526,"_23412":88390,"_7169":88534},[45444],"Input delimiter (defaults to comma)",{"_11692":715,"_44950":661,"_16990":88536,"_5":16526,"_23412":88390,"_7169":88537},[45444],"-g,--ignore-errors",{"_11692":716,"_44950":661,"_16990":88539,"_5":16526,"_23412":88390,"_7169":88540},[45444],"Ignore input errors",{"_11692":717,"_44950":661,"_16990":88542,"_5":16526,"_23412":88390,"_7169":88543},[45444],"-o,--output",{"_11692":718,"_44950":661,"_16990":88545,"_5":16526,"_23412":88390,"_7169":88546},[45444],"Output path for temporary HFiles (optional)",{"_11692":719,"_44950":661,"_16990":88548,"_5":16526,"_23412":88390,"_7169":88549},[45444],"-s,--schema",{"_11692":720,"_44950":661,"_16990":88551,"_5":16526,"_23412":88390,"_7169":88552},[45444],"Phoenix schema name (optional)",{"_11692":721,"_44950":661,"_16990":88554,"_5":16526,"_23412":88390,"_7169":88555},[45444],"-z,--zookeeper",{"_11692":722,"_44950":661,"_16990":88557,"_5":16526,"_23412":88390,"_7169":88558},[45444],"ZooKeeper quorum to connect to (optional)",{"_11692":723,"_44950":661,"_16990":88560,"_5":16526,"_23412":88390,"_7169":88561},[45444],"-it,--index-table",{"_11692":724,"_44950":661,"_16990":88563,"_5":16526,"_23412":88390,"_7169":88564},[45444],"Index table name to load (optional)",{"_11692":725,"_44950":661,"_16990":88566,"_5":16526,"_23412":88394,"_7169":88567},[45444],"The current MR-based bulk loader runs one MR job to load your data table and one MR job per index table to populate indexes. Use -it to load only one index table.",{"_11692":726,"_44950":661,"_16990":88569,"_5":16526,"_23412":88398,"_7169":88570},[45444],"There can be issues due to file permissions on created HFiles in the final stage of a bulk load, when HFiles are handed over to HBase. HBase must be able to move the created HFiles, which means it needs write access to the directories where files were written. If not, HFile upload may hang for a long time before failing.",{"_11692":727,"_44950":661,"_16990":88572,"_5":16526,"_23412":88398,"_7169":88573},[45444],"Two common workarounds are:",{"_11692":728,"_44950":661,"_16990":88575,"_5":16526,"_23412":88398,"_7169":88576},[45444],"Run the bulk load process as the hbase user.",{"_11692":729,"_44950":661,"_16990":88578,"_5":16526,"_23412":88398,"_7169":88579},[45444],"Create output files readable/writable for all users.",{"_11692":730,"_44950":661,"_16990":88581,"_5":16526,"_23412":88398,"_7169":88582},[45444],"The first option can be done by running:",{"_11692":731,"_44950":661,"_16990":88584,"_5":16526,"_23412":88398,"_7169":88585},[45444],"Creating output files readable by all can be done by setting fs.permissions.umask-mode to 000. This can be set in Hadoop config on the submit host, or only for job submission:",{"_11692":732,"_44950":661,"_16990":88587,"_5":16526,"_23412":88402,"_7169":88588},[45444],"Both PSQL and MapReduce loaders support array values with -a. Arrays in CSV are represented by a field that uses a different delimiter than the main CSV delimiter. For example, this file represents an id field and an array of integers:",{"_11692":733,"_44950":661,"_16990":88590,"_5":16526,"_23412":88402,"_7169":88591},[45444],"To load this file, use the default CSV delimiter (comma) and pass colon as the array delimiter via -a ':'.",{"_11692":734,"_44950":661,"_16990":88593,"_5":16526,"_23412":88406,"_7169":88594},[45444],"The default separator for both loaders is comma (,). A common separator for input files is tab, which can be tricky to pass on the command line. A common mistake is:",{"_11692":735,"_44950":661,"_16990":88596,"_5":16526,"_23412":88406,"_7169":88597},[45444],"This does not work because the shell passes two characters (backslash and t) to Phoenix.",{"_11692":736,"_44950":661,"_16990":88599,"_5":16526,"_23412":88406,"_7169":88600},[45444],"Two working approaches:",{"_11692":737,"_44950":661,"_16990":88602,"_5":16526,"_23412":88406,"_7169":88603},[45444],"Prefix the string representation of tab with $:",{"_11692":738,"_44950":661,"_16990":88605,"_5":16526,"_23412":88406,"_7169":88606},[45444],"Enter the separator as Ctrl+v and then press tab:",{"_11692":739,"_44950":661,"_16990":88608,"_5":16526,"_23412":88410,"_7169":88609},[45444],"Table names in Phoenix are case-insensitive (generally uppercase), but users may need to map an existing lowercase HBase table name into Phoenix. In this case, double quotes around the table name (for example, \"tablename\") preserve case sensitivity.",{"_11692":740,"_44950":661,"_16990":88611,"_5":16526,"_23412":88410,"_7169":88612},[45444],"This support was extended to bulk load options. However, due to how Apache Commons CLI parses command-line options (CLI-275), pass the argument as \\\"\\\"tablename\\\"\\\" instead of just \"tablename\" for CsvBulkLoadTool.",{"_11692":741,"_44950":661,"_16990":88614,"_5":16526,"_23412":88410,"_7169":87958},[45444],{"_11692":742,"_44950":742,"_5":12121,"_7169":88616,"_45415":88617,"_16990":88618,"_23412":742},"Change Data Capture (CDC)",[86368,86369,86370,88058],[45444],{"_11692":743,"_44950":742,"_16990":88620,"_5":16526,"_23412":742,"_7169":88621},[45444],"Query row-level change events on a Phoenix table using standard SQL — pull pre/post images and change deltas with bounded, resumable reads.",{"_11692":744,"_44950":742,"_5":45412,"_16990":88623,"_23412":88624,"_7169":88625},[45444],"/docs/features/change-data-capture#cdc-when","When to use it",{"_11692":745,"_44950":742,"_5":45412,"_16990":88627,"_23412":88628,"_7169":88629},[45444],"/docs/features/change-data-capture#cdc-enable","Enabling CDC on a table",{"_11692":746,"_44950":742,"_5":45412,"_16990":88631,"_23412":88632,"_7169":88633},[45444],"/docs/features/change-data-capture#cdc-read","Reading change events",{"_11692":747,"_44950":742,"_5":45412,"_16990":88635,"_23412":88636,"_7169":88637},[45444],"/docs/features/change-data-capture#time-bounded--incremental-reads","Time-bounded / incremental reads",{"_11692":748,"_44950":742,"_5":45412,"_16990":88639,"_23412":88640,"_7169":88641},[45444],"/docs/features/change-data-capture#per-partition-reads","Per-partition reads",{"_11692":749,"_44950":742,"_5":45412,"_16990":88643,"_23412":88644,"_7169":88645},[45444],"/docs/features/change-data-capture#cdc-lineage","Stream lineage: partitions, splits, and merges",{"_11692":750,"_44950":742,"_5":45412,"_16990":88647,"_23412":88648,"_7169":88649},[45444],"/docs/features/change-data-capture#consuming-events-in-parent--child-order","Consuming events in parent → child order",{"_11692":751,"_44950":742,"_5":45412,"_16990":88651,"_23412":88652,"_7169":88653},[45444],"/docs/features/change-data-capture#cdc-special-events","Special event types",{"_11692":752,"_44950":742,"_5":45412,"_16990":88655,"_23412":88656,"_7169":88657},[45444],"/docs/features/change-data-capture#cdc-ops","Operational notes",{"_11692":753,"_44950":742,"_16990":88659,"_5":16526,"_23412":742,"_7169":88660},[45444],"Change Data Capture turns a Phoenix table into a stream of change events that\ndownstream consumers can read using regular SQL. Once enabled, a CDC object behaves\nlike a queryable Phoenix table: every insert, update, and delete on the underlying\ndata table produces a row containing the affected primary key, an event timestamp,\nand a JSON payload describing what changed. Available in Phoenix 5.3.0\n(PHOENIX-7001).",{"_11692":754,"_44950":742,"_16990":88662,"_5":16526,"_23412":88624,"_7169":88663},[45444],"Reach for CDC when something downstream needs to react to row-level changes:",{"_11692":755,"_44950":742,"_16990":88665,"_5":16526,"_23412":88624,"_7169":88666},[45444],"Replication or mirroring to another store (Kafka, search index, data warehouse).",{"_11692":756,"_44950":742,"_16990":88668,"_5":16526,"_23412":88624,"_7169":88669},[45444],"Audit logs and change history.",{"_11692":757,"_44950":742,"_16990":88671,"_5":16526,"_23412":88624,"_7169":88672},[45444],"Cache invalidation and event-driven workflows.",{"_11692":758,"_44950":742,"_16990":88674,"_5":16526,"_23412":88624,"_7169":88675},[45444],"Materialized projections / fan-out tables maintained by an external process.",{"_11692":759,"_44950":742,"_16990":88677,"_5":16526,"_23412":88624,"_7169":88678},[45444],"CDC captures the actual mutations as they happen — including TTL-driven row\ndeletes — so consumers don't need to poll the data table or compute diffs.",{"_11692":760,"_44950":742,"_16990":88680,"_5":16526,"_23412":88628,"_7169":88681},[45444],"Use CREATE CDC to enable change capture on an existing table:",{"_11692":761,"_44950":742,"_16990":88683,"_5":16526,"_23412":88628,"_7169":88684},[45444],"The INCLUDE clause sets the default scopes that appear in the JSON payload.\nAvailable scopes:",{"_11692":762,"_44950":742,"_16990":88686,"_5":16526,"_23412":88628,"_7169":88687},[45444],"Scope",{"_11692":763,"_44950":742,"_16990":88689,"_5":16526,"_23412":88628,"_7169":88690},[45444],"Meaning",{"_11692":764,"_44950":742,"_16990":88692,"_5":16526,"_23412":88628,"_7169":88693},[45444],"PRE",{"_11692":765,"_44950":742,"_16990":88695,"_5":16526,"_23412":88628,"_7169":88696},[45444],"Row image before the mutation.",{"_11692":766,"_44950":742,"_16990":88698,"_5":16526,"_23412":88628,"_7169":88699},[45444],"POST",{"_11692":767,"_44950":742,"_16990":88701,"_5":16526,"_23412":88628,"_7169":88702},[45444],"Row image after the mutation.",{"_11692":768,"_44950":742,"_16990":88704,"_5":16526,"_23412":88628,"_7169":88705},[45444],"CHANGE",{"_11692":769,"_44950":742,"_16990":88707,"_5":16526,"_23412":88628,"_7169":88708},[45444],"Just the changed columns (diff).",{"_11692":770,"_44950":742,"_16990":88710,"_5":16526,"_23412":88628,"_7169":88711},[45444],"Standard CREATE INDEX–style table properties on CREATE CDC (SALT_BUCKETS,\nUPDATE_CACHE_FREQUENCY, COLUMN_ENCODED_BYTES, etc.) are forwarded to the\nunderlying CDC index.",{"_11692":771,"_44950":742,"_16990":88713,"_5":16526,"_23412":88628,"_7169":88714},[45444],"To remove CDC from a table:",{"_11692":772,"_44950":742,"_16990":88716,"_5":16526,"_23412":88632,"_7169":88717},[45444],"Each CDC object behaves like a Phoenix table whose columns are:",{"_11692":773,"_44950":742,"_16990":88719,"_5":16526,"_23412":88632,"_7169":88720},[45444],"The data table's primary-key columns (so you know which row changed).",{"_11692":774,"_44950":742,"_16990":88722,"_5":16526,"_23412":88632,"_7169":88723},[45444],"A payload column literally named \"CDC JSON\" (case-sensitive, must be quoted).\nProject it whenever you need the change payload; omit it for lightweight queries\nthat only care about which rows changed or for topology lookups. SELECT *\nincludes it automatically.",{"_11692":775,"_44950":742,"_16990":88725,"_5":16526,"_23412":88632,"_7169":88726},[45444],"Two helpers come along for the ride:",{"_11692":776,"_44950":742,"_16990":88728,"_5":16526,"_23412":88632,"_7169":88729},[45444],"PHOENIX_ROW_TIMESTAMP() — the event's timestamp; use it for ordering and time-\nbounded reads.",{"_11692":777,"_44950":742,"_16990":88731,"_5":16526,"_23412":88632,"_7169":88732},[45444],"PARTITION_ID() — the partition the event came from; useful for sharding consumer\nworkers.",{"_11692":778,"_44950":742,"_16990":88734,"_5":16526,"_23412":88632,"_7169":88735},[45444],"A typical read query that wants the full payload looks like this:",{"_11692":779,"_44950":742,"_16990":88737,"_5":16526,"_23412":88632,"_7169":88738},[45444],"The CDC_INCLUDE(...) query hint overrides the default scopes set at CREATE\nCDC time — so the same CDC object can serve different downstream consumers, each\nasking for only the scope they need. Without the hint, the payload uses the\nINCLUDE scopes from the CREATE CDC statement.",{"_11692":780,"_44950":742,"_16990":88740,"_5":16526,"_23412":88636,"_7169":88741},[45444],"Use PHOENIX_ROW_TIMESTAMP() predicates to pull only events within a window —\nconsumers typically remember the last timestamp they processed and bind it as the\nlower bound on the next call:",{"_11692":781,"_44950":742,"_16990":88743,"_5":16526,"_23412":88640,"_7169":88744},[45444],"Partitions track HBase regions of the data table, so you can shard a consumer pool\nacross them. Discover partitions with:",{"_11692":782,"_44950":742,"_16990":88746,"_5":16526,"_23412":88640,"_7169":88747},[45444],"Then issue per-partition reads:",{"_11692":783,"_44950":742,"_16990":88749,"_5":16526,"_23412":88644,"_7169":88750},[45444],"A CDC stream is logically a set of partitions, each carrying a totally-ordered\nsequence of change events. A partition isn't an abstract shard — it corresponds to a\nspecific HBase region of the data table at a point in time, and it has a finite\nlifetime: it's born when the region is created (or as the result of a split/merge)\nand it's closed when that region itself splits or merges into something new. New\nchild partitions take over from there.",{"_11692":784,"_44950":742,"_16990":88752,"_5":16526,"_23412":88644,"_7169":88753},[45444],"Phoenix tracks this topology in SYSTEM.CDC_STREAM. The schema makes the lineage\nexplicit — every partition row points at its parent partition(s):",{"_11692":785,"_44950":742,"_16990":88755,"_5":16526,"_23412":88644,"_7169":88756},[45444],"Column",{"_11692":786,"_44950":742,"_16990":88758,"_5":16526,"_23412":88644,"_7169":88759},[45444],"Notes",{"_11692":787,"_44950":742,"_16990":88761,"_5":16526,"_23412":88644,"_7169":88762},[45444],"TABLE_NAME",{"_11692":788,"_44950":742,"_16990":88764,"_5":16526,"_23412":88644,"_7169":88765},[45444],"The data table whose changes are streamed.",{"_11692":789,"_44950":742,"_16990":88767,"_5":16526,"_23412":88644,"_7169":88768},[45444],"STREAM_NAME",{"_11692":790,"_44950":742,"_16990":88770,"_5":16526,"_23412":88644,"_7169":88771},[45444],"The CDC stream (each CREATE CDC produces a uniquely-named stream).",{"_11692":791,"_44950":742,"_16990":88773,"_5":16526,"_23412":88644,"_7169":88774},[45444],"PARTITION_ID",{"_11692":792,"_44950":742,"_16990":88776,"_5":16526,"_23412":88644,"_7169":88777},[45444],"This partition's id — same value PARTITION_ID() returns on a CDC row.",{"_11692":793,"_44950":742,"_16990":88779,"_5":16526,"_23412":88644,"_7169":88780},[45444],"PARENT_PARTITION_ID",{"_11692":794,"_44950":742,"_16990":88782,"_5":16526,"_23412":88644,"_7169":88783},[45444],"The parent partition's id (empty/null for the initial partitions present when CDC was first enabled).",{"_11692":795,"_44950":742,"_16990":88785,"_5":16526,"_23412":88644,"_7169":88786},[45444],"PARTITION_START_TIME",{"_11692":796,"_44950":742,"_16990":88788,"_5":16526,"_23412":88644,"_7169":88789},[45444],"When this partition began.",{"_11692":797,"_44950":742,"_16990":88791,"_5":16526,"_23412":88644,"_7169":88792},[45444],"PARTITION_END_TIME",{"_11692":798,"_44950":742,"_16990":88794,"_5":16526,"_23412":88644,"_7169":88795},[45444],"When it was closed (a split or merge ended it). NULL while still active.",{"_11692":799,"_44950":742,"_16990":88797,"_5":16526,"_23412":88644,"_7169":88798},[45444],"PARTITION_START_KEY / _END_KEY",{"_11692":800,"_44950":742,"_16990":88800,"_5":16526,"_23412":88644,"_7169":88801},[45444],"The HBase region's row-key bounds at the time, stored as VARBINARY_ENCODED.",{"_11692":801,"_44950":742,"_16990":88803,"_5":16526,"_23412":88644,"_7169":88804},[45444],"PARENT_PARTITION_START_TIME",{"_11692":802,"_44950":742,"_16990":88806,"_5":16526,"_23412":88644,"_7169":88807},[45444],"The parent partition's PARTITION_START_TIME, embedded so consumers can walk parent → child without an extra join.",{"_11692":803,"_44950":742,"_16990":88809,"_5":16526,"_23412":88644,"_7169":88810},[45444],"Two important shapes fall out of this model:",{"_11692":804,"_44950":742,"_16990":88812,"_5":16526,"_23412":88644,"_7169":88813},[45444],"A split produces two child rows that share the same PARENT_PARTITION_ID (the\nregion that just split). Their key ranges together cover the parent's range.",{"_11692":805,"_44950":742,"_16990":88815,"_5":16526,"_23412":88644,"_7169":88816},[45444],"A merge produces one child partition with multiple rows in SYSTEM.CDC_STREAM —\none row per parent — sharing the same PARTITION_ID and differing only in\nPARENT_PARTITION_ID. Together those rows record every parent that fed the merge.",{"_11692":806,"_44950":742,"_16990":88818,"_5":16526,"_23412":88648,"_7169":88819},[45444],"Because events from a parent partition causally precede events from any of its\nchildren, a correct consumer must drain the parent before reading children that\ndescend from it. The pattern is:",{"_11692":807,"_44950":742,"_16990":88821,"_5":16526,"_23412":88648,"_7169":88822},[45444],"Discover the topology by reading SYSTEM.CDC_STREAM for your table and\nstream. Build a DAG keyed by PARTITION_ID, with edges drawn from\nPARENT_PARTITION_ID → child PARTITION_ID. Roots are partitions with no\nparent (the regions present when CDC was first enabled).",{"_11692":808,"_44950":742,"_16990":88824,"_5":16526,"_23412":88648,"_7169":88825},[45444],"Process roots first, then walk forward through the DAG. A child partition is\nready to be consumed once all of its parents have been fully drained — for\nmerges, that means all rows in SYSTEM.CDC_STREAM with the same child\nPARTITION_ID have had their parent partitions processed.",{"_11692":809,"_44950":742,"_16990":88827,"_5":16526,"_23412":88648,"_7169":88828},[45444],"For each partition, query the CDC object scoped to that partition and the\ntime window the partition was live:",{"_11692":810,"_44950":742,"_16990":88830,"_5":16526,"_23412":88648,"_7169":88831},[45444],"Re-poll the topology periodically. New rows appear in SYSTEM.CDC_STREAM\nwhen regions split or merge; consumers refresh their DAG to pick up the new\nchildren before existing partitions close.",{"_11692":811,"_44950":742,"_16990":88833,"_5":16526,"_23412":88648,"_7169":88834},[45444],"This is the same shard-lineage model used by DynamoDB Streams — if you're porting a\nDynamoDB Streams consumer, the bookkeeping translates almost directly.",{"_11692":812,"_44950":742,"_16990":88836,"_5":16526,"_23412":88652,"_7169":88837},[45444],"TTL-driven deletes (rows aged out by time-based or\nconditional TTL) produce CDC events alongside\napplication-issued mutations, so consumers don't have to reconcile retention-driven\nremovals separately.",{"_11692":813,"_44950":742,"_16990":88839,"_5":16526,"_23412":88652,"_7169":88840},[45444],"ARRAY and JSON columns in the data table are serialized as simple values\ninside the \"CDC JSON\" payload.",{"_11692":814,"_44950":742,"_16990":88842,"_5":16526,"_23412":88652,"_7169":88843},[45444],"Case-sensitive identifiers on the data table and its primary-key columns are\npreserved end to end in events.",{"_11692":815,"_44950":742,"_16990":88845,"_5":16526,"_23412":88656,"_7169":88846},[45444],"When the underlying data table is dropped, its CDC stream metadata in\nSYSTEM.CDC_STREAM is cleaned up automatically — you don't have to drop the CDC\nobject first.",{"_11692":816,"_44950":742,"_16990":88848,"_5":16526,"_23412":88656,"_7169":88849},[45444],"The CDC object is internally backed by a partitioned secondary index on the data\ntable, but it's not used to satisfy regular queries against the data table —\nthere's no read penalty on the data table from enabling CDC.",{"_11692":817,"_44950":742,"_16990":88851,"_5":16526,"_23412":88656,"_7169":88852},[45444],"Re-creating CDC after a drop produces a distinct stream (the stream name is\naugmented with creation time), so consumers can detect the boundary and reset\ntheir offsets cleanly.",{"_11692":818,"_44950":818,"_5":12121,"_7169":88854,"_45415":88855,"_16990":88856,"_23412":818},"Conditional TTL",[86368,86369,86370,88058],[45444],{"_11692":819,"_44950":818,"_16990":88858,"_5":16526,"_23412":818,"_7169":88859},[45444],"Express row expiration as a SQL boolean expression evaluated against the row itself, with strict and relaxed enforcement modes.",{"_11692":820,"_44950":818,"_5":45412,"_16990":88861,"_23412":88862,"_7169":88625},[45444],"/docs/features/conditional-ttl#conditional-ttl-when",{"_11692":821,"_44950":818,"_5":45412,"_16990":88864,"_23412":88865,"_7169":88866},[45444],"/docs/features/conditional-ttl#conditional-ttl-define","Defining a conditional TTL",{"_11692":822,"_44950":818,"_5":45412,"_16990":88868,"_23412":88869,"_7169":88870},[45444],"/docs/features/conditional-ttl#strict-vs-relaxed-ttl","Strict vs Relaxed TTL",{"_11692":823,"_44950":818,"_5":45412,"_16990":88872,"_23412":88873,"_7169":88874},[45444],"/docs/features/conditional-ttl#what-each-mode-does","What each mode does",{"_11692":824,"_44950":818,"_5":45412,"_16990":88876,"_23412":88877,"_7169":88878},[45444],"/docs/features/conditional-ttl#choosing-a-mode","Choosing a mode",{"_11692":825,"_44950":818,"_5":45412,"_16990":88880,"_23412":88881,"_7169":88882},[45444],"/docs/features/conditional-ttl#setting-the-mode","Setting the mode",{"_11692":826,"_44950":818,"_5":45412,"_16990":88884,"_23412":88885,"_7169":86490},[45444],"/docs/features/conditional-ttl#conditional-ttl-limitations",{"_11692":827,"_44950":818,"_16990":88887,"_5":16526,"_23412":818,"_7169":88888},[45444],"Conditional TTL lets you express row expiration as a SQL boolean expression\nevaluated against the row's own column values, instead of a fixed time-since-write\nnumber. A row is considered expired the moment the expression evaluates to TRUE for\nthat row. Available in Phoenix 5.3.0\n(PHOENIX-7170).",{"_11692":828,"_44950":818,"_16990":88890,"_5":16526,"_23412":88862,"_7169":88891},[45444],"Conditional TTL fits whenever \"expired\" is an application concept, not just an\nage. Some typical cases:",{"_11692":829,"_44950":818,"_16990":88893,"_5":16526,"_23412":88862,"_7169":88894},[45444],"\"Delete this row 30 days after STATUS becomes 'CLOSED'.\"",{"_11692":830,"_44950":818,"_16990":88896,"_5":16526,"_23412":88862,"_7169":88897},[45444],"\"Expire when RETAIN_UNTIL has passed.\"",{"_11692":831,"_44950":818,"_16990":88899,"_5":16526,"_23412":88862,"_7169":88900},[45444],"\"Keep failed records for a week, successful ones for an hour.\"",{"_11692":832,"_44950":818,"_16990":88902,"_5":16526,"_23412":88862,"_7169":88903},[45444],"\"Expire soft-deleted rows (is_deleted = TRUE) after a grace period.\"",{"_11692":833,"_44950":818,"_16990":88905,"_5":16526,"_23412":88862,"_7169":88906},[45444],"If retention is a flat duration that applies uniformly to all rows, use the regular\ntime-based TTL property. If different views over the same shared table need\ndifferent retention rules, look at View TTL — it composes\nwith conditional TTL.",{"_11692":834,"_44950":818,"_16990":88908,"_5":16526,"_23412":88865,"_7169":88909},[45444],"Pass a SQL boolean expression as the TTL table property at CREATE TABLE (or\nCREATE VIEW) time. The expression may reference any column of the table:",{"_11692":835,"_44950":818,"_16990":88911,"_5":16526,"_23412":88865,"_7169":88912},[45444],"Update or remove the expression later with ALTER TABLE:",{"_11692":836,"_44950":818,"_16990":88914,"_5":16526,"_23412":88865,"_7169":88915},[45444],"What \"expired\" means in practice:",{"_11692":837,"_44950":818,"_16990":88917,"_5":16526,"_23412":88865,"_7169":88918},[45444],"Read-time: any query touching the row evaluates the TTL expression server-side\nand skips the row if it returns TRUE. Rows become invisible the moment they\nmatch the predicate, regardless of physical state.",{"_11692":838,"_44950":818,"_16990":88920,"_5":16526,"_23412":88865,"_7169":88921},[45444],"Phoenix compaction: expired rows are physically removed by Phoenix's\ncompaction during HBase region compactions. There is no separate cleanup job —\nphysical removal happens whenever the underlying regions compact.",{"_11692":839,"_44950":818,"_16990":88923,"_5":16526,"_23412":88869,"_7169":88924},[45444],"Conditional TTL has two enforcement modes, controlled by the IS_STRICT_TTL\ntable property. The default is true (strict).",{"_11692":840,"_44950":818,"_16990":88926,"_5":16526,"_23412":88873,"_7169":88927},[45444],"Path",{"_11692":841,"_44950":818,"_16990":88929,"_5":16526,"_23412":88873,"_7169":88930},[45444],"Strict (default)",{"_11692":842,"_44950":818,"_16990":88932,"_5":16526,"_23412":88873,"_7169":88933},[45444],"Relaxed (IS_STRICT_TTL = false)",{"_11692":843,"_44950":818,"_16990":88935,"_5":16526,"_23412":88873,"_7169":88936},[45444],"Reads (region scanner)",{"_11692":844,"_44950":818,"_16990":88938,"_5":16526,"_23412":88873,"_7169":88939},[45444],"Server-side masking is enabled — rows for which the TTL expression is TRUE are filtered out of every result set, on every read path.",{"_11692":845,"_44950":818,"_16990":88941,"_5":16526,"_23412":88873,"_7169":88942},[45444],"Read-time masking is disabled. Expired rows can still surface through scans until compaction reclaims them.",{"_11692":846,"_44950":818,"_16990":88944,"_5":16526,"_23412":88873,"_7169":88945},[45444],"Atomic UPSERT / DELETE",{"_11692":847,"_44950":818,"_16990":88947,"_5":16526,"_23412":88873,"_7169":88948},[45444],"The row is locked and the TTL expression is pre-evaluated against the current row state. If the row is already expired, the mutation behaves as if the row does not exist (e.g. ON DUPLICATE KEY UPDATE falls through to insert).",{"_11692":848,"_44950":818,"_16990":88950,"_5":16526,"_23412":88873,"_7169":88951},[45444],"The extra row lock and pre-check are skipped — atomic mutations run without consulting the TTL expression.",{"_11692":849,"_44950":818,"_16990":88953,"_5":16526,"_23412":88877,"_7169":88954},[45444],"Start with strict (the default). Switch to relaxed when relaxed mode's\ncheaper write-path is the right trade-off: no extra lock or pre-check on atomic\noperations makes it a reasonable choice for high-throughput workloads where eventual\nvisibility of expired rows is acceptable.",{"_11692":850,"_44950":818,"_16990":88956,"_5":16526,"_23412":88881,"_7169":88957},[45444],"Switch a table between modes later:",{"_11692":851,"_44950":818,"_16990":88959,"_5":16526,"_23412":88885,"_7169":88960},[45444],"Conditional TTL requires the table to have a single column family.",{"_11692":852,"_44950":818,"_16990":88962,"_5":16526,"_23412":88885,"_7169":88963},[45444],"The TTL expression must be a valid Phoenix SQL boolean expression and may only\nreference columns of the same table — no joins, no subqueries.",{"_11692":853,"_44950":818,"_16990":88965,"_5":16526,"_23412":88885,"_7169":88966},[45444],"The classic time-based TTL = N (seconds) and conditional TTL = '<expr>' use the\nsame property; what you pass in determines which mode you get. You can't have both\nat once.",{"_11692":854,"_44950":854,"_5":12121,"_7169":88968,"_45415":88969,"_16990":88970,"_23412":854},"Cursor",[86368,86369,86370,88058],[45444],{"_11692":855,"_44950":854,"_16990":88972,"_5":16526,"_23412":854,"_7169":88973},[45444],"Use CURSOR statements in Phoenix to process query results in controlled row batches.",{"_11692":856,"_44950":854,"_5":45412,"_16990":88975,"_23412":88976,"_7169":88977},[45444],"/docs/features/cursor#using-a-cursor","Using a cursor",{"_11692":857,"_44950":854,"_16990":88979,"_5":16526,"_23412":854,"_7169":88980},[45444],"To work on a subset of rows from a query, Phoenix supports a CURSOR control structure. The sequence below shows how to use a cursor.",{"_11692":858,"_44950":854,"_16990":88982,"_5":16526,"_23412":88976,"_7169":88983},[45444],"Define a cursor for a query using the DECLARE statement.",{"_11692":859,"_44950":854,"_16990":88985,"_5":16526,"_23412":88976,"_7169":88986},[45444],"Open the cursor.",{"_11692":860,"_44950":854,"_16990":88988,"_5":16526,"_23412":88976,"_7169":88989},[45444],"Fetch a subset of rows to work with.",{"_11692":861,"_44950":854,"_16990":88991,"_5":16526,"_23412":88976,"_7169":88992},[45444],"Iterate through the fetched rows and process them as required.",{"_11692":862,"_44950":854,"_16990":88994,"_5":16526,"_23412":88976,"_7169":88995},[45444],"Fetch additional sets of rows as needed, and close the cursor when done.",{"_11692":863,"_44950":863,"_5":12121,"_7169":88249,"_45415":88997,"_16990":88998,"_23412":863},[86368,86369,86370,88058],[45444],{"_11692":864,"_44950":863,"_16990":89000,"_5":16526,"_23412":863,"_7169":89001},[45444],"Define and query late-bound dynamic columns in Phoenix when full schema cannot be declared upfront.",{"_11692":865,"_44950":863,"_16990":89003,"_5":16526,"_23412":863,"_7169":89004},[45444],"Sometimes defining a static schema up front is not feasible. Instead, a subset of columns may be specified at table create time while the rest are specified at query time. As of Phoenix 1.2, dynamic columns are supported by allowing column definitions in parentheses after the table name in the FROM clause of a SELECT statement. Although this is not standard SQL, it is useful for leveraging the late-binding capability of HBase.",{"_11692":866,"_44950":863,"_16990":89006,"_5":16526,"_23412":863,"_7169":89007},[45444],"For example:",{"_11692":867,"_44950":863,"_16990":89009,"_5":16526,"_23412":863,"_7169":89010},[45444],"You might define only a subset of event columns at create time, because each event type can have different properties:",{"_11692":868,"_44950":863,"_16990":89012,"_5":16526,"_23412":863,"_7169":89013},[45444],"To upsert a row with dynamic columns:",{"_11692":869,"_44950":869,"_5":12121,"_7169":89015,"_45415":89016,"_16990":89017,"_23412":869},"Metrics",[86368,86369,86370,88058],[45444],{"_11692":870,"_44950":869,"_16990":89019,"_5":16526,"_23412":869,"_7169":89020},[45444],"Request-level and global Phoenix client metrics, with practical usage patterns and Java examples.",{"_11692":871,"_44950":869,"_5":45412,"_16990":89022,"_23412":89023,"_7169":89024},[45444],"/docs/features/metrics#request-level-metrics","Request-level metrics",{"_11692":872,"_44950":869,"_5":45412,"_16990":89026,"_23412":89027,"_7169":89028},[45444],"/docs/features/metrics#mutation-metrics","Mutation metrics",{"_11692":873,"_44950":869,"_5":45412,"_16990":89030,"_23412":89031,"_7169":89032},[45444],"/docs/features/metrics#scan-task-metrics","Scan task metrics",{"_11692":874,"_44950":869,"_5":45412,"_16990":89034,"_23412":89035,"_7169":89036},[45444],"/docs/features/metrics#overall-query-metrics","Overall query metrics",{"_11692":875,"_44950":869,"_5":45412,"_16990":89038,"_23412":89039,"_7169":89040},[45444],"/docs/features/metrics#how-to-use-sql-statement-level-metrics","How to use SQL statement-level metrics",{"_11692":876,"_44950":869,"_16990":89042,"_5":16526,"_23412":869,"_7169":89043},[45444],"Phoenix surfaces various metrics that provide an insight into what is going on within the Phoenix client as it is executing various SQL statements. These metrics are collected within the client JVM in two ways:",{"_11692":877,"_44950":869,"_16990":89045,"_5":16526,"_23412":869,"_7169":89046},[45444],"Request level metrics - collected at an individual SQL statement level",{"_11692":878,"_44950":869,"_16990":89048,"_5":16526,"_23412":869,"_7169":89049},[45444],"Global metrics - collected at the client JVM level",{"_11692":879,"_44950":869,"_16990":89051,"_5":16526,"_23412":869,"_7169":89052},[45444],"Request level metrics are helpful for figuring out at a more granular level about the amount of work done by every SQL statement executed by Phoenix. These metrics can be classified into three categories:",{"_11692":880,"_44950":869,"_16990":89054,"_5":16526,"_23412":89027,"_7169":89055},[45444],"MUTATION_BATCH_SIZE - Batch sizes of mutations",{"_11692":881,"_44950":869,"_16990":89057,"_5":16526,"_23412":89027,"_7169":89058},[45444],"MUTATION_BYTES - Size of mutations in bytes",{"_11692":882,"_44950":869,"_16990":89060,"_5":16526,"_23412":89027,"_7169":89061},[45444],"MUTATION_COMMIT_TIME - Time it took to commit mutations",{"_11692":883,"_44950":869,"_16990":89063,"_5":16526,"_23412":89031,"_7169":89064},[45444],"NUM_PARALLEL_SCANS - Number of scans executed in parallel",{"_11692":884,"_44950":869,"_16990":89066,"_5":16526,"_23412":89031,"_7169":89067},[45444],"SCAN_BYTES - Number of bytes read by scans",{"_11692":885,"_44950":869,"_16990":89069,"_5":16526,"_23412":89031,"_7169":89070},[45444],"MEMORY_CHUNK_BYTES - Number of bytes allocated by the memory manager",{"_11692":886,"_44950":869,"_16990":89072,"_5":16526,"_23412":89031,"_7169":89073},[45444],"MEMORY_WAIT_TIME - Time in milliseconds threads needed to wait for memory to be allocated through memory manager",{"_11692":887,"_44950":869,"_16990":89075,"_5":16526,"_23412":89031,"_7169":89076},[45444],"SPOOL_FILE_SIZE - Size of spool files created in bytes",{"_11692":888,"_44950":869,"_16990":89078,"_5":16526,"_23412":89031,"_7169":89079},[45444],"SPOOL_FILE_COUNTER - Number of spool files created",{"_11692":889,"_44950":869,"_16990":89081,"_5":16526,"_23412":89031,"_7169":89082},[45444],"CACHE_REFRESH_SPLITS_COUNTER - Number of times Phoenix's metadata cache was refreshed because of splits",{"_11692":890,"_44950":869,"_16990":89084,"_5":16526,"_23412":89031,"_7169":89085},[45444],"TASK_QUEUE_WAIT_TIME - Time in milliseconds tasks had to wait in the queue of the thread pool executor",{"_11692":891,"_44950":869,"_16990":89087,"_5":16526,"_23412":89031,"_7169":89088},[45444],"TASK_END_TO_END_TIME - Time in milliseconds spent by tasks from creation to completion",{"_11692":892,"_44950":869,"_16990":89090,"_5":16526,"_23412":89031,"_7169":89091},[45444],"TASK_EXECUTION_TIME - Time in milliseconds tasks took to execute",{"_11692":893,"_44950":869,"_16990":89093,"_5":16526,"_23412":89031,"_7169":89094},[45444],"TASK_EXECUTED_COUNTER - Counter for number of tasks submitted to the thread pool executor",{"_11692":894,"_44950":869,"_16990":89096,"_5":16526,"_23412":89031,"_7169":89097},[45444],"TASK_REJECTED_COUNTER - Counter for number of tasks that were rejected by the thread pool executor",{"_11692":895,"_44950":869,"_16990":89099,"_5":16526,"_23412":89035,"_7169":89100},[45444],"QUERY_TIMEOUT_COUNTER - Number of times query timed out",{"_11692":896,"_44950":869,"_16990":89102,"_5":16526,"_23412":89035,"_7169":89103},[45444],"QUERY_FAILED_COUNTER - Number of times query failed",{"_11692":897,"_44950":869,"_16990":89105,"_5":16526,"_23412":89035,"_7169":89106},[45444],"WALL_CLOCK_TIME_MS - Wall clock time elapsed for the overall query execution",{"_11692":898,"_44950":869,"_16990":89108,"_5":16526,"_23412":89035,"_7169":89109},[45444],"RESULT_SET_TIME_MS - Wall clock time elapsed for reading all records using resultSet.next()",{"_11692":899,"_44950":869,"_16990":89111,"_5":16526,"_23412":89039,"_7169":89112},[45444],"Log and report query execution details which could be later used for analysis.",{"_11692":900,"_44950":869,"_16990":89114,"_5":16526,"_23412":89039,"_7169":89115},[45444],"Report top SQL queries by duration. Metric to use: WALL_CLOCK_TIME_MS.",{"_11692":901,"_44950":869,"_16990":89117,"_5":16526,"_23412":89039,"_7169":89118},[45444],"Check if the query is failing because it is timing out. Metric to use: QUERY_TIMEOUT_COUNTER > 0.",{"_11692":902,"_44950":869,"_16990":89120,"_5":16526,"_23412":89039,"_7169":89121},[45444],"Monitor the amount of bytes being written to or read from HBase for a SQL statement. Metrics to use: MUTATION_BYTES and SCAN_BYTES.",{"_11692":903,"_44950":869,"_16990":89123,"_5":16526,"_23412":89039,"_7169":89124},[45444],"Check if the query is doing too much work or needs tuning. Possible metrics to use: TASK_EXECUTED_COUNTER, TASK_QUEUE_WAIT_TIME, WALL_CLOCK_TIME_MS.",{"_11692":904,"_44950":869,"_16990":89126,"_5":16526,"_23412":89039,"_7169":89127},[45444],"Check if a successful query is facing thread starvation, i.e., number of threads in the thread pool likely needs to be increased. This is characterized by a relatively large difference between TASK_EXECUTION_TIME and TASK_END_TO_END_TIME.",{"_11692":905,"_44950":869,"_16990":89129,"_5":16526,"_23412":89039,"_7169":89130},[45444],"Request level metrics can be turned on/off for every Phoenix JDBC connection. Below is an example of how you can do that:",{"_11692":906,"_44950":869,"_16990":89132,"_5":16526,"_23412":89039,"_7169":89133},[45444],"A typical pattern for how one could get hold of read metrics for queries:",{"_11692":907,"_44950":869,"_16990":89135,"_5":16526,"_23412":89039,"_7169":89136},[45444],"One could also get hold of write related metrics (collected per table) for DML statements by doing something like this:",{"_11692":908,"_44950":869,"_16990":89138,"_5":16526,"_23412":89039,"_7169":89139},[45444],"Global metrics on the other hand are collected at the Phoenix client’s JVM level. These metrics could be used for building out a trend and seeing what is going on within Phoenix from client’s perspective over time. Other than the metrics reported above for request level metrics, the global metrics also includes the following counters:",{"_11692":909,"_44950":869,"_16990":89141,"_5":16526,"_23412":89039,"_7169":89142},[45444],"MUTATION_SQL_COUNTER - Counter for number of mutation SQL statements",{"_11692":910,"_44950":869,"_16990":89144,"_5":16526,"_23412":89039,"_7169":89145},[45444],"SELECT_SQL_COUNTER - Counter for number of SQL queries",{"_11692":911,"_44950":869,"_16990":89147,"_5":16526,"_23412":89039,"_7169":89148},[45444],"OPEN_PHOENIX_CONNECTIONS_COUNTER - Number of open Phoenix connections",{"_11692":912,"_44950":869,"_16990":89150,"_5":16526,"_23412":89039,"_7169":89151},[45444],"Global metrics could be helpful in monitoring and tuning various aspects of the execution environment. For example: an increase in TASK_REJECTED_COUNTER is probably a symptom of too much work being submitted, or that the Phoenix thread pool queue depth or number of threads (or both) needs to be increased. Similarly, a spike in TASK_EXECUTION_TIME for a time frame could be symptomatic of several things including overloaded region servers, a network glitch, or client/region servers undergoing garbage collection.",{"_11692":913,"_44950":869,"_16990":89153,"_5":16526,"_23412":89039,"_7169":89154},[45444],"Collection of global client metrics can be turned on/off (on by default) by setting the attribute phoenix.query.global.metrics.enabled to true/false in the client side hbase-site.xml.\nBelow is a code snippet showing how to log/report global metrics by using a scheduled job that runs periodically:",{"_11692":914,"_44950":914,"_5":12121,"_7169":89156,"_45415":89157,"_16990":89158,"_23412":914},"Multi-tenancy",[86368,86369,86370,88058],[45444],{"_11692":915,"_44950":914,"_16990":89160,"_5":16526,"_23412":914,"_7169":89161},[45444],"Use multi-tenant tables, tenant-specific connections, and tenant views to isolate tenant data in Phoenix.",{"_11692":916,"_44950":914,"_5":45412,"_16990":89163,"_23412":89164,"_7169":89165},[45444],"/docs/features/multi-tenancy#highlights","Highlights",{"_11692":917,"_44950":914,"_5":45412,"_16990":89167,"_23412":89168,"_7169":89169},[45444],"/docs/features/multi-tenancy#multi-tenant-tables","Multi-tenant tables",{"_11692":918,"_44950":914,"_5":45412,"_16990":89171,"_23412":89172,"_7169":89173},[45444],"/docs/features/multi-tenancy#tenant-specific-connections","Tenant-specific connections",{"_11692":919,"_44950":914,"_5":45412,"_16990":89175,"_23412":89176,"_7169":89177},[45444],"/docs/features/multi-tenancy#tenant-specific-views-optional","Tenant-specific views (optional)",{"_11692":920,"_44950":914,"_5":45412,"_16990":89179,"_23412":89180,"_7169":89181},[45444],"/docs/features/multi-tenancy#tenant-data-isolation","Tenant data isolation",{"_11692":921,"_44950":914,"_16990":89183,"_5":16526,"_23412":89164,"_7169":89184},[45444],"Multi-tenancy in Phoenix works via a combination of multi-tenant tables and tenant-specific connections (detailed below).",{"_11692":922,"_44950":914,"_16990":89186,"_5":16526,"_23412":89164,"_7169":89187},[45444],"Tenants open tenant-specific connections to Phoenix. These connections can only access data that belongs to the tenant.",{"_11692":923,"_44950":914,"_16990":89189,"_5":16526,"_23412":89164,"_7169":89190},[45444],"Tenants only see their own data in multi-tenant tables and can see all data in regular tables.",{"_11692":924,"_44950":914,"_16990":89192,"_5":16526,"_23412":89164,"_7169":89193},[45444],"In order to add their own columns, tenants create tenant-specific views on top of multi-tenant tables and add their own columns to the views.",{"_11692":925,"_44950":914,"_16990":89195,"_5":16526,"_23412":89168,"_7169":89196},[45444],"Multi-tenant tables in Phoenix are regular tables declared with the MULTI_TENANT=true DDL property. They work in conjunction with tenant-specific connections (detailed below) to ensure tenants only see their own data in these tables. The first primary key column of a multi-tenant table identifies the tenant. For example:",{"_11692":926,"_44950":914,"_16990":89198,"_5":16526,"_23412":89168,"_7169":89199},[45444],"The column that identifies the tenant may have any name, but it must be of type VARCHAR or CHAR. Regular Phoenix connections work with these tables without tenant constraints, including access across tenant boundaries.",{"_11692":927,"_44950":914,"_16990":89201,"_5":16526,"_23412":89172,"_7169":89202},[45444],"Tenants are identified by the presence or absence of the TenantId property at JDBC connection time. A connection with a non-null TenantId is tenant-specific. A connection with an unspecified or null TenantId is a regular connection. A tenant-specific connection may query only:",{"_11692":928,"_44950":914,"_16990":89204,"_5":16526,"_23412":89172,"_7169":89205},[45444],"all data in non-multi-tenant (global) tables, that is, tables created with a regular connection without MULTI_TENANT=true.",{"_11692":929,"_44950":914,"_16990":89207,"_5":16526,"_23412":89172,"_7169":89208},[45444],"their own data in multi-tenant tables.",{"_11692":930,"_44950":914,"_16990":89210,"_5":16526,"_23412":89172,"_7169":89211},[45444],"their own schema, meaning it sees only tenant-specific views created by that tenant (detailed below).",{"_11692":931,"_44950":914,"_16990":89213,"_5":16526,"_23412":89172,"_7169":89214},[45444],"For example, a tenant-specific connection is established like this:",{"_11692":932,"_44950":914,"_16990":89216,"_5":16526,"_23412":89176,"_7169":89217},[45444],"Tenant-specific views may only be created using tenant-specific connections. They are created the same way as views, however the base table must be a multi-tenant table or another view that eventually points to one. Tenant-specific views are typically used when new columns and/or filter criteria, specific to that tenant, are required. Otherwise the base table may be used directly through a tenant-specific connection as described above.",{"_11692":933,"_44950":914,"_16990":89219,"_5":16526,"_23412":89176,"_7169":89220},[45444],"For example, a tenant-specific view may be defined as follows:",{"_11692":934,"_44950":914,"_16990":89222,"_5":16526,"_23412":89176,"_7169":89223},[45444],"The tenant_id column is neither visible nor accessible from a tenant-specific view. Any reference to it causes a ColumnNotFoundException. As with any Phoenix view, whether the view is updatable follows the rules described here. In addition, indexes may be added to tenant-specific views just like regular tables and views (with these limitations).",{"_11692":935,"_44950":914,"_16990":89225,"_5":16526,"_23412":89180,"_7169":89226},[45444],"Any DML or query performed on multi-tenant tables using a tenant-specific connection is automatically constrained to that tenant’s data. For UPSERT, Phoenix automatically populates the tenant_id column with the tenant ID specified at connection time. For query and DELETE operations, a WHERE clause is transparently added so operations only see data for the current tenant.",{"_11692":936,"_44950":936,"_5":12121,"_7169":89228,"_45415":89229,"_16990":89230,"_23412":936},"Namespace Mapping",[86368,86369,86370,88058],[45444],{"_11692":937,"_44950":936,"_16990":89232,"_5":16526,"_23412":936,"_7169":89233},[45444],"Enable Phoenix schema-to-namespace mapping in HBase, including configuration, migration, and behavior by table type.",{"_11692":938,"_44950":936,"_5":45412,"_16990":89235,"_23412":89236,"_7169":86420},[45444],"/docs/features/namespace-mapping#namespace-mapping-configuration",{"_11692":939,"_44950":936,"_5":45412,"_16990":89238,"_23412":89239,"_7169":89240},[45444],"/docs/features/namespace-mapping#grammar-available","Grammar available",{"_11692":940,"_44950":936,"_5":45412,"_16990":89242,"_23412":89243,"_7169":87712},[45444],"/docs/features/namespace-mapping#namespace-mapping-faq",{"_11692":941,"_44950":936,"_5":45412,"_16990":89245,"_23412":89246,"_7169":89247},[45444],"/docs/features/namespace-mapping#how-to-migrate-existing-tables-with-schema-to-namespace","How to migrate existing tables with schema to namespace",{"_11692":942,"_44950":936,"_5":45412,"_16990":89249,"_23412":89250,"_7169":89251},[45444],"/docs/features/namespace-mapping#how-are-system-tables-migrated","How are system tables migrated",{"_11692":943,"_44950":936,"_5":45412,"_16990":89253,"_23412":89254,"_7169":89255},[45444],"/docs/features/namespace-mapping#what-permissions-are-required-to-create-and-drop-schema","What permissions are required to CREATE and DROP SCHEMA",{"_11692":944,"_44950":936,"_5":45412,"_16990":89257,"_23412":89258,"_7169":89259},[45444],"/docs/features/namespace-mapping#how-are-schemas-mapped-for-different-table-types","How are schemas mapped for different table types",{"_11692":945,"_44950":936,"_5":45412,"_16990":89261,"_23412":89262,"_7169":89263},[45444],"/docs/features/namespace-mapping#what-is-a-namespace-and-what-are-the-benefits-of-mapping-tables-to-namespaces","What is a namespace and what are the benefits of mapping tables to namespaces",{"_11692":946,"_44950":936,"_5":45412,"_16990":89265,"_23412":89266,"_7169":89267},[45444],"/docs/features/namespace-mapping#namespace-mapping-resources","Resources",{"_11692":947,"_44950":936,"_16990":89269,"_5":16526,"_23412":936,"_7169":89270},[45444],"From v4.8.0 onward, users can map Phoenix schemas to HBase namespaces so that any table created with a schema is created in the corresponding HBase namespace.",{"_11692":948,"_44950":936,"_16990":89272,"_5":16526,"_23412":936,"_7169":89273},[45444],"Earlier, every table (with or without schema) was created in the default namespace.",{"_11692":949,"_44950":936,"_16990":89275,"_5":16526,"_23412":89236,"_7169":89276},[45444],"Parameters to enable namespace mapping:",{"_11692":950,"_44950":936,"_16990":89278,"_5":16526,"_23412":89236,"_7169":89279},[45444],"Property",{"_11692":951,"_44950":936,"_16990":89281,"_5":16526,"_23412":89236,"_7169":88444},[45444],{"_11692":952,"_44950":936,"_16990":89283,"_5":16526,"_23412":89236,"_7169":89284},[45444],"Default",{"_11692":953,"_44950":936,"_16990":89286,"_5":16526,"_23412":89236,"_7169":89287},[45444],"phoenix.schema.isNamespaceMappingEnabled",{"_11692":954,"_44950":936,"_16990":89289,"_5":16526,"_23412":89236,"_7169":89290},[45444],"If enabled, tables created with a schema are mapped to the corresponding namespace. This must be set on both client and server. Once enabled, it should not be rolled back. Older clients will not work after this property is enabled.",{"_11692":955,"_44950":936,"_16990":89292,"_5":16526,"_23412":89236,"_7169":24355},[45444],{"_11692":956,"_44950":936,"_16990":89294,"_5":16526,"_23412":89236,"_7169":89295},[45444],"phoenix.schema.mapSystemTablesToNamespace",{"_11692":957,"_44950":936,"_16990":89297,"_5":16526,"_23412":89236,"_7169":89298},[45444],"This takes effect when phoenix.schema.isNamespaceMappingEnabled is also set to true. If enabled, existing SYSTEM tables are automatically migrated to the SYSTEM namespace. If disabled, system tables are created only in the default namespace. This must be set on both client and server.",{"_11692":958,"_44950":936,"_16990":89300,"_5":16526,"_23412":89236,"_7169":15248},[45444],{"_11692":959,"_44950":936,"_16990":89302,"_5":16526,"_23412":89239,"_7169":89303},[45444],"The following DDL statements can be used to interact with schemas:",{"_11692":960,"_44950":936,"_16990":89305,"_5":16526,"_23412":89239,"_7169":89306},[45444],"CREATE SCHEMA",{"_11692":961,"_44950":936,"_16990":89308,"_5":16526,"_23412":89239,"_7169":89309},[45444],"USE SCHEMA",{"_11692":962,"_44950":936,"_16990":89311,"_5":16526,"_23412":89239,"_7169":89312},[45444],"DROP SCHEMA",{"_11692":963,"_44950":936,"_16990":89314,"_5":16526,"_23412":89243,"_7169":89315},[45444],"How to migrate existing tables with schema to namespace?",{"_11692":964,"_44950":936,"_16990":89317,"_5":16526,"_23412":89243,"_7169":89318},[45444],"How are system tables migrated?",{"_11692":965,"_44950":936,"_16990":89320,"_5":16526,"_23412":89243,"_7169":89321},[45444],"What permissions are required to CREATE and DROP SCHEMA?",{"_11692":966,"_44950":936,"_16990":89323,"_5":16526,"_23412":89243,"_7169":89324},[45444],"How are schemas mapped for different table types?",{"_11692":967,"_44950":936,"_16990":89326,"_5":16526,"_23412":89243,"_7169":89327},[45444],"What is a namespace and what are the benefits of mapping tables to namespaces?",{"_11692":968,"_44950":936,"_16990":89329,"_5":16526,"_23412":89246,"_7169":89330},[45444],"For a Kerberized environment, run with a user that has sufficient permission (admin) to create a namespace.",{"_11692":969,"_44950":936,"_16990":89332,"_5":16526,"_23412":89246,"_7169":89333},[45444],"A table is mapped only to a namespace with the same name as the schema (schema_name). Currently, migrating an existing table to a different schema or namespace is not supported.",{"_11692":970,"_44950":936,"_16990":89335,"_5":16526,"_23412":89246,"_7169":87892},[45444],{"_11692":971,"_44950":936,"_16990":89337,"_5":16526,"_23412":89246,"_7169":89338},[45444],"Move table_name to the namespace named schema_name:",{"_11692":972,"_44950":936,"_16990":89340,"_5":16526,"_23412":89250,"_7169":89341},[45444],"SYSTEM tables are migrated automatically during the first connection after enabling phoenix.schema.mapSystemTablesToNamespace along with phoenix.schema.isNamespaceMappingEnabled.",{"_11692":973,"_44950":936,"_16990":89343,"_5":16526,"_23412":89254,"_7169":89344},[45444],"Users must have admin permission in HBase to execute CREATE SCHEMA and DROP SCHEMA, since these commands internally create or delete namespaces.",{"_11692":974,"_44950":936,"_16990":89346,"_5":16526,"_23412":89254,"_7169":89347},[45444],"Details for ACL management in HBase can be found here.",{"_11692":975,"_44950":936,"_16990":89349,"_5":16526,"_23412":89258,"_7169":89350},[45444],"Schema support in Phoenix is similar to other databases.",{"_11692":976,"_44950":936,"_16990":89352,"_5":16526,"_23412":89258,"_7169":89353},[45444],"The table below describes how physical tables map to Phoenix objects:",{"_11692":977,"_44950":936,"_16990":89355,"_5":16526,"_23412":89258,"_7169":89356},[45444],"DDL",{"_11692":978,"_44950":936,"_16990":89358,"_5":16526,"_23412":89258,"_7169":89359},[45444],"Table Type",{"_11692":979,"_44950":936,"_16990":89361,"_5":16526,"_23412":89258,"_7169":89362},[45444],"Physical Table",{"_11692":980,"_44950":936,"_16990":89364,"_5":16526,"_23412":89258,"_7169":88444},[45444],{"_11692":981,"_44950":936,"_16990":89366,"_5":16526,"_23412":89258,"_7169":89367},[45444],"CREATE TABLE S.T (ID INTEGER PRIMARY KEY)",{"_11692":982,"_44950":936,"_16990":89369,"_5":16526,"_23412":89258,"_7169":89370},[45444],"TABLE",{"_11692":983,"_44950":936,"_16990":89372,"_5":16526,"_23412":89258,"_7169":89373},[45444],"S:T",{"_11692":984,"_44950":936,"_16990":89375,"_5":16526,"_23412":89258,"_7169":89376},[45444],"Table T is created in namespace S.",{"_11692":985,"_44950":936,"_16990":89378,"_5":16526,"_23412":89258,"_7169":89379},[45444],"CREATE INDEX IDX ON S.T(ID)",{"_11692":986,"_44950":936,"_16990":89381,"_5":16526,"_23412":89258,"_7169":89382},[45444],"INDEX",{"_11692":987,"_44950":936,"_16990":89384,"_5":16526,"_23412":89258,"_7169":89385},[45444],"S:IDX",{"_11692":988,"_44950":936,"_16990":89387,"_5":16526,"_23412":89258,"_7169":89388},[45444],"Indexes inherit schema and namespace from the base table.",{"_11692":989,"_44950":936,"_16990":89390,"_5":16526,"_23412":89258,"_7169":89391},[45444],"CREATE VIEW V AS SELECT * FROM S.T",{"_11692":990,"_44950":936,"_16990":89393,"_5":16526,"_23412":89258,"_7169":89394},[45444],"VIEW with default schema",{"_11692":991,"_44950":936,"_16990":89396,"_5":16526,"_23412":89258,"_7169":89373},[45444],{"_11692":992,"_44950":936,"_16990":89398,"_5":16526,"_23412":89258,"_7169":89399},[45444],"View does not inherit schema from the parent table and can use the default schema.",{"_11692":993,"_44950":936,"_16990":89401,"_5":16526,"_23412":89258,"_7169":89402},[45444],"CREATE VIEW X.V AS SELECT * FROM S.T",{"_11692":994,"_44950":936,"_16990":89404,"_5":16526,"_23412":89258,"_7169":89405},[45444],"VIEW with different schema than physical table",{"_11692":995,"_44950":936,"_16990":89407,"_5":16526,"_23412":89258,"_7169":89373},[45444],{"_11692":996,"_44950":936,"_16990":89409,"_5":16526,"_23412":89258,"_7169":89410},[45444],"View uses the parent physical table and can have a different (or same) schema.",{"_11692":997,"_44950":936,"_16990":89412,"_5":16526,"_23412":89258,"_7169":89413},[45444],"CREATE VIEW S.V AS SELECT * FROM S.T",{"_11692":998,"_44950":936,"_16990":89415,"_5":16526,"_23412":89258,"_7169":89416},[45444],"VIEW with same schema as physical table",{"_11692":999,"_44950":936,"_16990":89418,"_5":16526,"_23412":89258,"_7169":89373},[45444],{"_11692":1000,"_44950":936,"_16990":89420,"_5":16526,"_23412":89258,"_7169":89410},[45444],{"_11692":1001,"_44950":936,"_16990":89422,"_5":16526,"_23412":89258,"_7169":89423},[45444],"CREATE INDEX IDX ON S.V(ID)",{"_11692":1002,"_44950":936,"_16990":89425,"_5":16526,"_23412":89258,"_7169":89426},[45444],"VIEW INDEX",{"_11692":1003,"_44950":936,"_16990":89428,"_5":16526,"_23412":89258,"_7169":89429},[45444],"S:_IDX_T",{"_11692":1004,"_44950":936,"_16990":89431,"_5":16526,"_23412":89258,"_7169":89432},[45444],"View indexes inherit schema and map to the corresponding namespace.",{"_11692":1005,"_44950":936,"_16990":89434,"_5":16526,"_23412":89262,"_7169":89435},[45444],"A namespace is a logical grouping of tables, analogous to a database in relational database systems. This abstraction lays the groundwork for multi-tenancy-related features:",{"_11692":1006,"_44950":936,"_16990":89437,"_5":16526,"_23412":89262,"_7169":89438},[45444],"Quota Management - Restrict the amount of resources (i.e. regions, tables) a namespace can consume.",{"_11692":1007,"_44950":936,"_16990":89440,"_5":16526,"_23412":89262,"_7169":89441},[45444],"Namespace Security Administration - Provide another level of security administration for tenants.",{"_11692":1008,"_44950":936,"_16990":89443,"_5":16526,"_23412":89262,"_7169":89444},[45444],"Region server groups - A namespace/table can be pinned to a subset of RegionServers, guaranteeing a coarse level of isolation.",{"_11692":1009,"_44950":936,"_16990":89446,"_5":16526,"_23412":89262,"_7169":89447},[45444],"Details about namespace management can be read here.",{"_11692":1010,"_44950":936,"_16990":89449,"_5":16526,"_23412":89266,"_7169":89450},[45444],"PHOENIX-1311: Implementation details and discussion for the namespace mapping feature.",{"_11692":1011,"_44950":1011,"_5":12121,"_7169":89452,"_45415":89453,"_16990":89454,"_23412":1011},"Paged Queries",[86368,86369,86370,88058],[45444],{"_11692":1012,"_44950":1011,"_16990":89456,"_5":16526,"_23412":1011,"_7169":89457},[45444],"Use row value constructors and OFFSET/LIMIT for efficient paged query patterns in Phoenix.",{"_11692":1013,"_44950":1011,"_5":45412,"_16990":89459,"_23412":89460,"_7169":89461},[45444],"/docs/features/paged-queries#row-value-constructors-rvc","Row Value Constructors (RVC)",{"_11692":1014,"_44950":1011,"_5":45412,"_16990":89463,"_23412":89464,"_7169":89465},[45444],"/docs/features/paged-queries#offset-with-limit","OFFSET with LIMIT",{"_11692":1015,"_44950":1011,"_16990":89467,"_5":16526,"_23412":1011,"_7169":89468},[45444],"Phoenix supports standard SQL constructs to enable paged queries:",{"_11692":1016,"_44950":1011,"_16990":89470,"_5":16526,"_23412":1011,"_7169":89461},[45444],{"_11692":1017,"_44950":1011,"_16990":89472,"_5":16526,"_23412":1011,"_7169":89465},[45444],{"_11692":1018,"_44950":1011,"_16990":89474,"_5":16526,"_23412":89460,"_7169":89475},[45444],"A row value constructor is an ordered sequence of values delimited by parentheses. For example:",{"_11692":1019,"_44950":1011,"_16990":89477,"_5":16526,"_23412":89460,"_7169":89478},[45444],"Just like regular values, row value constructors may be used in comparison expressions:",{"_11692":1020,"_44950":1011,"_16990":89480,"_5":16526,"_23412":89460,"_7169":89481},[45444],"Row value constructors are compared by conceptually concatenating the values together and comparing them against each other, with the leftmost part being most significant. Section 8.2 (comparison predicates) of the SQL-92 standard explains this in detail, but here are a few examples of predicates that would evaluate to true:",{"_11692":1021,"_44950":1011,"_16990":89483,"_5":16526,"_23412":89460,"_7169":89484},[45444],"Row value constructors may also be used in an IN list expression to efficiently query for a set of rows given the composite primary key columns. For example, the following would be optimized to be a point get of three rows:",{"_11692":1022,"_44950":1011,"_16990":89486,"_5":16526,"_23412":89460,"_7169":89487},[45444],"Another primary use case for row value constructors is to support query-more type functionality by enabling an ordered set of rows to be incrementally stepped through. For example, the following query would step through a set of rows, 20 rows at a time:",{"_11692":1023,"_44950":1011,"_16990":89489,"_5":16526,"_23412":89460,"_7169":89490},[45444],"Assuming that the client binds the three bind variables to the values of the last row processed, the next invocation would find the next 20 rows that match the query. If the columns you supply in your row value constructor match in order the columns from your primary key (or from a secondary index), then Phoenix will be able to turn the row value constructor expression into the start row of your scan. This enables a very efficient mechanism to locate at or after a row.",{"_11692":1024,"_44950":1011,"_16990":89492,"_5":16526,"_23412":89464,"_7169":89493},[45444],"Use OFFSET to specify the starting row offset into the result set returned by your query and LIMIT to specify the page size.",{"_11692":1025,"_44950":1011,"_16990":89495,"_5":16526,"_23412":89464,"_7169":89496},[45444],"For example, if page size is 10, then to select the second page, the following query can be used (rows 11 to 20 are returned):",{"_11692":1026,"_44950":1011,"_16990":89498,"_5":16526,"_23412":89464,"_7169":89499},[45444],"OFFSET reads and skips rows on either the server or client depending on query type, whereas RVC is more effective for queries on the primary key axis because it can start directly from the provided key.",{"_11692":1027,"_44950":1027,"_5":12121,"_7169":89501,"_45415":89502,"_16990":89503,"_23412":1027},"Query Server",[86368,86369,86370,88058],[45444],{"_11692":1028,"_44950":1027,"_16990":89505,"_5":16526,"_23412":1027,"_7169":89506},[45444],"Deploy and use Phoenix Query Server (PQS), including client access, impersonation, metrics, and load-balancing configuration.",{"_11692":1029,"_44950":1027,"_5":45412,"_16990":89508,"_23412":89509,"_7169":89510},[45444],"/docs/features/query-server#query-server-overview","Overview",{"_11692":1030,"_44950":1027,"_5":45412,"_16990":89512,"_23412":89513,"_7169":89514},[45444],"/docs/features/query-server#clients","Clients",{"_11692":1031,"_44950":1027,"_5":45412,"_16990":89516,"_23412":89517,"_7169":89518},[45444],"/docs/features/query-server#query-server-installation","Installation",{"_11692":1032,"_44950":1027,"_5":45412,"_16990":89520,"_23412":89521,"_7169":89522},[45444],"/docs/features/query-server#query-server-usage","Usage",{"_11692":1033,"_44950":1027,"_5":45412,"_16990":89524,"_23412":89525,"_7169":89526},[45444],"/docs/features/query-server#server","Server",{"_11692":1034,"_44950":1027,"_5":45412,"_16990":89528,"_23412":89529,"_7169":89530},[45444],"/docs/features/query-server#client","Client",{"_11692":1035,"_44950":1027,"_5":45412,"_16990":89532,"_23412":89533,"_7169":89534},[45444],"/docs/features/query-server#wire-api-documentation","Wire API documentation",{"_11692":1036,"_44950":1027,"_5":45412,"_16990":89536,"_23412":89537,"_7169":89538},[45444],"/docs/features/query-server#impersonation","Impersonation",{"_11692":1037,"_44950":1027,"_5":45412,"_16990":89540,"_23412":89541,"_7169":89015},[45444],"/docs/features/query-server#query-server-metrics",{"_11692":1038,"_44950":1027,"_5":45412,"_16990":89543,"_23412":89544,"_7169":86420},[45444],"/docs/features/query-server#query-server-configuration",{"_11692":1039,"_44950":1027,"_5":45412,"_16990":89546,"_23412":89547,"_7169":89548},[45444],"/docs/features/query-server#server-instantiation","Server Instantiation",{"_11692":1040,"_44950":1027,"_5":45412,"_16990":89550,"_23412":89551,"_7169":89552},[45444],"/docs/features/query-server#https","HTTPS",{"_11692":1041,"_44950":1027,"_5":45412,"_16990":89554,"_23412":89555,"_7169":89556},[45444],"/docs/features/query-server#secure-cluster-connection","Secure Cluster Connection",{"_11692":1042,"_44950":1027,"_5":45412,"_16990":89558,"_23412":89559,"_7169":89560},[45444],"/docs/features/query-server#server-connection-cache","Server Connection Cache",{"_11692":1043,"_44950":1027,"_5":45412,"_16990":89562,"_23412":89563,"_7169":89564},[45444],"/docs/features/query-server#server-statement-cache","Server Statement Cache",{"_11692":1044,"_44950":1027,"_5":45412,"_16990":89566,"_23412":89567,"_7169":89538},[45444],"/docs/features/query-server#impersonation-1",{"_11692":1045,"_44950":1027,"_5":45412,"_16990":89569,"_23412":89570,"_7169":89015},[45444],"/docs/features/query-server#query-server-metrics-config",{"_11692":1046,"_44950":1027,"_5":45412,"_16990":89572,"_23412":89573,"_7169":89574},[45444],"/docs/features/query-server#query-server-additions","Query Server Additions",{"_11692":1047,"_44950":1027,"_5":45412,"_16990":89576,"_23412":89577,"_7169":89578},[45444],"/docs/features/query-server#load-balancing","Load balancing",{"_11692":1048,"_44950":1027,"_16990":89580,"_5":16526,"_23412":1027,"_7169":89581},[45444],"The Phoenix Query Server provides an alternative means for interaction with\nPhoenix and HBase.",{"_11692":1049,"_44950":1027,"_16990":89583,"_5":16526,"_23412":89509,"_7169":89584},[45444],"Phoenix 4.4 introduces a stand-alone server that exposes Phoenix to \"thin\"\nclients. It is based on the Avatica component of\nApache Calcite. The query server is comprised of a Java server that\nmanages Phoenix Connections on the clients' behalf.",{"_11692":1050,"_44950":1027,"_16990":89586,"_5":16526,"_23412":89509,"_7169":89587},[45444],"With the introduction of the\nProtobuf transport, Avatica is moving towards backwards compatibility with the\nprovided thin JDBC driver. There are no such backwards compatibility guarantees\nfor the JSON API.",{"_11692":1051,"_44950":1027,"_16990":89589,"_5":16526,"_23412":89509,"_7169":89590},[45444],"To repeat, there is no guarantee of backwards compatibility with the JSON transport;\nhowever, compatibility with the Protobuf transport is stabilizing (although, not\ntested thoroughly enough to be stated as \"guaranteed\").",{"_11692":1052,"_44950":1027,"_16990":89592,"_5":16526,"_23412":89513,"_7169":89593},[45444],"The primary client implementation\nis currently a JDBC driver with minimal dependencies. The default and\nprimary transport mechanism since Phoenix 4.7 is Protobuf, the older JSON mechanism can still\nbe enabled.\nThe distribution includes the sqlline-thin.py CLI client that uses the JDBC thin client.",{"_11692":1053,"_44950":1027,"_16990":89595,"_5":16526,"_23412":89513,"_7169":89596},[45444],"The Phoenix project also maintains the Python driver\nphoenixdb.",{"_11692":1054,"_44950":1027,"_16990":89598,"_5":16526,"_23412":89513,"_7169":89599},[45444],"The Avatica Go client\ncan also be used.",{"_11692":1055,"_44950":1027,"_16990":89601,"_5":16526,"_23412":89513,"_7169":89602},[45444],"Proprietary ODBC drivers are also available for Windows and Linux.",{"_11692":1056,"_44950":1027,"_16990":89604,"_5":16526,"_23412":89517,"_7169":89605},[45444],"In the 4.4-4.14 and 5.0 releases the query server and its JDBC client are part of the standard Phoenix\ndistribution. They require no additional dependencies or installation.",{"_11692":1057,"_44950":1027,"_16990":89607,"_5":16526,"_23412":89517,"_7169":89608},[45444],"After the 4.15 and 5.1 release, the query server has been unbundled into the phoenix-queryserver\nrepository, and its version number has been reset to 6.0.",{"_11692":1058,"_44950":1027,"_16990":89610,"_5":16526,"_23412":89517,"_7169":89611},[45444],"Download the latest source or binary release from the\nDownload page,\nor check out the development version from\nGitHub.",{"_11692":1059,"_44950":1027,"_16990":89613,"_5":16526,"_23412":89517,"_7169":89614},[45444],"Either unpack the binary distribution, or build it from source. See BUILDING.md\nin the source distribution on how to build.",{"_11692":1060,"_44950":1027,"_16990":89616,"_5":16526,"_23412":89525,"_7169":89617},[45444],"The standalone Query Server distribution does not contain the necessary\nPhoenix (thick) client library by default.",{"_11692":1061,"_44950":1027,"_16990":89619,"_5":16526,"_23412":89525,"_7169":89620},[45444],"If using the standalone library you will either need to rebuild it from source to include the\nclient library (See BUILDING.md), or manually copy the phoenix thick client library\ninto the installation directory.",{"_11692":1062,"_44950":1027,"_16990":89622,"_5":16526,"_23412":89525,"_7169":89623},[45444],"The server component is managed through bin/queryserver.py. Its usage is as\nfollows",{"_11692":1063,"_44950":1027,"_16990":89625,"_5":16526,"_23412":89525,"_7169":89626},[45444],"When invoked with no arguments, the query server is launched in the foreground,\nwith logging directed to the console.",{"_11692":1064,"_44950":1027,"_16990":89628,"_5":16526,"_23412":89525,"_7169":89629},[45444],"The first argument is an optional start or stop command to the daemon. When\neither of these are provided, it will take appropriate action on a daemon\nprocess, if it exists.",{"_11692":1065,"_44950":1027,"_16990":89631,"_5":16526,"_23412":89525,"_7169":89632},[45444],"Any subsequent arguments are passed to the main class for interpretation.",{"_11692":1066,"_44950":1027,"_16990":89634,"_5":16526,"_23412":89525,"_7169":89635},[45444],"The server is packaged in a standalone jar,\nphoenix-queryserver-<version>.jar. This jar, the phoenix-client.jar and HBASE_CONF_DIR on the\nclasspath are all that is required to launch the server.",{"_11692":1067,"_44950":1027,"_16990":89637,"_5":16526,"_23412":89529,"_7169":89638},[45444],"Phoenix provides two mechanisms for interacting with the query server. A JDBC\ndriver is provided in the standalone\nphoenix-queryserver-client-<version>.jar. The script\nbin/sqlline-thin.py is available for the command line.",{"_11692":1068,"_44950":1027,"_16990":89640,"_5":16526,"_23412":89529,"_7169":89641},[45444],"The JDBC connection string is composed as follows:",{"_11692":1069,"_44950":1027,"_16990":89643,"_5":16526,"_23412":89529,"_7169":89644},[45444],"<scheme> specifies the transport protocol (http or https) used when communicating with the\nserver.",{"_11692":1070,"_44950":1027,"_16990":89646,"_5":16526,"_23412":89529,"_7169":89647},[45444],"<server-hostname> is the name of the host offering the service.",{"_11692":1071,"_44950":1027,"_16990":89649,"_5":16526,"_23412":89529,"_7169":89650},[45444],"<port> is the port number on which the host is listening. Default is 8765,\nthough this is configurable (see below).",{"_11692":1072,"_44950":1027,"_16990":89652,"_5":16526,"_23412":89529,"_7169":89653},[45444],"The full list of options that can be provided via the JDBC URL string is available\nin the Avatica documentation.",{"_11692":1073,"_44950":1027,"_16990":89655,"_5":16526,"_23412":89529,"_7169":89656},[45444],"The script bin/sqlline-thin.py is intended to behave identically to its\nsibling script bin/sqlline.py. It supports the following usage options.",{"_11692":1074,"_44950":1027,"_16990":89658,"_5":16526,"_23412":89529,"_7169":89659},[45444],"The first optional argument is a connection URL, as described previously. When\nnot provided, scheme defaults to http, host to localhost, and port to\n8765.",{"_11692":1075,"_44950":1027,"_16990":89661,"_5":16526,"_23412":89529,"_7169":89662},[45444],"The second optional parameter is a sql file from which to read commands.",{"_11692":1076,"_44950":1027,"_16990":89664,"_5":16526,"_23412":89533,"_7169":89665},[45444],"The API itself is documented in the Apache Calcite project as it is the Avatica\nAPI -- there is no wire API defined in Phoenix itself.",{"_11692":1077,"_44950":1027,"_16990":89667,"_5":16526,"_23412":89533,"_7169":89668},[45444],"JSON API",{"_11692":1078,"_44950":1027,"_16990":89670,"_5":16526,"_23412":89533,"_7169":89671},[45444],"Protocol Buffer API",{"_11692":1079,"_44950":1027,"_16990":89673,"_5":16526,"_23412":89533,"_7169":89674},[45444],"For more information in building clients in other languages that work with\nAvatica, please feel free to reach out to the Apache Calcite dev mailing list.",{"_11692":1080,"_44950":1027,"_16990":89676,"_5":16526,"_23412":89537,"_7169":89677},[45444],"By default, the Phoenix Query Server executes queries on behalf of the end-user. HBase permissions\nare enforced given the end-user, not the Phoenix Query Server's identity. In some cases, it may\nbe desirable to execute the query as some other user -- this is referred to as \"impersonation\".\nThis can enable workflows where a trusted user has the privilege to run queries for other users.",{"_11692":1081,"_44950":1027,"_16990":89679,"_5":16526,"_23412":89537,"_7169":89680},[45444],"This can be enabled by setting the configuration property phoenix.queryserver.withRemoteUserExtractor\nto true. The URL of the Query Server can be modified to include the required request parameter.\nFor example, to let \"bob\" to run a query as \"alice\", the following JDBC URL could be used:",{"_11692":1082,"_44950":1027,"_16990":89682,"_5":16526,"_23412":89537,"_7169":89683},[45444],"The standard Hadoop \"proxyuser\" configuration keys are checked to validate if the \"real\" remote user\nis allowed to impersonate the \"doAs\" user. See the Hadoop documentation\nfor more information on how to configure these rules.",{"_11692":1083,"_44950":1027,"_16990":89685,"_5":16526,"_23412":89537,"_7169":89686},[45444],"As a word of warning: there is no end-to-end test coverage for the HBase 0.98 and 1.1 Phoenix releases\nbecause of missing test-related code in those HBase releases. While we expect no issues on these\nPhoenix release lines, we recommend additional testing by the user to verify that there are no issues.",{"_11692":1084,"_44950":1027,"_16990":89688,"_5":16526,"_23412":89541,"_7169":89689},[45444],"By default, the Phoenix Query Server exposes various Phoenix global client metrics via JMX (for HBase versions 1.3 and up).\nThe list of metrics are available here.",{"_11692":1085,"_44950":1027,"_16990":89691,"_5":16526,"_23412":89541,"_7169":89692},[45444],"PQS Metrics use Hadoop Metrics 2 internally for metrics publishing. Hence it publishes various JVM related metrics. Metrics can be filtered based on certain tags, which can be configured by the property specified in hbase-site.xml on the classpath. Further details are provided in Configuration section.",{"_11692":1086,"_44950":1027,"_16990":89694,"_5":16526,"_23412":89544,"_7169":89695},[45444],"Server components are spread across a number of java packages, so effective\nlogging configuration requires updating multiple packages. The default server\nlogging configuration sets the following log levels:",{"_11692":1087,"_44950":1027,"_16990":89697,"_5":16526,"_23412":89544,"_7169":89698},[45444],"As of the time of writing, the underlying Avatica component respects the\nfollowing configuration options exposed via hbase-site.xml.",{"_11692":1088,"_44950":1027,"_16990":89700,"_5":16526,"_23412":89547,"_7169":89279},[45444],{"_11692":1089,"_44950":1027,"_16990":89702,"_5":16526,"_23412":89547,"_7169":88444},[45444],{"_11692":1090,"_44950":1027,"_16990":89704,"_5":16526,"_23412":89547,"_7169":89284},[45444],{"_11692":1091,"_44950":1027,"_16990":89706,"_5":16526,"_23412":89547,"_7169":89707},[45444],"phoenix.queryserver.http.port",{"_11692":1092,"_44950":1027,"_16990":89709,"_5":16526,"_23412":89547,"_7169":89710},[45444],"Port the server listens on.",{"_11692":1093,"_44950":1027,"_16990":89712,"_5":16526,"_23412":89547,"_7169":44703},[45444],{"_11692":1094,"_44950":1027,"_16990":89714,"_5":16526,"_23412":89547,"_7169":89715},[45444],"phoenix.queryserver.metafactory.class",{"_11692":1095,"_44950":1027,"_16990":89717,"_5":16526,"_23412":89547,"_7169":89718},[45444],"Avatica Meta.Factory implementation class.",{"_11692":1096,"_44950":1027,"_16990":89720,"_5":16526,"_23412":89547,"_7169":89721},[45444],"org.apache.phoenix.queryserver.server.PhoenixMetaFactoryImpl",{"_11692":1097,"_44950":1027,"_16990":89723,"_5":16526,"_23412":89547,"_7169":89724},[45444],"phoenix.queryserver.serialization",{"_11692":1098,"_44950":1027,"_16990":89726,"_5":16526,"_23412":89547,"_7169":89727},[45444],"Transport/serialization format (PROTOBUF or JSON).",{"_11692":1099,"_44950":1027,"_16990":89729,"_5":16526,"_23412":89547,"_7169":89730},[45444],"PROTOBUF",{"_11692":1100,"_44950":1027,"_16990":89732,"_5":16526,"_23412":89551,"_7169":89733},[45444],"HTTPS support is only available in unbundled phoenix-queryserver versions.",{"_11692":1101,"_44950":1027,"_16990":89735,"_5":16526,"_23412":89551,"_7169":89279},[45444],{"_11692":1102,"_44950":1027,"_16990":89737,"_5":16526,"_23412":89551,"_7169":88444},[45444],{"_11692":1103,"_44950":1027,"_16990":89739,"_5":16526,"_23412":89551,"_7169":89284},[45444],{"_11692":1104,"_44950":1027,"_16990":89741,"_5":16526,"_23412":89551,"_7169":89742},[45444],"phoenix.queryserver.tls.enabled",{"_11692":1105,"_44950":1027,"_16990":89744,"_5":16526,"_23412":89551,"_7169":89745},[45444],"Enables HTTPS transport. When enabled, keystore/truststore files and passwords are also required.",{"_11692":1106,"_44950":1027,"_16990":89747,"_5":16526,"_23412":89551,"_7169":24355},[45444],{"_11692":1107,"_44950":1027,"_16990":89749,"_5":16526,"_23412":89551,"_7169":89750},[45444],"phoenix.queryserver.tls.keystore",{"_11692":1108,"_44950":1027,"_16990":89752,"_5":16526,"_23412":89551,"_7169":89753},[45444],"Keystore file containing the HTTPS private key.",{"_11692":1109,"_44950":1027,"_16990":89755,"_5":16526,"_23412":89551,"_7169":23276},[45444],{"_11692":1110,"_44950":1027,"_16990":89757,"_5":16526,"_23412":89551,"_7169":89758},[45444],"phoenix.queryserver.tls.keystore.password",{"_11692":1111,"_44950":1027,"_16990":89760,"_5":16526,"_23412":89551,"_7169":89761},[45444],"Password for HTTPS keystore.",{"_11692":1112,"_44950":1027,"_16990":89763,"_5":16526,"_23412":89551,"_7169":89764},[45444],"empty string",{"_11692":1113,"_44950":1027,"_16990":89766,"_5":16526,"_23412":89551,"_7169":89767},[45444],"phoenix.queryserver.tls.truststore",{"_11692":1114,"_44950":1027,"_16990":89769,"_5":16526,"_23412":89551,"_7169":89770},[45444],"Keystore file containing the HTTPS certificate.",{"_11692":1115,"_44950":1027,"_16990":89772,"_5":16526,"_23412":89551,"_7169":23276},[45444],{"_11692":1116,"_44950":1027,"_16990":89774,"_5":16526,"_23412":89551,"_7169":89775},[45444],"phoenix.queryserver.tls.truststore.password",{"_11692":1117,"_44950":1027,"_16990":89777,"_5":16526,"_23412":89551,"_7169":89778},[45444],"Password for HTTPS truststore.",{"_11692":1118,"_44950":1027,"_16990":89780,"_5":16526,"_23412":89551,"_7169":89764},[45444],{"_11692":1119,"_44950":1027,"_16990":89782,"_5":16526,"_23412":89555,"_7169":89279},[45444],{"_11692":1120,"_44950":1027,"_16990":89784,"_5":16526,"_23412":89555,"_7169":88444},[45444],{"_11692":1121,"_44950":1027,"_16990":89786,"_5":16526,"_23412":89555,"_7169":89284},[45444],{"_11692":1122,"_44950":1027,"_16990":89788,"_5":16526,"_23412":89555,"_7169":89789},[45444],"hbase.security.authentication",{"_11692":1123,"_44950":1027,"_16990":89791,"_5":16526,"_23412":89555,"_7169":89792},[45444],"When set to kerberos, server logs in before initiating Phoenix connections.",{"_11692":1124,"_44950":1027,"_16990":89794,"_5":16526,"_23412":89555,"_7169":89795},[45444],"specified in hbase-default.xml",{"_11692":1125,"_44950":1027,"_16990":89797,"_5":16526,"_23412":89555,"_7169":89798},[45444],"phoenix.queryserver.keytab.file",{"_11692":1126,"_44950":1027,"_16990":89800,"_5":16526,"_23412":89555,"_7169":89801},[45444],"Key for keytab file lookup.",{"_11692":1127,"_44950":1027,"_16990":89803,"_5":16526,"_23412":89555,"_7169":23276},[45444],{"_11692":1128,"_44950":1027,"_16990":89805,"_5":16526,"_23412":89555,"_7169":89806},[45444],"phoenix.queryserver.kerberos.principal",{"_11692":1129,"_44950":1027,"_16990":89808,"_5":16526,"_23412":89555,"_7169":89809},[45444],"Kerberos principal for authentication; also used for SPNEGO if HTTP principal is not configured.",{"_11692":1130,"_44950":1027,"_16990":89811,"_5":16526,"_23412":89555,"_7169":23276},[45444],{"_11692":1131,"_44950":1027,"_16990":89813,"_5":16526,"_23412":89555,"_7169":89814},[45444],"phoenix.queryserver.http.keytab.file",{"_11692":1132,"_44950":1027,"_16990":89816,"_5":16526,"_23412":89555,"_7169":89817},[45444],"Keytab for SPNEGO auth; required if phoenix.queryserver.kerberos.http.principal is set; falls back to phoenix.queryserver.keytab.file.",{"_11692":1133,"_44950":1027,"_16990":89819,"_5":16526,"_23412":89555,"_7169":23276},[45444],{"_11692":1134,"_44950":1027,"_16990":89821,"_5":16526,"_23412":89555,"_7169":89822},[45444],"phoenix.queryserver.http.kerberos.principal",{"_11692":1135,"_44950":1027,"_16990":89824,"_5":16526,"_23412":89555,"_7169":89825},[45444],"Kerberos principal for SPNEGO auth; falls back to phoenix.queryserver.kerberos.principal.",{"_11692":1136,"_44950":1027,"_16990":89827,"_5":16526,"_23412":89555,"_7169":23276},[45444],{"_11692":1137,"_44950":1027,"_16990":89829,"_5":16526,"_23412":89555,"_7169":89830},[45444],"phoenix.queryserver.kerberos.http.principal",{"_11692":1138,"_44950":1027,"_16990":89832,"_5":16526,"_23412":89555,"_7169":89833},[45444],"Deprecated; use phoenix.queryserver.http.kerberos.principal.",{"_11692":1139,"_44950":1027,"_16990":89835,"_5":16526,"_23412":89555,"_7169":23276},[45444],{"_11692":1140,"_44950":1027,"_16990":89837,"_5":16526,"_23412":89555,"_7169":89838},[45444],"phoenix.queryserver.kerberos.allowed.realms",{"_11692":1141,"_44950":1027,"_16990":89840,"_5":16526,"_23412":89555,"_7169":89841},[45444],"Additional Kerberos realms allowed for SPNEGO auth.",{"_11692":1142,"_44950":1027,"_16990":89843,"_5":16526,"_23412":89555,"_7169":23276},[45444],{"_11692":1143,"_44950":1027,"_16990":89845,"_5":16526,"_23412":89555,"_7169":89846},[45444],"phoenix.queryserver.dns.nameserver",{"_11692":1144,"_44950":1027,"_16990":89848,"_5":16526,"_23412":89555,"_7169":89849},[45444],"DNS hostname.",{"_11692":1145,"_44950":1027,"_16990":89851,"_5":16526,"_23412":89555,"_7169":27401},[45444],{"_11692":1146,"_44950":1027,"_16990":89853,"_5":16526,"_23412":89555,"_7169":89854},[45444],"phoenix.queryserver.dns.interface",{"_11692":1147,"_44950":1027,"_16990":89856,"_5":16526,"_23412":89555,"_7169":89857},[45444],"Network interface name for DNS queries.",{"_11692":1148,"_44950":1027,"_16990":89859,"_5":16526,"_23412":89555,"_7169":27401},[45444],{"_11692":1149,"_44950":1027,"_16990":89861,"_5":16526,"_23412":89559,"_7169":89279},[45444],{"_11692":1150,"_44950":1027,"_16990":89863,"_5":16526,"_23412":89559,"_7169":88444},[45444],{"_11692":1151,"_44950":1027,"_16990":89865,"_5":16526,"_23412":89559,"_7169":89284},[45444],{"_11692":1152,"_44950":1027,"_16990":89867,"_5":16526,"_23412":89559,"_7169":89868},[45444],"avatica.connectioncache.concurrency",{"_11692":1153,"_44950":1027,"_16990":89870,"_5":16526,"_23412":89559,"_7169":89871},[45444],"Connection cache concurrency level.",{"_11692":1154,"_44950":1027,"_16990":89873,"_5":16526,"_23412":89559,"_7169":8717},[45444],{"_11692":1155,"_44950":1027,"_16990":89875,"_5":16526,"_23412":89559,"_7169":89876},[45444],"avatica.connectioncache.initialcapacity",{"_11692":1156,"_44950":1027,"_16990":89878,"_5":16526,"_23412":89559,"_7169":89879},[45444],"Connection cache initial capacity.",{"_11692":1157,"_44950":1027,"_16990":89881,"_5":16526,"_23412":89559,"_7169":42485},[45444],{"_11692":1158,"_44950":1027,"_16990":89883,"_5":16526,"_23412":89559,"_7169":89884},[45444],"avatica.connectioncache.maxcapacity",{"_11692":1159,"_44950":1027,"_16990":89886,"_5":16526,"_23412":89559,"_7169":89887},[45444],"Connection cache maximum capacity; LRU eviction begins near this point.",{"_11692":1160,"_44950":1027,"_16990":89889,"_5":16526,"_23412":89559,"_7169":42516},[45444],{"_11692":1161,"_44950":1027,"_16990":89891,"_5":16526,"_23412":89559,"_7169":89892},[45444],"avatica.connectioncache.expiryduration",{"_11692":1162,"_44950":1027,"_16990":89894,"_5":16526,"_23412":89559,"_7169":89895},[45444],"Connection cache expiration duration.",{"_11692":1163,"_44950":1027,"_16990":89897,"_5":16526,"_23412":89559,"_7169":8717},[45444],{"_11692":1164,"_44950":1027,"_16990":89899,"_5":16526,"_23412":89559,"_7169":89900},[45444],"avatica.connectioncache.expiryunit",{"_11692":1165,"_44950":1027,"_16990":89902,"_5":16526,"_23412":89559,"_7169":89903},[45444],"Time unit for avatica.connectioncache.expiryduration.",{"_11692":1166,"_44950":1027,"_16990":89905,"_5":16526,"_23412":89559,"_7169":89906},[45444],"MINUTES",{"_11692":1167,"_44950":1027,"_16990":89908,"_5":16526,"_23412":89563,"_7169":89279},[45444],{"_11692":1168,"_44950":1027,"_16990":89910,"_5":16526,"_23412":89563,"_7169":88444},[45444],{"_11692":1169,"_44950":1027,"_16990":89912,"_5":16526,"_23412":89563,"_7169":89284},[45444],{"_11692":1170,"_44950":1027,"_16990":89914,"_5":16526,"_23412":89563,"_7169":89915},[45444],"avatica.statementcache.concurrency",{"_11692":1171,"_44950":1027,"_16990":89917,"_5":16526,"_23412":89563,"_7169":89918},[45444],"Statement cache concurrency level.",{"_11692":1172,"_44950":1027,"_16990":89920,"_5":16526,"_23412":89563,"_7169":42485},[45444],{"_11692":1173,"_44950":1027,"_16990":89922,"_5":16526,"_23412":89563,"_7169":89923},[45444],"avatica.statementcache.initialcapacity",{"_11692":1174,"_44950":1027,"_16990":89925,"_5":16526,"_23412":89563,"_7169":89926},[45444],"Statement cache initial capacity.",{"_11692":1175,"_44950":1027,"_16990":89928,"_5":16526,"_23412":89563,"_7169":42516},[45444],{"_11692":1176,"_44950":1027,"_16990":89930,"_5":16526,"_23412":89563,"_7169":89931},[45444],"avatica.statementcache.maxcapacity",{"_11692":1177,"_44950":1027,"_16990":89933,"_5":16526,"_23412":89563,"_7169":89934},[45444],"Statement cache maximum capacity; LRU eviction begins near this point.",{"_11692":1178,"_44950":1027,"_16990":89936,"_5":16526,"_23412":89563,"_7169":42531},[45444],{"_11692":1179,"_44950":1027,"_16990":89938,"_5":16526,"_23412":89563,"_7169":89939},[45444],"avatica.statementcache.expiryduration",{"_11692":1180,"_44950":1027,"_16990":89941,"_5":16526,"_23412":89563,"_7169":89942},[45444],"Statement cache expiration duration.",{"_11692":1181,"_44950":1027,"_16990":89944,"_5":16526,"_23412":89563,"_7169":8846},[45444],{"_11692":1182,"_44950":1027,"_16990":89946,"_5":16526,"_23412":89563,"_7169":89947},[45444],"avatica.statementcache.expiryunit",{"_11692":1183,"_44950":1027,"_16990":89949,"_5":16526,"_23412":89563,"_7169":89950},[45444],"Time unit for avatica.statementcache.expiryduration.",{"_11692":1184,"_44950":1027,"_16990":89952,"_5":16526,"_23412":89563,"_7169":89906},[45444],{"_11692":1185,"_44950":1027,"_16990":89954,"_5":16526,"_23412":89567,"_7169":89279},[45444],{"_11692":1186,"_44950":1027,"_16990":89956,"_5":16526,"_23412":89567,"_7169":88444},[45444],{"_11692":1187,"_44950":1027,"_16990":89958,"_5":16526,"_23412":89567,"_7169":89284},[45444],{"_11692":1188,"_44950":1027,"_16990":89960,"_5":16526,"_23412":89567,"_7169":89961},[45444],"phoenix.queryserver.withRemoteUserExtractor",{"_11692":1189,"_44950":1027,"_16990":89963,"_5":16526,"_23412":89567,"_7169":89964},[45444],"If true, extracts impersonated user from request param instead of authenticated HTTP user.",{"_11692":1190,"_44950":1027,"_16990":89966,"_5":16526,"_23412":89567,"_7169":24355},[45444],{"_11692":1191,"_44950":1027,"_16990":89968,"_5":16526,"_23412":89567,"_7169":89969},[45444],"phoenix.queryserver.remoteUserExtractor.param",{"_11692":1192,"_44950":1027,"_16990":89971,"_5":16526,"_23412":89567,"_7169":89972},[45444],"HTTP request parameter name for impersonated user.",{"_11692":1193,"_44950":1027,"_16990":89974,"_5":16526,"_23412":89567,"_7169":89975},[45444],"doAs",{"_11692":1194,"_44950":1027,"_16990":89977,"_5":16526,"_23412":89570,"_7169":89279},[45444],{"_11692":1195,"_44950":1027,"_16990":89979,"_5":16526,"_23412":89570,"_7169":88444},[45444],{"_11692":1196,"_44950":1027,"_16990":89981,"_5":16526,"_23412":89570,"_7169":89284},[45444],{"_11692":1197,"_44950":1027,"_16990":89983,"_5":16526,"_23412":89570,"_7169":89984},[45444],"phoenix.client.metrics.tag",{"_11692":1198,"_44950":1027,"_16990":89986,"_5":16526,"_23412":89570,"_7169":89987},[45444],"Tag for filtering Phoenix global client metrics emitted by PQS in hadoop-metrics2.properties.",{"_11692":1199,"_44950":1027,"_16990":89989,"_5":16526,"_23412":89570,"_7169":89990},[45444],"FAT_CLIENT",{"_11692":1200,"_44950":1027,"_16990":89992,"_5":16526,"_23412":89573,"_7169":89993},[45444],"The Phoenix Query Server is meant to be horizontally scalable which means that it\nis a natural fit for add-on features like service discovery and load balancing.",{"_11692":1201,"_44950":1027,"_16990":89995,"_5":16526,"_23412":89577,"_7169":89996},[45444],"The Query Server can use off-the-shelf HTTP load balancers such as the Apache HTTP Server,\nnginx, or HAProxy. The primary requirement of\nusing these load balancers is that the implementation must implement \"sticky session\" (when a client\ncommunicates with a backend server, that client continues to talk to that backend server). The Query Server also\nprovides some bundled functionality for load balancing using ZooKeeper.",{"_11692":1202,"_44950":1027,"_16990":89998,"_5":16526,"_23412":89577,"_7169":89999},[45444],"The ZooKeeper-based load balancer functions by automatically registering PQS instances in\nZooKeeper and then allows clients to query the list of available servers. This implementation, unlike\nthe others mentioned above, requires that client use the advertised information to make a routing decision.\nIn this regard, this ZooKeeper-based approach is more akin to a service-discovery layer than a traditional\nload balancer. This load balancer implementation does not support SASL-based (Kerberos) ACLs in\nZooKeeper (see PHOENIX-4085).",{"_11692":1203,"_44950":1027,"_16990":90001,"_5":16526,"_23412":89577,"_7169":90002},[45444],"The following properties configure this load balancer:",{"_11692":1204,"_44950":1027,"_16990":90004,"_5":16526,"_23412":89577,"_7169":89279},[45444],{"_11692":1205,"_44950":1027,"_16990":90006,"_5":16526,"_23412":89577,"_7169":88444},[45444],{"_11692":1206,"_44950":1027,"_16990":90008,"_5":16526,"_23412":89577,"_7169":89284},[45444],{"_11692":1207,"_44950":1027,"_16990":90010,"_5":16526,"_23412":89577,"_7169":90011},[45444],"phoenix.queryserver.loadbalancer.enabled",{"_11692":1208,"_44950":1027,"_16990":90013,"_5":16526,"_23412":89577,"_7169":90014},[45444],"If true, PQS registers itself in ZooKeeper for load balancing.",{"_11692":1209,"_44950":1027,"_16990":90016,"_5":16526,"_23412":89577,"_7169":24355},[45444],{"_11692":1210,"_44950":1027,"_16990":90018,"_5":16526,"_23412":89577,"_7169":90019},[45444],"phoenix.queryserver.base.path",{"_11692":1211,"_44950":1027,"_16990":90021,"_5":16526,"_23412":89577,"_7169":90022},[45444],"Root znode where PQS instances register themselves.",{"_11692":1212,"_44950":1027,"_16990":90024,"_5":16526,"_23412":89577,"_7169":90025},[45444],"/phoenix",{"_11692":1213,"_44950":1027,"_16990":90027,"_5":16526,"_23412":89577,"_7169":90028},[45444],"phoenix.queryserver.service.name",{"_11692":1214,"_44950":1027,"_16990":90030,"_5":16526,"_23412":89577,"_7169":90031},[45444],"Unique name to identify this PQS instance.",{"_11692":1215,"_44950":1027,"_16990":90033,"_5":16526,"_23412":89577,"_7169":8664},[45444],{"_11692":1216,"_44950":1027,"_16990":90035,"_5":16526,"_23412":89577,"_7169":90036},[45444],"phoenix.queryserver.zookeeper.acl.username",{"_11692":1217,"_44950":1027,"_16990":90038,"_5":16526,"_23412":89577,"_7169":90039},[45444],"Username for optional DIGEST ZooKeeper ACL.",{"_11692":1218,"_44950":1027,"_16990":90041,"_5":16526,"_23412":89577,"_7169":7207},[45444],{"_11692":1219,"_44950":1027,"_16990":90043,"_5":16526,"_23412":89577,"_7169":90044},[45444],"phoenix.queryserver.zookeeper.acl.password",{"_11692":1220,"_44950":1027,"_16990":90046,"_5":16526,"_23412":89577,"_7169":90047},[45444],"Password for optional DIGEST ZooKeeper ACL.",{"_11692":1221,"_44950":1027,"_16990":90049,"_5":16526,"_23412":89577,"_7169":7207},[45444],{"_11692":1222,"_44950":1222,"_5":12121,"_7169":90051,"_45415":90052,"_16990":90053,"_23412":1222},"Row Timestamp Column",[86368,86369,86370,88058],[45444],{"_11692":1223,"_44950":1222,"_16990":90055,"_5":16526,"_23412":1222,"_7169":90056},[45444],"Map HBase row timestamps to a Phoenix primary-key column and use ROW_TIMESTAMP in table design and upserts.",{"_11692":1224,"_44950":1222,"_5":45412,"_16990":90058,"_23412":90059,"_7169":90060},[45444],"/docs/features/row-timestamp-column#sample-schema","Sample schema",{"_11692":1225,"_44950":1222,"_16990":90062,"_5":16526,"_23412":1222,"_7169":90063},[45444],"Phoenix 4.6 provides a way to map HBase’s native row timestamp to a Phoenix column. This helps you take advantage of HBase optimizations for time ranges in store files, along with query optimizations built into Phoenix.",{"_11692":1226,"_44950":1222,"_16990":90065,"_5":16526,"_23412":1222,"_7169":90066},[45444],"For a column to be designated as ROW_TIMESTAMP, certain constraints need to be followed:",{"_11692":1227,"_44950":1222,"_16990":90068,"_5":16526,"_23412":1222,"_7169":90069},[45444],"Only a primary key column of type TIME, DATE, TIMESTAMP, BIGINT, or UNSIGNED_LONG can be designated as ROW_TIMESTAMP.",{"_11692":1228,"_44950":1222,"_16990":90071,"_5":16526,"_23412":1222,"_7169":90072},[45444],"Only one primary key column can be designated as ROW_TIMESTAMP.",{"_11692":1229,"_44950":1222,"_16990":90074,"_5":16526,"_23412":1222,"_7169":90075},[45444],"The column value cannot be NULL (because it maps directly to the HBase row timestamp). This also means a column can be declared as ROW_TIMESTAMP only when creating the table.",{"_11692":1230,"_44950":1222,"_16990":90077,"_5":16526,"_23412":1222,"_7169":90078},[45444],"A ROW_TIMESTAMP column value cannot be negative. For DATE/TIME/TIMESTAMP, the corresponding epoch time in milliseconds cannot be less than zero.",{"_11692":1231,"_44950":1222,"_16990":90080,"_5":16526,"_23412":1222,"_7169":90081},[45444],"When upserting rows for a table with a row timestamp column (using UPSERT VALUES or UPSERT SELECT), you can explicitly provide the row timestamp value or let Phoenix set it automatically. When not specified, Phoenix sets the row timestamp column value to server-side time. The value also becomes the timestamp of the corresponding row in HBase.",{"_11692":1232,"_44950":1222,"_16990":90083,"_5":16526,"_23412":90059,"_7169":90084},[45444],"This sets CREATED_DATE to the value specified in the corresponding bind parameter.",{"_11692":1233,"_44950":1222,"_16990":90086,"_5":16526,"_23412":90059,"_7169":90087},[45444],"This sets CREATED_DATE to server-side time.",{"_11692":1234,"_44950":1222,"_16990":90089,"_5":16526,"_23412":90059,"_7169":90090},[45444],"This sets CREATED_DATE to the DATE selected from SOURCE_METRICS_TABLE.",{"_11692":1235,"_44950":1222,"_16990":90092,"_5":16526,"_23412":90059,"_7169":90093},[45444],"This sets CREATED_DATE in the destination table to the server timestamp.",{"_11692":1236,"_44950":1222,"_16990":90095,"_5":16526,"_23412":90059,"_7169":90096},[45444],"When querying with filters on the row timestamp column, Phoenix performs its usual row-key optimizations and can also set scan min/max time ranges appropriately. Using this time range information, HBase can skip store files that do not fall in the target time range, which significantly improves performance, especially for tail-end data queries.",{"_11692":1237,"_44950":1237,"_5":12121,"_7169":90098,"_45415":90099,"_16990":90100,"_23412":1237},"Salted Tables",[86368,86369,86370,88058],[45444],{"_11692":1238,"_44950":1237,"_16990":90102,"_5":16526,"_23412":1237,"_7169":90103},[45444],"Use SALT_BUCKETS to reduce HBase hotspotting and understand scan, split, and ordering behavior for salted tables.",{"_11692":1239,"_44950":1237,"_5":45412,"_16990":90105,"_23412":90106,"_7169":90107},[45444],"/docs/features/salted-tables#sequential-scan","Sequential scan",{"_11692":1240,"_44950":1237,"_5":45412,"_16990":90109,"_23412":90110,"_7169":90111},[45444],"/docs/features/salted-tables#splitting","Splitting",{"_11692":1241,"_44950":1237,"_5":45412,"_16990":90113,"_23412":90114,"_7169":90115},[45444],"/docs/features/salted-tables#row-key-ordering","Row key ordering",{"_11692":1242,"_44950":1237,"_5":45412,"_16990":90117,"_23412":90118,"_7169":90119},[45444],"/docs/features/salted-tables#salted-tables-performance","Performance",{"_11692":1243,"_44950":1237,"_16990":90121,"_5":16526,"_23412":1237,"_7169":90122},[45444],"Sequential writes in HBase may suffer from region server hotspotting if your row key is monotonically increasing. Salting the row key helps mitigate this problem. See this article for details.",{"_11692":1244,"_44950":1237,"_16990":90124,"_5":16526,"_23412":1237,"_7169":90125},[45444],"Phoenix provides a way to transparently salt the row key with a salting byte for a table. Specify this at table creation time with the SALT_BUCKETS table property, using a value from 1 to 256:",{"_11692":1245,"_44950":1237,"_16990":90127,"_5":16526,"_23412":1237,"_7169":90128},[45444],"There are some behavior differences and cautions to be aware of when using a salted table.",{"_11692":1246,"_44950":1237,"_16990":90130,"_5":16526,"_23412":90106,"_7169":90131},[45444],"Since a salted table does not store data in natural key sequence, a strict sequential scan does not return data in natural sorted order. Clauses that force sequential scan behavior (for example, LIMIT) may return rows differently compared to a non-salted table.",{"_11692":1247,"_44950":1237,"_16990":90133,"_5":16526,"_23412":90110,"_7169":90134},[45444],"If no split points are specified, a salted table is pre-split on salt-byte boundaries to ensure load distribution across region servers, including during initial table growth. If split points are provided manually, they must include the salt byte.",{"_11692":1248,"_44950":1237,"_16990":90136,"_5":16526,"_23412":90114,"_7169":90137},[45444],"Pre-splitting also ensures that entries in each region start with the same salt byte and are therefore locally sorted. During a parallel scan across regions, Phoenix can use this property to perform a client-side merge sort. The resulting scan can still be returned sequentially, as if from a normal table.",{"_11692":1249,"_44950":1237,"_16990":90139,"_5":16526,"_23412":90114,"_7169":90140},[45444],"This row-key ordered scan can be enabled by setting phoenix.query.rowKeyOrderSaltedTable=true in hbase-site.xml. When enabled, user-specified split points on salted tables are disallowed to ensure each bucket contains only entries with the same salt byte. With this property enabled, a salted table behaves more like a normal table for scans and returns items in row-key order.",{"_11692":1250,"_44950":1237,"_16990":90142,"_5":16526,"_23412":90118,"_7169":90143},[45444],"Using salted tables with pre-splitting helps distribute write workload uniformly across region servers, which improves write performance. Our performance evaluation shows that salted tables can achieve up to 80% higher write throughput than non-salted tables.",{"_11692":1251,"_44950":1237,"_16990":90145,"_5":16526,"_23412":90118,"_7169":90146},[45444],"Reads from salted tables can also benefit from more uniform data distribution. Our performance evaluation shows improved read performance for queries focused on subsets of data.",{"_11692":1252,"_44950":1252,"_5":12121,"_7169":90148,"_45415":90149,"_16990":90150,"_23412":1252},"Secondary Indexes",[86368,86369,86370,88058],[45444],{"_11692":1253,"_44950":1252,"_16990":90152,"_5":16526,"_23412":1252,"_7169":90153},[45444],"Concepts, setup, consistency guarantees, and tooling for Phoenix secondary indexes.",{"_11692":1254,"_44950":1252,"_5":45412,"_16990":90155,"_23412":90156,"_7169":90157},[45444],"/docs/features/secondary-indexes#covered-indexes","Covered Indexes",{"_11692":1255,"_44950":1252,"_5":45412,"_16990":90159,"_23412":90160,"_7169":90161},[45444],"/docs/features/secondary-indexes#functional-indexes","Functional Indexes",{"_11692":1256,"_44950":1252,"_5":45412,"_16990":90163,"_23412":90164,"_7169":90165},[45444],"/docs/features/secondary-indexes#global-indexes","Global Indexes",{"_11692":1257,"_44950":1252,"_5":45412,"_16990":90167,"_23412":90168,"_7169":90169},[45444],"/docs/features/secondary-indexes#local-indexes","Local Indexes",{"_11692":1258,"_44950":1252,"_5":45412,"_16990":90171,"_23412":90172,"_7169":90173},[45444],"/docs/features/secondary-indexes#uncovered-indexes","Uncovered Indexes",{"_11692":1259,"_44950":1252,"_5":45412,"_16990":90175,"_23412":90176,"_7169":90177},[45444],"/docs/features/secondary-indexes#uncovered-indexes-when","When to choose an uncovered index",{"_11692":1260,"_44950":1252,"_5":45412,"_16990":90179,"_23412":90180,"_7169":90181},[45444],"/docs/features/secondary-indexes#uncovered-indexes-usage","Creating and using an uncovered index",{"_11692":1261,"_44950":1252,"_5":45412,"_16990":90183,"_23412":90184,"_7169":90185},[45444],"/docs/features/secondary-indexes#index-population","Index Population",{"_11692":1262,"_44950":1252,"_5":45412,"_16990":90187,"_23412":90188,"_7169":90189},[45444],"/docs/features/secondary-indexes#async-index-threshold","ASYNC Index threshold",{"_11692":1263,"_44950":1252,"_5":45412,"_16990":90191,"_23412":90192,"_7169":90193},[45444],"/docs/features/secondary-indexes#index-usage","Index Usage",{"_11692":1264,"_44950":1252,"_5":45412,"_16990":90195,"_23412":90196,"_7169":90197},[45444],"/docs/features/secondary-indexes#index-removal","Index Removal",{"_11692":1265,"_44950":1252,"_5":45412,"_16990":90199,"_23412":90200,"_7169":90201},[45444],"/docs/features/secondary-indexes#index-properties","Index Properties",{"_11692":1266,"_44950":1252,"_5":45412,"_16990":90203,"_23412":90204,"_7169":90205},[45444],"/docs/features/secondary-indexes#consistency-guarantees","Consistency Guarantees",{"_11692":1267,"_44950":1252,"_5":45412,"_16990":90207,"_23412":90208,"_7169":90169},[45444],"/docs/features/secondary-indexes#local-indexes-1",{"_11692":1268,"_44950":1252,"_5":45412,"_16990":90210,"_23412":90211,"_7169":90212},[45444],"/docs/features/secondary-indexes#global-indexes-on-transactional-tables","Global Indexes on Transactional Tables",{"_11692":1269,"_44950":1252,"_5":45412,"_16990":90214,"_23412":90215,"_7169":90216},[45444],"/docs/features/secondary-indexes#global-indexes-on-immutable-tables","Global Indexes on Immutable Tables",{"_11692":1270,"_44950":1252,"_5":45412,"_16990":90218,"_23412":90219,"_7169":90220},[45444],"/docs/features/secondary-indexes#immutable-table-indexes-for-415-and-51-and-newer-versions","Immutable table indexes for 4.15 (and 5.1) and newer versions",{"_11692":1271,"_44950":1252,"_5":45412,"_16990":90222,"_23412":90223,"_7169":90224},[45444],"/docs/features/secondary-indexes#immutable-table-indexes-for-414-and-50-and-older-versions","Immutable table indexes for 4.14 (and 5.0) and older versions",{"_11692":1272,"_44950":1252,"_5":45412,"_16990":90226,"_23412":90227,"_7169":90228},[45444],"/docs/features/secondary-indexes#global-indexes-on-mutable-tables","Global Indexes on Mutable Tables",{"_11692":1273,"_44950":1252,"_5":45412,"_16990":90230,"_23412":90231,"_7169":90232},[45444],"/docs/features/secondary-indexes#mutable-table-indexes-for-415-and-51-and-newer-versions","Mutable table indexes for 4.15 (and 5.1) and newer versions",{"_11692":1274,"_44950":1252,"_5":45412,"_16990":90234,"_23412":90235,"_7169":90236},[45444],"/docs/features/secondary-indexes#mutable-table-indexes-for-414-and-50-and-older-versions","Mutable table indexes for 4.14 (and 5.0) and older versions",{"_11692":1275,"_44950":1252,"_5":45412,"_16990":90238,"_23412":90239,"_7169":90240},[45444],"/docs/features/secondary-indexes#bulkload-tool-limitation","BulkLoad Tool Limitation",{"_11692":1276,"_44950":1252,"_5":45412,"_16990":90242,"_23412":90243,"_7169":90244},[45444],"/docs/features/secondary-indexes#setup","Setup",{"_11692":1277,"_44950":1252,"_5":45412,"_16990":90246,"_23412":90247,"_7169":90248},[45444],"/docs/features/secondary-indexes#for-phoenix-412-and-later","For Phoenix 4.12 and later",{"_11692":1278,"_44950":1252,"_5":45412,"_16990":90250,"_23412":90251,"_7169":90252},[45444],"/docs/features/secondary-indexes#for-phoenix-48---411","For Phoenix 4.8 - 4.11",{"_11692":1279,"_44950":1252,"_5":45412,"_16990":90254,"_23412":90255,"_7169":90256},[45444],"/docs/features/secondary-indexes#for-phoenix-versions-47-and-below","For Phoenix versions 4.7 and below",{"_11692":1280,"_44950":1252,"_5":45412,"_16990":90258,"_23412":90259,"_7169":90260},[45444],"/docs/features/secondary-indexes#upgrading-local-indexes-created-before-480","Upgrading Local Indexes created before 4.8.0",{"_11692":1281,"_44950":1252,"_5":45412,"_16990":90262,"_23412":90263,"_7169":90264},[45444],"/docs/features/secondary-indexes#secondary-indexes-tuning","Tuning",{"_11692":1282,"_44950":1252,"_5":45412,"_16990":90266,"_23412":90267,"_7169":90119},[45444],"/docs/features/secondary-indexes#secondary-indexes-performance",{"_11692":1283,"_44950":1252,"_5":45412,"_16990":90269,"_23412":90270,"_7169":90271},[45444],"/docs/features/secondary-indexes#index-scrutiny-tool","Index Scrutiny Tool",{"_11692":1284,"_44950":1252,"_5":45412,"_16990":90273,"_23412":90274,"_7169":86490},[45444],"/docs/features/secondary-indexes#secondary-indexes-limitations",{"_11692":1285,"_44950":1252,"_5":45412,"_16990":90276,"_23412":90277,"_7169":90278},[45444],"/docs/features/secondary-indexes#index-upgrade-tool","Index Upgrade Tool",{"_11692":1286,"_44950":1252,"_5":45412,"_16990":90280,"_23412":90281,"_7169":89267},[45444],"/docs/features/secondary-indexes#secondary-indexes-resources",{"_11692":1287,"_44950":1252,"_16990":90283,"_5":16526,"_23412":1252,"_7169":90284},[45444],"Secondary indexes are an orthogonal way to access data from its primary access path. In HBase, you have a single\nindex that is lexicographically sorted on the primary row key. Access to records in any way other than through\nthe primary row requires scanning over potentially all the rows in the table to test them against your filter.\nWith secondary indexing, the columns or expressions you index form an alternate row key to allow point lookups\nand range scans along this new axis.",{"_11692":1288,"_44950":1252,"_16990":90286,"_5":16526,"_23412":90156,"_7169":90287},[45444],"Phoenix is particularly powerful in that we provide covered indexes -\nwe do not need to go back to the primary table once we have found the index entry. Instead, we bundle the data\nwe care about right in the index rows, saving read-time overhead.",{"_11692":1289,"_44950":1252,"_16990":90289,"_5":16526,"_23412":90156,"_7169":90290},[45444],"For example, the following would create an index on the v1 and v2 columns and\ninclude the v3 column in the index as well to prevent having to get it from the data table:",{"_11692":1290,"_44950":1252,"_16990":90292,"_5":16526,"_23412":90160,"_7169":90293},[45444],"Functional indexes (available in 4.3 and above) allow you to create\nan index not just on columns, but on an arbitrary expressions. Then when a query uses that expression, the index\nmay be used to retrieve the results instead of the data table. For example, you could create an index on UPPER(FIRST_NAME||' '||LAST_NAME)\nto allow you to do case insensitive searches on the combined first name and last name of a person.",{"_11692":1291,"_44950":1252,"_16990":90295,"_5":16526,"_23412":90160,"_7169":90296},[45444],"For example, the following would create this functional index:",{"_11692":1292,"_44950":1252,"_16990":90298,"_5":16526,"_23412":90160,"_7169":90299},[45444],"With this index in place, when the following query is issued, the index would be used instead of the data table to retrieve the results:",{"_11692":1293,"_44950":1252,"_16990":90301,"_5":16526,"_23412":90160,"_7169":90302},[45444],"Phoenix supports two types of indexing techniques: global and local indexing.\nEach are useful in different scenarios and have their own failure profiles and performance characteristics.",{"_11692":1294,"_44950":1252,"_16990":90304,"_5":16526,"_23412":90164,"_7169":90305},[45444],"Global indexing targets read heavy uses cases. With global indexes, all the performance penalties for indexes occur at write time. We intercept the data table updates on write (DELETE, UPSERT VALUES and UPSERT SELECT), build the index update and then sent any necessary updates to all interested index tables. At read time, Phoenix will select the index table to use that will produce the fastest query time and directly scan it just like any other HBase table. An index will not be used for a query that references a column that isn't part of the index.",{"_11692":1295,"_44950":1252,"_16990":90307,"_5":16526,"_23412":90168,"_7169":90308},[45444],"Local indexing targets write heavy, space constrained use cases. Just like with global indexes, Phoenix will automatically select whether or not to use a local index at query-time. With local indexes, index data and table data co-reside on same server preventing any network overhead during writes. Local indexes can be used even when the query isn't fully covered (i.e. Phoenix automatically retrieve the columns not in the index through point gets against the data table). Unlike global indexes, all local indexes of a table are stored in a single, separate shared table prior to 4.8.0 version. From 4.8.0 onwards we are storing all local index data in the separate shadow column families in the same data table. At read time when the local index is used, every region must be examined for the data as the exact region location of index data cannot be predetermined. Thus some overhead occurs at read-time.",{"_11692":1296,"_44950":1252,"_16990":90310,"_5":16526,"_23412":90172,"_7169":90311},[45444],"A global index is \"covered\" for a query when every column the query references is in\nthe index — either in the index key or in INCLUDE. Historically a global index that\nwasn't covered for a query simply wasn't used: Phoenix would fall back to a full\ndata-table scan. Uncovered indexes lift that restriction — Phoenix can use a\nglobal index even when the query needs columns that aren't in it, by joining back\nto the data table on the server side to fetch the missing columns\n(PHOENIX-6458).",{"_11692":1297,"_44950":1252,"_16990":90313,"_5":16526,"_23412":90172,"_7169":90314},[45444],"Local indexes already worked this way (see Local Indexes above);\nthe new capability is for global indexes.",{"_11692":1298,"_44950":1252,"_16990":90316,"_5":16526,"_23412":90176,"_7169":90317},[45444],"Both an INCLUDE covered index and an uncovered index let the same query use the\nindex. They trade off different costs:",{"_11692":1299,"_44950":1252,"_16990":90319,"_5":16526,"_23412":90176,"_7169":90320},[45444],"Approach",{"_11692":1300,"_44950":1252,"_16990":90322,"_5":16526,"_23412":90176,"_7169":90323},[45444],"Index size",{"_11692":1301,"_44950":1252,"_16990":90325,"_5":16526,"_23412":90176,"_7169":90326},[45444],"Read path",{"_11692":1302,"_44950":1252,"_16990":90328,"_5":16526,"_23412":90176,"_7169":90329},[45444],"Best when",{"_11692":1303,"_44950":1252,"_16990":90331,"_5":16526,"_23412":90176,"_7169":90332},[45444],"CREATE INDEX ... INCLUDE (c)",{"_11692":1304,"_44950":1252,"_16990":90334,"_5":16526,"_23412":90176,"_7169":90335},[45444],"Larger — c is duplicated",{"_11692":1305,"_44950":1252,"_16990":90337,"_5":16526,"_23412":90176,"_7169":90338},[45444],"Index-only scan",{"_11692":1306,"_44950":1252,"_16990":90340,"_5":16526,"_23412":90176,"_7169":90341},[45444],"Column c is small, frequently read with the index, and updated rarely",{"_11692":1307,"_44950":1252,"_16990":90343,"_5":16526,"_23412":90176,"_7169":90344},[45444],"CREATE UNCOVERED INDEX",{"_11692":1308,"_44950":1252,"_16990":90346,"_5":16526,"_23412":90176,"_7169":90347},[45444],"Smaller — only the key",{"_11692":1309,"_44950":1252,"_16990":90349,"_5":16526,"_23412":90176,"_7169":90350},[45444],"Index seek + server-side join to data row",{"_11692":1310,"_44950":1252,"_16990":90352,"_5":16526,"_23412":90176,"_7169":90353},[45444],"Column is large, rarely read with this access path, or updated often",{"_11692":1311,"_44950":1252,"_16990":90355,"_5":16526,"_23412":90176,"_7169":90356},[45444],"A common pattern is to leave wide payload columns out of the index entirely and\nlet Phoenix fetch them via the join-back when needed. This keeps the index compact\nand write-cheap, at the cost of a per-matching-row data-table read on the rare query\nthat wants the payload.",{"_11692":1312,"_44950":1252,"_16990":90358,"_5":16526,"_23412":90180,"_7169":90359},[45444],"Declare an uncovered global index with the UNCOVERED keyword in the DDL.\nUNCOVERED is global-only (cannot be combined with LOCAL) and cannot be combined\nwith INCLUDE — the whole point is to skip duplicating columns:",{"_11692":1313,"_44950":1252,"_16990":90361,"_5":16526,"_23412":90180,"_7169":90362},[45444],"The planner picks an uncovered index automatically when it's the best plan; no\nhint is required. If you want to force it (e.g. to compare plans), use the\nstandard index hint:",{"_11692":1314,"_44950":1252,"_16990":90364,"_5":16526,"_23412":90184,"_7169":90365},[45444],"By default, when an index is created, it is populated synchronously during the CREATE INDEX call. This may not be feasible depending on the current size of the data table. As of 4.5, initially population of an index may be done asynchronously by including the ASYNC keyword in the index creation DDL statement:",{"_11692":1315,"_44950":1252,"_16990":90367,"_5":16526,"_23412":90184,"_7169":90368},[45444],"The map reduce job that populates the index table must be kicked off separately through the HBase command line like this:",{"_11692":1316,"_44950":1252,"_16990":90370,"_5":16526,"_23412":90184,"_7169":90371},[45444],"Only when the map reduce job is complete will the index be activated and start to be used in queries. The job is resilient to the client being exited. The output-path option is used to specify a HDFS directory that is used for writing HFiles to.",{"_11692":1317,"_44950":1252,"_16990":90373,"_5":16526,"_23412":90184,"_7169":90374},[45444],"You can also start index population for all indexes in BUILDING (\"b\") state with the following HBase command line:",{"_11692":1318,"_44950":1252,"_16990":90376,"_5":16526,"_23412":90188,"_7169":90377},[45444],"As of 4.16 (and 5.1), setting the phoenix.index.async.threshold property to a positive number will disallow synchronous index creation if the estimated indexed data size exceeds phoenix.index.async.threshold (in bytes).",{"_11692":1319,"_44950":1252,"_16990":90379,"_5":16526,"_23412":90192,"_7169":90380},[45444],"Indexes are automatically used by Phoenix to service a query when it's determined more efficient to do so. However, a global index will not be used unless all of the columns referenced in the query are contained in the index. For example, the following query would not use the index, because v2 is referenced in the query but not included in the index:",{"_11692":1320,"_44950":1252,"_16990":90382,"_5":16526,"_23412":90192,"_7169":90383},[45444],"There are two means of getting an index to be used in this case:",{"_11692":1321,"_44950":1252,"_16990":90385,"_5":16526,"_23412":90192,"_7169":90386},[45444],"Create a covered index by including v2 in the index:",{"_11692":1322,"_44950":1252,"_16990":90388,"_5":16526,"_23412":90192,"_7169":90389},[45444],"This will cause the v2 column value to be copied into the index and kept in synch as it changes. This will obviously increase the size of the index.",{"_11692":1323,"_44950":1252,"_16990":90391,"_5":16526,"_23412":90192,"_7169":90392},[45444],"Create a local index:",{"_11692":1324,"_44950":1252,"_16990":90394,"_5":16526,"_23412":90192,"_7169":90395},[45444],"Unlike global indexes, local indexes will use an index even when all columns referenced in the query are not contained in the index. This is done by default for local indexes because we know that the table and index data coreside on the same region server thus ensuring the lookup is local.",{"_11692":1325,"_44950":1252,"_16990":90397,"_5":16526,"_23412":90196,"_7169":90398},[45444],"To drop an index, you'd issue the following statement:",{"_11692":1326,"_44950":1252,"_16990":90400,"_5":16526,"_23412":90196,"_7169":90401},[45444],"If an indexed column is dropped in the data table, the index will automatically be dropped. In addition, if a covered column is dropped in the data table, it will be automatically dropped from the index as well.",{"_11692":1327,"_44950":1252,"_16990":90403,"_5":16526,"_23412":90200,"_7169":90404},[45444],"Just like with the CREATE TABLE statement, the CREATE INDEX statement may pass through properties to apply to the underlying HBase table, including the ability to salt it:",{"_11692":1328,"_44950":1252,"_16990":90406,"_5":16526,"_23412":90200,"_7169":90407},[45444],"Note that if the primary table is salted, then the index is automatically salted in the same way for global indexes. In addition, the MAX_FILESIZE for the index is adjusted down, relative to the size of the primary versus index table. For more on salting see here. With local indexes, on the other hand, specifying SALT_BUCKETS is not allowed.",{"_11692":1329,"_44950":1252,"_16990":90409,"_5":16526,"_23412":90204,"_7169":90410},[45444],"On successful return to the client after a commit, all data is guaranteed to be written to all interested indexes and the\nprimary table. In other words, index updates are synchronous with the same strong consistency guarantees provided by HBase.",{"_11692":1330,"_44950":1252,"_16990":90412,"_5":16526,"_23412":90204,"_7169":90413},[45444],"However, since indexes are stored in separate tables than the data table, depending on the properties of the table and the\ntype of index, the consistency between your table and index varies in the event that a commit fails due to a server-side\ncrash. This is an important design consideration driven by your requirements and use case.",{"_11692":1331,"_44950":1252,"_16990":90415,"_5":16526,"_23412":90204,"_7169":90416},[45444],"Outlined below are the different options with various levels of consistency guarantees.",{"_11692":1332,"_44950":1252,"_16990":90418,"_5":16526,"_23412":90208,"_7169":90419},[45444],"Since Phoenix 4.8 local indexes are always guaranteed to be consistent.",{"_11692":1333,"_44950":1252,"_16990":90421,"_5":16526,"_23412":90211,"_7169":90422},[45444],"By declaring your table as transactional, you achieve the highest level of consistency guarantee\nbetween your table and index. In this case, your commit of your table mutations and related index updates are atomic\nwith strong ACID guarantees. If the commit fails, then none of your data (table\nor index) is updated, thus ensuring that your table and index are always in sync.",{"_11692":1334,"_44950":1252,"_16990":90424,"_5":16526,"_23412":90211,"_7169":90425},[45444],"Why not just always declare your tables as transactional? This may be fine, especially if your\ntable is declared as immutable, since the transactional overhead is very small in this case. However, if your data\nis mutable, make sure that the overhead associated with the conflict detection that occurs with transactional tables\nand the operational overhead of running the transaction manager is acceptable. Additionally, transactional tables\nwith secondary indexes potentially lowers your availability of being able to write to your data table, as both the\ndata table and its secondary index tables must be availalbe as otherwise the write will fail.",{"_11692":1335,"_44950":1252,"_16990":90427,"_5":16526,"_23412":90215,"_7169":90428},[45444],"For a table in which the data is only written once and never updated in-place, certain optimizations may be made to reduce the write-time overhead for incremental maintenance.\nThis is common with time-series data such as log or event data, where once a row is written, it will never be updated.\nTo take advantage of these optimizations, declare your table as immutable by adding the IMMUTABLE_ROWS=true property to your DDL statement:",{"_11692":1336,"_44950":1252,"_16990":90430,"_5":16526,"_23412":90215,"_7169":90431},[45444],"All indexes on a table declared with IMMUTABLE_ROWS=true are considered immutable (note that by default, tables are considered mutable).\nFor global immutable indexes, the index is maintained entirely on the client-side with the index table being generated as changes to the data table occur.\nLocal immutable indexes, on the other hand, are maintained on the server-side.\nNote that no safeguards are in-place to enforce that a table declared as immutable doesn't actually mutate data (as that would negate the performance gain achieved).\nIf that was to occur, the index would no longer be in sync with the table.",{"_11692":1337,"_44950":1252,"_16990":90433,"_5":16526,"_23412":90215,"_7169":90434},[45444],"If you have an existing table that you'd like to switch from immutable indexing to mutable indexing, use the ALTER TABLE command as show below:",{"_11692":1338,"_44950":1252,"_16990":90436,"_5":16526,"_23412":90215,"_7169":90437},[45444],"Global Indexing for Immutable tables has been completely rewritten for version 4.15 (and 5.1)",{"_11692":1339,"_44950":1252,"_16990":90439,"_5":16526,"_23412":90219,"_7169":90440},[45444],"Immutable index updates go through the same three phase writes as mutable index updates do except that deleting or un-verifying existing index rows is not applicable to immutable indexes.\nThis guarantees that the index tables are always in sync with the data tables.",{"_11692":1340,"_44950":1252,"_16990":90442,"_5":16526,"_23412":90223,"_7169":90443},[45444],"Indexes on non transactional, immutable tables have no mechanism in place to automatically deal with a commit failure. Maintaining\nconsistency between the table and index is left to the client to handle. Because the updates are idempotent, the simplest\nsolution is for the client to continue retrying the batch of mutations until they succeed.",{"_11692":1341,"_44950":1252,"_16990":90445,"_5":16526,"_23412":90227,"_7169":90446},[45444],"Global Indexing for Mutable tables has been completely rewritten for version 4.15 (and 5.1)",{"_11692":1342,"_44950":1252,"_16990":90448,"_5":16526,"_23412":90231,"_7169":90449},[45444],"The new Strongly Consistent Global Indexing feature uses a three-phase indexing algorithm to guarantee that the index tables are always in sync with the data tables.",{"_11692":1343,"_44950":1252,"_16990":90451,"_5":16526,"_23412":90231,"_7169":90452},[45444],"The implementation uses a shadow column to track the status of index rows:",{"_11692":1344,"_44950":1252,"_16990":90454,"_5":16526,"_23412":90231,"_7169":90455},[45444],"Write:",{"_11692":1345,"_44950":1252,"_16990":90457,"_5":16526,"_23412":90231,"_7169":90458},[45444],"Set the status of existing index rows to unverified and write the new index rows with the unverified status",{"_11692":1346,"_44950":1252,"_16990":90460,"_5":16526,"_23412":90231,"_7169":90461},[45444],"Write the data table rows",{"_11692":1347,"_44950":1252,"_16990":90463,"_5":16526,"_23412":90231,"_7169":90464},[45444],"Delete the existing index rows and set the status of new rows to verified",{"_11692":1348,"_44950":1252,"_16990":90466,"_5":16526,"_23412":90231,"_7169":90467},[45444],"Read:",{"_11692":1349,"_44950":1252,"_16990":90469,"_5":16526,"_23412":90231,"_7169":90470},[45444],"Read the index rows and check their status",{"_11692":1350,"_44950":1252,"_16990":90472,"_5":16526,"_23412":90231,"_7169":90473},[45444],"The unverified rows are repaired from the data table",{"_11692":1351,"_44950":1252,"_16990":90475,"_5":16526,"_23412":90231,"_7169":90476},[45444],"Delete:",{"_11692":1352,"_44950":1252,"_16990":90478,"_5":16526,"_23412":90231,"_7169":90479},[45444],"Set the index table rows with the unverified status",{"_11692":1353,"_44950":1252,"_16990":90481,"_5":16526,"_23412":90231,"_7169":90482},[45444],"Delete the data table rows",{"_11692":1354,"_44950":1252,"_16990":90484,"_5":16526,"_23412":90231,"_7169":90485},[45444],"Delete index table rows",{"_11692":1355,"_44950":1252,"_16990":90487,"_5":16526,"_23412":90231,"_7169":90488},[45444],"See resources for more in-depth information.",{"_11692":1356,"_44950":1252,"_16990":90490,"_5":16526,"_23412":90231,"_7169":90491},[45444],"All newly created tables use the new indexing algorithm.",{"_11692":1357,"_44950":1252,"_16990":90493,"_5":16526,"_23412":90231,"_7169":90494},[45444],"Indexes created with older Phoenix versions will continue to use the old implementation, until upgraded with IndexUpgradeTool",{"_11692":1358,"_44950":1252,"_16990":90496,"_5":16526,"_23412":90235,"_7169":90497},[45444],"For non transactional mutable tables, we maintain index update durability by adding the index updates to the Write-Ahead-Log (WAL) entry of the primary table row.\nOnly after the WAL entry is successfully synced to disk do we attempt to make the index/primary table updates. We write the\nindex updates in parallel by default, leading to very high throughput. If the server crashes while we are writing the index\nupdates, we replay the all the index updates to the index tables in the WAL recovery process and rely on the idempotence of\nthe updates to ensure correctness. Therefore, indexes on non transactional mutable tables are only ever a single batch of\nedits behind the primary table.",{"_11692":1359,"_44950":1252,"_16990":90499,"_5":16526,"_23412":90235,"_7169":90500},[45444],"It's important to note several points:",{"_11692":1360,"_44950":1252,"_16990":90502,"_5":16526,"_23412":90235,"_7169":90503},[45444],"For non transactional tables, you could see the index table out of sync with the primary table.",{"_11692":1361,"_44950":1252,"_16990":90505,"_5":16526,"_23412":90235,"_7169":90506},[45444],"As noted above, this is ok as we are only a very small bit behind and out of sync for very short periods",{"_11692":1362,"_44950":1252,"_16990":90508,"_5":16526,"_23412":90235,"_7169":90509},[45444],"Each data row and its index row(s) are guaranteed to to be written or lost - we never see partial updates as this is part of the atomicity guarantees of HBase.",{"_11692":1363,"_44950":1252,"_16990":90511,"_5":16526,"_23412":90235,"_7169":90512},[45444],"Data is first written to the table followed by the index tables (the reverse is true if the WAL is disabled).",{"_11692":1364,"_44950":1252,"_16990":90514,"_5":16526,"_23412":90235,"_7169":90515},[45444],"Singular Write Path",{"_11692":1365,"_44950":1252,"_16990":90517,"_5":16526,"_23412":90235,"_7169":90518},[45444],"There is a single write path that guarantees the failure properties. All writes to the HRegion get intercepted by our\ncoprocessor. We then build the index updates based on the pending update (or updates, in the case of the batch).\nThese update are then appended to the WAL entry for the original update.",{"_11692":1366,"_44950":1252,"_16990":90520,"_5":16526,"_23412":90235,"_7169":90521},[45444],"If we get any failure up to this point, we return the failure to the client and no data is persisted or made visible\nto the client.",{"_11692":1367,"_44950":1252,"_16990":90523,"_5":16526,"_23412":90235,"_7169":90524},[45444],"Once the WAL is written, we ensure that the index and primary table data will become visible, even in the case of a failure.",{"_11692":1368,"_44950":1252,"_16990":90526,"_5":16526,"_23412":90235,"_7169":90527},[45444],"If the server does crash, we then replay the index updates with the usual WAL replay mechanism",{"_11692":1369,"_44950":1252,"_16990":90529,"_5":16526,"_23412":90235,"_7169":90530},[45444],"If the server does not crash, we just insert the index updates to their respective tables.",{"_11692":1370,"_44950":1252,"_16990":90532,"_5":16526,"_23412":90235,"_7169":90533},[45444],"If the index updates fail, the various means of maintaining consistency are outlined below.",{"_11692":1371,"_44950":1252,"_16990":90535,"_5":16526,"_23412":90235,"_7169":90536},[45444],"If the Phoenix system catalog table cannot be reached when a failure occurs, we force the server to be immediately aborted and failing this, call System.exit on the JVM, forcing the server to die. By killing the server, we ensure that the WAL will be replayed on recovery, replaying the index updates to their appropriate tables. This ensures that a secondary index is not continued to be used when it's in a know, invalid state.",{"_11692":1372,"_44950":1252,"_16990":90538,"_5":16526,"_23412":90235,"_7169":90539},[45444],"Disallow table writes until mutable index is consistent",{"_11692":1373,"_44950":1252,"_16990":90541,"_5":16526,"_23412":90235,"_7169":90542},[45444],"The highest level of maintaining consistency between your non transactional table and index is to declare that writes to the\ndata table should be temporarily disallowed in the event of a failure to update the index. In this consistency\nmode, the table and index will be held at the timestamp before the failure occurred, with writes to the data\ntable being disallowed until the index is back online and in-sync with the data table. The index will\nremain active and continue to be used by queries as usual.",{"_11692":1374,"_44950":1252,"_16990":90544,"_5":16526,"_23412":90235,"_7169":90545},[45444],"The following server-side configurations control this behavior:",{"_11692":1375,"_44950":1252,"_16990":90547,"_5":16526,"_23412":90235,"_7169":90548},[45444],"phoenix.index.failure.block.write must be true to enable a writes to the data table to fail\nin the event of a commit failure until the index can be caught up with the data table.",{"_11692":1376,"_44950":1252,"_16990":90550,"_5":16526,"_23412":90235,"_7169":90551},[45444],"phoenix.index.failure.handling.rebuild must be true (the default) to enable a mutable index to\nbe rebuilt in the background in the event of a commit failure.",{"_11692":1377,"_44950":1252,"_16990":90553,"_5":16526,"_23412":90235,"_7169":90554},[45444],"Disable mutable indexes on write failure until consistency restored",{"_11692":1378,"_44950":1252,"_16990":90556,"_5":16526,"_23412":90235,"_7169":90557},[45444],"The default behavior with mutable indexes is to mark the index as disabled if a write to them fails at commit time,\npartially rebuild them in the background, and then mark them as active again once consistency is restored. In this\nconsistency mode, writes to the data table will not be blocked while the secondary index is being rebuilt. However,\nthe secondary index will not be used by queries while the rebuild is happening.",{"_11692":1379,"_44950":1252,"_16990":90559,"_5":16526,"_23412":90235,"_7169":90545},[45444],{"_11692":1380,"_44950":1252,"_16990":90561,"_5":16526,"_23412":90235,"_7169":90551},[45444],{"_11692":1381,"_44950":1252,"_16990":90563,"_5":16526,"_23412":90235,"_7169":90564},[45444],"phoenix.index.failure.handling.rebuild.interval controls the millisecond frequency at which the server\nchecks whether or not a mutable index needs to be partially rebuilt to catch up with updates to the data\ntable. The default is 10000 or 10 seconds.",{"_11692":1382,"_44950":1252,"_16990":90566,"_5":16526,"_23412":90235,"_7169":90567},[45444],"phoenix.index.failure.handling.rebuild.overlap.time controls how many milliseconds to go back from the timestamp\nat which the failure occurred to go back when a partial rebuild is performed. The default is 1.",{"_11692":1383,"_44950":1252,"_16990":90569,"_5":16526,"_23412":90235,"_7169":90570},[45444],"Disable mutable index on write failure with manual rebuild required",{"_11692":1384,"_44950":1252,"_16990":90572,"_5":16526,"_23412":90235,"_7169":90573},[45444],"This is the lowest level of consistency for mutable secondary indexes. In this case, when a write to a secondary\nindex fails, the index will be marked as disabled with a manual\nrebuild of the index required to enable it to be used\nonce again by queries.",{"_11692":1385,"_44950":1252,"_16990":90575,"_5":16526,"_23412":90235,"_7169":90545},[45444],{"_11692":1386,"_44950":1252,"_16990":90577,"_5":16526,"_23412":90235,"_7169":90578},[45444],"phoenix.index.failure.handling.rebuild must be set to false to disable a mutable index from being\nrebuilt in the background in the event of a commit failure.",{"_11692":1387,"_44950":1252,"_16990":90580,"_5":16526,"_23412":90239,"_7169":90581},[45444],"The BulkLoadTools (e.g. CSVBulkLoadTool and JSONBulkLoadTool) cannot presently generate correct updates to mutable\nsecondary indexes when pre-existing records are being updated. In the normal mutable secondary index write path, we can\nsafely calculate a Delete (for the old record) and a Put (for the new record) for each secondary index while holding a\nrow-lock to prevent concurrent updates. In the context of a MapReduce job, we cannot effectively execute this same logic\nbecause we are specifically doing this \"out of band\" from the HBase RegionServers. As such, while these Tools generate\nHFiles for the index tables with the proper updates for the data being loaded, any previous index records corresponding\nto the same record in the table are not deleted. This net-effect of this limitation is: if you use these Tools to re-ingest\nthe same records to an index table, that index table will have duplicate records in it which will result in incorrect\nquery results from that index table.",{"_11692":1388,"_44950":1252,"_16990":90583,"_5":16526,"_23412":90239,"_7169":90584},[45444],"To perform incremental loads of data using the BulkLoadTools which may update existing records, you must\ndrop and re-create all index tables after the data table is loaded. Re-creating the index with the ASYNC option and\nusing IndexTool to populate and enable that index is likely a must for tables of non-trivial size.",{"_11692":1389,"_44950":1252,"_16990":90586,"_5":16526,"_23412":90239,"_7169":90587},[45444],"To perform incremental loading of CSV datasets that do not require any manual index intervention, the psql tool can\nbe used in place of the BulkLoadTools. Additionally, a MapReduce job could be written to parse CSV/JSON data and write\nit directly to Phoenix; although, such a tool is not currently provided by Phoenix for users.",{"_11692":1390,"_44950":1252,"_16990":90589,"_5":16526,"_23412":90243,"_7169":90590},[45444],"Non transactional, mutable indexing requires special configuration options on the region server and master to run - Phoenix ensures that they are setup correctly when you enable mutable indexing on the table; if the correct properties are not set, you will not be able to use secondary indexing. After adding these settings to your hbase-site.xml, you'll need to do a rolling restart of your cluster.",{"_11692":1391,"_44950":1252,"_16990":90592,"_5":16526,"_23412":90243,"_7169":90593},[45444],"As Phoenix matures, it needs less and less manual configuration. For older Phoenix versions you'll need to add the properties listed for that version, as well as the properties listed for the later versions.",{"_11692":1392,"_44950":1252,"_16990":90595,"_5":16526,"_23412":90247,"_7169":90596},[45444],"You will need to add the following parameters to hbase-site.xml on each region server:",{"_11692":1393,"_44950":1252,"_16990":90598,"_5":16526,"_23412":90247,"_7169":90599},[45444],"The above property enables custom WAL edits to be written, ensuring proper writing/replay of the index updates. This codec supports the usual host of WALEdit options, most notably WALEdit compression.",{"_11692":1394,"_44950":1252,"_16990":90601,"_5":16526,"_23412":90251,"_7169":90602},[45444],"The following configuration changes are also required to the server-side hbase-site.xml on the master and regions server nodes:",{"_11692":1395,"_44950":1252,"_16990":90604,"_5":16526,"_23412":90251,"_7169":90605},[45444],"The above properties prevent deadlocks from occurring during index maintenance for global indexes (HBase 0.98.4+ and Phoenix 4.3.1+) by ensuring index updates are processed with a higher priority than data updates. It also prevents deadlocks by ensuring metadata rpc calls are processed with a higher priority than data rpc calls.",{"_11692":1396,"_44950":1252,"_16990":90607,"_5":16526,"_23412":90255,"_7169":90602},[45444],{"_11692":1397,"_44950":1252,"_16990":90609,"_5":16526,"_23412":90255,"_7169":90610},[45444],"The above properties are required to use local indexing.",{"_11692":1398,"_44950":1252,"_16990":90612,"_5":16526,"_23412":90259,"_7169":90613},[45444],"While upgrading the Phoenix to 4.8.0+ version at server remove above three local indexing related configurations from hbase-site.xml if present. From client we are supporting both online(while initializing the connection from phoenix client of 4.8.0+ versions) and offline(using psql tool) upgrade of local indexes created before 4.8.0. As part of upgrade we recreate the local indexes in ASYNC mode. After upgrade user need to build the indexes using IndexTool",{"_11692":1399,"_44950":1252,"_16990":90615,"_5":16526,"_23412":90259,"_7169":90616},[45444],"Following client side configuration used in the upgrade.",{"_11692":1400,"_44950":1252,"_16990":90618,"_5":16526,"_23412":90259,"_7169":90619},[45444],"phoenix.client.localIndexUpgradeThe value of it is true means online upgrade and false means offline upgrade.Default: true",{"_11692":1401,"_44950":1252,"_16990":90621,"_5":16526,"_23412":90259,"_7169":90622},[45444],"Command to run offline upgrade using psql:",{"_11692":1402,"_44950":1252,"_16990":90624,"_5":16526,"_23412":90263,"_7169":90625},[45444],"Out the box, indexing is pretty fast. However, to optimize for your particular environment and workload, there are several properties you can tune.",{"_11692":1403,"_44950":1252,"_16990":90627,"_5":16526,"_23412":90263,"_7169":90628},[45444],"All the following parameters must be set in hbase-site.xml - they are true for the entire cluster and all index tables, as well as across all regions on the same server (so, for instance, a single server would not write to too many different index tables at once).",{"_11692":1404,"_44950":1252,"_16990":90630,"_5":16526,"_23412":90263,"_7169":90631},[45444],"index.builder.threads.max",{"_11692":1405,"_44950":1252,"_16990":90633,"_5":16526,"_23412":90263,"_7169":90634},[45444],"Number of threads to used to build the index update from the primary table update",{"_11692":1406,"_44950":1252,"_16990":90636,"_5":16526,"_23412":90263,"_7169":90637},[45444],"Increasing this value overcomes the bottleneck of reading the current row state from the underlying HRegion. Tuning this value too high will just bottleneck at the HRegion as it will not be able to handle too many concurrent scan requests as well as general thread-swapping concerns.",{"_11692":1407,"_44950":1252,"_16990":90639,"_5":16526,"_23412":90263,"_7169":90640},[45444],"Default: 10",{"_11692":1408,"_44950":1252,"_16990":90642,"_5":16526,"_23412":90263,"_7169":90643},[45444],"index.builder.threads.keepalivetime",{"_11692":1409,"_44950":1252,"_16990":90645,"_5":16526,"_23412":90263,"_7169":90646},[45444],"Amount of time in seconds after we expire threads in the builder thread pool.",{"_11692":1410,"_44950":1252,"_16990":90648,"_5":16526,"_23412":90263,"_7169":90649},[45444],"Unused threads are immediately released after this amount of time and not core threads are retained (though this last is a small concern as tables are expected to sustain a fairly constant write load), but simultaneously allows us to drop threads if we are not seeing the expected load.",{"_11692":1411,"_44950":1252,"_16990":90651,"_5":16526,"_23412":90263,"_7169":90652},[45444],"Default: 60",{"_11692":1412,"_44950":1252,"_16990":90654,"_5":16526,"_23412":90263,"_7169":90655},[45444],"index.writer.threads.max",{"_11692":1413,"_44950":1252,"_16990":90657,"_5":16526,"_23412":90263,"_7169":90658},[45444],"Number of threads to use when writing to the target index tables.",{"_11692":1414,"_44950":1252,"_16990":90660,"_5":16526,"_23412":90263,"_7169":90661},[45444],"The first level of parallelization, on a per-table basis - it should roughly correspond to the number of index tables",{"_11692":1415,"_44950":1252,"_16990":90663,"_5":16526,"_23412":90263,"_7169":90640},[45444],{"_11692":1416,"_44950":1252,"_16990":90665,"_5":16526,"_23412":90263,"_7169":90666},[45444],"index.writer.threads.keepalivetime",{"_11692":1417,"_44950":1252,"_16990":90668,"_5":16526,"_23412":90263,"_7169":90669},[45444],"Amount of time in seconds after we expire threads in the writer thread pool.",{"_11692":1418,"_44950":1252,"_16990":90671,"_5":16526,"_23412":90263,"_7169":90649},[45444],{"_11692":1419,"_44950":1252,"_16990":90673,"_5":16526,"_23412":90263,"_7169":90652},[45444],{"_11692":1420,"_44950":1252,"_16990":90675,"_5":16526,"_23412":90263,"_7169":90676},[45444],"hbase.htable.threads.max",{"_11692":1421,"_44950":1252,"_16990":90678,"_5":16526,"_23412":90263,"_7169":90679},[45444],"Number of threads each index HTable can use for writes.",{"_11692":1422,"_44950":1252,"_16990":90681,"_5":16526,"_23412":90263,"_7169":90682},[45444],"Increasing this allows more concurrent index updates (for instance across batches), leading to high overall throughput.",{"_11692":1423,"_44950":1252,"_16990":90684,"_5":16526,"_23412":90263,"_7169":90685},[45444],"Default: 2,147,483,647",{"_11692":1424,"_44950":1252,"_16990":90687,"_5":16526,"_23412":90263,"_7169":90688},[45444],"hbase.htable.threads.keepalivetime",{"_11692":1425,"_44950":1252,"_16990":90690,"_5":16526,"_23412":90263,"_7169":90691},[45444],"Amount of time in seconds after we expire threads in the HTable's thread pool.",{"_11692":1426,"_44950":1252,"_16990":90693,"_5":16526,"_23412":90263,"_7169":90694},[45444],"Using the \"direct handoff\" approach, new threads will only be created if it is necessary and will grow unbounded. This could be bad but HTables only create as many Runnables as there are region servers; therefore, it also scales when new region servers are added.",{"_11692":1427,"_44950":1252,"_16990":90696,"_5":16526,"_23412":90263,"_7169":90652},[45444],{"_11692":1428,"_44950":1252,"_16990":90698,"_5":16526,"_23412":90263,"_7169":90699},[45444],"index.tablefactory.cache.size",{"_11692":1429,"_44950":1252,"_16990":90701,"_5":16526,"_23412":90263,"_7169":90702},[45444],"Number of index HTables we should keep in cache.",{"_11692":1430,"_44950":1252,"_16990":90704,"_5":16526,"_23412":90263,"_7169":90705},[45444],"Increasing this number ensures that we do not need to recreate an HTable for each attempt to write to an index table. Conversely, you could see memory pressure if this value is set too high.",{"_11692":1431,"_44950":1252,"_16990":90707,"_5":16526,"_23412":90263,"_7169":90640},[45444],{"_11692":1432,"_44950":1252,"_16990":90709,"_5":16526,"_23412":90263,"_7169":90710},[45444],"org.apache.phoenix.regionserver.index.priority.min",{"_11692":1433,"_44950":1252,"_16990":90712,"_5":16526,"_23412":90263,"_7169":90713},[45444],"Value to specify to bottom (inclusive) of the range in which index priority may lie.",{"_11692":1434,"_44950":1252,"_16990":90715,"_5":16526,"_23412":90263,"_7169":90716},[45444],"Default: 1000",{"_11692":1435,"_44950":1252,"_16990":90718,"_5":16526,"_23412":90263,"_7169":90719},[45444],"org.apache.phoenix.regionserver.index.priority.max",{"_11692":1436,"_44950":1252,"_16990":90721,"_5":16526,"_23412":90263,"_7169":90722},[45444],"Value to specify to top (exclusive) of the range in which index priority may lie.",{"_11692":1437,"_44950":1252,"_16990":90724,"_5":16526,"_23412":90263,"_7169":90725},[45444],"Higher priorites within the index min/max range do not means updates are processed sooner.",{"_11692":1438,"_44950":1252,"_16990":90727,"_5":16526,"_23412":90263,"_7169":90728},[45444],"Default: 1050",{"_11692":1439,"_44950":1252,"_16990":90730,"_5":16526,"_23412":90263,"_7169":90731},[45444],"org.apache.phoenix.regionserver.index.handler.count",{"_11692":1440,"_44950":1252,"_16990":90733,"_5":16526,"_23412":90263,"_7169":90734},[45444],"Number of threads to use when serving index write requests for global index maintenance.",{"_11692":1441,"_44950":1252,"_16990":90736,"_5":16526,"_23412":90263,"_7169":90737},[45444],"Though the actual number of threads is dictated by the Max(number of call queues, handler count), where the number of call queues is determined by standard HBase configuration. To further tune the queues, you can adjust the standard rpc queue length parameters (currently, there are no special knobs for the index queues), specifically ipc.server.max.callqueue.length and ipc.server.callqueue.handler.factor. See the HBase Reference Guide for more details.",{"_11692":1442,"_44950":1252,"_16990":90739,"_5":16526,"_23412":90263,"_7169":90740},[45444],"Default: 30",{"_11692":1443,"_44950":1252,"_16990":90742,"_5":16526,"_23412":90267,"_7169":90743},[45444],"We track secondary index performance via our performance framework. This is a generic test of performance based on defaults - your results will vary based on hardware specs as well as you individual configuration.",{"_11692":1444,"_44950":1252,"_16990":90745,"_5":16526,"_23412":90267,"_7169":90746},[45444],"That said, we have seen secondary indexing (both immutable and mutable) go as quickly as < 2x the regular write path on a small, (3 node) desktop-based cluster. This is actually pretty reasonable as we have to write to multiple tables as well as build the index update.",{"_11692":1445,"_44950":1252,"_16990":90748,"_5":16526,"_23412":90270,"_7169":90749},[45444],"With Phoenix 4.12, there is now a tool to run a MapReduce job to verify that an index table is valid against its data table. The only way to find orphaned rows in either table is to scan over all rows in the table and do a lookup in the other table for the corresponding row. For that reason, the tool can run with either the data or index table as the \"source\" table, and the other as the \"target\" table. The tool writes all invalid rows it finds either to file or to an output table PHOENIX_INDEX_SCRUTINY. An invalid row is a source row that either has no corresponding row in the target table, or has an incorrect value in the target table (i.e. covered column value).",{"_11692":1446,"_44950":1252,"_16990":90751,"_5":16526,"_23412":90270,"_7169":90752},[45444],"The tool has job counters that track its status. VALID_ROW_COUNT, INVALID_ROW_COUNT, BAD_COVERED_COL_VAL_COUNT. Note that invalid rows - bad col val rows = number of orphaned rows. These counters are written to the table PHOENIX_INDEX_SCRUTINY_METADATA, along with other job metadata.",{"_11692":1447,"_44950":1252,"_16990":90754,"_5":16526,"_23412":90270,"_7169":90755},[45444],"The Index Scrutiny Tool can be launched via the hbase command (in hbase/bin) as follows:",{"_11692":1448,"_44950":1252,"_16990":90757,"_5":16526,"_23412":90270,"_7169":90758},[45444],"It can also be run from Hadoop using either the phoenix-core or phoenix-server jar as follows:",{"_11692":1449,"_44950":1252,"_16990":90760,"_5":16526,"_23412":90270,"_7169":90761},[45444],"By default two mapreduce jobs are launched, one with the data table as the source table and one with the index table as the source table.",{"_11692":1450,"_44950":1252,"_16990":90763,"_5":16526,"_23412":90270,"_7169":90764},[45444],"The following parameters can be used with the Index Scrutiny Tool:",{"_11692":1451,"_44950":1252,"_16990":90766,"_5":16526,"_23412":90270,"_7169":88441},[45444],{"_11692":1452,"_44950":1252,"_16990":90768,"_5":16526,"_23412":90270,"_7169":88444},[45444],{"_11692":1453,"_44950":1252,"_16990":90770,"_5":16526,"_23412":90270,"_7169":90771},[45444],"-dt,--data-table",{"_11692":1454,"_44950":1252,"_16990":90773,"_5":16526,"_23412":90270,"_7169":90774},[45444],"Data table name (mandatory)",{"_11692":1455,"_44950":1252,"_16990":90776,"_5":16526,"_23412":90270,"_7169":88561},[45444],{"_11692":1456,"_44950":1252,"_16990":90778,"_5":16526,"_23412":90270,"_7169":90779},[45444],"Index table name (mandatory)",{"_11692":1457,"_44950":1252,"_16990":90781,"_5":16526,"_23412":90270,"_7169":88549},[45444],{"_11692":1458,"_44950":1252,"_16990":90783,"_5":16526,"_23412":90270,"_7169":88552},[45444],{"_11692":1459,"_44950":1252,"_16990":90785,"_5":16526,"_23412":90270,"_7169":90786},[45444],"-src,--source",{"_11692":1460,"_44950":1252,"_16990":90788,"_5":16526,"_23412":90270,"_7169":90789},[45444],"DATA_TABLE_SOURCE, INDEX_TABLE_SOURCE, or BOTH. Defaults to BOTH",{"_11692":1461,"_44950":1252,"_16990":90791,"_5":16526,"_23412":90270,"_7169":88543},[45444],{"_11692":1462,"_44950":1252,"_16990":90793,"_5":16526,"_23412":90270,"_7169":90794},[45444],"Whether to output invalid rows. Off by default",{"_11692":1463,"_44950":1252,"_16990":90796,"_5":16526,"_23412":90270,"_7169":90797},[45444],"-of,--output-format",{"_11692":1464,"_44950":1252,"_16990":90799,"_5":16526,"_23412":90270,"_7169":90800},[45444],"TABLE or FILE output format. Defaults to TABLE",{"_11692":1465,"_44950":1252,"_16990":90802,"_5":16526,"_23412":90270,"_7169":90803},[45444],"-om,--output-max",{"_11692":1466,"_44950":1252,"_16990":90805,"_5":16526,"_23412":90270,"_7169":90806},[45444],"Maximum number of invalid rows to output per mapper. Defaults to 1M",{"_11692":1467,"_44950":1252,"_16990":90808,"_5":16526,"_23412":90270,"_7169":90809},[45444],"-op,--output-path",{"_11692":1468,"_44950":1252,"_16990":90811,"_5":16526,"_23412":90270,"_7169":90812},[45444],"For FILE output format, the HDFS directory where files are written",{"_11692":1469,"_44950":1252,"_16990":90814,"_5":16526,"_23412":90270,"_7169":90815},[45444],"-t,--time",{"_11692":1470,"_44950":1252,"_16990":90817,"_5":16526,"_23412":90270,"_7169":90818},[45444],"Timestamp in millis at which to run the scrutiny. This is important so that incoming writes don't throw off the scrutiny. Defaults to current time minus 60 seconds",{"_11692":1471,"_44950":1252,"_16990":90820,"_5":16526,"_23412":90270,"_7169":90821},[45444],"-b,--batch-size",{"_11692":1472,"_44950":1252,"_16990":90823,"_5":16526,"_23412":90270,"_7169":90824},[45444],"Number of rows to compare at a time",{"_11692":1473,"_44950":1252,"_16990":90826,"_5":16526,"_23412":90274,"_7169":90827},[45444],"If rows are actively being updated or deleted while the scrutiny is running, the tool may give you false positives for inconsistencies (PHOENIX-4277).",{"_11692":1474,"_44950":1252,"_16990":90829,"_5":16526,"_23412":90274,"_7169":90830},[45444],"Snapshot reads are not supported by the scrutiny tool (PHOENIX-4270).",{"_11692":1475,"_44950":1252,"_16990":90832,"_5":16526,"_23412":90277,"_7169":90833},[45444],"IndexUpgradeTool updates global indexes created by Phoenix 4.14 and earlier (or 5.0) to use the new Strongly Consistent Global Indexes implementation.",{"_11692":1476,"_44950":1252,"_16990":90835,"_5":16526,"_23412":90277,"_7169":90836},[45444],"It accepts following parameters:",{"_11692":1477,"_44950":1252,"_16990":90838,"_5":16526,"_23412":90277,"_7169":88441},[45444],{"_11692":1478,"_44950":1252,"_16990":90840,"_5":16526,"_23412":90277,"_7169":88444},[45444],{"_11692":1479,"_44950":1252,"_16990":90842,"_5":16526,"_23412":90277,"_7169":90843},[45444],"only in version",{"_11692":1480,"_44950":1252,"_16990":90845,"_5":16526,"_23412":90277,"_7169":90846},[45444],"-o,--operation",{"_11692":1481,"_44950":1252,"_16990":90848,"_5":16526,"_23412":90277,"_7169":90849},[45444],"upgrade or rollback (mandatory)",{"_11692":1482,"_44950":1252,"_16990":90851,"_5":16526,"_23412":90277,"_7169":90852},[45444],"-tb,--tables",{"_11692":1483,"_44950":1252,"_16990":90854,"_5":16526,"_23412":90277,"_7169":90855},[45444],"[table1,table2,table3] (-tb or -f mandatory)",{"_11692":1484,"_44950":1252,"_16990":90857,"_5":16526,"_23412":90277,"_7169":90858},[45444],"-f,--file",{"_11692":1485,"_44950":1252,"_16990":90860,"_5":16526,"_23412":90277,"_7169":90861},[45444],"Csv file with above format (-tb or -f mandatory)",{"_11692":1486,"_44950":1252,"_16990":90863,"_5":16526,"_23412":90277,"_7169":90864},[45444],"-d,--dry-run",{"_11692":1487,"_44950":1252,"_16990":90866,"_5":16526,"_23412":90277,"_7169":90867},[45444],"If passed this will just output steps that will be executed; like a dry run",{"_11692":1488,"_44950":1252,"_16990":90869,"_5":16526,"_23412":90277,"_7169":90870},[45444],"-h,--help",{"_11692":1489,"_44950":1252,"_16990":90872,"_5":16526,"_23412":90277,"_7169":90873},[45444],"Help on how to use the tool",{"_11692":1490,"_44950":1252,"_16990":90875,"_5":16526,"_23412":90277,"_7169":90876},[45444],"-lf,--logfile",{"_11692":1491,"_44950":1252,"_16990":90878,"_5":16526,"_23412":90277,"_7169":90879},[45444],"File location to dump the logs",{"_11692":1492,"_44950":1252,"_16990":90881,"_5":16526,"_23412":90277,"_7169":90882},[45444],"-sr,--index-sync-rebuild",{"_11692":1493,"_44950":1252,"_16990":90884,"_5":16526,"_23412":90277,"_7169":90885},[45444],"whether or not synchronously rebuild the indexes; default rebuild asynchronous",{"_11692":1494,"_44950":1252,"_16990":90887,"_5":16526,"_23412":90277,"_7169":90888},[45444],"4.15",{"_11692":1495,"_44950":1252,"_16990":90890,"_5":16526,"_23412":90277,"_7169":90891},[45444],"-rb,--index-rebuild",{"_11692":1496,"_44950":1252,"_16990":90893,"_5":16526,"_23412":90277,"_7169":90894},[45444],"Rebuild the indexes. Set -tool to pass options to IndexTool",{"_11692":1497,"_44950":1252,"_16990":90896,"_5":16526,"_23412":90277,"_7169":90897},[45444],"4.16+, 5.1+",{"_11692":1498,"_44950":1252,"_16990":90899,"_5":16526,"_23412":90277,"_7169":90900},[45444],"-tool,--index-tool",{"_11692":1499,"_44950":1252,"_16990":90902,"_5":16526,"_23412":90277,"_7169":90903},[45444],"Options to pass to indexTool when rebuilding indexes",{"_11692":1500,"_44950":1252,"_16990":90905,"_5":16526,"_23412":90277,"_7169":90897},[45444],{"_11692":1501,"_44950":1252,"_16990":90907,"_5":16526,"_23412":90277,"_7169":90908},[45444],"For 4.16+/5.1+ either specifying the -rb option, or manually rebuilding the indexes with IndexTool after the upgrade is recommended, otherwise the first access of every index row will trigger an index row repair.",{"_11692":1502,"_44950":1252,"_16990":90910,"_5":16526,"_23412":90277,"_7169":90911},[45444],"Depending on whether index is mutable, it will remove Indexer coprocessor from a data table and load new coprocessor IndexRegionObserver. For both immutable and mutable, it will load GlobalIndexChecker coprocessor on Index table. During this process, data table and index table are disabled-loaded/unloaded with coproc-enabled within short time span. At the end, it does an asynchronous index rebuilds. Index reads are not blocked while index-rebuild is still ongoing, however, they may be a bit slower for rows written prior to upgrade.",{"_11692":1503,"_44950":1252,"_16990":90913,"_5":16526,"_23412":90277,"_7169":90914},[45444],"IndexUpgradeTool doesn't make any distinction between view-index and table-index. When a table is passed, it will perform the upgrade-operation on all the 'children' indexes of the given table.",{"_11692":1504,"_44950":1252,"_16990":90916,"_5":16526,"_23412":90281,"_7169":90917},[45444],"There have been several presentations given on how secondary indexing works in Phoenix that have a more in-depth look at how indexing works (with pretty pictures!):",{"_11692":1505,"_44950":1252,"_16990":90919,"_5":16526,"_23412":90281,"_7169":90920},[45444],"Slides for Strongly Consistent Global Indexes for Apache Phoenix, 2019 Distributed SQL Summit",{"_11692":1506,"_44950":1252,"_16990":90922,"_5":16526,"_23412":90281,"_7169":90923},[45444],"Recording of Strongly Consistent Global Indexes for Apache Phoenix, 2019 Distributed SQL Summit",{"_11692":1507,"_44950":1252,"_16990":90925,"_5":16526,"_23412":90281,"_7169":90926},[45444],"Slides for Local Secondary Indexes in Apache Phoenix, 2017 PhoenixCon",{"_11692":1508,"_44950":1252,"_16990":90928,"_5":16526,"_23412":90281,"_7169":90929},[45444],"These older resources refer to obsolete implementations in some cases",{"_11692":1509,"_44950":1252,"_16990":90931,"_5":16526,"_23412":90281,"_7169":90932},[45444],"Los Anglees HBase Meetup - Sept, 4th, 2013",{"_11692":1510,"_44950":1252,"_16990":90934,"_5":16526,"_23412":90281,"_7169":90935},[45444],"Local Indexes by Huawei",{"_11692":1511,"_44950":1252,"_16990":90937,"_5":16526,"_23412":90281,"_7169":90938},[45444],"PHOENIX-938 and HBASE-11513 for deadlock prevention during global index maintenance.",{"_11692":1512,"_44950":1252,"_16990":90940,"_5":16526,"_23412":90281,"_7169":90941},[45444],"PHOENIX-1112: Atomically rebuild index partially when index update fails",{"_11692":1513,"_44950":1513,"_5":12121,"_7169":90943,"_45415":90944,"_16990":90945,"_23412":1513},"Segment Scan",[86368,86369,86370,88058],[45444],{"_11692":1514,"_44950":1513,"_16990":90947,"_5":16526,"_23412":1513,"_7169":90948},[45444],"Get N evenly-bucketed key ranges for a Phoenix table so a client can drive a parallel full-table scan.",{"_11692":1515,"_44950":1513,"_5":45412,"_16990":90950,"_23412":90951,"_7169":88625},[45444],"/docs/features/segment-scan#segment-scan-when",{"_11692":1516,"_44950":1513,"_5":45412,"_16990":90953,"_23412":90954,"_7169":90955},[45444],"/docs/features/segment-scan#segment-scan-usage","Basic usage",{"_11692":1517,"_44950":1513,"_5":45412,"_16990":90957,"_23412":90958,"_7169":90959},[45444],"/docs/features/segment-scan#segment-scan-count","How many segments you actually get",{"_11692":1518,"_44950":1513,"_5":45412,"_16990":90961,"_23412":90962,"_7169":90963},[45444],"/docs/features/segment-scan#segment-scan-how","How it actually runs",{"_11692":1519,"_44950":1513,"_5":45412,"_16990":90965,"_23412":90966,"_7169":90967},[45444],"/docs/features/segment-scan#segment-scan-watch","Things to watch for",{"_11692":1520,"_44950":1513,"_16990":90969,"_5":16526,"_23412":1513,"_7169":90970},[45444],"Segment Scan turns a Phoenix table into N contiguous, non-overlapping key ranges\nthat you can hand out to a pool of workers to drive a parallel full-table scan. It is\nthe natural primitive for ETL exports, table validation/repair tools, bulk\nre-encoding, and anything else that needs to walk every row as fast as the cluster\ncan serve it. Available in Phoenix 5.3.0\n(PHOENIX-7684).",{"_11692":1521,"_44950":1513,"_16990":90972,"_5":16526,"_23412":90951,"_7169":90973},[45444],"Reach for Segment Scan when you want to read every row and you'd rather have many\nworkers do it concurrently than one client streaming sequentially. Typical use cases:",{"_11692":1522,"_44950":1513,"_16990":90975,"_5":16526,"_23412":90951,"_7169":90976},[45444],"Snapshot exports to a data lake / warehouse.",{"_11692":1523,"_44950":1513,"_16990":90978,"_5":16526,"_23412":90951,"_7169":90979},[45444],"Backfills or re-encodes (e.g. moving a column from VARBINARY to\nVARBINARY_ENCODED).",{"_11692":1524,"_44950":1513,"_16990":90981,"_5":16526,"_23412":90951,"_7169":90982},[45444],"Validation/repair scripts that scrub or hash every row.",{"_11692":1525,"_44950":1513,"_16990":90984,"_5":16526,"_23412":90951,"_7169":90985},[45444],"DynamoDB-style parallel scan against a Phoenix-backed table.",{"_11692":1526,"_44950":1513,"_16990":90987,"_5":16526,"_23412":90951,"_7169":90988},[45444],"If you only want to read some rows (e.g. by a key prefix or an indexed predicate),\nissue a normal SQL query — Segment Scan is for full-table fan-out, not selective\nfiltering.",{"_11692":1527,"_44950":1513,"_16990":90990,"_5":16526,"_23412":90954,"_7169":90991},[45444],"Two helpers — SCAN_START_KEY() and SCAN_END_KEY() — return the start and end\nrow keys of each segment. The TOTAL_SEGMENTS() = N predicate in the WHERE clause\nis what asks Phoenix to bucket the table into segments instead of running the query\nagainst the data:",{"_11692":1528,"_44950":1513,"_16990":90993,"_5":16526,"_23412":90954,"_7169":90994},[45444],"You get back one row per segment with two VARBINARY columns: the start key and\nthe end key of that range. Either may be empty — an empty start key means\n\"from the beginning of the table\"; an empty end key means \"to the end of the table\".",{"_11692":1529,"_44950":1513,"_16990":90996,"_5":16526,"_23412":90954,"_7169":90997},[45444],"The bytes are HBase-level row key bytes — typically you hand each (start_key,\nend_key) pair to a worker that drives a scan via the lower-level scan API (e.g.\nHBase Scan.setStartRow / setStopRow, or a framework like Phoenix's MapReduce\ninput format that accepts byte-range bounds). Each worker scans its slice\nindependently, in parallel.",{"_11692":1530,"_44950":1513,"_16990":90999,"_5":16526,"_23412":90958,"_7169":91000},[45444],"The number of segments returned is min(N, num_regions):",{"_11692":1531,"_44950":1513,"_16990":91002,"_5":16526,"_23412":90958,"_7169":91003},[45444],"If N <= num_regions, Phoenix bundles consecutive regions together so you get\nexactly N segments. The grouping is as even as possible — with r = num_regions\nmod N segments getting one extra region.",{"_11692":1532,"_44950":1513,"_16990":91005,"_5":16526,"_23412":90958,"_7169":91006},[45444],"If N > num_regions, you simply get one segment per region. Phoenix will not\nsplit a region's key range into smaller sub-ranges for you, so the maximum\nachievable parallelism is bounded by the number of regions in the table.",{"_11692":1533,"_44950":1513,"_16990":91008,"_5":16526,"_23412":90958,"_7169":91009},[45444],"If you want more parallelism than your region count permits, pre-split the table or\nsalt it; Segment Scan respects whatever the current region layout is.",{"_11692":1534,"_44950":1513,"_16990":91011,"_5":16526,"_23412":90958,"_7169":91012},[45444],"N must be a positive integer. Passing 0 or a negative value returns SQL error\ncode 221 (\"TOTAL_SEGMENTS() value must be greater than 0\").",{"_11692":1535,"_44950":1513,"_16990":91014,"_5":16526,"_23412":90962,"_7169":91015},[45444],"TOTAL_SEGMENTS() is a marker, not a server-side function. The Phoenix planner sees\nit during compilation and replaces the query plan entirely with a client-side plan\nthat:",{"_11692":1536,"_44950":1513,"_16990":91017,"_5":16526,"_23412":90962,"_7169":91018},[45444],"Looks up the table's current region locations.",{"_11692":1537,"_44950":1513,"_16990":91020,"_5":16526,"_23412":90962,"_7169":91021},[45444],"Buckets them into min(N, num_regions) contiguous groups.",{"_11692":1538,"_44950":1513,"_16990":91023,"_5":16526,"_23412":90962,"_7169":91024},[45444],"Returns each group's combined (start_key, end_key) as a result row.",{"_11692":1539,"_44950":1513,"_16990":91026,"_5":16526,"_23412":90962,"_7169":91027},[45444],"No region-server scan is issued for this query — it's a metadata-only operation, so\nit's cheap to call, and it doesn't read or count any of the actual data.",{"_11692":1540,"_44950":1513,"_16990":91029,"_5":16526,"_23412":90966,"_7169":91030},[45444],"Region layout changes between discovery and scan. The segments you got back\nreflect the region layout at the time of the call. If the table splits or merges\nbetween segment discovery and your parallel scan, your (start_key, end_key)\nranges are still valid as byte ranges — they just may not align with current\nregions. The parallel scan still works; you just lose some of the\nregion-locality benefit.",{"_11692":1541,"_44950":1513,"_16990":91032,"_5":16526,"_23412":90966,"_7169":91033},[45444],"Each segment can still hold a lot of data. Segments correspond to one or more\nwhole regions. If your regions are large or unevenly populated, individual\nworkers may end up scanning more than others. Use this with the standard scan\ncontrols (paging, batch sizes) rather than relying on Segment Scan to balance row\ncounts.",{"_11692":1542,"_44950":1513,"_16990":91035,"_5":16526,"_23412":90966,"_7169":91036},[45444],"Segment Scan describes ranges; it doesn't scan. The parallel scan itself is\nyour responsibility. The typical pattern is a worker pool that takes one\n(start_key, end_key) per task and runs a regular Phoenix query bounded by that\nrange.",{"_11692":1543,"_44950":1543,"_5":12121,"_7169":91038,"_45415":91039,"_16990":91040,"_23412":1543},"Skip Scan",[86368,86369,86370,88058],[45444],{"_11692":1544,"_44950":1543,"_16990":91042,"_5":16526,"_23412":1543,"_7169":91043},[45444],"How Phoenix Skip Scan uses key-range hints to efficiently skip non-matching row-key regions.",{"_11692":1545,"_44950":1543,"_16990":91045,"_5":16526,"_23412":1543,"_7169":91046},[45444],"Phoenix uses Skip Scan for intra-row scanning which allows for significant performance improvement over Range Scan when rows are retrieved based on a given set of keys.",{"_11692":1546,"_44950":1543,"_16990":91048,"_5":16526,"_23412":1543,"_7169":91049},[45444],"Skip Scan leverages SEEK_NEXT_USING_HINT in HBase filters. It stores information about which key sets or key ranges are being searched for in each column. During filter evaluation, it checks whether a key is in one of the valid combinations or ranges. If not, it computes the next highest key to jump to.",{"_11692":1547,"_44950":1543,"_16990":91051,"_5":16526,"_23412":1543,"_7169":91052},[45444],"Input to SkipScanFilter is a List<List<KeyRange>> where the top-level list represents each row-key column (that is, each primary key part), and the inner list represents OR-ed byte-array boundaries.",{"_11692":1548,"_44950":1543,"_16990":91054,"_5":16526,"_23412":1543,"_7169":91055},[45444],"Consider the following query:",{"_11692":1549,"_44950":1543,"_16990":91057,"_5":16526,"_23412":1543,"_7169":91058},[45444],"For the query above, the List<List<KeyRange>> passed to SkipScanFilter would look like:",{"_11692":1550,"_44950":1543,"_16990":91060,"_5":16526,"_23412":1543,"_7169":91061},[45444],"Here, [[a - b], [d - e]] represents ranges for KEY1, and [1, 2] represents the keys for KEY2.",{"_11692":1551,"_44950":1543,"_16990":91063,"_5":16526,"_23412":1543,"_7169":91064},[45444],"The following diagram illustrates graphically how the skip scan is able to jump around the key space:",{"_11692":1552,"_44950":1552,"_5":12121,"_7169":91066,"_45415":91067,"_16990":91068,"_23412":1552},"Statistics Collection",[86368,86369,86370,88058],[45444],{"_11692":1553,"_44950":1552,"_16990":91070,"_5":16526,"_23412":1552,"_7169":91071},[45444],"How Phoenix collects and uses guidepost statistics for query parallelization, with commands and configuration.",{"_11692":1554,"_44950":1552,"_5":45412,"_16990":91073,"_23412":91074,"_7169":91075},[45444],"/docs/features/statistics-collection#statistics-collection-parallelization","Parallelization",{"_11692":1555,"_44950":1552,"_5":45412,"_16990":91077,"_23412":91078,"_7169":88066},[45444],"/docs/features/statistics-collection#statistics-collection-examples",{"_11692":1556,"_44950":1552,"_5":45412,"_16990":91080,"_23412":91081,"_7169":91082},[45444],"/docs/features/statistics-collection#known-issues","Known issues",{"_11692":1557,"_44950":1552,"_5":45412,"_16990":91084,"_23412":91085,"_7169":86420},[45444],"/docs/features/statistics-collection#statistics-collection-configuration",{"_11692":1558,"_44950":1552,"_16990":91087,"_5":16526,"_23412":1552,"_7169":91088},[45444],"The UPDATE STATISTICS command updates the statistics collected on a table.\nThis command collects a set of keys per region per column family that\nare equal byte distanced from each other. These collected keys are called guideposts\nand they act as hints/guides to improve the parallelization of queries on a given\ntarget region.",{"_11692":1559,"_44950":1552,"_16990":91090,"_5":16526,"_23412":1552,"_7169":91091},[45444],"Statistics are also automatically collected during major compactions and region splits so\nmanually running this command may not be necessary.",{"_11692":1560,"_44950":1552,"_16990":91093,"_5":16526,"_23412":91074,"_7169":91094},[45444],"Phoenix breaks up queries into multiple scans and runs them in parallel to reduce latency.\nParallelization in Phoenix is driven by statistics-related configuration parameters.\nEach chunk of data between guideposts will be run in parallel in a separate scan to improve\nquery performance. The chunk size is determined by the GUIDE_POSTS_WIDTH table property (Phoenix 4.9+)\nor the global server-side phoenix.stats.guidepost.width parameter if the table property is\nnot set. As the size of the chunks decrease,\nyou'll want to increase phoenix.query.queueSize as more work will be queued in that\ncase. Note that at a minimum, separate scans will be run for each table region. Statistics in Phoenix\nprovides a means of gaining intraregion parallelization. In addition to the guidepost width specification,\nthe client-side phoenix.query.threadPoolSize and phoenix.query.queueSize parameters\nand the server-side hbase.regionserver.handler.count parameter have an impact on the amount\nof parallelization.",{"_11692":1561,"_44950":1552,"_16990":91096,"_5":16526,"_23412":91078,"_7169":91097},[45444],"To update the statistics for a given table my_table, execute the following command:",{"_11692":1562,"_44950":1552,"_16990":91099,"_5":16526,"_23412":91078,"_7169":91100},[45444],"The above syntax would collect the statistics for the table my_table and all the index tables,\nviews and view index tables associated with the table my_table.",{"_11692":1563,"_44950":1552,"_16990":91102,"_5":16526,"_23412":91078,"_7169":91103},[45444],"The equivalent syntax is:",{"_11692":1564,"_44950":1552,"_16990":91105,"_5":16526,"_23412":91078,"_7169":91106},[45444],"To collect statistics on the index table only:",{"_11692":1565,"_44950":1552,"_16990":91108,"_5":16526,"_23412":91078,"_7169":91109},[45444],"To collect statistics on the table only:",{"_11692":1566,"_44950":1552,"_16990":91111,"_5":16526,"_23412":91078,"_7169":91112},[45444],"To modify the guidepost width to 10MB for a table, execute the following command:",{"_11692":1567,"_44950":1552,"_16990":91114,"_5":16526,"_23412":91078,"_7169":91115},[45444],"To remove the guidepost width, set the property to null:",{"_11692":1568,"_44950":1552,"_16990":91117,"_5":16526,"_23412":91081,"_7169":91118},[45444],"Duplicated records (SQL count shows more rows than HBase row_count) can occur in Phoenix versions earlier than 4.12.",{"_11692":1569,"_44950":1552,"_16990":91120,"_5":16526,"_23412":91081,"_7169":91121},[45444],"This may happen for tables with several regions where guideposts were not generated for the last region(s) because the region size is smaller than the guidepost width.\nIn that case, parallel scans for those regions may start with the latest guidepost instead of the region start key.\nThis was fixed in 4.12 as part of PHOENIX-4007.",{"_11692":1570,"_44950":1552,"_16990":91123,"_5":16526,"_23412":91085,"_7169":91124},[45444],"The configuration parameters controlling statistics collection include:",{"_11692":1571,"_44950":1552,"_16990":91126,"_5":16526,"_23412":91085,"_7169":91127},[45444],"phoenix.stats.guidepost.width",{"_11692":1572,"_44950":1552,"_16990":91129,"_5":16526,"_23412":91085,"_7169":91130},[45444],"A server-side parameter that specifies the number of bytes between guideposts.\nA smaller amount increases parallelization, but also increases the number of\nchunks which must be merged on the client side.",{"_11692":1573,"_44950":1552,"_16990":91132,"_5":16526,"_23412":91085,"_7169":91133},[45444],"The default value is 104857600 (100 MB).",{"_11692":1574,"_44950":1552,"_16990":91135,"_5":16526,"_23412":91085,"_7169":91136},[45444],"phoenix.stats.updateFrequency",{"_11692":1575,"_44950":1552,"_16990":91138,"_5":16526,"_23412":91085,"_7169":91139},[45444],"A server-side parameter that determines the frequency in milliseconds for which statistics\nwill be refreshed from the statistics table and subsequently used by the client.",{"_11692":1576,"_44950":1552,"_16990":91141,"_5":16526,"_23412":91085,"_7169":91142},[45444],"The default value is 900000 (15 mins).",{"_11692":1577,"_44950":1552,"_16990":91144,"_5":16526,"_23412":91085,"_7169":91145},[45444],"phoenix.stats.minUpdateFrequency - A client-side parameter that determines the minimum amount of time in milliseconds that\nmust pass before statistics may again be manually collected through another UPDATE\nSTATISTICS call. - The default value is phoenix.stats.updateFrequency divided by two (7.5 mins).",{"_11692":1578,"_44950":1552,"_16990":91147,"_5":16526,"_23412":91085,"_7169":91148},[45444],"phoenix.stats.useCurrentTime",{"_11692":1579,"_44950":1552,"_16990":91150,"_5":16526,"_23412":91085,"_7169":91151},[45444],"An advanced server-side parameter that, if true, causes the current time on the server-side\nto be used as the timestamp of rows in the statistics table when background tasks such as\ncompactions or splits occur. If false, then the max timestamp found while traversing the\ntable over which statistics are being collected is used as the timestamp. Unless your\nclient is controlling the timestamps while reading and writing data, this parameter\nshould be left alone.",{"_11692":1580,"_44950":1552,"_16990":91153,"_5":16526,"_23412":91085,"_7169":91154},[45444],"The default value is true.",{"_11692":1581,"_44950":1552,"_16990":91156,"_5":16526,"_23412":91085,"_7169":91157},[45444],"phoenix.use.stats.parallelization",{"_11692":1582,"_44950":1552,"_16990":91159,"_5":16526,"_23412":91085,"_7169":91160},[45444],"This configuration is available starting in Phoenix 4.12. It controls whether statistical information\non the data should be used to drive query parallelization.",{"_11692":1583,"_44950":1552,"_16990":91162,"_5":16526,"_23412":91085,"_7169":91154},[45444],{"_11692":1584,"_44950":1584,"_5":12121,"_7169":91164,"_45415":91165,"_16990":91166,"_23412":1584},"Storage Formats",[86368,86369,86370,88058],[45444],{"_11692":1585,"_44950":1584,"_16990":91168,"_5":16526,"_23412":1584,"_7169":91169},[45444],"Configure Phoenix column mapping and immutable storage encoding for better storage efficiency and performance.",{"_11692":1586,"_44950":1584,"_5":45412,"_16990":91171,"_23412":91172,"_7169":91173},[45444],"/docs/features/storage-formats#how-to-use-column-mapping","How to use column mapping",{"_11692":1587,"_44950":1584,"_5":45412,"_16990":91175,"_23412":91176,"_7169":91177},[45444],"/docs/features/storage-formats#how-to-use-immutable-data-encoding","How to use immutable data encoding",{"_11692":1588,"_44950":1584,"_5":45412,"_16990":91179,"_23412":91180,"_7169":91181},[45444],"/docs/features/storage-formats#how-to-disable-column-mapping","How to disable column mapping",{"_11692":1589,"_44950":1584,"_16990":91183,"_5":16526,"_23412":1584,"_7169":91184},[45444],"As part of Phoenix 4.10, we have reduced on-disk storage size to improve overall performance by implementing the following enhancements:",{"_11692":1590,"_44950":1584,"_16990":91186,"_5":16526,"_23412":1584,"_7169":91187},[45444],"Introduce a layer of indirection between Phoenix column names and the corresponding HBase column qualifiers.",{"_11692":1591,"_44950":1584,"_16990":91189,"_5":16526,"_23412":1584,"_7169":91190},[45444],"Support a new encoding scheme for immutable tables that packs all values into a single cell per column family.",{"_11692":1592,"_44950":1584,"_16990":91192,"_5":16526,"_23412":1584,"_7169":91193},[45444],"For more details on column mapping and immutable data encoding, see this blog.",{"_11692":1593,"_44950":1584,"_16990":91195,"_5":16526,"_23412":91172,"_7169":91196},[45444],"You can set the column mapping property only when creating a table. Before deciding to use column mapping, think about how many columns your table and view hierarchy will require over their lifecycle. The following limits apply for each mapping scheme:",{"_11692":1594,"_44950":1584,"_16990":91198,"_5":16526,"_23412":91172,"_7169":91199},[45444],"Config/Property Value",{"_11692":1595,"_44950":1584,"_16990":91201,"_5":16526,"_23412":91172,"_7169":91202},[45444],"Max # of columns",{"_11692":1596,"_44950":1584,"_16990":91204,"_5":16526,"_23412":91172,"_7169":8714},[45444],{"_11692":1597,"_44950":1584,"_16990":91206,"_5":16526,"_23412":91172,"_7169":43732},[45444],{"_11692":1598,"_44950":1584,"_16990":91208,"_5":16526,"_23412":91172,"_7169":8743},[45444],{"_11692":1599,"_44950":1584,"_16990":91210,"_5":16526,"_23412":91172,"_7169":44931},[45444],{"_11692":1600,"_44950":1584,"_16990":91212,"_5":16526,"_23412":91172,"_7169":8770},[45444],{"_11692":1601,"_44950":1584,"_16990":91214,"_5":16526,"_23412":91172,"_7169":42672},[45444],{"_11692":1602,"_44950":1584,"_16990":91216,"_5":16526,"_23412":91172,"_7169":8693},[45444],{"_11692":1603,"_44950":1584,"_16990":91218,"_5":16526,"_23412":91172,"_7169":43626},[45444],{"_11692":1604,"_44950":1584,"_16990":91220,"_5":16526,"_23412":91172,"_7169":91221},[45444],"NONE",{"_11692":1605,"_44950":1584,"_16990":91223,"_5":16526,"_23412":91172,"_7169":91224},[45444],"no limit (theoretically)",{"_11692":1606,"_44950":1584,"_16990":91226,"_5":16526,"_23412":91172,"_7169":91227},[45444],"For mutable tables, this limit applies to columns in all column families. For immutable tables, the limit applies per column family. By default, new Phoenix tables use column mapping. These defaults can be overridden by setting the following config value in hbase-site.xml.",{"_11692":1607,"_44950":1584,"_16990":91229,"_5":16526,"_23412":91172,"_7169":91230},[45444],"Table type",{"_11692":1608,"_44950":1584,"_16990":91232,"_5":16526,"_23412":91172,"_7169":91233},[45444],"Default Column mapping",{"_11692":1609,"_44950":1584,"_16990":91235,"_5":16526,"_23412":91172,"_7169":91236},[45444],"Config",{"_11692":1610,"_44950":1584,"_16990":91238,"_5":16526,"_23412":91172,"_7169":91239},[45444],"Mutable/Immutable",{"_11692":1611,"_44950":1584,"_16990":91241,"_5":16526,"_23412":91172,"_7169":91242},[45444],"2 byte qualifiers",{"_11692":1612,"_44950":1584,"_16990":91244,"_5":16526,"_23412":91172,"_7169":91245},[45444],"phoenix.default.column.encoded.bytes.attrib",{"_11692":1613,"_44950":1584,"_16990":91247,"_5":16526,"_23412":91172,"_7169":91248},[45444],"This config controls global defaults that apply to all tables. If you want a different mapping scheme than the global default, use the COLUMN_ENCODED_BYTES table property.",{"_11692":1614,"_44950":1584,"_16990":91250,"_5":16526,"_23412":91176,"_7169":91251},[45444],"Like column mapping, immutable data encoding can only be set when creating a table. Through performance testing, SINGLE_CELL_ARRAY_WITH_OFFSETS generally provides strong performance and space savings. Below are some scenarios where ONE_CELL_PER_COLUMN encoding may be a better fit.",{"_11692":1615,"_44950":1584,"_16990":91253,"_5":16526,"_23412":91176,"_7169":91254},[45444],"Data is sparse, i.e. less than 50% of the columns have values.",{"_11692":1616,"_44950":1584,"_16990":91256,"_5":16526,"_23412":91176,"_7169":91257},[45444],"Size of data within a column family gets too big. With default HBase block size of 64K, if data within a column family grows beyond 50K then SINGLE_CELL_ARRAY_WITH_OFFSETS is generally not recommended.",{"_11692":1617,"_44950":1584,"_16990":91259,"_5":16526,"_23412":91176,"_7169":91260},[45444],"Immutable tables that are expected to have views on them.",{"_11692":1618,"_44950":1584,"_16990":91262,"_5":16526,"_23412":91176,"_7169":91263},[45444],"By default, immutable non-multitenant tables are created using two-byte column mapping and SINGLE_CELL_ARRAY_WITH_OFFSETS data encoding. Immutable multi-tenant tables are created with two-byte column mapping and ONE_CELL_PER_COLUMN data encoding. This is because users often create tenant-specific views on base multi-tenant tables, and as noted above this is more suitable for ONE_CELL_PER_COLUMN. Like column mapping, you can change these global defaults by setting the following configs in hbase-site.xml.",{"_11692":1619,"_44950":1584,"_16990":91265,"_5":16526,"_23412":91176,"_7169":91266},[45444],"Immutable Table type",{"_11692":1620,"_44950":1584,"_16990":91268,"_5":16526,"_23412":91176,"_7169":91269},[45444],"Immutable storage scheme",{"_11692":1621,"_44950":1584,"_16990":91271,"_5":16526,"_23412":91176,"_7169":91236},[45444],{"_11692":1622,"_44950":1584,"_16990":91273,"_5":16526,"_23412":91176,"_7169":91274},[45444],"Multi-tenant",{"_11692":1623,"_44950":1584,"_16990":91276,"_5":16526,"_23412":91176,"_7169":91277},[45444],"ONE_CELL_PER_COLUMN",{"_11692":1624,"_44950":1584,"_16990":91279,"_5":16526,"_23412":91176,"_7169":91280},[45444],"phoenix.default.multitenant.immutable.storage.scheme",{"_11692":1625,"_44950":1584,"_16990":91282,"_5":16526,"_23412":91176,"_7169":91283},[45444],"Non multi-tenant",{"_11692":1626,"_44950":1584,"_16990":91285,"_5":16526,"_23412":91176,"_7169":91286},[45444],"SINGLE_CELL_ARRAY_WITH_OFFSETS",{"_11692":1627,"_44950":1584,"_16990":91288,"_5":16526,"_23412":91176,"_7169":91289},[45444],"phoenix.default.immutable.storage.scheme",{"_11692":1628,"_44950":1584,"_16990":91291,"_5":16526,"_23412":91176,"_7169":91292},[45444],"You can also provide specific immutable storage and column mapping schemes with the IMMUTABLE_STORAGE_SCHEME and COLUMN_ENCODED_BYTES table properties. For example:",{"_11692":1629,"_44950":1584,"_16990":91294,"_5":16526,"_23412":91176,"_7169":91295},[45444],"You can choose not to use SINGLE_CELL_ARRAY_WITH_OFFSETS while still using numeric column mapping. For example:",{"_11692":1630,"_44950":1584,"_16990":91297,"_5":16526,"_23412":91176,"_7169":91298},[45444],"When using SINGLE_CELL_ARRAY_WITH_OFFSETS, you must use a numeric column mapping scheme. Attempting to use SINGLE_CELL_ARRAY_WITH_OFFSETS with COLUMN_ENCODED_BYTES = NONE throws an error.",{"_11692":1631,"_44950":1584,"_16990":91300,"_5":16526,"_23412":91180,"_7169":91301},[45444],"To disable column mapping across all new tables, set phoenix.default.column.encoded.bytes.attrib to 0. You can also keep it enabled globally and disable it selectively for a table by setting COLUMN_ENCODED_BYTES = 0 in the CREATE TABLE statement.",{"_11692":1632,"_44950":1632,"_5":12121,"_7169":91303,"_45415":91304,"_16990":91305,"_23412":1632},"Table Sampling",[86368,86369,86370,88058],[45444],{"_11692":1633,"_44950":1632,"_16990":91307,"_5":16526,"_23412":1632,"_7169":91308},[45444],"Use TABLESAMPLE in Phoenix for Bernoulli-style sampling, with performance notes, repeatability behavior, and tuning guidance.",{"_11692":1634,"_44950":1632,"_5":45412,"_16990":91310,"_23412":91311,"_7169":90119},[45444],"/docs/features/table-sampling#table-sampling-performance",{"_11692":1635,"_44950":1632,"_5":45412,"_16990":91313,"_23412":91314,"_7169":91315},[45444],"/docs/features/table-sampling#repeatable","Repeatable",{"_11692":1636,"_44950":1632,"_5":45412,"_16990":91317,"_23412":91318,"_7169":88066},[45444],"/docs/features/table-sampling#table-sampling-examples",{"_11692":1637,"_44950":1632,"_5":45412,"_16990":91320,"_23412":91321,"_7169":90264},[45444],"/docs/features/table-sampling#table-sampling-tuning",{"_11692":1638,"_44950":1632,"_16990":91323,"_5":16526,"_23412":1632,"_7169":91324},[45444],"To support table sampling (similar to PostgreSQL and T-SQL syntax), a TABLESAMPLE clause was incorporated into aliased table references as of Phoenix 4.12. The general syntax is described here. This feature limits the number of rows returned from a table to a percentage of rows. See PHOENIX-153 for implementation details.",{"_11692":1639,"_44950":1632,"_16990":91326,"_5":16526,"_23412":1632,"_7169":91327},[45444],"This feature is implemented with a Bernoulli trial and a consistent-hashing-based table sampler to achieve Bernoulli sampling on a given row population. Given a sampling rate, it leverages Phoenix statistics and HBase region distribution to perform table sampling.",{"_11692":1640,"_44950":1632,"_16990":91329,"_5":16526,"_23412":1632,"_7169":91330},[45444],"As part of statistics collection, a guidepost (a row reference) is created at equidistant byte intervals. When sampling is required, a Bernoulli trial process is applied repeatedly on each guidepost in each region with a probability proportional to the sampling rate. An included guidepost results in all rows between it and the next guidepost being included in the sample population.",{"_11692":1641,"_44950":1632,"_16990":91332,"_5":16526,"_23412":91311,"_7169":91333},[45444],"Sampling on a table with a sampling rate of 100% costs roughly the same computational resources as a query without sampling.\nResource consumption drops quickly as sampling rate decreases. In general, the amortized complexity of the sampling process is O(k + mn), where:",{"_11692":1642,"_44950":1632,"_16990":91335,"_5":16526,"_23412":91311,"_7169":91336},[45444],"n is the number of regions in the sampled HBase table.",{"_11692":1643,"_44950":1632,"_16990":91338,"_5":16526,"_23412":91311,"_7169":91339},[45444],"m is the number of guideposts.",{"_11692":1644,"_44950":1632,"_16990":91341,"_5":16526,"_23412":91311,"_7169":91342},[45444],"k is the sampled population size.",{"_11692":1645,"_44950":1632,"_16990":91344,"_5":16526,"_23412":91314,"_7169":91345},[45444],"Repeatable means repeated sampling on the same table returns the same sampled result.",{"_11692":1646,"_44950":1632,"_16990":91347,"_5":16526,"_23412":91314,"_7169":91348},[45444],"Repeatability is enabled by applying a consistent-hashing process to the binary representation of the start row key of each guidepost in each region during sampling. By default, an FNV1 implementation with lazy modulo is used. See FNV1.",{"_11692":1647,"_44950":1632,"_16990":91350,"_5":16526,"_23412":91318,"_7169":91351},[45444],"To sample a table, execute a query such as the following. The sampling rate is a numeric value between 0 and 100, inclusive.",{"_11692":1648,"_44950":1632,"_16990":91353,"_5":16526,"_23412":91318,"_7169":91354},[45444],"More examples:",{"_11692":1649,"_44950":1632,"_16990":91356,"_5":16526,"_23412":91318,"_7169":91357},[45444],"To use with aggregation:",{"_11692":1650,"_44950":1632,"_16990":91359,"_5":16526,"_23412":91318,"_7169":91360},[45444],"To explain a sampled query:",{"_11692":1651,"_44950":1632,"_16990":91362,"_5":16526,"_23412":91321,"_7169":91363},[45444],"Due to the sampling process, TABLESAMPLE should be used with caution. For example, a join of two tables is likely to return a match for each row in both tables; however, when sampling is applied to one or both tables, join results may differ from non-sampled expectations.",{"_11692":1652,"_44950":1632,"_16990":91365,"_5":16526,"_23412":91321,"_7169":91366},[45444],"Statistics should be collected to achieve the best sampling accuracy. To turn on statistics collection, refer to Statistics Collection.",{"_11692":1653,"_44950":1632,"_16990":91368,"_5":16526,"_23412":91321,"_7169":91369},[45444],"A denser guidepost setting improves sampling accuracy, but may reduce performance. A comparison is shown below.",{"_11692":1654,"_44950":1654,"_5":12121,"_7169":91371,"_45415":91372,"_16990":91373,"_23412":1654},"Tracing",[86368,86369,86370,88058],[45444],{"_11692":1655,"_44950":1654,"_16990":91375,"_5":16526,"_23412":1654,"_7169":91376},[45444],"Configure, enable, collect, and inspect Phoenix tracing data, including metrics sinks and tracing web app usage.",{"_11692":1656,"_44950":1654,"_5":45412,"_16990":91378,"_23412":91379,"_7169":86420},[45444],"/docs/features/tracing#tracing-configuration",{"_11692":1657,"_44950":1654,"_5":45412,"_16990":91381,"_23412":91382,"_7169":91383},[45444],"/docs/features/tracing#hadoop-metrics2-phoenixproperties","hadoop-metrics2-phoenix.properties",{"_11692":1658,"_44950":1654,"_5":45412,"_16990":91385,"_23412":91386,"_7169":91387},[45444],"/docs/features/tracing#hadoop-metrics2-hbaseproperties","hadoop-metrics2-hbase.properties",{"_11692":1659,"_44950":1654,"_5":45412,"_16990":91389,"_23412":91390,"_7169":91391},[45444],"/docs/features/tracing#disabling-tracing","Disabling tracing",{"_11692":1660,"_44950":1654,"_5":45412,"_16990":91393,"_23412":91394,"_7169":89522},[45444],"/docs/features/tracing#tracing-usage",{"_11692":1661,"_44950":1654,"_5":45412,"_16990":91396,"_23412":91397,"_7169":91398},[45444],"/docs/features/tracing#client-property","Client Property",{"_11692":1662,"_44950":1654,"_5":45412,"_16990":91400,"_23412":91401,"_7169":91402},[45444],"/docs/features/tracing#hbase-sitexml","hbase-site.xml",{"_11692":1663,"_44950":1654,"_5":45412,"_16990":91404,"_23412":91405,"_7169":91406},[45444],"/docs/features/tracing#reading-traces","Reading Traces",{"_11692":1664,"_44950":1654,"_5":45412,"_16990":91408,"_23412":91409,"_7169":91410},[45444],"/docs/features/tracing#phoenix-tracing-web-application","Phoenix Tracing Web Application",{"_11692":1665,"_44950":1654,"_5":45412,"_16990":91412,"_23412":91413,"_7169":91414},[45444],"/docs/features/tracing#how-to-start-the-tracing-web-application","How to start the tracing web application",{"_11692":1666,"_44950":1654,"_5":45412,"_16990":91416,"_23412":91417,"_7169":91418},[45444],"/docs/features/tracing#changing-the-web-app-port-number","Changing the web app port number",{"_11692":1667,"_44950":1654,"_5":45412,"_16990":91420,"_23412":91421,"_7169":91422},[45444],"/docs/features/tracing#feature-list","Feature list",{"_11692":1668,"_44950":1654,"_5":45412,"_16990":91424,"_23412":91425,"_7169":91426},[45444],"/docs/features/tracing#list","List",{"_11692":1669,"_44950":1654,"_5":45412,"_16990":91428,"_23412":91429,"_7169":91430},[45444],"/docs/features/tracing#dependency-tree","Dependency tree",{"_11692":1670,"_44950":1654,"_5":45412,"_16990":91432,"_23412":91433,"_7169":91434},[45444],"/docs/features/tracing#trace-count","Trace count",{"_11692":1671,"_44950":1654,"_5":45412,"_16990":91436,"_23412":91437,"_7169":91438},[45444],"/docs/features/tracing#trace-distribution","Trace distribution",{"_11692":1672,"_44950":1654,"_5":45412,"_16990":91440,"_23412":91441,"_7169":91442},[45444],"/docs/features/tracing#timeline","Timeline",{"_11692":1673,"_44950":1654,"_16990":91444,"_5":16526,"_23412":1654,"_7169":91445},[45444],"As of Phoenix 4.1.0, Phoenix supports collecting per-request traces. This allows you to see each important step in a query or insertion, all the way from the client through HBase and back again.",{"_11692":1674,"_44950":1654,"_16990":91447,"_5":16526,"_23412":1654,"_7169":91448},[45444],"Phoenix leverages Cloudera's HTrace library to integrate with HBase tracing utilities. Trace metrics are then deposited into a Hadoop Metrics2 sink that writes them into a Phoenix table.",{"_11692":1675,"_44950":1654,"_16990":91450,"_5":16526,"_23412":1654,"_7169":91451},[45444],"Writing traces to a Phoenix table is not supported on Hadoop 1.",{"_11692":1676,"_44950":1654,"_16990":91453,"_5":16526,"_23412":91379,"_7169":91454},[45444],"There are two key configuration files that you will need to update.",{"_11692":1677,"_44950":1654,"_16990":91456,"_5":16526,"_23412":91379,"_7169":91383},[45444],{"_11692":1678,"_44950":1654,"_16990":91458,"_5":16526,"_23412":91379,"_7169":91387},[45444],{"_11692":1679,"_44950":1654,"_16990":91460,"_5":16526,"_23412":91379,"_7169":91461},[45444],"They contain the properties you need to set on the client and server, respectively, as well as information on how the Metrics2 system uses the configuration files.",{"_11692":1680,"_44950":1654,"_16990":91463,"_5":16526,"_23412":91379,"_7169":91464},[45444],"Put these files on their respective classpaths and restart the process to pick up the new configurations.",{"_11692":1681,"_44950":1654,"_16990":91466,"_5":16526,"_23412":91382,"_7169":91467},[45444],"This file will configure the Hadoop Metrics2 system for Phoenix clients.",{"_11692":1682,"_44950":1654,"_16990":91469,"_5":16526,"_23412":91382,"_7169":91470},[45444],"The default properties you should set are:",{"_11692":1683,"_44950":1654,"_16990":91472,"_5":16526,"_23412":91382,"_7169":91473},[45444],"This enables standard Phoenix metrics sink (which collects the trace information) and writer (writes the traces to the Phoenix SYSTEM.TRACING_STATS table). You can modify this to set your own custom classes as well, if you have them.",{"_11692":1684,"_44950":1654,"_16990":91475,"_5":16526,"_23412":91382,"_7169":91476},[45444],"See the properties file in the source (phoenix-hadoop2-compat/bin) for more information on setting custom sinks and writers.",{"_11692":1685,"_44950":1654,"_16990":91478,"_5":16526,"_23412":91386,"_7169":91479},[45444],"A default HBase deployment already includes a Metrics2 configuration, so Phoenix Metrics2 config can either replace the existing file (if you do not have custom settings) or be merged into your existing Metrics2 configuration file.",{"_11692":1686,"_44950":1654,"_16990":91481,"_5":16526,"_23412":91386,"_7169":91482},[45444],"These are essentially the same properties as in hadoop-metrics2-phoenix.properties, but prefixed with hbase instead of phoenix so they are loaded with the rest of HBase metrics.",{"_11692":1687,"_44950":1654,"_16990":91484,"_5":16526,"_23412":91390,"_7169":91485},[45444],"You can disable tracing for client requests by creating a new connection without the tracing property enabled (see below).",{"_11692":1688,"_44950":1654,"_16990":91487,"_5":16526,"_23412":91390,"_7169":91488},[45444],"However, on the server side, once the metrics sink is enabled you cannot turn off trace collection and writing unless you remove the Phoenix Metrics2 configuration and restart the region server. This is enforced by the Metrics2 framework, which assumes server metrics should always be collected.",{"_11692":1689,"_44950":1654,"_16990":91490,"_5":16526,"_23412":91394,"_7169":91491},[45444],"There are only a couple small things you need to do to enable tracing a given request with Phoenix.",{"_11692":1690,"_44950":1654,"_16990":91493,"_5":16526,"_23412":91397,"_7169":91494},[45444],"The frequency of tracing is determined by the following client-side Phoenix property:",{"_11692":1691,"_44950":1654,"_16990":91496,"_5":16526,"_23412":91397,"_7169":91497},[45444],"There are three possible tracing frequencies you can use:",{"_11692":1692,"_44950":1654,"_16990":91499,"_5":16526,"_23412":91397,"_7169":41338},[45444],{"_11692":1693,"_44950":1654,"_16990":91501,"_5":16526,"_23412":91397,"_7169":91502},[45444],"This is the default",{"_11692":1694,"_44950":1654,"_16990":91504,"_5":16526,"_23412":91397,"_7169":25650},[45444],{"_11692":1695,"_44950":1654,"_16990":91506,"_5":16526,"_23412":91397,"_7169":91507},[45444],"Every request will be traced",{"_11692":1696,"_44950":1654,"_16990":91509,"_5":16526,"_23412":91397,"_7169":10597},[45444],{"_11692":1697,"_44950":1654,"_16990":91511,"_5":16526,"_23412":91397,"_7169":91512},[45444],"Take traces with a probabilistic frequency",{"_11692":1698,"_44950":1654,"_16990":91514,"_5":16526,"_23412":91397,"_7169":91515},[45444],"probability threshold is set by phoenix.trace.probability.threshold with a default of 0.05 (5%).",{"_11692":1699,"_44950":1654,"_16990":91517,"_5":16526,"_23412":91397,"_7169":91518},[45444],"As with other configuration properties, this property may be specified at JDBC connection time as a connection property.\nEnabling one of these properties only turns on trace collection. Trace data still needs to be deposited somewhere.",{"_11692":1700,"_44950":1654,"_16990":91520,"_5":16526,"_23412":91397,"_7169":87958},[45444],{"_11692":1701,"_44950":1654,"_16990":91522,"_5":16526,"_23412":91401,"_7169":91523},[45444],"You can also enable tracing via hbase-site.xml. However, only always and never are currently supported.",{"_11692":1702,"_44950":1654,"_16990":91525,"_5":16526,"_23412":91405,"_7169":91526},[45444],"Once the traces are deposited into the tracing table, by default SYSTEM.TRACING_STATS, but it is configurable in the HBase configuration via:",{"_11692":1703,"_44950":1654,"_16990":91528,"_5":16526,"_23412":91405,"_7169":91529},[45444],"The tracing table is initialized via the DDL:",{"_11692":1704,"_44950":1654,"_16990":91531,"_5":16526,"_23412":91405,"_7169":91532},[45444],"The tracing table also contains a number of dynamic columns for each trace. A trace is identified by trace ID (request ID), parent ID (parent span ID), and span ID (individual segment ID), and may have multiple tags and annotations. Once you know the number of tags and annotations, you can retrieve them from the table with a query like:",{"_11692":1705,"_44950":1654,"_16990":91534,"_5":16526,"_23412":91405,"_7169":91535},[45444],"Where columns is either annotations.aX or tags.tX, where X is the index of the dynamic column to look up.",{"_11692":1706,"_44950":1654,"_16990":91537,"_5":16526,"_23412":91405,"_7169":91538},[45444],"For more usage examples, see TraceReader, which can programmatically read traces from the tracing results table.",{"_11692":1707,"_44950":1654,"_16990":91540,"_5":16526,"_23412":91405,"_7169":91541},[45444],"Custom annotations can also be passed into Phoenix to be added to traces. Phoenix looks for connection properties whose names start with phoenix.annotation. and adds them as annotations to client-side traces. For example, a connection property phoenix.annotation.myannotation=abc results in an annotation with key myannotation and value abc. Use this to link traces to other request identifiers in your system, such as user or session IDs.",{"_11692":1708,"_44950":1654,"_16990":91543,"_5":16526,"_23412":91413,"_7169":91544},[45444],"Enable tracing for Apache Phoenix as above",{"_11692":1709,"_44950":1654,"_16990":91546,"_5":16526,"_23412":91413,"_7169":91547},[45444],"Start the web app:",{"_11692":1710,"_44950":1654,"_16990":91549,"_5":16526,"_23412":91413,"_7169":91550},[45444],"Open this URL in your browser: http://localhost:8864/webapp/",{"_11692":1711,"_44950":1654,"_16990":91552,"_5":16526,"_23412":91413,"_7169":91553},[45444],"Stop the tracing web app:",{"_11692":1712,"_44950":1654,"_16990":91555,"_5":16526,"_23412":91417,"_7169":91556},[45444],"Execute the command below:",{"_11692":1713,"_44950":1654,"_16990":91558,"_5":16526,"_23412":91421,"_7169":91559},[45444],"The tracing web app for Apache Phoenix includes: feature list, dependency tree, trace count, trace distribution, and timeline.",{"_11692":1714,"_44950":1654,"_16990":91561,"_5":16526,"_23412":91425,"_7169":91562},[45444],"The most recent traces are listed down. The limiting value entered on the textbox is used to determine the trace count displayed. With each trace, there is a link to view either the dependency tree or the timeline.",{"_11692":1715,"_44950":1654,"_16990":91564,"_5":16526,"_23412":91429,"_7169":91565},[45444],"The dependency tree shows traces for a given trace ID in a tree view. Parent-child relationships are displayed clearly. Tooltip data includes host name, parent ID, span ID, start time, end time, description, and duration. Each node is collapsible and expandable. The SQL query is shown for each tree rendering. Clear is used to remove the tree from view.",{"_11692":1716,"_44950":1654,"_16990":91567,"_5":16526,"_23412":91433,"_7169":91568},[45444],"The trace list is categorized by description. The trace count chart can be viewed as pie, line, bar, or area chart. The chart selector is collapsible and can be hidden.",{"_11692":1717,"_44950":1654,"_16990":91570,"_5":16526,"_23412":91437,"_7169":91571},[45444],"The trace distribution chart shows traces across Phoenix hosts on which they are running. Chart types include pie, line, bar, and area. The chart selector is collapsible and can be hidden.",{"_11692":1718,"_44950":1654,"_16990":91573,"_5":16526,"_23412":91441,"_7169":91574},[45444],"The traces can be viewed along the time axis for a given trace id. Traces can be added or cleared from the timeline. There should be a minimum of two traces starting at two different times for the system to draw its timeline. This feature helps the user to easily compare execution times between traces and within the same trace.",{"_11692":1719,"_44950":1719,"_5":12121,"_7169":91576,"_45415":91577,"_16990":91578,"_23412":1719},"Transactions",[86368,86369,86370,88058],[45444],{"_11692":1720,"_44950":1719,"_16990":91580,"_5":16526,"_23412":1719,"_7169":91581},[45444],"Configure and use transactional tables in Phoenix with Tephra, including setup steps and limitations.",{"_11692":1721,"_44950":1719,"_5":45412,"_16990":91583,"_23412":91584,"_7169":86490},[45444],"/docs/features/transactions#transactions-limitations",{"_11692":1722,"_44950":1719,"_16990":91586,"_5":16526,"_23412":1719,"_7169":91587},[45444],"Transactions (beta). Above and beyond the row-level transactional semantics of HBase, Phoenix adds cross row and cross table transaction support with full ACID semantics by integrating with Tephra, now an Apache incubator project. Tephra provides snapshot isolation of concurrent transactions by implementing multi-versioned concurrency control.",{"_11692":1723,"_44950":1719,"_16990":91589,"_5":16526,"_23412":1719,"_7169":91590},[45444],"Set up a system to use transactions in Phoenix with the following steps:",{"_11692":1724,"_44950":1719,"_16990":91592,"_5":16526,"_23412":1719,"_7169":91593},[45444],"Add the following config to your client-side hbase-site.xml file to enable transactions:",{"_11692":1725,"_44950":1719,"_16990":91595,"_5":16526,"_23412":1719,"_7169":91596},[45444],"Add the following config to your server-side hbase-site.xml file to configure the transaction manager.\nThe \"Transaction Server Configuration\" section of Tephra describes the available configuration options.",{"_11692":1726,"_44950":1719,"_16990":91598,"_5":16526,"_23412":1719,"_7169":91599},[45444],"Also set the transaction timeout (time after which open transactions become invalid) to a reasonable value:",{"_11692":1727,"_44950":1719,"_16990":91601,"_5":16526,"_23412":1719,"_7169":91602},[45444],"Set $HBASE_HOME and start the transaction manager:",{"_11692":1728,"_44950":1719,"_16990":91604,"_5":16526,"_23412":1719,"_7169":91605},[45444],"The transaction manager would typically be configured to run on one or more of the master nodes in your HBase cluster.",{"_11692":1729,"_44950":1719,"_16990":91607,"_5":16526,"_23412":1719,"_7169":91608},[45444],"Once this setup is done, transactions may then be enabled on a table by table basis by using the TRANSACTIONAL=true property when you create your table:",{"_11692":1730,"_44950":1719,"_16990":91610,"_5":16526,"_23412":1719,"_7169":91611},[45444],"An existing table may also be altered to be transactional, but be careful because you cannot switch a transactional table back to being non transactional:",{"_11692":1731,"_44950":1719,"_16990":91613,"_5":16526,"_23412":1719,"_7169":91614},[45444],"A transaction is started implicitly through the execution of a statement on a transactional table and then finished through either a commit or rollback. Once started, the statements will not see any data committed by other transactions until the transaction is complete. They will, however, see their own uncommitted data. For example:",{"_11692":1732,"_44950":1719,"_16990":91616,"_5":16526,"_23412":1719,"_7169":91617},[45444],"An exception is thrown if a transaction tries to commit a row that conflicts with other overlapping transaction that already committed. For example:",{"_11692":1733,"_44950":1719,"_16990":91619,"_5":16526,"_23412":1719,"_7169":91620},[45444],"In a second transaction perform a commit for the same row.",{"_11692":1734,"_44950":1719,"_16990":91622,"_5":16526,"_23412":1719,"_7169":91623},[45444],"Now if you try to commit the first transaction you will get an exception",{"_11692":1735,"_44950":1719,"_16990":91625,"_5":16526,"_23412":1719,"_7169":91626},[45444],"Queries are only able to view commits that completed before the current transaction started and are not able to view the in progress changes of other transactions.",{"_11692":1736,"_44950":1719,"_16990":91628,"_5":16526,"_23412":1719,"_7169":91629},[45444],"Indexes added to a transactional table are transactional as well with regard to their incremental maintenance. For example, the following index added to my_table will be kept transactional consistent with its data table as mutations are made:",{"_11692":1737,"_44950":1719,"_16990":91631,"_5":16526,"_23412":1719,"_7169":91632},[45444],"During a commit, if either the index or data table write fails, an exception is thrown and the client can either roll back or retry.\nIf the commit fails both the index and data table rows are not visible.",{"_11692":1738,"_44950":1719,"_16990":91634,"_5":16526,"_23412":1719,"_7169":91635},[45444],"An external Tephra transaction that has already been started can be used with Phoenix by setting the transaction context of the Phoenix connection:",{"_11692":1739,"_44950":1719,"_16990":91637,"_5":16526,"_23412":91584,"_7169":91638},[45444],"Starting a transaction on a connection with an SCN set is not allowed.",{"_11692":1740,"_44950":1719,"_16990":91640,"_5":16526,"_23412":91584,"_7169":91641},[45444],"Setting the maximum number of versions property while creating a transactional table limits the number of snapshots available for concurrent transactions.",{"_11692":1741,"_44950":1719,"_16990":91643,"_5":16526,"_23412":91584,"_7169":91644},[45444],"When a transaction times out or if it cannot be rolled back by the client, it is added to an invalid list. This list can potentially grow if there are a lot of failed or timed out transactions.\nFor now, an administrator can manually clear transactions from this list after a major compaction has occurred. TEPHRA-35 describes ongoing work to automatically remove transactions from the invalid list once all data associated with the transaction has been removed.",{"_11692":1742,"_44950":1719,"_16990":91646,"_5":16526,"_23412":91584,"_7169":91647},[45444],"If adding an index asynchronously to an existing transactional table, make sure to run a major compaction before issuing the CREATE INDEX ASYNC command as otherwise invalid and/or uncommitted transactions may appear in your index PHOENIX-2154.",{"_11692":1743,"_44950":1743,"_5":12121,"_7169":91649,"_45415":91650,"_16990":91651,"_23412":1743},"User-defined Functions",[86368,86369,86370,88058],[45444],{"_11692":1744,"_44950":1743,"_16990":91653,"_5":16526,"_23412":1743,"_7169":91654},[45444],"Create, deploy, and manage custom Phoenix UDFs with configuration, implementation steps, and known limitations.",{"_11692":1745,"_44950":1743,"_5":45412,"_16990":91656,"_23412":91657,"_7169":89510},[45444],"/docs/features/user-defined-functions#user-defined-functions-overview",{"_11692":1746,"_44950":1743,"_5":45412,"_16990":91659,"_23412":91660,"_7169":86420},[45444],"/docs/features/user-defined-functions#user-defined-functions-configuration",{"_11692":1747,"_44950":1743,"_5":45412,"_16990":91662,"_23412":91663,"_7169":91664},[45444],"/docs/features/user-defined-functions#creating-custom-udfs","Creating Custom UDFs",{"_11692":1748,"_44950":1743,"_5":45412,"_16990":91666,"_23412":91667,"_7169":91668},[45444],"/docs/features/user-defined-functions#dropping-the-udfs","Dropping the UDFs",{"_11692":1749,"_44950":1743,"_5":45412,"_16990":91670,"_23412":91671,"_7169":91672},[45444],"/docs/features/user-defined-functions#how-to-write-custom-udf","How to write custom UDF",{"_11692":1750,"_44950":1743,"_5":45412,"_16990":91674,"_23412":91675,"_7169":86490},[45444],"/docs/features/user-defined-functions#user-defined-functions-limitations",{"_11692":1751,"_44950":1743,"_16990":91677,"_5":16526,"_23412":1743,"_7169":91678},[45444],"As of Phoenix 4.4.0 we have added the ability to allow users to create and deploy\ntheir own custom or domain-specific UDFs to the cluster.",{"_11692":1752,"_44950":1743,"_16990":91680,"_5":16526,"_23412":91657,"_7169":91681},[45444],"Users can create temporary or permanent user-defined (domain-specific) scalar functions.\nUDFs can be used like built-in functions in queries such as SELECT, UPSERT, DELETE, and when creating functional indexes.\nTemporary functions are session-scoped and are not accessible from other sessions.\nPermanent function metadata is stored in the SYSTEM.FUNCTION table.\nPhoenix also supports tenant-specific functions. Functions created in one tenant-specific connection are not visible to other tenant-specific connections.\nOnly global tenant (no-tenant) functions are visible to all connections.",{"_11692":1753,"_44950":1743,"_16990":91683,"_5":16526,"_23412":91657,"_7169":91684},[45444],"Phoenix leverages the HBase dynamic class loader to load UDF JARs from HDFS at the Phoenix client and region server without restarting services.",{"_11692":1754,"_44950":1743,"_16990":91686,"_5":16526,"_23412":91660,"_7169":91687},[45444],"Add the following parameters to hbase-site.xml on the Phoenix client:",{"_11692":1755,"_44950":1743,"_16990":91689,"_5":16526,"_23412":91660,"_7169":91690},[45444],"The last two configuration values should match the HBase server-side configuration.",{"_11692":1756,"_44950":1743,"_16990":91692,"_5":16526,"_23412":91660,"_7169":91693},[45444],"As with other configuration properties, phoenix.functions.allowUserDefinedFunctions\nmay be specified at JDBC connection time as a connection property.",{"_11692":1757,"_44950":1743,"_16990":91695,"_5":16526,"_23412":91660,"_7169":87958},[45444],{"_11692":1758,"_44950":1743,"_16990":91697,"_5":16526,"_23412":91660,"_7169":91698},[45444],"The following optional parameter is used by the dynamic class loader to copy JARs from HDFS into the local filesystem:",{"_11692":1759,"_44950":1743,"_16990":91700,"_5":16526,"_23412":91663,"_7169":91701},[45444],"Implement your custom UDF by following How to write custom\nUDF.",{"_11692":1760,"_44950":1743,"_16990":91703,"_5":16526,"_23412":91663,"_7169":91704},[45444],"Compile your code into a JAR, then deploy the JAR to HDFS. It is recommended\nto add the JAR to the HDFS directory configured by hbase.dynamic.jars.dir.",{"_11692":1761,"_44950":1743,"_16990":91706,"_5":16526,"_23412":91667,"_7169":91707},[45444],"You can drop functions using the DROP FUNCTION query.\nDropping a function deletes the metadata for that function from Phoenix.",{"_11692":1762,"_44950":1743,"_16990":91709,"_5":16526,"_23412":91671,"_7169":91710},[45444],"You can follow these steps to write your UDF (for more detail, see this blog post):",{"_11692":1763,"_44950":1743,"_16990":91712,"_5":16526,"_23412":91671,"_7169":91713},[45444],"Create a new class derived from org.apache.phoenix.expression.function.ScalarFunction.",{"_11692":1764,"_44950":1743,"_16990":91715,"_5":16526,"_23412":91671,"_7169":91716},[45444],"Implement getDataType() to determine the function return type.",{"_11692":1765,"_44950":1743,"_16990":91718,"_5":16526,"_23412":91671,"_7169":91719},[45444],"Implement evaluate() to calculate the result for each row.\nThe method receives org.apache.phoenix.schema.tuple.Tuple with the current row state and an org.apache.hadoop.hbase.io.ImmutableBytesWritable to populate with the function result.\nThe method returns false if there is not enough information to calculate the result (usually because one argument is unknown), and true otherwise.",{"_11692":1766,"_44950":1743,"_16990":91721,"_5":16526,"_23412":91671,"_7169":91722},[45444],"Below are additional optimization-related steps.",{"_11692":1767,"_44950":1743,"_16990":91724,"_5":16526,"_23412":91671,"_7169":91725},[45444],"To contribute to scan start/stop key formation, custom functions need to override the following two methods from ScalarFunction:",{"_11692":1768,"_44950":1743,"_16990":91727,"_5":16526,"_23412":91671,"_7169":91728},[45444],"Additionally, to enable ORDER BY optimization or in-place GROUP BY, override:",{"_11692":1769,"_44950":1743,"_16990":91730,"_5":16526,"_23412":91675,"_7169":91731},[45444],"The JAR containing UDFs must be manually added to and deleted from HDFS. There is ongoing work to add SQL statements for JAR add/remove (PHOENIX-1890).",{"_11692":1770,"_44950":1743,"_16990":91733,"_5":16526,"_23412":91675,"_7169":91734},[45444],"The dynamic class loader copies UDF JARs to {hbase.local.dir}/jars at the Phoenix client and region server when a UDF is used in queries. These JARs must be deleted manually when a function is deleted.",{"_11692":1771,"_44950":1743,"_16990":91736,"_5":16526,"_23412":91675,"_7169":91737},[45444],"Functional indexes must be rebuilt manually if the function implementation changes (PHOENIX-1907).",{"_11692":1772,"_44950":1743,"_16990":91739,"_5":16526,"_23412":91675,"_7169":91740},[45444],"Once loaded, a JAR is not unloaded. Use a different JAR for modified implementations to avoid restarting the cluster (PHOENIX-1907).",{"_11692":1773,"_44950":1743,"_16990":91742,"_5":16526,"_23412":91675,"_7169":91743},[45444],"To list functions, query the SYSTEM.\"FUNCTION\" table (PHOENIX-1921).",{"_11692":1774,"_44950":1774,"_5":12121,"_7169":91745,"_45415":91746,"_16990":91747,"_23412":1774},"VARBINARY_ENCODED",[86368,86369,86370,88058],[45444],{"_11692":1775,"_44950":1774,"_16990":91749,"_5":16526,"_23412":1774,"_7169":91750},[45444],"A variable-length binary type that sorts correctly anywhere in a composite key — use it for row keys, index keys, and row value constructors that contain binary data.",{"_11692":1776,"_44950":1774,"_5":45412,"_16990":91752,"_23412":91753,"_7169":88625},[45444],"/docs/features/varbinary-encoded#varbinary-encoded-when",{"_11692":1777,"_44950":1774,"_5":45412,"_16990":91755,"_23412":91756,"_7169":91757},[45444],"/docs/features/varbinary-encoded#varbinary-encoded-defining","Defining columns",{"_11692":1778,"_44950":1774,"_5":45412,"_16990":91759,"_23412":91760,"_7169":91761},[45444],"/docs/features/varbinary-encoded#varbinary-encoded-paging","Paged scans with row value constructors",{"_11692":1779,"_44950":1774,"_5":45412,"_16990":91763,"_23412":91764,"_7169":91765},[45444],"/docs/features/varbinary-encoded#varbinary-encoded-sizing","Sizing and storage",{"_11692":1780,"_44950":1774,"_5":45412,"_16990":91767,"_23412":91768,"_7169":91769},[45444],"/docs/features/varbinary-encoded#varbinary-encoded-migrating","Migrating from VARBINARY",{"_11692":1781,"_44950":1774,"_16990":91771,"_5":16526,"_23412":1774,"_7169":91772},[45444],"VARBINARY_ENCODED is the safe choice whenever you need a variable-length binary\ncolumn that participates in ordering: a non-trailing column of a composite primary\nkey, a secondary-index key, or a row value constructor used for paged queries.\nIntroduced in Phoenix 5.3.0\n(PHOENIX-7357).",{"_11692":1782,"_44950":1774,"_16990":91774,"_5":16526,"_23412":91753,"_7169":91775},[45444],"Pick VARBINARY_ENCODED over VARBINARY when any of the following is true:",{"_11692":1783,"_44950":1774,"_16990":91777,"_5":16526,"_23412":91753,"_7169":91778},[45444],"The column is part of a multi-column primary key and is not the last PK column.",{"_11692":1784,"_44950":1774,"_16990":91780,"_5":16526,"_23412":91753,"_7169":91781},[45444],"The column is used as part of an index key.",{"_11692":1785,"_44950":1774,"_16990":91783,"_5":16526,"_23412":91753,"_7169":91784},[45444],"You scan with row value constructors (e.g., WHERE (a, b) > (?, ?) for keyset\npagination) and one of the columns is binary.",{"_11692":1786,"_44950":1774,"_16990":91786,"_5":16526,"_23412":91753,"_7169":91787},[45444],"The binary value can contain 0x00 bytes and you cannot guarantee it never will.",{"_11692":1787,"_44950":1774,"_16990":91789,"_5":16526,"_23412":91753,"_7169":91790},[45444],"Stick with VARBINARY only when the column is purely a payload — i.e. it's never used\nin a WHERE, ORDER BY, index, or non-trailing PK position.",{"_11692":1788,"_44950":1774,"_16990":91792,"_5":16526,"_23412":91753,"_7169":91793},[45444],"The reason: VARBINARY uses 0x00 as a separator between columns in the encoded row\nkey, so an embedded 0x00 byte in an earlier PK column collides with the separator and\nbreaks ordering. VARBINARY_ENCODED escapes zero bytes during encoding so the\nbyte-by-byte sort order of the encoded form matches the lexicographic order of the\noriginal bytes. The transform is reversed on read, so application code keeps seeing the\noriginal bytes.",{"_11692":1789,"_44950":1774,"_16990":91795,"_5":16526,"_23412":91756,"_7169":91796},[45444],"Use it like any other column type — including in any position of a composite key:",{"_11692":1790,"_44950":1774,"_16990":91798,"_5":16526,"_23412":91756,"_7169":91799},[45444],"Literals use the standard hex form x'...' in both UPSERT and WHERE:",{"_11692":1791,"_44950":1774,"_16990":91801,"_5":16526,"_23412":91760,"_7169":91802},[45444],"The intended use case for VARBINARY_ENCODED in a composite key is keyset pagination\nthat resumes from the last seen row. Because the type orders correctly, you can drive\nthis with a row value constructor without any application-level encoding:",{"_11692":1792,"_44950":1774,"_16990":91804,"_5":16526,"_23412":91760,"_7169":91805},[45444],"Bind the two parameters to the last row seen by the previous page; Phoenix turns the\npredicate into an efficient seek directly to the resume point. See\nPaged Queries for the broader pattern.",{"_11692":1793,"_44950":1774,"_16990":91807,"_5":16526,"_23412":91764,"_7169":91808},[45444],"The encoded form is at most 1 extra byte per 0x00 byte in the value. For typical\ninputs (random IDs, hashes, opaque tokens) the overhead is effectively zero. Plan a bit\nof headroom only when values are known to contain many zero bytes (e.g. fixed-width\nintegers stored raw with a lot of high-order zeros — in which case a fixed-width\nUNSIGNED_* type is usually a better choice anyway).",{"_11692":1794,"_44950":1774,"_16990":91810,"_5":16526,"_23412":91768,"_7169":91811},[45444],"Phoenix does not support changing a column's type in place via ALTER TABLE, so\nmoving an existing VARBINARY column to VARBINARY_ENCODED is a copy-and-switch\noperation:",{"_11692":1795,"_44950":1774,"_16990":91813,"_5":16526,"_23412":91768,"_7169":91814},[45444],"Create a new table with the same schema but with the affected columns declared as\nVARBINARY_ENCODED.",{"_11692":1796,"_44950":1774,"_16990":91816,"_5":16526,"_23412":91768,"_7169":91817},[45444],"Backfill: UPSERT INTO new_table SELECT ... FROM old_table; (Phoenix re-encodes\nthe values into the new physical layout for you).",{"_11692":1797,"_44950":1774,"_16990":91819,"_5":16526,"_23412":91768,"_7169":91820},[45444],"Cut over reads and writes to the new table, then drop the old one.",{"_11692":1798,"_44950":1774,"_16990":91822,"_5":16526,"_23412":91768,"_7169":91823},[45444],"For a brand-new column that you're adding to an existing table, you can declare it as\nVARBINARY_ENCODED directly with ALTER TABLE ... ADD ....",{"_11692":1799,"_44950":1799,"_5":12121,"_7169":91825,"_45415":91826,"_16990":91827,"_23412":1799},"View TTL",[86368,86369,86370,88058],[45444],{"_11692":1800,"_44950":1799,"_16990":91829,"_5":16526,"_23412":1799,"_7169":91830},[45444],"Per-view retention on top of a shared base table — different views can age data out on different schedules without splitting the table.",{"_11692":1801,"_44950":1799,"_5":45412,"_16990":91832,"_23412":91833,"_7169":88625},[45444],"/docs/features/view-ttl#view-ttl-when",{"_11692":1802,"_44950":1799,"_5":45412,"_16990":91835,"_23412":91836,"_7169":91837},[45444],"/docs/features/view-ttl#view-ttl-enable","Enable the feature",{"_11692":1803,"_44950":1799,"_5":45412,"_16990":91839,"_23412":91840,"_7169":91841},[45444],"/docs/features/view-ttl#view-ttl-define","Defining a TTL on a view",{"_11692":1804,"_44950":1799,"_5":45412,"_16990":91843,"_23412":91844,"_7169":91845},[45444],"/docs/features/view-ttl#view-ttl-inheritance","Inheritance and child views",{"_11692":1805,"_44950":1799,"_5":45412,"_16990":91847,"_23412":91848,"_7169":91849},[45444],"/docs/features/view-ttl#view-ttl-how","How it actually expires data",{"_11692":1806,"_44950":1799,"_5":45412,"_16990":91851,"_23412":91852,"_7169":91853},[45444],"/docs/features/view-ttl#view-ttl-conditional","Combining with Conditional TTL",{"_11692":1807,"_44950":1799,"_16990":91855,"_5":16526,"_23412":1799,"_7169":91856},[45444],"A Phoenix view is a logical table that shares a single physical\nHBase table with its sibling views. View TTL lets each view define its own data\nretention policy on top of that shared table. Rows that have outlived their view's TTL\ndisappear from queries against that view and are eventually removed in the background —\nwithout affecting any other view (or the base table). Available in Phoenix 5.3.0\n(PHOENIX-6978).",{"_11692":1808,"_44950":1799,"_16990":91858,"_5":16526,"_23412":91833,"_7169":91859},[45444],"The classic case is multi-tenant retention: one shared base table, many tenant\nviews, each tenant gets a different retention window driven by its plan, region, or\ncontract.",{"_11692":1809,"_44950":1799,"_16990":91861,"_5":16526,"_23412":91833,"_7169":91862},[45444],"Scenario",{"_11692":1810,"_44950":1799,"_16990":91864,"_5":16526,"_23412":91833,"_7169":91865},[45444],"View TTL fit",{"_11692":1811,"_44950":1799,"_16990":91867,"_5":16526,"_23412":91833,"_7169":91868},[45444],"Per-tenant retention windows on one shared base table",{"_11692":1812,"_44950":1799,"_16990":91870,"_5":16526,"_23412":91833,"_7169":91871},[45444],"Yes",{"_11692":1813,"_44950":1799,"_16990":91873,"_5":16526,"_23412":91833,"_7169":91874},[45444],"Per-use-case retention (e.g., \"raw events 7 days, audit 1 year\")",{"_11692":1814,"_44950":1799,"_16990":91876,"_5":16526,"_23412":91833,"_7169":91871},[45444],{"_11692":1815,"_44950":1799,"_16990":91878,"_5":16526,"_23412":91833,"_7169":91879},[45444],"Same retention for the entire physical table",{"_11692":1816,"_44950":1799,"_16990":91881,"_5":16526,"_23412":91833,"_7169":91882},[45444],"Use a regular table-level TTL instead",{"_11692":1817,"_44950":1799,"_16990":91884,"_5":16526,"_23412":91833,"_7169":91885},[45444],"Retention based on row content rather than age",{"_11692":1818,"_44950":1799,"_16990":91887,"_5":16526,"_23412":91833,"_7169":91888},[45444],"Use Conditional TTL",{"_11692":1819,"_44950":1799,"_16990":91890,"_5":16526,"_23412":91833,"_7169":91891},[45444],"Different schemas per tenant",{"_11692":1820,"_44950":1799,"_16990":91893,"_5":16526,"_23412":91833,"_7169":91894},[45444],"Use separate tables, not views",{"_11692":1821,"_44950":1799,"_16990":91896,"_5":16526,"_23412":91833,"_7169":91897},[45444],"If the retention rule is the same for everyone reading the table, set TTL on the\ntable itself; you don't need View TTL.",{"_11692":1822,"_44950":1799,"_16990":91899,"_5":16526,"_23412":91836,"_7169":91900},[45444],"View TTL is off by default. Enable it cluster-wide by setting this server-side\nproperty and restarting region servers:",{"_11692":1823,"_44950":1799,"_16990":91902,"_5":16526,"_23412":91836,"_7169":91903},[45444],"While the feature is disabled, attempts to declare TTL on a view return a SQL error\nexplaining the property must be turned on.",{"_11692":1824,"_44950":1799,"_16990":91905,"_5":16526,"_23412":91840,"_7169":91906},[45444],"Set TTL (in seconds) as a property on CREATE VIEW. Different views over the same\nbase table can use different values:",{"_11692":1825,"_44950":1799,"_16990":91908,"_5":16526,"_23412":91840,"_7169":91909},[45444],"Adjust the value later, or remove the TTL entirely:",{"_11692":1826,"_44950":1799,"_16990":91911,"_5":16526,"_23412":91844,"_7169":91912},[45444],"A child view inherits its parent view's TTL. Child views cannot override the\nparent's value — the TTL belongs to the view that owns it. If you need different\nretention windows for two slices of the same parent, create them as siblings under a\ncommon parent rather than nesting.",{"_11692":1827,"_44950":1799,"_16990":91914,"_5":16526,"_23412":91844,"_7169":91915},[45444],"In multi-tenant mode, each tenant connection sees its own view; setting TTL on a\ntenant view applies retention to that tenant's slice only.",{"_11692":1828,"_44950":1799,"_16990":91917,"_5":16526,"_23412":91848,"_7169":91918},[45444],"Two things happen to expired rows:",{"_11692":1829,"_44950":1799,"_16990":91920,"_5":16526,"_23412":91848,"_7169":91921},[45444],"Read-time filter (immediate). Whenever a query goes through a view, Phoenix\nfilters out rows whose age exceeds the view's TTL — so as soon as a row is \"too\nold\" for a view, it disappears from queries against that view, even before\nphysical deletion.",{"_11692":1830,"_44950":1799,"_16990":91923,"_5":16526,"_23412":91848,"_7169":91924},[45444],"Phoenix compaction (eventual). Expired rows are physically removed by\nPhoenix's compaction during HBase region compactions. This reclaims disk and\nstops the rows showing up via lower-level scans. There is no separate cleanup\njob — physical removal happens whenever the underlying HBase regions compact.",{"_11692":1831,"_44950":1799,"_16990":91926,"_5":16526,"_23412":91852,"_7169":91927},[45444],"A view's TTL can also be a SQL boolean expression instead of a number, in which\ncase it follows the Conditional TTL rules. This\nunlocks expiry based on row content (e.g. expire 30 days after STATUS becomes\n'CLOSED'), and the strict-vs-relaxed enforcement modes documented there.",{"_11692":1832,"_44950":1832,"_5":12121,"_7169":91929,"_45415":91930,"_16990":91931,"_23412":1832},"Views",[86368,86369,86370,88058],[45444],{"_11692":1833,"_44950":1832,"_16990":91933,"_5":16526,"_23412":1832,"_7169":91934},[45444],"Define updatable and read-only Phoenix views over shared HBase tables, including indexing behavior and limitations.",{"_11692":1834,"_44950":1832,"_5":45412,"_16990":91936,"_23412":91937,"_7169":91938},[45444],"/docs/features/views#updatable-views","Updatable Views",{"_11692":1835,"_44950":1832,"_5":45412,"_16990":91940,"_23412":91941,"_7169":91942},[45444],"/docs/features/views#read-only-views","Read-only Views",{"_11692":1836,"_44950":1832,"_5":45412,"_16990":91944,"_23412":91945,"_7169":91946},[45444],"/docs/features/views#indexes-on-views","Indexes on Views",{"_11692":1837,"_44950":1832,"_5":45412,"_16990":91948,"_23412":91949,"_7169":86490},[45444],"/docs/features/views#views-limitations",{"_11692":1838,"_44950":1832,"_16990":91951,"_5":16526,"_23412":1832,"_7169":91952},[45444],"The standard SQL view syntax (with some limitations) is now supported by Phoenix to enable multiple virtual tables to all share the same underlying physical HBase table. This is important in HBase as there are limits to the number of regions which HBase can manage. Limiting the number of tables can help limit the number of regions in a cluster.",{"_11692":1839,"_44950":1832,"_16990":91954,"_5":16526,"_23412":1832,"_7169":91955},[45444],"For example, given the following table definition that defines a base table to collect product metrics:",{"_11692":1840,"_44950":1832,"_16990":91957,"_5":16526,"_23412":1832,"_7169":91958},[45444],"You may define the following view:",{"_11692":1841,"_44950":1832,"_16990":91960,"_5":16526,"_23412":1832,"_7169":91961},[45444],"In this case, the same underlying physical HBase table (i.e. PRODUCT_METRICS) stores all of the data.\nNotice that unlike with standard SQL views, you may define additional columns for your view. The view inherits all of the columns from its base table, in addition to being able to optionally add new KeyValue columns. You may also add these columns after-the-fact with an ALTER VIEW statement.",{"_11692":1842,"_44950":1832,"_16990":91963,"_5":16526,"_23412":1832,"_7169":91964},[45444],"NOTE: Phoenix 4.15.0 onwards contains PHOENIX-4810 which introduces a new endpoint coprocessor on the SYSTEM.CHILD_LINK table for adding parent->child links, whenever a view is created. Thus, when namespace mapping is enabled, users that wish to create views will need to be granted EXEC permissions on SYSTEM.CHILD_LINK in order to be able to invoke this coprocessor.",{"_11692":1843,"_44950":1832,"_16990":91966,"_5":16526,"_23412":91937,"_7169":91967},[45444],"If your view uses only simple equality expressions in the WHERE clause, you are also allowed to issue DML against the view. These views are termed updatable views. For example, in this case you could issue the following UPSERT statement:",{"_11692":1844,"_44950":1832,"_16990":91969,"_5":16526,"_23412":91937,"_7169":91970},[45444],"In this case, the row will be stored in the PRODUCT_METRICS HBase table and the metric_type column value will be inferred to be 'm' since the VIEW defines it as such.",{"_11692":1845,"_44950":1832,"_16990":91972,"_5":16526,"_23412":91937,"_7169":91973},[45444],"Also, queries done through the view will automatically apply the WHERE clause filter. For example:",{"_11692":1846,"_44950":1832,"_16990":91975,"_5":16526,"_23412":91937,"_7169":91976},[45444],"This would sum all the dropped_calls across all product_metrics with a metric_type of 'm' and a carrier of 'Verizon'.",{"_11692":1847,"_44950":1832,"_16990":91978,"_5":16526,"_23412":91941,"_7169":91979},[45444],"Views may also be defined with more complex WHERE clauses, but in that case you cannot issue DML against them as you'll get a ReadOnlyException. You are still allowed to query through them and their WHERE clauses will be in effect as with standard SQL views.",{"_11692":1848,"_44950":1832,"_16990":91981,"_5":16526,"_23412":91941,"_7169":91982},[45444],"As expected, you may create a VIEW on another VIEW as well to further filter the data set. The same rules as above apply: if only simple equality expressions are used in the VIEW and its parent VIEW(s), the new view is updatable as well, otherwise it's read-only.",{"_11692":1849,"_44950":1832,"_16990":91984,"_5":16526,"_23412":91941,"_7169":91985},[45444],"Note that the previous support for creating a read-only VIEW directly over an HBase table is still supported.",{"_11692":1850,"_44950":1832,"_16990":91987,"_5":16526,"_23412":91945,"_7169":91988},[45444],"In addition, you may create an INDEX over a VIEW, just as with a TABLE. This is particularly useful to improve query performance over newly added columns on a VIEW, since it provides a way of doing point lookups based on these column values. Note that until PHOENIX-1499 gets implemented, an INDEX over a VIEW is only maintained if the updates are made through the VIEW (as opposed to through the underlying TABLE).",{"_11692":1851,"_44950":1832,"_16990":91990,"_5":16526,"_23412":91949,"_7169":91991},[45444],"Views have the following restrictions:",{"_11692":1852,"_44950":1832,"_16990":91993,"_5":16526,"_23412":91949,"_7169":91994},[45444],"An INDEX over a VIEW is only maintained if the updates are made through the VIEW. Updates made through the underlying TABLE or the parent VIEW will not be reflected in the index (PHOENIX-1499).",{"_11692":1853,"_44950":1832,"_16990":91996,"_5":16526,"_23412":91949,"_7169":91997},[45444],"A primary key column may not be added to a VIEW when its base table has a primary key constraint that ends with a variable-length column (PHOENIX-2157).",{"_11692":1854,"_44950":1832,"_16990":91999,"_5":16526,"_23412":91949,"_7169":92000},[45444],"A VIEW may be defined over only a single table through a simple SELECT * query. You may not create a VIEW over multiple joined tables or over aggregations (PHOENIX-1505, PHOENIX-1506).",{"_11692":1855,"_44950":1832,"_16990":92002,"_5":16526,"_23412":91949,"_7169":92003},[45444],"When a column is added to a VIEW, the new column is not automatically added to child VIEWs (PHOENIX-2054). The workaround is to manually add the column to child VIEWs.",{"_11692":1856,"_44950":1832,"_16990":92005,"_5":16526,"_23412":91949,"_7169":92006},[45444],"All columns must be projected into a VIEW when it is created (that is, only CREATE VIEW ... AS SELECT * is supported). You may drop non-primary-key columns inherited from the base table after creation using ALTER VIEW. Providing a subset of columns or expressions in the SELECT clause is planned for a future release (PHOENIX-1507).",{"_11692":1857,"_44950":1857,"_5":12121,"_7169":92008,"_45415":92009,"_16990":92010,"_23412":1857},"SQL Functions",[86368,86369,86482],[45444],{"_11692":1858,"_44950":1857,"_16990":92012,"_5":16526,"_23412":1857,"_7169":92013},[45444],"Built-in SQL function reference for Apache Phoenix — aggregate, string, numeric, array, date/time, and general functions.",{"_11692":1859,"_44950":1857,"_5":45412,"_16990":92015,"_23412":92016,"_7169":92017},[45444],"/docs/functions#functions-aggregate","Functions (Aggregate)",{"_11692":1860,"_44950":1857,"_5":45412,"_16990":92019,"_23412":92020,"_7169":92021},[45444],"/docs/functions#avg","AVG",{"_11692":1861,"_44950":1857,"_5":45412,"_16990":92023,"_23412":92024,"_7169":92025},[45444],"/docs/functions#count","COUNT",{"_11692":1862,"_44950":1857,"_5":45412,"_16990":92027,"_23412":92028,"_7169":92029},[45444],"/docs/functions#approx_count_distinct","APPROX_COUNT_DISTINCT",{"_11692":1863,"_44950":1857,"_5":45412,"_16990":92031,"_23412":92032,"_7169":92033},[45444],"/docs/functions#max","MAX",{"_11692":1864,"_44950":1857,"_5":45412,"_16990":92035,"_23412":92036,"_7169":92037},[45444],"/docs/functions#min","MIN",{"_11692":1865,"_44950":1857,"_5":45412,"_16990":92039,"_23412":92040,"_7169":92041},[45444],"/docs/functions#sum","SUM",{"_11692":1866,"_44950":1857,"_5":45412,"_16990":92043,"_23412":92044,"_7169":92045},[45444],"/docs/functions#percentile_cont","PERCENTILE_CONT",{"_11692":1867,"_44950":1857,"_5":45412,"_16990":92047,"_23412":92048,"_7169":92049},[45444],"/docs/functions#percentile_disc","PERCENTILE_DISC",{"_11692":1868,"_44950":1857,"_5":45412,"_16990":92051,"_23412":92052,"_7169":92053},[45444],"/docs/functions#percent_rank","PERCENT_RANK",{"_11692":1869,"_44950":1857,"_5":45412,"_16990":92055,"_23412":92056,"_7169":92057},[45444],"/docs/functions#first_value","FIRST_VALUE",{"_11692":1870,"_44950":1857,"_5":45412,"_16990":92059,"_23412":92060,"_7169":92061},[45444],"/docs/functions#last_value","LAST_VALUE",{"_11692":1871,"_44950":1857,"_5":45412,"_16990":92063,"_23412":92064,"_7169":92065},[45444],"/docs/functions#first_values","FIRST_VALUES",{"_11692":1872,"_44950":1857,"_5":45412,"_16990":92067,"_23412":92068,"_7169":92069},[45444],"/docs/functions#last_values","LAST_VALUES",{"_11692":1873,"_44950":1857,"_5":45412,"_16990":92071,"_23412":92072,"_7169":92073},[45444],"/docs/functions#nth_value","NTH_VALUE",{"_11692":1874,"_44950":1857,"_5":45412,"_16990":92075,"_23412":92076,"_7169":92077},[45444],"/docs/functions#stddev_pop","STDDEV_POP",{"_11692":1875,"_44950":1857,"_5":45412,"_16990":92079,"_23412":92080,"_7169":92081},[45444],"/docs/functions#stddev_samp","STDDEV_SAMP",{"_11692":1876,"_44950":1857,"_5":45412,"_16990":92083,"_23412":92084,"_7169":92085},[45444],"/docs/functions#functions-numeric","Functions (Numeric)",{"_11692":1877,"_44950":1857,"_5":45412,"_16990":92087,"_23412":92088,"_7169":92089},[45444],"/docs/functions#round","ROUND",{"_11692":1878,"_44950":1857,"_5":45412,"_16990":92091,"_23412":92092,"_7169":92093},[45444],"/docs/functions#ceil","CEIL",{"_11692":1879,"_44950":1857,"_5":45412,"_16990":92095,"_23412":92096,"_7169":92097},[45444],"/docs/functions#floor","FLOOR",{"_11692":1880,"_44950":1857,"_5":45412,"_16990":92099,"_23412":92100,"_7169":92101},[45444],"/docs/functions#trunc","TRUNC",{"_11692":1881,"_44950":1857,"_5":45412,"_16990":92103,"_23412":92104,"_7169":92105},[45444],"/docs/functions#to_number","TO_NUMBER",{"_11692":1882,"_44950":1857,"_5":45412,"_16990":92107,"_23412":92108,"_7169":92109},[45444],"/docs/functions#rand","RAND",{"_11692":1883,"_44950":1857,"_5":45412,"_16990":92111,"_23412":92112,"_7169":92113},[45444],"/docs/functions#functions-string","Functions (String)",{"_11692":1884,"_44950":1857,"_5":45412,"_16990":92115,"_23412":92116,"_7169":92117},[45444],"/docs/functions#substr","SUBSTR",{"_11692":1885,"_44950":1857,"_5":45412,"_16990":92119,"_23412":92120,"_7169":92121},[45444],"/docs/functions#instr","INSTR",{"_11692":1886,"_44950":1857,"_5":45412,"_16990":92123,"_23412":92124,"_7169":92125},[45444],"/docs/functions#trim","TRIM",{"_11692":1887,"_44950":1857,"_5":45412,"_16990":92127,"_23412":92128,"_7169":92129},[45444],"/docs/functions#ltrim","LTRIM",{"_11692":1888,"_44950":1857,"_5":45412,"_16990":92131,"_23412":92132,"_7169":92133},[45444],"/docs/functions#rtrim","RTRIM",{"_11692":1889,"_44950":1857,"_5":45412,"_16990":92135,"_23412":92136,"_7169":92137},[45444],"/docs/functions#lpad","LPAD",{"_11692":1890,"_44950":1857,"_5":45412,"_16990":92139,"_23412":92140,"_7169":92141},[45444],"/docs/functions#length","LENGTH",{"_11692":1891,"_44950":1857,"_5":45412,"_16990":92143,"_23412":92144,"_7169":92145},[45444],"/docs/functions#regexp_substr","REGEXP_SUBSTR",{"_11692":1892,"_44950":1857,"_5":45412,"_16990":92147,"_23412":92148,"_7169":92149},[45444],"/docs/functions#regexp_replace","REGEXP_REPLACE",{"_11692":1893,"_44950":1857,"_5":45412,"_16990":92151,"_23412":92152,"_7169":92153},[45444],"/docs/functions#regexp_split","REGEXP_SPLIT",{"_11692":1894,"_44950":1857,"_5":45412,"_16990":92155,"_23412":92156,"_7169":92157},[45444],"/docs/functions#upper","UPPER",{"_11692":1895,"_44950":1857,"_5":45412,"_16990":92159,"_23412":92160,"_7169":92161},[45444],"/docs/functions#lower","LOWER",{"_11692":1896,"_44950":1857,"_5":45412,"_16990":92163,"_23412":92164,"_7169":92165},[45444],"/docs/functions#reverse","REVERSE",{"_11692":1897,"_44950":1857,"_5":45412,"_16990":92167,"_23412":92168,"_7169":92169},[45444],"/d