gle-page#what-hbase-and-hadoop-versions-are-supported",{"_11928":3730,"_45410":3682,"_5":45882,"_17277":98877,"_23720":98878,"_7299":89005},[45774],"/docs/single-page#can-phoenix-work-on-tables-with-arbitrary-timestamp-as-flexible-as-hbase-api",{"_11928":3731,"_45410":3682,"_5":45882,"_17277":98880,"_23720":98881,"_7299":89009},[45774],"/docs/single-page#why-isnt-my-query-doing-a-range-scan",{"_11928":3732,"_45410":3682,"_5":45882,"_17277":98883,"_23720":98884,"_7299":89013},[45774],"/docs/single-page#should-i-pool-phoenix-jdbc-connections",{"_11928":3733,"_45410":3682,"_5":45882,"_17277":98886,"_23720":98887,"_7299":89017},[45774],"/docs/single-page#why-does-phoenix-add-an-emptydummy-keyvalue-when-doing-an-upsert",{"_11928":3734,"_45410":3682,"_5":45882,"_17277":98889,"_23720":98890,"_7299":94249},[45774],"/docs/single-page#building",{"_11928":3735,"_45410":3682,"_5":45882,"_17277":98892,"_23720":98893,"_7299":94258},[45774],"/docs/single-page#building-the-main-phoenix-project",{"_11928":3736,"_45410":3682,"_5":45882,"_17277":98895,"_23720":98896,"_7299":94262},[45774],"/docs/single-page#using-phoenix-in-a-maven-project",{"_11928":3737,"_45410":3682,"_5":45882,"_17277":98898,"_23720":98899,"_7299":94266},[45774],"/docs/single-page#branches",{"_11928":3738,"_45410":3682,"_5":45882,"_17277":98901,"_23720":98902,"_7299":94315},[45774],"/docs/single-page#client-classpath-and-jdbc-url",{"_11928":3739,"_45410":3682,"_5":45882,"_17277":98904,"_23720":98905,"_7299":94324},[45774],"/docs/single-page#using-the-phoenix-jdbc-driver",{"_11928":3740,"_45410":3682,"_5":45882,"_17277":98907,"_23720":98908,"_7299":94328},[45774],"/docs/single-page#the-phoenix-classpath",{"_11928":3741,"_45410":3682,"_5":45882,"_17277":98910,"_23720":98911,"_7299":94332},[45774],"/docs/single-page#phoenix-driver-jar",{"_11928":3742,"_45410":3682,"_5":45882,"_17277":98913,"_23720":98914,"_7299":94336},[45774],"/docs/single-page#hbase--hadoop-configuration-files",{"_11928":3743,"_45410":3682,"_5":4588