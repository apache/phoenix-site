":106571,"_65530":106573,"_65532":106575,"_65534":106577,"_65536":106579,"_65538":106581,"_65540":106583,"_65542":106585,"_65544":106587,"_65546":106589,"_65548":106591,"_65550":106593,"_65552":106595,"_65554":106597,"_65556":106599,"_65558":106601,"_65560":106603,"_65562":106605,"_65564":106607,"_65566":106609,"_65568":106611,"_65570":106613,"_65572":106615,"_65574":106617,"_65576":106619,"_65578":106621,"_65580":106623,"_65582":106625,"_65584":106627,"_65586":106629,"_65588":106631,"_65590":106633,"_65592":106635,"_65594":106637,"_65596":106639,"_65598":106641,"_65600":106643,"_65602":106645,"_65604":106647,"_65606":106649,"_65608":106651,"_65610":106653,"_65612":106655,"_65614":106657,"_65616":106659,"_65618":106661,"_65620":106663,"_65622":106665,"_65624":106667,"_65626":106669,"_65628":106671,"_65630":106673,"_65632":106675,"_65634":106677,"_65636":106679,"_65638":106681,"_65640":106683,"_65642":106685,"_65644":106687,"_65646":106689,"_65648":106691,"_65650":106693,"_65652":106695,"_65654":106697,"_65656":106699,"_65658":106701,"_65660":106703,"_65662":106705,"_65664":106707,"_65666":106709,"_65668":106711},{"_11930":11,"_45438":11,"_5":12359,"_7301":87620,"_45913":87621,"_17286":87626,"_23744":11},"Phoenix Omid Transaction Manager",[87622,87623,87624,87625],"Docs","Multi-Page Documentation","Development","Addons",[45942],{"_11930":12,"_45438":11,"_17286":87628,"_5":16822,"_23744":11,"_7301":87629},[45942],"Status update for Apache Omid graduation as an Apache Phoenix sub-project.",{"_11930":13,"_45438":11,"_17286":87631,"_5":16822,"_23744":11,"_7301":87632},[45942],"The Apache Omid podling has recently decided to graduate as a sub-project of Apache Phoenix.",{"_11930":14,"_45438":11,"_17286":87634,"_5":16822,"_23744":11,"_7301":87635},[45942],"This graduation process is currently ongoing. Please follow the Apache Phoenix mailing lists\nfor more information about this effort.",{"_11930":15,"_45438":15,"_5":12359,"_7301":87637,"_45913":87638,"_17286":87639,"_23744":15},"Phoenix ORM library",[87622,87623,87624,87625],[45942],{"_11930":16,"_45438":15,"_17286":87641,"_5":16822,"_23744":15,"_7301":87642},[45942],"Guide to PHO (Phoenix-HBase ORM) for entity mapping, query building, execution, and configuration.",{"_11930":17,"_45438":15,"_5":45910,"_17286":87644,"_23744":87645,"_7301":87646},[45942],"/docs/addons/phoenix-orm-library#entity-class","Entity Class",{"_11930":18,"_45438":15,"_5":45910,"_17286":87648,"_23744":87649,"_7301":87650},[45942],"/docs/addons/phoenix-orm-library#query-building","Query Building",{"_11930":19,"_45438":15,"_5":45910,"_17286":87652,"_23744":87653,"_7301":87654},[45942],"/docs/addons/phoenix-orm-library#simple-queries","Simple queries",{"_11930":20,"_45438":15,"_5":45910,"_17286":87656,"_23744":87657,"_7301":87658},[45942],"/docs/addons/phoenix-orm-library#compound-queries","Compound queries",{"_11930":21,"_45438":15,"_5":45910,"_17286":87660,"_23744":87661,"_7301":87662},[45942],"/docs/addons/phoenix-orm-library#query-interface","Query Interface",{"_11930":22,"_45438":15,"_5":45910,"_17286":87664,"_23744":87665,"_7301":87666},[45942],"/docs/addons/phoenix-orm-library#resolving-entity-and-property-names","Resolving Entity and Property Names",{"_11930":23,"_45438":15,"_5":45910,"_17286":87668,"_23744":87669,"_7301":87670},[45942],"/docs/addons/phoenix-orm-library#query-execution","Query Execution",{"_11930":24,"_45438":15,"_5":45910,"_17286":87672,"_23744":87673,"_7301":87674},[45942],"/docs/addons/phoenix-orm-library#phoenix-orm-library-configuration","Configuration",{"_11930":25,"_45438":15,"_5":45910,"_17286":87676,"_23744":87677,"_7301":87678},[45942],"/docs/addons/phoenix-orm-library#hbase","HBase",{"_11930":26,"_45438":15,"_17286":87680,"_5":16822,"_23744":15,"_7301":87681},[45942],"PHO is an Object Relational Mapping (ORM) library for building and executing queries on HBase using Apache Phoenix.\nIt provides ORM-style mappings and DSL-style query building. Initially developed and open sourced by eHarmony, it is available on GitHub.",{"_11930":27,"_45438":15,"_17286":87683,"_5":16822,"_23744":15,"_7301":87684},[45942],"Its interfaces and generic annotations make it possible to switch data store APIs in the future without changing query definitions.\nCurrently, it supports HBase integration through Apache Phoenix, and can be extended with other implementations.",{"_11930":28,"_45438":15,"_17286":87686,"_5":16822,"_23744":87645,"_7301":87687},[45942],"Suppose we have the following TestClass we want to query in our data store:",{"_11930":29,"_45438":15,"_17286":87689,"_5":16822,"_23744":87649,"_7301":87690},[45942],"Query building can be done in DSL style. More advanced query building is under development, but for now we will use a combination of QueryBuilder and static, Hibernate-style Restrictions methods to construct queries.",{"_11930":30,"_45438":15,"_17286":87692,"_5":16822,"_23744":87653,"_7301":87693},[45942],"Construct a query to find all user matches delivered in the past two days and not in a closed state.",{"_11930":31,"_45438":15,"_17286":87695,"_5":16822,"_23744":87657,"_7301":87696},[45942],"Construct a more complex query where we find items older than one day, include multiple status values, order by deliveryDate, and limit result size to 10.",{"_11930":32,"_45438":15,"_17286":87698,"_5":16822,"_23744":87657,"_7301":87699},[45942],"By default, expressions are combined with AND when added separately.",{"_11930":33,"_45438":15,"_17286":87701,"_5":16822,"_23744":87661,"_7301":87702},[45942],"The following query components are supported:",{"_11930":34,"_45438":15,"_17286":87704,"_5":16822,"_23744":87665,"_7301":87705},[45942],"Always use the property names of your Java objects in your queries.\nIf these names differ from those used in your datastore, use annotations to provide mappings.\nEntity resolvers are configured to map entity classes to table or collection names.\nProperty resolvers are configured to map object variable names to column or field names.",{"_11930":35,"_45438":15,"_17286":87707,"_5":16822,"_23744":87665,"_7301":87708},[45942],"The following annotations are currently supported for the indicated data store type.\nCustom EntityResolvers and PropertyResolvers are straightforward to configure and create.",{"_11930":36,"_45438":15,"_17286":87710,"_5":16822,"_23744":87665,"_7301":87711},[45942],"See Morphia annotations for entity class annotation mappings.",{"_11930":37,"_45438":15,"_17286":87713,"_5":16822,"_23744":87669,"_7301":87714},[45942],"The QueryExecutor interface supports the following operations:",{"_11930":38,"_45438":15,"_17286":87716,"_5":16822,"_23744":87673,"_7301":87717},[45942],"Here are some example Spring configuration files for HBase using Apache Phoenix.",{"_11930":39,"_45438":15,"_17286":87719,"_5":16822,"_23744":87677,"_7301":87720},[45942],"Configuration properties:",{"_11930":40,"_45438":40,"_5":12359,"_7301":87722,"_45913":87723,"_17286":87724,"_23744":40},"Phoenix Tephra Transaction Manager",[87622,87623,87624,87625],[45942],{"_11930":41,"_45438":40,"_17286":87726,"_5":16822,"_23744":40,"_7301":87727},[45942],"Status update for Apache Tephra graduation as an Apache Phoenix sub-project.",{"_11930":42,"_45438":40,"_17286":87729,"_5":16822,"_23744":40,"_7301":87730},[45942],"The Apache Tephra podling has recently decided to graduate as a sub-project of Apache Phoenix.",{"_11930":43,"_45438":40,"_17286":87732,"_5":16822,"_23744":40,"_7301":87635},[45942],{"_11930":44,"_45438":44,"_5":12359,"_7301":87734,"_45913":87735,"_17286":87737,"_23744":44},"Array Type",[87622,87623,87736],"Reference",[45942],{"_11930":45,"_45438":44,"_17286":87739,"_5":16822,"_23744":44,"_7301":87740},[45942],"Use JDBC ARRAY columns in Phoenix, including DDL, inserts, indexing syntax, and built-in array functions.",{"_11930":46,"_45438":44,"_5":45910,"_17286":87742,"_23744":87743,"_7301":87744},[45942],"/docs/array-type#array-type-limitations","Limitations",{"_11930":47,"_45438":44,"_17286":87746,"_5":16822,"_23744":44,"_7301":87747},[45942],"Apache Phoenix 3.0/4.0 introduced support for the JDBC ARRAY type. Any primitive type may be used in an ARRAY. Here is an example of declaring an array type when creating a table:",{"_11930":48,"_45438":44,"_17286":87749,"_5":16822,"_23744":44,"_7301":87750},[45942],"or alternately:",{"_11930":49,"_45438":44,"_17286":87752,"_5":16822,"_23744":44,"_7301":87753},[45942],"Insertion into the array may be done entirely through a SQL statement:",{"_11930":50,"_45438":44,"_17286":87755,"_5":16822,"_23744":44,"_7301":87756},[45942],"or programmatically through JDBC:",{"_11930":51,"_45438":44,"_17286":87758,"_5":16822,"_23744":44,"_7301":87759},[45942],"The entire array may be selected:",{"_11930":52,"_45438":44,"_17286":87761,"_5":16822,"_23744":44,"_7301":87762},[45942],"or an individual element in the array may be accessed via a subscript notation. The subscript is one-based, so the following would select the first element:",{"_11930":53,"_45438":44,"_17286":87764,"_5":16822,"_23744":44,"_7301":87765},[45942],"Use of the array subscript notation is supported in other expressions as well, for example in a WHERE clause:",{"_11930":54,"_45438":44,"_17286":87767,"_5":16822,"_23744":44,"_7301":87768},[45942],"The array length grows dynamically as needed and can be accessed through the built-in ARRAY_LENGTH function:",{"_11930":55,"_45438":44,"_17286":87770,"_5":16822,"_23744":44,"_7301":87771},[45942],"Attempts to access an array element beyond the current length will evaluate to null.",{"_11930":56,"_45438":44,"_17286":87773,"_5":16822,"_23744":44,"_7301":87774},[45942],"For searching in an array, built-in functions like ANY and ALL are provided. For example,",{"_11930":57,"_45438":44,"_17286":87776,"_5":16822,"_23744":44,"_7301":87777},[45942],"The built-in function ANY checks if any array element satisfies the condition and is equivalent to an OR condition:",{"_11930":58,"_45438":44,"_17286":87779,"_5":16822,"_23744":44,"_7301":87780},[45942],"The built-in function ALL checks if all array elements satisfy the condition and is equivalent to an AND condition:",{"_11930":59,"_45438":44,"_17286":87782,"_5":16822,"_23744":87743,"_7301":87783},[45942],"Only one-dimensional arrays are currently supported.",{"_11930":60,"_45438":44,"_17286":87785,"_5":16822,"_23744":87743,"_7301":87786},[45942],"For an array of fixed width types, null elements occurring in the middle of an array are not tracked.",{"_11930":61,"_45438":44,"_17286":87788,"_5":16822,"_23744":87743,"_7301":87789},[45942],"The declaration of an array length at DDL time is not enforced currently, but maybe in the future. Note that it is persisted with the table metadata.",{"_11930":62,"_45438":44,"_17286":87791,"_5":16822,"_23744":87743,"_7301":87792},[45942],"An array may only be used as the last column in a primary key constraint.",{"_11930":63,"_45438":44,"_17286":87794,"_5":16822,"_23744":87743,"_7301":87795},[45942],"Partial update of an array is currently not possible. Instead, the array may be manipulated on the client-side and then upserted back in its entirety.",{"_11930":64,"_45438":64,"_5":12359,"_7301":87797,"_45913":87798,"_17286":87800,"_23744":64},"Building Website",[87622,87623,87624,87799],"Contributing",[45942],{"_11930":65,"_45438":64,"_17286":87802,"_5":16822,"_23744":64,"_7301":87803},[45942],"Build and test the Apache Phoenix website locally with the current React + TypeScript workflow.",{"_11930":66,"_45438":64,"_5":45910,"_17286":87805,"_23744":87806,"_7301":87807},[45942],"/docs/contributing/building-website#building-website-prerequisites","Prerequisites",{"_11930":67,"_45438":64,"_5":45910,"_17286":87809,"_23744":87810,"_7301":87811},[45942],"/docs/contributing/building-website#building-phoenix-project-website","Building Phoenix Project Website",{"_11930":68,"_45438":64,"_5":45910,"_17286":87813,"_23744":87814,"_7301":87815},[45942],"/docs/contributing/building-website#publishing-website-artifact","Publishing Website Artifact",{"_11930":69,"_45438":64,"_5":45910,"_17286":87817,"_23744":87818,"_7301":87819},[45942],"/docs/contributing/building-website#local-testing-during-development","Local Testing During Development",{"_11930":70,"_45438":64,"_17286":87821,"_5":16822,"_23744":87806,"_7301":87822},[45942],"Node.js 22.x (minimum 22.12.0)",{"_11930":71,"_45438":64,"_17286":87824,"_5":16822,"_23744":87806,"_7301":87825},[45942],"npm (bundled with Node.js)",{"_11930":72,"_45438":64,"_17286":87827,"_5":16822,"_23744":87810,"_7301":87828},[45942],"Clone the repository:",{"_11930":73,"_45438":64,"_17286":87830,"_5":16822,"_23744":87810,"_7301":87831},[45942],"During development, install dependencies:",{"_11930":74,"_45438":64,"_17286":87833,"_5":16822,"_23744":87810,"_7301":87834},[45942],"For local iteration, run checks/build directly when needed:",{"_11930":75,"_45438":64,"_17286":87836,"_5":16822,"_23744":87810,"_7301":87837},[45942],"Before opening a pull request, run the mandatory build script:",{"_11930":76,"_45438":64,"_17286":87839,"_5":16822,"_23744":87810,"_7301":87840},[45942],"build.sh is required for all contributors. It:",{"_11930":77,"_45438":64,"_17286":87842,"_5":16822,"_23744":87810,"_7301":87843},[45942],"ensures Node/npm are available",{"_11930":78,"_45438":64,"_17286":87845,"_5":16822,"_23744":87810,"_7301":87846},[45942],"runs a clean install (npm ci)",{"_11930":79,"_45438":64,"_17286":87848,"_5":16822,"_23744":87810,"_7301":87849},[45942],"runs full validation/build (npm run ci)",{"_11930":80,"_45438":64,"_17286":87851,"_5":16822,"_23744":87810,"_7301":87852},[45942],"copies build/client/ into output/",{"_11930":81,"_45438":64,"_17286":87854,"_5":16822,"_23744":87810,"_7301":87855},[45942],"There is no remote CI/CD runner currently executing this script. The generated output/ directory is a build artifact that must be committed and pushed with your PR.",{"_11930":82,"_45438":64,"_17286":87857,"_5":16822,"_23744":87814,"_7301":87858},[45942],"Current publishing flow:",{"_11930":83,"_45438":64,"_17286":87860,"_5":16822,"_23744":87814,"_7301":87861},[45942],"Run ./build.sh locally",{"_11930":84,"_45438":64,"_17286":87863,"_5":16822,"_23744":87814,"_7301":87864},[45942],"Commit both source changes and updated output/",{"_11930":85,"_45438":64,"_17286":87866,"_5":16822,"_23744":87814,"_7301":87867},[45942],"Push your branch and open a PR",{"_11930":86,"_45438":64,"_17286":87869,"_5":16822,"_23744":87814,"_7301":87870},[45942],"After merge, output/ is used as the website artifact for deployment.",{"_11930":87,"_45438":64,"_17286":87872,"_5":16822,"_23744":87818,"_7301":87873},[45942],"Start the development server with hot reload:",{"_11930":88,"_45438":64,"_17286":87875,"_5":16822,"_23744":87818,"_7301":87876},[45942],"By default, the website is available at:",{"_11930":89,"_45438":64,"_17286":87878,"_5":16822,"_23744":87818,"_7301":87879},[45942],"To test the production build locally:",{"_11930":90,"_45438":90,"_5":12359,"_7301":87881,"_45913":87882,"_17286":87883,"_23744":90},"Developing Phoenix",[87622,87623,87624,87799],[45942],{"_11930":91,"_45438":90,"_17286":87885,"_5":16822,"_23744":90,"_7301":87886},[45942],"Set up a local Apache Phoenix development environment, IDE preferences, and contribution workflow.",{"_11930":92,"_45438":90,"_5":45910,"_17286":87888,"_23744":87889,"_7301":87890},[45942],"/docs/contributing/develop#develop-getting-started","Getting Started",{"_11930":93,"_45438":90,"_5":45910,"_17286":87892,"_23744":87893,"_7301":87894},[45942],"/docs/contributing/develop#other-phoenix-subprojects","Other Phoenix Subprojects",{"_11930":94,"_45438":90,"_5":45910,"_17286":87896,"_23744":87897,"_7301":87898},[45942],"/docs/contributing/develop#setup-local-git-repository","Setup Local Git Repository",{"_11930":95,"_45438":90,"_5":45910,"_17286":87900,"_23744":87901,"_7301":87902},[45942],"/docs/contributing/develop#for-eclipse-ide-for-java-developers-luna","For Eclipse IDE for Java Developers (Luna)",{"_11930":96,"_45438":90,"_5":45910,"_17286":87904,"_23744":87905,"_7301":87906},[45942],"/docs/contributing/develop#get-settings-and-preferences-correct","Get Settings and Preferences Correct",{"_11930":97,"_45438":90,"_5":45910,"_17286":87908,"_23744":87909,"_7301":87910},[45942],"/docs/contributing/develop#connecting-to-jira","Connecting to Jira",{"_11930":98,"_45438":90,"_5":45910,"_17286":87912,"_23744":87913,"_7301":87914},[45942],"/docs/contributing/develop#commit","Commit",{"_11930":99,"_45438":90,"_5":45910,"_17286":87916,"_23744":87917,"_7301":87918},[45942],"/docs/contributing/develop#for-intellij","For Intellij",{"_11930":100,"_45438":90,"_5":45910,"_17286":87920,"_23744":87921,"_7301":87922},[45942],"/docs/contributing/develop#if-you-dont-have-a-local-git-repository-setup","If you don't have a local git repository setup",{"_11930":101,"_45438":90,"_5":45910,"_17286":87924,"_23744":87925,"_7301":87926},[45942],"/docs/contributing/develop#if-you-already-have-a-local-git-repository-setup","If you already have a local git repository setup",{"_11930":102,"_45438":90,"_5":45910,"_17286":87928,"_23744":87929,"_7301":87906},[45942],"/docs/contributing/develop#get-settings-and-preferences-correct-1",{"_11930":103,"_45438":90,"_5":45910,"_17286":87931,"_23744":87932,"_7301":87910},[45942],"/docs/contributing/develop#connecting-to-jira-1",{"_11930":104,"_45438":90,"_5":45910,"_17286":87934,"_23744":87935,"_7301":87914},[45942],"/docs/contributing/develop#commit-1",{"_11930":105,"_45438":90,"_5":45910,"_17286":87937,"_23744":87938,"_7301":87939},[45942],"/docs/contributing/develop#contributing-finished-work","Contributing finished work",{"_11930":106,"_45438":90,"_5":45910,"_17286":87941,"_23744":87942,"_7301":87943},[45942],"/docs/contributing/develop#create-pull-request","Create pull request",{"_11930":107,"_45438":90,"_17286":87945,"_5":16822,"_23744":87889,"_7301":87946},[45942],"Review the How to Contribute documentation.",{"_11930":108,"_45438":90,"_17286":87948,"_5":16822,"_23744":87889,"_7301":87949},[45942],"Sign up for a GitHub account if you do not have one.",{"_11930":109,"_45438":90,"_17286":87951,"_5":16822,"_23744":87889,"_7301":87952},[45942],"Go to the Phoenix GitHub repository and create a fork, which creates {username}/phoenix.",{"_11930":110,"_45438":90,"_17286":87954,"_5":16822,"_23744":87889,"_7301":87955},[45942],"Set up Git locally.",{"_11930":111,"_45438":90,"_17286":87957,"_5":16822,"_23744":87889,"_7301":87958},[45942],"Instructions",{"_11930":112,"_45438":90,"_17286":87960,"_5":16822,"_23744":87889,"_7301":87961},[45942],"Download",{"_11930":113,"_45438":90,"_17286":87963,"_5":16822,"_23744":87889,"_7301":87964},[45942],"Make sure you have a JDK (Phoenix historically required JDK 7).",{"_11930":114,"_45438":90,"_17286":87966,"_5":16822,"_23744":87889,"_7301":87967},[45942],"Make sure you have Maven 3+ installed.",{"_11930":115,"_45438":90,"_17286":87969,"_5":16822,"_23744":87889,"_7301":87970},[45942],"Add the following to your .bashrc or equivalent to ensure Maven and Java are configured correctly for command-line usage.",{"_11930":116,"_45438":90,"_17286":87972,"_5":16822,"_23744":87893,"_7301":87973},[45942],"The instructions here are for the main Phoenix project. For the other subprojects, use the corresponding repository and JIRA project.",{"_11930":117,"_45438":90,"_17286":87975,"_5":16822,"_23744":87893,"_7301":87976},[45942],"The Eclipse and IntelliJ setup instructions may not necessarily work well for the other projects.",{"_11930":118,"_45438":90,"_17286":87978,"_5":16822,"_23744":87897,"_7301":87979},[45942],"You may find it easier to clone from your IDE of choice, especially with IntelliJ.",{"_11930":119,"_45438":90,"_17286":87981,"_5":16822,"_23744":87897,"_7301":87982},[45942],"Create a local clone of your new forked repository",{"_11930":120,"_45438":90,"_17286":87984,"_5":16822,"_23744":87897,"_7301":87985},[45942],"Configure your local repository to be able to sync with the apache/phoenix repository",{"_11930":121,"_45438":90,"_17286":87987,"_5":16822,"_23744":87897,"_7301":87988},[45942],"Setup your development environment",{"_11930":122,"_45438":90,"_17286":87990,"_5":16822,"_23744":87901,"_7301":87991},[45942],"Download Eclipse",{"_11930":123,"_45438":90,"_17286":87993,"_5":16822,"_23744":87901,"_7301":87994},[45942],"You will want 'Eclipse IDE for Java Developers' unless you want to install the following tools by hand",{"_11930":124,"_45438":90,"_17286":87996,"_5":16822,"_23744":87901,"_7301":19384},[45942],{"_11930":125,"_45438":90,"_17286":87998,"_5":16822,"_23744":87901,"_7301":39878},[45942],{"_11930":126,"_45438":90,"_17286":88000,"_5":16822,"_23744":87901,"_7301":88001},[45942],"Configure Eclipse to handle Maven Issues appropriately so you don't see unnecessary errors.",{"_11930":127,"_45438":90,"_17286":88003,"_5":16822,"_23744":87901,"_7301":88004},[45942],"Window -> Preferences -> Maven -> Errors/Warnings",{"_11930":128,"_45438":90,"_17286":88006,"_5":16822,"_23744":87901,"_7301":88007},[45942],"Choose Ignore option for 'Plugin execution not covered by lifecycle configuration' -> Ok",{"_11930":129,"_45438":90,"_17286":88009,"_5":16822,"_23744":87901,"_7301":88010},[45942],"Add the local Git repository to Eclipse",{"_11930":130,"_45438":90,"_17286":88012,"_5":16822,"_23744":87901,"_7301":88013},[45942],"Window -> Show View -> Other... -> Git | Git Repositories -> Ok",{"_11930":131,"_45438":90,"_17286":88015,"_5":16822,"_23744":87901,"_7301":88016},[45942],"Click 'Add an existing local Git Repository to this view'",{"_11930":132,"_45438":90,"_17286":88018,"_5":16822,"_23744":87901,"_7301":88019},[45942],"Search for appropriate git repository",{"_11930":133,"_45438":90,"_17286":88021,"_5":16822,"_23744":87901,"_7301":88022},[45942],"Finish",{"_11930":134,"_45438":90,"_17286":88024,"_5":16822,"_23744":87901,"_7301":88025},[45942],"Import Maven Projects",{"_11930":135,"_45438":90,"_17286":88027,"_5":16822,"_23744":87901,"_7301":88028},[45942],"File -> Import -> Maven -> Existing Maven Projects",{"_11930":136,"_45438":90,"_17286":88030,"_5":16822,"_23744":87901,"_7301":88031},[45942],"Choose Root directory where phoenix git repository is located",{"_11930":137,"_45438":90,"_17286":88033,"_5":16822,"_23744":87901,"_7301":88034},[45942],"Select All",{"_11930":138,"_45438":90,"_17286":88036,"_5":16822,"_23744":87901,"_7301":88022},[45942],{"_11930":139,"_45438":90,"_17286":88038,"_5":16822,"_23744":87901,"_7301":88039},[45942],"Generate Lexer and Parser Files",{"_11930":140,"_45438":90,"_17286":88041,"_5":16822,"_23744":87901,"_7301":88042},[45942],"Select phoenix-core project",{"_11930":141,"_45438":90,"_17286":88044,"_5":16822,"_23744":87901,"_7301":88045},[45942],"Run -> Run As -> Maven generate-sources",{"_11930":142,"_45438":90,"_17286":88047,"_5":16822,"_23744":87901,"_7301":88048},[45942],"Make sure you are setup to develop now.",{"_11930":143,"_45438":90,"_17286":88050,"_5":16822,"_23744":87901,"_7301":88051},[45942],"Open IndexUtilTest.Java",{"_11930":144,"_45438":90,"_17286":88053,"_5":16822,"_23744":87901,"_7301":88054},[45942],"Run -> Run As -> JUnit Test",{"_11930":145,"_45438":90,"_17286":88056,"_5":16822,"_23744":87905,"_7301":88057},[45942],"Import General Preferences",{"_11930":146,"_45438":90,"_17286":88059,"_5":16822,"_23744":87905,"_7301":88060},[45942],"File -> Import... -> General -> Preferences",{"_11930":147,"_45438":90,"_17286":88062,"_5":16822,"_23744":87905,"_7301":88063},[45942],"From - {repository}/dev/eclipse_prefs_phoenix.epf",{"_11930":148,"_45438":90,"_17286":88065,"_5":16822,"_23744":87905,"_7301":88066},[45942],"Import All",{"_11930":149,"_45438":90,"_17286":88068,"_5":16822,"_23744":87905,"_7301":88022},[45942],{"_11930":150,"_45438":90,"_17286":88070,"_5":16822,"_23744":87905,"_7301":88071},[45942],"Import Code Templates",{"_11930":151,"_45438":90,"_17286":88073,"_5":16822,"_23744":87905,"_7301":88074},[45942],"Window -> Preferences -> Java -> Code Style -> Code Templates -> Import...",{"_11930":152,"_45438":90,"_17286":88076,"_5":16822,"_23744":87905,"_7301":88077},[45942],"Navigate to {repository}/dev/PhoenixCodeTemplate.xml -> Ok",{"_11930":153,"_45438":90,"_17286":88079,"_5":16822,"_23744":87905,"_7301":88080},[45942],"Import Formatter",{"_11930":154,"_45438":90,"_17286":88082,"_5":16822,"_23744":87905,"_7301":88083},[45942],"Window -> Preferences -> Java -> Code Style -> Formatter-> Import...",{"_11930":155,"_45438":90,"_17286":88085,"_5":16822,"_23744":87905,"_7301":88077},[45942],{"_11930":156,"_45438":90,"_17286":88087,"_5":16822,"_23744":87905,"_7301":88088},[45942],"Import correct import order settings",{"_11930":157,"_45438":90,"_17286":88090,"_5":16822,"_23744":87905,"_7301":88091},[45942],"Window -> Preferences -> Java -> Code Style -> Organize Imports -> Import...",{"_11930":158,"_45438":90,"_17286":88093,"_5":16822,"_23744":87905,"_7301":88094},[45942],"Navigate to {repository}/dev/phoenix.importorder -> Ok",{"_11930":159,"_45438":90,"_17286":88096,"_5":16822,"_23744":87905,"_7301":88097},[45942],"Make sure you use space for tabs",{"_11930":160,"_45438":90,"_17286":88099,"_5":16822,"_23744":87905,"_7301":88100},[45942],"Window -> Preferences -> General -> Editors -> Text Editors",{"_11930":161,"_45438":90,"_17286":88102,"_5":16822,"_23744":87905,"_7301":88103},[45942],"Select 'Insert Spaces for tabs' -> Ok",{"_11930":162,"_45438":90,"_17286":88105,"_5":16822,"_23744":87909,"_7301":88106},[45942],"Install Connector for Jira",{"_11930":163,"_45438":90,"_17286":88108,"_5":16822,"_23744":87909,"_7301":88109},[45942],"Help -> Install New Software -> Add",{"_11930":164,"_45438":90,"_17286":88111,"_5":16822,"_23744":87909,"_7301":88112},[45942],"Location - https://update.atlassian.com/atlassian-eclipse-plugin/rest/e3.7 -> Atlassian Connector",{"_11930":165,"_45438":90,"_17286":88114,"_5":16822,"_23744":87909,"_7301":88022},[45942],{"_11930":166,"_45438":90,"_17286":88116,"_5":16822,"_23744":87909,"_7301":88117},[45942],"Add Task Repository",{"_11930":167,"_45438":90,"_17286":88119,"_5":16822,"_23744":87909,"_7301":88120},[45942],"Window -> Show View -> Mylyn -> Task Repositories -> Add Task Repository",{"_11930":168,"_45438":90,"_17286":88122,"_5":16822,"_23744":87909,"_7301":88123},[45942],"JIRA -> Next -> Server - https://issues.apache.org/jira -> Validate Settings",{"_11930":169,"_45438":90,"_17286":88125,"_5":16822,"_23744":87909,"_7301":88022},[45942],{"_11930":170,"_45438":90,"_17286":88127,"_5":16822,"_23744":87909,"_7301":88128},[45942],"Add Filter Of All JIRAs assigned to you",{"_11930":171,"_45438":90,"_17286":88130,"_5":16822,"_23744":87909,"_7301":88131},[45942],"Right Click on Repository You added -> New Query... -> Predefined Filter",{"_11930":172,"_45438":90,"_17286":88133,"_5":16822,"_23744":87909,"_7301":88134},[45942],"Select Phoenix Project -> Select Assigned to me",{"_11930":173,"_45438":90,"_17286":88136,"_5":16822,"_23744":87909,"_7301":88022},[45942],{"_11930":174,"_45438":90,"_17286":88138,"_5":16822,"_23744":87913,"_7301":88139},[45942],"Commit Changes and Push to Github with appropriate Message",{"_11930":175,"_45438":90,"_17286":88141,"_5":16822,"_23744":87913,"_7301":88142},[45942],"CTRL-# -> Set Commit message to include jira number at beginning PHOENIX-####",{"_11930":176,"_45438":90,"_17286":88144,"_5":16822,"_23744":87913,"_7301":88145},[45942],"Commit and Push",{"_11930":177,"_45438":90,"_17286":88147,"_5":16822,"_23744":87917,"_7301":88148},[45942],"Download IntelliJ",{"_11930":178,"_45438":90,"_17286":88150,"_5":16822,"_23744":87921,"_7301":88151},[45942],"This will automatically create the local clone of your repository for you. You will still want to add the remote upstream repository from above afterwards.",{"_11930":179,"_45438":90,"_17286":88153,"_5":16822,"_23744":87921,"_7301":88154},[45942],"Clone Github project and Import Maven Projects to IDE",{"_11930":180,"_45438":90,"_17286":88156,"_5":16822,"_23744":87921,"_7301":88157},[45942],"Check out from Version Control -> GitHub -> Enter your GitHub Login Info",{"_11930":181,"_45438":90,"_17286":88159,"_5":16822,"_23744":87921,"_7301":88160},[45942],"https://github.com/{username}/phoenix.git -> Check out from Version Control | Yes",{"_11930":182,"_45438":90,"_17286":88162,"_5":16822,"_23744":87921,"_7301":88163},[45942],"Generate Parser and Lexer Files",{"_11930":183,"_45438":90,"_17286":88165,"_5":16822,"_23744":87921,"_7301":88166},[45942],"Maven Projects -> Phoenix Core -> Lifecycle -> compile",{"_11930":184,"_45438":90,"_17286":88168,"_5":16822,"_23744":87921,"_7301":88169},[45942],"Compile Project",{"_11930":185,"_45438":90,"_17286":88171,"_5":16822,"_23744":87921,"_7301":88172},[45942],"Build -> Make Project",{"_11930":186,"_45438":90,"_17286":88174,"_5":16822,"_23744":87921,"_7301":88048},[45942],{"_11930":187,"_45438":90,"_17286":88176,"_5":16822,"_23744":87921,"_7301":88177},[45942],"Open IndexUtilTest.Java -> Run -> Run IndexUtilTest",{"_11930":188,"_45438":90,"_17286":88179,"_5":16822,"_23744":87925,"_7301":88180},[45942],"Import Projects",{"_11930":189,"_45438":90,"_17286":88182,"_5":16822,"_23744":87925,"_7301":88183},[45942],"Import Project",{"_11930":190,"_45438":90,"_17286":88185,"_5":16822,"_23744":87925,"_7301":88186},[45942],"Select Directory of your local repository -> Next",{"_11930":191,"_45438":90,"_17286":88188,"_5":16822,"_23744":87925,"_7301":88189},[45942],"Import project from external model -> Maven -> Next",{"_11930":192,"_45438":90,"_17286":88191,"_5":16822,"_23744":87925,"_7301":88192},[45942],"Select 'Import Maven project automatically'",{"_11930":193,"_45438":90,"_17286":88194,"_5":16822,"_23744":87925,"_7301":88195},[45942],"Select 'Create IntelliJ IDEA modules for aggregator projects'",{"_11930":194,"_45438":90,"_17286":88197,"_5":16822,"_23744":87925,"_7301":88198},[45942],"Select 'Keep source and test folders on reimport'",{"_11930":195,"_45438":90,"_17286":88200,"_5":16822,"_23744":87925,"_7301":88201},[45942],"Select 'Exclude build directory'",{"_11930":196,"_45438":90,"_17286":88203,"_5":16822,"_23744":87925,"_7301":88204},[45942],"Select 'Use Maven output directories' -> Next",{"_11930":197,"_45438":90,"_17286":88206,"_5":16822,"_23744":87925,"_7301":88207},[45942],"Select maven-3 -> Next",{"_11930":198,"_45438":90,"_17286":88209,"_5":16822,"_23744":87925,"_7301":88210},[45942],"Next a whole bunch",{"_11930":199,"_45438":90,"_17286":88212,"_5":16822,"_23744":87925,"_7301":88163},[45942],{"_11930":200,"_45438":90,"_17286":88214,"_5":16822,"_23744":87925,"_7301":88166},[45942],{"_11930":201,"_45438":90,"_17286":88216,"_5":16822,"_23744":87925,"_7301":88169},[45942],{"_11930":202,"_45438":90,"_17286":88218,"_5":16822,"_23744":87925,"_7301":88172},[45942],{"_11930":203,"_45438":90,"_17286":88220,"_5":16822,"_23744":87925,"_7301":88048},[45942],{"_11930":204,"_45438":90,"_17286":88222,"_5":16822,"_23744":87925,"_7301":88177},[45942],{"_11930":205,"_45438":90,"_17286":88224,"_5":16822,"_23744":87929,"_7301":88225},[45942],"Import Settings from eclipse profile",{"_11930":206,"_45438":90,"_17286":88227,"_5":16822,"_23744":87929,"_7301":88228},[45942],"File -> Settings -> Editor -> Code Style -> Java",{"_11930":207,"_45438":90,"_17286":88230,"_5":16822,"_23744":87929,"_7301":88231},[45942],"Set From... -> Import... -> Eclipse XML Profile -> {repository}/dev/PhoenixCodeTemplate.xml",{"_11930":208,"_45438":90,"_17286":88233,"_5":16822,"_23744":87932,"_7301":88234},[45942],"Create Connection to Apache Jira",{"_11930":209,"_45438":90,"_17286":88236,"_5":16822,"_23744":87932,"_7301":88237},[45942],"Tools -> Tasks and Contexts -> Configure Servers -> + -> Jira ->",{"_11930":210,"_45438":90,"_17286":88239,"_5":16822,"_23744":87932,"_7301":88240},[45942],"Server Url: https://issues.apache.org/jira",{"_11930":211,"_45438":90,"_17286":88242,"_5":16822,"_23744":87932,"_7301":88243},[45942],"Query: 'project=Phoenix and ...'",{"_11930":212,"_45438":90,"_17286":88245,"_5":16822,"_23744":87932,"_7301":88246},[45942],"Switch Easily between Tasks",{"_11930":213,"_45438":90,"_17286":88248,"_5":16822,"_23744":87932,"_7301":88249},[45942],"Tools-> Tasks and Contexts -> Open Task->PHOENIX-####",{"_11930":214,"_45438":90,"_17286":88251,"_5":16822,"_23744":87932,"_7301":88252},[45942],"Select Create branch PHOENIX-#### from master->OK",{"_11930":215,"_45438":90,"_17286":88254,"_5":16822,"_23744":87935,"_7301":88139},[45942],{"_11930":216,"_45438":90,"_17286":88256,"_5":16822,"_23744":87935,"_7301":88257},[45942],"VCS -> Commit -> Set Commit message to include jira number PHOENIX-####",{"_11930":217,"_45438":90,"_17286":88259,"_5":16822,"_23744":87935,"_7301":88145},[45942],{"_11930":218,"_45438":90,"_17286":88261,"_5":16822,"_23744":87942,"_7301":87946},[45942],{"_11930":219,"_45438":90,"_17286":88263,"_5":16822,"_23744":87942,"_7301":88264},[45942],"Navigate to branch: https://github.com/{username}/phoenix/tree/{branchname}",{"_11930":220,"_45438":90,"_17286":88266,"_5":16822,"_23744":87942,"_7301":88267},[45942],"Click Pull Request",{"_11930":221,"_45438":90,"_17286":88269,"_5":16822,"_23744":87942,"_7301":88270},[45942],"Confirm that you see apache:master ... {username}:{branchname}",{"_11930":222,"_45438":90,"_17286":88272,"_5":16822,"_23744":87942,"_7301":88273},[45942],"Make sure the pull request title begins with the JIRA key, for example PHOENIX-####.",{"_11930":223,"_45438":90,"_17286":88275,"_5":16822,"_23744":87942,"_7301":88276},[45942],"Click Create pull request.",{"_11930":224,"_45438":224,"_5":12359,"_7301":88278,"_45913":88279,"_17286":88280,"_23744":224},"How to Release",[87622,87623,87624,87799],[45942],{"_11930":225,"_45438":224,"_17286":88282,"_5":16822,"_23744":224,"_7301":88283},[45942],"Apache Phoenix release process, release candidates, and voting workflow.",{"_11930":226,"_45438":224,"_5":45910,"_17286":88285,"_23744":88286,"_7301":88278},[45942],"/docs/contributing/how-to-release#contributing-how-to-release",{"_11930":227,"_45438":224,"_5":45910,"_17286":88288,"_23744":88289,"_7301":88290},[45942],"/docs/contributing/how-to-release#pre-reqs","Pre-Reqs",{"_11930":228,"_45438":224,"_5":45910,"_17286":88292,"_23744":88293,"_7301":88294},[45942],"/docs/contributing/how-to-release#do-a-dry-run","Do a dry run",{"_11930":229,"_45438":224,"_5":45910,"_17286":88296,"_23744":88297,"_7301":88298},[45942],"/docs/contributing/how-to-release#create-real-rc","Create real RC",{"_11930":230,"_45438":224,"_5":45910,"_17286":88300,"_23744":88301,"_7301":88302},[45942],"/docs/contributing/how-to-release#close-the-staging-repository","Close the staging repository",{"_11930":231,"_45438":224,"_5":45910,"_17286":88304,"_23744":88305,"_7301":88306},[45942],"/docs/contributing/how-to-release#voting","Voting",{"_11930":232,"_45438":224,"_5":45910,"_17286":88308,"_23744":88309,"_7301":88310},[45942],"/docs/contributing/how-to-release#release","Release",{"_11930":233,"_45438":224,"_17286":88312,"_5":16822,"_23744":88286,"_7301":88313},[45942],"Phoenix has several repos: phoenix-thirdparty, phoenix-omid, phoenix-tephra, phoenix, phoenix-connectors, and phoenix-queryserver.\nThe create-release scripts provide a unified script to handle the release from each repo.\nThe create-release scripts are in the master branch of the phoenix repo, in the dev/create-release directory.",{"_11930":234,"_45438":224,"_17286":88315,"_5":16822,"_23744":88289,"_7301":88316},[45942],"Make sure that the JIRAs included in the release have their fix-version and release notes fields set correctly, and are resolved.The script will query them and create the CHANGES and RELEASE_NOTES files from that information.Use dev/misc_utils/git_jira_fix_version_check.py to find discrepancies between commits and JIRAs.",{"_11930":235,"_45438":224,"_17286":88318,"_5":16822,"_23744":88289,"_7301":88319},[45942],"Make sure you have set up your user for release signing. Details: http://www.apache.org/dev/release-signing.html.",{"_11930":236,"_45438":224,"_17286":88321,"_5":16822,"_23744":88289,"_7301":88322},[45942],"Make sure you have set up Maven for deploying to the ASF repo. Details: https://infra.apache.org/publishing-maven-artifacts.html.",{"_11930":237,"_45438":224,"_17286":88324,"_5":16822,"_23744":88289,"_7301":88325},[45942],"Clone the Phoenix master branch locally (the script will download the actual repo to release itself).",{"_11930":238,"_45438":224,"_17286":88327,"_5":16822,"_23744":88289,"_7301":88328},[45942],"Make sure Docker is running locally.",{"_11930":239,"_45438":224,"_17286":88330,"_5":16822,"_23744":88289,"_7301":88331},[45942],"Note that Docker Desktop for Mac works, but will be slow (several hours for a Phoenix core release). Running on a native Linux machine is much faster because you avoid filesystem translation layer overhead.",{"_11930":240,"_45438":224,"_17286":88333,"_5":16822,"_23744":88293,"_7301":88334},[45942],"Read /dev/create_release/README.txt to understand what the script does and how to set up gpg-agent for signing.",{"_11930":241,"_45438":224,"_17286":88336,"_5":16822,"_23744":88293,"_7301":88337},[45942],"Run the dev/create-release/do-release-docker.sh -d <workdir> -p <project> command, where",{"_11930":242,"_45438":224,"_17286":88339,"_5":16822,"_23744":88293,"_7301":88340},[45942],"<project> is the repo name you're releasing from (i.e. phoenix)",{"_11930":243,"_45438":224,"_17286":88342,"_5":16822,"_23744":88293,"_7301":88343},[45942],"<workdir> is any existing directory that can be deleted",{"_11930":244,"_45438":224,"_17286":88345,"_5":16822,"_23744":88293,"_7301":88346},[45942],"The script will ask a number of questions. Some of them will have intelligent default, but make sure you check them all:",{"_11930":245,"_45438":224,"_17286":88348,"_5":16822,"_23744":88293,"_7301":88349},[45942],"PROJECT: the repo to release (default specified by -p on the command line)",{"_11930":246,"_45438":224,"_17286":88351,"_5":16822,"_23744":88293,"_7301":88352},[45942],"GIT_BRANCH: the git branch to use for release. This can be master, or a pre-created release branch.",{"_11930":247,"_45438":224,"_17286":88354,"_5":16822,"_23744":88293,"_7301":88355},[45942],"RC_COUNT: the RC number, starting from 0",{"_11930":248,"_45438":224,"_17286":88357,"_5":16822,"_23744":88293,"_7301":88358},[45942],"RELEASE_TAG: the git tag the script will tag the RC commit with.",{"_11930":249,"_45438":224,"_17286":88360,"_5":16822,"_23744":88293,"_7301":88361},[45942],"ASF_USERNAME: your ASF username, for publishing the release artifacts.",{"_11930":250,"_45438":224,"_17286":88363,"_5":16822,"_23744":88293,"_7301":88364},[45942],"ASF_PASSWORD: your ASF password, only for non-dry runs",{"_11930":251,"_45438":224,"_17286":88366,"_5":16822,"_23744":88293,"_7301":88367},[45942],"GIT_NAME/GIT_EMAIL: will be used for the RC commit",{"_11930":252,"_45438":224,"_17286":88369,"_5":16822,"_23744":88293,"_7301":88370},[45942],"GPG_KEY: ID for your GPG key. The script will offer a GPG secret key from your key ring, double-check that it is your code-signing key, and correct it if it is not.",{"_11930":253,"_45438":224,"_17286":88372,"_5":16822,"_23744":88293,"_7301":88373},[45942],"The dry-run will generate the signed release files into <workdir>/output directory.\nThe Maven artifacts will be in <workdir>/output/phoenix-repo-XXXX local Maven repo, in the usual structure.",{"_11930":254,"_45438":224,"_17286":88375,"_5":16822,"_23744":88297,"_7301":88376},[45942],"If the dry-run release artifacts (source, binary, and Maven) check out, then publish a real RC to ASF.",{"_11930":255,"_45438":224,"_17286":88378,"_5":16822,"_23744":88297,"_7301":88379},[45942],"Repeat the dry run process, but add the -f switch to the do-release-docker.sh command.",{"_11930":256,"_45438":224,"_17286":88381,"_5":16822,"_23744":88297,"_7301":88382},[45942],"The script will upload the source and binary release artifacts to a directory under https://dist.apache.org/repos/dist/dev/phoenix/.\nThe script will also deploy the Maven artifacts to https://repository.apache.org/#stagingRepositories.\nCheck that these are present.",{"_11930":257,"_45438":224,"_17286":88384,"_5":16822,"_23744":88301,"_7301":88385},[45942],"The published staging repository is in the \"open\" state. Open staging repositories\nare aggressively cleaned up, and may be removed by the time the vote passes.\nTo avoid this, close\n(but DO NOT release) the staging repository immediately after deployment.",{"_11930":258,"_45438":224,"_17286":88387,"_5":16822,"_23744":88305,"_7301":88388},[45942],"Initiate the vote email. See example here, or use the <workdir>/output/vote.txt template generated by the script.",{"_11930":259,"_45438":224,"_17286":88390,"_5":16822,"_23744":88305,"_7301":88391},[45942],"In case the RC (Release Candidate) is rejected via the vote, you will have to repeat the above process and re-initiate the vote for the next RC (RC0, RC1, etc.).",{"_11930":260,"_45438":224,"_17286":88393,"_5":16822,"_23744":88309,"_7301":88394},[45942],"Once voting is successful (say for RC1), copy artifacts to https://dist.apache.org/repos/dist/release/phoenix:",{"_11930":261,"_45438":224,"_17286":88396,"_5":16822,"_23744":88309,"_7301":88397},[45942],"Set release tag and commit:",{"_11930":262,"_45438":224,"_17286":88399,"_5":16822,"_23744":88309,"_7301":88400},[45942],"Remove any obsolete releases on https://dist.apache.org/repos/dist/release/phoenix given the current release.",{"_11930":263,"_45438":224,"_17286":88402,"_5":16822,"_23744":88309,"_7301":88403},[45942],"Go to https://repository.apache.org/#stagingRepositories and release the staged artifacts (this takes a while so you may need to refresh multiple times).",{"_11930":264,"_45438":224,"_17286":88405,"_5":16822,"_23744":88309,"_7301":88406},[45942],"Create new branch based on current release if needed, for ex: 4.15 branches in this case.",{"_11930":265,"_45438":224,"_17286":88408,"_5":16822,"_23744":88309,"_7301":88409},[45942],"Set version to the upcoming SNAPSHOT and commit:",{"_11930":266,"_45438":224,"_17286":88411,"_5":16822,"_23744":88309,"_7301":88412},[45942],"If releasing Phoenix (core) Create a JIRA to update PHOENIX_MAJOR_VERSION, PHOENIX_MINOR_VERSION and PHOENIX_PATCH_NUMBER in MetaDataProtocol.java appropriately to next version (4, 16, 0 respectively in this case) and compatible_client_versions.json file with the client versions that are compatible against the next version (in this case 4.14.3 and 4.15.0 would be the backward compatible clients for 4.16.0). This JIRA should be committed/marked with fixVersion of the next release candidate.",{"_11930":267,"_45438":224,"_17286":88414,"_5":16822,"_23744":88309,"_7301":88415},[45942],"Add documentation of released version to the downloads page and wiki.",{"_11930":268,"_45438":224,"_17286":88417,"_5":16822,"_23744":88309,"_7301":88418},[45942],"Update the Apache Committee Report Helper DB",{"_11930":269,"_45438":224,"_17286":88420,"_5":16822,"_23744":88309,"_7301":88421},[45942],"Send out an announcement email. See example here.",{"_11930":270,"_45438":224,"_17286":88423,"_5":16822,"_23744":88309,"_7301":88424},[45942],"Bulk close JIRAs that were marked for the release fixVersion.",{"_11930":271,"_45438":224,"_17286":88426,"_5":16822,"_23744":88309,"_7301":88427},[45942],"Congratulations!",{"_11930":272,"_45438":272,"_5":12359,"_7301":87799,"_45913":88429,"_17286":88430,"_23744":272},[87622,87623,87624,87799],[45942],{"_11930":273,"_45438":272,"_17286":88432,"_5":16822,"_23744":272,"_7301":88433},[45942],"Contribution workflow for Apache Phoenix, including JIRA, patch/PR submission, and committer practices.",{"_11930":274,"_45438":272,"_5":45910,"_17286":88435,"_23744":88436,"_7301":88437},[45942],"/docs/contributing#general-process","General process",{"_11930":275,"_45438":272,"_5":45910,"_17286":88439,"_23744":88440,"_7301":88441},[45942],"/docs/contributing#discuss-on-the-mailing-list","Discuss on the mailing list",{"_11930":276,"_45438":272,"_5":45910,"_17286":88443,"_23744":88444,"_7301":88445},[45942],"/docs/contributing#log-a-jira-ticket","Log a JIRA ticket",{"_11930":277,"_45438":272,"_5":45910,"_17286":88447,"_23744":88448,"_7301":88449},[45942],"/docs/contributing#setup-development-environment","Setup development environment",{"_11930":278,"_45438":272,"_5":45910,"_17286":88451,"_23744":88452,"_7301":88453},[45942],"/docs/contributing#generate-a-patch","Generate a patch",{"_11930":279,"_45438":272,"_5":45910,"_17286":88455,"_23744":88456,"_7301":88457},[45942],"/docs/contributing#naming-convention-for-the-patch","Naming convention for the patch",{"_11930":280,"_45438":272,"_5":45910,"_17286":88459,"_23744":88460,"_7301":88461},[45942],"/docs/contributing#github-workflow","GitHub workflow",{"_11930":281,"_45438":272,"_5":45910,"_17286":88463,"_23744":88464,"_7301":88465},[45942],"/docs/contributing#local-git-workflow","Local Git workflow",{"_11930":282,"_45438":272,"_5":45910,"_17286":88467,"_23744":88468,"_7301":88469},[45942],"/docs/contributing#code-conventions","Code conventions",{"_11930":283,"_45438":272,"_5":45910,"_17286":88471,"_23744":88472,"_7301":88473},[45942],"/docs/contributing#committer-workflow","Committer workflow",{"_11930":284,"_45438":272,"_17286":88475,"_5":16822,"_23744":88436,"_7301":88476},[45942],"The general process for contributing code to Phoenix works as follows:",{"_11930":285,"_45438":272,"_17286":88478,"_5":16822,"_23744":88436,"_7301":88479},[45942],"Discuss your changes on the dev mailing list",{"_11930":286,"_45438":272,"_17286":88481,"_5":16822,"_23744":88436,"_7301":88482},[45942],"Create a JIRA issue unless there already is one",{"_11930":287,"_45438":272,"_17286":88484,"_5":16822,"_23744":88436,"_7301":87988},[45942],{"_11930":288,"_45438":272,"_17286":88486,"_5":16822,"_23744":88436,"_7301":88487},[45942],"Prepare a patch containing your changes",{"_11930":289,"_45438":272,"_17286":88489,"_5":16822,"_23744":88436,"_7301":88490},[45942],"Submit the patch",{"_11930":290,"_45438":272,"_17286":88492,"_5":16822,"_23744":88436,"_7301":88493},[45942],"These steps are explained in greater detail below.",{"_11930":291,"_45438":272,"_17286":88495,"_5":16822,"_23744":88436,"_7301":88496},[45942],"Note that the instructions below are for the main Phoenix project.\nUse the corresponding repository for the other subprojects.\nTephra and Omid also have their own JIRA projects.",{"_11930":292,"_45438":272,"_17286":88498,"_5":16822,"_23744":88440,"_7301":88499},[45942],"It's often best to discuss a change on the public mailing lists before creating and submitting a patch.",{"_11930":293,"_45438":272,"_17286":88501,"_5":16822,"_23744":88440,"_7301":88502},[45942],"If you're unsure whether certain behavior in Phoenix is a bug, please send a mail to the user mailing list to check.",{"_11930":294,"_45438":272,"_17286":88504,"_5":16822,"_23744":88440,"_7301":88505},[45942],"If you're considering adding major new functionality to Phoenix, it's a good idea to first discuss the idea on the developer mailing list to make sure that your plans are in line with others in the Phoenix community.",{"_11930":295,"_45438":272,"_17286":88507,"_5":16822,"_23744":88444,"_7301":88508},[45942],"The first step is to create a ticket on the Phoenix JIRA.",{"_11930":296,"_45438":272,"_17286":88510,"_5":16822,"_23744":88448,"_7301":88511},[45942],"To set up your development environment, see these directions.",{"_11930":297,"_45438":272,"_17286":88513,"_5":16822,"_23744":88452,"_7301":88514},[45942],"There are two general approaches for creating and submitting a patch: GitHub pull requests, or manual patch creation with Git. Both are explained below. Please make sure that the patch applies cleanly on all active branches, including master and the unified 4.x branch.",{"_11930":298,"_45438":272,"_17286":88516,"_5":16822,"_23744":88452,"_7301":88517},[45942],"Regardless of which approach is taken, please make sure to follow the Phoenix code conventions (more information below). Whenever possible, unit tests or integration tests should be included with patches.",{"_11930":299,"_45438":272,"_17286":88519,"_5":16822,"_23744":88452,"_7301":88520},[45942],"Please make sure that the patch contains only one commit, then click the \"Submit patch\" button to automatically trigger tests on the patch.",{"_11930":300,"_45438":272,"_17286":88522,"_5":16822,"_23744":88452,"_7301":88523},[45942],"The commit message should reference the JIRA ticket issue (which has the format\nPHOENIX-{NUMBER}:{JIRA-TITLE}).",{"_11930":301,"_45438":272,"_17286":88525,"_5":16822,"_23744":88452,"_7301":88526},[45942],"To effectively get the patch reviewed, please raise the pull request against an appropriate branch.",{"_11930":302,"_45438":272,"_17286":88528,"_5":16822,"_23744":88456,"_7301":88529},[45942],"When generating a patch, make sure the patch name uses the following format:\nPHOENIX-{NUMBER}.{BRANCH-NAME}.{VERSION}.patch",{"_11930":303,"_45438":272,"_17286":88531,"_5":16822,"_23744":88456,"_7301":88532},[45942],"Examples: PHOENIX-4872.master.v1.patch, PHOENIX-4872.master.v2.patch, PHOENIX-4872.4.x-HBase-1.3.v1.patch, etc.",{"_11930":304,"_45438":272,"_17286":88534,"_5":16822,"_23744":88460,"_7301":88535},[45942],"Create a pull request in GitHub for the mirror of the Phoenix Git repository.",{"_11930":305,"_45438":272,"_17286":88537,"_5":16822,"_23744":88460,"_7301":88538},[45942],"Generate a patch and attach it to JIRA so Hadoop QA runs automated tests.",{"_11930":306,"_45438":272,"_17286":88540,"_5":16822,"_23744":88460,"_7301":88541},[45942],"If you update the PR, generate a new patch with a different name so patch changes are detected and tests run for the new patch.",{"_11930":307,"_45438":272,"_17286":88543,"_5":16822,"_23744":88464,"_7301":88544},[45942],"Create a local branch:",{"_11930":308,"_45438":272,"_17286":88546,"_5":16822,"_23744":88464,"_7301":88547},[45942],"Make and commit changes",{"_11930":309,"_45438":272,"_17286":88549,"_5":16822,"_23744":88464,"_7301":88550},[45942],"Generate a patch based on the JIRA issue number:",{"_11930":310,"_45438":272,"_17286":88552,"_5":16822,"_23744":88464,"_7301":88553},[45942],"Attach the created patch file to the JIRA ticket.",{"_11930":311,"_45438":272,"_17286":88555,"_5":16822,"_23744":88468,"_7301":88556},[45942],"The Phoenix code conventions are similar to the Sun/Oracle Java Code Convention. We use 4 spaces (no tabs) for indentation and limit lines to 100 characters.",{"_11930":312,"_45438":272,"_17286":88558,"_5":16822,"_23744":88468,"_7301":88559},[45942],"Eclipse code formatting settings and import order settings (which can also be imported into Intellij IDEA) are available in the dev directory of the Phoenix codebase.",{"_11930":313,"_45438":272,"_17286":88561,"_5":16822,"_23744":88468,"_7301":88562},[45942],"All new source files should include the Apache license header.",{"_11930":314,"_45438":272,"_17286":88564,"_5":16822,"_23744":88472,"_7301":88565},[45942],"In general, the \"rebase\" workflow should be used with the Phoenix codebase (see this blog post for more information on the difference between \"merge\" and \"rebase\" workflows in Git).",{"_11930":315,"_45438":272,"_17286":88567,"_5":16822,"_23744":88472,"_7301":88568},[45942],"A patch file can be downloaded from a GitHub pull request by adding .patch to the end of the pull request URL, for example: https://github.com/apache/phoenix/pull/35.patch.",{"_11930":316,"_45438":272,"_17286":88570,"_5":16822,"_23744":88472,"_7301":88571},[45942],"When applying a user-contributed patch, use git am when a fully formatted patch file is available, as this preserves contributor contact information. Otherwise, add the contributor's name to the commit message.",{"_11930":317,"_45438":272,"_17286":88573,"_5":16822,"_23744":88472,"_7301":88574},[45942],"If a single ticket consists of a patch with multiple commits, the commits can be squashed into a single commit using git rebase.",{"_11930":318,"_45438":318,"_5":12359,"_7301":88576,"_45913":88577,"_17286":88578,"_23744":318},"Data Types",[87622,87623,87736],[45942],{"_11930":319,"_45438":318,"_17286":88580,"_5":16822,"_23744":318,"_7301":88581},[45942],"SQL data type reference for Apache Phoenix.",{"_11930":320,"_45438":318,"_5":45910,"_17286":88583,"_23744":88584,"_7301":88576},[45942],"/docs/datatypes#data-types",{"_11930":321,"_45438":318,"_5":45910,"_17286":88586,"_23744":88587,"_7301":88588},[45942],"/docs/datatypes#integer-type","INTEGER Type",{"_11930":322,"_45438":318,"_5":45910,"_17286":88590,"_23744":88591,"_7301":88592},[45942],"/docs/datatypes#unsigned_int-type","UNSIGNED_INT Type",{"_11930":323,"_45438":318,"_5":45910,"_17286":88594,"_23744":88595,"_7301":88596},[45942],"/docs/datatypes#bigint-type","BIGINT Type",{"_11930":324,"_45438":318,"_5":45910,"_17286":88598,"_23744":88599,"_7301":88600},[45942],"/docs/datatypes#unsigned_long-type","UNSIGNED_LONG Type",{"_11930":325,"_45438":318,"_5":45910,"_17286":88602,"_23744":88603,"_7301":88604},[45942],"/docs/datatypes#tinyint-type","TINYINT Type",{"_11930":326,"_45438":318,"_5":45910,"_17286":88606,"_23744":88607,"_7301":88608},[45942],"/docs/datatypes#unsigned_tinyint-type","UNSIGNED_TINYINT Type",{"_11930":327,"_45438":318,"_5":45910,"_17286":88610,"_23744":88611,"_7301":88612},[45942],"/docs/datatypes#smallint-type","SMALLINT Type",{"_11930":328,"_45438":318,"_5":45910,"_17286":88614,"_23744":88615,"_7301":88616},[45942],"/docs/datatypes#unsigned_smallint-type","UNSIGNED_SMALLINT Type",{"_11930":329,"_45438":318,"_5":45910,"_17286":88618,"_23744":88619,"_7301":88620},[45942],"/docs/datatypes#float-type","FLOAT Type",{"_11930":330,"_45438":318,"_5":45910,"_17286":88622,"_23744":88623,"_7301":88624},[45942],"/docs/datatypes#unsigned_float-type","UNSIGNED_FLOAT Type",{"_11930":331,"_45438":318,"_5":45910,"_17286":88626,"_23744":88627,"_7301":88628},[45942],"/docs/datatypes#double-type","DOUBLE Type",{"_11930":332,"_45438":318,"_5":45910,"_17286":88630,"_23744":88631,"_7301":88632},[45942],"/docs/datatypes#unsigned_double-type","UNSIGNED_DOUBLE Type",{"_11930":333,"_45438":318,"_5":45910,"_17286":88634,"_23744":88635,"_7301":88636},[45942],"/docs/datatypes#decimal-type","DECIMAL Type",{"_11930":334,"_45438":318,"_5":45910,"_17286":88638,"_23744":88639,"_7301":88640},[45942],"/docs/datatypes#boolean-type","BOOLEAN Type",{"_11930":335,"_45438":318,"_5":45910,"_17286":88642,"_23744":88643,"_7301":88644},[45942],"/docs/datatypes#time-type","TIME Type",{"_11930":336,"_45438":318,"_5":45910,"_17286":88646,"_23744":88647,"_7301":88648},[45942],"/docs/datatypes#date-type","DATE Type",{"_11930":337,"_45438":318,"_5":45910,"_17286":88650,"_23744":88651,"_7301":88652},[45942],"/docs/datatypes#timestamp-type","TIMESTAMP Type",{"_11930":338,"_45438":318,"_5":45910,"_17286":88654,"_23744":88655,"_7301":88656},[45942],"/docs/datatypes#unsigned_time-type","UNSIGNED_TIME Type",{"_11930":339,"_45438":318,"_5":45910,"_17286":88658,"_23744":88659,"_7301":88660},[45942],"/docs/datatypes#unsigned_date-type","UNSIGNED_DATE Type",{"_11930":340,"_45438":318,"_5":45910,"_17286":88662,"_23744":88663,"_7301":88664},[45942],"/docs/datatypes#unsigned_timestamp-type","UNSIGNED_TIMESTAMP Type",{"_11930":341,"_45438":318,"_5":45910,"_17286":88666,"_23744":88667,"_7301":88668},[45942],"/docs/datatypes#varchar-type","VARCHAR Type",{"_11930":342,"_45438":318,"_5":45910,"_17286":88670,"_23744":88671,"_7301":88672},[45942],"/docs/datatypes#char-type","CHAR Type",{"_11930":343,"_45438":318,"_5":45910,"_17286":88674,"_23744":88675,"_7301":88676},[45942],"/docs/datatypes#binary-type","BINARY Type",{"_11930":344,"_45438":318,"_5":45910,"_17286":88678,"_23744":88679,"_7301":88680},[45942],"/docs/datatypes#varbinary-type","VARBINARY Type",{"_11930":345,"_45438":318,"_5":45910,"_17286":88682,"_23744":88683,"_7301":88684},[45942],"/docs/datatypes#varbinary_encoded-type","VARBINARY_ENCODED Type",{"_11930":346,"_45438":318,"_5":45910,"_17286":88686,"_23744":88687,"_7301":88688},[45942],"/docs/datatypes#array","ARRAY",{"_11930":347,"_45438":318,"_5":45910,"_17286":88690,"_23744":88691,"_7301":88692},[45942],"/docs/datatypes#bson-type","BSON Type",{"_11930":348,"_45438":318,"_17286":88694,"_5":16822,"_23744":88587,"_7301":88695},[45942],"Possible values: -2147483648 to 2147483647.",{"_11930":349,"_45438":318,"_17286":88697,"_5":16822,"_23744":88587,"_7301":88698},[45942],"Mapped to java.lang.Integer. The binary representation is a 4 byte integer with the sign bit flipped (so that negative values sorts before positive values).",{"_11930":350,"_45438":318,"_17286":88700,"_5":16822,"_23744":88587,"_7301":88701},[45942],"Example",{"_11930":351,"_45438":318,"_17286":88703,"_5":16822,"_23744":88591,"_7301":88704},[45942],"Possible values: 0 to 2147483647. Mapped to java.lang.Integer. The binary representation is a 4 byte integer, matching the Bytes.toBytes(int) method. The purpose of this type is to map to existing HBase data that was serialized using this HBase utility method. If that is not the case, use the regular signed type instead.",{"_11930":352,"_45438":318,"_17286":88706,"_5":16822,"_23744":88591,"_7301":88701},[45942],{"_11930":353,"_45438":318,"_17286":88708,"_5":16822,"_23744":88595,"_7301":88709},[45942],"Possible values: -9223372036854775808 to 9223372036854775807. Mapped to java.lang.Long. The binary representation is an 8 byte long with the sign bit flipped (so that negative values sorts before positive values).",{"_11930":354,"_45438":318,"_17286":88711,"_5":16822,"_23744":88595,"_7301":88701},[45942],{"_11930":355,"_45438":318,"_17286":88713,"_5":16822,"_23744":88599,"_7301":88714},[45942],"Possible values: 0 to 9223372036854775807. Mapped to java.lang.Long. The binary representation is an 8 byte integer, matching the Bytes.toBytes(long) method. The purpose of this type is to map to existing HBase data that was serialized using this HBase utility method. If that is not the case, use the regular signed type instead.",{"_11930":356,"_45438":318,"_17286":88716,"_5":16822,"_23744":88599,"_7301":88701},[45942],{"_11930":357,"_45438":318,"_17286":88718,"_5":16822,"_23744":88603,"_7301":88719},[45942],"Possible values: -128 to 127. Mapped to java.lang.Byte. The binary representation is a single byte, with the sign bit flipped (so that negative values sorts before positive values).",{"_11930":358,"_45438":318,"_17286":88721,"_5":16822,"_23744":88603,"_7301":88701},[45942],{"_11930":359,"_45438":318,"_17286":88723,"_5":16822,"_23744":88607,"_7301":88724},[45942],"Possible values: 0 to 127. Mapped to java.lang.Byte. The binary representation is a single byte, matching the Bytes.toBytes(byte) method. The purpose of this type is to map to existing HBase data that was serialized using this HBase utility method. If that is not the case, use the regular signed type instead.",{"_11930":360,"_45438":318,"_17286":88726,"_5":16822,"_23744":88607,"_7301":88701},[45942],{"_11930":361,"_45438":318,"_17286":88728,"_5":16822,"_23744":88611,"_7301":88729},[45942],"Possible values: -32768 to 32767. Mapped to java.lang.Short. The binary representation is a 2 byte short with the sign bit flipped (so that negative values sort before positive values).",{"_11930":362,"_45438":318,"_17286":88731,"_5":16822,"_23744":88611,"_7301":88701},[45942],{"_11930":363,"_45438":318,"_17286":88733,"_5":16822,"_23744":88615,"_7301":88734},[45942],"Possible values: 0 to 32767. Mapped to java.lang.Short. The binary representation is an 2 byte integer, matching the Bytes.toBytes(short) method. The purpose of this type is to map to existing HBase data that was serialized using this HBase utility method. If that is not the case, use the regular signed type instead.",{"_11930":364,"_45438":318,"_17286":88736,"_5":16822,"_23744":88615,"_7301":88701},[45942],{"_11930":365,"_45438":318,"_17286":88738,"_5":16822,"_23744":88619,"_7301":88739},[45942],"Possible values: -3.402823466 E + 38 to 3.402823466 E + 38. Mapped to java.lang.Float. The binary representation is an 4 byte float with the sign bit flipped (so that negative values sort before positive values).",{"_11930":366,"_45438":318,"_17286":88741,"_5":16822,"_23744":88619,"_7301":88701},[45942],{"_11930":367,"_45438":318,"_17286":88743,"_5":16822,"_23744":88623,"_7301":88744},[45942],"Possible values: 0 to 3.402823466 E + 38. Mapped to java.lang.Float. The binary representation is an 4 byte float matching the Bytes.toBytes(float) method. The purpose of this type is to map to existing HBase data that was serialized using this HBase utility method. If that is not the case, use the regular signed type instead.",{"_11930":368,"_45438":318,"_17286":88746,"_5":16822,"_23744":88623,"_7301":88701},[45942],{"_11930":369,"_45438":318,"_17286":88748,"_5":16822,"_23744":88627,"_7301":88749},[45942],"Possible values: -1.7976931348623158 E + 308 to 1.7976931348623158 E + 308. Mapped to java.lang.Double. The binary representation is an 8 byte double with the sign bit flipped (so that negative values sort before positive value).",{"_11930":370,"_45438":318,"_17286":88751,"_5":16822,"_23744":88627,"_7301":88701},[45942],{"_11930":371,"_45438":318,"_17286":88753,"_5":16822,"_23744":88631,"_7301":88754},[45942],"Possible values: 0 to  1.7976931348623158 E + 308. Mapped to java.lang.Double. The binary representation is an 8 byte double matching the Bytes.toBytes(double) method. The purpose of this type is to map to existing HBase data that was serialized using this HBase utility method. If that is not the case, use the regular signed type instead.",{"_11930":372,"_45438":318,"_17286":88756,"_5":16822,"_23744":88631,"_7301":88701},[45942],{"_11930":373,"_45438":318,"_17286":88758,"_5":16822,"_23744":88635,"_7301":88759},[45942],"Data type with fixed precision and scale. A user can specify precision and scale by expression DECIMAL(precision,scale) in a DDL statement, for example, DECIMAL(10,2). The maximum precision is 38 digits. Mapped to java.math.BigDecimal. The binary representation is binary comparable, variable length format. When used in a row key, it is terminated with a null byte unless it is the last column.",{"_11930":374,"_45438":318,"_17286":88761,"_5":16822,"_23744":88635,"_7301":88701},[45942],{"_11930":375,"_45438":318,"_17286":88763,"_5":16822,"_23744":88639,"_7301":88764},[45942],"Possible values: TRUE and FALSE.",{"_11930":376,"_45438":318,"_17286":88766,"_5":16822,"_23744":88639,"_7301":88767},[45942],"Mapped to java.lang.Boolean. The binary representation is a single byte with 0 for false and 1 for true",{"_11930":377,"_45438":318,"_17286":88769,"_5":16822,"_23744":88639,"_7301":88701},[45942],{"_11930":378,"_45438":318,"_17286":88771,"_5":16822,"_23744":88643,"_7301":88772},[45942],"The time data type. The format is yyyy-MM-dd hh:mm:ss, with both the date and time parts maintained. Mapped to java.sql.Time. The binary representation is an 8 byte long (the number of milliseconds from the epoch), making it possible (although not necessarily recommended) to store more information within a TIME column than what is provided by \"java.sql.Time\". Note that the internal representation is based on a number of milliseconds since the epoch (which is based on a time in GMT), while \"java.sql.Time\" will format times based on the client's local time zone. Please note that this TIME type is different than the TIME type as defined by the SQL 92 standard in that it includes year, month, and day components. As such, it is not in compliance with the JDBC APIs. As the underlying data is still stored as a long, only the presentation of the value is incorrect.",{"_11930":379,"_45438":318,"_17286":88774,"_5":16822,"_23744":88643,"_7301":88701},[45942],{"_11930":380,"_45438":318,"_17286":88776,"_5":16822,"_23744":88647,"_7301":88777},[45942],"The date data type. The format is yyyy-MM-dd hh:mm:ss, with both the date and time parts maintained to a millisecond accuracy. Mapped to java.sql.Date. The binary representation is an 8 byte long (the number of milliseconds from the epoch), making it possible (although not necessarily recommended) to store more information within a DATE column than what is provided by \"java.sql.Date\". Note that the internal representation is based on a number of milliseconds since the epoch (which is based on a time in GMT), while \"java.sql.Date\" will format dates based on the client's local time zone. Please note that this DATE type is different than the DATE type as defined by the SQL 92 standard in that it includes a time component. As such, it is not in compliance with the JDBC APIs. As the underlying data is still stored as a long, only the presentation of the value is incorrect.",{"_11930":381,"_45438":318,"_17286":88779,"_5":16822,"_23744":88647,"_7301":88701},[45942],{"_11930":382,"_45438":318,"_17286":88781,"_5":16822,"_23744":88651,"_7301":88782},[45942],"The timestamp data type. The format is yyyy-MM-dd hh:mm:ss[.nnnnnnnnn]. Mapped to java.sql.Timestamp with an internal representation of the number of nanos from the epoch. The binary representation is 12 bytes: an 8 byte long for the epoch time plus a 4 byte integer for the nanos. Note that the internal representation is based on a number of milliseconds since the epoch (which is based on a time in GMT), while \"java.sql.Timestamp\" will format timestamps based on the client's local time zone.",{"_11930":383,"_45438":318,"_17286":88784,"_5":16822,"_23744":88651,"_7301":88701},[45942],{"_11930":384,"_45438":318,"_17286":88786,"_5":16822,"_23744":88655,"_7301":88787},[45942],"The unsigned time data type. The format is yyyy-MM-dd hh:mm:ss, with both the date and time parts maintained to the millisecond accuracy. Mapped to java.sql.Time. The binary representation is an 8 byte long (the number of milliseconds from the epoch) matching the HBase.toBytes(long) method. The purpose of this type is to map to existing HBase data that was serialized using this HBase utility method. If that is not the case, use the regular signed type instead.",{"_11930":385,"_45438":318,"_17286":88789,"_5":16822,"_23744":88655,"_7301":88701},[45942],{"_11930":386,"_45438":318,"_17286":88791,"_5":16822,"_23744":88659,"_7301":88792},[45942],"The unsigned date data type. The format is yyyy-MM-dd hh:mm:ss, with both the date and time parts maintained to a millisecond accuracy. Mapped to java.sql.Date. The binary representation is an 8 byte long (the number of milliseconds from the epoch) matching the HBase.toBytes(long) method. The purpose of this type is to map to existing HBase data that was serialized using this HBase utility method. If that is not the case, use the regular signed type instead.",{"_11930":387,"_45438":318,"_17286":88794,"_5":16822,"_23744":88659,"_7301":88701},[45942],{"_11930":388,"_45438":318,"_17286":88796,"_5":16822,"_23744":88663,"_7301":88797},[45942],"The timestamp data type. The format is yyyy-MM-dd hh:mm:ss[.nnnnnnnnn]. Mapped to java.sql.Timestamp with an internal representation of the number of nanos from the epoch. The binary representation is 12 bytes: an 8 byte long for the epoch time plus a 4 byte integer for the nanos with the long serialized through the HBase.toBytes(long) method. The purpose of this type is to map to existing HBase data that was serialized using this HBase utility method. If that is not the case, use the regular signed type instead.",{"_11930":389,"_45438":318,"_17286":88799,"_5":16822,"_23744":88663,"_7301":88701},[45942],{"_11930":390,"_45438":318,"_17286":88801,"_5":16822,"_23744":88667,"_7301":88802},[45942],"A variable length String with an optional max byte length. The binary representation is UTF8 matching the Bytes.toBytes(String) method. When used in a row key, it is terminated with a null byte unless it is the last column.",{"_11930":391,"_45438":318,"_17286":88804,"_5":16822,"_23744":88667,"_7301":88805},[45942],"Mapped to java.lang.String.",{"_11930":392,"_45438":318,"_17286":88807,"_5":16822,"_23744":88667,"_7301":88701},[45942],{"_11930":393,"_45438":318,"_17286":88809,"_5":16822,"_23744":88671,"_7301":88810},[45942],"A fixed length String with single-byte characters. The binary representation is UTF8 matching the Bytes.toBytes(String) method.",{"_11930":394,"_45438":318,"_17286":88812,"_5":16822,"_23744":88671,"_7301":88805},[45942],{"_11930":395,"_45438":318,"_17286":88814,"_5":16822,"_23744":88671,"_7301":88701},[45942],{"_11930":396,"_45438":318,"_17286":88816,"_5":16822,"_23744":88675,"_7301":88817},[45942],"Raw fixed length byte array.",{"_11930":397,"_45438":318,"_17286":88819,"_5":16822,"_23744":88675,"_7301":88820},[45942],"Mapped to byte[].",{"_11930":398,"_45438":318,"_17286":88822,"_5":16822,"_23744":88675,"_7301":88701},[45942],{"_11930":399,"_45438":318,"_17286":88824,"_5":16822,"_23744":88679,"_7301":88825},[45942],"Raw variable length byte array.",{"_11930":400,"_45438":318,"_17286":88827,"_5":16822,"_23744":88679,"_7301":88820},[45942],{"_11930":401,"_45438":318,"_17286":88829,"_5":16822,"_23744":88679,"_7301":88701},[45942],{"_11930":402,"_45438":318,"_17286":88831,"_5":16822,"_23744":88683,"_7301":88832},[45942],"Variable length byte array that escapes embedded 0x00 bytes so its sort order matches the lexicographic order of the original bytes. Use it anywhere ordering matters: a non-trailing column of a composite primary key, an index key, or a row value constructor over binary data.",{"_11930":403,"_45438":318,"_17286":88834,"_5":16822,"_23744":88683,"_7301":88835},[45942],"Mapped to byte[]. See VARBINARY_ENCODED for details.",{"_11930":404,"_45438":318,"_17286":88837,"_5":16822,"_23744":88683,"_7301":88701},[45942],{"_11930":405,"_45438":318,"_17286":88839,"_5":16822,"_23744":88687,"_7301":88840},[45942],"Mapped to java.sql.Array. Every primitive type except for VARBINARY may be declared as an ARRAY. Only single dimensional arrays are supported.",{"_11930":406,"_45438":318,"_17286":88842,"_5":16822,"_23744":88687,"_7301":88701},[45942],{"_11930":407,"_45438":318,"_17286":88844,"_5":16822,"_23744":88691,"_7301":88845},[45942],"Native binary JSON document column for schemaless data. Phoenix can read individual fields with BSON_VALUE, filter rows with BSON_CONDITION_EXPRESSION, and atomically update fields with BSON_UPDATE_EXPRESSION — all evaluated server-side.",{"_11930":408,"_45438":318,"_17286":88847,"_5":16822,"_23744":88691,"_7301":88848},[45942],"Stored as BSON bytes; returned as org.bson.RawBsonDocument. See Document Data: BSON for details.",{"_11930":409,"_45438":318,"_17286":88850,"_5":16822,"_23744":88691,"_7301":88701},[45942],{"_11930":410,"_45438":410,"_5":12359,"_7301":88852,"_45913":88853,"_17286":88854,"_23744":410},"Explain Plan",[87622,87623,87736],[45942],{"_11930":411,"_45438":410,"_17286":88856,"_5":16822,"_23744":410,"_7301":88857},[45942],"How to read and use EXPLAIN plans in Apache Phoenix.",{"_11930":412,"_45438":410,"_5":45910,"_17286":88859,"_23744":88860,"_7301":88852},[45942],"/docs/explain-plan#explain-plan-overview",{"_11930":413,"_45438":410,"_5":45910,"_17286":88862,"_23744":88863,"_7301":88864},[45942],"/docs/explain-plan#anatomy-of-an-explain-plan","Anatomy of an Explain Plan",{"_11930":414,"_45438":410,"_5":45910,"_17286":88866,"_23744":88867,"_7301":88701},[45942],"/docs/explain-plan#explain-plan-example",{"_11930":415,"_45438":410,"_5":45910,"_17286":88869,"_23744":88870,"_7301":88871},[45942],"/docs/explain-plan#jdbc-explain-plan-api-and-estimates","JDBC Explain Plan API and Estimates",{"_11930":416,"_45438":410,"_17286":88873,"_5":16822,"_23744":88860,"_7301":88874},[45942],"An EXPLAIN plan tells you a lot about how a query will be run:",{"_11930":417,"_45438":410,"_17286":88876,"_5":16822,"_23744":88860,"_7301":88877},[45942],"All the HBase range queries that will be executed",{"_11930":418,"_45438":410,"_17286":88879,"_5":16822,"_23744":88860,"_7301":88880},[45942],"An estimate of the number of bytes that will be scanned",{"_11930":419,"_45438":410,"_17286":88882,"_5":16822,"_23744":88860,"_7301":88883},[45942],"An estimate of the number of rows that will be traversed",{"_11930":420,"_45438":410,"_17286":88885,"_5":16822,"_23744":88860,"_7301":88886},[45942],"Time at which the above estimate information was collected",{"_11930":421,"_45438":410,"_17286":88888,"_5":16822,"_23744":88860,"_7301":88889},[45942],"Which HBase table will be used for each scan",{"_11930":422,"_45438":410,"_17286":88891,"_5":16822,"_23744":88860,"_7301":88892},[45942],"Which operations (sort, merge, scan, limit) are executed on the client versus the server",{"_11930":423,"_45438":410,"_17286":88894,"_5":16822,"_23744":88860,"_7301":88895},[45942],"Use an EXPLAIN plan to check how a query will run, and consider rewriting queries to meet the following goals:",{"_11930":424,"_45438":410,"_17286":88897,"_5":16822,"_23744":88860,"_7301":88898},[45942],"Emphasize operations on the server rather than the client. Server operations are distributed across the cluster and operate in parallel, while client operations execute within the single client JDBC driver.",{"_11930":425,"_45438":410,"_17286":88900,"_5":16822,"_23744":88860,"_7301":88901},[45942],"Use RANGE SCAN or SKIP SCAN whenever possible rather than TABLE SCAN.",{"_11930":426,"_45438":410,"_17286":88903,"_5":16822,"_23744":88860,"_7301":88904},[45942],"Filter against leading columns in the primary key constraint. This assumes you have designed the primary key to lead with frequently-accessed or frequently-filtered columns as described in “Primary Keys,” above.",{"_11930":427,"_45438":410,"_17286":88906,"_5":16822,"_23744":88860,"_7301":88907},[45942],"If necessary, introduce a local index or a global index that covers your query.",{"_11930":428,"_45438":410,"_17286":88909,"_5":16822,"_23744":88860,"_7301":88910},[45942],"If you have an index that covers your query but the optimizer is not detecting it, try hinting the query:\nSELECT /*+ INDEX() */ …",{"_11930":429,"_45438":410,"_17286":88912,"_5":16822,"_23744":88860,"_7301":88913},[45942],"See also: SQL Language Reference - EXPLAIN",{"_11930":430,"_45438":410,"_17286":88915,"_5":16822,"_23744":88863,"_7301":88916},[45942],"An explain plan consists of lines of text that describe operations that Phoenix will perform during a query, using the following terms:",{"_11930":431,"_45438":410,"_17286":88918,"_5":16822,"_23744":88863,"_7301":88919},[45942],"AGGREGATE INTO ORDERED DISTINCT ROWS — aggregates the returned rows using an operation such as addition. When ORDERED is used, the GROUP BY operation is applied to the leading part of the primary key constraint, which allows the aggregation to be done in place rather than keeping all distinct groups in memory on the server side.",{"_11930":432,"_45438":410,"_17286":88921,"_5":16822,"_23744":88863,"_7301":88922},[45942],"AGGREGATE INTO SINGLE ROW — aggregates the results into a single row using an aggregate function with no GROUP BY clause. For example, the count() statement returns one row with the total number of rows that match the query.",{"_11930":433,"_45438":410,"_17286":88924,"_5":16822,"_23744":88863,"_7301":88925},[45942],"CLIENT — the operation will be performed on the client side. It's faster to perform most operations on the server side, so you should consider whether there's a way to rewrite the query to give the server more of the work to do.",{"_11930":434,"_45438":410,"_17286":88927,"_5":16822,"_23744":88863,"_7301":88928},[45942],"FILTER BY expression—returns only results that match the expression.",{"_11930":435,"_45438":410,"_17286":88930,"_5":16822,"_23744":88863,"_7301":88931},[45942],"FULL SCAN OVER tableName—the operation will scan every row in the specified table.",{"_11930":436,"_45438":410,"_17286":88933,"_5":16822,"_23744":88863,"_7301":88934},[45942],"INNER-JOIN — the operation will join multiple tables on rows where the join condition is met.",{"_11930":437,"_45438":410,"_17286":88936,"_5":16822,"_23744":88863,"_7301":88937},[45942],"MERGE SORT — performs a merge sort on the results.",{"_11930":438,"_45438":410,"_17286":88939,"_5":16822,"_23744":88863,"_7301":88940},[45942],"RANGE SCAN OVER tableName [ ... ] — The information in the square brackets indicates the start and stop for each primary key that's used in the query.",{"_11930":439,"_45438":410,"_17286":88942,"_5":16822,"_23744":88863,"_7301":88943},[45942],"ROUND ROBIN — when the query doesn't contain ORDER BY and therefore the rows can be returned in any order, ROUND ROBIN order maximizes parallelization on the client side.",{"_11930":440,"_45438":410,"_17286":88945,"_5":16822,"_23744":88863,"_7301":88946},[45942],"<x>-CHUNK — describes how many threads will be used for the operation. The maximum parallelism is limited to the number of threads in the thread pool. The minimum parallelization corresponds to the number of regions the table has between the start and stop rows of the scan. The number of chunks will increase with a lower guidepost width, as there is more than one chunk per region.",{"_11930":441,"_45438":410,"_17286":88948,"_5":16822,"_23744":88863,"_7301":88949},[45942],"PARALLEL <x>-WAY — describes how many parallel scans will be merge sorted during the operation.",{"_11930":442,"_45438":410,"_17286":88951,"_5":16822,"_23744":88863,"_7301":88952},[45942],"SERIAL — some queries run serially. For example, a single row lookup or a query that filters on the leading part of the primary key and limits the results below a configurable threshold.",{"_11930":443,"_45438":410,"_17286":88954,"_5":16822,"_23744":88863,"_7301":88955},[45942],"EST_BYTES_READ - provides an estimate of the total number of bytes that will be scanned as part of executing the query.",{"_11930":444,"_45438":410,"_17286":88957,"_5":16822,"_23744":88863,"_7301":88958},[45942],"EST_ROWS_READ - provides an estimate of the total number of rows that will be scanned as part of executing the query.",{"_11930":445,"_45438":410,"_17286":88960,"_5":16822,"_23744":88863,"_7301":88961},[45942],"EST_INFO_TS - epoch time in milliseconds at which the estimate information was collected.",{"_11930":446,"_45438":410,"_17286":88963,"_5":16822,"_23744":88870,"_7301":88964},[45942],"The information displayed in the explain plan API can also be accessed programmatically through the standard JDBC interfaces. When statistics collection\nis enabled for a table, the explain plan also gives an estimate of number of rows and bytes a query is going to scan. To get hold of the info, you can\nuse corresponding columns in the result set returned by the explain plan statement. When stats collection is not enabled or if for some reason\nPhoenix cannot provide the estimate information, the columns return null. Below is an example:",{"_11930":447,"_45438":447,"_5":12359,"_7301":88966,"_45913":88967,"_17286":88968,"_23744":447},"FAQ",[87622,87623,87890],[45942],{"_11930":448,"_45438":447,"_17286":88970,"_5":16822,"_23744":447,"_7301":88971},[45942],"Frequently asked question about Phoenix",{"_11930":449,"_45438":447,"_5":45910,"_17286":88973,"_23744":88974,"_7301":88975},[45942],"/docs/faq#questions-answered-in-this-page","Questions answered in this page:",{"_11930":450,"_45438":447,"_5":45910,"_17286":88977,"_23744":88978,"_7301":88979},[45942],"/docs/faq#i-want-to-get-started-is-there-a-phoenix-hello-world","I want to get started. Is there a Phoenix Hello World?",{"_11930":451,"_45438":447,"_5":45910,"_17286":88981,"_23744":88982,"_7301":88983},[45942],"/docs/faq#using-console","Using console",{"_11930":452,"_45438":447,"_5":45910,"_17286":88985,"_23744":88986,"_7301":88987},[45942],"/docs/faq#using-java","Using Java",{"_11930":453,"_45438":447,"_5":45910,"_17286":88989,"_23744":88990,"_7301":88991},[45942],"/docs/faq#what-is-the-phoenix-jdbc-url-syntax","What is the Phoenix JDBC URL syntax?",{"_11930":454,"_45438":447,"_5":45910,"_17286":88993,"_23744":88994,"_7301":88995},[45942],"/docs/faq#thick-driver","Thick Driver",{"_11930":455,"_45438":447,"_5":45910,"_17286":88997,"_23744":88998,"_7301":88999},[45942],"/docs/faq#thin-driver","Thin Driver",{"_11930":456,"_45438":447,"_5":45910,"_17286":89001,"_23744":89002,"_7301":89003},[45942],"/docs/faq#is-there-a-way-to-bulk-load-in-phoenix","Is there a way to bulk load in Phoenix?",{"_11930":457,"_45438":447,"_5":45910,"_17286":89005,"_23744":89006,"_7301":89007},[45942],"/docs/faq#map-reduce","Map Reduce",{"_11930":458,"_45438":447,"_5":45910,"_17286":89009,"_23744":89010,"_7301":89011},[45942],"/docs/faq#csv","CSV",{"_11930":459,"_45438":447,"_5":45910,"_17286":89013,"_23744":89014,"_7301":89015},[45942],"/docs/faq#how-i-map-phoenix-table-to-an-existing-hbase-table","How I map Phoenix table to an existing HBase table?",{"_11930":460,"_45438":447,"_5":45910,"_17286":89017,"_23744":89018,"_7301":89019},[45942],"/docs/faq#are-there-any-tips-for-optimizing-phoenix","Are there any tips for optimizing Phoenix?",{"_11930":461,"_45438":447,"_5":45910,"_17286":89021,"_23744":89022,"_7301":89023},[45942],"/docs/faq#how-do-i-create-secondary-index-on-a-table","How do I create Secondary Index on a table?",{"_11930":462,"_45438":447,"_5":45910,"_17286":89025,"_23744":89026,"_7301":89027},[45942],"/docs/faq#why-isnt-my-secondary-index-being-used","Why isn't my secondary index being used?",{"_11930":463,"_45438":447,"_5":45910,"_17286":89029,"_23744":89030,"_7301":89031},[45942],"/docs/faq#how-fast-is-phoenix-why-is-it-so-fast","How fast is Phoenix? Why is it so fast?",{"_11930":464,"_45438":447,"_5":45910,"_17286":89033,"_23744":89034,"_7301":89035},[45942],"/docs/faq#how-do-i-connect-to-secure-hbase-cluster","How do I connect to secure HBase cluster?",{"_11930":465,"_45438":447,"_5":45910,"_17286":89037,"_23744":89038,"_7301":89039},[45942],"/docs/faq#what-hbase-and-hadoop-versions-are-supported","What HBase and Hadoop versions are supported?",{"_11930":466,"_45438":447,"_5":45910,"_17286":89041,"_23744":89042,"_7301":89043},[45942],"/docs/faq#can-phoenix-work-on-tables-with-arbitrary-timestamp-as-flexible-as-hbase-api","Can phoenix work on tables with arbitrary timestamp as flexible as HBase API?",{"_11930":467,"_45438":447,"_5":45910,"_17286":89045,"_23744":89046,"_7301":89047},[45942],"/docs/faq#why-isnt-my-query-doing-a-range-scan","Why isn't my query doing a RANGE SCAN?",{"_11930":468,"_45438":447,"_5":45910,"_17286":89049,"_23744":89050,"_7301":89051},[45942],"/docs/faq#should-i-pool-phoenix-jdbc-connections","Should I pool Phoenix JDBC Connections?",{"_11930":469,"_45438":447,"_5":45910,"_17286":89053,"_23744":89054,"_7301":89055},[45942],"/docs/faq#why-does-phoenix-add-an-emptydummy-keyvalue-when-doing-an-upsert","Why does Phoenix add an empty/dummy KeyValue when doing an upsert?",{"_11930":470,"_45438":447,"_17286":89057,"_5":16822,"_23744":88974,"_7301":88979},[45942],{"_11930":471,"_45438":447,"_17286":89059,"_5":16822,"_23744":88974,"_7301":88991},[45942],{"_11930":472,"_45438":447,"_17286":89061,"_5":16822,"_23744":88974,"_7301":89003},[45942],{"_11930":473,"_45438":447,"_17286":89063,"_5":16822,"_23744":88974,"_7301":89015},[45942],{"_11930":474,"_45438":447,"_17286":89065,"_5":16822,"_23744":88974,"_7301":89019},[45942],{"_11930":475,"_45438":447,"_17286":89067,"_5":16822,"_23744":88974,"_7301":89023},[45942],{"_11930":476,"_45438":447,"_17286":89069,"_5":16822,"_23744":88974,"_7301":89027},[45942],{"_11930":477,"_45438":447,"_17286":89071,"_5":16822,"_23744":88974,"_7301":89031},[45942],{"_11930":478,"_45438":447,"_17286":89073,"_5":16822,"_23744":88974,"_7301":89035},[45942],{"_11930":479,"_45438":447,"_17286":89075,"_5":16822,"_23744":88974,"_7301":89039},[45942],{"_11930":480,"_45438":447,"_17286":89077,"_5":16822,"_23744":88974,"_7301":89043},[45942],{"_11930":481,"_45438":447,"_17286":89079,"_5":16822,"_23744":88974,"_7301":89047},[45942],{"_11930":482,"_45438":447,"_17286":89081,"_5":16822,"_23744":88974,"_7301":89051},[45942],{"_11930":483,"_45438":447,"_17286":89083,"_5":16822,"_23744":88974,"_7301":89084},[45942],"Why does Phoenix add an empty or dummy KeyValue when doing an upsert?",{"_11930":484,"_45438":447,"_17286":89086,"_5":16822,"_23744":88978,"_7301":89087},[45942],"Pre-requisite: Download and install the latest Phoenix.",{"_11930":485,"_45438":447,"_17286":89089,"_5":16822,"_23744":88982,"_7301":89090},[45942],"Start Sqlline:",{"_11930":486,"_45438":447,"_17286":89092,"_5":16822,"_23744":88982,"_7301":89093},[45942],"Execute the following statements when Sqlline connects:",{"_11930":487,"_45438":447,"_17286":89095,"_5":16822,"_23744":88982,"_7301":89096},[45942],"You should get the following output:",{"_11930":488,"_45438":447,"_17286":89098,"_5":16822,"_23744":88986,"_7301":89099},[45942],"Create test.java file with the following content:",{"_11930":489,"_45438":447,"_17286":89101,"_5":16822,"_23744":88986,"_7301":89102},[45942],"Compile and execute on command line",{"_11930":490,"_45438":447,"_17286":89104,"_5":16822,"_23744":88986,"_7301":89105},[45942],"You should get the following output",{"_11930":491,"_45438":447,"_17286":89107,"_5":16822,"_23744":88994,"_7301":89108},[45942],"See Using the Phoenix JDBC Driver for a more up-to-date description",{"_11930":492,"_45438":447,"_17286":89110,"_5":16822,"_23744":88994,"_7301":89111},[45942],"The Phoenix (Thick) Driver JDBC URL syntax is as follows (where elements in square brackets are optional):",{"_11930":493,"_45438":447,"_17286":89113,"_5":16822,"_23744":88994,"_7301":89114},[45942],"The simplest URL is:",{"_11930":494,"_45438":447,"_17286":89116,"_5":16822,"_23744":88994,"_7301":89117},[45942],"Whereas the most complicated URL is:",{"_11930":495,"_45438":447,"_17286":89119,"_5":16822,"_23744":88994,"_7301":89120},[45942],"Please note that each optional element in the URL requires all previous optional elements. For example, to specify the\nHBase root ZNode, the ZooKeeper port must also be specified.",{"_11930":496,"_45438":447,"_17286":89122,"_5":16822,"_23744":88994,"_7301":89123},[45942],"See also Connection String.",{"_11930":497,"_45438":447,"_17286":89125,"_5":16822,"_23744":88998,"_7301":89126},[45942],"The Phoenix Thin Driver (used with the Phoenix Query Server) JDBC URL syntax is as follows:",{"_11930":498,"_45438":447,"_17286":89128,"_5":16822,"_23744":88998,"_7301":89129},[45942],"There are a number of keys exposed for client-use. The most commonly-used keys are: url and serialization. The url\nkey is required to interact with the Phoenix Query Server.",{"_11930":499,"_45438":447,"_17286":89131,"_5":16822,"_23744":88998,"_7301":89114},[45942],{"_11930":500,"_45438":447,"_17286":89133,"_5":16822,"_23744":88998,"_7301":89134},[45942],"Where as very complicated URL is:",{"_11930":501,"_45438":447,"_17286":89136,"_5":16822,"_23744":88998,"_7301":89137},[45942],"Please refer to the Apache Avatica documentation for a full list of supported options in the Thin client JDBC URL,\nor see the Query Server documentation",{"_11930":502,"_45438":447,"_17286":89139,"_5":16822,"_23744":89006,"_7301":89140},[45942],"See the example here",{"_11930":503,"_45438":447,"_17286":89142,"_5":16822,"_23744":89010,"_7301":89143},[45942],"CSV data can be bulk loaded with built in utility named psql. Typical upsert rates are 20K - 50K rows per second (depends on how wide are the rows).",{"_11930":504,"_45438":447,"_17286":89145,"_5":16822,"_23744":89010,"_7301":89146},[45942],"Usage example:",{"_11930":505,"_45438":447,"_17286":89148,"_5":16822,"_23744":89010,"_7301":89149},[45942],"Create table using psql:",{"_11930":506,"_45438":447,"_17286":89151,"_5":16822,"_23744":89010,"_7301":89152},[45942],"Upsert CSV bulk data:",{"_11930":507,"_45438":447,"_17286":89154,"_5":16822,"_23744":89014,"_7301":89155},[45942],"You can create both a Phoenix table or view through the CREATE TABLE/CREATE VIEW DDL statement on a pre-existing HBase table. In both cases, we'll leave the HBase metadata as-is. For CREATE TABLE, we'll create any metadata (table, column families) that doesn't already exist. We'll also add an empty key value for each row so that queries behave as expected (without requiring all columns to be projected during scans).",{"_11930":508,"_45438":447,"_17286":89157,"_5":16822,"_23744":89014,"_7301":89158},[45942],"The other caveat is that the way the bytes were serialized must match the way the bytes are serialized by Phoenix. For VARCHAR, CHAR, and UNSIGNED_* types, we use the HBase Bytes methods. The CHAR type expects only single-byte characters and the UNSIGNED types expect values greater than or equal to zero. For signed types (TINYINT, SMALLINT, INTEGER and BIGINT), Phoenix will flip the first bit so that negative values will sort before positive values. Because HBase sorts row keys in lexicographical order and negative value's first bit is 1 while positive 0 so that negative value is 'greater than' positive value if we don't flip the first bit. So if you stored integers by HBase native API and want to access them by Phoenix, make sure that all your data types are UNSIGNED types.",{"_11930":509,"_45438":447,"_17286":89160,"_5":16822,"_23744":89014,"_7301":89161},[45942],"Our composite row keys are formed by simply concatenating the values together, with a zero byte character used as a separator after a variable length type.",{"_11930":510,"_45438":447,"_17286":89163,"_5":16822,"_23744":89014,"_7301":89164},[45942],"If you create an HBase table like this:",{"_11930":511,"_45438":447,"_17286":89166,"_5":16822,"_23744":89014,"_7301":89167},[45942],"then you have an HBase table with a name of t1 and a column family with a name of f1. Remember, in HBase, you don't model the possible KeyValues or the structure of the row key. This is the information you specify in Phoenix above and beyond the table and column family.",{"_11930":512,"_45438":447,"_17286":89169,"_5":16822,"_23744":89014,"_7301":89170},[45942],"So in Phoenix, you'd create a view like this:",{"_11930":513,"_45438":447,"_17286":89172,"_5":16822,"_23744":89014,"_7301":89173},[45942],"The pk column declares that your row key is a VARCHAR (i.e. a string) while the \"f1\".val column declares that your HBase table will contain KeyValues with a column family and column qualifier of \"f1\":VAL and that their value will be a VARCHAR.",{"_11930":514,"_45438":447,"_17286":89175,"_5":16822,"_23744":89014,"_7301":89176},[45942],"Note that you don't need the double quotes if you create your HBase table with all caps names (since this is how Phoenix normalizes strings, by upper casing them). For example, with:",{"_11930":515,"_45438":447,"_17286":89178,"_5":16822,"_23744":89014,"_7301":89179},[45942],"you could create this Phoenix view:",{"_11930":516,"_45438":447,"_17286":89181,"_5":16822,"_23744":89014,"_7301":89182},[45942],"Or if you're creating new HBase tables, just let Phoenix do everything for you like this (No need to use the HBase shell at all.):",{"_11930":517,"_45438":447,"_17286":89184,"_5":16822,"_23744":89018,"_7301":89185},[45942],"Use Salting to increase read/write performanceSalting can significantly increase read/write performance by pre-splitting the data into multiple regions. Although Salting will yield better performance in most scenarios.Example:",{"_11930":518,"_45438":447,"_17286":89187,"_5":16822,"_23744":89018,"_7301":89188},[45942],"Note: Ideally for a 16 region server cluster with quad-core CPUs, choose salt buckets between 32-64 for optimal performance.",{"_11930":519,"_45438":447,"_17286":89190,"_5":16822,"_23744":89018,"_7301":89191},[45942],"Pre-split tableSalting does automatic table splitting but in case you want to exactly control where table split occurs with out adding extra byte or change row key order then you can pre-split a table.Example:",{"_11930":520,"_45438":447,"_17286":89193,"_5":16822,"_23744":89018,"_7301":89194},[45942],"Use multiple column familiesColumn family contains related data in separate files. If you query use selected columns then it make sense to group those columns together in a column family to improve read performance.Example:Following create table DDL will create two column faimiles A and B.",{"_11930":521,"_45438":447,"_17286":89196,"_5":16822,"_23744":89018,"_7301":89197},[45942],"Use compressionOn disk compression improves performance on large tablesExample:",{"_11930":522,"_45438":447,"_17286":89199,"_5":16822,"_23744":89018,"_7301":89200},[45942],"Create indexes\nSee How do I connect to secure HBase cluster?",{"_11930":523,"_45438":447,"_17286":89202,"_5":16822,"_23744":89018,"_7301":89203},[45942],"Optimize cluster parameters\nSee https://hbase.apache.org/docs/performance",{"_11930":524,"_45438":447,"_17286":89205,"_5":16822,"_23744":89018,"_7301":89206},[45942],"Optimize Phoenix parameters\nSee Configuration",{"_11930":525,"_45438":447,"_17286":89208,"_5":16822,"_23744":89022,"_7301":89209},[45942],"Starting with Phoenix version 2.1, Phoenix supports index over mutable and immutable data. Note that Phoenix 2.0.x only supports Index over immutable data. Index write performance index with immutable table is slightly faster than mutable table however data in immutable table cannot be updated.",{"_11930":526,"_45438":447,"_17286":89211,"_5":16822,"_23744":89022,"_7301":89212},[45942],"Example:",{"_11930":527,"_45438":447,"_17286":89214,"_5":16822,"_23744":89022,"_7301":89215},[45942],"Create tableImmutable table: create table test (mykey varchar primary key, col1 varchar, col2 varchar) IMMUTABLE_ROWS=true;Mutable table: create table test (mykey varchar primary key, col1 varchar, col2 varchar);",{"_11930":528,"_45438":447,"_17286":89217,"_5":16822,"_23744":89022,"_7301":89218},[45942],"Creating index on col2create index idx on test (col2)",{"_11930":529,"_45438":447,"_17286":89220,"_5":16822,"_23744":89022,"_7301":89221},[45942],"Creating index on col1 and a covered index on col2create index idx on test (col1) include (col2)Upsert rows in this test table and Phoenix query optimizer will choose correct index to use. You can see in explain plan if Phoenix is using the index table. You can also give a hint in Phoenix query to use a specific index.",{"_11930":530,"_45438":447,"_17286":89223,"_5":16822,"_23744":89022,"_7301":89224},[45942],"See Secondary Indexing for further information",{"_11930":531,"_45438":447,"_17286":89226,"_5":16822,"_23744":89026,"_7301":89227},[45942],"The secondary index won't be used unless all columns used in the query are in it ( as indexed or covered columns). All columns making up the primary key of the data table will automatically be included in the index.",{"_11930":532,"_45438":447,"_17286":89229,"_5":16822,"_23744":89026,"_7301":89230},[45942],"Example: DDL create table usertable (id varchar primary key, firstname varchar, lastname varchar); create index idx_name on usertable (firstname);",{"_11930":533,"_45438":447,"_17286":89232,"_5":16822,"_23744":89026,"_7301":89233},[45942],"Query: DDL select id, firstname, lastname from usertable where firstname = 'foo';",{"_11930":534,"_45438":447,"_17286":89235,"_5":16822,"_23744":89026,"_7301":89236},[45942],"Index would not be used in this case as lastname is not part of indexed or covered column. This can be verified by looking at the explain plan. To fix this create index that has either lastname part of index or covered column. Example: create idx_name on usertable (firstname) include (lastname);",{"_11930":535,"_45438":447,"_17286":89238,"_5":16822,"_23744":89026,"_7301":89239},[45942],"You can force Phoenix to use secondary for uncovered columns by specifying an index hint",{"_11930":536,"_45438":447,"_17286":89241,"_5":16822,"_23744":89030,"_7301":89242},[45942],"Phoenix is fast. Full table scan of 100M rows usually completes in 20 seconds (narrow table on a medium sized cluster). This time come down to few milliseconds if query contains filter on key columns. For filters on non-key columns or non-leading key columns, you can add index on these columns which leads to performance equivalent to filtering on key column by making copy of table with indexed column(s) part of key.",{"_11930":537,"_45438":447,"_17286":89244,"_5":16822,"_23744":89030,"_7301":89245},[45942],"Why is Phoenix fast even when doing full scan:",{"_11930":538,"_45438":447,"_17286":89247,"_5":16822,"_23744":89030,"_7301":89248},[45942],"Phoenix chunks up your query using the region boundaries and runs them in parallel on the client using a configurable number of threads.",{"_11930":539,"_45438":447,"_17286":89250,"_5":16822,"_23744":89030,"_7301":89251},[45942],"The aggregation will be done in a coprocessor on the server-side, collapsing the amount of data that gets returned back to the client rather than returning it all.",{"_11930":540,"_45438":447,"_17286":89253,"_5":16822,"_23744":89034,"_7301":89254},[45942],"Specify the principal and corresponding keytab in the JDBC URL as show above.\nFor ancient Phoenix versions heck out the excellent post by Anil Gupta",{"_11930":541,"_45438":447,"_17286":89256,"_5":16822,"_23744":89038,"_7301":89257},[45942],"Phoenix 4.x supports HBase 1.x running on Hadoop 2",{"_11930":542,"_45438":447,"_17286":89259,"_5":16822,"_23744":89038,"_7301":89260},[45942],"Phoenix 5.x supports HBase 2.x running on Hadoop 3",{"_11930":543,"_45438":447,"_17286":89262,"_5":16822,"_23744":89038,"_7301":89263},[45942],"See the release notes and BUILDING in recent releases for the exact versions supported,\nand on how to build Phoenix for specific HBase and Hadoop versions",{"_11930":544,"_45438":447,"_17286":89265,"_5":16822,"_23744":89042,"_7301":89266},[45942],"By default, Phoenix lets HBase manage the timestamps and just shows you the latest values for everything. However, Phoenix also allows arbitrary timestamps to be supplied by the user. To do that you'd specify a CurrentSCN at connection time, like this:",{"_11930":545,"_45438":447,"_17286":89268,"_5":16822,"_23744":89042,"_7301":89269},[45942],"The above is equivalent to doing this with the HBase API:",{"_11930":546,"_45438":447,"_17286":89271,"_5":16822,"_23744":89042,"_7301":89272},[45942],"By specifying a CurrentSCN, you're telling Phoenix that you want everything for that connection to be done at that timestamp. Note that this applies to queries done on the connection as well - for example, a query over myTable above would not see the data it just upserted, since it only sees data that was created before its CurrentSCN property. This provides a way of doing snapshot, flashback, or point-in-time queries.",{"_11930":547,"_45438":447,"_17286":89274,"_5":16822,"_23744":89042,"_7301":89275},[45942],"Keep in mind that creating a new connection is not an expensive operation. The same underlying HConnection is used for all connections to the same cluster, so it's more or less like instantiating a few objects.",{"_11930":548,"_45438":447,"_17286":89277,"_5":16822,"_23744":89046,"_7301":89278},[45942],"RANGE SCAN means that only a subset of the rows in your table will be scanned over. This occurs if you use one or more leading columns from your primary key constraint. Query that is not filtering on leading PK columns ex. select * from test where pk2='x' and pk3='y'; will result in full scan whereas the following query will result in range scan select * from test where pk1='x' and pk2='y';. Note that you can add a secondary index on your pk2 and pk3 columns and that would cause a range scan to be done for the first query (over the index table).",{"_11930":549,"_45438":447,"_17286":89280,"_5":16822,"_23744":89046,"_7301":89281},[45942],"DEGENERATE SCAN means that a query can't possibly return any rows. If we can determine that at compile time, then we don't bother to even run the scan.",{"_11930":550,"_45438":447,"_17286":89283,"_5":16822,"_23744":89046,"_7301":89284},[45942],"FULL SCAN means that all rows of the table will be scanned over (potentially with a filter applied if you have a WHERE clause)",{"_11930":551,"_45438":447,"_17286":89286,"_5":16822,"_23744":89046,"_7301":89287},[45942],"SKIP SCAN means that either a subset or all rows in your table will be scanned over, however it will skip large groups of rows depending on the conditions in your filter. See this blog for more detail. We don't do a SKIP SCAN if you have no filter on the leading primary key columns, but you can force a SKIP SCAN by using the /*+ SKIP_SCAN */ hint. Under some conditions, namely when the cardinality of your leading primary key columns is low, it will be more efficient than a FULL SCAN.",{"_11930":552,"_45438":447,"_17286":89289,"_5":16822,"_23744":89050,"_7301":89290},[45942],"No, it is not necessary to pool Phoenix JDBC Connections.",{"_11930":553,"_45438":447,"_17286":89292,"_5":16822,"_23744":89050,"_7301":89293},[45942],"Phoenix's Connection objects are different from most other JDBC Connections due to the underlying HBase connection. The Phoenix Connection object is designed to be a thin object that is inexpensive to create. If Phoenix Connections are reused, it is possible that the underlying HBase connection is not always left in a healthy state by the previous user. It is better to create new Phoenix Connections to ensure that you avoid any potential issues.",{"_11930":554,"_45438":447,"_17286":89295,"_5":16822,"_23744":89050,"_7301":89296},[45942],"Implementing pooling for Phoenix could be done simply by creating a delegate Connection that instantiates a new Phoenix connection when retrieved from the pool and then closes the connection when returning it to the pool (see PHOENIX-2388).",{"_11930":555,"_45438":447,"_17286":89298,"_5":16822,"_23744":89054,"_7301":89299},[45942],"The empty or dummy KeyValue (with a column qualifier of _0) is needed to ensure that a given column is available\nfor all rows.",{"_11930":556,"_45438":447,"_17286":89301,"_5":16822,"_23744":89054,"_7301":89302},[45942],"As you may know, data is stored in HBase as KeyValues, meaning that\nthe full row key is stored for each column value. This also implies\nthat the row key is not stored at all unless there is at least one\ncolumn stored.",{"_11930":557,"_45438":447,"_17286":89304,"_5":16822,"_23744":89054,"_7301":89305},[45942],"Now consider JDBC row which has an integer primary key, and several\ncolumns which are all null. In order to be able to store the primary\nkey, a KeyValue needs to be stored to show that the row is present at\nall. This column is represented by the empty column that you've\nnoticed. This allows doing a SELECT * FROM TABLE and receiving\nrecords for all rows, even those whose non-pk columns are null.",{"_11930":558,"_45438":447,"_17286":89307,"_5":16822,"_23744":89054,"_7301":89308},[45942],"The same issue comes up even if only one column is null for some (or\nall) records. A scan over Phoenix will include the empty column to\nensure that rows that only consist of the primary key (and have null\nfor all non-key columns) will be included in a scan result.",{"_11930":559,"_45438":559,"_5":12359,"_7301":89310,"_45913":89311,"_17286":89313,"_23744":559},"Atomic Upsert",[87622,87623,87624,89312],"Features",[45942],{"_11930":560,"_45438":559,"_17286":89315,"_5":16822,"_23744":559,"_7301":89316},[45942],"Use UPSERT ... ON DUPLICATE KEY for atomic row-level updates in Phoenix, with examples and limitations.",{"_11930":561,"_45438":559,"_5":45910,"_17286":89318,"_23744":89319,"_7301":89320},[45942],"/docs/features/atomic-upsert#atomic-upsert-examples","Examples",{"_11930":562,"_45438":559,"_5":45910,"_17286":89322,"_23744":89323,"_7301":89324},[45942],"/docs/features/atomic-upsert#atomic-upsert-update-only","ON DUPLICATE KEY UPDATE_ONLY",{"_11930":563,"_45438":559,"_5":45910,"_17286":89326,"_23744":89327,"_7301":89328},[45942],"/docs/features/atomic-upsert#atomic-upsert-returning","Returning the affected row",{"_11930":564,"_45438":559,"_5":45910,"_17286":89330,"_23744":89331,"_7301":89332},[45942],"/docs/features/atomic-upsert#java-jdbc-thick-client-api","Java JDBC thick-client API",{"_11930":565,"_45438":559,"_5":45910,"_17286":89334,"_23744":89335,"_7301":87744},[45942],"/docs/features/atomic-upsert#atomic-upsert-limitations",{"_11930":566,"_45438":559,"_17286":89337,"_5":16822,"_23744":559,"_7301":89338},[45942],"To support atomic upsert, an optional ON DUPLICATE KEY clause, similar to the MySQL syntax, has been\nincorporated into the UPSERT VALUES command as of Phoenix 4.9. The general syntax is described\nhere. This feature provides a superset of the HBase Increment and\nCheckAndPut functionality to enable atomic upserts. On the server-side, when the commit\nis processed, the row being updated will be locked while the current column values are read and the\nON DUPLICATE KEY clause is executed. Given that the row must be locked and read when the ON DUPLICATE KEY\nclause is used, there will be a performance penalty (much like there is for an HBase Put versus a CheckAndPut).",{"_11930":567,"_45438":559,"_17286":89340,"_5":16822,"_23744":559,"_7301":89341},[45942],"In the presence of the ON DUPLICATE KEY clause, if the row already exists, the VALUES specified will\nbe ignored and instead either:",{"_11930":568,"_45438":559,"_17286":89343,"_5":16822,"_23744":559,"_7301":89344},[45942],"the row will not be updated if ON DUPLICATE KEY IGNORE is specified or",{"_11930":569,"_45438":559,"_17286":89346,"_5":16822,"_23744":559,"_7301":89347},[45942],"the row will be updated (under lock) by executing the expressions following the ON DUPLICATE KEY UPDATE\nclause.",{"_11930":570,"_45438":559,"_17286":89349,"_5":16822,"_23744":559,"_7301":89350},[45942],"Multiple UPSERT statements for the same row in the same commit batch will be processed in the order of their\nexecution. Thus the same result will be produced when auto commit is on or off.",{"_11930":571,"_45438":559,"_17286":89352,"_5":16822,"_23744":89319,"_7301":89353},[45942],"For example, to atomically increment two counter columns, you would execute the following command:",{"_11930":572,"_45438":559,"_17286":89355,"_5":16822,"_23744":89319,"_7301":89356},[45942],"To only update a column if it doesn't yet exist:",{"_11930":573,"_45438":559,"_17286":89358,"_5":16822,"_23744":89319,"_7301":89359},[45942],"Note that arbitrarily complex expressions may be used in this new clause:",{"_11930":574,"_45438":559,"_17286":89361,"_5":16822,"_23744":89323,"_7301":89362},[45942],"UPDATE_ONLY is a third variant of the ON DUPLICATE KEY clause, available from\nPhoenix 5.3.0 (PHOENIX-7648).\nUnlike UPDATE, it only runs the update-clause expressions when the row already\nexists — it never inserts. If the row is missing, the supplied VALUES are discarded\nand the statement is a no-op. Use it when an UPSERT should be able to update an\nexisting row but must not create a new one.",{"_11930":575,"_45438":559,"_17286":89364,"_5":16822,"_23744":89323,"_7301":89365},[45942],"If id = 'sku-42' already exists, its qty is decremented under the row lock.\nIf it doesn't, the supplied VALUES are discarded and nothing is written.",{"_11930":576,"_45438":559,"_17286":89367,"_5":16822,"_23744":89323,"_7301":89368},[45942],"The three forms compared:",{"_11930":577,"_45438":559,"_17286":89370,"_5":16822,"_23744":89323,"_7301":89371},[45942],"Clause",{"_11930":578,"_45438":559,"_17286":89373,"_5":16822,"_23744":89323,"_7301":89374},[45942],"Row missing",{"_11930":579,"_45438":559,"_17286":89376,"_5":16822,"_23744":89323,"_7301":89377},[45942],"Row present",{"_11930":580,"_45438":559,"_17286":89379,"_5":16822,"_23744":89323,"_7301":89380},[45942],"ON DUPLICATE KEY IGNORE",{"_11930":581,"_45438":559,"_17286":89382,"_5":16822,"_23744":89323,"_7301":89383},[45942],"Insert from VALUES",{"_11930":582,"_45438":559,"_17286":89385,"_5":16822,"_23744":89323,"_7301":89386},[45942],"No-op",{"_11930":583,"_45438":559,"_17286":89388,"_5":16822,"_23744":89323,"_7301":89389},[45942],"ON DUPLICATE KEY UPDATE ...",{"_11930":584,"_45438":559,"_17286":89391,"_5":16822,"_23744":89323,"_7301":89383},[45942],{"_11930":585,"_45438":559,"_17286":89393,"_5":16822,"_23744":89323,"_7301":89394},[45942],"Run the update",{"_11930":586,"_45438":559,"_17286":89396,"_5":16822,"_23744":89323,"_7301":89397},[45942],"ON DUPLICATE KEY UPDATE_ONLY ...",{"_11930":587,"_45438":559,"_17286":89399,"_5":16822,"_23744":89323,"_7301":89400},[45942],"No-op (VALUES discarded)",{"_11930":588,"_45438":559,"_17286":89402,"_5":16822,"_23744":89323,"_7301":89394},[45942],{"_11930":589,"_45438":559,"_17286":89404,"_5":16822,"_23744":89327,"_7301":89405},[45942],"A single-row UPSERT or DELETE can append RETURNING * to return the affected row\nas a JDBC ResultSet in the same round-trip, available from Phoenix 5.3.0\n(PHOENIX-7651). The returned\nrow reflects the server-side state after the mutation — including any values\ncomputed by an ON DUPLICATE KEY UPDATE clause under the row lock.",{"_11930":590,"_45438":559,"_17286":89407,"_5":16822,"_23744":89327,"_7301":89408},[45942],"This collapses two common patterns into one round-trip:",{"_11930":591,"_45438":559,"_17286":89410,"_5":16822,"_23744":89327,"_7301":89411},[45942],"Atomic read-modify-write counters — increment, then read the new value\nwithout a follow-up SELECT (and without risking a different writer slipping in\nbetween).",{"_11930":592,"_45438":559,"_17286":89413,"_5":16822,"_23744":89327,"_7301":89414},[45942],"Tombstoning / queue consumers — atomically delete a row and read the payload\nyou just removed, useful for idempotent replay and \"claim the next task\" patterns.",{"_11930":593,"_45438":559,"_17286":89416,"_5":16822,"_23744":89327,"_7301":89417},[45942],"The statement must affect a single row when RETURNING * is used. Drivers iterate\nthe returned ResultSet exactly like the result of a regular SELECT.",{"_11930":594,"_45438":559,"_17286":89419,"_5":16822,"_23744":89331,"_7301":89420},[45942],"Java applications using the Phoenix thick JDBC client can drive the same\natomic-return semantics directly through typed methods on PhoenixStatement and\nPhoenixPreparedStatement, without putting RETURNING * in the SQL:",{"_11930":595,"_45438":559,"_17286":89422,"_5":16822,"_23744":89331,"_7301":89423},[45942],"executeAtomicUpdateReturnRow — returns the row state after the mutation\n(or the unchanged row when the statement was a no-op). Equivalent to\nRETURNING * in SQL.",{"_11930":596,"_45438":559,"_17286":89425,"_5":16822,"_23744":89331,"_7301":89426},[45942],"executeAtomicUpdateReturnOldRow — returns the row state before the\nmutation, regardless of whether the mutation was applied. There is no SQL form\nfor this — only the typed API exposes the pre-image, which is the natural fit\nfor audit logs and compare-and-swap-style flows.",{"_11930":597,"_45438":559,"_17286":89428,"_5":16822,"_23744":89331,"_7301":89429},[45942],"Both return a Pair<Integer, ResultSet> where the integer is 1 if the row was\nmutated and 0 for a no-op, so callers know the outcome without having to inspect\ncell contents. Both require an auto-commit connection.",{"_11930":598,"_45438":559,"_17286":89431,"_5":16822,"_23744":89335,"_7301":89432},[45942],"The following limitations are enforced for the ON DUPLICATE KEY clause usage:",{"_11930":599,"_45438":559,"_17286":89434,"_5":16822,"_23744":89335,"_7301":89435},[45942],"Primary key columns may not be updated, since this would essentially be creating a new row.",{"_11930":600,"_45438":559,"_17286":89437,"_5":16822,"_23744":89335,"_7301":89438},[45942],"Transactional tables may not use this clause as atomic upserts are already possible through\nexception handling when a conflict occurs.",{"_11930":601,"_45438":559,"_17286":89440,"_5":16822,"_23744":89335,"_7301":89441},[45942],"Immutable tables may not use this clause as by definition there should be no updates to\nexisting rows.",{"_11930":602,"_45438":559,"_17286":89443,"_5":16822,"_23744":89335,"_7301":89444},[45942],"The CURRENT_SCN property may not be set on connection when this clause is used as HBase\ndoes not handle atomicity unless the latest value is being updated.",{"_11930":603,"_45438":559,"_17286":89446,"_5":16822,"_23744":89335,"_7301":89447},[45942],"The same column should not be updated more than once in the same statement.",{"_11930":604,"_45438":559,"_17286":89449,"_5":16822,"_23744":89335,"_7301":89450},[45942],"No aggregation or references to sequences are allowed within the clause.",{"_11930":605,"_45438":605,"_5":12359,"_7301":89452,"_45913":89453,"_17286":89454,"_23744":605},"Document Data: BSON",[87622,87623,87624,89312],[45942],{"_11930":606,"_45438":605,"_17286":89456,"_5":16822,"_23744":605,"_7301":89457},[45942],"Store, query, filter, and atomically update Binary JSON (BSON) documents inside a Phoenix table — without round-tripping the document to the client.",{"_11930":607,"_45438":605,"_5":45910,"_17286":89459,"_23744":89460,"_7301":89461},[45942],"/docs/features/bson#bson-when","When to reach for BSON",{"_11930":608,"_45438":605,"_5":45910,"_17286":89463,"_23744":89464,"_7301":89465},[45942],"/docs/features/bson#bson-defining","Defining a BSON column",{"_11930":609,"_45438":605,"_5":45910,"_17286":89467,"_23744":89468,"_7301":89469},[45942],"/docs/features/bson#bson-paths","Field paths",{"_11930":610,"_45438":605,"_5":45910,"_17286":89471,"_23744":89472,"_7301":89473},[45942],"/docs/features/bson#bson-value","Reading fields: BSON_VALUE",{"_11930":611,"_45438":605,"_5":45910,"_17286":89475,"_23744":89476,"_7301":89477},[45942],"/docs/features/bson#bson-condition-expression","Filtering rows: BSON_CONDITION_EXPRESSION",{"_11930":612,"_45438":605,"_5":45910,"_17286":89479,"_23744":89480,"_7301":89481},[45942],"/docs/features/bson#bson-update-expression","Atomically updating fields: BSON_UPDATE_EXPRESSION",{"_11930":613,"_45438":605,"_5":45910,"_17286":89483,"_23744":89484,"_7301":89485},[45942],"/docs/features/bson#bson-indexing","Indexing individual fields",{"_11930":614,"_45438":605,"_5":45910,"_17286":89487,"_23744":89488,"_7301":89489},[45942],"/docs/features/bson#bson-end-to-end","End-to-end example",{"_11930":615,"_45438":605,"_5":45910,"_17286":89491,"_23744":89492,"_7301":87744},[45942],"/docs/features/bson#bson-limitations",{"_11930":616,"_45438":605,"_17286":89494,"_5":16822,"_23744":605,"_7301":89495},[45942],"BSON is a native column type for storing schemaless document data alongside your\nrelational columns. Documents are stored in Binary JSON — a\ncompact, length-prefixed format that is cheap to parse server-side and supports the\nfull set of value types (strings, numbers, dates, binary, booleans, nulls, arrays,\nnested objects). Introduced in Phoenix 5.3.0\n(PHOENIX-7330).",{"_11930":617,"_45438":605,"_17286":89497,"_5":16822,"_23744":605,"_7301":89498},[45942],"The point of the type is not just to hold documents — it's that Phoenix can read,\nfilter, and mutate individual fields on the server without the client ever\ndeserializing the whole document.",{"_11930":618,"_45438":605,"_17286":89500,"_5":16822,"_23744":89460,"_7301":89501},[45942],"Use case",{"_11930":619,"_45438":605,"_17286":89503,"_5":16822,"_23744":89460,"_7301":89504},[45942],"Recommended type",{"_11930":620,"_45438":605,"_17286":89506,"_5":16822,"_23744":89460,"_7301":89507},[45942],"Schema is well-known and stable",{"_11930":621,"_45438":605,"_17286":89509,"_5":16822,"_23744":89460,"_7301":89510},[45942],"Regular relational columns",{"_11930":622,"_45438":605,"_17286":89512,"_5":16822,"_23744":89460,"_7301":89513},[45942],"A few optional/sparse fields on otherwise relational rows",{"_11930":623,"_45438":605,"_17286":89515,"_5":16822,"_23744":89460,"_7301":89516},[45942],"Dynamic Columns",{"_11930":624,"_45438":605,"_17286":89518,"_5":16822,"_23744":89460,"_7301":89519},[45942],"Variable-shape documents per row, server-side reads/filters/updates needed",{"_11930":625,"_45438":605,"_17286":89521,"_5":16822,"_23744":89460,"_7301":89522},[45942],"BSON",{"_11930":626,"_45438":605,"_17286":89524,"_5":16822,"_23744":89460,"_7301":89525},[45942],"Variable-shape documents but the server never inspects them",{"_11930":627,"_45438":605,"_17286":89527,"_5":16822,"_23744":89460,"_7301":89528},[45942],"VARCHAR (raw JSON) or VARBINARY",{"_11930":628,"_45438":605,"_17286":89530,"_5":16822,"_23744":89460,"_7301":89531},[45942],"Common cases for BSON:",{"_11930":629,"_45438":605,"_17286":89533,"_5":16822,"_23744":89460,"_7301":89534},[45942],"DynamoDB-style application objects backed by Phoenix.",{"_11930":630,"_45438":605,"_17286":89536,"_5":16822,"_23744":89460,"_7301":89537},[45942],"Customer / configuration / preferences documents that vary per row.",{"_11930":631,"_45438":605,"_17286":89539,"_5":16822,"_23744":89460,"_7301":89540},[45942],"Event payloads where downstream queries need to filter or project specific fields.",{"_11930":632,"_45438":605,"_17286":89542,"_5":16822,"_23744":89460,"_7301":89543},[45942],"Counters and per-field updates that must be atomic without rewriting the whole row.",{"_11930":633,"_45438":605,"_17286":89545,"_5":16822,"_23744":89464,"_7301":89546},[45942],"You may pass a JSON string literal as shown — Phoenix parses and converts it to BSON on\nwrite — or bind a pre-built BSON document via JDBC.",{"_11930":634,"_45438":605,"_17286":89548,"_5":16822,"_23744":89464,"_7301":89549},[45942],"A BSON column may also serve as a primary-key column. In a composite primary key it\nmust be the last column of the key (so the row-key encoding stays bounded for the\npreceding columns).",{"_11930":635,"_45438":605,"_17286":89551,"_5":16822,"_23744":89468,"_7301":89552},[45942],"All three BSON functions address fields with a small path syntax:",{"_11930":636,"_45438":605,"_17286":89554,"_5":16822,"_23744":89468,"_7301":89555},[45942],"name — top-level field",{"_11930":637,"_45438":605,"_17286":89557,"_5":16822,"_23744":89468,"_7301":89558},[45942],"addresses[0] — first element of an array",{"_11930":638,"_45438":605,"_17286":89560,"_5":16822,"_23744":89468,"_7301":89561},[45942],"addresses[0].city — nested field",{"_11930":639,"_45438":605,"_17286":89563,"_5":16822,"_23744":89468,"_7301":89564},[45942],"preferences.theme — nested field on a sub-document",{"_11930":640,"_45438":605,"_17286":89566,"_5":16822,"_23744":89472,"_7301":89567},[45942],"BSON_VALUE(bson_column, field_path, target_type [, default]) projects a single field\nout of a document and returns it as the requested Phoenix data type. Returns NULL if\nthe path is missing — or the supplied default if you provide one.",{"_11930":641,"_45438":605,"_17286":89569,"_5":16822,"_23744":89472,"_7301":89570},[45942],"BSON_VALUE can also return a sub-document (use 'BSON' as the target type) and\nreturn raw binary fields as VARBINARY_ENCODED. A companion function\nBSON_VALUE_TYPE(bson_column, field_path) returns the BSON type of the field as a\nstring (e.g. 'STRING', 'INT32', 'DOCUMENT', 'ARRAY').",{"_11930":642,"_45438":605,"_17286":89572,"_5":16822,"_23744":89476,"_7301":89573},[45942],"BSON_CONDITION_EXPRESSION(bson_column, expression) evaluates a boolean expression\nover a document and returns TRUE or FALSE. Use it in a WHERE clause when you\nwant to filter on multiple document fields at once, or test for the existence/shape\nof fields, without the verbosity of stacking multiple BSON_VALUE calls.",{"_11930":643,"_45438":605,"_17286":89575,"_5":16822,"_23744":89476,"_7301":89576},[45942],"The expression language is intentionally small and DynamoDB-flavored:",{"_11930":644,"_45438":605,"_17286":89578,"_5":16822,"_23744":89476,"_7301":89579},[45942],"Comparisons: =, <> (or !=), <, <=, >, >=",{"_11930":645,"_45438":605,"_17286":89581,"_5":16822,"_23744":89476,"_7301":89582},[45942],"Boolean composition: AND, OR, NOT, parentheses",{"_11930":646,"_45438":605,"_17286":89584,"_5":16822,"_23744":89476,"_7301":89585},[45942],"Ranges and sets: BETWEEN ... AND ..., IN (...), IS NULL",{"_11930":647,"_45438":605,"_17286":89587,"_5":16822,"_23744":89476,"_7301":89588},[45942],"Field presence: field_exists(name), field_not_exists(name)",{"_11930":648,"_45438":605,"_17286":89590,"_5":16822,"_23744":89476,"_7301":89591},[45942],"String/array helpers: begins_with(field, value), contains(field, value)",{"_11930":649,"_45438":605,"_17286":89593,"_5":16822,"_23744":89476,"_7301":89594},[45942],"Type and size: field_type(field, 'STRING' | 'NUMBER' | ...), size(field)",{"_11930":650,"_45438":605,"_17286":89596,"_5":16822,"_23744":89476,"_7301":89597},[45942],"The expression is evaluated server-side, so rows are filtered before they cross the\nnetwork.",{"_11930":651,"_45438":605,"_17286":89599,"_5":16822,"_23744":89480,"_7301":89600},[45942],"BSON_UPDATE_EXPRESSION(bson_column, expression) returns a new BSON document with\nthe requested mutations applied. The intended use is inside an\natomic upsert so an entire family of per-field updates\nruns under the row lock in a single round-trip:",{"_11930":652,"_45438":605,"_17286":89602,"_5":16822,"_23744":89480,"_7301":89603},[45942],"Supported update verbs follow the DynamoDB convention:",{"_11930":653,"_45438":605,"_17286":89605,"_5":16822,"_23744":89480,"_7301":89606},[45942],"SET path = value — write a field (or nested path).",{"_11930":654,"_45438":605,"_17286":89608,"_5":16822,"_23744":89480,"_7301":89609},[45942],"REMOVE path[, path ...] — delete a field.",{"_11930":655,"_45438":605,"_17286":89611,"_5":16822,"_23744":89480,"_7301":89612},[45942],"ADD path number — atomic numeric increment / decrement on a single field.",{"_11930":656,"_45438":605,"_17286":89614,"_5":16822,"_23744":89480,"_7301":89615},[45942],"DELETE path value — remove a value from an array/set field.",{"_11930":657,"_45438":605,"_17286":89617,"_5":16822,"_23744":89480,"_7301":89618},[45942],"if_not_exists(path, default) — read-then-write helper for conditional defaults.",{"_11930":658,"_45438":605,"_17286":89620,"_5":16822,"_23744":89480,"_7301":89621},[45942],"Because the update runs on the server under the row lock, this is the right primitive\nfor things like per-document counters, idempotent flag flips, and DynamoDB-style\nconditional writes (combine with BSON_CONDITION_EXPRESSION in a WHERE clause).",{"_11930":659,"_45438":605,"_17286":89623,"_5":16822,"_23744":89484,"_7301":89624},[45942],"To make a BSON-field filter fast, create a functional index on the projection:",{"_11930":660,"_45438":605,"_17286":89626,"_5":16822,"_23744":89484,"_7301":89627},[45942],"Combine with INCLUDE (...) to cover other projected columns, or rely on\nuncovered indexes when you only\nfilter on the indexed field.",{"_11930":661,"_45438":605,"_17286":89629,"_5":16822,"_23744":89488,"_7301":89630},[45942],"Putting the pieces together — a customer-preferences scenario backed entirely by a\nsingle BSON column:",{"_11930":662,"_45438":605,"_17286":89632,"_5":16822,"_23744":89492,"_7301":89633},[45942],"A BSON column in a composite primary key must be the last PK column.",{"_11930":663,"_45438":605,"_17286":89635,"_5":16822,"_23744":89492,"_7301":89636},[45942],"The condition/update expression language is intentionally a small document-focused\nDSL, not full SQL. Combine it with regular SQL predicates on relational columns when\nyou need joins, aggregations, or expressions across multiple rows.",{"_11930":664,"_45438":605,"_17286":89638,"_5":16822,"_23744":89492,"_7301":89639},[45942],"Functional indexes on BSON_VALUE(...) are scoped to one specific path/type pair —\nyou'll typically want an index per hot field rather than a generic \"BSON index\".",{"_11930":665,"_45438":665,"_5":12359,"_7301":89641,"_45913":89642,"_17286":89643,"_23744":665},"Bulk Loading",[87622,87623,87624,89312],[45942],{"_11930":666,"_45438":665,"_17286":89645,"_5":16822,"_23744":665,"_7301":89646},[45942],"Load Phoenix tables with PSQL and MapReduce-based CSV/JSON bulk loaders, including options, permissions, and tuning notes.",{"_11930":667,"_45438":665,"_5":45910,"_17286":89648,"_23744":89649,"_7301":89650},[45942],"/docs/features/bulk-loading#sample-data","Sample data",{"_11930":668,"_45438":665,"_5":45910,"_17286":89652,"_23744":89653,"_7301":89654},[45942],"/docs/features/bulk-loading#loading-via-psql","Loading via PSQL",{"_11930":669,"_45438":665,"_5":45910,"_17286":89656,"_23744":89657,"_7301":89658},[45942],"/docs/features/bulk-loading#loading-via-mapreduce","Loading via MapReduce",{"_11930":670,"_45438":665,"_5":45910,"_17286":89660,"_23744":89661,"_7301":89662},[45942],"/docs/features/bulk-loading#notes-on-the-mapreduce-importer","Notes on the MapReduce importer",{"_11930":671,"_45438":665,"_5":45910,"_17286":89664,"_23744":89665,"_7301":89666},[45942],"/docs/features/bulk-loading#permission-issues-when-uploading-hfiles","Permission issues when uploading HFiles",{"_11930":672,"_45438":665,"_5":45910,"_17286":89668,"_23744":89669,"_7301":89670},[45942],"/docs/features/bulk-loading#loading-array-data","Loading array data",{"_11930":673,"_45438":665,"_5":45910,"_17286":89672,"_23744":89673,"_7301":89674},[45942],"/docs/features/bulk-loading#a-note-on-separator-characters","A note on separator characters",{"_11930":674,"_45438":665,"_5":45910,"_17286":89676,"_23744":89677,"_7301":89678},[45942],"/docs/features/bulk-loading#a-note-on-lowercase-tableschema-names","A note on lowercase table/schema names",{"_11930":675,"_45438":665,"_17286":89680,"_5":16822,"_23744":665,"_7301":89681},[45942],"Phoenix provides two methods for bulk loading data into Phoenix tables:",{"_11930":676,"_45438":665,"_17286":89683,"_5":16822,"_23744":665,"_7301":89684},[45942],"Single-threaded client loading tool for CSV-formatted data via the psql command",{"_11930":677,"_45438":665,"_17286":89686,"_5":16822,"_23744":665,"_7301":89687},[45942],"MapReduce-based bulk load tool for CSV and JSON-formatted data",{"_11930":678,"_45438":665,"_17286":89689,"_5":16822,"_23744":665,"_7301":89690},[45942],"The psql tool is typically appropriate for tens of megabytes, while the MapReduce-based loader is typically better for larger load volumes.",{"_11930":679,"_45438":665,"_17286":89692,"_5":16822,"_23744":89649,"_7301":89693},[45942],"For the following examples, assume we have a CSV file named data.csv with this content:",{"_11930":680,"_45438":665,"_17286":89695,"_5":16822,"_23744":89649,"_7301":89696},[45942],"We will use a table with the following structure:",{"_11930":681,"_45438":665,"_17286":89698,"_5":16822,"_23744":89653,"_7301":89699},[45942],"The psql command is invoked via psql.py in the Phoenix bin directory. To load CSV data, provide connection information for your HBase cluster, the target table name, and one or more CSV file paths. All CSV files must use the .csv extension (because arbitrary SQL scripts with the .sql extension can also be supplied on the psql command line).",{"_11930":682,"_45438":665,"_17286":89701,"_5":16822,"_23744":89653,"_7301":89702},[45942],"To load the example data above into HBase running locally:",{"_11930":683,"_45438":665,"_17286":89704,"_5":16822,"_23744":89653,"_7301":89705},[45942],"The following parameters can be used for loading data with psql:",{"_11930":684,"_45438":665,"_17286":89707,"_5":16822,"_23744":89653,"_7301":89708},[45942],"Parameter",{"_11930":685,"_45438":665,"_17286":89710,"_5":16822,"_23744":89653,"_7301":89711},[45942],"Description",{"_11930":686,"_45438":665,"_17286":89713,"_5":16822,"_23744":89653,"_7301":44732},[45942],{"_11930":687,"_45438":665,"_17286":89715,"_5":16822,"_23744":89653,"_7301":89716},[45942],"Provide the target table name. By default, the table name is taken from the CSV file name. This parameter is case-sensitive.",{"_11930":688,"_45438":665,"_17286":89718,"_5":16822,"_23744":89653,"_7301":44758},[45942],{"_11930":689,"_45438":665,"_17286":89720,"_5":16822,"_23744":89653,"_7301":89721},[45942],"Override the column names to which CSV data maps (case-sensitive). A special value of in-line indicates that the first line of the CSV file determines column mapping.",{"_11930":690,"_45438":665,"_17286":89723,"_5":16822,"_23744":89653,"_7301":44772},[45942],{"_11930":691,"_45438":665,"_17286":89725,"_5":16822,"_23744":89653,"_7301":89726},[45942],"Run in strict mode, throwing an error on CSV parsing errors.",{"_11930":692,"_45438":665,"_17286":89728,"_5":16822,"_23744":89653,"_7301":44614},[45942],{"_11930":693,"_45438":665,"_17286":89730,"_5":16822,"_23744":89653,"_7301":89731},[45942],"Supply one or more custom delimiters for CSV parsing.",{"_11930":694,"_45438":665,"_17286":89733,"_5":16822,"_23744":89653,"_7301":44814},[45942],{"_11930":695,"_45438":665,"_17286":89735,"_5":16822,"_23744":89653,"_7301":89736},[45942],"Supply a custom phrase delimiter (defaults to the double quote character).",{"_11930":696,"_45438":665,"_17286":89738,"_5":16822,"_23744":89653,"_7301":44821},[45942],{"_11930":697,"_45438":665,"_17286":89740,"_5":16822,"_23744":89653,"_7301":89741},[45942],"Supply a custom escape character (default is backslash).",{"_11930":698,"_45438":665,"_17286":89743,"_5":16822,"_23744":89653,"_7301":44834},[45942],{"_11930":699,"_45438":665,"_17286":89745,"_5":16822,"_23744":89653,"_7301":89746},[45942],"Supply an array delimiter (explained in more detail below).",{"_11930":700,"_45438":665,"_17286":89748,"_5":16822,"_23744":89657,"_7301":89749},[45942],"For higher-throughput loading distributed across the cluster, the MapReduce loader can be used. This loader first converts data into HFiles, then provides the created HFiles to HBase after HFile creation completes.",{"_11930":701,"_45438":665,"_17286":89751,"_5":16822,"_23744":89657,"_7301":89752},[45942],"The CSV MapReduce loader is launched using the hadoop command with the Phoenix client JAR:",{"_11930":702,"_45438":665,"_17286":89754,"_5":16822,"_23744":89657,"_7301":89755},[45942],"When using Phoenix 4.0 and above, there is a known HBase issue (\"Notice to MapReduce users of HBase 0.96.1 and above\" in the HBase Reference Guide). You should use:",{"_11930":703,"_45438":665,"_17286":89757,"_5":16822,"_23744":89657,"_7301":89758},[45942],"Or:",{"_11930":704,"_45438":665,"_17286":89760,"_5":16822,"_23744":89657,"_7301":89761},[45942],"The JSON MapReduce loader is launched similarly:",{"_11930":705,"_45438":665,"_17286":89763,"_5":16822,"_23744":89657,"_7301":89764},[45942],"The input file must be present on HDFS (not the local filesystem where the command is run).",{"_11930":706,"_45438":665,"_17286":89766,"_5":16822,"_23744":89657,"_7301":89767},[45942],"The following parameters can be used with the MapReduce loader:",{"_11930":707,"_45438":665,"_17286":89769,"_5":16822,"_23744":89657,"_7301":89708},[45942],{"_11930":708,"_45438":665,"_17286":89771,"_5":16822,"_23744":89657,"_7301":89711},[45942],{"_11930":709,"_45438":665,"_17286":89773,"_5":16822,"_23744":89657,"_7301":89774},[45942],"-i,--input",{"_11930":710,"_45438":665,"_17286":89776,"_5":16822,"_23744":89657,"_7301":89777},[45942],"Input CSV path (mandatory)",{"_11930":711,"_45438":665,"_17286":89779,"_5":16822,"_23744":89657,"_7301":89780},[45942],"-t,--table",{"_11930":712,"_45438":665,"_17286":89782,"_5":16822,"_23744":89657,"_7301":89783},[45942],"Phoenix table name (mandatory)",{"_11930":713,"_45438":665,"_17286":89785,"_5":16822,"_23744":89657,"_7301":89786},[45942],"-a,--array-delimiter",{"_11930":714,"_45438":665,"_17286":89788,"_5":16822,"_23744":89657,"_7301":89789},[45942],"Array element delimiter (optional)",{"_11930":715,"_45438":665,"_17286":89791,"_5":16822,"_23744":89657,"_7301":89792},[45942],"-c,--import-columns",{"_11930":716,"_45438":665,"_17286":89794,"_5":16822,"_23744":89657,"_7301":89795},[45942],"Comma-separated list of columns to import",{"_11930":717,"_45438":665,"_17286":89797,"_5":16822,"_23744":89657,"_7301":89798},[45942],"-d,--delimiter",{"_11930":718,"_45438":665,"_17286":89800,"_5":16822,"_23744":89657,"_7301":89801},[45942],"Input delimiter (defaults to comma)",{"_11930":719,"_45438":665,"_17286":89803,"_5":16822,"_23744":89657,"_7301":89804},[45942],"-g,--ignore-errors",{"_11930":720,"_45438":665,"_17286":89806,"_5":16822,"_23744":89657,"_7301":89807},[45942],"Ignore input errors",{"_11930":721,"_45438":665,"_17286":89809,"_5":16822,"_23744":89657,"_7301":89810},[45942],"-o,--output",{"_11930":722,"_45438":665,"_17286":89812,"_5":16822,"_23744":89657,"_7301":89813},[45942],"Output path for temporary HFiles (optional)",{"_11930":723,"_45438":665,"_17286":89815,"_5":16822,"_23744":89657,"_7301":89816},[45942],"-s,--schema",{"_11930":724,"_45438":665,"_17286":89818,"_5":16822,"_23744":89657,"_7301":89819},[45942],"Phoenix schema name (optional)",{"_11930":725,"_45438":665,"_17286":89821,"_5":16822,"_23744":89657,"_7301":89822},[45942],"-z,--zookeeper",{"_11930":726,"_45438":665,"_17286":89824,"_5":16822,"_23744":89657,"_7301":89825},[45942],"ZooKeeper quorum to connect to (optional)",{"_11930":727,"_45438":665,"_17286":89827,"_5":16822,"_23744":89657,"_7301":89828},[45942],"-it,--index-table",{"_11930":728,"_45438":665,"_17286":89830,"_5":16822,"_23744":89657,"_7301":89831},[45942],"Index table name to load (optional)",{"_11930":729,"_45438":665,"_17286":89833,"_5":16822,"_23744":89661,"_7301":89834},[45942],"The current MR-based bulk loader runs one MR job to load your data table and one MR job per index table to populate indexes. Use -it to load only one index table.",{"_11930":730,"_45438":665,"_17286":89836,"_5":16822,"_23744":89665,"_7301":89837},[45942],"There can be issues due to file permissions on created HFiles in the final stage of a bulk load, when HFiles are handed over to HBase. HBase must be able to move the created HFiles, which means it needs write access to the directories where files were written. If not, HFile upload may hang for a long time before failing.",{"_11930":731,"_45438":665,"_17286":89839,"_5":16822,"_23744":89665,"_7301":89840},[45942],"Two common workarounds are:",{"_11930":732,"_45438":665,"_17286":89842,"_5":16822,"_23744":89665,"_7301":89843},[45942],"Run the bulk load process as the hbase user.",{"_11930":733,"_45438":665,"_17286":89845,"_5":16822,"_23744":89665,"_7301":89846},[45942],"Create output files readable/writable for all users.",{"_11930":734,"_45438":665,"_17286":89848,"_5":16822,"_23744":89665,"_7301":89849},[45942],"The first option can be done by running:",{"_11930":735,"_45438":665,"_17286":89851,"_5":16822,"_23744":89665,"_7301":89852},[45942],"Creating output files readable by all can be done by setting fs.permissions.umask-mode to 000. This can be set in Hadoop config on the submit host, or only for job submission:",{"_11930":736,"_45438":665,"_17286":89854,"_5":16822,"_23744":89669,"_7301":89855},[45942],"Both PSQL and MapReduce loaders support array values with -a. Arrays in CSV are represented by a field that uses a different delimiter than the main CSV delimiter. For example, this file represents an id field and an array of integers:",{"_11930":737,"_45438":665,"_17286":89857,"_5":16822,"_23744":89669,"_7301":89858},[45942],"To load this file, use the default CSV delimiter (comma) and pass colon as the array delimiter via -a ':'.",{"_11930":738,"_45438":665,"_17286":89860,"_5":16822,"_23744":89673,"_7301":89861},[45942],"The default separator for both loaders is comma (,). A common separator for input files is tab, which can be tricky to pass on the command line. A common mistake is:",{"_11930":739,"_45438":665,"_17286":89863,"_5":16822,"_23744":89673,"_7301":89864},[45942],"This does not work because the shell passes two characters (backslash and t) to Phoenix.",{"_11930":740,"_45438":665,"_17286":89866,"_5":16822,"_23744":89673,"_7301":89867},[45942],"Two working approaches:",{"_11930":741,"_45438":665,"_17286":89869,"_5":16822,"_23744":89673,"_7301":89870},[45942],"Prefix the string representation of tab with $:",{"_11930":742,"_45438":665,"_17286":89872,"_5":16822,"_23744":89673,"_7301":89873},[45942],"Enter the separator as Ctrl+v and then press tab:",{"_11930":743,"_45438":665,"_17286":89875,"_5":16822,"_23744":89677,"_7301":89876},[45942],"Table names in Phoenix are case-insensitive (generally uppercase), but users may need to map an existing lowercase HBase table name into Phoenix. In this case, double quotes around the table name (for example, \"tablename\") preserve case sensitivity.",{"_11930":744,"_45438":665,"_17286":89878,"_5":16822,"_23744":89677,"_7301":89879},[45942],"This support was extended to bulk load options. However, due to how Apache Commons CLI parses command-line options (CLI-275), pass the argument as \\\"\\\"tablename\\\"\\\" instead of just \"tablename\" for CsvBulkLoadTool.",{"_11930":745,"_45438":665,"_17286":89881,"_5":16822,"_23744":89677,"_7301":89212},[45942],{"_11930":746,"_45438":746,"_5":12359,"_7301":89883,"_45913":89884,"_17286":89885,"_23744":746},"Change Data Capture (CDC)",[87622,87623,87624,89312],[45942],{"_11930":747,"_45438":746,"_17286":89887,"_5":16822,"_23744":746,"_7301":89888},[45942],"Query row-level change events on a Phoenix table using standard SQL — pull pre/post images and change deltas with bounded, resumable reads.",{"_11930":748,"_45438":746,"_5":45910,"_17286":89890,"_23744":89891,"_7301":89892},[45942],"/docs/features/change-data-capture#cdc-when","When to use it",{"_11930":749,"_45438":746,"_5":45910,"_17286":89894,"_23744":89895,"_7301":89896},[45942],"/docs/features/change-data-capture#cdc-enable","Enabling CDC on a table",{"_11930":750,"_45438":746,"_5":45910,"_17286":89898,"_23744":89899,"_7301":89900},[45942],"/docs/features/change-data-capture#cdc-read","Reading change events",{"_11930":751,"_45438":746,"_5":45910,"_17286":89902,"_23744":89903,"_7301":89904},[45942],"/docs/features/change-data-capture#time-bounded--incremental-reads","Time-bounded / incremental reads",{"_11930":752,"_45438":746,"_5":45910,"_17286":89906,"_23744":89907,"_7301":89908},[45942],"/docs/features/change-data-capture#per-partition-reads","Per-partition reads",{"_11930":753,"_45438":746,"_5":45910,"_17286":89910,"_23744":89911,"_7301":89912},[45942],"/docs/features/change-data-capture#cdc-lineage","Stream lineage: partitions, splits, and merges",{"_11930":754,"_45438":746,"_5":45910,"_17286":89914,"_23744":89915,"_7301":89916},[45942],"/docs/features/change-data-capture#consuming-events-in-parent--child-order","Consuming events in parent → child order",{"_11930":755,"_45438":746,"_5":45910,"_17286":89918,"_23744":89919,"_7301":89920},[45942],"/docs/features/change-data-capture#cdc-special-events","Special event types",{"_11930":756,"_45438":746,"_5":45910,"_17286":89922,"_23744":89923,"_7301":89924},[45942],"/docs/features/change-data-capture#cdc-ops","Operational notes",{"_11930":757,"_45438":746,"_17286":89926,"_5":16822,"_23744":746,"_7301":89927},[45942],"Change Data Capture turns a Phoenix table into a stream of change events that\ndownstream consumers can read using regular SQL. Once enabled, a CDC object behaves\nlike a queryable Phoenix table: every insert, update, and delete on the underlying\ndata table produces a row containing the affected primary key, an event timestamp,\nand a JSON payload describing what changed. Available in Phoenix 5.3.0\n(PHOENIX-7001).",{"_11930":758,"_45438":746,"_17286":89929,"_5":16822,"_23744":89891,"_7301":89930},[45942],"Reach for CDC when something downstream needs to react to row-level changes:",{"_11930":759,"_45438":746,"_17286":89932,"_5":16822,"_23744":89891,"_7301":89933},[45942],"Replication or mirroring to another store (Kafka, search index, data warehouse).",{"_11930":760,"_45438":746,"_17286":89935,"_5":16822,"_23744":89891,"_7301":89936},[45942],"Audit logs and change history.",{"_11930":761,"_45438":746,"_17286":89938,"_5":16822,"_23744":89891,"_7301":89939},[45942],"Cache invalidation and event-driven workflows.",{"_11930":762,"_45438":746,"_17286":89941,"_5":16822,"_23744":89891,"_7301":89942},[45942],"Materialized projections / fan-out tables maintained by an external process.",{"_11930":763,"_45438":746,"_17286":89944,"_5":16822,"_23744":89891,"_7301":89945},[45942],"CDC captures the actual mutations as they happen — including TTL-driven row\ndeletes — so consumers don't need to poll the data table or compute diffs.",{"_11930":764,"_45438":746,"_17286":89947,"_5":16822,"_23744":89895,"_7301":89948},[45942],"Use CREATE CDC to enable change capture on an existing table:",{"_11930":765,"_45438":746,"_17286":89950,"_5":16822,"_23744":89895,"_7301":89951},[45942],"The INCLUDE clause sets the default scopes that appear in the JSON payload.\nAvailable scopes:",{"_11930":766,"_45438":746,"_17286":89953,"_5":16822,"_23744":89895,"_7301":89954},[45942],"Scope",{"_11930":767,"_45438":746,"_17286":89956,"_5":16822,"_23744":89895,"_7301":89957},[45942],"Meaning",{"_11930":768,"_45438":746,"_17286":89959,"_5":16822,"_23744":89895,"_7301":89960},[45942],"PRE",{"_11930":769,"_45438":746,"_17286":89962,"_5":16822,"_23744":89895,"_7301":89963},[45942],"Row image before the mutation.",{"_11930":770,"_45438":746,"_17286":89965,"_5":16822,"_23744":89895,"_7301":89966},[45942],"POST",{"_11930":771,"_45438":746,"_17286":89968,"_5":16822,"_23744":89895,"_7301":89969},[45942],"Row image after the mutation.",{"_11930":772,"_45438":746,"_17286":89971,"_5":16822,"_23744":89895,"_7301":89972},[45942],"CHANGE",{"_11930":773,"_45438":746,"_17286":89974,"_5":16822,"_23744":89895,"_7301":89975},[45942],"Just the changed columns (diff).",{"_11930":774,"_45438":746,"_17286":89977,"_5":16822,"_23744":89895,"_7301":89978},[45942],"Standard CREATE INDEX–style table properties on CREATE CDC (SALT_BUCKETS,\nUPDATE_CACHE_FREQUENCY, COLUMN_ENCODED_BYTES, etc.) are forwarded to the\nunderlying CDC index.",{"_11930":775,"_45438":746,"_17286":89980,"_5":16822,"_23744":89895,"_7301":89981},[45942],"To remove CDC from a table:",{"_11930":776,"_45438":746,"_17286":89983,"_5":16822,"_23744":89899,"_7301":89984},[45942],"Each CDC object behaves like a Phoenix table whose columns are:",{"_11930":777,"_45438":746,"_17286":89986,"_5":16822,"_23744":89899,"_7301":89987},[45942],"The data table's primary-key columns (so you know which row changed).",{"_11930":778,"_45438":746,"_17286":89989,"_5":16822,"_23744":89899,"_7301":89990},[45942],"A payload column literally named \"CDC JSON\" (case-sensitive, must be quoted).\nProject it whenever you need the change payload; omit it for lightweight queries\nthat only care about which rows changed or for topology lookups. SELECT *\nincludes it automatically.",{"_11930":779,"_45438":746,"_17286":89992,"_5":16822,"_23744":89899,"_7301":89993},[45942],"Two helpers come along for the ride:",{"_11930":780,"_45438":746,"_17286":89995,"_5":16822,"_23744":89899,"_7301":89996},[45942],"PHOENIX_ROW_TIMESTAMP() — the event's timestamp; use it for ordering and time-\nbounded reads.",{"_11930":781,"_45438":746,"_17286":89998,"_5":16822,"_23744":89899,"_7301":89999},[45942],"PARTITION_ID() — the partition the event came from; useful for sharding consumer\nworkers.",{"_11930":782,"_45438":746,"_17286":90001,"_5":16822,"_23744":89899,"_7301":90002},[45942],"A typical read query that wants the full payload looks like this:",{"_11930":783,"_45438":746,"_17286":90004,"_5":16822,"_23744":89899,"_7301":90005},[45942],"The CDC_INCLUDE(...) query hint overrides the default scopes set at CREATE\nCDC time — so the same CDC object can serve different downstream consumers, each\nasking for only the scope they need. Without the hint, the payload uses the\nINCLUDE scopes from the CREATE CDC statement.",{"_11930":784,"_45438":746,"_17286":90007,"_5":16822,"_23744":89903,"_7301":90008},[45942],"Use PHOENIX_ROW_TIMESTAMP() predicates to pull only events within a window —\nconsumers typically remember the last timestamp they processed and bind it as the\nlower bound on the next call:",{"_11930":785,"_45438":746,"_17286":90010,"_5":16822,"_23744":89907,"_7301":90011},[45942],"Partitions track HBase regions of the data table, so you can shard a consumer pool\nacross them. Discover partitions with:",{"_11930":786,"_45438":746,"_17286":90013,"_5":16822,"_23744":89907,"_7301":90014},[45942],"Then issue per-partition reads:",{"_11930":787,"_45438":746,"_17286":90016,"_5":16822,"_23744":89911,"_7301":90017},[45942],"A CDC stream is logically a set of partitions, each carrying a totally-ordered\nsequence of change events. A partition isn't an abstract shard — it corresponds to a\nspecific HBase region of the data table at a point in time, and it has a finite\nlifetime: it's born when the region is created (or as the result of a split/merge)\nand it's closed when that region itself splits or merges into something new. New\nchild partitions take over from there.",{"_11930":788,"_45438":746,"_17286":90019,"_5":16822,"_23744":89911,"_7301":90020},[45942],"Phoenix tracks this topology in SYSTEM.CDC_STREAM. The schema makes the lineage\nexplicit — every partition row points at its parent partition(s):",{"_11930":789,"_45438":746,"_17286":90022,"_5":16822,"_23744":89911,"_7301":90023},[45942],"Column",{"_11930":790,"_45438":746,"_17286":90025,"_5":16822,"_23744":89911,"_7301":90026},[45942],"Notes",{"_11930":791,"_45438":746,"_17286":90028,"_5":16822,"_23744":89911,"_7301":90029},[45942],"TABLE_NAME",{"_11930":792,"_45438":746,"_17286":90031,"_5":16822,"_23744":89911,"_7301":90032},[45942],"The data table whose changes are streamed.",{"_11930":793,"_45438":746,"_17286":90034,"_5":16822,"_23744":89911,"_7301":90035},[45942],"STREAM_NAME",{"_11930":794,"_45438":746,"_17286":90037,"_5":16822,"_23744":89911,"_7301":90038},[45942],"The CDC stream (each CREATE CDC produces a uniquely-named stream).",{"_11930":795,"_45438":746,"_17286":90040,"_5":16822,"_23744":89911,"_7301":90041},[45942],"PARTITION_ID",{"_11930":796,"_45438":746,"_17286":90043,"_5":16822,"_23744":89911,"_7301":90044},[45942],"This partition's id — same value PARTITION_ID() returns on a CDC row.",{"_11930":797,"_45438":746,"_17286":90046,"_5":16822,"_23744":89911,"_7301":90047},[45942],"PARENT_PARTITION_ID",{"_11930":798,"_45438":746,"_17286":90049,"_5":16822,"_23744":89911,"_7301":90050},[45942],"The parent partition's id (empty/null for the initial partitions present when CDC was first enabled).",{"_11930":799,"_45438":746,"_17286":90052,"_5":16822,"_23744":89911,"_7301":90053},[45942],"PARTITION_START_TIME",{"_11930":800,"_45438":746,"_17286":90055,"_5":16822,"_23744":89911,"_7301":90056},[45942],"When this partition began.",{"_11930":801,"_45438":746,"_17286":90058,"_5":16822,"_23744":89911,"_7301":90059},[45942],"PARTITION_END_TIME",{"_11930":802,"_45438":746,"_17286":90061,"_5":16822,"_23744":89911,"_7301":90062},[45942],"When it was closed (a split or merge ended it). NULL while still active.",{"_11930":803,"_45438":746,"_17286":90064,"_5":16822,"_23744":89911,"_7301":90065},[45942],"PARTITION_START_KEY / _END_KEY",{"_11930":804,"_45438":746,"_17286":90067,"_5":16822,"_23744":89911,"_7301":90068},[45942],"The HBase region's row-key bounds at the time, stored as VARBINARY_ENCODED.",{"_11930":805,"_45438":746,"_17286":90070,"_5":16822,"_23744":89911,"_7301":90071},[45942],"PARENT_PARTITION_START_TIME",{"_11930":806,"_45438":746,"_17286":90073,"_5":16822,"_23744":89911,"_7301":90074},[45942],"The parent partition's PARTITION_START_TIME, embedded so consumers can walk parent → child without an extra join.",{"_11930":807,"_45438":746,"_17286":90076,"_5":16822,"_23744":89911,"_7301":90077},[45942],"Two important shapes fall out of this model:",{"_11930":808,"_45438":746,"_17286":90079,"_5":16822,"_23744":89911,"_7301":90080},[45942],"A split produces two child rows that share the same PARENT_PARTITION_ID (the\nregion that just split). Their key ranges together cover the parent's range.",{"_11930":809,"_45438":746,"_17286":90082,"_5":16822,"_23744":89911,"_7301":90083},[45942],"A merge produces one child partition with multiple rows in SYSTEM.CDC_STREAM —\none row per parent — sharing the same PARTITION_ID and differing only in\nPARENT_PARTITION_ID. Together those rows record every parent that fed the merge.",{"_11930":810,"_45438":746,"_17286":90085,"_5":16822,"_23744":89915,"_7301":90086},[45942],"Because events from a parent partition causally precede events from any of its\nchildren, a correct consumer must drain the parent before reading children that\ndescend from it. The pattern is:",{"_11930":811,"_45438":746,"_17286":90088,"_5":16822,"_23744":89915,"_7301":90089},[45942],"Discover the topology by reading SYSTEM.CDC_STREAM for your table and\nstream. Build a DAG keyed by PARTITION_ID, with edges drawn from\nPARENT_PARTITION_ID → child PARTITION_ID. Roots are partitions with no\nparent (the regions present when CDC was first enabled).",{"_11930":812,"_45438":746,"_17286":90091,"_5":16822,"_23744":89915,"_7301":90092},[45942],"Process roots first, then walk forward through the DAG. A child partition is\nready to be consumed once all of its parents have been fully drained — for\nmerges, that means all rows in SYSTEM.CDC_STREAM with the same child\nPARTITION_ID have had their parent partitions processed.",{"_11930":813,"_45438":746,"_17286":90094,"_5":16822,"_23744":89915,"_7301":90095},[45942],"For each partition, query the CDC object scoped to that partition and the\ntime window the partition was live:",{"_11930":814,"_45438":746,"_17286":90097,"_5":16822,"_23744":89915,"_7301":90098},[45942],"Re-poll the topology periodically. New rows appear in SYSTEM.CDC_STREAM\nwhen regions split or merge; consumers refresh their DAG to pick up the new\nchildren before existing partitions close.",{"_11930":815,"_45438":746,"_17286":90100,"_5":16822,"_23744":89915,"_7301":90101},[45942],"This is the same shard-lineage model used by DynamoDB Streams — if you're porting a\nDynamoDB Streams consumer, the bookkeeping translates almost directly.",{"_11930":816,"_45438":746,"_17286":90103,"_5":16822,"_23744":89919,"_7301":90104},[45942],"TTL-driven deletes (rows aged out by time-based or\nconditional TTL) produce CDC events alongside\napplication-issued mutations, so consumers don't have to reconcile retention-driven\nremovals separately.",{"_11930":817,"_45438":746,"_17286":90106,"_5":16822,"_23744":89919,"_7301":90107},[45942],"ARRAY and JSON columns in the data table are serialized as simple values\ninside the \"CDC JSON\" payload.",{"_11930":818,"_45438":746,"_17286":90109,"_5":16822,"_23744":89919,"_7301":90110},[45942],"Case-sensitive identifiers on the data table and its primary-key columns are\npreserved end to end in events.",{"_11930":819,"_45438":746,"_17286":90112,"_5":16822,"_23744":89923,"_7301":90113},[45942],"When the underlying data table is dropped, its CDC stream metadata in\nSYSTEM.CDC_STREAM is cleaned up automatically — you don't have to drop the CDC\nobject first.",{"_11930":820,"_45438":746,"_17286":90115,"_5":16822,"_23744":89923,"_7301":90116},[45942],"The CDC object is internally backed by a partitioned secondary index on the data\ntable, but it's not used to satisfy regular queries against the data table —\nthere's no read penalty on the data table from enabling CDC.",{"_11930":821,"_45438":746,"_17286":90118,"_5":16822,"_23744":89923,"_7301":90119},[45942],"Re-creating CDC after a drop produces a distinct stream (the stream name is\naugmented with creation time), so consumers can detect the boundary and reset\ntheir offsets cleanly.",{"_11930":822,"_45438":822,"_5":12359,"_7301":90121,"_45913":90122,"_17286":90123,"_23744":822},"Conditional TTL",[87622,87623,87624,89312],[45942],{"_11930":823,"_45438":822,"_17286":90125,"_5":16822,"_23744":822,"_7301":90126},[45942],"Express row expiration as a SQL boolean expression evaluated against the row itself.",{"_11930":824,"_45438":822,"_5":45910,"_17286":90128,"_23744":90129,"_7301":89892},[45942],"/docs/features/conditional-ttl#conditional-ttl-when",{"_11930":825,"_45438":822,"_5":45910,"_17286":90131,"_23744":90132,"_7301":90133},[45942],"/docs/features/conditional-ttl#conditional-ttl-define","Defining a conditional TTL",{"_11930":826,"_45438":822,"_5":45910,"_17286":90135,"_23744":90136,"_7301":90137},[45942],"/docs/features/conditional-ttl#conditional-ttl-write-path","Effect on the write path",{"_11930":827,"_45438":822,"_5":45910,"_17286":90139,"_23744":90140,"_7301":87744},[45942],"/docs/features/conditional-ttl#conditional-ttl-limitations",{"_11930":828,"_45438":822,"_17286":90142,"_5":16822,"_23744":822,"_7301":90143},[45942],"Conditional TTL lets you express row expiration as a SQL boolean expression\nevaluated against the row's own column values, instead of a fixed time-since-write\nnumber. A row is considered expired the moment the expression evaluates to TRUE for\nthat row. Available in Phoenix 5.3.0\n(PHOENIX-7170).",{"_11930":829,"_45438":822,"_17286":90145,"_5":16822,"_23744":90129,"_7301":90146},[45942],"Conditional TTL fits whenever \"expired\" is an application concept, not just an\nage. Some typical cases:",{"_11930":830,"_45438":822,"_17286":90148,"_5":16822,"_23744":90129,"_7301":90149},[45942],"\"Delete this row 30 days after STATUS becomes 'CLOSED'.\"",{"_11930":831,"_45438":822,"_17286":90151,"_5":16822,"_23744":90129,"_7301":90152},[45942],"\"Expire when RETAIN_UNTIL has passed.\"",{"_11930":832,"_45438":822,"_17286":90154,"_5":16822,"_23744":90129,"_7301":90155},[45942],"\"Keep failed records for a week, successful ones for an hour.\"",{"_11930":833,"_45438":822,"_17286":90157,"_5":16822,"_23744":90129,"_7301":90158},[45942],"\"Expire soft-deleted rows (is_deleted = TRUE) after a grace period.\"",{"_11930":834,"_45438":822,"_17286":90160,"_5":16822,"_23744":90129,"_7301":90161},[45942],"If retention is a flat duration that applies uniformly to all rows, use the regular\ntime-based TTL property. If different views over the same shared table need\ndifferent retention rules, look at View TTL — it composes\nwith conditional TTL.",{"_11930":835,"_45438":822,"_17286":90163,"_5":16822,"_23744":90132,"_7301":90164},[45942],"Pass a SQL boolean expression as the TTL table property at CREATE TABLE (or\nCREATE VIEW) time. The expression may reference any column of the table:",{"_11930":836,"_45438":822,"_17286":90166,"_5":16822,"_23744":90132,"_7301":90167},[45942],"Update or remove the expression later with ALTER TABLE:",{"_11930":837,"_45438":822,"_17286":90169,"_5":16822,"_23744":90132,"_7301":90170},[45942],"What \"expired\" means in practice:",{"_11930":838,"_45438":822,"_17286":90172,"_5":16822,"_23744":90132,"_7301":90173},[45942],"Read-time: any query touching the row evaluates the TTL expression server-side\nand skips the row if it returns TRUE. Rows become invisible the moment they\nmatch the predicate, regardless of physical state.",{"_11930":839,"_45438":822,"_17286":90175,"_5":16822,"_23744":90132,"_7301":90176},[45942],"Phoenix compaction: expired rows are physically removed by Phoenix's\ncompaction during HBase region compactions. There is no separate cleanup job —\nphysical removal happens whenever the underlying regions compact.",{"_11930":840,"_45438":822,"_17286":90178,"_5":16822,"_23744":90136,"_7301":90179},[45942],"IS_STRICT_TTL is a table property that applies to any kind of TTL — see\nStrict vs Relaxed TTL for the full\ndescription.",{"_11930":841,"_45438":822,"_17286":90181,"_5":16822,"_23744":90136,"_7301":90182},[45942],"The conditional-TTL-specific cost is in the write path: with strict (the\ndefault), every mutation reads the current row state on the server to evaluate the\nTTL expression, which adds latency. With relaxed (IS_STRICT_TTL = false), that\nextra row read is skipped — at the cost of expired rows remaining visible to\nreaders until major compaction physically removes them.",{"_11930":842,"_45438":822,"_17286":90184,"_5":16822,"_23744":90140,"_7301":90185},[45942],"Conditional TTL requires the table to have a single column family.",{"_11930":843,"_45438":822,"_17286":90187,"_5":16822,"_23744":90140,"_7301":90188},[45942],"The TTL expression must be a valid Phoenix SQL boolean expression and may only\nreference columns of the same table — no joins, no subqueries.",{"_11930":844,"_45438":822,"_17286":90190,"_5":16822,"_23744":90140,"_7301":90191},[45942],"The classic time-based TTL = N (seconds) and conditional TTL = '<expr>' use the\nsame property; what you pass in determines which mode you get. You can't have both\nat once.",{"_11930":845,"_45438":845,"_5":12359,"_7301":90193,"_45913":90194,"_17286":90195,"_23744":845},"Cursor",[87622,87623,87624,89312],[45942],{"_11930":846,"_45438":845,"_17286":90197,"_5":16822,"_23744":845,"_7301":90198},[45942],"Use CURSOR statements in Phoenix to process query results in controlled row batches.",{"_11930":847,"_45438":845,"_5":45910,"_17286":90200,"_23744":90201,"_7301":90202},[45942],"/docs/features/cursor#using-a-cursor","Using a cursor",{"_11930":848,"_45438":845,"_17286":90204,"_5":16822,"_23744":845,"_7301":90205},[45942],"To work on a subset of rows from a query, Phoenix supports a CURSOR control structure. The sequence below shows how to use a cursor.",{"_11930":849,"_45438":845,"_17286":90207,"_5":16822,"_23744":90201,"_7301":90208},[45942],"Define a cursor for a query using the DECLARE statement.",{"_11930":850,"_45438":845,"_17286":90210,"_5":16822,"_23744":90201,"_7301":90211},[45942],"Open the cursor.",{"_11930":851,"_45438":845,"_17286":90213,"_5":16822,"_23744":90201,"_7301":90214},[45942],"Fetch a subset of rows to work with.",{"_11930":852,"_45438":845,"_17286":90216,"_5":16822,"_23744":90201,"_7301":90217},[45942],"Iterate through the fetched rows and process them as required.",{"_11930":853,"_45438":845,"_17286":90219,"_5":16822,"_23744":90201,"_7301":90220},[45942],"Fetch additional sets of rows as needed, and close the cursor when done.",{"_11930":854,"_45438":854,"_5":12359,"_7301":89516,"_45913":90222,"_17286":90223,"_23744":854},[87622,87623,87624,89312],[45942],{"_11930":855,"_45438":854,"_17286":90225,"_5":16822,"_23744":854,"_7301":90226},[45942],"Define and query late-bound dynamic columns in Phoenix when full schema cannot be declared upfront.",{"_11930":856,"_45438":854,"_17286":90228,"_5":16822,"_23744":854,"_7301":90229},[45942],"Sometimes defining a static schema up front is not feasible. Instead, a subset of columns may be specified at table create time while the rest are specified at query time. As of Phoenix 1.2, dynamic columns are supported by allowing column definitions in parentheses after the table name in the FROM clause of a SELECT statement. Although this is not standard SQL, it is useful for leveraging the late-binding capability of HBase.",{"_11930":857,"_45438":854,"_17286":90231,"_5":16822,"_23744":854,"_7301":90232},[45942],"For example:",{"_11930":858,"_45438":854,"_17286":90234,"_5":16822,"_23744":854,"_7301":90235},[45942],"You might define only a subset of event columns at create time, because each event type can have different properties:",{"_11930":859,"_45438":854,"_17286":90237,"_5":16822,"_23744":854,"_7301":90238},[45942],"To upsert a row with dynamic columns:",{"_11930":860,"_45438":860,"_5":12359,"_7301":90240,"_45913":90241,"_17286":90242,"_23744":860},"Metrics",[87622,87623,87624,89312],[45942],{"_11930":861,"_45438":860,"_17286":90244,"_5":16822,"_23744":860,"_7301":90245},[45942],"Request-level and global Phoenix client metrics, with practical usage patterns and Java examples.",{"_11930":862,"_45438":860,"_5":45910,"_17286":90247,"_23744":90248,"_7301":90249},[45942],"/docs/features/metrics#request-level-metrics","Request-level metrics",{"_11930":863,"_45438":860,"_5":45910,"_17286":90251,"_23744":90252,"_7301":90253},[45942],"/docs/features/metrics#mutation-metrics","Mutation metrics",{"_11930":864,"_45438":860,"_5":45910,"_17286":90255,"_23744":90256,"_7301":90257},[45942],"/docs/features/metrics#scan-task-metrics","Scan task metrics",{"_11930":865,"_45438":860,"_5":45910,"_17286":90259,"_23744":90260,"_7301":90261},[45942],"/docs/features/metrics#overall-query-metrics","Overall query metrics",{"_11930":866,"_45438":860,"_5":45910,"_17286":90263,"_23744":90264,"_7301":90265},[45942],"/docs/features/metrics#how-to-use-sql-statement-level-metrics","How to use SQL statement-level metrics",{"_11930":867,"_45438":860,"_17286":90267,"_5":16822,"_23744":860,"_7301":90268},[45942],"Phoenix surfaces various metrics that provide an insight into what is going on within the Phoenix client as it is executing various SQL statements. These metrics are collected within the client JVM in two ways:",{"_11930":868,"_45438":860,"_17286":90270,"_5":16822,"_23744":860,"_7301":90271},[45942],"Request level metrics - collected at an individual SQL statement level",{"_11930":869,"_45438":860,"_17286":90273,"_5":16822,"_23744":860,"_7301":90274},[45942],"Global metrics - collected at the client JVM level",{"_11930":870,"_45438":860,"_17286":90276,"_5":16822,"_23744":860,"_7301":90277},[45942],"Request level metrics are helpful for figuring out at a more granular level about the amount of work done by every SQL statement executed by Phoenix. These metrics can be classified into three categories:",{"_11930":871,"_45438":860,"_17286":90279,"_5":16822,"_23744":90252,"_7301":90280},[45942],"MUTATION_BATCH_SIZE - Batch sizes of mutations",{"_11930":872,"_45438":860,"_17286":90282,"_5":16822,"_23744":90252,"_7301":90283},[45942],"MUTATION_BYTES - Size of mutations in bytes",{"_11930":873,"_45438":860,"_17286":90285,"_5":16822,"_23744":90252,"_7301":90286},[45942],"MUTATION_COMMIT_TIME - Time it took to commit mutations",{"_11930":874,"_45438":860,"_17286":90288,"_5":16822,"_23744":90256,"_7301":90289},[45942],"NUM_PARALLEL_SCANS - Number of scans executed in parallel",{"_11930":875,"_45438":860,"_17286":90291,"_5":16822,"_23744":90256,"_7301":90292},[45942],"SCAN_BYTES - Number of bytes read by scans",{"_11930":876,"_45438":860,"_17286":90294,"_5":16822,"_23744":90256,"_7301":90295},[45942],"MEMORY_CHUNK_BYTES - Number of bytes allocated by the memory manager",{"_11930":877,"_45438":860,"_17286":90297,"_5":16822,"_23744":90256,"_7301":90298},[45942],"MEMORY_WAIT_TIME - Time in milliseconds threads needed to wait for memory to be allocated through memory manager",{"_11930":878,"_45438":860,"_17286":90300,"_5":16822,"_23744":90256,"_7301":90301},[45942],"SPOOL_FILE_SIZE - Size of spool files created in bytes",{"_11930":879,"_45438":860,"_17286":90303,"_5":16822,"_23744":90256,"_7301":90304},[45942],"SPOOL_FILE_COUNTER - Number of spool files created",{"_11930":880,"_45438":860,"_17286":90306,"_5":16822,"_23744":90256,"_7301":90307},[45942],"CACHE_REFRESH_SPLITS_COUNTER - Number of times Phoenix's metadata cache was refreshed because of splits",{"_11930":881,"_45438":860,"_17286":90309,"_5":16822,"_23744":90256,"_7301":90310},[45942],"TASK_QUEUE_WAIT_TIME - Time in milliseconds tasks had to wait in the queue of the thread pool executor",{"_11930":882,"_45438":860,"_17286":90312,"_5":16822,"_23744":90256,"_7301":90313},[45942],"TASK_END_TO_END_TIME - Time in milliseconds spent by tasks from creation to completion",{"_11930":883,"_45438":860,"_17286":90315,"_5":16822,"_23744":90256,"_7301":90316},[45942],"TASK_EXECUTION_TIME - Time in milliseconds tasks took to execute",{"_11930":884,"_45438":860,"_17286":90318,"_5":16822,"_23744":90256,"_7301":90319},[45942],"TASK_EXECUTED_COUNTER - Counter for number of tasks submitted to the thread pool executor",{"_11930":885,"_45438":860,"_17286":90321,"_5":16822,"_23744":90256,"_7301":90322},[45942],"TASK_REJECTED_COUNTER - Counter for number of tasks that were rejected by the thread pool executor",{"_11930":886,"_45438":860,"_17286":90324,"_5":16822,"_23744":90260,"_7301":90325},[45942],"QUERY_TIMEOUT_COUNTER - Number of times query timed out",{"_11930":887,"_45438":860,"_17286":90327,"_5":16822,"_23744":90260,"_7301":90328},[45942],"QUERY_FAILED_COUNTER - Number of times query failed",{"_11930":888,"_45438":860,"_17286":90330,"_5":16822,"_23744":90260,"_7301":90331},[45942],"WALL_CLOCK_TIME_MS - Wall clock time elapsed for the overall query execution",{"_11930":889,"_45438":860,"_17286":90333,"_5":16822,"_23744":90260,"_7301":90334},[45942],"RESULT_SET_TIME_MS - Wall clock time elapsed for reading all records using resultSet.next()",{"_11930":890,"_45438":860,"_17286":90336,"_5":16822,"_23744":90264,"_7301":90337},[45942],"Log and report query execution details which could be later used for analysis.",{"_11930":891,"_45438":860,"_17286":90339,"_5":16822,"_23744":90264,"_7301":90340},[45942],"Report top SQL queries by duration. Metric to use: WALL_CLOCK_TIME_MS.",{"_11930":892,"_45438":860,"_17286":90342,"_5":16822,"_23744":90264,"_7301":90343},[45942],"Check if the query is failing because it is timing out. Metric to use: QUERY_TIMEOUT_COUNTER > 0.",{"_11930":893,"_45438":860,"_17286":90345,"_5":16822,"_23744":90264,"_7301":90346},[45942],"Monitor the amount of bytes being written to or read from HBase for a SQL statement. Metrics to use: MUTATION_BYTES and SCAN_BYTES.",{"_11930":894,"_45438":860,"_17286":90348,"_5":16822,"_23744":90264,"_7301":90349},[45942],"Check if the query is doing too much work or needs tuning. Possible metrics to use: TASK_EXECUTED_COUNTER, TASK_QUEUE_WAIT_TIME, WALL_CLOCK_TIME_MS.",{"_11930":895,"_45438":860,"_17286":90351,"_5":16822,"_23744":90264,"_7301":90352},[45942],"Check if a successful query is facing thread starvation, i.e., number of threads in the thread pool likely needs to be increased. This is characterized by a relatively large difference between TASK_EXECUTION_TIME and TASK_END_TO_END_TIME.",{"_11930":896,"_45438":860,"_17286":90354,"_5":16822,"_23744":90264,"_7301":90355},[45942],"Request level metrics can be turned on/off for every Phoenix JDBC connection. Below is an example of how you can do that:",{"_11930":897,"_45438":860,"_17286":90357,"_5":16822,"_23744":90264,"_7301":90358},[45942],"A typical pattern for how one could get hold of read metrics for queries:",{"_11930":898,"_45438":860,"_17286":90360,"_5":16822,"_23744":90264,"_7301":90361},[45942],"One could also get hold of write related metrics (collected per table) for DML statements by doing something like this:",{"_11930":899,"_45438":860,"_17286":90363,"_5":16822,"_23744":90264,"_7301":90364},[45942],"Global metrics on the other hand are collected at the Phoenix client’s JVM level. These metrics could be used for building out a trend and seeing what is going on within Phoenix from client’s perspective over time. Other than the metrics reported above for request level metrics, the global metrics also includes the following counters:",{"_11930":900,"_45438":860,"_17286":90366,"_5":16822,"_23744":90264,"_7301":90367},[45942],"MUTATION_SQL_COUNTER - Counter for number of mutation SQL statements",{"_11930":901,"_45438":860,"_17286":90369,"_5":16822,"_23744":90264,"_7301":90370},[45942],"SELECT_SQL_COUNTER - Counter for number of SQL queries",{"_11930":902,"_45438":860,"_17286":90372,"_5":16822,"_23744":90264,"_7301":90373},[45942],"OPEN_PHOENIX_CONNECTIONS_COUNTER - Number of open Phoenix connections",{"_11930":903,"_45438":860,"_17286":90375,"_5":16822,"_23744":90264,"_7301":90376},[45942],"Global metrics could be helpful in monitoring and tuning various aspects of the execution environment. For example: an increase in TASK_REJECTED_COUNTER is probably a symptom of too much work being submitted, or that the Phoenix thread pool queue depth or number of threads (or both) needs to be increased. Similarly, a spike in TASK_EXECUTION_TIME for a time frame could be symptomatic of several things including overloaded region servers, a network glitch, or client/region servers undergoing garbage collection.",{"_11930":904,"_45438":860,"_17286":90378,"_5":16822,"_23744":90264,"_7301":90379},[45942],"Collection of global client metrics can be turned on/off (on by default) by setting the attribute phoenix.query.global.metrics.enabled to true/false in the client side hbase-site.xml.\nBelow is a code snippet showing how to log/report global metrics by using a scheduled job that runs periodically:",{"_11930":905,"_45438":905,"_5":12359,"_7301":90381,"_45913":90382,"_17286":90383,"_23744":905},"Multi-tenancy",[87622,87623,87624,89312],[45942],{"_11930":906,"_45438":905,"_17286":90385,"_5":16822,"_23744":905,"_7301":90386},[45942],"Use multi-tenant tables, tenant-specific connections, and tenant views to isolate tenant data in Phoenix.",{"_11930":907,"_45438":905,"_5":45910,"_17286":90388,"_23744":90389,"_7301":90390},[45942],"/docs/features/multi-tenancy#highlights","Highlights",{"_11930":908,"_45438":905,"_5":45910,"_17286":90392,"_23744":90393,"_7301":90394},[45942],"/docs/features/multi-tenancy#multi-tenant-tables","Multi-tenant tables",{"_11930":909,"_45438":905,"_5":45910,"_17286":90396,"_23744":90397,"_7301":90398},[45942],"/docs/features/multi-tenancy#tenant-specific-connections","Tenant-specific connections",{"_11930":910,"_45438":905,"_5":45910,"_17286":90400,"_23744":90401,"_7301":90402},[45942],"/docs/features/multi-tenancy#tenant-specific-views-optional","Tenant-specific views (optional)",{"_11930":911,"_45438":905,"_5":45910,"_17286":90404,"_23744":90405,"_7301":90406},[45942],"/docs/features/multi-tenancy#tenant-data-isolation","Tenant data isolation",{"_11930":912,"_45438":905,"_17286":90408,"_5":16822,"_23744":90389,"_7301":90409},[45942],"Multi-tenancy in Phoenix works via a combination of multi-tenant tables and tenant-specific connections (detailed below).",{"_11930":913,"_45438":905,"_17286":90411,"_5":16822,"_23744":90389,"_7301":90412},[45942],"Tenants open tenant-specific connections to Phoenix. These connections can only access data that belongs to the tenant.",{"_11930":914,"_45438":905,"_17286":90414,"_5":16822,"_23744":90389,"_7301":90415},[45942],"Tenants only see their own data in multi-tenant tables and can see all data in regular tables.",{"_11930":915,"_45438":905,"_17286":90417,"_5":16822,"_23744":90389,"_7301":90418},[45942],"In order to add their own columns, tenants create tenant-specific views on top of multi-tenant tables and add their own columns to the views.",{"_11930":916,"_45438":905,"_17286":90420,"_5":16822,"_23744":90393,"_7301":90421},[45942],"Multi-tenant tables in Phoenix are regular tables declared with the MULTI_TENANT=true DDL property. They work in conjunction with tenant-specific connections (detailed below) to ensure tenants only see their own data in these tables. The first primary key column of a multi-tenant table identifies the tenant. For example:",{"_11930":917,"_45438":905,"_17286":90423,"_5":16822,"_23744":90393,"_7301":90424},[45942],"The column that identifies the tenant may have any name, but it must be of type VARCHAR or CHAR. Regular Phoenix connections work with these tables without tenant constraints, including access across tenant boundaries.",{"_11930":918,"_45438":905,"_17286":90426,"_5":16822,"_23744":90397,"_7301":90427},[45942],"Tenants are identified by the presence or absence of the TenantId property at JDBC connection time. A connection with a non-null TenantId is tenant-specific. A connection with an unspecified or null TenantId is a regular connection. A tenant-specific connection may query only:",{"_11930":919,"_45438":905,"_17286":90429,"_5":16822,"_23744":90397,"_7301":90430},[45942],"all data in non-multi-tenant (global) tables, that is, tables created with a regular connection without MULTI_TENANT=true.",{"_11930":920,"_45438":905,"_17286":90432,"_5":16822,"_23744":90397,"_7301":90433},[45942],"their own data in multi-tenant tables.",{"_11930":921,"_45438":905,"_17286":90435,"_5":16822,"_23744":90397,"_7301":90436},[45942],"their own schema, meaning it sees only tenant-specific views created by that tenant (detailed below).",{"_11930":922,"_45438":905,"_17286":90438,"_5":16822,"_23744":90397,"_7301":90439},[45942],"For example, a tenant-specific connection is established like this:",{"_11930":923,"_45438":905,"_17286":90441,"_5":16822,"_23744":90401,"_7301":90442},[45942],"Tenant-specific views may only be created using tenant-specific connections. They are created the same way as views, however the base table must be a multi-tenant table or another view that eventually points to one. Tenant-specific views are typically used when new columns and/or filter criteria, specific to that tenant, are required. Otherwise the base table may be used directly through a tenant-specific connection as described above.",{"_11930":924,"_45438":905,"_17286":90444,"_5":16822,"_23744":90401,"_7301":90445},[45942],"For example, a tenant-specific view may be defined as follows:",{"_11930":925,"_45438":905,"_17286":90447,"_5":16822,"_23744":90401,"_7301":90448},[45942],"The tenant_id column is neither visible nor accessible from a tenant-specific view. Any reference to it causes a ColumnNotFoundException. As with any Phoenix view, whether the view is updatable follows the rules described here. In addition, indexes may be added to tenant-specific views just like regular tables and views (with these limitations).",{"_11930":926,"_45438":905,"_17286":90450,"_5":16822,"_23744":90405,"_7301":90451},[45942],"Any DML or query performed on multi-tenant tables using a tenant-specific connection is automatically constrained to that tenant’s data. For UPSERT, Phoenix automatically populates the tenant_id column with the tenant ID specified at connection time. For query and DELETE operations, a WHERE clause is transparently added so operations only see data for the current tenant.",{"_11930":927,"_45438":927,"_5":12359,"_7301":90453,"_45913":90454,"_17286":90455,"_23744":927},"Namespace Mapping",[87622,87623,87624,89312],[45942],{"_11930":928,"_45438":927,"_17286":90457,"_5":16822,"_23744":927,"_7301":90458},[45942],"Enable Phoenix schema-to-namespace mapping in HBase, including configuration, migration, and behavior by table type.",{"_11930":929,"_45438":927,"_5":45910,"_17286":90460,"_23744":90461,"_7301":87674},[45942],"/docs/features/namespace-mapping#namespace-mapping-configuration",{"_11930":930,"_45438":927,"_5":45910,"_17286":90463,"_23744":90464,"_7301":90465},[45942],"/docs/features/namespace-mapping#grammar-available","Grammar available",{"_11930":931,"_45438":927,"_5":45910,"_17286":90467,"_23744":90468,"_7301":88966},[45942],"/docs/features/namespace-mapping#namespace-mapping-faq",{"_11930":932,"_45438":927,"_5":45910,"_17286":90470,"_23744":90471,"_7301":90472},[45942],"/docs/features/namespace-mapping#how-to-migrate-existing-tables-with-schema-to-namespace","How to migrate existing tables with schema to namespace",{"_11930":933,"_45438":927,"_5":45910,"_17286":90474,"_23744":90475,"_7301":90476},[45942],"/docs/features/namespace-mapping#how-are-system-tables-migrated","How are system tables migrated",{"_11930":934,"_45438":927,"_5":45910,"_17286":90478,"_23744":90479,"_7301":90480},[45942],"/docs/features/namespace-mapping#what-permissions-are-required-to-create-and-drop-schema","What permissions are required to CREATE and DROP SCHEMA",{"_11930":935,"_45438":927,"_5":45910,"_17286":90482,"_23744":90483,"_7301":90484},[45942],"/docs/features/namespace-mapping#how-are-schemas-mapped-for-different-table-types","How are schemas mapped for different table types",{"_11930":936,"_45438":927,"_5":45910,"_17286":90486,"_23744":90487,"_7301":90488},[45942],"/docs/features/namespace-mapping#what-is-a-namespace-and-what-are-the-benefits-of-mapping-tables-to-namespaces","What is a namespace and what are the benefits of mapping tables to namespaces",{"_11930":937,"_45438":927,"_5":45910,"_17286":90490,"_23744":90491,"_7301":90492},[45942],"/docs/features/namespace-mapping#namespace-mapping-resources","Resources",{"_11930":938,"_45438":927,"_17286":90494,"_5":16822,"_23744":927,"_7301":90495},[45942],"From v4.8.0 onward, users can map Phoenix schemas to HBase namespaces so that any table created with a schema is created in the corresponding HBase namespace.",{"_11930":939,"_45438":927,"_17286":90497,"_5":16822,"_23744":927,"_7301":90498},[45942],"Earlier, every table (with or without schema) was created in the default namespace.",{"_11930":940,"_45438":927,"_17286":90500,"_5":16822,"_23744":90461,"_7301":90501},[45942],"Parameters to enable namespace mapping:",{"_11930":941,"_45438":927,"_17286":90503,"_5":16822,"_23744":90461,"_7301":90504},[45942],"Property",{"_11930":942,"_45438":927,"_17286":90506,"_5":16822,"_23744":90461,"_7301":89711},[45942],{"_11930":943,"_45438":927,"_17286":90508,"_5":16822,"_23744":90461,"_7301":90509},[45942],"Default",{"_11930":944,"_45438":927,"_17286":90511,"_5":16822,"_23744":90461,"_7301":90512},[45942],"phoenix.schema.isNamespaceMappingEnabled",{"_11930":945,"_45438":927,"_17286":90514,"_5":16822,"_23744":90461,"_7301":90515},[45942],"If enabled, tables created with a schema are mapped to the corresponding namespace. This must be set on both client and server. Once enabled, it should not be rolled back. Older clients will not work after this property is enabled.",{"_11930":946,"_45438":927,"_17286":90517,"_5":16822,"_23744":90461,"_7301":24704},[45942],{"_11930":947,"_45438":927,"_17286":90519,"_5":16822,"_23744":90461,"_7301":90520},[45942],"phoenix.schema.mapSystemTablesToNamespace",{"_11930":948,"_45438":927,"_17286":90522,"_5":16822,"_23744":90461,"_7301":90523},[45942],"This takes effect when phoenix.schema.isNamespaceMappingEnabled is also set to true. If enabled, existing SYSTEM tables are automatically migrated to the SYSTEM namespace. If disabled, system tables are created only in the default namespace. This must be set on both client and server.",{"_11930":949,"_45438":927,"_17286":90525,"_5":16822,"_23744":90461,"_7301":15532},[45942],{"_11930":950,"_45438":927,"_17286":90527,"_5":16822,"_23744":90464,"_7301":90528},[45942],"The following DDL statements can be used to interact with schemas:",{"_11930":951,"_45438":927,"_17286":90530,"_5":16822,"_23744":90464,"_7301":90531},[45942],"CREATE SCHEMA",{"_11930":952,"_45438":927,"_17286":90533,"_5":16822,"_23744":90464,"_7301":90534},[45942],"USE SCHEMA",{"_11930":953,"_45438":927,"_17286":90536,"_5":16822,"_23744":90464,"_7301":90537},[45942],"DROP SCHEMA",{"_11930":954,"_45438":927,"_17286":90539,"_5":16822,"_23744":90468,"_7301":90540},[45942],"How to migrate existing tables with schema to namespace?",{"_11930":955,"_45438":927,"_17286":90542,"_5":16822,"_23744":90468,"_7301":90543},[45942],"How are system tables migrated?",{"_11930":956,"_45438":927,"_17286":90545,"_5":16822,"_23744":90468,"_7301":90546},[45942],"What permissions are required to CREATE and DROP SCHEMA?",{"_11930":957,"_45438":927,"_17286":90548,"_5":16822,"_23744":90468,"_7301":90549},[45942],"How are schemas mapped for different table types?",{"_11930":958,"_45438":927,"_17286":90551,"_5":16822,"_23744":90468,"_7301":90552},[45942],"What is a namespace and what are the benefits of mapping tables to namespaces?",{"_11930":959,"_45438":927,"_17286":90554,"_5":16822,"_23744":90471,"_7301":90555},[45942],"For a Kerberized environment, run with a user that has sufficient permission (admin) to create a namespace.",{"_11930":960,"_45438":927,"_17286":90557,"_5":16822,"_23744":90471,"_7301":90558},[45942],"A table is mapped only to a namespace with the same name as the schema (schema_name). Currently, migrating an existing table to a different schema or namespace is not supported.",{"_11930":961,"_45438":927,"_17286":90560,"_5":16822,"_23744":90471,"_7301":89146},[45942],{"_11930":962,"_45438":927,"_17286":90562,"_5":16822,"_23744":90471,"_7301":90563},[45942],"Move table_name to the namespace named schema_name:",{"_11930":963,"_45438":927,"_17286":90565,"_5":16822,"_23744":90475,"_7301":90566},[45942],"SYSTEM tables are migrated automatically during the first connection after enabling phoenix.schema.mapSystemTablesToNamespace along with phoenix.schema.isNamespaceMappingEnabled.",{"_11930":964,"_45438":927,"_17286":90568,"_5":16822,"_23744":90479,"_7301":90569},[45942],"Users must have admin permission in HBase to execute CREATE SCHEMA and DROP SCHEMA, since these commands internally create or delete namespaces.",{"_11930":965,"_45438":927,"_17286":90571,"_5":16822,"_23744":90479,"_7301":90572},[45942],"Details for ACL management in HBase can be found here.",{"_11930":966,"_45438":927,"_17286":90574,"_5":16822,"_23744":90483,"_7301":90575},[45942],"Schema support in Phoenix is similar to other databases.",{"_11930":967,"_45438":927,"_17286":90577,"_5":16822,"_23744":90483,"_7301":90578},[45942],"The table below describes how physical tables map to Phoenix objects:",{"_11930":968,"_45438":927,"_17286":90580,"_5":16822,"_23744":90483,"_7301":90581},[45942],"DDL",{"_11930":969,"_45438":927,"_17286":90583,"_5":16822,"_23744":90483,"_7301":90584},[45942],"Table Type",{"_11930":970,"_45438":927,"_17286":90586,"_5":16822,"_23744":90483,"_7301":90587},[45942],"Physical Table",{"_11930":971,"_45438":927,"_17286":90589,"_5":16822,"_23744":90483,"_7301":89711},[45942],{"_11930":972,"_45438":927,"_17286":90591,"_5":16822,"_23744":90483,"_7301":90592},[45942],"CREATE TABLE S.T (ID INTEGER PRIMARY KEY)",{"_11930":973,"_45438":927,"_17286":90594,"_5":16822,"_23744":90483,"_7301":90595},[45942],"TABLE",{"_11930":974,"_45438":927,"_17286":90597,"_5":16822,"_23744":90483,"_7301":90598},[45942],"S:T",{"_11930":975,"_45438":927,"_17286":90600,"_5":16822,"_23744":90483,"_7301":90601},[45942],"Table T is created in namespace S.",{"_11930":976,"_45438":927,"_17286":90603,"_5":16822,"_23744":90483,"_7301":90604},[45942],"CREATE INDEX IDX ON S.T(ID)",{"_11930":977,"_45438":927,"_17286":90606,"_5":16822,"_23744":90483,"_7301":90607},[45942],"INDEX",{"_11930":978,"_45438":927,"_17286":90609,"_5":16822,"_23744":90483,"_7301":90610},[45942],"S:IDX",{"_11930":979,"_45438":927,"_17286":90612,"_5":16822,"_23744":90483,"_7301":90613},[45942],"Indexes inherit schema and namespace from the base table.",{"_11930":980,"_45438":927,"_17286":90615,"_5":16822,"_23744":90483,"_7301":90616},[45942],"CREATE VIEW V AS SELECT * FROM S.T",{"_11930":981,"_45438":927,"_17286":90618,"_5":16822,"_23744":90483,"_7301":90619},[45942],"VIEW with default schema",{"_11930":982,"_45438":927,"_17286":90621,"_5":16822,"_23744":90483,"_7301":90598},[45942],{"_11930":983,"_45438":927,"_17286":90623,"_5":16822,"_23744":90483,"_7301":90624},[45942],"View does not inherit schema from the parent table and can use the default schema.",{"_11930":984,"_45438":927,"_17286":90626,"_5":16822,"_23744":90483,"_7301":90627},[45942],"CREATE VIEW X.V AS SELECT * FROM S.T",{"_11930":985,"_45438":927,"_17286":90629,"_5":16822,"_23744":90483,"_7301":90630},[45942],"VIEW with different schema than physical table",{"_11930":986,"_45438":927,"_17286":90632,"_5":16822,"_23744":90483,"_7301":90598},[45942],{"_11930":987,"_45438":927,"_17286":90634,"_5":16822,"_23744":90483,"_7301":90635},[45942],"View uses the parent physical table and can have a different (or same) schema.",{"_11930":988,"_45438":927,"_17286":90637,"_5":16822,"_23744":90483,"_7301":90638},[45942],"CREATE VIEW S.V AS SELECT * FROM S.T",{"_11930":989,"_45438":927,"_17286":90640,"_5":16822,"_23744":90483,"_7301":90641},[45942],"VIEW with same schema as physical table",{"_11930":990,"_45438":927,"_17286":90643,"_5":16822,"_23744":90483,"_7301":90598},[45942],{"_11930":991,"_45438":927,"_17286":90645,"_5":16822,"_23744":90483,"_7301":90635},[45942],{"_11930":992,"_45438":927,"_17286":90647,"_5":16822,"_23744":90483,"_7301":90648},[45942],"CREATE INDEX IDX ON S.V(ID)",{"_11930":993,"_45438":927,"_17286":90650,"_5":16822,"_23744":90483,"_7301":90651},[45942],"VIEW INDEX",{"_11930":994,"_45438":927,"_17286":90653,"_5":16822,"_23744":90483,"_7301":90654},[45942],"S:_IDX_T",{"_11930":995,"_45438":927,"_17286":90656,"_5":16822,"_23744":90483,"_7301":90657},[45942],"View indexes inherit schema and map to the corresponding namespace.",{"_11930":996,"_45438":927,"_17286":90659,"_5":16822,"_23744":90487,"_7301":90660},[45942],"A namespace is a logical grouping of tables, analogous to a database in relational database systems. This abstraction lays the groundwork for multi-tenancy-related features:",{"_11930":997,"_45438":927,"_17286":90662,"_5":16822,"_23744":90487,"_7301":90663},[45942],"Quota Management - Restrict the amount of resources (i.e. regions, tables) a namespace can consume.",{"_11930":998,"_45438":927,"_17286":90665,"_5":16822,"_23744":90487,"_7301":90666},[45942],"Namespace Security Administration - Provide another level of security administration for tenants.",{"_11930":999,"_45438":927,"_17286":90668,"_5":16822,"_23744":90487,"_7301":90669},[45942],"Region server groups - A namespace/table can be pinned to a subset of RegionServers, guaranteeing a coarse level of isolation.",{"_11930":1000,"_45438":927,"_17286":90671,"_5":16822,"_23744":90487,"_7301":90672},[45942],"Details about namespace management can be read here.",{"_11930":1001,"_45438":927,"_17286":90674,"_5":16822,"_23744":90491,"_7301":90675},[45942],"PHOENIX-1311: Implementation details and discussion for the namespace mapping feature.",{"_11930":1002,"_45438":1002,"_5":12359,"_7301":90677,"_45913":90678,"_17286":90679,"_23744":1002},"Paged Queries",[87622,87623,87624,89312],[45942],{"_11930":1003,"_45438":1002,"_17286":90681,"_5":16822,"_23744":1002,"_7301":90682},[45942],"Use row value constructors and OFFSET/LIMIT for efficient paged query patterns in Phoenix.",{"_11930":1004,"_45438":1002,"_5":45910,"_17286":90684,"_23744":90685,"_7301":90686},[45942],"/docs/features/paged-queries#row-value-constructors-rvc","Row Value Constructors (RVC)",{"_11930":1005,"_45438":1002,"_5":45910,"_17286":90688,"_23744":90689,"_7301":90690},[45942],"/docs/features/paged-queries#offset-with-limit","OFFSET with LIMIT",{"_11930":1006,"_45438":1002,"_17286":90692,"_5":16822,"_23744":1002,"_7301":90693},[45942],"Phoenix supports standard SQL constructs to enable paged queries:",{"_11930":1007,"_45438":1002,"_17286":90695,"_5":16822,"_23744":1002,"_7301":90686},[45942],{"_11930":1008,"_45438":1002,"_17286":90697,"_5":16822,"_23744":1002,"_7301":90690},[45942],{"_11930":1009,"_45438":1002,"_17286":90699,"_5":16822,"_23744":90685,"_7301":90700},[45942],"A row value constructor is an ordered sequence of values delimited by parentheses. For example:",{"_11930":1010,"_45438":1002,"_17286":90702,"_5":16822,"_23744":90685,"_7301":90703},[45942],"Just like regular values, row value constructors may be used in comparison expressions:",{"_11930":1011,"_45438":1002,"_17286":90705,"_5":16822,"_23744":90685,"_7301":90706},[45942],"Row value constructors are compared by conceptually concatenating the values together and comparing them against each other, with the leftmost part being most significant. Section 8.2 (comparison predicates) of the SQL-92 standard explains this in detail, but here are a few examples of predicates that would evaluate to true:",{"_11930":1012,"_45438":1002,"_17286":90708,"_5":16822,"_23744":90685,"_7301":90709},[45942],"Row value constructors may also be used in an IN list expression to efficiently query for a set of rows given the composite primary key columns. For example, the following would be optimized to be a point get of three rows:",{"_11930":1013,"_45438":1002,"_17286":90711,"_5":16822,"_23744":90685,"_7301":90712},[45942],"Another primary use case for row value constructors is to support query-more type functionality by enabling an ordered set of rows to be incrementally stepped through. For example, the following query would step through a set of rows, 20 rows at a time:",{"_11930":1014,"_45438":1002,"_17286":90714,"_5":16822,"_23744":90685,"_7301":90715},[45942],"Assuming that the client binds the three bind variables to the values of the last row processed, the next invocation would find the next 20 rows that match the query. If the columns you supply in your row value constructor match in order the columns from your primary key (or from a secondary index), then Phoenix will be able to turn the row value constructor expression into the start row of your scan. This enables a very efficient mechanism to locate at or after a row.",{"_11930":1015,"_45438":1002,"_17286":90717,"_5":16822,"_23744":90689,"_7301":90718},[45942],"Use OFFSET to specify the starting row offset into the result set returned by your query and LIMIT to specify the page size.",{"_11930":1016,"_45438":1002,"_17286":90720,"_5":16822,"_23744":90689,"_7301":90721},[45942],"For example, if page size is 10, then to select the second page, the following query can be used (rows 11 to 20 are returned):",{"_11930":1017,"_45438":1002,"_17286":90723,"_5":16822,"_23744":90689,"_7301":90724},[45942],"OFFSET reads and skips rows on either the server or client depending on query type, whereas RVC is more effective for queries on the primary key axis because it can start directly from the provided key.",{"_11930":1018,"_45438":1018,"_5":12359,"_7301":90726,"_45913":90727,"_17286":90728,"_23744":1018},"PHOENIX_ROW_TIMESTAMP()",[87622,87623,87624,89312],[45942],{"_11930":1019,"_45438":1018,"_17286":90730,"_5":16822,"_23744":1018,"_7301":90731},[45942],"Read the per-row last-modified timestamp Phoenix maintains automatically — usable in projections, predicates, and indexes for fast time-bounded reads.",{"_11930":1020,"_45438":1018,"_5":45910,"_17286":90733,"_23744":90734,"_7301":90735},[45942],"/docs/features/phoenix-row-timestamp#phoenix-row-timestamp-read","Reading the row timestamp",{"_11930":1021,"_45438":1018,"_5":45910,"_17286":90737,"_23744":90738,"_7301":90739},[45942],"/docs/features/phoenix-row-timestamp#phoenix-row-timestamp-where","In WHERE predicates",{"_11930":1022,"_45438":1018,"_5":45910,"_17286":90741,"_23744":90742,"_7301":90743},[45942],"/docs/features/phoenix-row-timestamp#phoenix-row-timestamp-index","Indexing on PHOENIX_ROW_TIMESTAMP()",{"_11930":1023,"_45438":1018,"_5":45910,"_17286":90745,"_23744":90746,"_7301":90747},[45942],"/docs/features/phoenix-row-timestamp#phoenix-row-timestamp-vs-row-timestamp","Relationship to ROW_TIMESTAMP column",{"_11930":1024,"_45438":1018,"_17286":90749,"_5":16822,"_23744":1018,"_7301":90750},[45942],"PHOENIX_ROW_TIMESTAMP() is a built-in SQL function that returns the timestamp\nof the row's empty column, which Phoenix updates automatically on every write.\nIt's effectively the row's last-modified time, available on any Phoenix table\nwithout you having to declare or manage a timestamp column yourself. The return\ntype is DATE.",{"_11930":1025,"_45438":1018,"_17286":90752,"_5":16822,"_23744":1018,"_7301":90753},[45942],"It can be used in three places, and the third one is what makes it especially\npowerful:",{"_11930":1026,"_45438":1018,"_17286":90755,"_5":16822,"_23744":1018,"_7301":90756},[45942],"As a projection in SELECT.",{"_11930":1027,"_45438":1018,"_17286":90758,"_5":16822,"_23744":1018,"_7301":90759},[45942],"As a predicate in WHERE (and JOIN) clauses.",{"_11930":1028,"_45438":1018,"_17286":90761,"_5":16822,"_23744":1018,"_7301":90762},[45942],"As the indexed expression in a functional index, which makes time-bounded reads fast even when the table isn't ordered by time.",{"_11930":1029,"_45438":1018,"_17286":90764,"_5":16822,"_23744":90734,"_7301":90765},[45942],"Project it like any other column:",{"_11930":1030,"_45438":1018,"_17286":90767,"_5":16822,"_23744":90734,"_7301":90768},[45942],"The function takes no arguments and is evaluated server-side from the empty cell\nthat Phoenix already maintains for every row.",{"_11930":1031,"_45438":1018,"_17286":90770,"_5":16822,"_23744":90738,"_7301":90771},[45942],"Use it to bound queries by mutation time, including incremental \"what changed\nsince\" patterns:",{"_11930":1032,"_45438":1018,"_17286":90773,"_5":16822,"_23744":90738,"_7301":90774},[45942],"Without an index, these predicates require a scan of the table. The next section\nfixes that.",{"_11930":1033,"_45438":1018,"_17286":90776,"_5":16822,"_23744":90742,"_7301":90777},[45942],"Create a functional index\non the function to make time-bounded reads fast. Phoenix can then seek directly\non the indexed timestamp instead of scanning the data table:",{"_11930":1034,"_45438":1018,"_17286":90779,"_5":16822,"_23744":90742,"_7301":90780},[45942],"This is the typical recipe for \"scan rows changed in the last N minutes\" type\nqueries on a table whose primary key isn't time-ordered. Pair with\nuncovered indexes when you\ndon't want to duplicate payload columns into the index.",{"_11930":1035,"_45438":1018,"_17286":90782,"_5":16822,"_23744":90742,"_7301":90783},[45942],"If your downstream needs a continuous, ordered stream of changes rather than\nperiodic time-bounded scans — including the actual mutation deltas — reach for\nChange Data Capture instead. The functional\nindex pattern here is best suited to ad-hoc time-window reads from the same\nclient that issues regular SQL queries.",{"_11930":1036,"_45438":1018,"_17286":90785,"_5":16822,"_23744":90746,"_7301":90786},[45942],"Two related concepts share the word \"timestamp\" — they are not the same:",{"_11930":1037,"_45438":1018,"_17286":90788,"_5":16822,"_23744":90746,"_7301":90789},[45942],"Feature",{"_11930":1038,"_45438":1018,"_17286":90791,"_5":16822,"_23744":90746,"_7301":90792},[45942],"Direction",{"_11930":1039,"_45438":1018,"_17286":90794,"_5":16822,"_23744":90746,"_7301":90795},[45942],"What it does",{"_11930":1040,"_45438":1018,"_17286":90797,"_5":16822,"_23744":90746,"_7301":90798},[45942],"ROW_TIMESTAMP column",{"_11930":1041,"_45438":1018,"_17286":90800,"_5":16822,"_23744":90746,"_7301":90801},[45942],"Write",{"_11930":1042,"_45438":1018,"_17286":90803,"_5":16822,"_23744":90746,"_7301":90804},[45942],"Designate a primary-key column whose value is written into the underlying HBase row timestamp.",{"_11930":1043,"_45438":1018,"_17286":90806,"_5":16822,"_23744":90746,"_7301":90807},[45942],"PHOENIX_ROW_TIMESTAMP() function",{"_11930":1044,"_45438":1018,"_17286":90809,"_5":16822,"_23744":90746,"_7301":90810},[45942],"Read",{"_11930":1045,"_45438":1018,"_17286":90812,"_5":16822,"_23744":90746,"_7301":90813},[45942],"Return the underlying HBase row timestamp Phoenix already maintains on every row's empty cell.",{"_11930":1046,"_45438":1018,"_17286":90815,"_5":16822,"_23744":90746,"_7301":90816},[45942],"PHOENIX_ROW_TIMESTAMP() works on any Phoenix table, regardless of whether\nyou've declared a ROW_TIMESTAMP column. If you have declared one, both\nmechanisms read/write the same underlying timestamp, so PHOENIX_ROW_TIMESTAMP()\nreturns the value of the ROW_TIMESTAMP column for that row.",{"_11930":1047,"_45438":1047,"_5":12359,"_7301":90818,"_45913":90819,"_17286":90820,"_23744":1047},"Query Server",[87622,87623,87624,89312],[45942],{"_11930":1048,"_45438":1047,"_17286":90822,"_5":16822,"_23744":1047,"_7301":90823},[45942],"Deploy and use Phoenix Query Server (PQS), including client access, impersonation, metrics, and load-balancing configuration.",{"_11930":1049,"_45438":1047,"_5":45910,"_17286":90825,"_23744":90826,"_7301":90827},[45942],"/docs/features/query-server#query-server-overview","Overview",{"_11930":1050,"_45438":1047,"_5":45910,"_17286":90829,"_23744":90830,"_7301":90831},[45942],"/docs/features/query-server#clients","Clients",{"_11930":1051,"_45438":1047,"_5":45910,"_17286":90833,"_23744":90834,"_7301":90835},[45942],"/docs/features/query-server#query-server-installation","Installation",{"_11930":1052,"_45438":1047,"_5":45910,"_17286":90837,"_23744":90838,"_7301":90839},[45942],"/docs/features/query-server#query-server-usage","Usage",{"_11930":1053,"_45438":1047,"_5":45910,"_17286":90841,"_23744":90842,"_7301":90843},[45942],"/docs/features/query-server#server","Server",{"_11930":1054,"_45438":1047,"_5":45910,"_17286":90845,"_23744":90846,"_7301":90847},[45942],"/docs/features/query-server#client","Client",{"_11930":1055,"_45438":1047,"_5":45910,"_17286":90849,"_23744":90850,"_7301":90851},[45942],"/docs/features/query-server#wire-api-documentation","Wire API documentation",{"_11930":1056,"_45438":1047,"_5":45910,"_17286":90853,"_23744":90854,"_7301":90855},[45942],"/docs/features/query-server#impersonation","Impersonation",{"_11930":1057,"_45438":1047,"_5":45910,"_17286":90857,"_23744":90858,"_7301":90240},[45942],"/docs/features/query-server#query-server-metrics",{"_11930":1058,"_45438":1047,"_5":45910,"_17286":90860,"_23744":90861,"_7301":87674},[45942],"/docs/features/query-server#query-server-configuration",{"_11930":1059,"_45438":1047,"_5":45910,"_17286":90863,"_23744":90864,"_7301":90865},[45942],"/docs/features/query-server#server-instantiation","Server Instantiation",{"_11930":1060,"_45438":1047,"_5":45910,"_17286":90867,"_23744":90868,"_7301":90869},[45942],"/docs/features/query-server#https","HTTPS",{"_11930":1061,"_45438":1047,"_5":45910,"_17286":90871,"_23744":90872,"_7301":90873},[45942],"/docs/features/query-server#secure-cluster-connection","Secure Cluster Connection",{"_11930":1062,"_45438":1047,"_5":45910,"_17286":90875,"_23744":90876,"_7301":90877},[45942],"/docs/features/query-server#server-connection-cache","Server Connection Cache",{"_11930":1063,"_45438":1047,"_5":45910,"_17286":90879,"_23744":90880,"_7301":90881},[45942],"/docs/features/query-server#server-statement-cache","Server Statement Cache",{"_11930":1064,"_45438":1047,"_5":45910,"_17286":90883,"_23744":90884,"_7301":90855},[45942],"/docs/features/query-server#impersonation-1",{"_11930":1065,"_45438":1047,"_5":45910,"_17286":90886,"_23744":90887,"_7301":90240},[45942],"/docs/features/query-server#query-server-metrics-config",{"_11930":1066,"_45438":1047,"_5":45910,"_17286":90889,"_23744":90890,"_7301":90891},[45942],"/docs/features/query-server#query-server-additions","Query Server Additions",{"_11930":1067,"_45438":1047,"_5":45910,"_17286":90893,"_23744":90894,"_7301":90895},[45942],"/docs/features/query-server#load-balancing","Load balancing",{"_11930":1068,"_45438":1047,"_17286":90897,"_5":16822,"_23744":1047,"_7301":90898},[45942],"The Phoenix Query Server provides an alternative means for interaction with\nPhoenix and HBase.",{"_11930":1069,"_45438":1047,"_17286":90900,"_5":16822,"_23744":90826,"_7301":90901},[45942],"Phoenix 4.4 introduces a stand-alone server that exposes Phoenix to \"thin\"\nclients. It is based on the Avatica component of\nApache Calcite. The query server is comprised of a Java server that\nmanages Phoenix Connections on the clients' behalf.",{"_11930":1070,"_45438":1047,"_17286":90903,"_5":16822,"_23744":90826,"_7301":90904},[45942],"With the introduction of the\nProtobuf transport, Avatica is moving towards backwards compatibility with the\nprovided thin JDBC driver. There are no such backwards compatibility guarantees\nfor the JSON API.",{"_11930":1071,"_45438":1047,"_17286":90906,"_5":16822,"_23744":90826,"_7301":90907},[45942],"To repeat, there is no guarantee of backwards compatibility with the JSON transport;\nhowever, compatibility with the Protobuf transport is stabilizing (although, not\ntested thoroughly enough to be stated as \"guaranteed\").",{"_11930":1072,"_45438":1047,"_17286":90909,"_5":16822,"_23744":90830,"_7301":90910},[45942],"The primary client implementation\nis currently a JDBC driver with minimal dependencies. The default and\nprimary transport mechanism since Phoenix 4.7 is Protobuf, the older JSON mechanism can still\nbe enabled.\nThe distribution includes the sqlline-thin.py CLI client that uses the JDBC thin client.",{"_11930":1073,"_45438":1047,"_17286":90912,"_5":16822,"_23744":90830,"_7301":90913},[45942],"The Phoenix project also maintains the Python driver\nphoenixdb.",{"_11930":1074,"_45438":1047,"_17286":90915,"_5":16822,"_23744":90830,"_7301":90916},[45942],"The Avatica Go client\ncan also be used.",{"_11930":1075,"_45438":1047,"_17286":90918,"_5":16822,"_23744":90830,"_7301":90919},[45942],"Proprietary ODBC drivers are also available for Windows and Linux.",{"_11930":1076,"_45438":1047,"_17286":90921,"_5":16822,"_23744":90834,"_7301":90922},[45942],"In the 4.4-4.14 and 5.0 releases the query server and its JDBC client are part of the standard Phoenix\ndistribution. They require no additional dependencies or installation.",{"_11930":1077,"_45438":1047,"_17286":90924,"_5":16822,"_23744":90834,"_7301":90925},[45942],"After the 4.15 and 5.1 release, the query server has been unbundled into the phoenix-queryserver\nrepository, and its version number has been reset to 6.0.",{"_11930":1078,"_45438":1047,"_17286":90927,"_5":16822,"_23744":90834,"_7301":90928},[45942],"Download the latest source or binary release from the\nDownload page,\nor check out the development version from\nGitHub.",{"_11930":1079,"_45438":1047,"_17286":90930,"_5":16822,"_23744":90834,"_7301":90931},[45942],"Either unpack the binary distribution, or build it from source. See BUILDING.md\nin the source distribution on how to build.",{"_11930":1080,"_45438":1047,"_17286":90933,"_5":16822,"_23744":90842,"_7301":90934},[45942],"The standalone Query Server distribution does not contain the necessary\nPhoenix (thick) client library by default.",{"_11930":1081,"_45438":1047,"_17286":90936,"_5":16822,"_23744":90842,"_7301":90937},[45942],"If using the standalone library you will either need to rebuild it from source to include the\nclient library (See BUILDING.md), or manually copy the phoenix thick client library\ninto the installation directory.",{"_11930":1082,"_45438":1047,"_17286":90939,"_5":16822,"_23744":90842,"_7301":90940},[45942],"The server component is managed through bin/queryserver.py. Its usage is as\nfollows",{"_11930":1083,"_45438":1047,"_17286":90942,"_5":16822,"_23744":90842,"_7301":90943},[45942],"When invoked with no arguments, the query server is launched in the foreground,\nwith logging directed to the console.",{"_11930":1084,"_45438":1047,"_17286":90945,"_5":16822,"_23744":90842,"_7301":90946},[45942],"The first argument is an optional start or stop command to the daemon. When\neither of these are provided, it will take appropriate action on a daemon\nprocess, if it exists.",{"_11930":1085,"_45438":1047,"_17286":90948,"_5":16822,"_23744":90842,"_7301":90949},[45942],"Any subsequent arguments are passed to the main class for interpretation.",{"_11930":1086,"_45438":1047,"_17286":90951,"_5":16822,"_23744":90842,"_7301":90952},[45942],"The server is packaged in a standalone jar,\nphoenix-queryserver-<version>.jar. This jar, the phoenix-client.jar and HBASE_CONF_DIR on the\nclasspath are all that is required to launch the server.",{"_11930":1087,"_45438":1047,"_17286":90954,"_5":16822,"_23744":90846,"_7301":90955},[45942],"Phoenix provides two mechanisms for interacting with the query server. A JDBC\ndriver is provided in the standalone\nphoenix-queryserver-client-<version>.jar. The script\nbin/sqlline-thin.py is available for the command line.",{"_11930":1088,"_45438":1047,"_17286":90957,"_5":16822,"_23744":90846,"_7301":90958},[45942],"The JDBC connection string is composed as follows:",{"_11930":1089,"_45438":1047,"_17286":90960,"_5":16822,"_23744":90846,"_7301":90961},[45942],"<scheme> specifies the transport protocol (http or https) used when communicating with the\nserver.",{"_11930":1090,"_45438":1047,"_17286":90963,"_5":16822,"_23744":90846,"_7301":90964},[45942],"<server-hostname> is the name of the host offering the service.",{"_11930":1091,"_45438":1047,"_17286":90966,"_5":16822,"_23744":90846,"_7301":90967},[45942],"<port> is the port number on which the host is listening. Default is 8765,\nthough this is configurable (see below).",{"_11930":1092,"_45438":1047,"_17286":90969,"_5":16822,"_23744":90846,"_7301":90970},[45942],"The full list of options that can be provided via the JDBC URL string is available\nin the Avatica documentation.",{"_11930":1093,"_45438":1047,"_17286":90972,"_5":16822,"_23744":90846,"_7301":90973},[45942],"The script bin/sqlline-thin.py is intended to behave identically to its\nsibling script bin/sqlline.py. It supports the following usage options.",{"_11930":1094,"_45438":1047,"_17286":90975,"_5":16822,"_23744":90846,"_7301":90976},[45942],"The first optional argument is a connection URL, as described previously. When\nnot provided, scheme defaults to http, host to localhost, and port to\n8765.",{"_11930":1095,"_45438":1047,"_17286":90978,"_5":16822,"_23744":90846,"_7301":90979},[45942],"The second optional parameter is a sql file from which to read commands.",{"_11930":1096,"_45438":1047,"_17286":90981,"_5":16822,"_23744":90850,"_7301":90982},[45942],"The API itself is documented in the Apache Calcite project as it is the Avatica\nAPI -- there is no wire API defined in Phoenix itself.",{"_11930":1097,"_45438":1047,"_17286":90984,"_5":16822,"_23744":90850,"_7301":90985},[45942],"JSON API",{"_11930":1098,"_45438":1047,"_17286":90987,"_5":16822,"_23744":90850,"_7301":90988},[45942],"Protocol Buffer API",{"_11930":1099,"_45438":1047,"_17286":90990,"_5":16822,"_23744":90850,"_7301":90991},[45942],"For more information in building clients in other languages that work with\nAvatica, please feel free to reach out to the Apache Calcite dev mailing list.",{"_11930":1100,"_45438":1047,"_17286":90993,"_5":16822,"_23744":90854,"_7301":90994},[45942],"By default, the Phoenix Query Server executes queries on behalf of the end-user. HBase permissions\nare enforced given the end-user, not the Phoenix Query Server's identity. In some cases, it may\nbe desirable to execute the query as some other user -- this is referred to as \"impersonation\".\nThis can enable workflows where a trusted user has the privilege to run queries for other users.",{"_11930":1101,"_45438":1047,"_17286":90996,"_5":16822,"_23744":90854,"_7301":90997},[45942],"This can be enabled by setting the configuration property phoenix.queryserver.withRemoteUserExtractor\nto true. The URL of the Query Server can be modified to include the required request parameter.\nFor example, to let \"bob\" to run a query as \"alice\", the following JDBC URL could be used:",{"_11930":1102,"_45438":1047,"_17286":90999,"_5":16822,"_23744":90854,"_7301":91000},[45942],"The standard Hadoop \"proxyuser\" configuration keys are checked to validate if the \"real\" remote user\nis allowed to impersonate the \"doAs\" user. See the Hadoop documentation\nfor more information on how to configure these rules.",{"_11930":1103,"_45438":1047,"_17286":91002,"_5":16822,"_23744":90854,"_7301":91003},[45942],"As a word of warning: there is no end-to-end test coverage for the HBase 0.98 and 1.1 Phoenix releases\nbecause of missing test-related code in those HBase releases. While we expect no issues on these\nPhoenix release lines, we recommend additional testing by the user to verify that there are no issues.",{"_11930":1104,"_45438":1047,"_17286":91005,"_5":16822,"_23744":90858,"_7301":91006},[45942],"By default, the Phoenix Query Server exposes various Phoenix global client metrics via JMX (for HBase versions 1.3 and up).\nThe list of metrics are available here.",{"_11930":1105,"_45438":1047,"_17286":91008,"_5":16822,"_23744":90858,"_7301":91009},[45942],"PQS Metrics use Hadoop Metrics 2 internally for metrics publishing. Hence it publishes various JVM related metrics. Metrics can be filtered based on certain tags, which can be configured by the property specified in hbase-site.xml on the classpath. Further details are provided in Configuration section.",{"_11930":1106,"_45438":1047,"_17286":91011,"_5":16822,"_23744":90861,"_7301":91012},[45942],"Server components are spread across a number of java packages, so effective\nlogging configuration requires updating multiple packages. The default server\nlogging configuration sets the following log levels:",{"_11930":1107,"_45438":1047,"_17286":91014,"_5":16822,"_23744":90861,"_7301":91015},[45942],"As of the time of writing, the underlying Avatica component respects the\nfollowing configuration options exposed via hbase-site.xml.",{"_11930":1108,"_45438":1047,"_17286":91017,"_5":16822,"_23744":90864,"_7301":90504},[45942],{"_11930":1109,"_45438":1047,"_17286":91019,"_5":16822,"_23744":90864,"_7301":89711},[45942],{"_11930":1110,"_45438":1047,"_17286":91021,"_5":16822,"_23744":90864,"_7301":90509},[45942],{"_11930":1111,"_45438":1047,"_17286":91023,"_5":16822,"_23744":90864,"_7301":91024},[45942],"phoenix.queryserver.http.port",{"_11930":1112,"_45438":1047,"_17286":91026,"_5":16822,"_23744":90864,"_7301":91027},[45942],"Port the server listens on.",{"_11930":1113,"_45438":1047,"_17286":91029,"_5":16822,"_23744":90864,"_7301":45191},[45942],{"_11930":1114,"_45438":1047,"_17286":91031,"_5":16822,"_23744":90864,"_7301":91032},[45942],"phoenix.queryserver.metafactory.class",{"_11930":1115,"_45438":1047,"_17286":91034,"_5":16822,"_23744":90864,"_7301":91035},[45942],"Avatica Meta.Factory implementation class.",{"_11930":1116,"_45438":1047,"_17286":91037,"_5":16822,"_23744":90864,"_7301":91038},[45942],"org.apache.phoenix.queryserver.server.PhoenixMetaFactoryImpl",{"_11930":1117,"_45438":1047,"_17286":91040,"_5":16822,"_23744":90864,"_7301":91041},[45942],"phoenix.queryserver.serialization",{"_11930":1118,"_45438":1047,"_17286":91043,"_5":16822,"_23744":90864,"_7301":91044},[45942],"Transport/serialization format (PROTOBUF or JSON).",{"_11930":1119,"_45438":1047,"_17286":91046,"_5":16822,"_23744":90864,"_7301":91047},[45942],"PROTOBUF",{"_11930":1120,"_45438":1047,"_17286":91049,"_5":16822,"_23744":90868,"_7301":91050},[45942],"HTTPS support is only available in unbundled phoenix-queryserver versions.",{"_11930":1121,"_45438":1047,"_17286":91052,"_5":16822,"_23744":90868,"_7301":90504},[45942],{"_11930":1122,"_45438":1047,"_17286":91054,"_5":16822,"_23744":90868,"_7301":89711},[45942],{"_11930":1123,"_45438":1047,"_17286":91056,"_5":16822,"_23744":90868,"_7301":90509},[45942],{"_11930":1124,"_45438":1047,"_17286":91058,"_5":16822,"_23744":90868,"_7301":91059},[45942],"phoenix.queryserver.tls.enabled",{"_11930":1125,"_45438":1047,"_17286":91061,"_5":16822,"_23744":90868,"_7301":91062},[45942],"Enables HTTPS transport. When enabled, keystore/truststore files and passwords are also required.",{"_11930":1126,"_45438":1047,"_17286":91064,"_5":16822,"_23744":90868,"_7301":24704},[45942],{"_11930":1127,"_45438":1047,"_17286":91066,"_5":16822,"_23744":90868,"_7301":91067},[45942],"phoenix.queryserver.tls.keystore",{"_11930":1128,"_45438":1047,"_17286":91069,"_5":16822,"_23744":90868,"_7301":91070},[45942],"Keystore file containing the HTTPS private key.",{"_11930":1129,"_45438":1047,"_17286":91072,"_5":16822,"_23744":90868,"_7301":23597},[45942],{"_11930":1130,"_45438":1047,"_17286":91074,"_5":16822,"_23744":90868,"_7301":91075},[45942],"phoenix.queryserver.tls.keystore.password",{"_11930":1131,"_45438":1047,"_17286":91077,"_5":16822,"_23744":90868,"_7301":91078},[45942],"Password for HTTPS keystore.",{"_11930":1132,"_45438":1047,"_17286":91080,"_5":16822,"_23744":90868,"_7301":91081},[45942],"empty string",{"_11930":1133,"_45438":1047,"_17286":91083,"_5":16822,"_23744":90868,"_7301":91084},[45942],"phoenix.queryserver.tls.truststore",{"_11930":1134,"_45438":1047,"_17286":91086,"_5":16822,"_23744":90868,"_7301":91087},[45942],"Keystore file containing the HTTPS certificate.",{"_11930":1135,"_45438":1047,"_17286":91089,"_5":16822,"_23744":90868,"_7301":23597},[45942],{"_11930":1136,"_45438":1047,"_17286":91091,"_5":16822,"_23744":90868,"_7301":91092},[45942],"phoenix.queryserver.tls.truststore.password",{"_11930":1137,"_45438":1047,"_17286":91094,"_5":16822,"_23744":90868,"_7301":91095},[45942],"Password for HTTPS truststore.",{"_11930":1138,"_45438":1047,"_17286":91097,"_5":16822,"_23744":90868,"_7301":91081},[45942],{"_11930":1139,"_45438":1047,"_17286":91099,"_5":16822,"_23744":90872,"_7301":90504},[45942],{"_11930":1140,"_45438":1047,"_17286":91101,"_5":16822,"_23744":90872,"_7301":89711},[45942],{"_11930":1141,"_45438":1047,"_17286":91103,"_5":16822,"_23744":90872,"_7301":90509},[45942],{"_11930":1142,"_45438":1047,"_17286":91105,"_5":16822,"_23744":90872,"_7301":91106},[45942],"hbase.security.authentication",{"_11930":1143,"_45438":1047,"_17286":91108,"_5":16822,"_23744":90872,"_7301":91109},[45942],"When set to kerberos, server logs in before initiating Phoenix connections.",{"_11930":1144,"_45438":1047,"_17286":91111,"_5":16822,"_23744":90872,"_7301":91112},[45942],"specified in hbase-default.xml",{"_11930":1145,"_45438":1047,"_17286":91114,"_5":16822,"_23744":90872,"_7301":91115},[45942],"phoenix.queryserver.keytab.file",{"_11930":1146,"_45438":1047,"_17286":91117,"_5":16822,"_23744":90872,"_7301":91118},[45942],"Key for keytab file lookup.",{"_11930":1147,"_45438":1047,"_17286":91120,"_5":16822,"_23744":90872,"_7301":23597},[45942],{"_11930":1148,"_45438":1047,"_17286":91122,"_5":16822,"_23744":90872,"_7301":91123},[45942],"phoenix.queryserver.kerberos.principal",{"_11930":1149,"_45438":1047,"_17286":91125,"_5":16822,"_23744":90872,"_7301":91126},[45942],"Kerberos principal for authentication; also used for SPNEGO if HTTP principal is not configured.",{"_11930":1150,"_45438":1047,"_17286":91128,"_5":16822,"_23744":90872,"_7301":23597},[45942],{"_11930":1151,"_45438":1047,"_17286":91130,"_5":16822,"_23744":90872,"_7301":91131},[45942],"phoenix.queryserver.http.keytab.file",{"_11930":1152,"_45438":1047,"_17286":91133,"_5":16822,"_23744":90872,"_7301":91134},[45942],"Keytab for SPNEGO auth; required if phoenix.queryserver.kerberos.http.principal is set; falls back to phoenix.queryserver.keytab.file.",{"_11930":1153,"_45438":1047,"_17286":91136,"_5":16822,"_23744":90872,"_7301":23597},[45942],{"_11930":1154,"_45438":1047,"_17286":91138,"_5":16822,"_23744":90872,"_7301":91139},[45942],"phoenix.queryserver.http.kerberos.principal",{"_11930":1155,"_45438":1047,"_17286":91141,"_5":16822,"_23744":90872,"_7301":91142},[45942],"Kerberos principal for SPNEGO auth; falls back to phoenix.queryserver.kerberos.principal.",{"_11930":1156,"_45438":1047,"_17286":91144,"_5":16822,"_23744":90872,"_7301":23597},[45942],{"_11930":1157,"_45438":1047,"_17286":91146,"_5":16822,"_23744":90872,"_7301":91147},[45942],"phoenix.queryserver.kerberos.http.principal",{"_11930":1158,"_45438":1047,"_17286":91149,"_5":16822,"_23744":90872,"_7301":91150},[45942],"Deprecated; use phoenix.queryserver.http.kerberos.