624,"_23503":3365,"_7204":97005},[45581],{"_11759":3437,"_45083":3365,"_17088":97114,"_5":16624,"_23503":3365,"_7204":97115},[45581],"MU947",{"_11759":3438,"_45083":3365,"_17088":97117,"_5":16624,"_23503":3365,"_7204":97118},[45581],"20.35",{"_11759":3439,"_45083":3365,"_17088":97120,"_5":16624,"_23503":3365,"_7204":97027},[45581],{"_11759":3440,"_45083":3365,"_17088":97122,"_5":16624,"_23503":3365,"_7204":97123},[45581],"MU3508",{"_11759":3441,"_45083":3365,"_17088":97125,"_5":16624,"_23503":3365,"_7204":97126},[45581],"9.60",{"_11759":3442,"_45083":3365,"_17088":97128,"_5":16624,"_23503":3365,"_7204":97129},[45581],"I004",{"_11759":3443,"_45083":3365,"_17088":97131,"_5":16624,"_23503":3365,"_7204":97132},[45581],"XC7732",{"_11759":3444,"_45083":3365,"_17088":97134,"_5":16624,"_23503":3365,"_7204":97135},[45581],"55.24",{"_11759":3445,"_45083":3365,"_17088":97137,"_5":16624,"_23503":3365,"_7204":97138},[45581],"I005",{"_11759":3446,"_45083":3365,"_17088":97140,"_5":16624,"_23503":3365,"_7204":97141},[45581],"XT0019",{"_11759":3447,"_45083":3365,"_17088":97143,"_5":16624,"_23503":3365,"_7204":97144},[45581],"12.65",{"_11759":3448,"_45083":3365,"_17088":97146,"_5":16624,"_23503":3365,"_7204":96993},[45581],{"_11759":3449,"_45083":3365,"_17088":97148,"_5":16624,"_23503":3365,"_7204":97149},[45581],"XT2217",{"_11759":3450,"_45083":3365,"_17088":97151,"_5":16624,"_23503":3365,"_7204":97152},[45581],"12.35",{"_11759":3451,"_45083":3365,"_17088":97154,"_5":16624,"_23503":3365,"_7204":97155},[45581],"You may get a combined view of the \"Orders\" table and the \"Customers\" table by running the following join query:",{"_11759":3452,"_45083":3365,"_17088":97157,"_5":16624,"_23503":3365,"_7204":97158},[45581],"This will produce results like:",{"_11759":3453,"_45083":3365,"_17088":97160,"_5":16624,"_23503":3365,"_7204":97161},[45581],"O.OrderID",{"_11759":3454,"_45083":3365,"_17088":97163,"_5":16624,"_23503":3365,"_7204":97164},[45581],"C.CustomerName",{"_11759":3455,"_45083":3365,"_17088":97166,"_5":16624,"_23503":3365,"_7204":97167},[45581],"C.Country",{"_11759":3456,"_45083":3365,"_17088":97169,"_5":16624,"_23503":3365,"_7204":97170},[45581],"O.Date",{"_11759":3457,"_45083":3365,"_17088":97172,"_5":16624,"_23503":3365,"_7204":42834},[45581],{"_11759":3458,"_45083":3365,"_17088":97174,"_5":16624,"_23503":3365,"_7204":97072},[45581],{"_11759":3459,"_45083":3365,"_17088":97176,"_5":16624,"_23503":3365,"_7204":97075},[45581],{"_11759":3460,"_45083":3365,"_17088":97178,"_5":16624,"_23503":3365,"_7204":43384},[45581],{"_11759":3461,"_45083":3365,"_17088":97180,"_5":16624,"_23503":3365,"_7204":42843},[45581],{"_11759":3462,"_45083":3365,"_17088":97182,"_5":16624,"_23503":3365,"_7204":97064},[45581],{"_11759":3463,"_45083":3365,"_17088":97184,"_5":16624,"_23503":3365,"_7204":97067},[45581],{"_11759":3464,"_45083":3365,"_17088":97186,"_5":16624,"_23503":3365,"_7204":43394},[45581],{"_11759":3465,"_45083":3365,"_17088":97188,"_5":16624,"_23503":3365,"_7204":42852},[45581],{"_11759":3466,"_45083":3365,"_17088":97190,"_5":16624,"_23503":3365,"_7204":97056},[45581],{"_11759":3467,"_45083":3365,"_17088":97192,"_5":16624,"_23503":3365,"_7204":97059},[45581],{"_11759":3468,"_45083":3365,"_17088":97194,"_5":16624,"_23503":3365,"_7204":43404},[45581],{"_11759":3469,"_45083":3365,"_17088":97196,"_5":16624,"_23503":3365,"_7204":42861},[45581],{"_11759":3470,"_45083":3365,"_17088":97198,"_5":16624,"_23503":3365,"_7204":97072},[45581],{"_11759":3471,"_45083":3365,"_17088":97200,"_5":16624,"_23503":3365,"_7204":97075},[45581],{"_11759":3472,"_45083":3365,"_17088":97202,"_5":16624,"_23503":3365,"_7204":43414},[45581],{"_11759":3473,"_45083":3365,"_17088":97204,"_5":16624,"_23503":3365,"_7204":42870},[45581],{"_11759":3474,"_45083":3365,"_17088":97206,"_5":16624,"_23503":3365,"_7204":97080},[45581],{"_11759":3475,"_45083":3365,"_17088":97208,"_5":16624,"_23503":3365,"_7204":97051},[45581],{"_11759":3476,"_45083":3365,"_17088":97210,"_5":16624,"_23503":3365,"_7204":43424},[45581],{"_11759":3477,"_45083":3365,"_17088":97212,"_5":16624,"_23503":96926,"_7204":97213},[45581],"Secondary indices will be automatically utilized when running join queries. For example, if we create indices on the \"Orders\" table and the \"Items\" table respectively, which are defined as follows:",{"_11759":3478,"_45083":3365,"_17088":97215,"_5":16624,"_23503":96926,"_7204":97216},[45581],"We can find out each item's total sales value by joining the \"Items\" table and the \"Orders\" table and then grouping the joined result with \"ItemName\" (and also adding some filtering conditions):",{"_11759":3479,"_45083":3365,"_17088":97218,"_5":16624,"_23503":96926,"_7204":97219},[45581],"The results will be like:",{"_11759":3480,"_45083":3365,"_17088":97221,"_5":16624,"_23503":96926,"_7204":97099},[45581],{"_11759":3481,"_45083":3365,"_17088":97223,"_5":16624,"_23503":96926,"_7204":97224},[45581],"OrderValue",{"_11759":3482,"_45083":3365,"_17088":97226,"_5":16624,"_23503":96926,"_7204":97107},[45581],{"_11759":3483,"_45083":3365,"_17088":97228,"_5":16624,"_23503":96926,"_7204":42747},[45581],{"_11759":3484,"_45083":3365,"_17088":97230,"_5":16624,"_23503":96926,"_7204":97123},[45581],{"_11759":3485,"_45083":3365,"_17088":97232,"_5":16624,"_23503":96926,"_7204":42889},[45581],{"_11759":3486,"_45083":3365,"_17088":97234,"_5":16624,"_23503":96926,"_7204":97149},[45581],{"_11759":3487,"_45083":3365,"_17088":97236,"_5":16624,"_23503":96926,"_7204":43494},[45581],{"_11759":3488,"_45083":3365,"_17088":97238,"_5":16624,"_23503":96926,"_7204":97239},[45581],"The execution plan for this query (by running EXPLAIN <query>) will be:",{"_11759":3489,"_45083":3365,"_17088":97241,"_5":16624,"_23503":96926,"_7204":97242},[45581],"In this case, the index table iItems is used in place of the data table Items since the index table iItems is indexed on column ItemName and will hence benefit the GROUP BY clause in this query. Meanwhile, the index table i2Orders is favored over the data table Orders and another index table iOrders because a range scan instead of a full scan can be applied as a result of the WHERE clause.",{"_11759":3490,"_45083":3365,"_17088":97244,"_5":16624,"_23503":96930,"_7204":97245},[45581],"Phoenix also supports complex join syntax such as grouped joins (or sub joins) and joins with derived-tables. You can group joins by using parenthesis to prioritize certain joins before other joins are executed. You can also replace any one (or more) of your join tables with a subquery (derived table), which could be yet another join query.",{"_11759":3491,"_45083":3365,"_17088":97247,"_5":16624,"_23503":96930,"_7204":97248},[45581],"For grouped joins, you can write something like:",{"_11759":3492,"_45083":3365,"_17088":97250,"_5":16624,"_23503":96930,"_7204":97251},[45581],"By replacing the sub join with a subquery (derived table), we get an equivalent query as:",{"_11759":3493,"_45083":3365,"_17088":97253,"_5":16624,"_23503":96930,"_7204":97254},[45581],"As an alternative to the earlier example where we find each item's sales figures, instead of using GROUP BY after joining two tables, we can join the \"Items\" table with grouped results from the \"Orders\" table:",{"_11759":3494,"_45083":3365,"_17088":97256,"_5":16624,"_23503":96934,"_7204":97257},[45581],"Basic hash join usually outperforms other types of join algorithms, but it has its limitations too, the most significant of which is the assumption that one of the relations must be small enough to fit into memory. Thus Phoenix now has both hash join and sort-merge join implemented to facilitate fast join operations as well as join between two large tables.",{"_11759":3495,"_45083":3365,"_17088":97259,"_5":16624,"_23503":96934,"_7204":97260},[45581],"Phoenix currently uses hash join whenever possible since it is usually faster. You can force sort-merge join with hint USE_SORT_MERGE_JOIN. Choosing between algorithms and detecting the smaller relation for hash join is expected to be increasingly guided by table statistics.",{"_11759":3496,"_45083":3365,"_17088":97262,"_5":16624,"_23503":96938,"_7204":97263},[45581],"Oftentimes a join will occur from a child table to a parent table, mapping the foreign key of the child table to the primary key of the parent. So instead of doing a full scan on the parent table, Phoenix will drive a skip-scan or a range-scan based on the foreign key values it got from the child table result.",{"_11759":3497,"_45083":3365,"_17088":97265,"_5":16624,"_23503":96938,"_7204":97266},[45581],"Phoenix will extract and sort multiple key parts from the join keys so that it can get the most accurate key hints/ranges possible for the parent table scan.",{"_11759":3498,"_45083":3365,"_17088":97268,"_5":16624,"_23503":96938,"_7204":97269},[45581],"For example, we have parent table \"Employee\" and child table \"Patent\" defined as:",{"_11759":3499,"_45083":3365,"_17088":97271,"_5":16624,"_23503":96938,"_7204":97272},[45581],"Now we'd like to find employees who filed patents after January 2000 and list their names by patent count:",{"_11759":3500,"_45083":3365,"_17088":97274,"_5":16624,"_23503":96938,"_7204":97275},[45581],"The above statement will do a skip-scan over the \"Employee\" table and will use both join key \"Region\" and \"LocalID\" for runtime key hint calculation. Below is the execution time of this query with and without this optimization on an \"Employee\" table of about 5000000 records and a \"Patent\" table of about 1000 records:",{"_11759":3501,"_45083":3365,"_17088":97277,"_5":16624,"_23503":96938,"_7204":97278},[45581],"W/O Optimization",{"_11759":3502,"_45083":3365,"_17088":97280,"_5":16624,"_23503":96938,"_7204":97281},[45581],"W/ Optimization",{"_11759":3503,"_45083":3365,"_17088":97283,"_5":16624,"_23503":96938,"_7204":97284},[45581],"8.1s",{"_11759":3504,"_45083":3365,"_17088":97286,"_5":16624,"_23503":96938,"_7204":97287},[45581],"0.4s",{"_11759":3505,"_45083":3365,"_17088":97289,"_5":16624,"_23503":96938,"_7204":97290},[45581],"However, there are times when foreign key values from the child table account for the complete primary key space in the parent table, so skip scans may be slower. You can turn off this optimization with hint NO_CHILD_PARENT_OPTIMIZATION. Table statistics are expected to help make smarter choices between these schemes.",{"_11759":3506,"_45083":3365,"_17088":97292,"_5":16624,"_23503":96942,"_7204":97293},[45581],"As mentioned earlier, if we decide to use the hash join approach for our join queries, the prerequisite is that either of the relations can be small enough to fit into memory in order to be broadcast over all servers that have the data of concern from the other relation. And aside from making sure that the region server heap size is big enough to hold the smaller relation, we might also need to pay a attention to a few configuration parameters that are crucial to running hash joins.",{"_11759":3507,"_45083":3365,"_17088":97295,"_5":16624,"_23503":96942,"_7204":97296},[45581],"The server-side caches hold the hash table built on the smaller relation. Cache size and lifetime are controlled by the following parameters. A relation may be a physical table, a view, a subquery, or a joined result of other relations in a multi-join query.",{"_11759":3508,"_45083":3365,"_17088":97298,"_5":16624,"_23503":96942,"_7204":93683},[45581],{"_11759":3509,"_45083":3365,"_17088":97300,"_5":16624,"_23503":96942,"_7204":97301},[45581],"Maximum size (in bytes) of the raw results of a relation before being compressed and sent over to the region servers.",{"_11759":3510,"_45083":3365,"_17088":97303,"_5":16624,"_23503":96942,"_7204":97304},[45581],"Attempting to serializing the raw results of a relation with a size bigger than this setting will result in a MaxServerCacheSizeExceededException.",{"_11759":3511,"_45083":3365,"_17088":97306,"_5":16624,"_23503":96942,"_7204":97307},[45581],"Default: 104,857,600",{"_11759":3512,"_45083":3365,"_17088":97309,"_5":16624,"_23503":96942,"_7204":93594},[45581],{"_11759":3513,"_45083":3365,"_17088":97311,"_5":16624,"_23503":96942,"_7204":97312},[45581],"Percentage of total heap memory (i.e. Runtime.getRuntime().maxMemory()) that all threads may use.",{"_11759":3514,"_45083":3365,"_17088":97314,"_5":16624,"_23503":96942,"_7204":97315},[45581],"The summed size of all living caches must be smaller than this global memory pool size. Otherwise, you would get an InsufficientMemoryException.",{"_11759":3515,"_45083":3365,"_17088":97317,"_5":16624,"_23503":96942,"_7204":97318},[45581],"Default: 15",{"_11759":3516,"_45083":3365,"_17088":97320,"_5":16624,"_23503":96942,"_7204":93691},[45581],{"_11759":3517,"_45083":3365,"_17088":97322,"_5":16624,"_23503":96942,"_7204":97323},[45581],"Maximum living time (in milliseconds) of server caches. A cache entry expires after this amount of time has passed since last access.",{"_11759":3518,"_45083":3365,"_17088":97325,"_5":16624,"_23503":96942,"_7204":97326},[45581],"Consider adjusting this parameter when a server-side IOException (\"Could not find hash cache for joinId\") happens. Getting warnings like \"Earlier hash cache(s) might have expired on servers\" might also be a sign that this number should be increased.",{"_11759":3519,"_45083":3365,"_17088":97328,"_5":16624,"_23503":96942,"_7204":97329},[45581],"Default: 30,000",{"_11759":3520,"_45083":3365,"_17088":97331,"_5":16624,"_23503":96942,"_7204":97332},[45581],"See our Configuration and Tuning Guide for more details.",{"_11759":3521,"_45083":3365,"_17088":97334,"_5":16624,"_23503":96942,"_7204":97335},[45581],"Although changing parameters can sometimes be a solution to getting rid of the exceptions mentioned above, it is highly recommended that you first consider optimizing the join queries according to the information provided in the following section.",{"_11759":3522,"_45083":3365,"_17088":97337,"_5":16624,"_23503":96945,"_7204":97338},[45581],"Now that we know hash joins depend heavily on available memory, instead of immediately changing configuration, it can be enough to understand execution internals and adjust table order in your join query.",{"_11759":3523,"_45083":3365,"_17088":97340,"_5":16624,"_23503":96945,"_7204":97341},[45581],"Below is the default join order (without table statistics) and which side of the query is treated as the \"smaller\" relation and put into server cache:",{"_11759":3524,"_45083":3365,"_17088":97343,"_5":16624,"_23503":96945,"_7204":97344},[45581],"lhs INNER JOIN rhsrhs will be built as hash table in server cache.",{"_11759":3525,"_45083":3365,"_17088":97346,"_5":16624,"_23503":96945,"_7204":97347},[45581],"lhs LEFT OUTER JOIN rhsrhs will be built as hash table in server cache.",{"_11759":3526,"_45083":3365,"_17088":97349,"_5":16624,"_23503":96945,"_7204":97350},[45581],"lhs RIGHT OUTER JOIN rhslhs will be built as hash table in server cache.",{"_11759":3527,"_45083":3365,"_17088":97352,"_5":16624,"_23503":96945,"_7204":97353},[45581],"Join order is more complicated with multi-join queries. You can run EXPLAIN <join_query> to inspect the actual execution plan. For multi-inner-join queries, Phoenix applies star-join optimization by default, which means the leading (left-hand-side) table is scanned once while joining all right-hand-side tables at the same time. You can disable this optimization with hint NO_STAR_JOIN if total size of right-hand-side tables exceeds memory limits.",{"_11759":3528,"_45083":3365,"_17088":97355,"_5":16624,"_23503":96945,"_7204":97356},[45581],"Let's take the previous query for example:",{"_11759":3529,"_45083":3365,"_17088":97358,"_5":16624,"_23503":96945,"_7204":97359},[45581],"The default join order (using star-join optimization) will be:",{"_11759":3530,"_45083":3365,"_17088":97361,"_5":16624,"_23503":96945,"_7204":97362},[45581],"Alternatively, if we use hint NO_STAR_JOIN:",{"_11759":3531,"_45083":3365,"_17088":97364,"_5":16624,"_23503":96945,"_7204":97365},[45581],"The join order will be:",{"_11759":3532,"_45083":3365,"_17088":97367,"_5":16624,"_23503":96945,"_7204":97368},[45581],"It is also worth mentioning that not the entire dataset of the table should be counted into the memory consumption. Instead, only those columns used by the query, and of only the records that satisfy the predicates will be built into the server hash table.",{"_11759":3533,"_45083":3365,"_17088":97370,"_5":16624,"_23503":96949,"_7204":97371},[45581],"In our Phoenix 3.3.0 and 4.3.0 releases, joins have the following restrictions and improvements to be made:",{"_11759":3534,"_45083":3365,"_17088":97373,"_5":16624,"_23503":96949,"_7204":97374},[45581],"PHOENIX-1555: Fallback to many-to-many join if hash join fails due to insufficient memory.",{"_11759":3535,"_45083":3365,"_17088":97376,"_5":16624,"_23503":96949,"_7204":97377},[45581],"PHOENIX-1556: Base hash join versus many-to-many decision on how many guideposts will be traversed for RHS table(s).",{"_11759":3536,"_45083":3365,"_17088":97379,"_5":16624,"_23503":96949,"_7204":97380},[45581],"Continuous efforts are being made to bring in more performance enhancement for join queries based on table statistics. Please refer to our Roadmap for more information.",{"_11759":3537,"_45083":3537,"_5":12188,"_7204":95530,"_45552":97382,"_17088":97383,"_23503":3537},[86704,86705,86972],[45581],{"_11759":3538,"_45083":3537,"_17088":97385,"_5":16624,"_23503":3537,"_7204":97386},[45581],"Phoenix in 15 minutes or less.",{"_11759":3539,"_45083":3537,"_5":45549,"_17088":97388,"_23503":97389,"_7204":97390},[45581],"/docs/quick-start#what-is-this-new-phoenix-thing-ive-been-hearing-about","What is this new Phoenix thing I've been hearing about?",{"_11759":3540,"_45083":3537,"_5":45549,"_17088":97392,"_23503":97393,"_7204":97394},[45581],"/docs/quick-start#doesnt-putting-an-extra-layer-between-my-application-and-hbase-just-slow-things-down","Doesn't putting an extra layer between my application and HBase just slow things down?",{"_11759":3541,"_45083":3537,"_5":45549,"_17088":97396,"_23503":97397,"_7204":97398},[45581],"/docs/quick-start#ok-so-its-fast-but-why-sql-its-so-1970s","Ok, so it's fast. But why SQL? It's so 1970s",{"_11759":3542,"_45083":3537,"_5":45549,"_17088":97400,"_23503":97401,"_7204":97402},[45581],"/docs/quick-start#but-how-can-sql-support-my-favorite-hbase-technique-of-xyz","But how can SQL support my favorite HBase technique of x,y,z",{"_11759":3543,"_45083":3537,"_5":45549,"_17088":97404,"_23503":97405,"_7204":97406},[45581],"/docs/quick-start#blah-blah-blah---i-just-want-to-get-started","Blah, blah, blah - I just want to get started!",{"_11759":3544,"_45083":3537,"_5":45549,"_17088":97408,"_23503":97409,"_7204":97410},[45581],"/docs/quick-start#i-dont-want-to-download-and-setup-anything-else","I don't want to download and setup anything else!",{"_11759":3545,"_45083":3537,"_5":45549,"_17088":97412,"_23503":97413,"_7204":97414},[45581],"/docs/quick-start#first-lets-create-a-us_populationsql-file-containing-a-table-definition","First, let's create a us_population.sql file, containing a table definition:",{"_11759":3546,"_45083":3537,"_5":45549,"_17088":97416,"_23503":97417,"_7204":97418},[45581],"/docs/quick-start#now-lets-create-a-us_populationcsv-file-containing-some-data-to-put-in-that-table","Now let's create a us_population.csv file containing some data to put in that table:",{"_11759":3547,"_45083":3537,"_5":45549,"_17088":97420,"_23503":97421,"_7204":97422},[45581],"/docs/quick-start#execute-the-following-command-from-a-command-terminal-to-create-and-populate-the-table","Execute the following command from a command terminal to create and populate the table",{"_11759":3548,"_45083":3537,"_5":45549,"_17088":97424,"_23503":97425,"_7204":97426},[45581],"/docs/quick-start#start-the-interactive-sql-client","Start the interactive sql client",{"_11759":3549,"_45083":3537,"_5":45549,"_17088":97428,"_23503":97429,"_7204":97430},[45581],"/docs/quick-start#big-deal---10-rows-what-else-you-got","Big deal - 10 rows! What else you got?",{"_11759":3550,"_45083":3537,"_5":45549,"_17088":97432,"_23503":97433,"_7204":97434},[45581],"/docs/quick-start#why-is-it-called-phoenix-anyway-did-some-other-project-crash-and-burn-and-this-is-the-next-generation","Why is it called Phoenix anyway? Did some other project crash and burn and this is the next generation?",{"_11759":3551,"_45083":3537,"_17088":97436,"_5":16624,"_23503":97389,"_7204":97437},[45581],"Phoenix is an open source SQL skin for HBase. You use the standard JDBC APIs instead of the regular HBase client APIs to create tables, insert data, and query your HBase data.",{"_11759":3552,"_45083":3537,"_17088":97439,"_5":16624,"_23503":97393,"_7204":97440},[45581],"Actually, no. Phoenix achieves as good or likely better performance than if you hand-coded it yourself (not to mention with a heck of a lot less code) by:",{"_11759":3553,"_45083":3537,"_17088":97442,"_5":16624,"_23503":97393,"_7204":97443},[45581],"compiling your SQL queries to native HBase scans",{"_11759":3554,"_45083":3537,"_17088":97445,"_5":16624,"_23503":97393,"_7204":97446},[45581],"determining the optimal start and stop for your scan key",{"_11759":3555,"_45083":3537,"_17088":97448,"_5":16624,"_23503":97393,"_7204":97449},[45581],"orchestrating the parallel execution of your scans",{"_11759":3556,"_45083":3537,"_17088":97451,"_5":16624,"_23503":97393,"_7204":97452},[45581],"bringing the computation to the data by",{"_11759":3557,"_45083":3537,"_17088":97454,"_5":16624,"_23503":97393,"_7204":97455},[45581],"pushing the predicates in your where clause to a server-side filter",{"_11759":3558,"_45083":3537,"_17088":97457,"_5":16624,"_23503":97393,"_7204":97458},[45581],"executing aggregate queries through server-side hooks (called co-processors)",{"_11759":3559,"_45083":3537,"_17088":97460,"_5":16624,"_23503":97393,"_7204":97461},[45581],"secondary indexes to improve performance for queries on non row key columns",{"_11759":3560,"_45083":3537,"_17088":97463,"_5":16624,"_23503":97393,"_7204":97464},[45581],"stats gathering to improve parallelization and guide choices between optimizations",{"_11759":3561,"_45083":3537,"_17088":97466,"_5":16624,"_23503":97393,"_7204":97467},[45581],"skip scan filter to optimize IN, LIKE, and OR queries",{"_11759":3562,"_45083":3537,"_17088":97469,"_5":16624,"_23503":97393,"_7204":97470},[45581],"optional salting of row keys to evenly distribute write load",{"_11759":3563,"_45083":3537,"_17088":97472,"_5":16624,"_23503":97397,"_7204":97473},[45581],"Well, that's kind of the point: give folks something with which they're already familiar. What better way to spur the adoption of HBase? On top of that, using JDBC and SQL:",{"_11759":3564,"_45083":3537,"_17088":97475,"_5":16624,"_23503":97397,"_7204":97476},[45581],"Reduces the amount of code users need to write",{"_11759":3565,"_45083":3537,"_17088":97478,"_5":16624,"_23503":97397,"_7204":97479},[45581],"Allows for performance optimizations transparent to the user",{"_11759":3566,"_45083":3537,"_17088":97481,"_5":16624,"_23503":97397,"_7204":97482},[45581],"Opens the door for leveraging and integrating lots of existing tooling",{"_11759":3567,"_45083":3537,"_17088":97484,"_5":16624,"_23503":97401,"_7204":97485},[45581],"Didn't make it to the last HBase Meetup did you? SQL is just a way of expressing what you want to get not how you want to get it. Check out my presentation for various existing and to-be-done Phoenix features to support your favorite HBase trick. Have ideas of your own? We'd love to hear about them: file an issue for us and/or join our mailing list.",{"_11759":3568,"_45083":3537,"_17088":97487,"_5":16624,"_23503":97405,"_7204":97488},[45581],"Ok, great! Just follow our install instructions:",{"_11759":3569,"_45083":3537,"_17088":97490,"_5":16624,"_23503":97405,"_7204":97491},[45581],"download and expand our installation binary tar corresponding to your HBase version",{"_11759":3570,"_45083":3537,"_17088":97493,"_5":16624,"_23503":97405,"_7204":97494},[45581],"copy the phoenix server jar into the lib directory of every region server and master",{"_11759":3571,"_45083":3537,"_17088":97496,"_5":16624,"_23503":97405,"_7204":97497},[45581],"restart HBase",{"_11759":3572,"_45083":3537,"_17088":97499,"_5":16624,"_23503":97405,"_7204":97500},[45581],"add the phoenix client jar to the classpath of your JDBC client or application",{"_11759":3573,"_45083":3537,"_17088":97502,"_5":16624,"_23503":97405,"_7204":97503},[45581],"We have detailed instructions for setting up SQuirreL SQL as your SQL client",{"_11759":3574,"_45083":3537,"_17088":97505,"_5":16624,"_23503":97409,"_7204":97506},[45581],"Ok, fair enough - you can create your own SQL scripts and execute them using our command line tools instead. Let's walk through an example now. Begin by navigating to the bin/ directory of your Phoenix install location.",{"_11759":3575,"_45083":3537,"_17088":97508,"_5":16624,"_23503":97425,"_7204":97509},[45581],"and issue a query",{"_11759":3576,"_45083":3537,"_17088":97511,"_5":16624,"_23503":97425,"_7204":97512},[45581],"Congratulations! You've just created your first Phoenix table, inserted data into it, and executed an aggregate query with just a few lines of code in 15 minutes or less!",{"_11759":3577,"_45083":3537,"_17088":97514,"_5":16624,"_23503":97429,"_7204":97515},[45581],"Ok, ok - tough crowd. Check out our bin/performance.py script to create as many rows as you want, for any schema you come up with, and run timed queries against it.",{"_11759":3578,"_45083":3537,"_17088":97517,"_5":16624,"_23503":97433,"_7204":97518},[45581],"I'm sorry, but we're out of time and space, so we'll have to answer that next time!",{"_11759":3579,"_45083":3579,"_5":12188,"_7204":97520,"_45552":97521,"_17088":97522,"_23503":3579},"Sequences",[86704,86705,86818],[45581],{"_11759":3580,"_45083":3579,"_17088":97524,"_5":16624,"_23503":3579,"_7204":97525},[45581],"Create, configure, and use SQL sequences in Phoenix, including caching, cycling, and NEXT/CURRENT VALUE semantics.",{"_11759":3581,"_45083":3579,"_17088":97527,"_5":16624,"_23503":3579,"_7204":97528},[45581],"Sequences are a standard SQL feature that generate monotonically increasing numbers, typically used to create IDs. To create a sequence, use:",{"_11759":3582,"_45083":3579,"_17088":97530,"_5":16624,"_23503":3579,"_7204":97531},[45581],"This creates a sequence named my_schema.my_sequence with an initial value of 1, incremented by 1 each time, with no cycle, minimum value, or maximum value, and 100 sequence values cached in your session (controlled by the phoenix.sequence.cacheSize config parameter). The complete syntax of CREATE SEQUENCE is documented here.",{"_11759":3583,"_45083":3579,"_17088":97533,"_5":16624,"_23503":3579,"_7204":97534},[45581],"Caching sequence values on your session improves performance, as we don't need to ask the server for more sequence values until we run out of cached values. The tradeoff is that you may end up with gaps in your sequence values when other sessions also use the same sequence.",{"_11759":3584,"_45083":3579,"_17088":97536,"_5":16624,"_23503":3579,"_7204":97537},[45581],"All of these parameters can be overridden when the sequence is created like this:",{"_11759":3585,"_45083":3579,"_17088":97539,"_5":16624,"_23503":3579,"_7204":97540},[45581],"Phoenix 3.1/4.1 added support for defining minimum and maximum values using MINVALUE and MAXVALUE, and for controlling cycling with the CYCLE keyword. Specifying CYCLE means the sequence continues generating values after reaching either boundary. For ascending sequences, after the maximum it returns to the minimum. For descending sequences, after the minimum it returns to the maximum. For example:",{"_11759":3586,"_45083":3579,"_17088":97542,"_5":16624,"_23503":3579,"_7204":97543},[45581],"will cause the sequence to cycle continuously from 1 to 100.",{"_11759":3587,"_45083":3579,"_17088":97545,"_5":16624,"_23503":3579,"_7204":97546},[45581],"Sequences are incremented using the NEXT VALUE FOR <sequence_name> expression in UPSERT VALUES, UPSERT SELECT, or SELECT statements:",{"_11759":3588,"_45083":3579,"_17088":97548,"_5":16624,"_23503":3579,"_7204":97549},[45581],"This will allocate a BIGINT based on the next value from the sequence (beginning with the START WITH value and incrementing from there based on the INCREMENT BY amount).",{"_11759":3589,"_45083":3579,"_17088":97551,"_5":16624,"_23503":3579,"_7204":97552},[45581],"When used in an UPSERT SELECT or SELECT statement, each row returned by the statement would have a unique value associated with it. For example:",{"_11759":3590,"_45083":3579,"_17088":97554,"_5":16624,"_23503":3579,"_7204":97555},[45581],"This allocates a new sequence value for each row returned from the SELECT expression. A sequence is incremented only once per statement, so multiple references to the same sequence by NEXT VALUE FOR produce the same value. For example, in the statement below, my_table.col1 and my_table.col2 would end up with the same value:",{"_11759":3591,"_45083":3579,"_17088":97557,"_5":16624,"_23503":3579,"_7204":97558},[45581],"You may also access the last sequence value allocated using a CURRENT VALUE FOR expression as shown below:",{"_11759":3592,"_45083":3579,"_17088":97560,"_5":16624,"_23503":3579,"_7204":97561},[45581],"This would evaluate to the last sequence value allocated from the previous NEXT VALUE FOR expression for your session (i.e. all connections on the same JVM for the same client machine). If no NEXT VALUE FOR expression had been previously called, this would produce an exception. If in a given statement a CURRENT VALUE FOR expression is used together with a NEXT VALUE FOR expression for the same sequence, then both would evaluate to the value produced by the NEXT VALUE FOR expression.",{"_11759":3593,"_45083":3579,"_17088":97563,"_5":16624,"_23503":3579,"_7204":97564},[45581],"The NEXT VALUE FOR and CURRENT VALUE FOR expressions may only be used as SELECT expressions or in the UPSERT VALUES statement. Use in WHERE, GROUP BY, HAVING, or ORDER BY will produce an exception. In addition, they cannot be used as the argument to an aggregate function.",{"_11759":3594,"_45083":3579,"_17088":97566,"_5":16624,"_23503":3579,"_7204":97567},[45581],"To drop a sequence, issue the following command:",{"_11759":3595,"_45083":3579,"_17088":97569,"_5":16624,"_23503":3579,"_7204":97570},[45581],"To discover all sequences that have been created, you may query the SYSTEM.SEQUENCE table as shown here:",{"_11759":3596,"_45083":3579,"_17088":97572,"_5":16624,"_23503":3579,"_7204":97573},[45581],"Note that only read-only access to the SYSTEM.SEQUENCE table is supported.",{"_11759":3597,"_45083":3597,"_5":12188,"_7204":97575,"_45552":97576,"_17088":97577,"_23503":3597},"Subqueries",[86704,86705,86818],[45581],{"_11759":3598,"_45083":3597,"_17088":97579,"_5":16624,"_23503":3597,"_7204":97580},[45581],"Use IN/EXISTS/comparison subqueries, correlated subqueries, row subqueries, and derived tables in Phoenix.",{"_11759":3599,"_45083":3597,"_5":45549,"_17088":97582,"_23503":97583,"_7204":97584},[45581],"/docs/subqueries#subqueries-with-in-or-not-in","Subqueries with IN or NOT IN",{"_11759":3600,"_45083":3597,"_5":45549,"_17088":97586,"_23503":97587,"_7204":97588},[45581],"/docs/subqueries#subqueries-with-exists-or-not-exists","Subqueries with EXISTS or NOT EXISTS",{"_11759":3601,"_45083":3597,"_5":45549,"_17088":97590,"_23503":97591,"_7204":97592},[45581],"/docs/subqueries#semi-joins-and-anti-joins","Semi-joins and Anti-joins",{"_11759":3602,"_45083":3597,"_5":45549,"_17088":97594,"_23503":97595,"_7204":97596},[45581],"/docs/subqueries#semi-join-optimization","Semi-join Optimization",{"_11759":3603,"_45083":3597,"_5":45549,"_17088":97598,"_23503":97599,"_7204":97600},[45581],"/docs/subqueries#subqueries-with-comparison-operators","Subqueries with Comparison Operators",{"_11759":3604,"_45083":3597,"_5":45549,"_17088":97602,"_23503":97603,"_7204":97604},[45581],"/docs/subqueries#subqueries-with-anysomeall-comparison-operators","Subqueries with ANY/SOME/ALL Comparison Operators",{"_11759":3605,"_45083":3597,"_5":45549,"_17088":97606,"_23503":97607,"_7204":97608},[45581],"/docs/subqueries#correlated-subqueries","Correlated Subqueries",{"_11759":3606,"_45083":3597,"_5":45549,"_17088":97610,"_23503":97611,"_7204":97612},[45581],"/docs/subqueries#andor-branches-and-multiple-levels-of-nesting","AND/OR Branches and Multiple levels of Nesting",{"_11759":3607,"_45083":3597,"_5":45549,"_17088":97614,"_23503":97615,"_7204":97616},[45581],"/docs/subqueries#row-subqueries","Row subqueries",{"_11759":3608,"_45083":3597,"_5":45549,"_17088":97618,"_23503":97619,"_7204":97620},[45581],"/docs/subqueries#derived-tables","Derived Tables",{"_11759":3609,"_45083":3597,"_5":45549,"_17088":97622,"_23503":97623,"_7204":86826},[45581],"/docs/subqueries#subqueries-limitations",{"_11759":3610,"_45083":3597,"_17088":97625,"_5":16624,"_23503":3597,"_7204":97626},[45581],"Phoenix now supports subqueries in the WHERE clause and the FROM clause. Subqueries can be specified in many places, like IN/NOT IN, EXISTS/NOT EXISTS, unmodified comparison operators or ANY/SOME/ALL comparison operators.",{"_11759":3611,"_45083":3597,"_17088":97628,"_5":16624,"_23503":97583,"_7204":97629},[45581],"The following query finds the names of the items that have sales record after Sept 2nd 2013. The inner query returns a list of items that satisfy the search criteria and the outer query will make use of this list to find matching entries.",{"_11759":3612,"_45083":3597,"_17088":97631,"_5":16624,"_23503":97587,"_7204":97632},[45581],"EXISTS simply tests the existence of the returned rows by the inner query. If the inner query returns one or more rows, EXISTS returns a value of TRUE; otherwise a value of FALSE. Many EXISTS queries are used to achieve the same goal as with IN queries or with ANY/SOME/ALL comparison queries. The below query returns the same results as the query in the previous example does:",{"_11759":3613,"_45083":3597,"_17088":97634,"_5":16624,"_23503":97591,"_7204":97635},[45581],"Queries with IN/NOT IN or EXISTS/NOT EXISTS are implemented with semi-joins and anti-joins wherever possible. A semi-join is different from a conventional join in that rows in the first table will be returned at most once, regardless of how many matches the second table contains for a certain row in the first table. A semi-join returns all those rows from the first table which can find at least one match in the second table. An IN or EXISTS construct is often translated into semi-joins.",{"_11759":3614,"_45083":3597,"_17088":97637,"_5":16624,"_23503":97591,"_7204":97638},[45581],"An anti-join is the opposite of a semi-join. The results of an anti-join are all those rows from the first table that can find no match in the second table. A NOT IN or NOT EXISTS construct is often translated into anti-joins.",{"_11759":3615,"_45083":3597,"_17088":97640,"_5":16624,"_23503":97595,"_7204":97641},[45581],"The \"Foreign Key to Primary Key Join Optimization\" mentioned in Phoenix Joins is equally applied to semi-joins. So if a skip-scan is driven for a semi-join qualified for this optimization and the IN or EXISTS semantics can be fully substituted by the skip-scan alone, the server-side join operation will not happen at all.",{"_11759":3616,"_45083":3597,"_17088":97643,"_5":16624,"_23503":97599,"_7204":97644},[45581],"Subqueries can be specified as the right-hand-side operand of the comparison operators (=, <>, >, >=, <, !>, !<, or <=).",{"_11759":3617,"_45083":3597,"_17088":97646,"_5":16624,"_23503":97599,"_7204":97647},[45581],"The example below finds participants whose contest scores are greater than the overall average score.",{"_11759":3618,"_45083":3597,"_17088":97649,"_5":16624,"_23503":97599,"_7204":97650},[45581],"A subquery introduced with an unmodified comparison operator (a comparison operator not followed by ANY or ALL) must only return a single row; otherwise it would result in getting a SQL error message.",{"_11759":3619,"_45083":3597,"_17088":97652,"_5":16624,"_23503":97603,"_7204":97653},[45581],"Subqueries can be introduced with a comparison operator modified by the keywords ANY, SOME or ALL, which has exactly the same semantics with static arrays, only that the array elements have to be dynamically computed through the execution of the inner query.",{"_11759":3620,"_45083":3597,"_17088":97655,"_5":16624,"_23503":97603,"_7204":97656},[45581],"The following query provides an example which lists the orders with a quantity greater than or equal to the maximum order quantity of any item.",{"_11759":3621,"_45083":3597,"_17088":97658,"_5":16624,"_23503":97607,"_7204":97659},[45581],"Correlated subqueries (also known as synchronized subqueries) are subqueries that contain references to the outer queries. Unlike independent subqueries, which only need to be evaluated once, the correlated inner query result depends on the outer query values and may differ from row to row.",{"_11759":3622,"_45083":3597,"_17088":97661,"_5":16624,"_23503":97607,"_7204":97662},[45581],"The following example finds the patents filed earlier than or equal to all patents filed within the same region:",{"_11759":3623,"_45083":3597,"_17088":97664,"_5":16624,"_23503":97607,"_7204":97665},[45581],"Phoenix optimizes such queries by rewriting them into equivalent join queries so that the inner query only needs to be executed once instead of once per outer row. The correlated subquery above will be rewritten in Phoenix as:",{"_11759":3624,"_45083":3597,"_17088":97667,"_5":16624,"_23503":97607,"_7204":97668},[45581],"Here, collect_distinct() is a reserved internal function in Phoenix, which collects distinct values of a given column or expression into a Phoenix array.",{"_11759":3625,"_45083":3597,"_17088":97670,"_5":16624,"_23503":97611,"_7204":97671},[45581],"Correlated subqueries or independent subqueries can be specified anywhere in the WHERE clause, whether in AND branches or in OR branches. And a query can have more than one level of subquery nesting, which means a subquery can include yet another (or more) subquery in itself.",{"_11759":3626,"_45083":3597,"_17088":97673,"_5":16624,"_23503":97611,"_7204":97674},[45581],"Below is an example of a complicated query that has multiple levels of subqueries connected with AND and OR branches, which is to find the items not involved in the orders sold to customers in Belgium with a quantity lower than 1000 or to customers in Germany with a quantity lower than 2000:",{"_11759":3627,"_45083":3597,"_17088":97676,"_5":16624,"_23503":97615,"_7204":97677},[45581],"A subquery can return multiple fields in one row, which is considered returning a row constructor. The row constructor on both sides of the operator (IN/NOT IN, EXISTS/NOT EXISTS or comparison operator) must contain the same number of values, like in the below example:",{"_11759":3628,"_45083":3597,"_17088":97679,"_5":16624,"_23503":97615,"_7204":97680},[45581],"This query returns all pairs of (column1, column2) that can match any pair of (column3, column4) in the second table after being filtered by condition: column5 = ‘nowhere’.",{"_11759":3629,"_45083":3597,"_17088":97682,"_5":16624,"_23503":97619,"_7204":97683},[45581],"Subqueries specified in the FROM clause are also called derived tables. For example, suppose you want to list a set of maximum values of a grouped table by their frequency of occurrence, and the below query will return the desired result:",{"_11759":3630,"_45083":3597,"_17088":97685,"_5":16624,"_23503":97619,"_7204":97686},[45581],"Derived tables can also be specified anywhere in a join query as join-tables. Please refer to the \"Grouped Joins and Derived Tables\" section of Phoenix Joins for more information and examples.",{"_11759":3631,"_45083":3597,"_17088":97688,"_5":16624,"_23503":97623,"_7204":97689},[45581],"In our Phoenix 3.2 and 4.2 releases, the subquery support has the following restrictions:",{"_11759":3632,"_45083":3597,"_17088":97691,"_5":16624,"_23503":97623,"_7204":97692},[45581],"PHOENIX-1388 Support correlated subqueries in the HAVING clause.",{"_11759":3633,"_45083":3597,"_17088":97694,"_5":16624,"_23503":97623,"_7204":97695},[45581],"PHOENIX-1392 Using subqueries as expressions.",{"_11759":3634,"_45083":3634,"_5":12188,"_7204":97697,"_45552":97698,"_17088":97700,"_23503":3634},"Apache Phoenix Documentation",[86704,97699],"Single-Page Documentation",[45441],{"_11759":3635,"_45083":3634,"_17088":97702,"_5":16624,"_23503":3634,"_7204":97703},[45441],"Complete Apache Phoenix documentation in one continuous page.",{"_11759":3636,"_45083":3634,"_5":45549,"_17088":97705,"_23503":97706,"_7204":89820},[45441],"/docs/single-page#overview",{"_11759":3637,"_45083":3634,"_5":45549,"_17088":97708,"_23503":97709,"_7204":95526},[45441],"/docs/single-page#mission",{"_11759":3638,"_45083":3634,"_5":45549,"_17088":97711,"_23503":97712,"_7204":95530},[45441],"/docs/single-page#index-quick-start",{"_11759":3639,"_45083":3634,"_5":45549,"_17088":97714,"_23503":97715,"_7204":95534},[45441],"/docs/single-page#sql-support",{"_11759":3640,"_45083":3634,"_5":45549,"_17088":97717,"_23503":97718,"_7204":95538},[45441],"/docs/single-page#connection",{"_11759":3641,"_45083":3634,"_5":45549,"_17088":97720,"_23503":97721,"_7204":91889},[45441],"/docs/single-page#index-transactions",{"_11759":3642,"_45083":3634,"_5":45549,"_17088":97723,"_23503":97724,"_7204":95545},[45441],"/docs/single-page#timestamps",{"_11759":3643,"_45083":3634,"_5":45549,"_17088":97726,"_23503":97727,"_7204":95549},[45441],"/docs/single-page#schema",{"_11759":3644,"_45083":3634,"_5":45549,"_17088":97729,"_23503":97730,"_7204":95553},[45441],"/docs/single-page#altering",{"_11759":3645,"_45083":3634,"_5":45549,"_17088":97732,"_23503":97733,"_7204":92320},[45441],"/docs/single-page#index-views",{"_11759":3646,"_45083":3634,"_5":45549,"_17088":97735,"_23503":97736,"_7204":89466},[45441],"/docs/single-page#index-multi-tenancy",{"_11759":3647,"_45083":3634,"_5":45549,"_17088":97738,"_23503":97739,"_7204":95563},[45441],"/docs/single-page#schema-at-read-time",{"_11759":3648,"_45083":3634,"_5":45549,"_17088":97741,"_23503":97742,"_7204":95567},[45441],"/docs/single-page#mapping-to-an-existing-hbase-table",{"_11759":3649,"_45083":3634,"_5":45549,"_17088":97744,"_23503":97745,"_7204":94175},[45441],"/docs/single-page#index-salting",{"_11759":3650,"_45083":3634,"_5":45549,"_17088":97747,"_23503":97748,"_7204":95574},[45441],"/docs/single-page#apis",{"_11759":3651,"_45083":3634,"_5":45549,"_17088":97750,"_23503":97751,"_7204":95530},[45441],"/docs/single-page#quick-start",{"_11759":3652,"_45083":3634,"_5":45549,"_17088":97753,"_23503":97754,"_7204":97390},[45441],"/docs/single-page#what-is-this-new-phoenix-thing-ive-been-hearing-about",{"_11759":3653,"_45083":3634,"_5":45549,"_17088":97756,"_23503":97757,"_7204":97394},[45441],"/docs/single-page#doesnt-putting-an-extra-layer-between-my-application-and-hbase-just-slow-things-down",{"_11759":3654,"_45083":3634,"_5":45549,"_17088":97759,"_23503":97760,"_7204":97398},[45441],"/docs/single-page#ok-so-its-fast-but-why-sql-its-so-1970s",{"_11759":3655,"_45083":3634,"_5":45549,"_17088":97762,"_23503":97763,"_7204":97402},[45441],"/docs/single-page#but-how-can-sql-support-my-favorite-hbase-technique-of-xyz",{"_11759":3656,"_45083":3634,"_5":45549,"_17088":97765,"_23503":97766,"_7204":97406},[45441],"/docs/single-page#blah-blah-blah---i-just-want-to-get-started",{"_11759":3657,"_45083":3634,"_5":45549,"_17088":97768,"_23503":97769,"_7204":97410},[45441],"/docs/single-page#i-dont-want-to-download-and-setup-anything-else",{"_11759":3658,"_45083":3634,"_5":45549,"_17088":97771,"_23503":97772,"_7204":97414},[45441],"/docs/single-page#first-lets-create-a-us_populationsql-file-containing-a-table-definition",{"_11759":3659,"_45083":3634,"_5":45549,"_17088":97774,"_23503":97775,"_7204":97418},[45441],"/docs/single-page#now-lets-create-a-us_populationcsv-file-containing-some-data-to-put-in-that-table",{"_11759":3660,"_45083":3634,"_5":45549,"_17088":97777,"_23503":97778,"_7204":97422},[45441],"/docs/single-page#execute-the-following-command-from-a-command-terminal-to-create-and-populate-the-table",{"_11759":3661,"_45083":3634,"_5":45549,"_17088":97780,"_23503":97781,"_7204":97426},[45441],"/docs/single-page#start-the-interactive-sql-client",{"_11759":3662,"_45083":3634,"_5":45549,"_17088":97783,"_23503":97784,"_7204":97430},[45441],"/docs/single-page#big-deal---10-rows-what-else-you-got",{"_11759":3663,"_45083":3634,"_5":45549,"_17088":97786,"_23503":97787,"_7204":97434},[45441],"/docs/single-page#why-is-it-called-phoenix-anyway-did-some-other-project-crash-and-burn-and-this-is-the-next-generation",{"_11759":3664,"_45083":3634,"_5":45549,"_17088":97789,"_23503":97790,"_7204":88048},[45441],"/docs/single-page#faq",{"_11759":3665,"_45083":3634,"_5":45549,"_17088":97792,"_23503":97793,"_7204":88057},[45441],"/docs/single-page#questions-answered-in-this-page",{"_11759":3666,"_45083":3634,"_5":45549,"_17088":97795,"_23503":97796,"_7204":88061},[45441],"/docs/single-page#i-want-to-get-started-is-there-a-phoenix-hello-world",{"_11759":3667,"_45083":3634,"_5":45549,"_17088":97798,"_23503":97799,"_7204":88065},[45441],"/docs/single-page#using-console",{"_11759":3668,"_45083":3634,"_5":45549,"_17088":97801,"_23503":97802,"_7204":88069},[45441],"/docs/single-page#using-java",{"_11759":3669,"_45083":3634,"_5":45549,"_17088":97804,"_23503":97805,"_7204":88073},[45441],"/docs/single-page#what-is-the-phoenix-jdbc-url-syntax",{"_11759":3670,"_45083":3634,"_5":45549,"_17088":97807,"_23503":97808,"_7204":88077},[45441],"/docs/single-page#thick-driver",{"_11759":3671,"_45083":3634,"_5":45549,"_17088":97810,"_23503":97811,"_7204":88081},[45441],"/docs/single-page#thin-driver",{"_11759":3672,"_45083":3634,"_5":45549,"_17088":97813,"_23503":97814,"_7204":88085},[45441],"/docs/single-page#is-there-a-way-to-bulk-load-in-phoenix",{"_11759":3673,"_45083":3634,"_5":45549,"_17088":97816,"_23503":97817,"_7204":88089},[45441],"/docs/single-page#map-reduce",{"_11759":3674,"_45083":3634,"_5":45549,"_17088":97819,"_23503":97820,"_7204":88093},[45441],"/docs/single-page#csv",{"_11759":3675,"_45083":3634,"_5":45549,"_17088":97822,"_23503":97823,"_7204":88097},[45441],"/docs/single-page#how-i-map-phoenix-table-to-an-existing-hbase-table",{"_11759":3676,"_45083":3634,"_5":45549,"_17088":97825,"_23503":97826,"_7204":88101},[45441],"/docs/single-page#are-there-any-tips-for-optimizing-phoenix",{"_11759":3677,"_45083":3634,"_5":45549,"_17088":97828,"_23503":97829,"_7204":88105},[45441],"/docs/single-page#how-do-i-create-secondary-index-on-a-table",{"_11759":3678,"_45083":3634,"_5":45549,"_17088":97831,"_23503":97832,"_7204":88109},[45441],"/docs/single-page#why-isnt-my-secondary-index-being-used",{"_11759":3679,"_45083":3634,"_5":45549,"_17088":97834,"_23503":97835,"_7204":88113},[45441],"/docs/single-page#how-fast-is-phoenix-why-is-it-so-fast",{"_11759":3680,"_45083":3634,"_5":45549,"_17088":97837,"_23503":97838,"_7204":88117},[45441],"/docs/single-page#how-do-i-connect-to-secure-hbase-cluster",{"_11759":3681,"_45083":3634,"_5":45549,"_17088":97840,"_23503":97841,"_7204":88121},[45441],"/docs/single-page#what-hbase-and-hadoop-versions-are-supported",{"_11759":3682,"_45083":3634,"_5":45549,"_17088":97843,"_23503":97844,"_7204":88125},[45441],"/docs/single-page#can-phoenix-work-on-tables-with-arbitrary-timestamp-as-flexible-as-hbase-api",{"_11759":3683,"_45083":3634,"_5":45549,"_17088":97846,"_23503":97847,"_7204":88129},[45441],"/docs/single-page#why-isnt-my-query-doing-a-range-scan",{"_11759":3684,"_45083":3634,"_5":45549,"_17088":97849,"_23503":97850,"_7204":88133},[45441],"/docs/single-page#should-i-pool-phoenix-jdbc-connections",{"_11759":3685,"_45083":3634,"_5":45549,"_17088":97852,"_23503":97853,"_7204":88137},[45441],"/docs/sin