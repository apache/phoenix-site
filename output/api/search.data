12705,"_69303":112707,"_69305":112709,"_69307":112711,"_69309":112713,"_69311":112715,"_69313":112717,"_69315":112719,"_69317":112721,"_69319":112723,"_69321":112725,"_69323":112727,"_69325":112729,"_69327":112731,"_69329":112733,"_69331":112735,"_69333":112737,"_69335":112739,"_69337":112741,"_69339":112743,"_69341":112745,"_69343":112747,"_69345":112749,"_69347":112751,"_69349":112753,"_69351":112755,"_69353":112757,"_69355":112759,"_69357":112761,"_69359":112763,"_69361":112765,"_69363":112767,"_69365":112769,"_69367":112771,"_69369":112773,"_69371":112775,"_69373":112777,"_69375":112779,"_69377":112781,"_69379":112783,"_69381":112785,"_69383":112787,"_69385":112789,"_69387":112791,"_69389":112793,"_69391":112795,"_69393":112797,"_69395":112799,"_69397":112801,"_69399":112803,"_69401":112805,"_69403":112807,"_69405":112809,"_69407":112811,"_69409":112813,"_69411":112815,"_69413":112817,"_69415":112819,"_69417":112821,"_69419":112823,"_69421":112825,"_69423":112827,"_69425":112829,"_69427":112831,"_69429":112833,"_69431":112835,"_69433":112837,"_69435":112839,"_69437":112841,"_69439":112843,"_69441":112845,"_69443":112847,"_69445":112849,"_69447":112851,"_69449":112853,"_69451":112855,"_69453":112857,"_69455":112859,"_69457":112861,"_69459":112863,"_69461":112865,"_69463":112867,"_69465":112869,"_69467":112871,"_69469":112873,"_69471":112875,"_69473":112877,"_69475":112879,"_69477":112881,"_69479":112883,"_69481":112885,"_69483":112887,"_69485":112889,"_69487":112891,"_69489":112893,"_69491":112895,"_69493":112897,"_69495":112899,"_69497":112901,"_69499":112903,"_69501":112905,"_69503":112907,"_69505":112909,"_69507":112911,"_69509":112913,"_69511":112915,"_69513":112917,"_69515":112919,"_69517":112921,"_69519":112923,"_69521":112925,"_69523":112927,"_69525":112929,"_69527":112931,"_69529":112933,"_69531":112935,"_69533":112937,"_69535":112939,"_69537":112941,"_69539":112943,"_69541":112945,"_69543":112947,"_69545":112949,"_69547":112951,"_69549":112953,"_69551":112955,"_69553":112957,"_69555":112959,"_69557":112961,"_69559":112963,"_69561":112965,"_69563":112967,"_69565":112969,"_69567":112971,"_69569":112973,"_69571":112975,"_69573":112977,"_69575":112979,"_69577":112981,"_69579":112983,"_69581":112985,"_69583":112987,"_69585":112989,"_69587":112991,"_69589":112993,"_69591":112995,"_69593":112997,"_69595":112999,"_69597":113001,"_69599":113003,"_69601":113005,"_69603":113007,"_69605":113009,"_69607":113011,"_69609":113013,"_69611":113015,"_69613":113017,"_69615":113019,"_69617":113021,"_69619":113023,"_69621":113025,"_69623":113027,"_69625":113029,"_69627":113031,"_69629":113033,"_69631":113035,"_69633":113037,"_69635":113039,"_69637":113041,"_69639":113043,"_69641":113045,"_69643":113047,"_69645":113049,"_69647":113051,"_69649":113053,"_69651":113055,"_69653":113057,"_69655":113059,"_69657":113061,"_69659":113063,"_69661":113065,"_69663":113067,"_69665":113069,"_69667":113071,"_69669":113073,"_69671":113075,"_69673":113077,"_69675":113079,"_69677":113081,"_69679":113083,"_69681":113085,"_69683":113087,"_69685":113089,"_69687":113091,"_69689":113093,"_69691":113095,"_69693":113097,"_69695":113099},{"_12623":11,"_48290":11,"_5":13058,"_7710":92878,"_48807":92879,"_18312":92884,"_25222":11},"Phoenix Omid Transaction Manager",[92880,92881,92882,92883],"Docs","Multi-Page Documentation","Development","Addons",[48836],{"_12623":12,"_48290":11,"_18312":92886,"_5":17825,"_25222":11,"_7710":92887},[48836],"Status update for Apache Omid graduation as an Apache Phoenix sub-project.",{"_12623":13,"_48290":11,"_18312":92889,"_5":17825,"_25222":11,"_7710":92890},[48836],"The Apache Omid podling has recently decided to graduate as a sub-project of Apache Phoenix.",{"_12623":14,"_48290":11,"_18312":92892,"_5":17825,"_25222":11,"_7710":92893},[48836],"This graduation process is currently ongoing. Please follow the Apache Phoenix mailing lists\nfor more information about this effort.",{"_12623":15,"_48290":15,"_5":13058,"_7710":92895,"_48807":92896,"_18312":92897,"_25222":15},"Phoenix ORM library",[92880,92881,92882,92883],[48836],{"_12623":16,"_48290":15,"_18312":92899,"_5":17825,"_25222":15,"_7710":92900},[48836],"Guide to PHO (Phoenix-HBase ORM) for entity mapping, query building, execution, and configuration.",{"_12623":17,"_48290":15,"_5":48804,"_18312":92902,"_25222":92903,"_7710":92904},[48836],"/docs/addons/phoenix-orm-library#entity-class","Entity Class",{"_12623":18,"_48290":15,"_5":48804,"_18312":92906,"_25222":92907,"_7710":92908},[48836],"/docs/addons/phoenix-orm-library#query-building","Query Building",{"_12623":19,"_48290":15,"_5":48804,"_18312":92910,"_25222":92911,"_7710":92912},[48836],"/docs/addons/phoenix-orm-library#simple-queries","Simple queries",{"_12623":20,"_48290":15,"_5":48804,"_18312":92914,"_25222":92915,"_7710":92916},[48836],"/docs/addons/phoenix-orm-library#compound-queries","Compound queries",{"_12623":21,"_48290":15,"_5":48804,"_18312":92918,"_25222":92919,"_7710":92920},[48836],"/docs/addons/phoenix-orm-library#query-interface","Query Interface",{"_12623":22,"_48290":15,"_5":48804,"_18312":92922,"_25222":92923,"_7710":92924},[48836],"/docs/addons/phoenix-orm-library#resolving-entity-and-property-names","Resolving Entity and Property Names",{"_12623":23,"_48290":15,"_5":48804,"_18312":92926,"_25222":92927,"_7710":92928},[48836],"/docs/addons/phoenix-orm-library#query-execution","Query Execution",{"_12623":24,"_48290":15,"_5":48804,"_18312":92930,"_25222":92931,"_7710":92932},[48836],"/docs/addons/phoenix-orm-library#phoenix-orm-library-configuration","Configuration",{"_12623":25,"_48290":15,"_5":48804,"_18312":92934,"_25222":92935,"_7710":92936},[48836],"/docs/addons/phoenix-orm-library#hbase","HBase",{"_12623":26,"_48290":15,"_18312":92938,"_5":17825,"_25222":15,"_7710":92939},[48836],"PHO is an Object Relational Mapping (ORM) library for building and executing queries on HBase using Apache Phoenix.\nIt provides ORM-style mappings and DSL-style query building. Initially developed and open sourced by eHarmony, it is available on GitHub.",{"_12623":27,"_48290":15,"_18312":92941,"_5":17825,"_25222":15,"_7710":92942},[48836],"Its interfaces and generic annotations make it possible to switch data store APIs in the future without changing query definitions.\nCurrently, it supports HBase integration through Apache Phoenix, and can be extended with other implementations.",{"_12623":28,"_48290":15,"_18312":92944,"_5":17825,"_25222":92903,"_7710":92945},[48836],"Suppose we have the following TestClass we want to query in our data store:",{"_12623":29,"_48290":15,"_18312":92947,"_5":17825,"_25222":92907,"_7710":92948},[48836],"Query building can be done in DSL style. More advanced query building is under development, but for now we will use a combination of QueryBuilder and static, Hibernate-style Restrictions methods to construct queries.",{"_12623":30,"_48290":15,"_18312":92950,"_5":17825,"_25222":92911,"_7710":92951},[48836],"Construct a query to find all user matches delivered in the past two days and not in a closed state.",{"_12623":31,"_48290":15,"_18312":92953,"_5":17825,"_25222":92915,"_7710":92954},[48836],"Construct a more complex query where we find items older than one day, include multiple status values, order by deliveryDate, and limit result size to 10.",{"_12623":32,"_48290":15,"_18312":92956,"_5":17825,"_25222":92915,"_7710":92957},[48836],"By default, expressions are combined with AND when added separately.",{"_12623":33,"_48290":15,"_18312":92959,"_5":17825,"_25222":92919,"_7710":92960},[48836],"The following query components are supported:",{"_12623":34,"_48290":15,"_18312":92962,"_5":17825,"_25222":92923,"_7710":92963},[48836],"Always use the property names of your Java objects in your queries.\nIf these names differ from those used in your datastore, use annotations to provide mappings.\nEntity resolvers are configured to map entity classes to table or collection names.\nProperty resolvers are configured to map object variable names to column or field names.",{"_12623":35,"_48290":15,"_18312":92965,"_5":17825,"_25222":92923,"_7710":92966},[48836],"The following annotations are currently supported for the indicated data store type.\nCustom EntityResolvers and PropertyResolvers are straightforward to configure and create.",{"_12623":36,"_48290":15,"_18312":92968,"_5":17825,"_25222":92923,"_7710":92969},[48836],"See Morphia annotations for entity class annotation mappings.",{"_12623":37,"_48290":15,"_18312":92971,"_5":17825,"_25222":92927,"_7710":92972},[48836],"The QueryExecutor interface supports the following operations:",{"_12623":38,"_48290":15,"_18312":92974,"_5":17825,"_25222":92931,"_7710":92975},[48836],"Here are some example Spring configuration files for HBase using Apache Phoenix.",{"_12623":39,"_48290":15,"_18312":92977,"_5":17825,"_25222":92935,"_7710":92978},[48836],"Configuration properties:",{"_12623":40,"_48290":40,"_5":13058,"_7710":92980,"_48807":92981,"_18312":92982,"_25222":40},"Phoenix Tephra Transaction Manager",[92880,92881,92882,92883],[48836],{"_12623":41,"_48290":40,"_18312":92984,"_5":17825,"_25222":40,"_7710":92985},[48836],"Status update for Apache Tephra graduation as an Apache Phoenix sub-project.",{"_12623":42,"_48290":40,"_18312":92987,"_5":17825,"_25222":40,"_7710":92988},[48836],"The Apache Tephra podling has recently decided to graduate as a sub-project of Apache Phoenix.",{"_12623":43,"_48290":40,"_18312":92990,"_5":17825,"_25222":40,"_7710":92893},[48836],{"_12623":44,"_48290":44,"_5":13058,"_7710":92992,"_48807":92993,"_18312":92995,"_25222":44},"Array Type",[92880,92881,92994],"Reference",[48836],{"_12623":45,"_48290":44,"_18312":92997,"_5":17825,"_25222":44,"_7710":92998},[48836],"Use JDBC ARRAY columns in Phoenix, including DDL, inserts, indexing syntax, and built-in array functions.",{"_12623":46,"_48290":44,"_5":48804,"_18312":93000,"_25222":93001,"_7710":93002},[48836],"/docs/array-type#array-type-limitations","Limitations",{"_12623":47,"_48290":44,"_18312":93004,"_5":17825,"_25222":44,"_7710":93005},[48836],"Apache Phoenix 3.0/4.0 introduced support for the JDBC ARRAY type. Any primitive type may be used in an ARRAY. Here is an example of declaring an array type when creating a table:",{"_12623":48,"_48290":44,"_18312":93007,"_5":17825,"_25222":44,"_7710":93008},[48836],"or alternately:",{"_12623":49,"_48290":44,"_18312":93010,"_5":17825,"_25222":44,"_7710":93011},[48836],"Insertion into the array may be done entirely through a SQL statement:",{"_12623":50,"_48290":44,"_18312":93013,"_5":17825,"_25222":44,"_7710":93014},[48836],"or programmatically through JDBC:",{"_12623":51,"_48290":44,"_18312":93016,"_5":17825,"_25222":44,"_7710":93017},[48836],"The entire array may be selected:",{"_12623":52,"_48290":44,"_18312":93019,"_5":17825,"_25222":44,"_7710":93020},[48836],"or an individual element in the array may be accessed via a subscript notation. The subscript is one-based, so the following would select the first element:",{"_12623":53,"_48290":44,"_18312":93022,"_5":17825,"_25222":44,"_7710":93023},[48836],"Use of the array subscript notation is supported in other expressions as well, for example in a WHERE clause:",{"_12623":54,"_48290":44,"_18312":93025,"_5":17825,"_25222":44,"_7710":93026},[48836],"The array length grows dynamically as needed and can be accessed through the built-in ARRAY_LENGTH function:",{"_12623":55,"_48290":44,"_18312":93028,"_5":17825,"_25222":44,"_7710":93029},[48836],"Attempts to access an array element beyond the current length will evaluate to null.",{"_12623":56,"_48290":44,"_18312":93031,"_5":17825,"_25222":44,"_7710":93032},[48836],"For searching in an array, built-in functions like ANY and ALL are provided. For example,",{"_12623":57,"_48290":44,"_18312":93034,"_5":17825,"_25222":44,"_7710":93035},[48836],"The built-in function ANY checks if any array element satisfies the condition and is equivalent to an OR condition:",{"_12623":58,"_48290":44,"_18312":93037,"_5":17825,"_25222":44,"_7710":93038},[48836],"The built-in function ALL checks if all array elements satisfy the condition and is equivalent to an AND condition:",{"_12623":59,"_48290":44,"_18312":93040,"_5":17825,"_25222":93001,"_7710":93041},[48836],"Only one-dimensional arrays are currently supported.",{"_12623":60,"_48290":44,"_18312":93043,"_5":17825,"_25222":93001,"_7710":93044},[48836],"For an array of fixed width types, null elements occurring in the middle of an array are not tracked.",{"_12623":61,"_48290":44,"_18312":93046,"_5":17825,"_25222":93001,"_7710":93047},[48836],"The declaration of an array length at DDL time is not enforced currently, but maybe in the future. Note that it is persisted with the table metadata.",{"_12623":62,"_48290":44,"_18312":93049,"_5":17825,"_25222":93001,"_7710":93050},[48836],"An array may only be used as the last column in a primary key constraint.",{"_12623":63,"_48290":44,"_18312":93052,"_5":17825,"_25222":93001,"_7710":93053},[48836],"Partial update of an array is currently not possible. Instead, the array may be manipulated on the client-side and then upserted back in its entirety.",{"_12623":64,"_48290":64,"_5":13058,"_7710":93055,"_48807":93056,"_18312":93058,"_25222":64},"Building Website",[92880,92881,92882,93057],"Contributing",[48836],{"_12623":65,"_48290":64,"_18312":93060,"_5":17825,"_25222":64,"_7710":93061},[48836],"Build and test the Apache Phoenix website locally with the current React + TypeScript workflow.",{"_12623":66,"_48290":64,"_5":48804,"_18312":93063,"_25222":93064,"_7710":93065},[48836],"/docs/contributing/building-website#building-website-prerequisites","Prerequisites",{"_12623":67,"_48290":64,"_5":48804,"_18312":93067,"_25222":93068,"_7710":93069},[48836],"/docs/contributing/building-website#building-phoenix-project-website","Building Phoenix Project Website",{"_12623":68,"_48290":64,"_5":48804,"_18312":93071,"_25222":93072,"_7710":93073},[48836],"/docs/contributing/building-website#publishing-website-artifact","Publishing Website Artifact",{"_12623":69,"_48290":64,"_5":48804,"_18312":93075,"_25222":93076,"_7710":93077},[48836],"/docs/contributing/building-website#local-testing-during-development","Local Testing During Development",{"_12623":70,"_48290":64,"_18312":93079,"_5":17825,"_25222":93064,"_7710":93080},[48836],"Node.js 22.x (minimum 22.12.0)",{"_12623":71,"_48290":64,"_18312":93082,"_5":17825,"_25222":93064,"_7710":93083},[48836],"npm (bundled with Node.js)",{"_12623":72,"_48290":64,"_18312":93085,"_5":17825,"_25222":93068,"_7710":93086},[48836],"Clone the repository:",{"_12623":73,"_48290":64,"_18312":93088,"_5":17825,"_25222":93068,"_7710":93089},[48836],"During development, install dependencies:",{"_12623":74,"_48290":64,"_18312":93091,"_5":17825,"_25222":93068,"_7710":93092},[48836],"For local iteration, run checks/build directly when needed:",{"_12623":75,"_48290":64,"_18312":93094,"_5":17825,"_25222":93068,"_7710":93095},[48836],"Before opening a pull request, run the mandatory build script:",{"_12623":76,"_48290":64,"_18312":93097,"_5":17825,"_25222":93068,"_7710":93098},[48836],"build.sh is required for all contributors. It:",{"_12623":77,"_48290":64,"_18312":93100,"_5":17825,"_25222":93068,"_7710":93101},[48836],"ensures Node/npm are available",{"_12623":78,"_48290":64,"_18312":93103,"_5":17825,"_25222":93068,"_7710":93104},[48836],"runs a clean install (npm ci)",{"_12623":79,"_48290":64,"_18312":93106,"_5":17825,"_25222":93068,"_7710":93107},[48836],"runs full validation/build (npm run ci)",{"_12623":80,"_48290":64,"_18312":93109,"_5":17825,"_25222":93068,"_7710":93110},[48836],"copies build/client/ into output/",{"_12623":81,"_48290":64,"_18312":93112,"_5":17825,"_25222":93068,"_7710":93113},[48836],"There is no remote CI/CD runner currently executing this script. The generated output/ directory is a build artifact that must be committed and pushed with your PR.",{"_12623":82,"_48290":64,"_18312":93115,"_5":17825,"_25222":93072,"_7710":93116},[48836],"Current publishing flow:",{"_12623":83,"_48290":64,"_18312":93118,"_5":17825,"_25222":93072,"_7710":93119},[48836],"Run ./build.sh locally",{"_12623":84,"_48290":64,"_18312":93121,"_5":17825,"_25222":93072,"_7710":93122},[48836],"Commit both source changes and updated output/",{"_12623":85,"_48290":64,"_18312":93124,"_5":17825,"_25222":93072,"_7710":93125},[48836],"Push your branch and open a PR",{"_12623":86,"_48290":64,"_18312":93127,"_5":17825,"_25222":93072,"_7710":93128},[48836],"After merge, output/ is used as the website artifact for deployment.",{"_12623":87,"_48290":64,"_18312":93130,"_5":17825,"_25222":93076,"_7710":93131},[48836],"Start the development server with hot reload:",{"_12623":88,"_48290":64,"_18312":93133,"_5":17825,"_25222":93076,"_7710":93134},[48836],"By default, the website is available at:",{"_12623":89,"_48290":64,"_18312":93136,"_5":17825,"_25222":93076,"_7710":93137},[48836],"To test the production build locally:",{"_12623":90,"_48290":90,"_5":13058,"_7710":93139,"_48807":93140,"_18312":93141,"_25222":90},"Developing Phoenix",[92880,92881,92882,93057],[48836],{"_12623":91,"_48290":90,"_18312":93143,"_5":17825,"_25222":90,"_7710":93144},[48836],"Set up a local Apache Phoenix development environment, IDE preferences, and contribution workflow.",{"_12623":92,"_48290":90,"_5":48804,"_18312":93146,"_25222":93147,"_7710":93148},[48836],"/docs/contributing/develop#develop-getting-started","Getting Started",{"_12623":93,"_48290":90,"_5":48804,"_18312":93150,"_25222":93151,"_7710":93152},[48836],"/docs/contributing/develop#other-phoenix-subprojects","Other Phoenix Subprojects",{"_12623":94,"_48290":90,"_5":48804,"_18312":93154,"_25222":93155,"_7710":93156},[48836],"/docs/contributing/develop#setup-local-git-repository","Setup Local Git Repository",{"_12623":95,"_48290":90,"_5":48804,"_18312":93158,"_25222":93159,"_7710":93160},[48836],"/docs/contributing/develop#for-eclipse-ide-for-java-developers-luna","For Eclipse IDE for Java Developers (Luna)",{"_12623":96,"_48290":90,"_5":48804,"_18312":93162,"_25222":93163,"_7710":93164},[48836],"/docs/contributing/develop#get-settings-and-preferences-correct","Get Settings and Preferences Correct",{"_12623":97,"_48290":90,"_5":48804,"_18312":93166,"_25222":93167,"_7710":93168},[48836],"/docs/contributing/develop#connecting-to-jira","Connecting to Jira",{"_12623":98,"_48290":90,"_5":48804,"_18312":93170,"_25222":93171,"_7710":93172},[48836],"/docs/contributing/develop#commit","Commit",{"_12623":99,"_48290":90,"_5":48804,"_18312":93174,"_25222":93175,"_7710":93176},[48836],"/docs/contributing/develop#for-intellij","For Intellij",{"_12623":100,"_48290":90,"_5":48804,"_18312":93178,"_25222":93179,"_7710":93180},[48836],"/docs/contributing/develop#if-you-dont-have-a-local-git-repository-setup","If you don't have a local git repository setup",{"_12623":101,"_48290":90,"_5":48804,"_18312":93182,"_25222":93183,"_7710":93184},[48836],"/docs/contributing/develop#if-you-already-have-a-local-git-repository-setup","If you already have a local git repository setup",{"_12623":102,"_48290":90,"_5":48804,"_18312":93186,"_25222":93187,"_7710":93164},[48836],"/docs/contributing/develop#get-settings-and-preferences-correct-1",{"_12623":103,"_48290":90,"_5":48804,"_18312":93189,"_25222":93190,"_7710":93168},[48836],"/docs/contributing/develop#connecting-to-jira-1",{"_12623":104,"_48290":90,"_5":48804,"_18312":93192,"_25222":93193,"_7710":93172},[48836],"/docs/contributing/develop#commit-1",{"_12623":105,"_48290":90,"_5":48804,"_18312":93195,"_25222":93196,"_7710":93197},[48836],"/docs/contributing/develop#contributing-finished-work","Contributing finished work",{"_12623":106,"_48290":90,"_5":48804,"_18312":93199,"_25222":93200,"_7710":93201},[48836],"/docs/contributing/develop#create-pull-request","Create pull request",{"_12623":107,"_48290":90,"_18312":93203,"_5":17825,"_25222":93147,"_7710":93204},[48836],"Review the How to Contribute documentation.",{"_12623":108,"_48290":90,"_18312":93206,"_5":17825,"_25222":93147,"_7710":93207},[48836],"Sign up for a GitHub account if you do not have one.",{"_12623":109,"_48290":90,"_18312":93209,"_5":17825,"_25222":93147,"_7710":93210},[48836],"Go to the Phoenix GitHub repository and create a fork, which creates {username}/phoenix.",{"_12623":110,"_48290":90,"_18312":93212,"_5":17825,"_25222":93147,"_7710":93213},[48836],"Set up Git locally.",{"_12623":111,"_48290":90,"_18312":93215,"_5":17825,"_25222":93147,"_7710":93216},[48836],"Instructions",{"_12623":112,"_48290":90,"_18312":93218,"_5":17825,"_25222":93147,"_7710":93219},[48836],"Download",{"_12623":113,"_48290":90,"_18312":93221,"_5":17825,"_25222":93147,"_7710":93222},[48836],"Make sure you have a JDK (Phoenix historically required JDK 7).",{"_12623":114,"_48290":90,"_18312":93224,"_5":17825,"_25222":93147,"_7710":93225},[48836],"Make sure you have Maven 3+ installed.",{"_12623":115,"_48290":90,"_18312":93227,"_5":17825,"_25222":93147,"_7710":93228},[48836],"Add the following to your .bashrc or equivalent to ensure Maven and Java are configured correctly for command-line usage.",{"_12623":116,"_48290":90,"_18312":93230,"_5":17825,"_25222":93151,"_7710":93231},[48836],"The instructions here are for the main Phoenix project. For the other subprojects, use the corresponding repository and JIRA project.",{"_12623":117,"_48290":90,"_18312":93233,"_5":17825,"_25222":93151,"_7710":93234},[48836],"The Eclipse and IntelliJ setup instructions may not necessarily work well for the other projects.",{"_12623":118,"_48290":90,"_18312":93236,"_5":17825,"_25222":93155,"_7710":93237},[48836],"You may find it easier to clone from your IDE of choice, especially with IntelliJ.",{"_12623":119,"_48290":90,"_18312":93239,"_5":17825,"_25222":93155,"_7710":93240},[48836],"Create a local clone of your new forked repository",{"_12623":120,"_48290":90,"_18312":93242,"_5":17825,"_25222":93155,"_7710":93243},[48836],"Configure your local repository to be able to sync with the apache/phoenix repository",{"_12623":121,"_48290":90,"_18312":93245,"_5":17825,"_25222":93155,"_7710":93246},[48836],"Setup your development environment",{"_12623":122,"_48290":90,"_18312":93248,"_5":17825,"_25222":93159,"_7710":93249},[48836],"Download Eclipse",{"_12623":123,"_48290":90,"_18312":93251,"_5":17825,"_25222":93159,"_7710":93252},[48836],"You will want 'Eclipse IDE for Java Developers' unless you want to install the following tools by hand",{"_12623":124,"_48290":90,"_18312":93254,"_5":17825,"_25222":93159,"_7710":20570},[48836],{"_12623":125,"_48290":90,"_18312":93256,"_5":17825,"_25222":93159,"_7710":42319},[48836],{"_12623":126,"_48290":90,"_18312":93258,"_5":17825,"_25222":93159,"_7710":93259},[48836],"Configure Eclipse to handle Maven Issues appropriately so you don't see unnecessary errors.",{"_12623":127,"_48290":90,"_18312":93261,"_5":17825,"_25222":93159,"_7710":93262},[48836],"Window -> Preferences -> Maven -> Errors/Warnings",{"_12623":128,"_48290":90,"_18312":93264,"_5":17825,"_25222":93159,"_7710":93265},[48836],"Choose Ignore option for 'Plugin execution not covered by lifecycle configuration' -> Ok",{"_12623":129,"_48290":90,"_18312":93267,"_5":17825,"_25222":93159,"_7710":93268},[48836],"Add the local Git repository to Eclipse",{"_12623":130,"_48290":90,"_18312":93270,"_5":17825,"_25222":93159,"_7710":93271},[48836],"Window -> Show View -> Other... -> Git | Git Repositories -> Ok",{"_12623":131,"_48290":90,"_18312":93273,"_5":17825,"_25222":93159,"_7710":93274},[48836],"Click 'Add an existing local Git Repository to this view'",{"_12623":132,"_48290":90,"_18312":93276,"_5":17825,"_25222":93159,"_7710":93277},[48836],"Search for appropriate git repository",{"_12623":133,"_48290":90,"_18312":93279,"_5":17825,"_25222":93159,"_7710":93280},[48836],"Finish",{"_12623":134,"_48290":90,"_18312":93282,"_5":17825,"_25222":93159,"_7710":93283},[48836],"Import Maven Projects",{"_12623":135,"_48290":90,"_18312":93285,"_5":17825,"_25222":93159,"_7710":93286},[48836],"File -> Import -> Maven -> Existing Maven Projects",{"_12623":136,"_48290":90,"_18312":93288,"_5":17825,"_25222":93159,"_7710":93289},[48836],"Choose Root directory where phoenix git repository is located",{"_12623":137,"_48290":90,"_18312":93291,"_5":17825,"_25222":93159,"_7710":93292},[48836],"Select All",{"_12623":138,"_48290":90,"_18312":93294,"_5":17825,"_25222":93159,"_7710":93280},[48836],{"_12623":139,"_48290":90,"_18312":93296,"_5":17825,"_25222":93159,"_7710":93297},[48836],"Generate Lexer and Parser Files",{"_12623":140,"_48290":90,"_18312":93299,"_5":17825,"_25222":93159,"_7710":93300},[48836],"Select phoenix-core project",{"_12623":141,"_48290":90,"_18312":93302,"_5":17825,"_25222":93159,"_7710":93303},[48836],"Run -> Run As -> Maven generate-sources",{"_12623":142,"_48290":90,"_18312":93305,"_5":17825,"_25222":93159,"_7710":93306},[48836],"Make sure you are setup to develop now.",{"_12623":143,"_48290":90,"_18312":93308,"_5":17825,"_25222":93159,"_7710":93309},[48836],"Open IndexUtilTest.Java",{"_12623":144,"_48290":90,"_18312":93311,"_5":17825,"_25222":93159,"_7710":93312},[48836],"Run -> Run As -> JUnit Test",{"_12623":145,"_48290":90,"_18312":93314,"_5":17825,"_25222":93163,"_7710":93315},[48836],"Import General Preferences",{"_12623":146,"_48290":90,"_18312":93317,"_5":17825,"_25222":93163,"_7710":93318},[48836],"File -> Import... -> General -> Preferences",{"_12623":147,"_48290":90,"_18312":93320,"_5":17825,"_25222":93163,"_7710":93321},[48836],"From - {repository}/dev/eclipse_prefs_phoenix.epf",{"_12623":148,"_48290":90,"_18312":93323,"_5":17825,"_25222":93163,"_7710":93324},[48836],"Import All",{"_12623":149,"_48290":90,"_18312":93326,"_5":17825,"_25222":93163,"_7710":93280},[48836],{"_12623":150,"_48290":90,"_18312":93328,"_5":17825,"_25222":93163,"_7710":93329},[48836],"Import Code Templates",{"_12623":151,"_48290":90,"_18312":93331,"_5":17825,"_25222":93163,"_7710":93332},[48836],"Window -> Preferences -> Java -> Code Style -> Code Templates -> Import...",{"_12623":152,"_48290":90,"_18312":93334,"_5":17825,"_25222":93163,"_7710":93335},[48836],"Navigate to {repository}/dev/PhoenixCodeTemplate.xml -> Ok",{"_12623":153,"_48290":90,"_18312":93337,"_5":17825,"_25222":93163,"_7710":93338},[48836],"Import Formatter",{"_12623":154,"_48290":90,"_18312":93340,"_5":17825,"_25222":93163,"_7710":93341},[48836],"Window -> Preferences -> Java -> Code Style -> Formatter-> Import...",{"_12623":155,"_48290":90,"_18312":93343,"_5":17825,"_25222":93163,"_7710":93335},[48836],{"_12623":156,"_48290":90,"_18312":93345,"_5":17825,"_25222":93163,"_7710":93346},[48836],"Import correct import order settings",{"_12623":157,"_48290":90,"_18312":93348,"_5":17825,"_25222":93163,"_7710":93349},[48836],"Window -> Preferences -> Java -> Code Style -> Organize Imports -> Import...",{"_12623":158,"_48290":90,"_18312":93351,"_5":17825,"_25222":93163,"_7710":93352},[48836],"Navigate to {repository}/dev/phoenix.importorder -> Ok",{"_12623":159,"_48290":90,"_18312":93354,"_5":17825,"_25222":93163,"_7710":93355},[48836],"Make sure you use space for tabs",{"_12623":160,"_48290":90,"_18312":93357,"_5":17825,"_25222":93163,"_7710":93358},[48836],"Window -> Preferences -> General -> Editors -> Text Editors",{"_12623":161,"_48290":90,"_18312":93360,"_5":17825,"_25222":93163,"_7710":93361},[48836],"Select 'Insert Spaces for tabs' -> Ok",{"_12623":162,"_48290":90,"_18312":93363,"_5":17825,"_25222":93167,"_7710":93364},[48836],"Install Connector for Jira",{"_12623":163,"_48290":90,"_18312":93366,"_5":17825,"_25222":93167,"_7710":93367},[48836],"Help -> Install New Software -> Add",{"_12623":164,"_48290":90,"_18312":93369,"_5":17825,"_25222":93167,"_7710":93370},[48836],"Location - https://update.atlassian.com/atlassian-eclipse-plugin/rest/e3.7 -> Atlassian Connector",{"_12623":165,"_48290":90,"_18312":93372,"_5":17825,"_25222":93167,"_7710":93280},[48836],{"_12623":166,"_48290":90,"_18312":93374,"_5":17825,"_25222":93167,"_7710":93375},[48836],"Add Task Repository",{"_12623":167,"_48290":90,"_18312":93377,"_5":17825,"_25222":93167,"_7710":93378},[48836],"Window -> Show View -> Mylyn -> Task Repositories -> Add Task Repository",{"_12623":168,"_48290":90,"_18312":93380,"_5":17825,"_25222":93167,"_7710":93381},[48836],"JIRA -> Next -> Server - https://issues.apache.org/jira -> Validate Settings",{"_12623":169,"_48290":90,"_18312":93383,"_5":17825,"_25222":93167,"_7710":93280},[48836],{"_12623":170,"_48290":90,"_18312":93385,"_5":17825,"_25222":93167,"_7710":93386},[48836],"Add Filter Of All JIRAs assigned to you",{"_12623":171,"_48290":90,"_18312":93388,"_5":17825,"_25222":93167,"_7710":93389},[48836],"Right Click on Repository You added -> New Query... -> Predefined Filter",{"_12623":172,"_48290":90,"_18312":93391,"_5":17825,"_25222":93167,"_7710":93392},[48836],"Select Phoenix Project -> Select Assigned to me",{"_12623":173,"_48290":90,"_18312":93394,"_5":17825,"_25222":93167,"_7710":93280},[48836],{"_12623":174,"_48290":90,"_18312":93396,"_5":17825,"_25222":93171,"_7710":93397},[48836],"Commit Changes and Push to Github with appropriate Message",{"_12623":175,"_48290":90,"_18312":93399,"_5":17825,"_25222":93171,"_7710":93400},[48836],"CTRL-# -> Set Commit message to include jira number at beginning PHOENIX-####",{"_12623":176,"_48290":90,"_18312":93402,"_5":17825,"_25222":93171,"_7710":93403},[48836],"Commit and Push",{"_12623":177,"_48290":90,"_18312":93405,"_5":17825,"_25222":93175,"_7710":93406},[48836],"Download IntelliJ",{"_12623":178,"_48290":90,"_18312":93408,"_5":17825,"_25222":93179,"_7710":93409},[48836],"This will automatically create the local clone of your repository for you. You will still want to add the remote upstream repository from above afterwards.",{"_12623":179,"_48290":90,"_18312":93411,"_5":17825,"_25222":93179,"_7710":93412},[48836],"Clone Github project and Import Maven Projects to IDE",{"_12623":180,"_48290":90,"_18312":93414,"_5":17825,"_25222":93179,"_7710":93415},[48836],"Check out from Version Control -> GitHub -> Enter your GitHub Login Info",{"_12623":181,"_48290":90,"_18312":93417,"_5":17825,"_25222":93179,"_7710":93418},[48836],"https://github.com/{username}/phoenix.git -> Check out from Version Control | Yes",{"_12623":182,"_48290":90,"_18312":93420,"_5":17825,"_25222":93179,"_7710":93421},[48836],"Generate Parser and Lexer Files",{"_12623":183,"_48290":90,"_18312":93423,"_5":17825,"_25222":93179,"_7710":93424},[48836],"Maven Projects -> Phoenix Core -> Lifecycle -> compile",{"_12623":184,"_48290":90,"_18312":93426,"_5":17825,"_25222":93179,"_7710":93427},[48836],"Compile Project",{"_12623":185,"_48290":90,"_18312":93429,"_5":17825,"_25222":93179,"_7710":93430},[48836],"Build -> Make Project",{"_12623":186,"_48290":90,"_18312":93432,"_5":17825,"_25222":93179,"_7710":93306},[48836],{"_12623":187,"_48290":90,"_18312":93434,"_5":17825,"_25222":93179,"_7710":93435},[48836],"Open IndexUtilTest.Java -> Run -> Run IndexUtilTest",{"_12623":188,"_48290":90,"_18312":93437,"_5":17825,"_25222":93183,"_7710":93438},[48836],"Import Projects",{"_12623":189,"_48290":90,"_18312":93440,"_5":17825,"_25222":93183,"_7710":93441},[48836],"Import Project",{"_12623":190,"_48290":90,"_18312":93443,"_5":17825,"_25222":93183,"_7710":93444},[48836],"Select Directory of your local repository -> Next",{"_12623":191,"_48290":90,"_18312":93446,"_5":17825,"_25222":93183,"_7710":93447},[48836],"Import project from external model -> Maven -> Next",{"_12623":192,"_48290":90,"_18312":93449,"_5":17825,"_25222":93183,"_7710":93450},[48836],"Select 'Import Maven project automatically'",{"_12623":193,"_48290":90,"_18312":93452,"_5":17825,"_25222":93183,"_7710":93453},[48836],"Select 'Create IntelliJ IDEA modules for aggregator projects'",{"_12623":194,"_48290":90,"_18312":93455,"_5":17825,"_25222":93183,"_7710":93456},[48836],"Select 'Keep source and test folders on reimport'",{"_12623":195,"_48290":90,"_18312":93458,"_5":17825,"_25222":93183,"_7710":93459},[48836],"Select 'Exclude build directory'",{"_12623":196,"_48290":90,"_18312":93461,"_5":17825,"_25222":93183,"_7710":93462},[48836],"Select 'Use Maven output directories' -> Next",{"_12623":197,"_48290":90,"_18312":93464,"_5":17825,"_25222":93183,"_7710":93465},[48836],"Select maven-3 -> Next",{"_12623":198,"_48290":90,"_18312":93467,"_5":17825,"_25222":93183,"_7710":93468},[48836],"Next a whole bunch",{"_12623":199,"_48290":90,"_18312":93470,"_5":17825,"_25222":93183,"_7710":93421},[48836],{"_12623":200,"_48290":90,"_18312":93472,"_5":17825,"_25222":93183,"_7710":93424},[48836],{"_12623":201,"_48290":90,"_18312":93474,"_5":17825,"_25222":93183,"_7710":93427},[48836],{"_12623":202,"_48290":90,"_18312":93476,"_5":17825,"_25222":93183,"_7710":93430},[48836],{"_12623":203,"_48290":90,"_18312":93478,"_5":17825,"_25222":93183,"_7710":93306},[48836],{"_12623":204,"_48290":90,"_18312":93480,"_5":17825,"_25222":93183,"_7710":93435},[48836],{"_12623":205,"_48290":90,"_18312":93482,"_5":17825,"_25222":93187,"_7710":93483},[48836],"Import Settings from eclipse profile",{"_12623":206,"_48290":90,"_18312":93485,"_5":17825,"_25222":93187,"_7710":93486},[48836],"File -> Settings -> Editor -> Code Style -> Java",{"_12623":207,"_48290":90,"_18312":93488,"_5":17825,"_25222":93187,"_7710":93489},[48836],"Set From... -> Import... -> Eclipse XML Profile -> {repository}/dev/PhoenixCodeTemplate.xml",{"_12623":208,"_48290":90,"_18312":93491,"_5":17825,"_25222":93190,"_7710":93492},[48836],"Create Connection to Apache Jira",{"_12623":209,"_48290":90,"_18312":93494,"_5":17825,"_25222":93190,"_7710":93495},[48836],"Tools -> Tasks and Contexts -> Configure Servers -> + -> Jira ->",{"_12623":210,"_48290":90,"_18312":93497,"_5":17825,"_25222":93190,"_7710":93498},[48836],"Server Url: https://issues.apache.org/jira",{"_12623":211,"_48290":90,"_18312":93500,"_5":17825,"_25222":93190,"_7710":93501},[48836],"Query: 'project=Phoenix and ...'",{"_12623":212,"_48290":90,"_18312":93503,"_5":17825,"_25222":93190,"_7710":93504},[48836],"Switch Easily between Tasks",{"_12623":213,"_48290":90,"_18312":93506,"_5":17825,"_25222":93190,"_7710":93507},[48836],"Tools-> Tasks and Contexts -> Open Task->PHOENIX-####",{"_12623":214,"_48290":90,"_18312":93509,"_5":17825,"_25222":93190,"_7710":93510},[48836],"Select Create branch PHOENIX-#### from master->OK",{"_12623":215,"_48290":90,"_18312":93512,"_5":17825,"_25222":93193,"_7710":93397},[48836],{"_12623":216,"_48290":90,"_18312":93514,"_5":17825,"_25222":93193,"_7710":93515},[48836],"VCS -> Commit -> Set Commit message to include jira number PHOENIX-####",{"_12623":217,"_48290":90,"_18312":93517,"_5":17825,"_25222":93193,"_7710":93403},[48836],{"_12623":218,"_48290":90,"_18312":93519,"_5":17825,"_25222":93200,"_7710":93204},[48836],{"_12623":219,"_48290":90,"_18312":93521,"_5":17825,"_25222":93200,"_7710":93522},[48836],"Navigate to branch: https://github.com/{username}/phoenix/tree/{branchname}",{"_12623":220,"_48290":90,"_18312":93524,"_5":17825,"_25222":93200,"_7710":93525},[48836],"Click Pull Request",{"_12623":221,"_48290":90,"_18312":93527,"_5":17825,"_25222":93200,"_7710":93528},[48836],"Confirm that you see apache:master ... {username}:{branchname}",{"_12623":222,"_48290":90,"_18312":93530,"_5":17825,"_25222":93200,"_7710":93531},[48836],"Make sure the pull request title begins with the JIRA key, for example PHOENIX-####.",{"_12623":223,"_48290":90,"_18312":93533,"_5":17825,"_25222":93200,"_7710":93534},[48836],"Click Create pull request.",{"_12623":224,"_48290":224,"_5":13058,"_7710":93536,"_48807":93537,"_18312":93538,"_25222":224},"How to Release",[92880,92881,92882,93057],[48836],{"_12623":225,"_48290":224,"_18312":93540,"_5":17825,"_25222":224,"_7710":93541},[48836],"Apache Phoenix release process, release candidates, and voting workflow.",{"_12623":226,"_48290":224,"_5":48804,"_18312":93543,"_25222":93544,"_7710":93536},[48836],"/docs/contributing/how-to-release#contributing-how-to-release",{"_12623":227,"_48290":224,"_5":48804,"_18312":93546,"_25222":93547,"_7710":93548},[48836],"/docs/contributing/how-to-release#pre-reqs","Pre-Reqs",{"_12623":228,"_48290":224,"_5":48804,"_18312":93550,"_25222":93551,"_7710":93552},[48836],"/docs/contributing/how-to-release#do-a-dry-run","Do a dry run",{"_12623":229,"_48290":224,"_5":48804,"_18312":93554,"_25222":93555,"_7710":93556},[48836],"/docs/contributing/how-to-release#create-real-rc","Create real RC",{"_12623":230,"_48290":224,"_5":48804,"_18312":93558,"_25222":93559,"_7710":93560},[48836],"/docs/contributing/how-to-release#close-the-staging-repository","Close the staging repository",{"_12623":231,"_48290":224,"_5":48804,"_18312":93562,"_25222":93563,"_7710":93564},[48836],"/docs/contributing/how-to-release#voting","Voting",{"_12623":232,"_48290":224,"_5":48804,"_18312":93566,"_25222":93567,"_7710":93568},[48836],"/docs/contributing/how-to-release#release","Release",{"_12623":233,"_48290":224,"_18312":93570,"_5":17825,"_25222":93544,"_7710":93571},[48836],"Phoenix has several repos: phoenix-thirdparty, phoenix-omid, phoenix-tephra, phoenix, phoenix-connectors, and phoenix-queryserver.\nThe create-release scripts provide a unified script to handle the release from each repo.\nThe create-release scripts are in the master branch of the phoenix repo, in the dev/create-release directory.",{"_12623":234,"_48290":224,"_18312":93573,"_5":17825,"_25222":93547,"_7710":93574},[48836],"Make sure that the JIRAs included in the release have their fix-version and release notes fields set correctly, and are resolved.The script will query them and create the CHANGES and RELEASE_NOTES files from that information.Use dev/misc_utils/git_jira_fix_version_check.py to find discrepancies between commits and JIRAs.",{"_12623":235,"_48290":224,"_18312":93576,"_5":17825,"_25222":93547,"_7710":93577},[48836],"Make sure you have set up your user for release signing. Details: http://www.apache.org/dev/release-signing.html.",{"_12623":236,"_48290":224,"_18312":93579,"_5":17825,"_25222":93547,"_7710":93580},[48836],"Make sure you have set up Maven for deploying to the ASF repo. Details: https://infra.apache.org/publishing-maven-artifacts.html.",{"_12623":237,"_48290":224,"_18312":93582,"_5":17825,"_25222":93547,"_7710":93583},[48836],"Clone the Phoenix master branch locally (the script will download the actual repo to release itself).",{"_12623":238,"_48290":224,"_18312":93585,"_5":17825,"_25222":93547,"_7710":93586},[48836],"Make sure Docker is running locally.",{"_12623":239,"_48290":224,"_18312":93588,"_5":17825,"_25222":93547,"_7710":93589},[48836],"Note that Docker Desktop for Mac works, but will be slow (several hours for a Phoenix core release). Running on a native Linux machine is much faster because you avoid filesystem translation layer overhead.",{"_12623":240,"_48290":224,"_18312":93591,"_5":17825,"_25222":93551,"_7710":93592},[48836],"Read /dev/create_release/README.txt to understand what the script does and how to set up gpg-agent for signing.",{"_12623":241,"_48290":224,"_18312":93594,"_5":17825,"_25222":93551,"_7710":93595},[48836],"Run the dev/create-release/do-release-docker.sh -d <workdir> -p <project> command, where",{"_12623":242,"_48290":224,"_18312":93597,"_5":17825,"_25222":93551,"_7710":93598},[48836],"<project> is the repo name you're releasing from (i.e. phoenix)",{"_12623":243,"_48290":224,"_18312":93600,"_5":17825,"_25222":93551,"_7710":93601},[48836],"<workdir> is any existing directory that can be deleted",{"_12623":244,"_48290":224,"_18312":93603,"_5":17825,"_25222":93551,"_7710":93604},[48836],"The script will ask a number of questions. Some of them will have intelligent default, but make sure you check them all:",{"_12623":245,"_48290":224,"_18312":93606,"_5":17825,"_25222":93551,"_7710":93607},[48836],"PROJECT: the repo to release (default specified by -p on the command line)",{"_12623":246,"_48290":224,"_18312":93609,"_5":17825,"_25222":93551,"_7710":93610},[48836],"GIT_BRANCH: the git branch to use for release. This can be master, or a pre-created release branch.",{"_12623":247,"_48290":224,"_18312":93612,"_5":17825,"_25222":93551,"_7710":93613},[48836],"RC_COUNT: the RC number, starting from 0",{"_12623":248,"_48290":224,"_18312":93615,"_5":17825,"_25222":93551,"_7710":93616},[48836],"RELEASE_TAG: the git tag the script will tag the RC commit with.",{"_12623":249,"_48290":224,"_18312":93618,"_5":17825,"_25222":93551,"_7710":93619},[48836],"ASF_USERNAME: your ASF username, for publishing the release artifacts.",{"_12623":250,"_48290":224,"_18312":93621,"_5":17825,"_25222":93551,"_7710":93622},[48836],"ASF_PASSWORD: your ASF password, only for non-dry runs",{"_12623":251,"_48290":224,"_18312":93624,"_5":17825,"_25222":93551,"_7710":93625},[48836],"GIT_NAME/GIT_EMAIL: will be used for the RC commit",{"_12623":252,"_48290":224,"_18312":93627,"_5":17825,"_25222":93551,"_7710":93628},[48836],"GPG_KEY: ID for your GPG key. The script will offer a GPG secret key from your key ring, double-check that it is your code-signing key, and correct it if it is not.",{"_12623":253,"_48290":224,"_18312":93630,"_5":17825,"_25222":93551,"_7710":93631},[48836],"The dry-run will generate the signed release files into <workdir>/output directory.\nThe Maven artifacts will be in <workdir>/output/phoenix-repo-XXXX local Maven repo, in the usual structure.",{"_12623":254,"_48290":224,"_18312":93633,"_5":17825,"_25222":93555,"_7710":93634},[48836],"If the dry-run release artifacts (source, binary, and Maven) check out, then publish a real RC to ASF.",{"_12623":255,"_48290":224,"_18312":93636,"_5":17825,"_25222":93555,"_7710":93637},[48836],"Repeat the dry run process, but add the -f switch to the do-release-docker.sh command.",{"_12623":256,"_48290":224,"_18312":93639,"_5":17825,"_25222":93555,"_7710":93640},[48836],"The script will upload the source and binary release artifacts to a directory under https://dist.apache.org/repos/dist/dev/phoenix/.\nThe script will also deploy the Maven artifacts to https://repository.apache.org/#stagingRepositories.\nCheck that these are present.",{"_12623":257,"_48290":224,"_18312":93642,"_5":17825,"_25222":93559,"_7710":93643},[48836],"The published staging repository is in the \"open\" state. Open staging repositories\nare aggressively cleaned up, and may be removed by the time the vote passes.\nTo avoid this, close\n(but DO NOT release) the staging repository immediately after deployment.",{"_12623":258,"_48290":224,"_18312":93645,"_5":17825,"_25222":93563,"_7710":93646},[48836],"Initiate the vote email. See example here, or use the <workdir>/output/vote.txt template generated by the script.",{"_12623":259,"_48290":224,"_18312":93648,"_5":17825,"_25222":93563,"_7710":93649},[48836],"In case the RC (Release Candidate) is rejected via the vote, you will have to repeat the above process and re-initiate the vote for the next RC (RC0, RC1, etc.).",{"_12623":260,"_48290":224,"_18312":93651,"_5":17825,"_25222":93567,"_7710":93652},[48836],"Once voting is successful (say for RC1), copy artifacts to https://dist.apache.org/repos/dist/release/phoenix:",{"_12623":261,"_48290":224,"_18312":93654,"_5":17825,"_25222":93567,"_7710":93655},[48836],"Set release tag and commit:",{"_12623":262,"_48290":224,"_18312":93657,"_5":17825,"_25222":93567,"_7710":93658},[48836],"Remove any obsolete releases on https://dist.apache.org/repos/dist/release/phoenix given the current release.",{"_12623":263,"_48290":224,"_18312":93660,"_5":17825,"_25222":93567,"_7710":93661},[48836],"Go to https://repository.apache.org/#stagingRepositories and release the staged artifacts (this takes a while so you may need to refresh multiple times).",{"_12623":264,"_48290":224,"_18312":93663,"_5":17825,"_25222":93567,"_7710":93664},[48836],"Create new branch based on current release if needed, for ex: 4.15 branches in this case.",{"_12623":265,"_48290":224,"_18312":93666,"_5":17825,"_25222":93567,"_7710":93667},[48836],"Set version to the upcoming SNAPSHOT and commit:",{"_12623":266,"_48290":224,"_18312":93669,"_5":17825,"_25222":93567,"_7710":93670},[48836],"If releasing Phoenix (core) Create a JIRA to update PHOENIX_MAJOR_VERSION, PHOENIX_MINOR_VERSION and PHOENIX_PATCH_NUMBER in MetaDataProtocol.java appropriately to next version (4, 16, 0 respectively in this case) and compatible_client_versions.json file with the client versions that are compatible against the next version (in this case 4.14.3 and 4.15.0 would be the backward compatible clients for 4.16.0). This JIRA should be committed/marked with fixVersion of the next release candidate.",{"_12623":267,"_48290":224,"_18312":93672,"_5":17825,"_25222":93567,"_7710":93673},[48836],"Add documentation of released version to the downloads page and wiki.",{"_12623":268,"_48290":224,"_18312":93675,"_5":17825,"_25222":93567,"_7710":93676},[48836],"Update the Apache Committee Report Helper DB",{"_12623":269,"_48290":224,"_18312":93678,"_5":17825,"_25222":93567,"_7710":93679},[48836],"Send out an announcement email. See example here.",{"_12623":270,"_48290":224,"_18312":93681,"_5":17825,"_25222":93567,"_7710":93682},[48836],"Bulk close JIRAs that were marked for the release fixVersion.",{"_12623":271,"_48290":224,"_18312":93684,"_5":17825,"_25222":93567,"_7710":93685},[48836],"Congratulations!",{"_12623":272,"_48290":272,"_5":13058,"_7710":93057,"_48807":93687,"_18312":93688,"_25222":272},[92880,92881,92882,93057],[48836],{"_12623":273,"_48290":272,"_18312":93690,"_5":17825,"_25222":272,"_7710":93691},[48836],"Contribution workflow for Apache Phoenix, including JIRA, patch/PR submission, and committer practices.",{"_12623":274,"_48290":272,"_5":48804,"_18312":93693,"_25222":93694,"_7710":93695},[48836],"/docs/contributing#general-process","General process",{"_12623":275,"_48290":272,"_5":48804,"_18312":93697,"_25222":93698,"_7710":93699},[48836],"/docs/contributing#discuss-on-the-mailing-list","Discuss on the mailing list",{"_12623":276,"_48290":272,"_5":48804,"_18312":93701,"_25222":93702,"_7710":93703},[48836],"/docs/contributing#log-a-jira-ticket","Log a JIRA ticket",{"_12623":277,"_48290":272,"_5":48804,"_18312":93705,"_25222":93706,"_7710":93707},[48836],"/docs/contributing#setup-development-environment","Setup development environment",{"_12623":278,"_48290":272,"_5":48804,"_18312":93709,"_25222":93710,"_7710":93711},[48836],"/docs/contributing#generate-a-patch","Generate a patch",{"_12623":279,"_48290":272,"_5":48804,"_18312":93713,"_25222":93714,"_7710":93715},[48836],"/docs/contributing#naming-convention-for-the-patch","Naming convention for the patch",{"_12623":280,"_48290":272,"_5":48804,"_18312":93717,"_25222":93718,"_7710":93719},[48836],"/docs/contributing#github-workflow","GitHub workflow",{"_12623":281,"_48290":272,"_5":48804,"_18312":93721,"_25222":93722,"_7710":93723},[48836],"/docs/contributing#local-git-workflow","Local Git workflow",{"_12623":282,"_48290":272,"_5":48804,"_18312":93725,"_25222":93726,"_7710":93727},[48836],"/docs/contributing#code-conventions","Code conventions",{"_12623":283,"_48290":272,"_5":48804,"_18312":93729,"_25222":93730,"_7710":93731},[48836],"/docs/contributing#committer-workflow","Committer workflow",{"_12623":284,"_48290":272,"_18312":93733,"_5":17825,"_25222":93694,"_7710":93734},[48836],"The general process for contributing code to Phoenix works as follows:",{"_12623":285,"_48290":272,"_18312":93736,"_5":17825,"_25222":93694,"_7710":93737},[48836],"Discuss your changes on the dev mailing list",{"_12623":286,"_48290":272,"_18312":93739,"_5":17825,"_25222":93694,"_7710":93740},[48836],"Create a JIRA issue unless there already is one",{"_12623":287,"_48290":272,"_18312":93742,"_5":17825,"_25222":93694,"_7710":93246},[48836],{"_12623":288,"_48290":272,"_18312":93744,"_5":17825,"_25222":93694,"_7710":93745},[48836],"Prepare a patch containing your changes",{"_12623":289,"_48290":272,"_18312":93747,"_5":17825,"_25222":93694,"_7710":93748},[48836],"Submit the patch",{"_12623":290,"_48290":272,"_18312":93750,"_5":17825,"_25222":93694,"_7710":93751},[48836],"These steps are explained in greater detail below.",{"_12623":291,"_48290":272,"_18312":93753,"_5":17825,"_25222":93694,"_7710":93754},[48836],"Note that the instructions below are for the main Phoenix project.\nUse the corresponding repository for the other subprojects.\nTephra and Omid also have their own JIRA projects.",{"_12623":292,"_48290":272,"_18312":93756,"_5":17825,"_25222":93698,"_7710":93757},[48836],"It's often best to discuss a change on the public mailing lists before creating and submitting a patch.",{"_12623":293,"_48290":272,"_18312":93759,"_5":17825,"_25222":93698,"_7710":93760},[48836],"If you're unsure whether certain behavior in Phoenix is a bug, please send a mail to the user mailing list to check.",{"_12623":294,"_48290":272,"_18312":93762,"_5":17825,"_25222":93698,"_7710":93763},[48836],"If you're considering adding major new functionality to Phoenix, it's a good idea to first discuss the idea on the developer mailing list to make sure that your plans are in line with others in the Phoenix community.",{"_12623":295,"_48290":272,"_18312":93765,"_5":17825,"_25222":93702,"_7710":93766},[48836],"The first step is to create a ticket on the Phoenix JIRA.",{"_12623":296,"_48290":272,"_18312":93768,"_5":17825,"_25222":93706,"_7710":93769},[48836],"To set up your development environment, see these directions.",{"_12623":297,"_48290":272,"_18312":93771,"_5":17825,"_25222":93710,"_7710":93772},[48836],"There are two general approaches for creating and submitting a patch: GitHub pull requests, or manual patch creation with Git. Both are explained below. Please make sure that the patch applies cleanly on all active branches, including master and the unified 4.x branch.",{"_12623":298,"_48290":272,"_18312":93774,"_5":17825,"_25222":93710,"_7710":93775},[48836],"Regardless of which approach is taken, please make sure to follow the Phoenix code conventions (more information below). Whenever possible, unit tests or integration tests should be included with patches.",{"_12623":299,"_48290":272,"_18312":93777,"_5":17825,"_25222":93710,"_7710":93778},[48836],"Please make sure that the patch contains only one commit, then click the \"Submit patch\" button to automatically trigger tests on the patch.",{"_12623":300,"_48290":272,"_18312":93780,"_5":17825,"_25222":93710,"_7710":93781},[48836],"The commit message should reference the JIRA ticket issue (which has the format\nPHOENIX-{NUMBER}:{JIRA-TITLE}).",{"_12623":301,"_48290":272,"_18312":93783,"_5":17825,"_25222":93710,"_7710":93784},[48836],"To effectively get the patch reviewed, please raise the pull request against an appropriate branch.",{"_12623":302,"_48290":272,"_18312":93786,"_5":17825,"_25222":93714,"_7710":93787},[48836],"When generating a patch, make sure the patch name uses the following format:\nPHOENIX-{NUMBER}.{BRANCH-NAME}.{VERSION}.patch",{"_12623":303,"_48290":272,"_18312":93789,"_5":17825,"_25222":93714,"_7710":93790},[48836],"Examples: PHOENIX-4872.master.v1.patch, PHOENIX-4872.master.v2.patch, PHOENIX-4872.4.x-HBase-1.3.v1.patch, etc.",{"_12623":304,"_48290":272,"_18312":93792,"_5":17825,"_25222":93718,"_7710":93793},[48836],"Create a pull request in GitHub for the mirror of the Phoenix Git repository.",{"_12623":305,"_48290":272,"_18312":93795,"_5":17825,"_25222":93718,"_7710":93796},[48836],"Generate a patch and attach it to JIRA so Hadoop QA runs automated tests.",{"_12623":306,"_48290":272,"_18312":93798,"_5":17825,"_25222":93718,"_7710":93799},[48836],"If you update the PR, generate a new patch with a different name so patch changes are detected and tests run for the new patch.",{"_12623":307,"_48290":272,"_18312":93801,"_5":17825,"_25222":93722,"_7710":93802},[48836],"Create a local branch:",{"_12623":308,"_48290":272,"_18312":93804,"_5":17825,"_25222":93722,"_7710":93805},[48836],"Make and commit changes",{"_12623":309,"_48290":272,"_18312":93807,"_5":17825,"_25222":93722,"_7710":93808},[48836],"Generate a patch based on the JIRA issue number:",{"_12623":310,"_48290":272,"_18312":93810,"_5":17825,"_25222":93722,"_7710":93811},[48836],"Attach the created patch file to the JIRA ticket.",{"_12623":311,"_48290":272,"_18312":93813,"_5":17825,"_25222":93726,"_7710":93814},[48836],"The Phoenix code conventions are similar to the Sun/Oracle Java Code Convention. We use 4 spaces (no tabs) for indentation and limit lines to 100 characters.",{"_12623":312,"_48290":272,"_18312":93816,"_5":17825,"_25222":93726,"_7710":93817},[48836],"Eclipse code formatting settings and import order settings (which can also be imported into Intellij IDEA) are available in the dev directory of the Phoenix codebase.",{"_12623":313,"_48290":272,"_18312":93819,"_5":17825,"_25222":93726,"_7710":93820},[48836],"All new source files should include the Apache license header.",{"_12623":314,"_48290":272,"_18312":93822,"_5":17825,"_25222":93730,"_7710":93823},[48836],"In general, the \"rebase\" workflow should be used with the Phoenix codebase (see this blog post for more information on the difference between \"merge\" and \"rebase\" workflows in Git).",{"_12623":315,"_48290":272,"_18312":93825,"_5":17825,"_25222":93730,"_7710":93826},[48836],"A patch file can be downloaded from a GitHub pull request by adding .patch to the end of the pull request URL, for example: https://github.com/apache/phoenix/pull/35.patch.",{"_12623":316,"_48290":272,"_18312":93828,"_5":17825,"_25222":93730,"_7710":93829},[48836],"When applying a user-contributed patch, use git am when a fully formatted patch file is available, as this preserves contributor contact information. Otherwise, add the contributor's name to the commit message.",{"_12623":317,"_48290":272,"_18312":93831,"_5":17825,"_25222":93730,"_7710":93832},[48836],"If a single ticket consists of a patch with multiple commits, the commits can be squashed into a single commit using git rebase.",{"_12623":318,"_48290":318,"_5":13058,"_7710":93834,"_48807":93835,"_18312":93836,"_25222":318},"Data Types",[92880,92881,92994],[48836],{"_12623":319,"_48290":318,"_18312":93838,"_5":17825,"_25222":318,"_7710":93839},[48836],"SQL data type reference for Apache Phoenix.",{"_12623":320,"_48290":318,"_5":48804,"_18312":93841,"_25222":93842,"_7710":93834},[48836],"/docs/datatypes#data-types",{"_12623":321,"_48290":318,"_5":48804,"_18312":93844,"_25222":93845,"_7710":93846},[48836],"/docs/datatypes#integer-type","INTEGER Type",{"_12623":322,"_48290":318,"_5":48804,"_18312":93848,"_25222":93849,"_7710":93850},[48836],"/docs/datatypes#unsigned_int-type","UNSIGNED_INT Type",{"_12623":323,"_48290":318,"_5":48804,"_18312":93852,"_25222":93853,"_7710":93854},[48836],"/docs/datatypes#bigint-type","BIGINT Type",{"_12623":324,"_48290":318,"_5":48804,"_18312":93856,"_25222":93857,"_7710":93858},[48836],"/docs/datatypes#unsigned_long-type","UNSIGNED_LONG Type",{"_12623":325,"_48290":318,"_5":48804,"_18312":93860,"_25222":93861,"_7710":93862},[48836],"/docs/datatypes#tinyint-type","TINYINT Type",{"_12623":326,"_48290":318,"_5":48804,"_18312":93864,"_25222":93865,"_7710":93866},[48836],"/docs/datatypes#unsigned_tinyint-type","UNSIGNED_TINYINT Type",{"_12623":327,"_48290":318,"_5":48804,"_18312":93868,"_25222":93869,"_7710":93870},[48836],"/docs/datatypes#smallint-type","SMALLINT Type",{"_12623":328,"_48290":318,"_5":48804,"_18312":93872,"_25222":93873,"_7710":93874},[48836],"/docs/datatypes#unsigned_smallint-type","UNSIGNED_SMALLINT Type",{"_12623":329,"_48290":318,"_5":48804,"_18312":93876,"_25222":93877,"_7710":93878},[48836],"/docs/datatypes#float-type","FLOAT Type",{"_12623":330,"_48290":318,"_5":48804,"_18312":93880,"_25222":93881,"_7710":93882},[48836],"/docs/datatypes#unsigned_float-type","UNSIGNED_FLOAT Type",{"_12623":331,"_48290":318,"_5":48804,"_18312":93884,"_25222":93885,"_7710":93886},[48836],"/docs/datatypes#double-type","DOUBLE Type",{"_12623":332,"_48290":318,"_5":48804,"_18312":93888,"_25222":93889,"_7710":93890},[48836],"/docs/datatypes#unsigned_double-type","UNSIGNED_DOUBLE Type",{"_12623":333,"_48290":318,"_5":48804,"_18312":93892,"_25222":93893,"_7710":93894},[48836],"/docs/datatypes#decimal-type","DECIMAL Type",{"_12623":334,"_48290":318,"_5":48804,"_18312":93896,"_25222":93897,"_7710":93898},[48836],"/docs/datatypes#boolean-type","BOOLEAN Type",{"_12623":335,"_48290":318,"_5":48804,"_18312":93900,"_25222":93901,"_7710":93902},[48836],"/docs/datatypes#time-type","TIME Type",{"_12623":336,"_48290":318,"_5":48804,"_18312":93904,"_25222":93905,"_7710":93906},[48836],"/docs/datatypes#date-type","DATE Type",{"_12623":337,"_48290":318,"_5":48804,"_18312":93908,"_25222":93909,"_7710":93910},[48836],"/docs/datatypes#timestamp-type","TIMESTAMP Type",{"_12623":338,"_48290":318,"_5":48804,"_18312":93912,"_25222":93913,"_7710":93914},[48836],"/docs/datatypes#unsigned_time-type","UNSIGNED_TIME Type",{"_12623":339,"_48290":318,"_5":48804,"_18312":93916,"_25222":93917,"_7710":93918},[48836],"/docs/datatypes#unsigned_date-type","UNSIGNED_DATE Type",{"_12623":340,"_48290":318,"_5":48804,"_18312":93920,"_25222":93921,"_7710":93922},[48836],"/docs/datatypes#unsigned_timestamp-type","UNSIGNED_TIMESTAMP Type",{"_12623":341,"_48290":318,"_5":48804,"_18312":93924,"_25222":93925,"_7710":93926},[48836],"/docs/datatypes#varchar-type","VARCHAR Type",{"_12623":342,"_48290":318,"_5":48804,"_18312":93928,"_25222":93929,"_7710":93930},[48836],"/docs/datatypes#char-type","CHAR Type",{"_12623":343,"_48290":318,"_5":48804,"_18312":93932,"_25222":93933,"_7710":93934},[48836],"/docs/datatypes#binary-type","BINARY Type",{"_12623":344,"_48290":318,"_5":48804,"_18312":93936,"_25222":93937,"_7710":93938},[48836],"/docs/datatypes#varbinary-type","VARBINARY Type",{"_12623":345,"_48290":318,"_5":48804,"_18312":93940,"_25222":93941,"_7710":93942},[48836],"/docs/datatypes#varbinary_encoded-type","VARBINARY_ENCODED Type",{"_12623":346,"_48290":318,"_5":48804,"_18312":93944,"_25222":93945,"_7710":93946},[48836],"/docs/datatypes#array","ARRAY",{"_12623":347,"_48290":318,"_5":48804,"_18312":93948,"_25222":93949,"_7710":93950},[48836],"/docs/datatypes#bson-type","BSON Type",{"_12623":348,"_48290":318,"_18312":93952,"_5":17825,"_25222":93845,"_7710":93953},[48836],"Possible values: -2147483648 to 2147483647.",{"_12623":349,"_48290":318,"_18312":93955,"_5":17825,"_25222":93845,"_7710":93956},[48836],"Mapped to java.lang.Integer. The binary representation is a 4 byte integer with the sign bit flipped (so that negative values sorts before positive values).",{"_12623":350,"_48290":318,"_18312":93958,"_5":17825,"_25222":93845,"_7710":93959},[48836],"Example",{"_12623":351,"_48290":318,"_18312":93961,"_5":17825,"_25222":93849,"_7710":93962},[48836],"Possible values: 0 to 2147483647. Mapped to java.lang.Integer. The binary representation is a 4 byte integer, matching the Bytes.toBytes(int) method. The purpose of this type is to map to existing HBase data that was serialized using this HBase utility method. If that is not the case, use the regular signed type instead.",{"_12623":352,"_48290":318,"_18312":93964,"_5":17825,"_25222":93849,"_7710":93959},[48836],{"_12623":353,"_48290":318,"_18312":93966,"_5":17825,"_25222":93853,"_7710":93967},[48836],"Possible values: -9223372036854775808 to 9223372036854775807. Mapped to java.lang.Long. The binary representation is an 8 byte long with the sign bit flipped (so that negative values sorts before positive values).",{"_12623":354,"_48290":318,"_18312":93969,"_5":17825,"_25222":93853,"_7710":93959},[48836],{"_12623":355,"_48290":318,"_18312":93971,"_5":17825,"_25222":93857,"_7710":93972},[48836],"Possible values: 0 to 9223372036854775807. Mapped to java.lang.Long. The binary representation is an 8 byte integer, matching the Bytes.toBytes(long) method. The purpose of this type is to map to existing HBase data that was serialized using this HBase utility method. If that is not the case, use the regular signed type instead.",{"_12623":356,"_48290":318,"_18312":93974,"_5":17825,"_25222":93857,"_7710":93959},[48836],{"_12623":357,"_48290":318,"_18312":93976,"_5":17825,"_25222":93861,"_7710":93977},[48836],"Possible values: -128 to 127. Mapped to java.lang.Byte. The binary representation is a single byte, with the sign bit flipped (so that negative values sorts before positive values).",{"_12623":358,"_48290":318,"_18312":93979,"_5":17825,"_25222":93861,"_7710":93959},[48836],{"_12623":359,"_48290":318,"_18312":93981,"_5":17825,"_25222":93865,"_7710":93982},[48836],"Possible values: 0 to 127. Mapped to java.lang.Byte. The binary representation is a single byte, matching the Bytes.toBytes(byte) method. The purpose of this type is to map to existing HBase data that was serialized using this HBase utility method. If that is not the case, use the regular signed type instead.",{"_12623":360,"_48290":318,"_18312":93984,"_5":17825,"_25222":93865,"_7710":93959},[48836],{"_12623":361,"_48290":318,"_18312":93986,"_5":17825,"_25222":93869,"_7710":93987},[48836],"Possible values: -32768 to 32767. Mapped to java.lang.Short. The binary representation is a 2 byte short with the sign bit flipped (so that negative values sort before positive values).",{"_12623":362,"_48290":318,"_18312":93989,"_5":17825,"_25222":93869,"_7710":93959},[48836],{"_12623":363,"_48290":318,"_18312":93991,"_5":17825,"_25222":93873,"_7710":93992},[48836],"Possible values: 0 to 32767. Mapped to java.lang.Short. The binary representation is an 2 byte integer, matching the Bytes.toBytes(short) method. The purpose of this type is to map to existing HBase data that was serialized using this HBase utility method. If that is not the case, use the regular signed type instead.",{"_12623":364,"_48290":318,"_18312":93994,"_5":17825,"_25222":93873,"_7710":93959},[48836],{"_12623":365,"_48290":318,"_18312":93996,"_5":17825,"_25222":93877,"_7710":93997},[48836],"Possible values: -3.402823466 E + 38 to 3.402823466 E + 38. Mapped to java.lang.Float. The binary representation is an 4 byte float with the sign bit flipped (so that negative values sort before positive values).",{"_12623":366,"_48290":318,"_18312":93999,"_5":17825,"_25222":93877,"_7710":93959},[48836],{"_12623":367,"_48290":318,"_18312":94001,"_5":17825,"_25222":93881,"_7710":94002},[48836],"Possible values: 0 to 3.402823466 E + 38. Mapped to java.lang.Float. The binary representation is an 4 byte float matching the Bytes.toBytes(float) method. The purpose of this type is to map to existing HBase data that was serialized using this HBase utility method. If that is not the case, use the regular signed type instead.",{"_12623":368,"_48290":318,"_18312":94004,"_5":17825,"_25222":93881,"_7710":93959},[48836],{"_12623":369,"_48290":318,"_18312":94006,"_5":17825,"_25222":93885,"_7710":94007},[48836],"Possible values: -1.7976931348623158 E + 308 to 1.7976931348623158 E + 308. Mapped to java.lang.Double. The binary representation is an 8 byte double with the sign bit flipped (so that negative values sort before positive value).",{"_12623":370,"_48290":318,"_18312":94009,"_5":17825,"_25222":93885,"_7710":93959},[48836],{"_12623":371,"_48290":318,"_18312":94011,"_5":17825,"_25222":93889,"_7710":94012},[48836],"Possible values: 0 to  1.7976931348623158 E + 308. Mapped to java.lang.Double. The binary representation is an 8 byte double matching the Bytes.toBytes(double) method. The purpose of this type is to map to existing HBase data that was serialized using this HBase utility method. If that is not the case, use the regular signed type instead.",{"_12623":372,"_48290":318,"_18312":94014,"_5":17825,"_25222":93889,"_7710":93959},[48836],{"_12623":373,"_48290":318,"_18312":94016,"_5":17825,"_25222":93893,"_7710":94017},[48836],"Data type with fixed precision and scale. A user can specify precision and scale by expression DECIMAL(precision,scale) in a DDL statement, for example, DECIMAL(10,2). The maximum precision is 38 digits. Mapped to java.math.BigDecimal. The binary representation is binary comparable, variable length format. When used in a row key, it is terminated with a null byte unless it is the last column.",{"_12623":374,"_48290":318,"_18312":94019,"_5":17825,"_25222":93893,"_7710":93959},[48836],{"_12623":375,"_48290":318,"_18312":94021,"_5":17825,"_25222":93897,"_7710":94022},[48836],"Possible values: TRUE and FALSE.",{"_12623":376,"_48290":318,"_18312":94024,"_5":17825,"_25222":93897,"_7710":94025},[48836],"Mapped to java.lang.Boolean. The binary representation is a single byte with 0 for false and 1 for true",{"_12623":377,"_48290":318,"_18312":94027,"_5":17825,"_25222":93897,"_7710":93959},[48836],{"_12623":378,"_48290":318,"_18312":94029,"_5":17825,"_25222":93901,"_7710":94030},[48836],"The time data type. The format is yyyy-MM-dd hh:mm:ss, with both the date and time parts maintained. Mapped to java.sql.Time. The binary representation is an 8 byte long (the number of milliseconds from the epoch), making it possible (although not necessarily recommended) to store more information within a TIME column than what is provided by \"java.sql.Time\". Note that the internal representation is based on a number of milliseconds since the epoch (which is based on a time in GMT), while \"java.sql.Time\" will format times based on the client's local time zone. Please note that this TIME type is different than the TIME type as defined by the SQL 92 standard in that it includes year, month, and day components. As such, it is not in compliance with the JDBC APIs. As the underlying data is still stored as a long, only the presentation of the value is incorrect.",{"_12623":379,"_48290":318,"_18312":94032,"_5":17825,"_25222":93901,"_7710":93959},[48836],{"_12623":380,"_48290":318,"_18312":94034,"_5":17825,"_25222":93905,"_7710":94035},[48836],"The date data type. The format is yyyy-MM-dd hh:mm:ss, with both the date and time parts maintained to a millisecond accuracy. Mapped to java.sql.Date. The binary representation is an 8 byte long (the number of milliseconds from the epoch), making it possible (although not necessarily recommended) to store more information within a DATE column than what is provided by \"java.sql.Date\". Note that the internal representation is based on a number of milliseconds since the epoch (which is based on a time in GMT), while \"java.sql.Date\" will format dates based on the client's local time zone. Please note that this DATE type is different than the DATE type as defined by the SQL 92 standard in that it includes a time component. As such, it is not in compliance with the JDBC APIs. As the underlying data is still stored as a long, only the presentation of the value is incorrect.",{"_12623":381,"_48290":318,"_18312":94037,"_5":17825,"_25222":93905,"_7710":93959},[48836],{"_12623":382,"_48290":318,"_18312":94039,"_5":17825,"_25222":93909,"_7710":94040},[48836],"The timestamp data type. The format is yyyy-MM-dd hh:mm:ss[.nnnnnnnnn]. Mapped to java.sql.Timestamp with an internal representation of the number of nanos from the epoch. The binary representation is 12 bytes: an 8 byte long for the epoch time plus a 4 byte integer for the nanos. Note that the internal representation is based on a number of milliseconds since the epoch (which is based on a time in GMT), while \"java.sql.Timestamp\" will format timestamps based on the client's local time zone.",{"_12623":383,"_48290":318,"_18312":94042,"_5":17825,"_25222":93909,"_7710":93959},[48836],{"_12623":384,"_48290":318,"_18312":94044,"_5":17825,"_25222":93913,"_7710":94045},[48836],"The unsigned time data type. The format is yyyy-MM-dd hh:mm:ss, with both the date and time parts maintained to the millisecond accuracy. Mapped to java.sql.Time. The binary representation is an 8 byte long (the number of milliseconds from the epoch) matching the HBase.toBytes(long) method. The purpose of this type is to map to existing HBase data that was serialized using this HBase utility method. If that is not the case, use the regular signed type instead.",{"_12623":385,"_48290":318,"_18312":94047,"_5":17825,"_25222":93913,"_7710":93959},[48836],{"_12623":386,"_48290":318,"_18312":94049,"_5":17825,"_25222":93917,"_7710":94050},[48836],"The unsigned date data type. The format is yyyy-MM-dd hh:mm:ss, with both the date and time parts maintained to a millisecond accuracy. Mapped to java.sql.Date. The binary representation is an 8 byte long (the number of milliseconds from the epoch) matching the HBase.toBytes(long) method. The purpose of this type is to map to existing HBase data that was serialized using this HBase utility method. If that is not the case, use the regular signed type instead.",{"_12623":387,"_48290":318,"_18312":94052,"_5":17825,"_25222":93917,"_7710":93959},[48836],{"_12623":388,"_48290":318,"_18312":94054,"_5":17825,"_25222":93921,"_7710":94055},[48836],"The timestamp data type. The format is yyyy-MM-dd hh:mm:ss[.nnnnnnnnn]. Mapped to java.sql.Timestamp with an internal representation of the number of nanos from the epoch. The binary representation is 12 bytes: an 8 byte long for the epoch time plus a 4 byte integer for the nanos with the long serialized through the HBase.toBytes(long) method. The purpose of this type is to map to existing HBase data that was serialized using this HBase utility method. If that is not the case, use the regular signed type instead.",{"_12623":389,"_48290":318,"_18312":94057,"_5":17825,"_25222":93921,"_7710":93959},[48836],{"_12623":390,"_48290":318,"_18312":94059,"_5":17825,"_25222":93925,"_7710":94060},[48836],"A variable length String with an optional max byte length. The binary representation is UTF8 matching the Bytes.toBytes(String) method. When used in a row key, it is terminated with a null byte unless it is the last column.",{"_12623":391,"_48290":318,"_18312":94062,"_5":17825,"_25222":93925,"_7710":94063},[48836],"Mapped to java.lang.String.",{"_12623":392,"_48290":318,"_18312":94065,"_5":17825,"_25222":93925,"_7710":93959},[48836],{"_12623":393,"_48290":318,"_18312":94067,"_5":17825,"_25222":93929,"_7710":94068},[48836],"A fixed length String with single-byte characters. The binary representation is UTF8 matching the Bytes.toBytes(String) method.",{"_12623":394,"_48290":318,"_18312":94070,"_5":17825,"_25222":93929,"_7710":94063},[48836],{"_12623":395,"_48290":318,"_18312":94072,"_5":17825,"_25222":93929,"_7710":93959},[48836],{"_12623":396,"_48290":318,"_18312":94074,"_5":17825,"_25222":93933,"_7710":94075},[48836],"Raw fixed length byte array.",{"_12623":397,"_48290":318,"_18312":94077,"_5":17825,"_25222":93933,"_7710":94078},[48836],"Mapped to byte[].",{"_12623":398,"_48290":318,"_18312":94080,"_5":17825,"_25222":93933,"_7710":93959},[48836],{"_12623":399,"_48290":318,"_18312":94082,"_5":17825,"_25222":93937,"_7710":94083},[48836],"Raw variable length byte array.",{"_12623":400,"_48290":318,"_18312":94085,"_5":17825,"_25222":93937,"_7710":94078},[48836],{"_12623":401,"_48290":318,"_18312":94087,"_5":17825,"_25222":93937,"_7710":93959},[48836],{"_12623":402,"_48290":318,"_18312":94089,"_5":17825,"_25222":93941,"_7710":94090},[48836],"Variable length byte array that escapes embedded 0x00 bytes so its sort order matches the lexicographic order of the original bytes. Use it anywhere ordering matters: a non-trailing column of a composite primary key, an index key, or a row value constructor over binary data.",{"_12623":403,"_48290":318,"_18312":94092,"_5":17825,"_25222":93941,"_7710":94093},[48836],"Mapped to byte[]. See VARBINARY_ENCODED for details.",{"_12623":404,"_48290":318,"_18312":94095,"_5":17825,"_25222":93941,"_7710":93959},[48836],{"_12623":405,"_48290":318,"_18312":94097,"_5":17825,"_25222":93945,"_7710":94098},[48836],"Mapped to java.sql.Array. Every primitive type except for VARBINARY may be declared as an ARRAY. Only single dimensional arrays are supported.",{"_12623":406,"_48290":318,"_18312":94100,"_5":17825,"_25222":93945,"_7710":93959},[48836],{"_12623":407,"_48290":318,"_18312":94102,"_5":17825,"_25222":93949,"_7710":94103},[48836],"Native binary JSON document column for schemaless data. Phoenix can read individual fields with BSON_VALUE, filter rows with BSON_CONDITION_EXPRESSION, and atomically update fields with BSON_UPDATE_EXPRESSION — all evaluated server-side.",{"_12623":408,"_48290":318,"_18312":94105,"_5":17825,"_25222":93949,"_7710":94106},[48836],"Stored as BSON bytes; returned as org.bson.RawBsonDocument. See Document Data: BSON for details.",{"_12623":409,"_48290":318,"_18312":94108,"_5":17825,"_25222":93949,"_7710":93959},[48836],{"_12623":410,"_48290":410,"_5":13058,"_7710":94110,"_48807":94111,"_18312":94112,"_25222":410},"Explain Plan",[92880,92881,92994],[48836],{"_12623":411,"_48290":410,"_18312":94114,"_5":17825,"_25222":410,"_7710":94115},[48836],"How to read and use EXPLAIN plans in Apache Phoenix.",{"_12623":412,"_48290":410,"_5":48804,"_18312":94117,"_25222":94118,"_7710":94110},[48836],"/docs/explain-plan#explain-plan-overview",{"_12623":413,"_48290":410,"_5":48804,"_18312":94120,"_25222":94121,"_7710":94122},[48836],"/docs/explain-plan#anatomy-of-an-explain-plan","Anatomy of an Explain Plan",{"_12623":414,"_48290":410,"_5":48804,"_18312":94124,"_25222":94125,"_7710":93959},[48836],"/docs/explain-plan#explain-plan-example",{"_12623":415,"_48290":410,"_5":48804,"_18312":94127,"_25222":94128,"_7710":94129},[48836],"/docs/explain-plan#jdbc-explain-plan-api-and-estimates","JDBC Explain Plan API and Estimates",{"_12623":416,"_48290":410,"_18312":94131,"_5":17825,"_25222":94118,"_7710":94132},[48836],"An EXPLAIN plan tells you a lot about how a query will be run:",{"_12623":417,"_48290":410,"_18312":94134,"_5":17825,"_25222":94118,"_7710":94135},[48836],"All the HBase range queries that will be executed",{"_12623":418,"_48290":410,"_18312":94137,"_5":17825,"_25222":94118,"_7710":94138},[48836],"An estimate of the number of bytes that will be scanned",{"_12623":419,"_48290":410,"_18312":94140,"_5":17825,"_25222":94118,"_7710":94141},[48836],"An estimate of the number of rows that will be traversed",{"_12623":420,"_48290":410,"_18312":94143,"_5":17825,"_25222":94118,"_7710":94144},[48836],"Time at which the above estimate information was collected",{"_12623":421,"_48290":410,"_18312":94146,"_5":17825,"_25222":94118,"_7710":94147},[48836],"Which HBase table will be used for each scan",{"_12623":422,"_48290":410,"_18312":94149,"_5":17825,"_25222":94118,"_7710":94150},[48836],"Which operations (sort, merge, scan, limit) are executed on the client versus the server",{"_12623":423,"_48290":410,"_18312":94152,"_5":17825,"_25222":94118,"_7710":94153},[48836],"Use an EXPLAIN plan to check how a query will run, and consider rewriting queries to meet the following goals:",{"_12623":424,"_48290":410,"_18312":94155,"_5":17825,"_25222":94118,"_7710":94156},[48836],"Emphasize operations on the server rather than the client. Server operations are distributed across the cluster and operate in parallel, while client operations execute within the single client JDBC driver.",{"_12623":425,"_48290":410,"_18312":94158,"_5":17825,"_25222":94118,"_7710":94159},[48836],"Use RANGE SCAN or SKIP SCAN whenever possible rather than TABLE SCAN.",{"_12623":426,"_48290":410,"_18312":94161,"_5":17825,"_25222":94118,"_7710":94162},[48836],"Filter against leading columns in the primary key constraint. This assumes you have designed the primary key to lead with frequently-accessed or frequently-filtered columns as described in “Primary Keys,” above.",{"_12623":427,"_48290":410,"_18312":94164,"_5":17825,"_25222":94118,"_7710":94165},[48836],"If necessary, introduce a local index or a global index that covers your query.",{"_12623":428,"_48290":410,"_18312":94167,"_5":17825,"_25222":94118,"_7710":94168},[48836],"If you have an index that covers your query but the optimizer is not detecting it, try hinting the query:\nSELECT /*+ INDEX() */ …",{"_12623":429,"_48290":410,"_18312":94170,"_5":17825,"_25222":94118,"_7710":94171},[48836],"See also: SQL Language Reference - EXPLAIN",{"_12623":430,"_48290":410,"_18312":94173,"_5":17825,"_25222":94121,"_7710":94174},[48836],"An explain plan consists of lines of text that describe operations that Phoenix will perform during a query, using the following terms:",{"_12623":431,"_48290":410,"_18312":94176,"_5":17825,"_25222":94121,"_7710":94177},[48836],"AGGREGATE INTO ORDERED DISTINCT ROWS — aggregates the returned rows using an operation such as addition. When ORDERED is used, the GROUP BY operation is applied to the leading part of the primary key constraint, which allows the aggregation to be done in place rather than keeping all distinct groups in memory on the server side.",{"_12623":432,"_48290":410,"_18312":94179,"_5":17825,"_25222":94121,"_7710":94180},[48836],"AGGREGATE INTO SINGLE ROW — aggregates the results into a single row using an aggregate function with no GROUP BY clause. For example, the count() statement returns one row with the total number of rows that match the query.",{"_12623":433,"_48290":410,"_18312":94182,"_5":17825,"_25222":94121,"_7710":94183},[48836],"CLIENT — the operation will be performed on the client side. It's faster to perform most operations on the server side, so you should consider whether there's a way to rewrite the query to give the server more of the work to do.",{"_12623":434,"_48290":410,"_18312":94185,"_5":17825,"_25222":94121,"_7710":94186},[48836],"FILTER BY expression—returns only results that match the expression.",{"_12623":435,"_48290":410,"_18312":94188,"_5":17825,"_25222":94121,"_7710":94189},[48836],"FULL SCAN OVER tableName—the operation will scan every row in the specified table.",{"_12623":436,"_48290":410,"_18312":94191,"_5":17825,"_25222":94121,"_7710":94192},[48836],"INNER-JOIN — the operation will join multiple tables on rows where the join condition is met.",{"_12623":437,"_48290":410,"_18312":94194,"_5":17825,"_25222":94121,"_7710":94195},[48836],"MERGE SORT — performs a merge sort on the results.",{"_12623":438,"_48290":410,"_18312":94197,"_5":17825,"_25222":94121,"_7710":94198},[48836],"RANGE SCAN OVER tableName [ ... ] — The information in the square brackets indicates the start and stop for each primary key that's used in the query.",{"_12623":439,"_48290":410,"_18312":94200,"_5":17825,"_25222":94121,"_7710":94201},[48836],"ROUND ROBIN — when the query doesn't contain ORDER BY and therefore the rows can be returned in any order, ROUND ROBIN order maximizes parallelization on the client side.",{"_12623":440,"_48290":410,"_18312":94203,"_5":17825,"_25222":94121,"_7710":94204},[48836],"<x>-CHUNK — describes how many threads will be used for the operation. The maximum parallelism is limited to the number of threads in the thread pool. The minimum parallelization corresponds to the number of regions the table has between the start and stop rows of the scan. The number of chunks will increase with a lower guidepost width, as there is more than one chunk per region.",{"_12623":441,"_48290":410,"_18312":94206,"_5":17825,"_25222":94121,"_7710":94207},[48836],"PARALLEL <x>-WAY — describes how many parallel scans will be merge sorted during the operation.",{"_12623":442,"_48290":410,"_18312":94209,"_5":17825,"_25222":94121,"_7710":94210},[48836],"SERIAL — some queries run serially. For example, a single row lookup or a query that filters on the leading part of the primary key and limits the results below a configurable threshold.",{"_12623":443,"_48290":410,"_18312":94212,"_5":17825,"_25222":94121,"_7710":94213},[48836],"EST_BYTES_READ - provides an estimate of the total number of bytes that will be scanned as part of executing the query.",{"_12623":444,"_48290":410,"_18312":94215,"_5":17825,"_25222":94121,"_7710":94216},[48836],"EST_ROWS_READ - provides an estimate of the total number of rows that will be scanned as part of executing the query.",{"_12623":445,"_48290":410,"_18312":94218,"_5":17825,"_25222":94121,"_7710":94219},[48836],"EST_INFO_TS - epoch time in milliseconds at which the estimate information was collected.",{"_12623":446,"_48290":410,"_18312":94221,"_5":17825,"_25222":94128,"_7710":94222},[48836],"The information displayed in the explain plan API can also be accessed programmatically through the standard JDBC interfaces. When statistics collection\nis enabled for a table, the explain plan also gives an estimate of number of rows and bytes a query is going to scan. To get hold of the info, you can\nuse corresponding columns in the result set returned by the explain plan statement. When stats collection is not enabled or if for some reason\nPhoenix cannot provide the estimate information, the columns return null. Below is an example:",{"_12623":447,"_48290":447,"_5":13058,"_7710":94224,"_48807":94225,"_18312":94226,"_25222":447},"FAQ",[92880,92881,93148],[48836],{"_12623":448,"_48290":447,"_18312":94228,"_5":17825,"_25222":447,"_7710":94229},[48836],"Frequently asked question about Phoenix",{"_12623":449,"_48290":447,"_5":48804,"_18312":94231,"_25222":94232,"_7710":94233},[48836],"/docs/faq#questions-answered-in-this-page","Questions answered in this page:",{"_12623":450,"_48290":447,"_5":48804,"_18312":94235,"_25222":94236,"_7710":94237},[48836],"/docs/faq#i-want-to-get-started-is-there-a-phoenix-hello-world","I want to get started. Is there a Phoenix Hello World?",{"_12623":451,"_48290":447,"_5":48804,"_18312":94239,"_25222":94240,"_7710":94241},[48836],"/docs/faq#using-console","Using console",{"_12623":452,"_48290":447,"_5":48804,"_18312":94243,"_25222":94244,"_7710":94245},[48836],"/docs/faq#using-java","Using Java",{"_12623":453,"_48290":447,"_5":48804,"_18312":94247,"_25222":94248,"_7710":94249},[48836],"/docs/faq#what-is-the-phoenix-jdbc-url-syntax","What is the Phoenix JDBC URL syntax?",{"_12623":454,"_48290":447,"_5":48804,"_18312":94251,"_25222":94252,"_7710":94253},[48836],"/docs/faq#thick-driver","Thick Driver",{"_12623":455,"_48290":447,"_5":48804,"_18312":94255,"_25222":94256,"_7710":94257},[48836],"/docs/faq#thin-driver","Thin Driver",{"_12623":456,"_48290":447,"_5":48804,"_18312":94259,"_25222":94260,"_7710":94261},[48836],"/docs/faq#is-there-a-way-to-bulk-load-in-phoenix","Is there a way to bulk load in Phoenix?",{"_12623":457,"_48290":447,"_5":48804,"_18312":94263,"_25222":94264,"_7710":94265},[48836],"/docs/faq#map-reduce","Map Reduce",{"_12623":458,"_48290":447,"_5":48804,"_18312":94267,"_25222":94268,"_7710":94269},[48836],"/docs/faq#csv","CSV",{"_12623":459,"_48290":447,"_5":48804,"_18312":94271,"_25222":94272,"_7710":94273},[48836],"/docs/faq#how-i-map-phoenix-table-to-an-existing-hbase-table","How I map Phoenix table to an existing HBase table?",{"_12623":460,"_48290":447,"_5":48804,"_18312":94275,"_25222":94276,"_7710":94277},[48836],"/docs/faq#are-there-any-tips-for-optimizing-phoenix","Are there any tips for optimizing Phoenix?",{"_12623":461,"_48290":447,"_5":48804,"_18312":94279,"_25222":94280,"_7710":94281},[48836],"/docs/faq#how-do-i-create-secondary-index-on-a-table","How do I create Secondary Index on a table?",{"_12623":462,"_48290":447,"_5":48804,"_18312":94283,"_25222":94284,"_7710":94285},[48836],"/docs/faq#why-isnt-my-secondary-index-being-used","Why isn't my secondary index being used?",{"_12623":463,"_48290":447,"_5":48804,"_18312":94287,"_25222":94288,"_7710":94289},[48836],"/docs/faq#how-fast-is-phoenix-why-is-it-so-fast","How fast is Phoenix? Why is it so fast?",{"_12623":464,"_48290":447,"_5":48804,"_18312":94291,"_25222":94292,"_7710":94293},[48836],"/docs/faq#how-do-i-connect-to-secure-hbase-cluster","How do I connect to secure HBase cluster?",{"_12623":465,"_48290":447,"_5":48804,"_18312":94295,"_25222":94296,"_7710":94297},[48836],"/docs/faq#what-hbase-and-hadoop-versions-are-supported","What HBase and Hadoop versions are supported?",{"_12623":466,"_48290":447,"_5":48804,"_18312":94299,"_25222":94300,"_7710":94301},[48836],"/docs/faq#can-phoenix-work-on-tables-with-arbitrary-timestamp-as-flexible-as-hbase-api","Can phoenix work on tables with arbitrary timestamp as flexible as HBase API?",{"_12623":467,"_48290":447,"_5":48804,"_18312":94303,"_25222":94304,"_7710":94305},[48836],"/docs/faq#why-isnt-my-query-doing-a-range-scan","Why isn't my query doing a RANGE SCAN?",{"_12623":468,"_48290":447,"_5":48804,"_18312":94307,"_25222":94308,"_7710":94309},[48836],"/docs/faq#should-i-pool-phoenix-jdbc-connections","Should I pool Phoenix JDBC Connections?",{"_12623":469,"_48290":447,"_5":48804,"_18312":94311,"_25222":94312,"_7710":94313},[48836],"/docs/faq#why-does-phoenix-add-an-emptydummy-keyvalue-when-doing-an-upsert","Why does Phoenix add an empty/dummy KeyValue when doing an upsert?",{"_12623":470,"_48290":447,"_18312":94315,"_5":17825,"_25222":94232,"_7710":94237},[48836],{"_12623":471,"_48290":447,"_18312":94317,"_5":17825,"_25222":94232,"_7710":94249},[48836],{"_12623":472,"_48290":447,"_18312":94319,"_5":17825,"_25222":94232,"_7710":94261},[48836],{"_12623":473,"_48290":447,"_18312":94321,"_5":17825,"_25222":94232,"_7710":94273},[48836],{"_12623":474,"_48290":447,"_18312":94323,"_5":17825,"_25222":94232,"_7710":94277},[48836],{"_12623":475,"_48290":447,"_18312":94325,"_5":17825,"_25222":94232,"_7710":94281},[48836],{"_12623":476,"_48290":447,"_18312":94327,"_5":17825,"_25222":94232,"_7710":94285},[48836],{"_12623":477,"_48290":447,"_18312":94329,"_5":17825,"_25222":94232,"_7710":94289},[48836],{"_12623":478,"_48290":447,"_18312":94331,"_5":17825,"_25222":94232,"_7710":94293},[48836],{"_12623":479,"_48290":447,"_18312":94333,"_5":17825,"_25222":94232,"_7710":94297},[48836],{"_12623":480,"_48290":447,"_18312":94335,"_5":17825,"_25222":94232,"_7710":94301},[48836],{"_12623":481,"_48290":447,"_18312":94337,"_5":17825,"_25222":94232,"_7710":94305},[48836],{"_12623":482,"_48290":447,"_18312":94339,"_5":17825,"_25222":94232,"_7710":94309},[48836],{"_12623":483,"_48290":447,"_18312":94341,"_5":17825,"_25222":94232,"_7710":94342},[48836],"Why does Phoenix add an empty or dummy KeyValue when doing an upsert?",{"_12623":484,"_48290":447,"_18312":94344,"_5":17825,"_25222":94236,"_7710":94345},[48836],"Pre-requisite: Download and install the latest Phoenix.",{"_12623":485,"_48290":447,"_18312":94347,"_5":17825,"_25222":94240,"_7710":94348},[48836],"Start Sqlline:",{"_12623":486,"_48290":447,"_18312":94350,"_5":17825,"_25222":94240,"_7710":94351},[48836],"Execute the following statements when Sqlline connects:",{"_12623":487,"_48290":447,"_18312":94353,"_5":17825,"_25222":94240,"_7710":94354},[48836],"You should get the following output:",{"_12623":488,"_48290":447,"_18312":94356,"_5":17825,"_25222":94244,"_7710":94357},[48836],"Create test.java file with the following content:",{"_12623":489,"_48290":447,"_18312":94359,"_5":17825,"_25222":94244,"_7710":94360},[48836],"Compile and execute on command line",{"_12623":490,"_48290":447,"_18312":94362,"_5":17825,"_25222":94244,"_7710":94363},[48836],"You should get the following output",{"_12623":491,"_48290":447,"_18312":94365,"_5":17825,"_25222":94252,"_7710":94366},[48836],"See Using the Phoenix JDBC Driver for a more up-to-date description",{"_12623":492,"_48290":447,"_18312":94368,"_5":17825,"_25222":94252,"_7710":94369},[48836],"The Phoenix (Thick) Driver JDBC URL syntax is as follows (where elements in square brackets are optional):",{"_12623":493,"_48290":447,"_18312":94371,"_5":17825,"_25222":94252,"_7710":94372},[48836],"The simplest URL is:",{"_12623":494,"_48290":447,"_18312":94374,"_5":17825,"_25222":94252,"_7710":94375},[48836],"Whereas the most complicated URL is:",{"_12623":495,"_48290":447,"_18312":94377,"_5":17825,"_25222":94252,"_7710":94378},[48836],"Please note that each optional element in the URL requires all previous optional elements. For example, to specify the\nHBase root ZNode, the ZooKeeper port must also be specified.",{"_12623":496,"_48290":447,"_18312":94380,"_5":17825,"_25222":94252,"_7710":94381},[48836],"See also Connection String.",{"_12623":497,"_48290":447,"_18312":94383,"_5":17825,"_25222":94256,"_7710":94384},[48836],"The Phoenix Thin Driver (used with the Phoenix Query Server) JDBC URL syntax is as follows:",{"_12623":498,"_48290":447,"_18312":94386,"_5":17825,"_25222":94256,"_7710":94387},[48836],"There are a number of keys exposed for client-use. The most commonly-used keys are: url and serialization. The url\nkey is required to interact with the Phoenix Query Server.",{"_12623":499,"_48290":447,"_18312":94389,"_5":17825,"_25222":94256,"_7710":94372},[48836],{"_12623":500,"_48290":447,"_18312":94391,"_5":17825,"_25222":94256,"_7710":94392},[48836],"Where as very complicated URL is:",{"_12623":501,"_48290":447,"_18312":94394,"_5":17825,"_25222":94256,"_7710":94395},[48836],"Please refer to the Apache Avatica documentation for a full list of supported options in the Thin client JDBC URL,\nor see the Query Server documentation",{"_12623":502,"_48290":447,"_18312":94397,"_5":17825,"_25222":94264,"_7710":94398},[48836],"See the example here",{"_12623":503,"_48290":447,"_18312":94400,"_5":17825,"_25222":94268,"_7710":94401},[48836],"CSV data can be bulk loaded with built in utility named psql. Typical upsert rates are 20K - 50K rows per second (depends on how wide are the rows).",{"_12623":504,"_48290":447,"_18312":94403,"_5":17825,"_25222":94268,"_7710":94404},[48836],"Usage example:",{"_12623":505,"_48290":447,"_18312":94406,"_5":17825,"_25222":94268,"_7710":94407},[48836],"Create table using psql:",{"_12623":506,"_48290":447,"_18312":94409,"_5":17825,"_25222":94268,"_7710":94410},[48836],"Upsert CSV bulk data:",{"_12623":507,"_48290":447,"_18312":94412,"_5":17825,"_25222":94272,"_7710":94413},[48836],"You can create both a Phoenix table or view through the CREATE TABLE/CREATE VIEW DDL statement on a pre-existing HBase table. In both cases, we'll leave the HBase metadata as-is. For CREATE TABLE, we'll create any metadata (table, column families) that doesn't already exist. We'll also add an empty key value for each row so that queries behave as expected (without requiring all columns to be projected during scans).",{"_12623":508,"_48290":447,"_18312":94415,"_5":17825,"_25222":94272,"_7710":94416},[48836],"The other caveat is that the way the bytes were serialized must match the way the bytes are serialized by Phoenix. For VARCHAR, CHAR, and UNSIGNED_* types, we use the HBase Bytes methods. The CHAR type expects only single-byte characters and the UNSIGNED types expect values greater than or equal to zero. For signed types (TINYINT, SMALLINT, INTEGER and BIGINT), Phoenix will flip the first bit so that negative values will sort before positive values. Because HBase sorts row keys in lexicographical order and negative value's first bit is 1 while positive 0 so that negative value is 'greater than' positive value if we don't flip the first bit. So if you stored integers by HBase native API and want to access them by Phoenix, make sure that all your data types are UNSIGNED types.",{"_12623":509,"_48290":447,"_18312":94418,"_5":17825,"_25222":94272,"_7710":94419},[48836],"Our composite row keys are formed by simply concatenating the values together, with a zero byte character used as a separator after a variable length type.",{"_12623":510,"_48290":447,"_18312":94421,"_5":17825,"_25222":94272,"_7710":94422},[48836],"If you create an HBase table like this:",{"_12623":511,"_48290":447,"_18312":94424,"_5":17825,"_25222":94272,"_7710":94425},[48836],"then you have an HBase table with a name of t1 and a column family with a name of f1. Remember, in HBase, you don't model the possible KeyValues or the structure of the row key. This is the information you specify in Phoenix above and beyond the table and column family.",{"_12623":512,"_48290":447,"_18312":94427,"_5":17825,"_25222":94272,"_7710":94428},[48836],"So in Phoenix, you'd create a view like this:",{"_12623":513,"_48290":447,"_18312":94430,"_5":17825,"_25222":94272,"_7710":94431},[48836],"The pk column declares that your row key is a VARCHAR (i.e. a string) while the \"f1\".val column declares that your HBase table will contain KeyValues with a column family and column qualifier of \"f1\":VAL and that their value will be a VARCHAR.",{"_12623":514,"_48290":447,"_18312":94433,"_5":17825,"_25222":94272,"_7710":94434},[48836],"Note that you don't need the double quotes if you create your HBase table with all caps names (since this is how Phoenix normalizes strings, by upper casing them). For example, with:",{"_12623":515,"_48290":447,"_18312":94436,"_5":17825,"_25222":94272,"_7710":94437},[48836],"you could create this Phoenix view:",{"_12623":516,"_48290":447,"_18312":94439,"_5":17825,"_25222":94272,"_7710":94440},[48836],"Or if you're creating new HBase tables, just let Phoenix do everything for you like this (No need to use the HBase shell at all.):",{"_12623":517,"_48290":447,"_18312":94442,"_5":17825,"_25222":94276,"_7710":94443},[48836],"Use Salting to increase read/write performanceSalting can significantly increase read/write performance by pre-splitting the data into multiple regions. Although Salting will yield better performance in most scenarios.Example:",{"_12623":518,"_48290":447,"_18312":94445,"_5":17825,"_25222":94276,"_7710":94446},[48836],"Note: Ideally for a 16 region server cluster with quad-core CPUs, choose salt buckets between 32-64 for optimal performance.",{"_12623":519,"_48290":447,"_18312":94448,"_5":17825,"_25222":94276,"_7710":94449},[48836],"Pre-split tableSalting does automatic table splitting but in case you want to exactly control where table split occurs with out adding extra byte or change row key order then you can pre-split a table.Example:",{"_12623":520,"_48290":447,"_18312":94451,"_5":17825,"_25222":94276,"_7710":94452},[48836],"Use multiple column familiesColumn family contains related data in separate files. If you query use selected columns then it make sense to group those columns together in a column family to improve read performance.Example:Following create table DDL will create two column faimiles A and B.",{"_12623":521,"_48290":447,"_18312":94454,"_5":17825,"_25222":94276,"_7710":94455},[48836],"Use compressionOn disk compression improves performance on large tablesExample:",{"_12623":522,"_48290":447,"_18312":94457,"_5":17825,"_25222":94276,"_7710":94458},[48836],"Create indexes\nSee How do I connect to secure HBase cluster?",{"_12623":523,"_48290":447,"_18312":94460,"_5":17825,"_25222":94276,"_7710":94461},[48836],"Optimize cluster parameters\nSee https://hbase.apache.org/docs/performance",{"_12623":524,"_48290":447,"_18312":94463,"_5":17825,"_25222":94276,"_7710":94464},[48836],"Optimize Phoenix parameters\nSee Configuration",{"_12623":525,"_48290":447,"_18312":94466,"_5":17825,"_25222":94280,"_7710":94467},[48836],"Starting with Phoenix version 2.1, Phoenix supports index over mutable and immutable data. Note that Phoenix 2.0.x only supports Index over immutable data. Index write performance index with immutable table is slightly faster than mutable table however data in immutable table cannot be updated.",{"_12623":526,"_48290":447,"_18312":94469,"_5":17825,"_25222":94280,"_7710":94470},[48836],"Example:",{"_12623":527,"_48290":447,"_18312":94472,"_5":17825,"_25222":94280,"_7710":94473},[48836],"Create tableImmutable table: create table test (mykey varchar primary key, col1 varchar, col2 varchar) IMMUTABLE_ROWS=true;Mutable table: create table test (mykey varchar primary key, col1 varchar, col2 varchar);",{"_12623":528,"_48290":447,"_18312":94475,"_5":17825,"_25222":94280,"_7710":94476},[48836],"Creating index on col2create index idx on test (col2)",{"_12623":529,"_48290":447,"_18312":94478,"_5":17825,"_25222":94280,"_7710":94479},[48836],"Creating index on col1 and a covered index on col2create index idx on test (col1) include (col2)Upsert rows in this test table and Phoenix query optimizer will choose correct index to use. You can see in explain plan if Phoenix is using the index table. You can also give a hint in Phoenix query to use a specific index.",{"_12623":530,"_48290":447,"_18312":94481,"_5":17825,"_25222":94280,"_7710":94482},[48836],"See Secondary Indexing for further information",{"_12623":531,"_48290":447,"_18312":94484,"_5":17825,"_25222":94284,"_7710":94485},[48836],"The secondary index won't be used unless all columns used in the query are in it ( as indexed or covered columns). All columns making up the primary key of the data table will automatically be included in the index.",{"_12623":532,"_48290":447,"_18312":94487,"_5":17825,"_25222":94284,"_7710":94488},[48836],"Example: DDL create table usertable (id varchar primary key, firstname varchar, lastname varchar); create index idx_name on usertable (firstname);",{"_12623":533,"_48290":447,"_18312":94490,"_5":17825,"_25222":94284,"_7710":94491},[48836],"Query: DDL select id, firstname, lastname from usertable where firstname = 'foo';",{"_12623":534,"_48290":447,"_18312":94493,"_5":17825,"_25222":94284,"_7710":94494},[48836],"Index would not be used in this case as lastname is not part of indexed or covered column. This can be verified by looking at the explain plan. To fix this create index that has either lastname part of index or covered column. Example: create idx_name on usertable (firstname) include (lastname);",{"_12623":535,"_48290":447,"_18312":94496,"_5":17825,"_25222":94284,"_7710":94497},[48836],"You can force Phoenix to use secondary for uncovered columns by specifying an index hint",{"_12623":536,"_48290":447,"_18312":94499,"_5":17825,"_25222":94288,"_7710":94500},[48836],"Phoenix is fast. Full table scan of 100M rows usually completes in 20 seconds (narrow table on a medium sized cluster). This time come down to few milliseconds if query contains filter on key columns. For filters on non-key columns or non-leading key columns, you can add index on these columns which leads to performance equivalent to filtering on key column by making copy of table with indexed column(s) part of key.",{"_12623":537,"_48290":447,"_18312":94502,"_5":17825,"_25222":94288,"_7710":94503},[48836],"Why is Phoenix fast even when doing full scan:",{"_12623":538,"_48290":447,"_18312":94505,"_5":17825,"_25222":94288,"_7710":94506},[48836],"Phoenix chunks up your query using the region boundaries and runs them in parallel on the client using a configurable number of threads.",{"_12623":539,"_48290":447,"_18312":94508,"_5":17825,"_25222":94288,"_7710":94509},[48836],"The aggregation will be done in a coprocessor on the server-side, collapsing the amount of data that gets returned back to the client rather than returning it all.",{"_12623":540,"_48290":447,"_18312":94511,"_5":17825,"_25222":94292,"_7710":94512},[48836],"Specify the principal and corresponding keytab in the JDBC URL as show above.\nFor ancient Phoenix versions heck out the excellent post by Anil Gupta",{"_12623":541,"_48290":447,"_18312":94514,"_5":17825,"_25222":94296,"_7710":94515},[48836],"Phoenix 4.x supports HBase 1.x running on Hadoop 2",{"_12623":542,"_48290":447,"_18312":94517,"_5":17825,"_25222":94296,"_7710":94518},[48836],"Phoenix 5.x supports HBase 2.x running on Hadoop 3",{"_12623":543,"_48290":447,"_18312":94520,"_5":17825,"_25222":94296,"_7710":94521},[48836],"See the release notes and BUILDING in recent releases for the exact versions supported,\nand on how to build Phoenix for specific HBase and Hadoop versions",{"_12623":544,"_48290":447,"_18312":94523,"_5":17825,"_25222":94300,"_7710":94524},[48836],"By default, Phoenix lets HBase manage the timestamps and just shows you the latest values for everything. However, Phoenix also allows arbitrary timestamps to be supplied by the user. To do that you'd specify a CurrentSCN at connection time, like this:",{"_12623":545,"_48290":447,"_18312":94526,"_5":17825,"_25222":94300,"_7710":94527},[48836],"The above is equivalent to doing this with the HBase API:",{"_12623":546,"_48290":447,"_18312":94529,"_5":17825,"_25222":94300,"_7710":94530},[48836],"By specifying a CurrentSCN, you're telling Phoenix that you want everything for that connection to be done at that timestamp. Note that this applies to queries done on the connection as well - for example, a query over myTable above would not see the data it just upserted, since it only sees data that was created before its CurrentSCN property. This provides a way of doing snapshot, flashback, or point-in-time queries.",{"_12623":547,"_48290":447,"_18312":94532,"_5":17825,"_25222":94300,"_7710":94533},[48836],"Keep in mind that creating a new connection is not an expensive operation. The same underlying HConnection is used for all connections to the same cluster, so it's more or less like instantiating a few objects.",{"_12623":548,"_48290":447,"_18312":94535,"_5":17825,"_25222":94304,"_7710":94536},[48836],"RANGE SCAN means that only a subset of the rows in your table will be scanned over. This occurs if you use one or more leading columns from your primary key constraint. Query that is not filtering on leading PK columns ex. select * from test where pk2='x' and pk3='y'; will result in full scan whereas the following query will result in range scan select * from test where pk1='x' and pk2='y';. Note that you can add a secondary index on your pk2 and pk3 columns and that would cause a range scan to be done for the first query (over the index table).",{"_12623":549,"_48290":447,"_18312":94538,"_5":17825,"_25222":94304,"_7710":94539},[48836],"DEGENERATE SCAN means that a query can't possibly return any rows. If we can determine that at compile time, then we don't bother to even run the scan.",{"_12623":550,"_48290":447,"_18312":94541,"_5":17825,"_25222":94304,"_7710":94542},[48836],"FULL SCAN means that all rows of the table will be scanned over (potentially with a filter applied if you have a WHERE clause)",{"_12623":551,"_48290":447,"_18312":94544,"_5":17825,"_25222":94304,"_7710":94545},[48836],"SKIP SCAN means that either a subset or all rows in your table will be scanned over, however it will skip large groups of rows depending on the conditions in your filter. See this blog for more detail. We don't do a SKIP SCAN if you have no filter on the leading primary key columns, but you can force a SKIP SCAN by using the /*+ SKIP_SCAN */ hint. Under some conditions, namely when the cardinality of your leading primary key columns is low, it will be more efficient than a FULL SCAN.",{"_12623":552,"_48290":447,"_18312":94547,"_5":17825,"_25222":94308,"_7710":94548},[48836],"No, it is not necessary to pool Phoenix JDBC Connections.",{"_12623":553,"_48290":447,"_18312":94550,"_5":17825,"_25222":94308,"_7710":94551},[48836],"Phoenix's Connection objects are different from most other JDBC Connections due to the underlying HBase connection. The Phoenix Connection object is designed to be a thin object that is inexpensive to create. If Phoenix Connections are reused, it is possible that the underlying HBase connection is not always left in a healthy state by the previous user. It is better to create new Phoenix Connections to ensure that you avoid any potential issues.",{"_12623":554,"_48290":447,"_18312":94553,"_5":17825,"_25222":94308,"_7710":94554},[48836],"Implementing pooling for Phoenix could be done simply by creating a delegate Connection that instantiates a new Phoenix connection when retrieved from the pool and then closes the connection when returning it to the pool (see PHOENIX-2388).",{"_12623":555,"_48290":447,"_18312":94556,"_5":17825,"_25222":94312,"_7710":94557},[48836],"The empty or dummy KeyValue (with a column qualifier of _0) is needed to ensure that a given column is available\nfor all rows.",{"_12623":556,"_48290":447,"_18312":94559,"_5":17825,"_25222":94312,"_7710":94560},[48836],"As you may know, data is stored in HBase as KeyValues, meaning that\nthe full row key is stored for each column value. This also implies\nthat the row key is not stored at all unless there is at least one\ncolumn stored.",{"_12623":557,"_48290":447,"_18312":94562,"_5":17825,"_25222":94312,"_7710":94563},[48836],"Now consider JDBC row which has an integer primary key, and several\ncolumns which are all null. In order to be able to store the primary\nkey, a KeyValue needs to be stored to show that the row is present at\nall. This column is represented by the empty column that you've\nnoticed. This allows doing a SELECT * FROM TABLE and receiving\nrecords for all rows, even those whose non-pk columns are null.",{"_12623":558,"_48290":447,"_18312":94565,"_5":17825,"_25222":94312,"_7710":94566},[48836],"The same issue comes up even if only one column is null for some (or\nall) records. A scan over Phoenix will include the empty column to\nensure that rows that only consist of the primary key (and have null\nfor all non-key columns) will be included in a scan result.",{"_12623":559,"_48290":559,"_5":13058,"_7710":94568,"_48807":94569,"_18312":94571,"_25222":559},"Atomic Upsert",[92880,92881,92882,94570],"Features",[48836],{"_12623":560,"_48290":559,"_18312":94573,"_5":17825,"_25222":559,"_7710":94574},[48836],"Use UPSERT ... ON DUPLICATE KEY for atomic row-level updates in Phoenix, with examples and limitations.",{"_12623":561,"_48290":559,"_5":48804,"_18312":94576,"_25222":94577,"_7710":94578},[48836],"/docs/features/atomic-upsert#atomic-upsert-examples","Examples",{"_12623":562,"_48290":559,"_5":48804,"_18312":94580,"_25222":94581,"_7710":94582},[48836],"/docs/features/atomic-upsert#atomic-upsert-update-only","ON DUPLICATE KEY UPDATE_ONLY",{"_12623":563,"_48290":559,"_5":48804,"_18312":94584,"_25222":94585,"_7710":94586},[48836],"/docs/features/atomic-upsert#atomic-upsert-returning","Returning the affected row",{"_12623":564,"_48290":559,"_5":48804,"_18312":94588,"_25222":94589,"_7710":94590},[48836],"/docs/features/atomic-upsert#java-jdbc-thick-client-api","Java JDBC thick-client API",{"_12623":565,"_48290":559,"_5":48804,"_18312":94592,"_25222":94593,"_7710":93002},[48836],"/docs/features/atomic-upsert#atomic-upsert-limitations",{"_12623":566,"_48290":559,"_18312":94595,"_5":17825,"_25222":559,"_7710":94596},[48836],"To support atomic upsert, an optional ON DUPLICATE KEY clause, similar to the MySQL syntax, has been\nincorporated into the UPSERT VALUES command as of Phoenix 4.9. The general syntax is described\nhere. This feature provides a superset of the HBase Increment and\nCheckAndPut functionality to enable atomic upserts. On the server-side, when the commit\nis processed, the row being updated will be locked while the current column values are read and the\nON DUPLICATE KEY clause is executed. Given that the row must be locked and read when the ON DUPLICATE KEY\nclause is used, there will be a performance penalty (much like there is for an HBase Put versus a CheckAndPut).",{"_12623":567,"_48290":559,"_18312":94598,"_5":17825,"_25222":559,"_7710":94599},[48836],"In the presence of the ON DUPLICATE KEY clause, if the row already exists, the VALUES specified will\nbe ignored and instead either:",{"_12623":568,"_48290":559,"_18312":94601,"_5":17825,"_25222":559,"_7710":94602},[48836],"the row will not be updated if ON DUPLICATE KEY IGNORE is specified or",{"_12623":569,"_48290":559,"_18312":94604,"_5":17825,"_25222":559,"_7710":94605},[48836],"the row will be updated (under lock) by executing the expressions following the ON DUPLICATE KEY UPDATE\nclause.",{"_12623":570,"_48290":559,"_18312":94607,"_5":17825,"_25222":559,"_7710":94608},[48836],"Multiple UPSERT statements for the same row in the same commit batch will be processed in the order of their\nexecution. Thus the same result will be produced when auto commit is on or off.",{"_12623":571,"_48290":559,"_18312":94610,"_5":17825,"_25222":94577,"_7710":94611},[48836],"For example, to atomically increment two counter columns, you would execute the following command:",{"_12623":572,"_48290":559,"_18312":94613,"_5":17825,"_25222":94577,"_7710":94614},[48836],"To only update a column if it doesn't yet exist:",{"_12623":573,"_48290":559,"_18312":94616,"_5":17825,"_25222":94577,"_7710":94617},[48836],"Note that arbitrarily complex expressions may be used in this new clause:",{"_12623":574,"_48290":559,"_18312":94619,"_5":17825,"_25222":94581,"_7710":94620},[48836],"UPDATE_ONLY is a third variant of the ON DUPLICATE KEY clause, available from\nPhoenix 5.3.0 (PHOENIX-7648).\nUnlike UPDATE, it only runs the update-clause expressions when the row already\nexists — it never inserts. If the row is missing, the supplied VALUES are discarded\nand the statement is a no-op. Use it when an UPSERT should be able to update an\nexisting row but must not create a new one.",{"_12623":575,"_48290":559,"_18312":94622,"_5":17825,"_25222":94581,"_7710":94623},[48836],"If id = 'sku-42' already exists, its qty is decremented under the row lock.\nIf it doesn't, the supplied VALUES are discarded and nothing is written.",{"_12623":576,"_48290":559,"_18312":94625,"_5":17825,"_25222":94581,"_7710":94626},[48836],"The three forms compared:",{"_12623":577,"_48290":559,"_18312":94628,"_5":17825,"_25222":94581,"_7710":94629},[48836],"Clause",{"_12623":578,"_48290":559,"_18312":94631,"_5":17825,"_25222":94581,"_7710":94632},[48836],"Row missing",{"_12623":579,"_48290":559,"_18312":94634,"_5":17825,"_25222":94581,"_7710":94635},[48836],"Row present",{"_12623":580,"_48290":559,"_18312":94637,"_5":17825,"_25222":94581,"_7710":94638},[48836],"ON DUPLICATE KEY IGNORE",{"_12623":581,"_48290":559,"_18312":94640,"_5":17825,"_25222":94581,"_7710":94641},[48836],"Insert from VALUES",{"_12623":582,"_48290":559,"_18312":94643,"_5":17825,"_25222":94581,"_7710":94644},[48836],"No-op",{"_12623":583,"_48290":559,"_18312":94646,"_5":17825,"_25222":94581,"_7710":94647},[48836],"ON DUPLICATE KEY UPDATE ...",{"_12623":584,"_48290":559,"_18312":94649,"_5":17825,"_25222":94581,"_7710":94641},[48836],{"_12623":585,"_48290":559,"_18312":94651,"_5":17825,"_25222":94581,"_7710":94652},[48836],"Run the update",{"_12623":586,"_48290":559,"_18312":94654,"_5":17825,"_25222":94581,"_7710":94655},[48836],"ON DUPLICATE KEY UPDATE_ONLY ...",{"_12623":587,"_48290":559,"_18312":94657,"_5":17825,"_25222":94581,"_7710":94658},[48836],"No-op (VALUES discarded)",{"_12623":588,"_48290":559,"_18312":94660,"_5":17825,"_25222":94581,"_7710":94652},[48836],{"_12623":589,"_48290":559,"_18312":94662,"_5":17825,"_25222":94585,"_7710":94663},[48836],"A single-row UPSERT or DELETE can append RETURNING * to return the affected row\nas a JDBC ResultSet in the same round-trip, available from Phoenix 5.3.0\n(PHOENIX-7651). The returned\nrow reflects the server-side state after the mutation — including any values\ncomputed by an ON DUPLICATE KEY UPDATE clause under the row lock.",{"_12623":590,"_48290":559,"_18312":94665,"_5":17825,"_25222":94585,"_7710":94666},[48836],"This collapses two common patterns into one round-trip:",{"_12623":591,"_48290":559,"_18312":94668,"_5":17825,"_25222":94585,"_7710":94669},[48836],"Atomic read-modify-write counters — increment, then read the new value\nwithout a follow-up SELECT (and without risking a different writer slipping in\nbetween).",{"_12623":592,"_48290":559,"_18312":94671,"_5":17825,"_25222":94585,"_7710":94672},[48836],"Tombstoning / queue consumers — atomically delete a row and read the payload\nyou just removed, useful for idempotent replay and \"claim the next task\" patterns.",{"_12623":593,"_48290":559,"_18312":94674,"_5":17825,"_25222":94585,"_7710":94675},[48836],"The statement must affect a single row when RETURNING * is used. Drivers iterate\nthe returned ResultSet exactly like the result of a regular SELECT.",{"_12623":594,"_48290":559,"_18312":94677,"_5":17825,"_25222":94589,"_7710":94678},[48836],"Java applications using the Phoenix thick JDBC client can drive the same\natomic-return semantics directly through typed methods on PhoenixStatement and\nPhoenixPreparedStatement, without putting RETURNING * in the SQL:",{"_12623":595,"_48290":559,"_18312":94680,"_5":17825,"_25222":94589,"_7710":94681},[48836],"executeAtomicUpdateReturnRow — returns the row state after the mutation\n(or the unchanged row when the statement was a no-op). Equivalent to\nRETURNING * in SQL.",{"_12623":596,"_48290":559,"_18312":94683,"_5":17825,"_25222":94589,"_7710":94684},[48836],"executeAtomicUpdateReturnOldRow — returns the row state before the\nmutation, regardless of whether the mutation was applied. There is no SQL form\nfor this — only the typed API exposes the pre-image, which is the natural fit\nfor audit logs and compare-and-swap-style flows.",{"_12623":597,"_48290":559,"_18312":94686,"_5":17825,"_25222":94589,"_7710":94687},[48836],"Both return a Pair<Integer, ResultSet> where the integer is 1 if the row was\nmutated and 0 for a no-op, so callers know the outcome without having to inspect\ncell contents. Both require an auto-commit connection.",{"_12623":598,"_48290":559,"_18312":94689,"_5":17825,"_25222":94593,"_7710":94690},[48836],"The following limitations are enforced for the ON DUPLICATE KEY clause usage:",{"_12623":599,"_48290":559,"_18312":94692,"_5":17825,"_25222":94593,"_7710":94693},[48836],"Primary key columns may not be updated, since this would essentially be creating a new row.",{"_12623":600,"_48290":559,"_18312":94695,"_5":17825,"_25222":94593,"_7710":94696},[48836],"Transactional tables may not use this clause as atomic upserts are already possible through\nexception handling when a conflict occurs.",{"_12623":601,"_48290":559,"_18312":94698,"_5":17825,"_25222":94593,"_7710":94699},[48836],"Immutable tables may not use this clause as by definition there should be no updates to\nexisting rows.",{"_12623":602,"_48290":559,"_18312":94701,"_5":17825,"_25222":94593,"_7710":94702},[48836],"The CURRENT_SCN property may not be set on connection when this clause is used as HBase\ndoes not handle atomicity unless the latest value is being updated.",{"_12623":603,"_48290":559,"_18312":94704,"_5":17825,"_25222":94593,"_7710":94705},[48836],"The same column should not be updated more than once in the same statement.",{"_12623":604,"_48290":559,"_18312":94707,"_5":17825,"_25222":94593,"_7710":94708},[48836],"No aggregation or references to sequences are allowed within the clause.",{"_12623":605,"_48290":605,"_5":13058,"_7710":94710,"_48807":94711,"_18312":94712,"_25222":605},"Document Data: BSON",[92880,92881,92882,94570],[48836],{"_12623":606,"_48290":605,"_18312":94714,"_5":17825,"_25222":605,"_7710":94715},[48836],"Store, query, filter, and atomically update Binary JSON (BSON) documents inside a Phoenix table — without round-tripping the document to the client.",{"_12623":607,"_48290":605,"_5":48804,"_18312":94717,"_25222":94718,"_7710":94719},[48836],"/docs/features/bson#bson-when","When to reach for BSON",{"_12623":608,"_48290":605,"_5":48804,"_18312":94721,"_25222":94722,"_7710":94723},[48836],"/docs/features/bson#bson-defining","Defining a BSON column",{"_12623":609,"_48290":605,"_5":48804,"_18312":94725,"_25222":94726,"_7710":94727},[48836],"/docs/features/bson#bson-paths","Field paths",{"_12623":610,"_48290":605,"_5":48804,"_18312":94729,"_25222":94730,"_7710":94731},[48836],"/docs/features/bson#bson-value","Reading fields: BSON_VALUE",{"_12623":611,"_48290":605,"_5":48804,"_18312":94733,"_25222":94734,"_7710":94735},[48836],"/docs/features/bson#bson-condition-expression","Filtering rows: BSON_CONDITION_EXPRESSION",{"_12623":612,"_48290":605,"_5":48804,"_18312":94737,"_25222":94738,"_7710":94739},[48836],"/docs/features/bson#bson-update-expression","Atomically updating fields: BSON_UPDATE_EXPRESSION",{"_12623":613,"_48290":605,"_5":48804,"_18312":94741,"_25222":94742,"_7710":94743},[48836],"/docs/features/bson#bson-indexing","Indexing individual fields",{"_12623":614,"_48290":605,"_5":48804,"_18312":94745,"_25222":94746,"_7710":94747},[48836],"/docs/features/bson#bson-end-to-end","End-to-end example",{"_12623":615,"_48290":605,"_5":48804,"_18312":94749,"_25222":94750,"_7710":93002},[48836],"/docs/features/bson#bson-limitations",{"_12623":616,"_48290":605,"_18312":94752,"_5":17825,"_25222":605,"_7710":94753},[48836],"BSON is a native column type for storing schemaless document data alongside your\nrelational columns. Documents are stored in Binary JSON — a\ncompact, length-prefixed format that is cheap to parse server-side and supports the\nfull set of value types (strings, numbers, dates, binary, booleans, nulls, arrays,\nnested objects). Introduced in Phoenix 5.3.0\n(PHOENIX-7330).",{"_12623":617,"_48290":605,"_18312":94755,"_5":17825,"_25222":605,"_7710":94756},[48836],"The point of the type is not just to hold documents — it's that Phoenix can read,\nfilter, and mutate individual fields on the server without the client ever\ndeserializing the whole document.",{"_12623":618,"_48290":605,"_18312":94758,"_5":17825,"_25222":94718,"_7710":94759},[48836],"Use case",{"_12623":619,"_48290":605,"_18312":94761,"_5":17825,"_25222":94718,"_7710":94762},[48836],"Recommended type",{"_12623":620,"_48290":605,"_18312":94764,"_5":17825,"_25222":94718,"_7710":94765},[48836],"Schema is well-known and stable",{"_12623":621,"_48290":605,"_18312":94767,"_5":17825,"_25222":94718,"_7710":94768},[48836],"Regular relational columns",{"_12623":622,"_48290":605,"_18312":94770,"_5":17825,"_25222":94718,"_7710":94771},[48836],"A few optional/sparse fields on otherwise relational rows",{"_12623":623,"_48290":605,"_18312":94773,"_5":17825,"_25222":94718,"_7710":94774},[48836],"Dynamic Columns",{"_12623":624,"_48290":605,"_18312":94776,"_5":17825,"_25222":94718,"_7710":94777},[48836],"Variable-shape documents per row, server-side reads/filters/updates needed",{"_12623":625,"_48290":605,"_18312":94779,"_5":17825,"_25222":94718,"_7710":94780},[48836],"BSON",{"_12623":626,"_48290":605,"_18312":94782,"_5":17825,"_25222":94718,"_7710":94783},[48836],"Variable-shape documents but the server never inspects them",{"_12623":627,"_48290":605,"_18312":94785,"_5":17825,"_25222":94718,"_7710":94786},[48836],"VARCHAR (raw JSON) or VARBINARY",{"_12623":628,"_48290":605,"_18312":94788,"_5":17825,"_25222":94718,"_7710":94789},[48836],"Common cases for BSON:",{"_12623":629,"_48290":605,"_18312":94791,"_5":17825,"_25222":94718,"_7710":94792},[48836],"DynamoDB-style application objects backed by Phoenix.",{"_12623":630,"_48290":605,"_18312":94794,"_5":17825,"_25222":94718,"_7710":94795},[48836],"Customer / configuration / preferences documents that vary per row.",{"_12623":631,"_48290":605,"_18312":94797,"_5":17825,"_25222":94718,"_7710":94798},[48836],"Event payloads where downstream queries need to filter or project specific fields.",{"_12623":632,"_48290":605,"_18312":94800,"_5":17825,"_25222":94718,"_7710":94801},[48836],"Counters and per-field updates that must be atomic without rewriting the whole row.",{"_12623":633,"_48290":605,"_18312":94803,"_5":17825,"_25222":94722,"_7710":94804},[48836],"You may pass a JSON string literal as shown — Phoenix parses and converts it to BSON on\nwrite — or bind a pre-built BSON document via JDBC.",{"_12623":634,"_48290":605,"_18312":94806,"_5":17825,"_25222":94722,"_7710":94807},[48836],"A BSON column may also serve as a primary-key column. In a composite primary key it\nmust be the last column of the key (so the row-key encoding stays bounded for the\npreceding columns).",{"_12623":635,"_48290":605,"_18312":94809,"_5":17825,"_25222":94726,"_7710":94810},[48836],"All three BSON functions address fields with a small path syntax:",{"_12623":636,"_48290":605,"_18312":94812,"_5":17825,"_25222":94726,"_7710":94813},[48836],"name — top-level field",{"_12623":637,"_48290":605,"_18312":94815,"_5":17825,"_25222":94726,"_7710":94816},[48836],"addresses[0] — first element of an array",{"_12623":638,"_48290":605,"_18312":94818,"_5":17825,"_25222":94726,"_7710":94819},[48836],"addresses[0].city — nested field",{"_12623":639,"_48290":605,"_18312":94821,"_5":17825,"_25222":94726,"_7710":94822},[48836],"preferences.theme — nested field on a sub-document",{"_12623":640,"_48290":605,"_18312":94824,"_5":17825,"_25222":94730,"_7710":94825},[48836],"BSON_VALUE(bson_column, field_path, target_type [, default]) projects a single field\nout of a document and returns it as the requested Phoenix data type. Returns NULL if\nthe path is missing — or the supplied default if you provide one.",{"_12623":641,"_48290":605,"_18312":94827,"_5":17825,"_25222":94730,"_7710":94828},[48836],"BSON_VALUE can also return a sub-document (use 'BSON' as the target type) and\nreturn raw binary fields as VARBINARY_ENCODED. A companion function\nBSON_VALUE_TYPE(bson_column, field_path) returns the BSON type of the field as a\nstring (e.g. 'STRING', 'INT32', 'DOCUMENT', 'ARRAY').",{"_12623":642,"_48290":605,"_18312":94830,"_5":17825,"_25222":94734,"_7710":94831},[48836],"BSON_CONDITION_EXPRESSION(bson_column, expression) evaluates a boolean expression\nover a document and returns TRUE or FALSE. Use it in a WHERE clause when you\nwant to filter on multiple document fields at once, or test for the existence/shape\nof fields, without the verbosity of stacking multiple BSON_VALUE calls.",{"_12623":643,"_48290":605,"_18312":94833,"_5":17825,"_25222":94734,"_7710":94834},[48836],"The expression language is intentionally small and DynamoDB-flavored:",{"_12623":644,"_48290":605,"_18312":94836,"_5":17825,"_25222":94734,"_7710":94837},[48836],"Comparisons: =, <> (or !=), <, <=, >, >=",{"_12623":645,"_48290":605,"_18312":94839,"_5":17825,"_25222":94734,"_7710":94840},[48836],"Boolean composition: AND, OR, NOT, parentheses",{"_12623":646,"_48290":605,"_18312":94842,"_5":17825,"_25222":94734,"_7710":94843},[48836],"Ranges and sets: BETWEEN ... AND ..., IN (...), IS NULL",{"_12623":647,"_48290":605,"_18312":94845,"_5":17825,"_25222":94734,"_7710":94846},[48836],"Field presence: field_exists(name), field_not_exists(name)",{"_12623":648,"_48290":605,"_18312":94848,"_5":17825,"_25222":94734,"_7710":94849},[48836],"String/array helpers: begins_with(field, value), contains(field, value)",{"_12623":649,"_48290":605,"_18312":94851,"_5":17825,"_25222":94734,"_7710":94852},[48836],"Type and size: field_type(field, 'STRING' | 'NUMBER' | ...), size(field)",{"_12623":650,"_48290":605,"_18312":94854,"_5":17825,"_25222":94734,"_7710":94855},[48836],"The expression is evaluated server-side, so rows are filtered before they cross the\nnetwork.",{"_12623":651,"_48290":605,"_18312":94857,"_5":17825,"_25222":94738,"_7710":94858},[48836],"BSON_UPDATE_EXPRESSION(bson_column, expression) returns a new BSON document with\nthe requested mutations applied. The intended use is inside an\natomic upsert so an entire family of per-field updates\nruns under the row lock in a single round-trip:",{"_12623":652,"_48290":605,"_18312":94860,"_5":17825,"_25222":94738,"_7710":94861},[48836],"Supported update verbs follow the DynamoDB convention:",{"_12623":653,"_48290":605,"_18312":94863,"_5":17825,"_25222":94738,"_7710":94864},[48836],"SET path = value — write a field (or nested path).",{"_12623":654,"_48290":605,"_18312":94866,"_5":17825,"_25222":94738,"_7710":94867},[48836],"REMOVE path[, path ...] — delete a field.",{"_12623":655,"_48290":605,"_18312":94869,"_5":17825,"_25222":94738,"_7710":94870},[48836],"ADD path number — atomic numeric increment / decrement on a single field.",{"_12623":656,"_48290":605,"_18312":94872,"_5":17825,"_25222":94738,"_7710":94873},[48836],"DELETE path value — remove a value from an array/set field.",{"_12623":657,"_48290":605,"_18312":94875,"_5":17825,"_25222":94738,"_7710":94876},[48836],"if_not_exists(path, default) — read-then-write helper for conditional defaults.",{"_12623":658,"_48290":605,"_18312":94878,"_5":17825,"_25222":94738,"_7710":94879},[48836],"Because the update runs on the server under the row lock, this is the right primitive\nfor things like per-document counters, idempotent flag flips, and DynamoDB-style\nconditional writes (combine with BSON_CONDITION_EXPRESSION in a WHERE clause).",{"_12623":659,"_48290":605,"_18312":94881,"_5":17825,"_25222":94742,"_7710":94882},[48836],"To make a BSON-field filter fast, create a functional index on the projection:",{"_12623":660,"_48290":605,"_18312":94884,"_5":17825,"_25222":94742,"_7710":94885},[48836],"Combine with INCLUDE (...) to cover other projected columns, or rely on\nuncovered indexes when you only\nfilter on the indexed field.",{"_12623":661,"_48290":605,"_18312":94887,"_5":17825,"_25222":94746,"_7710":94888},[48836],"Putting the pieces together — a customer-preferences scenario backed entirely by a\nsingle BSON column:",{"_12623":662,"_48290":605,"_18312":94890,"_5":17825,"_25222":94750,"_7710":94891},[48836],"A BSON column in a composite primary key must be the last PK column.",{"_12623":663,"_48290":605,"_18312":94893,"_5":17825,"_25222":94750,"_7710":94894},[48836],"The condition/update expression language is intentionally a small document-focused\nDSL, not full SQL. Combine it with regular SQL predicates on relational columns when\nyou need joins, aggregations, or expressions across multiple rows.",{"_12623":664,"_48290":605,"_18312":94896,"_5":17825,"_25222":94750,"_7710":94897},[48836],"Functional indexes on BSON_VALUE(...) are scoped to one specific path/type pair —\nyou'll typically want an index per hot field rather than a generic \"BSON index\".",{"_12623":665,"_48290":665,"_5":13058,"_7710":94899,"_48807":94900,"_18312":94901,"_25222":665},"Bulk Loading",[92880,92881,92882,94570],[48836],{"_12623":666,"_48290":665,"_18312":94903,"_5":17825,"_25222":665,"_7710":94904},[48836],"Load Phoenix tables with PSQL and MapReduce-based CSV/JSON bulk loaders, including options, permissions, and tuning notes.",{"_12623":667,"_48290":665,"_5":48804,"_18312":94906,"_25222":94907,"_7710":94908},[48836],"/docs/features/bulk-loading#sample-data","Sample data",{"_12623":668,"_48290":665,"_5":48804,"_18312":94910,"_25222":94911,"_7710":94912},[48836],"/docs/features/bulk-loading#loading-via-psql","Loading via PSQL",{"_12623":669,"_48290":665,"_5":48804,"_18312":94914,"_25222":94915,"_7710":94916},[48836],"/docs/features/bulk-loading#loading-via-mapreduce","Loading via MapReduce",{"_12623":670,"_48290":665,"_5":48804,"_18312":94918,"_25222":94919,"_7710":94920},[48836],"/docs/features/bulk-loading#notes-on-the-mapreduce-importer","Notes on the MapReduce importer",{"_12623":671,"_48290":665,"_5":48804,"_18312":94922,"_25222":94923,"_7710":94924},[48836],"/docs/features/bulk-loading#permission-issues-when-uploading-hfiles","Permission issues when uploading HFiles",{"_12623":672,"_48290":665,"_5":48804,"_18312":94926,"_25222":94927,"_7710":94928},[48836],"/docs/features/bulk-loading#loading-array-data","Loading array data",{"_12623":673,"_48290":665,"_5":48804,"_18312":94930,"_25222":94931,"_7710":94932},[48836],"/docs/features/bulk-loading#a-note-on-separator-characters","A note on separator characters",{"_12623":674,"_48290":665,"_5":48804,"_18312":94934,"_25222":94935,"_7710":94936},[48836],"/docs/features/bulk-loading#a-note-on-lowercase-tableschema-names","A note on lowercase table/schema names",{"_12623":675,"_48290":665,"_18312":94938,"_5":17825,"_25222":665,"_7710":94939},[48836],"Phoenix provides two methods for bulk loading data into Phoenix tables:",{"_12623":676,"_48290":665,"_18312":94941,"_5":17825,"_25222":665,"_7710":94942},[48836],"Single-threaded client loading tool for CSV-formatted data via the psql command",{"_12623":677,"_48290":665,"_18312":94944,"_5":17825,"_25222":665,"_7710":94945},[48836],"MapReduce-based bulk load tool for CSV and JSON-formatted data",{"_12623":678,"_48290":665,"_18312":94947,"_5":17825,"_25222":665,"_7710":94948},[48836],"The psql tool is typically appropriate for tens of megabytes, while the MapReduce-based loader is typically better for larger load volumes.",{"_12623":679,"_48290":665,"_18312":94950,"_5":17825,"_25222":94907,"_7710":94951},[48836],"For the following examples, assume we have a CSV file named data.csv with this content:",{"_12623":680,"_48290":665,"_18312":94953,"_5":17825,"_25222":94907,"_7710":94954},[48836],"We will use a table with the following structure:",{"_12623":681,"_48290":665,"_18312":94956,"_5":17825,"_25222":94911,"_7710":94957},[48836],"The psql command is invoked via psql.py in the Phoenix bin directory. To load CSV data, provide connection information for your HBase cluster, the target table name, and one or more CSV file paths. All CSV files must use the .csv extension (because arbitrary SQL scripts with the .sql extension can also be supplied on the psql command line).",{"_12623":682,"_48290":665,"_18312":94959,"_5":17825,"_25222":94911,"_7710":94960},[48836],"To load the example data above into HBase running locally:",{"_12623":683,"_48290":665,"_18312":94962,"_5":17825,"_25222":94911,"_7710":94963},[48836],"The following parameters can be used for loading data with psql:",{"_12623":684,"_48290":665,"_18312":94965,"_5":17825,"_25222":94911,"_7710":94966},[48836],"Parameter",{"_12623":685,"_48290":665,"_18312":94968,"_5":17825,"_25222":94911,"_7710":94969},[48836],"Description",{"_12623":686,"_48290":665,"_18312":94971,"_5":17825,"_25222":94911,"_7710":47418},[48836],{"_12623":687,"_48290":665,"_18312":94973,"_5":17825,"_25222":94911,"_7710":94974},[48836],"Provide the target table name. By default, the table name is taken from the CSV file name. This parameter is case-sensitive.",{"_12623":688,"_48290":665,"_18312":94976,"_5":17825,"_25222":94911,"_7710":47467},[48836],{"_12623":689,"_48290":665,"_18312":94978,"_5":17825,"_25222":94911,"_7710":94979},[48836],"Override the column names to which CSV data maps (case-sensitive). A special value of in-line indicates that the first line of the CSV file determines column mapping.",{"_12623":690,"_48290":665,"_18312":94981,"_5":17825,"_25222":94911,"_7710":47482},[48836],{"_12623":691,"_48290":665,"_18312":94983,"_5":17825,"_25222":94911,"_7710":94984},[48836],"Run in strict mode, throwing an error on CSV parsing errors.",{"_12623":692,"_48290":665,"_18312":94986,"_5":17825,"_25222":94911,"_7710":47277},[48836],{"_12623":693,"_48290":665,"_18312":94988,"_5":17825,"_25222":94911,"_7710":94989},[48836],"Supply one or more custom delimiters for CSV parsing.",{"_12623":694,"_48290":665,"_18312":94991,"_5":17825,"_25222":94911,"_7710":47525},[48836],{"_12623":695,"_48290":665,"_18312":94993,"_5":17825,"_25222":94911,"_7710":94994},[48836],"Supply a custom phrase delimiter (defaults to the double quote character).",{"_12623":696,"_48290":665,"_18312":94996,"_5":17825,"_25222":94911,"_7710":47532},[48836],{"_12623":697,"_48290":665,"_18312":94998,"_5":17825,"_25222":94911,"_7710":94999},[48836],"Supply a custom escape character (default is backslash).",{"_12623":698,"_48290":665,"_18312":95001,"_5":17825,"_25222":94911,"_7710":47545},[48836],{"_12623":699,"_48290":665,"_18312":95003,"_5":17825,"_25222":94911,"_7710":95004},[48836],"Supply an array delimiter (explained in more detail below).",{"_12623":700,"_48290":665,"_18312":95006,"_5":17825,"_25222":94915,"_7710":95007},[48836],"For higher-throughput loading distributed across the cluster, the MapReduce loader can be used. This loader first converts data into HFiles, then provides the created HFiles to HBase after HFile creation completes.",{"_12623":701,"_48290":665,"_18312":95009,"_5":17825,"_25222":94915,"_7710":95010},[48836],"The CSV MapReduce loader is launched using the hadoop command with the Phoenix client JAR:",{"_12623":702,"_48290":665,"_18312":95012,"_5":17825,"_25222":94915,"_7710":95013},[48836],"When using Phoenix 4.0 and above, there is a known HBase issue (\"Notice to MapReduce users of HBase 0.96.1 and above\" in the HBase Reference Guide). You should use:",{"_12623":703,"_48290":665,"_18312":95015,"_5":17825,"_25222":94915,"_7710":95016},[48836],"Or:",{"_12623":704,"_48290":665,"_18312":95018,"_5":17825,"_25222":94915,"_7710":95019},[48836],"The JSON MapReduce loader is launched similarly:",{"_12623":705,"_48290":665,"_18312":95021,"_5":17825,"_25222":94915,"_7710":95022},[48836],"The input file must be present on HDFS (not the local filesystem where the command is run).",{"_12623":706,"_48290":665,"_18312":95024,"_5":17825,"_25222":94915,"_7710":95025},[48836],"The following parameters can be used with the MapReduce loader:",{"_12623":707,"_48290":665,"_18312":95027,"_5":17825,"_25222":94915,"_7710":94966},[48836],{"_12623":708,"_48290":665,"_18312":95029,"_5":17825,"_25222":94915,"_7710":94969},[48836],{"_12623":709,"_48290":665,"_18312":95031,"_5":17825,"_25222":94915,"_7710":95032},[48836],"-i,--input",{"_12623":710,"_48290":665,"_18312":95034,"_5":17825,"_25222":94915,"_7710":95035},[48836],"Input CSV path (mandatory)",{"_12623":711,"_48290":665,"_18312":95037,"_5":17825,"_25222":94915,"_7710":95038},[48836],"-t,--table",{"_12623":712,"_48290":665,"_18312":95040,"_5":17825,"_25222":94915,"_7710":95041},[48836],"Phoenix table name (mandatory)",{"_12623":713,"_48290":665,"_18312":95043,"_5":17825,"_25222":94915,"_7710":95044},[48836],"-a,--array-delimiter",{"_12623":714,"_48290":665,"_18312":95046,"_5":17825,"_25222":94915,"_7710":95047},[48836],"Array element delimiter (optional)",{"_12623":715,"_48290":665,"_18312":95049,"_5":17825,"_25222":94915,"_7710":95050},[48836],"-c,--import-columns",{"_12623":716,"_48290":665,"_18312":95052,"_5":17825,"_25222":94915,"_7710":95053},[48836],"Comma-separated list of columns to import",{"_12623":717,"_48290":665,"_18312":95055,"_5":17825,"_25222":94915,"_7710":95056},[48836],"-d,--delimiter",{"_12623":718,"_48290":665,"_18312":95058,"_5":17825,"_25222":94915,"_7710":95059},[48836],"Input delimiter (defaults to comma)",{"_12623":719,"_48290":665,"_18312":95061,"_5":17825,"_25222":94915,"_7710":95062},[48836],"-g,--ignore-errors",{"_12623":720,"_48290":665,"_18312":95064,"_5":17825,"_25222":94915,"_7710":95065},[48836],"Ignore input errors",{"_12623":721,"_48290":665,"_18312":95067,"_5":17825,"_25222":94915,"_7710":95068},[48836],"-o,--output",{"_12623":722,"_48290":665,"_18312":95070,"_5":17825,"_25222":94915,"_7710":95071},[48836],"Output path for temporary HFiles (optional)",{"_12623":723,"_48290":665,"_18312":95073,"_5":17825,"_25222":94915,"_7710":95074},[48836],"-s,--schema",{"_12623":724,"_48290":665,"_18312":95076,"_5":17825,"_25222":94915,"_7710":95077},[48836],"Phoenix schema name (optional)",{"_12623":725,"_48290":665,"_18312":95079,"_5":17825,"_25222":94915,"_7710":95080},[48836],"-z,--zookeeper",{"_12623":726,"_48290":665,"_18312":95082,"_5":17825,"_25222":94915,"_7710":95083},[48836],"ZooKeeper quorum to connect to (optional)",{"_12623":727,"_48290":665,"_18312":95085,"_5":17825,"_25222":94915,"_7710":95086},[48836],"-it,--index-table",{"_12623":728,"_48290":665,"_18312":95088,"_5":17825,"_25222":94915,"_7710":95089},[48836],"Index table name to load (optional)",{"_12623":729,"_48290":665,"_18312":95091,"_5":17825,"_25222":94919,"_7710":95092},[48836],"The current MR-based bulk loader runs one MR job to load your data table and one MR job per index table to populate indexes. Use -it to load only one index table.",{"_12623":730,"_48290":665,"_18312":95094,"_5":17825,"_25222":94923,"_7710":95095},[48836],"There can be issues due to file permissions on created HFiles in the final stage of a bulk load, when HFiles are handed over to HBase. HBase must be able to move the created HFiles, which means it needs write access to the directories where files were written. If not, HFile upload may hang for a long time before failing.",{"_12623":731,"_48290":665,"_18312":95097,"_5":17825,"_25222":94923,"_7710":95098},[48836],"Two common workarounds are:",{"_12623":732,"_48290":665,"_18312":95100,"_5":17825,"_25222":94923,"_7710":95101},[48836],"Run the bulk load process as the hbase user.",{"_12623":733,"_48290":665,"_18312":95103,"_5":17825,"_25222":94923,"_7710":95104},[48836],"Create output files readable/writable for all users.",{"_12623":734,"_48290":665,"_18312":95106,"_5":17825,"_25222":94923,"_7710":95107},[48836],"The first option can be done by running:",{"_12623":735,"_48290":665,"_18312":95109,"_5":17825,"_25222":94923,"_7710":95110},[48836],"Creating output files readable by all can be done by setting fs.permissions.umask-mode to 000. This can be set in Hadoop config on the submit host, or only for job submission:",{"_12623":736,"_48290":665,"_18312":95112,"_5":17825,"_25222":94927,"_7710":95113},[48836],"Both PSQL and MapReduce loaders support array values with -a. Arrays in CSV are represented by a field that uses a different delimiter than the main CSV delimiter. For example, this file represents an id field and an array of integers:",{"_12623":737,"_48290":665,"_18312":95115,"_5":17825,"_25222":94927,"_7710":95116},[48836],"To load this file, use the default CSV delimiter (comma) and pass colon as the array delimiter via -a ':'.",{"_12623":738,"_48290":665,"_18312":95118,"_5":17825,"_25222":94931,"_7710":95119},[48836],"The default separator for both loaders is comma (,). A common separator for input files is tab, which can be tricky to pass on the command line. A common mistake is:",{"_12623":739,"_48290":665,"_18312":95121,"_5":17825,"_25222":94931,"_7710":95122},[48836],"This does not work because the shell passes two characters (backslash and t) to Phoenix.",{"_12623":740,"_48290":665,"_18312":95124,"_5":17825,"_25222":94931,"_7710":95125},[48836],"Two working approaches:",{"_12623":741,"_48290":665,"_18312":95127,"_5":17825,"_25222":94931,"_7710":95128},[48836],"Prefix the string representation of tab with $:",{"_12623":742,"_48290":665,"_18312":95130,"_5":17825,"_25222":94931,"_7710":95131},[48836],"Enter the separator as Ctrl+v and then press tab:",{"_12623":743,"_48290":665,"_18312":95133,"_5":17825,"_25222":94935,"_7710":95134},[48836],"Table names in Phoenix are case-insensitive (generally uppercase), but users may need to map an existing lowercase HBase table name into Phoenix. In this case, double quotes around the table name (for example, \"tablename\") preserve case sensitivity.",{"_12623":744,"_48290":665,"_18312":95136,"_5":17825,"_25222":94935,"_7710":95137},[48836],"This support was extended to bulk load options. However, due to how Apache Commons CLI parses command-line options (CLI-275), pass the argument as \\\"\\\"tablename\\\"\\\" instead of just \"tablename\" for CsvBulkLoadTool.",{"_12623":745,"_48290":665,"_18312":95139,"_5":17825,"_25222":94935,"_7710":94470},[48836],{"_12623":746,"_48290":746,"_5":13058,"_7710":95141,"_48807":95142,"_18312":95143,"_25222":746},"Change Data Capture (CDC)",[92880,92881,92882,94570],[48836],{"_12623":747,"_48290":746,"_18312":95145,"_5":17825,"_25222":746,"_7710":95146},[48836],"Query row-level change events on a Phoenix table using standard SQL — pull pre/post images and change deltas with bounded, resumable reads.",{"_12623":748,"_48290":746,"_5":48804,"_18312":95148,"_25222":95149,"_7710":95150},[48836],"/docs/features/change-data-capture#cdc-when","When to use it",{"_12623":749,"_48290":746,"_5":48804,"_18312":95152,"_25222":95153,"_7710":95154},[48836],"/docs/features/change-data-capture#cdc-enable","Enabling CDC on a table",{"_12623":750,"_48290":746,"_5":48804,"_18312":95156,"_25222":95157,"_7710":95158},[48836],"/docs/features/change-data-capture#cdc-read","Reading change events",{"_12623":751,"_48290":746,"_5":48804,"_18312":95160,"_25222":95161,"_7710":95162},[48836],"/docs/features/change-data-capture#time-bounded--incremental-reads","Time-bounded / incremental reads",{"_12623":752,"_48290":746,"_5":48804,"_18312":95164,"_25222":95165,"_7710":95166},[48836],"/docs/features/change-data-capture#per-partition-reads","Per-partition reads",{"_12623":753,"_48290":746,"_5":48804,"_18312":95168,"_25222":95169,"_7710":95170},[48836],"/docs/features/change-data-capture#cdc-lineage","Stream lineage: partitions, splits, and merges",{"_12623":754,"_48290":746,"_5":48804,"_18312":95172,"_25222":95173,"_7710":95174},[48836],"/docs/features/change-data-capture#consuming-events-in-parent--child-order","Consuming events in parent → child order",{"_12623":755,"_48290":746,"_5":48804,"_18312":95176,"_25222":95177,"_7710":95178},[48836],"/docs/features/change-data-capture#cdc-special-events","Special event types",{"_12623":756,"_48290":746,"_5":48804,"_18312":95180,"_25222":95181,"_7710":95182},[48836],"/docs/features/change-data-capture#cdc-ops","Operational notes",{"_12623":757,"_48290":746,"_18312":95184,"_5":17825,"_25222":746,"_7710":95185},[48836],"Change Data Capture turns a Phoenix table into a stream of change events that\ndownstream consumers can read using regular SQL. Once enabled, a CDC object behaves\nlike a queryable Phoenix table: every insert, update, and delete on the underlying\ndata table produces a row containing the affected primary key, an event timestamp,\nand a JSON payload describing what changed. Available in Phoenix 5.3.0\n(PHOENIX-7001).",{"_12623":758,"_48290":746,"_18312":95187,"_5":17825,"_25222":95149,"_7710":95188},[48836],"Reach for CDC when something downstream needs to react to row-level changes:",{"_12623":759,"_48290":746,"_18312":95190,"_5":17825,"_25222":95149,"_7710":95191},[48836],"Replication or mirroring to another store (Kafka, search index, data warehouse).",{"_12623":760,"_48290":746,"_18312":95193,"_5":17825,"_25222":95149,"_7710":95194},[48836],"Audit logs and change history.",{"_12623":761,"_48290":746,"_18312":95196,"_5":17825,"_25222":95149,"_7710":95197},[48836],"Cache invalidation and event-driven workflows.",{"_12623":762,"_48290":746,"_18312":95199,"_5":17825,"_25222":95149,"_7710":95200},[48836],"Materialized projections / fan-out tables maintained by an external process.",{"_12623":763,"_48290":746,"_18312":95202,"_5":17825,"_25222":95149,"_7710":95203},[48836],"CDC captures the actual mutations as they happen — including TTL-driven row\ndeletes — so consumers don't need to poll the data table or compute diffs.",{"_12623":764,"_48290":746,"_18312":95205,"_5":17825,"_25222":95153,"_7710":95206},[48836],"Use CREATE CDC to enable change capture on an existing table:",{"_12623":765,"_48290":746,"_18312":95208,"_5":17825,"_25222":95153,"_7710":95209},[48836],"The INCLUDE clause sets the default scopes that appear in the JSON payload.\nAvailable scopes:",{"_12623":766,"_48290":746,"_18312":95211,"_5":17825,"_25222":95153,"_7710":95212},[48836],"Scope",{"_12623":767,"_48290":746,"_18312":95214,"_5":17825,"_25222":95153,"_7710":95215},[48836],"Meaning",{"_12623":768,"_48290":746,"_18312":95217,"_5":17825,"_25222":95153,"_7710":95218},[48836],"PRE",{"_12623":769,"_48290":746,"_18312":95220,"_5":17825,"_25222":95153,"_7710":95221},[48836],"Row image before the mutation.",{"_12623":770,"_48290":746,"_18312":95223,"_5":17825,"_25222":95153,"_7710":95224},[48836],"POST",{"_12623":771,"_48290":746,"_18312":95226,"_5":17825,"_25222":95153,"_7710":95227},[48836],"Row image after the mutation.",{"_12623":772,"_48290":746,"_18312":95229,"_5":17825,"_25222":95153,"_7710":95230},[48836],"CHANGE",{"_12623":773,"_48290":746,"_18312":95232,"_5":17825,"_25222":95153,"_7710":95233},[48836],"Just the changed columns (diff).",{"_12623":774,"_48290":746,"_18312":95235,"_5":17825,"_25222":95153,"_7710":95236},[48836],"Standard CREATE INDEX–style table properties on CREATE CDC (SALT_BUCKETS,\nUPDATE_CACHE_FREQUENCY, COLUMN_ENCODED_BYTES, etc.) are forwarded to the\nunderlying CDC index.",{"_12623":775,"_48290":746,"_18312":95238,"_5":17825,"_25222":95153,"_7710":95239},[48836],"To remove CDC from a table:",{"_12623":776,"_48290":746,"_18312":95241,"_5":17825,"_25222":95157,"_7710":95242},[48836],"Each CDC object behaves like a Phoenix table whose columns are:",{"_12623":777,"_48290":746,"_18312":95244,"_5":17825,"_25222":95157,"_7710":95245},[48836],"The data table's primary-key columns (so you know which row changed).",{"_12623":778,"_48290":746,"_18312":95247,"_5":17825,"_25222":95157,"_7710":95248},[48836],"A payload column literally named \"CDC JSON\" (case-sensitive, must be quoted).\nProject it whenever you need the change payload; omit it for lightweight queries\nthat only care about which rows changed or for topology lookups. SELECT *\nincludes it automatically.",{"_12623":779,"_48290":746,"_18312":95250,"_5":17825,"_25222":95157,"_7710":95251},[48836],"Two helpers come along for the ride:",{"_12623":780,"_48290":746,"_18312":95253,"_5":17825,"_25222":95157,"_7710":95254},[48836],"PHOENIX_ROW_TIMESTAMP() — the event's timestamp; use it for ordering and time-\nbounded reads.",{"_12623":781,"_48290":746,"_18312":95256,"_5":17825,"_25222":95157,"_7710":95257},[48836],"PARTITION_ID() — the partition the event came from; useful for sharding consumer\nworkers.",{"_12623":782,"_48290":746,"_18312":95259,"_5":17825,"_25222":95157,"_7710":95260},[48836],"A typical read query that wants the full payload looks like this:",{"_12623":783,"_48290":746,"_18312":95262,"_5":17825,"_25222":95157,"_7710":95263},[48836],"The CDC_INCLUDE(...) query hint overrides the default scopes set at CREATE\nCDC time — so the same CDC object can serve different downstream consumers, each\nasking for only the scope they need. Without the hint, the payload uses the\nINCLUDE scopes from the CREATE CDC statement.",{"_12623":784,"_48290":746,"_18312":95265,"_5":17825,"_25222":95161,"_7710":95266},[48836],"Use PHOENIX_ROW_TIMESTAMP() predicates to pull only events within a window —\nconsumers typically remember the last timestamp they processed and bind it as the\nlower bound on the next call:",{"_12623":785,"_48290":746,"_18312":95268,"_5":17825,"_25222":95165,"_7710":95269},[48836],"Partitions track HBase regions of the data table, so you can shard a consumer pool\nacross them. Discover partitions with:",{"_12623":786,"_48290":746,"_18312":95271,"_5":17825,"_25222":95165,"_7710":95272},[48836],"Then issue per-partition reads:",{"_12623":787,"_48290":746,"_18312":95274,"_5":17825,"_25222":95169,"_7710":95275},[48836],"A CDC stream is logically a set of partitions, each carrying a totally-ordered\nsequence of change events. A partition isn't an abstract shard — it corresponds to a\nspecific HBase region of the data table at a point in time, and it has a finite\nlifetime: it's born when the region is created (or as the result of a split/merge)\nand it's closed when that region itself splits or merges into something new. New\nchild partitions take over from there.",{"_12623":788,"_48290":746,"_18312":95277,"_5":17825,"_25222":95169,"_7710":95278},[48836],"Phoenix tracks this topology in SYSTEM.CDC_STREAM. The schema makes the lineage\nexplicit — every partition row points at its parent partition(s):",{"_12623":789,"_48290":746,"_18312":95280,"_5":17825,"_25222":95169,"_7710":95281},[48836],"Column",{"_12623":790,"_48290":746,"_18312":95283,"_5":17825,"_25222":95169,"_7710":95284},[48836],"Notes",{"_12623":791,"_48290":746,"_18312":95286,"_5":17825,"_25222":95169,"_7710":95287},[48836],"TABLE_NAME",{"_12623":792,"_48290":746,"_18312":95289,"_5":17825,"_25222":95169,"_7710":95290},[48836],"The data table whose changes are streamed.",{"_12623":793,"_48290":746,"_18312":95292,"_5":17825,"_25222":95169,"_7710":95293},[48836],"STREAM_NAME",{"_12623":794,"_48290":746,"_18312":95295,"_5":17825,"_25222":95169,"_7710":95296},[48836],"The CDC stream (each CREATE CDC produces a uniquely-named stream).",{"_12623":795,"_48290":746,"_18312":95298,"_5":17825,"_25222":95169,"_7710":95299},[48836],"PARTITION_ID",{"_12623":796,"_48290":746,"_18312":95301,"_5":17825,"_25222":95169,"_7710":95302},[48836],"This partition's id — same value PARTITION_ID() returns on a CDC row.",{"_12623":797,"_48290":746,"_18312":95304,"_5":17825,"_25222":95169,"_7710":95305},[48836],"PARENT_PARTITION_ID",{"_12623":798,"_48290":746,"_18312":95307,"_5":17825,"_25222":95169,"_7710":95308},[48836],"The parent partition's id (empty/null for the initial partitions present when CDC was first enabled).",{"_12623":799,"_48290":746,"_18312":95310,"_5":17825,"_25222":95169,"_7710":95311},[48836],"PARTITION_START_TIME",{"_12623":800,"_48290":746,"_18312":95313,"_5":17825,"_25222":95169,"_7710":95314},[48836],"When this partition began.",{"_12623":801,"_48290":746,"_18312":95316,"_5":17825,"_25222":95169,"_7710":95317},[48836],"PARTITION_END_TIME",{"_12623":802,"_48290":746,"_18312":95319,"_5":17825,"_25222":95169,"_7710":95320},[48836],"When it was closed (a split or merge ended it). NULL while still active.",{"_12623":803,"_48290":746,"_18312":95322,"_5":17825,"_25222":95169,"_7710":95323},[48836],"PARTITION_START_KEY / _END_KEY",{"_12623":804,"_48290":746,"_18312":95325,"_5":17825,"_25222":95169,"_7710":95326},[48836],"The HBase region's row-key bounds at the time, stored as VARBINARY_ENCODED.",{"_12623":805,"_48290":746,"_18312":95328,"_5":17825,"_25222":95169,"_7710":95329},[48836],"PARENT_PARTITION_START_TIME",{"_12623":806,"_48290":746,"_18312":95331,"_5":17825,"_25222":95169,"_7710":95332},[48836],"The parent partition's PARTITION_START_TIME, embedded so consumers can walk parent → child without an extra join.",{"_12623":807,"_48290":746,"_18312":95334,"_5":17825,"_25222":95169,"_7710":95335},[48836],"Two important shapes fall out of this model:",{"_12623":808,"_48290":746,"_18312":95337,"_5":17825,"_25222":95169,"_7710":95338},[48836],"A split produces two child rows that share the same PARENT_PARTITION_ID (the\nregion that just split). Their key ranges together cover the parent's range.",{"_12623":809,"_48290":746,"_18312":95340,"_5":17825,"_25222":95169,"_7710":95341},[48836],"A merge produces one child partition with multiple rows in SYSTEM.CDC_STREAM —\none row per parent — sharing the same PARTITION_ID and differing only in\nPARENT_PARTITION_ID. Together those rows record every parent that fed the merge.",{"_12623":810,"_48290":746,"_18312":95343,"_5":17825,"_25222":95173,"_7710":95344},[48836],"Because events from a parent partition causally precede events from any of its\nchildren, a correct consumer must drain the parent before reading children that\ndescend from it. The pattern is:",{"_12623":811,"_48290":746,"_18312":95346,"_5":17825,"_25222":95173,"_7710":95347},[48836],"Discover the topology by reading SYSTEM.CDC_STREAM for your table and\nstream. Build a DAG keyed by PARTITION_ID, with edges drawn from\nPARENT_PARTITION_ID → child PARTITION_ID. Roots are partitions with no\nparent (the regions present when CDC was first enabled).",{"_12623":812,"_48290":746,"_18312":95349,"_5":17825,"_25222":95173,"_7710":95350},[48836],"Process roots first, then walk forward through the DAG. A child partition is\nready to be consumed once all of its parents have been fully drained — for\nmerges, that means all rows in SYSTEM.CDC_STREAM with the same child\nPARTITION_ID have had their parent partitions processed.",{"_12623":813,"_48290":746,"_18312":95352,"_5":17825,"_25222":95173,"_7710":95353},[48836],"For each partition, query the CDC object scoped to that partition and the\ntime window the partition was live:",{"_12623":814,"_48290":746,"_18312":95355,"_5":17825,"_25222":95173,"_7710":95356},[48836],"Re-poll the topology periodically. New rows appear in SYSTEM.CDC_STREAM\nwhen regions split or merge; consumers refresh their DAG to pick up the new\nchildren before existing partitions close.",{"_12623":815,"_48290":746,"_18312":95358,"_5":17825,"_25222":95173,"_7710":95359},[48836],"This is the same shard-lineage model used by DynamoDB Streams — if you're porting a\nDynamoDB Streams consumer, the bookkeeping translates almost directly.",{"_12623":816,"_48290":746,"_18312":95361,"_5":17825,"_25222":95177,"_7710":95362},[48836],"TTL-driven deletes (rows aged out by time-based or\nconditional TTL) produce CDC events alongside\napplication-issued mutations, so consumers don't have to reconcile retention-driven\nremovals separately.",{"_12623":817,"_48290":746,"_18312":95364,"_5":17825,"_25222":95177,"_7710":95365},[48836],"ARRAY and JSON columns in the data table are serialized as simple values\ninside the \"CDC JSON\" payload.",{"_12623":818,"_48290":746,"_18312":95367,"_5":17825,"_25222":95177,"_7710":95368},[48836],"Case-sensitive identifiers on the data table and its primary-key columns are\npreserved end to end in events.",{"_12623":819,"_48290":746,"_18312":95370,"_5":17825,"_25222":95181,"_7710":95371},[48836],"When the underlying data table is dropped, its CDC stream metadata in\nSYSTEM.CDC_STREAM is cleaned up automatically — you don't have to drop the CDC\nobject first.",{"_12623":820,"_48290":746,"_18312":95373,"_5":17825,"_25222":95181,"_7710":95374},[48836],"The CDC object is internally backed by a partitioned secondary index on the data\ntable, but it's not used to satisfy regular queries against the data table —\nthere's no read penalty on the data table from enabling CDC.",{"_12623":821,"_48290":746,"_18312":95376,"_5":17825,"_25222":95181,"_7710":95377},[48836],"Re-creating CDC after a drop produces a distinct stream (the stream name is\naugmented with creation time), so consumers can detect the boundary and reset\ntheir offsets cleanly.",{"_12623":822,"_48290":822,"_5":13058,"_7710":95379,"_48807":95380,"_18312":95381,"_25222":822},"Conditional TTL",[92880,92881,92882,94570],[48836],{"_12623":823,"_48290":822,"_18312":95383,"_5":17825,"_25222":822,"_7710":95384},[48836],"Express row expiration as a SQL boolean expression evaluated against the row itself.",{"_12623":824,"_48290":822,"_5":48804,"_18312":95386,"_25222":95387,"_7710":95150},[48836],"/docs/features/conditional-ttl#conditional-ttl-when",{"_12623":825,"_48290":822,"_5":48804,"_18312":95389,"_25222":95390,"_7710":95391},[48836],"/docs/features/conditional-ttl#conditional-ttl-define","Defining a conditional TTL",{"_12623":826,"_48290":822,"_5":48804,"_18312":95393,"_25222":95394,"_7710":95395},[48836],"/docs/features/conditional-ttl#conditional-ttl-write-path","Effect on the write path",{"_12623":827,"_48290":822,"_5":48804,"_18312":95397,"_25222":95398,"_7710":93002},[48836],"/docs/features/conditional-ttl#conditional-ttl-limitations",{"_12623":828,"_48290":822,"_18312":95400,"_5":17825,"_25222":822,"_7710":95401},[48836],"Conditional TTL lets you express row expiration as a SQL boolean expression\nevaluated against the row's own column values, instead of a fixed time-since-write\nnumber. A row is considered expired the moment the expression evaluates to TRUE for\nthat row. Available in Phoenix 5.3.0\n(PHOENIX-7170).",{"_12623":829,"_48290":822,"_18312":95403,"_5":17825,"_25222":95387,"_7710":95404},[48836],"Conditional TTL fits whenever \"expired\" is an application concept, not just an\nage. Some typical cases:",{"_12623":830,"_48290":822,"_18312":95406,"_5":17825,"_25222":95387,"_7710":95407},[48836],"\"Delete this row 30 days after STATUS becomes 'CLOSED'.\"",{"_12623":831,"_48290":822,"_18312":95409,"_5":17825,"_25222":95387,"_7710":95410},[48836],"\"Expire when RETAIN_UNTIL has passed.\"",{"_12623":832,"_48290":822,"_18312":95412,"_5":17825,"_25222":95387,"_7710":95413},[48836],"\"Keep failed records for a week, successful ones for an hour.\"",{"_12623":833,"_48290":822,"_18312":95415,"_5":17825,"_25222":95387,"_7710":95416},[48836],"\"Expire soft-deleted rows (is_deleted = TRUE) after a grace period.\"",{"_12623":834,"_48290":822,"_18312":95418,"_5":17825,"_25222":95387,"_7710":95419},[48836],"If retention is a flat duration that applies uniformly to all rows, use the regular\ntime-based TTL property. If different views over the same shared table need\ndifferent retention rules, look at View TTL — it composes\nwith conditional TTL.",{"_12623":835,"_48290":822,"_18312":95421,"_5":17825,"_25222":95390,"_7710":95422},[48836],"Pass a SQL boolean expression as the TTL table property at CREATE TABLE (or\nCREATE VIEW) time. The expression may reference any column of the table:",{"_12623":836,"_48290":822,"_18312":95424,"_5":17825,"_25222":95390,"_7710":95425},[48836],"Update or remove the expression later with ALTER TABLE:",{"_12623":837,"_48290":822,"_18312":95427,"_5":17825,"_25222":95390,"_7710":95428},[48836],"What \"expired\" means in practice:",{"_12623":838,"_48290":822,"_18312":95430,"_5":17825,"_25222":95390,"_7710":95431},[48836],"Read-time: any query touching the row evaluates the TTL expression server-side\nand skips the row if it returns TRUE. Rows become invisible the moment they\nmatch the predicate, regardless of physical state.",{"_12623":839,"_48290":822,"_18312":95433,"_5":17825,"_25222":95390,"_7710":95434},[48836],"Phoenix compaction: expired rows are physically removed by Phoenix's\ncompaction during HBase region compactions. There is no separate cleanup job —\nphysical removal happens whenever the underlying regions compact.",{"_12623":840,"_48290":822,"_18312":95436,"_5":17825,"_25222":95394,"_7710":95437},[48836],"IS_STRICT_TTL is a table property that applies to any kind of TTL — see\nStrict vs Relaxed TTL for the full\ndescription.",{"_12623":841,"_48290":822,"_18312":95439,"_5":17825,"_25222":95394,"_7710":95440},[48836],"The conditional-TTL-specific cost is in the write path: with strict (the\ndefault), every mutation reads the current row state on the server to evaluate the\nTTL expression, which adds latency. With relaxed (IS_STRICT_TTL = false), that\nextra row read is skipped — at the cost of expired rows remaining visible to\nreaders until major compaction physically removes them.",{"_12623":842,"_48290":822,"_18312":95442,"_5":17825,"_25222":95398,"_7710":95443},[48836],"Conditional TTL requires the table to have a single column family.",{"_12623":843,"_48290":822,"_18312":95445,"_5":17825,"_25222":95398,"_7710":95446},[48836],"The TTL expression must be a valid Phoenix SQL boolean expression and may only\nreference columns of the same table — no joins, no subqueries.",{"_12623":844,"_48290":822,"_18312":95448,"_5":17825,"_25222":95398,"_7710":95449},[48836],"The classic time-based TTL = N (seconds) and conditional TTL = '<expr>' use the\nsame property; what you pass in determines which mode you get. You can't have both\nat once.",{"_12623":845,"_48290":845,"_5":13058,"_7710":95451,"_48807":95452,"_18312":95453,"_25222":845},"Cursor",[92880,92881,92882,94570],[48836],{"_12623":846,"_48290":845,"_18312":95455,"_5":17825,"_25222":845,"_7710":95456},[48836],"Use CURSOR statements in Phoenix to process query results in controlled row batches.",{"_12623":847,"_48290":845,"_5":48804,"_18312":95458,"_25222":95459,"_7710":95460},[48836],"/docs/features/cursor#using-a-cursor","Using a cursor",{"_12623":848,"_48290":845,"_18312":95462,"_5":17825,"_25222":845,"_7710":95463},[48836],"To work on a subset of rows from a query, Phoenix supports a CURSOR control structure. The sequence below shows how to use a cursor.",{"_12623":849,"_48290":845,"_18312":95465,"_5":17825,"_25222":95459,"_7710":95466},[48836],"Define a cursor for a query using the DECLARE statement.",{"_12623":850,"_48290":845,"_18312":95468,"_5":17825,"_25222":95459,"_7710":95469},[48836],"Open the cursor.",{"_12623":851,"_48290":845,"_18312":95471,"_5":17825,"_25222":95459,"_7710":95472},[48836],"Fetch a subset of rows to work with.",{"_12623":852,"_48290":845,"_18312":95474,"_5":17825,"_25222":95459,"_7710":95475},[48836],"Iterate through the fetched rows and process them as required.",{"_12623":853,"_48290":845,"_18312":95477,"_5":17825,"_25222":95459,"_7710":95478},[48836],"Fetch additional sets of rows as needed, and close the cursor when done.",{"_12623":854,"_48290":854,"_5":13058,"_7710":94774,"_48807":95480,"_18312":95481,"_25222":854},[92880,92881,92882,94570],[48836],{"_12623":855,"_48290":854,"_18312":95483,"_5":17825,"_25222":854,"_7710":95484},[48836],"Define and query late-bound dynamic columns in Phoenix when full schema cannot be declared upfront.",{"_12623":856,"_48290":854,"_18312":95486,"_5":17825,"_25222":854,"_7710":95487},[48836],"Sometimes defining a static schema up front is not feasible. Instead, a subset of columns may be specified at table create time while the rest are specified at query time. As of Phoenix 1.2, dynamic columns are supported by allowing column definitions in parentheses after the table name in the FROM clause of a SELECT statement. Although this is not standard SQL, it is useful for leveraging the late-binding capability of HBase.",{"_12623":857,"_48290":854,"_18312":95489,"_5":17825,"_25222":854,"_7710":95490},[48836],"For example:",{"_12623":858,"_48290":854,"_18312":95492,"_5":17825,"_25222":854,"_7710":95493},[48836],"You might define only a subset of event columns at create time, because each event type can have different properties:",{"_12623":859,"_48290":854,"_18312":95495,"_5":17825,"_25222":854,"_7710":95496},[48836],"To upsert a row with dynamic columns:",{"_12623":860,"_48290":860,"_5":13058,"_7710":95498,"_48807":95499,"_18312":95500,"_25222":860},"Eventually Consistent Global Indexes",[92880,92881,92882,94570],[48836],{"_12623":861,"_48290":860,"_18312":95502,"_5":17825,"_25222":860,"_7710":95503},[48836],"Global secondary indexes maintained asynchronously off the data-table write path — for write-heavy workloads that can tolerate a bounded staleness window on the index in exchange for higher write throughput.",{"_12623":862,"_48290":860,"_5":48804,"_18312":95505,"_25222":95506,"_7710":95150},[48836],"/docs/features/eventually-consistent-indexes#ec-indexes-when",{"_12623":863,"_48290":860,"_5":48804,"_18312":95508,"_25222":95509,"_7710":95510},[48836],"/docs/features/eventually-consistent-indexes#ec-indexes-create","Creating an EC index",{"_12623":864,"_48290":860,"_5":48804,"_18312":95512,"_25222":95513,"_7710":95514},[48836],"/docs/features/eventually-consistent-indexes#ec-indexes-how","How it works",{"_12623":865,"_48290":860,"_5":48804,"_18312":95516,"_25222":95517,"_7710":95518},[48836],"/docs/features/eventually-consistent-indexes#ec-indexes-reads","How reads behave",{"_12623":866,"_48290":860,"_5":48804,"_18312":95520,"_25222":95521,"_7710":95522},[48836],"/docs/features/eventually-consistent-indexes#ec-indexes-tuning","Tuning",{"_12623":867,"_48290":860,"_5":48804,"_18312":95524,"_25222":95525,"_7710":93002},[48836],"/docs/features/eventually-consistent-indexes#ec-indexes-limitations",{"_12623":868,"_48290":860,"_5":48804,"_18312":95527,"_25222":95528,"_7710":95182},[48836],"/docs/features/eventually-consistent-indexes#ec-indexes-ops",{"_12623":869,"_48290":860,"_5":48804,"_18312":95530,"_25222":95531,"_7710":95532},[48836],"/docs/features/eventually-consistent-indexes#ec-indexes-see-also","See also",{"_12623":870,"_48290":860,"_18312":95534,"_5":17825,"_25222":860,"_7710":95535},[48836],"An eventually consistent global index behaves like a regular Phoenix\nglobal index at the SQL\nlevel — same DDL, same INCLUDE, same query planning — but Phoenix maintains\nit asynchronously instead of on the synchronous write path. Writes commit\nfaster on the data table, the index catches up shortly after, and reads from\nthe index are read-repaired against the data table so they never return\nincorrect data. Introduced in Phoenix 5.3.1\n(PHOENIX-7794).",{"_12623":871,"_48290":860,"_18312":95537,"_5":17825,"_25222":95506,"_7710":95538},[48836],"Pick eventually consistent over the default (strong) consistency when both\nare true:",{"_12623":872,"_48290":860,"_18312":95540,"_5":17825,"_25222":95506,"_7710":95541},[48836],"Synchronous index maintenance is your write-path bottleneck — typically a\ndata table fanning out to several large indexes per mutation.",{"_12623":873,"_48290":860,"_18312":95543,"_5":17825,"_25222":95506,"_7710":95544},[48836],"A bounded staleness window on the index (seconds) is acceptable for the\nqueries that hit it.",{"_12623":874,"_48290":860,"_18312":95546,"_5":17825,"_25222":95506,"_7710":95547},[48836],"Stay with the default CONSISTENCY=STRONG for indexes that back\nread-your-write flows — e.g. \"insert a row, then immediately query it via the\nnew index\" inside a single user request.",{"_12623":875,"_48290":860,"_18312":95549,"_5":17825,"_25222":95506,"_7710":95550},[48836],"This is a property of global indexes only. CONSISTENCY=EVENTUAL on a\nLOCAL index parses but has no runtime effect.",{"_12623":876,"_48290":860,"_18312":95552,"_5":17825,"_25222":95509,"_7710":95553},[48836],"CONSISTENCY=EVENTUAL is set in the trailing properties slot of CREATE INDEX:",{"_12623":877,"_48290":860,"_18312":95555,"_5":17825,"_25222":95509,"_7710":95556},[48836],"UNCOVERED and ASYNC compose normally:",{"_12623":878,"_48290":860,"_18312":95558,"_5":17825,"_25222":95509,"_7710":95559},[48836],"The default is CONSISTENCY=STRONG. Flip an existing index in either direction:",{"_12623":879,"_48290":860,"_18312":95561,"_5":17825,"_25222":95509,"_7710":95562},[48836],"The consistency mode is a per-index property — not a connection setting and\nnot a query hint. Every reader of the index sees the same mode.",{"_12623":880,"_48290":860,"_18312":95564,"_5":17825,"_25222":95513,"_7710":95565},[48836],"EC indexes are maintained by a per-region background consumer that reads a\nChange Data Capture stream on the data\ntable and applies the resulting mutations to the index. The first EC index\non a table provisions the stream automatically; subsequent EC indexes on the\nsame table share it.",{"_12623":881,"_48290":860,"_18312":95567,"_5":17825,"_25222":95513,"_7710":95568},[48836],"The consumer supports two strategies for turning a CDC event into an index\nmutation, with opposite write-vs-read IO tradeoffs:",{"_12623":882,"_48290":860,"_18312":95570,"_5":17825,"_25222":95513,"_7710":95571},[48836],"Derive on consume (default). The CDC event carries a lightweight\ndata-row-state marker; the consumer re-reads the data row at consume time\nto compute the index mutation. Cheap on the write path, one extra\ndata-table read per event on the consume path. Relies on\nphoenix.max.lookback.age.seconds being long enough for the data table to\nretain the before image of every modified row until the consumer catches up.",{"_12623":883,"_48290":860,"_18312":95573,"_5":17825,"_25222":95513,"_7710":95574},[48836],"Serialize on write. The index mutation is computed at write time and\nserialized into the CDC event itself; the consumer just replays it. More\nwrite IO (and optionally compressed), no extra read on consume. Useful when\nthe consumer's data-table read is the bottleneck or max-lookback is tight.",{"_12623":884,"_48290":860,"_18312":95576,"_5":17825,"_25222":95513,"_7710":95577},[48836],"Toggle with phoenix.index.cdc.mutation.serialize (see Tuning). For most\nworkloads the default — derive on consume — is the right choice.",{"_12623":885,"_48290":860,"_18312":95579,"_5":17825,"_25222":95517,"_7710":95580},[48836],"There is no query-side change — no hint, no new syntax. The planner picks\nan EC index exactly like a STRONG index. The visibility contract differs in\ntwo ways:",{"_12623":886,"_48290":860,"_18312":95582,"_5":17825,"_25222":95517,"_7710":95583},[48836],"A row recently inserted on the data table may not yet appear in the index.",{"_12623":887,"_48290":860,"_18312":95585,"_5":17825,"_25222":95517,"_7710":95586},[48836],"An existing index row's covered column values may be stale until the next\nupdate is applied.",{"_12623":888,"_48290":860,"_18312":95588,"_5":17825,"_25222":95517,"_7710":95589},[48836],"Phoenix never returns incorrect rows: any index row not yet caught up is\nverified against the data table before being returned, exactly like a STRONG\nindex. The practical visibility window is a few seconds on a healthy\ncluster, governed by the tunables below.",{"_12623":889,"_48290":860,"_18312":95591,"_5":17825,"_25222":95521,"_7710":95592},[48836],"Set on the RegionServer side in hbase-site.xml. The defaults are sensible\nfor most clusters; the two knobs you will typically reach for are batch size\n(throughput) and timestamp buffer (visibility delay floor).",{"_12623":890,"_48290":860,"_18312":95594,"_5":17825,"_25222":95521,"_7710":95595},[48836],"Property",{"_12623":891,"_48290":860,"_18312":95597,"_5":17825,"_25222":95521,"_7710":95598},[48836],"Default",{"_12623":892,"_48290":860,"_18312":95600,"_5":17825,"_25222":95521,"_7710":94969},[48836],{"_12623":893,"_48290":860,"_18312":95602,"_5":17825,"_25222":95521,"_7710":95603},[48836],"phoenix.index.cdc.consumer.enabled",{"_12623":894,"_48290":860,"_18312":95605,"_5":17825,"_25222":95521,"_7710":16457},[48836],{"_12623":895,"_48290":860,"_18312":95607,"_5":17825,"_25222":95521,"_7710":95608},[48836],"Master switch for the async index maintenance subsystem. Disable to halt all EC-index maintenance cluster-wide.",{"_12623":896,"_48290":860,"_18312":95610,"_5":17825,"_25222":95521,"_7710":95611},[48836],"phoenix.index.cdc.consumer.batch.size",{"_12623":897,"_48290":860,"_18312":95613,"_5":17825,"_25222":95521,"_7710":48141},[48836],{"_12623":898,"_48290":860,"_18312":95615,"_5":17825,"_25222":95521,"_7710":95616},[48836],"Events drained per iteration. Larger amortizes overhead; smaller bounds staleness on bursty workloads.",{"_12623":899,"_48290":860,"_18312":95618,"_5":17825,"_25222":95521,"_7710":95619},[48836],"phoenix.index.cdc.consumer.poll.interval.ms",{"_12623":900,"_48290":860,"_18312":95621,"_5":17825,"_25222":95521,"_7710":45578},[48836],{"_12623":901,"_48290":860,"_18312":95623,"_5":17825,"_25222":95521,"_7710":95624},[48836],"Sleep when there is no work to do. Raise to reduce idle wake-ups.",{"_12623":902,"_48290":860,"_18312":95626,"_5":17825,"_25222":95521,"_7710":95627},[48836],"phoenix.index.cdc.consumer.timestamp.buffer.ms",{"_12623":903,"_48290":860,"_18312":95629,"_5":17825,"_25222":95521,"_7710":48147},[48836],{"_12623":904,"_48290":860,"_18312":95631,"_5":17825,"_25222":95521,"_7710":95632},[48836],"Safety buffer subtracted from \"now\" before consuming. Floor for visibility delay.",{"_12623":905,"_48290":860,"_18312":95634,"_5":17825,"_25222":95521,"_7710":95635},[48836],"phoenix.index.cdc.consumer.startup.delay.ms",{"_12623":906,"_48290":860,"_18312":95637,"_5":17825,"_25222":95521,"_7710":45595},[48836],{"_12623":907,"_48290":860,"_18312":95639,"_5":17825,"_25222":95521,"_7710":95640},[48836],"Delay before a freshly opened region starts consuming.",{"_12623":908,"_48290":860,"_18312":95642,"_5":17825,"_25222":95521,"_7710":95643},[48836],"phoenix.index.cdc.consumer.max.data.visibility.retries",{"_12623":909,"_48290":860,"_18312":95645,"_5":17825,"_25222":95521,"_7710":9344},[48836],{"_12623":910,"_48290":860,"_18312":95647,"_5":17825,"_25222":95521,"_7710":95648},[48836],"Retries when the data row is not yet visible to the consumer.",{"_12623":911,"_48290":860,"_18312":95650,"_5":17825,"_25222":95521,"_7710":95651},[48836],"phoenix.index.cdc.consumer.retry.pause.ms",{"_12623":912,"_48290":860,"_18312":95653,"_5":17825,"_25222":95521,"_7710":46472},[48836],{"_12623":913,"_48290":860,"_18312":95655,"_5":17825,"_25222":95521,"_7710":95656},[48836],"Sleep between data-visibility retries.",{"_12623":914,"_48290":860,"_18312":95658,"_5":17825,"_25222":95521,"_7710":95659},[48836],"phoenix.index.cdc.mutation.serialize",{"_12623":915,"_48290":860,"_18312":95661,"_5":17825,"_25222":95521,"_7710":26233},[48836],{"_12623":916,"_48290":860,"_18312":95663,"_5":17825,"_25222":95521,"_7710":95664},[48836],"Selects the consumer strategy (see How it works). false derives index mutations at consume time (lower write IO); true serializes them at write time (no consume-side read).",{"_12623":917,"_48290":860,"_18312":95666,"_5":17825,"_25222":95521,"_7710":95667},[48836],"phoenix.index.cdc.mutations.compress.enabled",{"_12623":918,"_48290":860,"_18312":95669,"_5":17825,"_25222":95521,"_7710":26233},[48836],{"_12623":919,"_48290":860,"_18312":95671,"_5":17825,"_25222":95521,"_7710":95672},[48836],"Snappy-compress the serialized index mutation. Only relevant when phoenix.index.cdc.mutation.serialize=true.",{"_12623":920,"_48290":860,"_18312":95674,"_5":17825,"_25222":95521,"_7710":95675},[48836],"With defaults, expect end-to-end index visibility of ~5–10 seconds.",{"_12623":921,"_48290":860,"_18312":95677,"_5":17825,"_25222":95525,"_7710":95678},[48836],"Global indexes only. LOCAL INDEX ... CONSISTENCY=EVENTUAL is a no-op.",{"_12623":922,"_48290":860,"_18312":95680,"_5":17825,"_25222":95525,"_7710":95681},[48836],"Designed and tested for non-transactional tables. Combining EC indexes\nwith transactional tables is undefined in 5.3.1.",{"_12623":923,"_48290":860,"_18312":95683,"_5":17825,"_25222":95525,"_7710":95684},[48836],"Salted data tables are not supported — the underlying change stream\nPhoenix needs to maintain an EC index is incompatible with salting.",{"_12623":924,"_48290":860,"_18312":95686,"_5":17825,"_25222":95525,"_7710":95687},[48836],"Data-table max lookback age must outlive the async lag. Increase\nphoenix.max.lookback.age.seconds on the data table if you tune the\nconsumer for low throughput or you expect long catch-up periods.",{"_12623":925,"_48290":860,"_18312":95689,"_5":17825,"_25222":95528,"_7710":95690},[48836],"The first EC index on a table provisions the underlying change stream\nautomatically. Subsequent EC indexes on the same table reuse it.",{"_12623":926,"_48290":860,"_18312":95692,"_5":17825,"_25222":95528,"_7710":95693},[48836],"Region splits and merges are handled transparently — no operator action is\nrequired to keep the index up to date through topology changes.",{"_12623":927,"_48290":860,"_18312":95695,"_5":17825,"_25222":95528,"_7710":95696},[48836],"ALTER INDEX ... CONSISTENCY=STRONG returns the index to synchronous\nmaintenance for new writes. Any in-flight async work continues to flow\nthrough until the queue drains.",{"_12623":928,"_48290":860,"_18312":95698,"_5":17825,"_25222":95531,"_7710":95699},[48836],"Secondary Indexes — global, local,\ncovered, uncovered, and functional indexes.",{"_12623":929,"_48290":860,"_18312":95701,"_5":17825,"_25222":95531,"_7710":95702},[48836],"Change Data Capture — exposed\nPhoenix-level change streams for application use.",{"_12623":930,"_48290":930,"_5":13058,"_7710":95704,"_48807":95705,"_18312":95706,"_25222":930},"High Availability",[92880,92881,92882,94570],[48836],{"_12623":931,"_48290":930,"_18312":95708,"_5":17825,"_25222":930,"_7710":95709},[48836],"Active/active and active/standby Phoenix client wiring across two HBase clusters, with graceful failover that lets writes drain server-side before the peer is promoted.",{"_12623":932,"_48290":930,"_5":48804,"_18312":95711,"_25222":95712,"_7710":95713},[48836],"/docs/features/high-availability#ha-concepts","Concepts",{"_12623":933,"_48290":930,"_5":48804,"_18312":95715,"_25222":95716,"_7710":95717},[48836],"/docs/features/high-availability#cluster-roles","Cluster roles",{"_12623":934,"_48290":930,"_5":48804,"_18312":95719,"_25222":95720,"_7710":95721},[48836],"/docs/features/high-availability#ha-policies","HA policies",{"_12623":935,"_48290":930,"_5":48804,"_18312":95723,"_25222":95724,"_7710":95725},[48836],"/docs/features/high-availability#failover-sub-policies-failover-only","Failover sub-policies (FAILOVER only)",{"_12623":936,"_48290":930,"_5":48804,"_18312":95727,"_25222":95728,"_7710":95729},[48836],"/docs/features/high-availability#ha-url","JDBC URL",{"_12623":937,"_48290":930,"_5":48804,"_18312":95731,"_25222":95732,"_7710":95733},[48836],"/docs/features/high-availability#connecting","Connecting",{"_12623":938,"_48290":930,"_5":48804,"_18312":95735,"_25222":95736,"_7710":95737},[48836],"/docs/features/high-availability#ha-graceful","Graceful failover",{"_12623":939,"_48290":930,"_5":48804,"_18312":95739,"_25222":95740,"_7710":92932},[48836],"/docs/features/high-availability#ha-config",{"_12623":940,"_48290":930,"_5":48804,"_18312":95742,"_25222":95743,"_7710":95744},[48836],"/docs/features/high-availability#required","Required",{"_12623":941,"_48290":930,"_5":48804,"_18312":95746,"_25222":95747,"_7710":95748},[48836],"/docs/features/high-availability#zookeeper-tuning-client-side","ZooKeeper tuning (client side)",{"_12623":942,"_48290":930,"_5":48804,"_18312":95750,"_25222":95751,"_7710":95752},[48836],"/docs/features/high-availability#fallback-to-a-single-cluster","Fallback to a single cluster",{"_12623":943,"_48290":930,"_5":48804,"_18312":95754,"_25222":95755,"_7710":95756},[48836],"/docs/features/high-availability#failover-behavior","Failover behavior",{"_12623":944,"_48290":930,"_5":48804,"_18312":95758,"_25222":95759,"_7710":95760},[48836],"/docs/features/high-availability#server-side-write-blocking","Server-side write blocking",{"_12623":945,"_48290":930,"_5":48804,"_18312":95762,"_25222":95763,"_7710":95764},[48836],"/docs/features/high-availability#ha-operator-workflow","Operator workflow",{"_12623":946,"_48290":930,"_5":48804,"_18312":95766,"_25222":95767,"_7710":95532},[48836],"/docs/features/high-availability#ha-see-also",{"_12623":947,"_48290":930,"_18312":95769,"_5":17825,"_25222":930,"_7710":95770},[48836],"Phoenix High Availability (HA) lets a JDBC client transparently target a pair\nof HBase clusters that mirror the same Phoenix schema, so an operator-driven\nor fault-driven failover never requires the application to restart, reconnect,\nor rewrite URLs.",{"_12623":948,"_48290":930,"_18312":95772,"_5":17825,"_25222":930,"_7710":95773},[48836],"Phoenix 5.3.1 adds graceful failover — an intermediate ACTIVE_TO_STANDBY\nrole that lets writes drain server-side before the peer is promoted — plus\nsupport for HBase's MASTER and RPC connection registries\n(PHOENIX-7493,\nPHOENIX-7495,\nPHOENIX-7586).",{"_12623":949,"_48290":930,"_18312":95775,"_5":17825,"_25222":95712,"_7710":95776},[48836],"An HA group is a named tuple of two HBase clusters and an HA policy,\nshared by every client that participates. The current role of each cluster\nlives in a JSON record in ZooKeeper, replicated to both clusters' ZK\nensembles and watched by the client; role changes are picked up\nautomatically.",{"_12623":950,"_48290":930,"_18312":95778,"_5":17825,"_25222":95716,"_7710":95779},[48836],"Role",{"_12623":951,"_48290":930,"_18312":95781,"_5":17825,"_25222":95716,"_7710":95782},[48836],"Clients can connect?",{"_12623":952,"_48290":930,"_18312":95784,"_5":17825,"_25222":95716,"_7710":95215},[48836],{"_12623":953,"_48290":930,"_18312":95786,"_5":17825,"_25222":95716,"_7710":95787},[48836],"ACTIVE",{"_12623":954,"_48290":930,"_18312":95789,"_5":17825,"_25222":95716,"_7710":45946},[48836],{"_12623":955,"_48290":930,"_18312":95791,"_5":17825,"_25222":95716,"_7710":95792},[48836],"Cluster is serving live reads and writes.",{"_12623":956,"_48290":930,"_18312":95794,"_5":17825,"_25222":95716,"_7710":95795},[48836],"STANDBY",{"_12623":957,"_48290":930,"_18312":95797,"_5":17825,"_25222":95716,"_7710":45946},[48836],{"_12623":958,"_48290":930,"_18312":95799,"_5":17825,"_25222":95716,"_7710":95800},[48836],"Cluster is reachable but not the current primary. FAILOVER clients refuse to bind; PARALLEL clients still bind.",{"_12623":959,"_48290":930,"_18312":95802,"_5":17825,"_25222":95716,"_7710":95803},[48836],"ACTIVE_TO_STANDBY",{"_12623":960,"_48290":930,"_18312":95805,"_5":17825,"_25222":95716,"_7710":45946},[48836],{"_12623":961,"_48290":930,"_18312":95807,"_5":17825,"_25222":95716,"_7710":95808},[48836],"Transitional state during graceful failover. FAILOVER connections are closed; PARALLEL clients still bind. Writes may be rejected (see Graceful failover below).",{"_12623":962,"_48290":930,"_18312":95810,"_5":17825,"_25222":95716,"_7710":95811},[48836],"OFFLINE",{"_12623":963,"_48290":930,"_18312":95813,"_5":17825,"_25222":95716,"_7710":27002},[48836],{"_12623":964,"_48290":930,"_18312":95815,"_5":17825,"_25222":95716,"_7710":95816},[48836],"Cluster is intentionally taken out of rotation.",{"_12623":965,"_48290":930,"_18312":95818,"_5":17825,"_25222":95716,"_7710":95819},[48836],"UNKNOWN",{"_12623":966,"_48290":930,"_18312":95821,"_5":17825,"_25222":95716,"_7710":27002},[48836],{"_12623":967,"_48290":930,"_18312":95823,"_5":17825,"_25222":95716,"_7710":95824},[48836],"Role has not been initialized or the record could not be read.",{"_12623":968,"_48290":930,"_18312":95826,"_5":17825,"_25222":95720,"_7710":95827},[48836],"The policy is part of the HA-group record. Clients do not pick it — operators\ndo, when provisioning the group.",{"_12623":969,"_48290":930,"_18312":95829,"_5":17825,"_25222":95720,"_7710":95830},[48836],"FAILOVER — exactly one cluster (the ACTIVE) serves the connection at\nany moment. The client transparently re-binds on role change.",{"_12623":970,"_48290":930,"_18312":95832,"_5":17825,"_25222":95720,"_7710":95833},[48836],"PARALLEL — every statement is issued to both clusters in parallel,\nwith the faster result returned. Useful when both clusters carry identical\ndata and you want to mask single-cluster tail latency.",{"_12623":971,"_48290":930,"_18312":95835,"_5":17825,"_25222":95724,"_7710":95836},[48836],"Controls how a FAILOVER connection reacts when its bound cluster transitions\naway from ACTIVE:",{"_12623":972,"_48290":930,"_18312":95838,"_5":17825,"_25222":95724,"_7710":95839},[48836],"phoenix.ha.failover.policy",{"_12623":973,"_48290":930,"_18312":95841,"_5":17825,"_25222":95724,"_7710":95842},[48836],"Behavior",{"_12623":974,"_48290":930,"_18312":95844,"_5":17825,"_25222":95724,"_7710":95845},[48836],"explicit (default)",{"_12623":975,"_48290":930,"_18312":95847,"_5":17825,"_25222":95724,"_7710":95848},[48836],"Subsequent operations throw FailoverSQLException; the application calls failover() to rebind to the new ACTIVE.",{"_12623":976,"_48290":930,"_18312":95850,"_5":17825,"_25222":95724,"_7710":28064},[48836],{"_12623":977,"_48290":930,"_18312":95852,"_5":17825,"_25222":95724,"_7710":95853},[48836],"Connection transparently rebinds to the new ACTIVE on the next statement, up to phoenix.ha.failover.count attempts (default 3).",{"_12623":978,"_48290":930,"_18312":95855,"_5":17825,"_25222":95728,"_7710":95856},[48836],"The HA URL is a bracketed pair of per-cluster endpoints separated by |,\noptionally followed by a principal:",{"_12623":979,"_48290":930,"_18312":95858,"_5":17825,"_25222":95728,"_7710":95859},[48836],"The presence of | inside the URL is what triggers the HA code path. The two\nURLs inside the brackets are always ZooKeeper quorums — Phoenix uses them to\nread the HA-group record.",{"_12623":980,"_48290":930,"_18312":95861,"_5":17825,"_25222":95728,"_7710":95862},[48836],"The per-cluster connection Phoenix opens underneath may use any of the\nsupported HBase registries (ZK, MASTER, or RPC), based on what the\noperator configured in the HA-group record. RPC requires HBase 2.5+.",{"_12623":981,"_48290":930,"_18312":95864,"_5":17825,"_25222":95732,"_7710":95865},[48836],"Set the HA group name as a JDBC property and open a connection like any other:",{"_12623":982,"_48290":930,"_18312":95867,"_5":17825,"_25222":95732,"_7710":95868},[48836],"The returned Connection honors the policy declared in the HA-group record.",{"_12623":983,"_48290":930,"_18312":95870,"_5":17825,"_25222":95736,"_7710":95871},[48836],"Graceful failover is a two-step demotion of the ACTIVE cluster:",{"_12623":984,"_48290":930,"_18312":95873,"_5":17825,"_25222":95736,"_7710":95874},[48836],"ACTIVE → ACTIVE_TO_STANDBY. The operator flips the source cluster\ninto ACTIVE_TO_STANDBY. FAILOVER clients' wrapped connections to the\ndemoting cluster are closed (subsequent statements raise\nFailoverSQLException, or rebind on the next statement under the\nactive sub-policy). PARALLEL clients continue to operate against\nboth clusters. On the server side, with\nphoenix.cluster.role.based.mutation.block.enabled=true, new mutations\non the demoting cluster are rejected with MutationBlockedIOException\nso replication to the peer can drain. No cluster is ACTIVE during\nthis step, so new FAILOVER connections cannot be opened until step 2.",{"_12623":985,"_48290":930,"_18312":95876,"_5":17825,"_25222":95736,"_7710":95877},[48836],"ACTIVE_TO_STANDBY → STANDBY (peer promoted to ACTIVE). Once\nreplication has caught up, the operator demotes the source the rest of\nthe way and promotes the peer. New FAILOVER connections (and active\nsub-policy retries pending from step 1) now bind to the new ACTIVE;\nexplicit clients call failover() themselves.",{"_12623":986,"_48290":930,"_18312":95879,"_5":17825,"_25222":95736,"_7710":95880},[48836],"Rolling back is supported: an ACTIVE → ACTIVE_TO_STANDBY → ACTIVE sequence\nrestores the source to ACTIVE without further role transitions. PARALLEL\nclients remain operational throughout; FAILOVER clients reopen connections\nto the restored ACTIVE once it returns.",{"_12623":987,"_48290":930,"_18312":95882,"_5":17825,"_25222":95740,"_7710":95883},[48836],"All HA-related keys. All can be set in hbase-site.xml on the client and/or\nas JDBC connection properties.",{"_12623":988,"_48290":930,"_18312":95885,"_5":17825,"_25222":95743,"_7710":95886},[48836],"Key",{"_12623":989,"_48290":930,"_18312":95888,"_5":17825,"_25222":95743,"_7710":95284},[48836],{"_12623":990,"_48290":930,"_18312":95890,"_5":17825,"_25222":95743,"_7710":95891},[48836],"phoenix.ha.group.name",{"_12623":991,"_48290":930,"_18312":95893,"_5":17825,"_25222":95743,"_7710":95894},[48836],"Name of the HA group — must match the operator-provisioned record.",{"_12623":992,"_48290":930,"_18312":95896,"_5":17825,"_25222":95747,"_7710":95886},[48836],{"_12623":993,"_48290":930,"_18312":95898,"_5":17825,"_25222":95747,"_7710":95598},[48836],{"_12623":994,"_48290":930,"_18312":95900,"_5":17825,"_25222":95747,"_7710":95901},[48836],"phoenix.ha.zk.connection.timeout.ms",{"_12623":995,"_48290":930,"_18312":95903,"_5":17825,"_25222":95747,"_7710":46430},[48836],{"_12623":996,"_48290":930,"_18312":95905,"_5":17825,"_25222":95747,"_7710":95906},[48836],"phoenix.ha.zk.session.timeout.ms",{"_12623":997,"_48290":930,"_18312":95908,"_5":17825,"_25222":95747,"_7710":46430},[48836],{"_12623":998,"_48290":930,"_18312":95910,"_5":17825,"_25222":95747,"_7710":95911},[48836],"phoenix.ha.zk.retry.base.sleep.ms",{"_12623":999,"_48290":930,"_18312":95913,"_5":17825,"_25222":95747,"_7710":45578},[48836],{"_12623":1000,"_48290":930,"_18312":95915,"_5":17825,"_25222":95747,"_7710":95916},[48836],"phoenix.ha.zk.retry.max",{"_12623":1001,"_48290":930,"_18312":95918,"_5":17825,"_25222":95747,"_7710":9473},[48836],{"_12623":1002,"_48290":930,"_18312":95920,"_5":17825,"_25222":95747,"_7710":95921},[48836],"phoenix.ha.zk.retry.max.sleep.ms",{"_12623":1003,"_48290":930,"_18312":95923,"_5":17825,"_25222":95747,"_7710":45595},[48836],{"_12623":1004,"_48290":930,"_18312":95925,"_5":17825,"_25222":95751,"_7710":95886},[48836],{"_12623":1005,"_48290":930,"_18312":95927,"_5":17825,"_25222":95751,"_7710":95598},[48836],{"_12623":1006,"_48290":930,"_18312":95929,"_5":17825,"_25222":95751,"_7710":95930},[48836],"phoenix.ha.fallback.enabled",{"_12623":1007,"_48290":930,"_18312":95932,"_5":17825,"_25222":95751,"_7710":95933},[48836],"true — if the HA record cannot be read from either ZK, fall back to a single-cluster connection.",{"_12623":1008,"_48290":930,"_18312":95935,"_5":17825,"_25222":95751,"_7710":95936},[48836],"phoenix.ha.fallback.cluster",{"_12623":1009,"_48290":930,"_18312":95938,"_5":17825,"_25222":95751,"_7710":95939},[48836],"(empty) — JDBC URL of the fallback cluster.",{"_12623":1010,"_48290":930,"_18312":95941,"_5":17825,"_25222":95755,"_7710":95886},[48836],{"_12623":1011,"_48290":930,"_18312":95943,"_5":17825,"_25222":95755,"_7710":95598},[48836],{"_12623":1012,"_48290":930,"_18312":95945,"_5":17825,"_25222":95755,"_7710":95946},[48836],"phoenix.ha.transition.timeout.ms",{"_12623":1013,"_48290":930,"_18312":95948,"_5":17825,"_25222":95755,"_7710":95949},[48836],"300000 (5 min) — time the client gets to close connections during a role transition.",{"_12623":1014,"_48290":930,"_18312":95951,"_5":17825,"_25222":95755,"_7710":95839},[48836],{"_12623":1015,"_48290":930,"_18312":95953,"_5":17825,"_25222":95755,"_7710":95954},[48836],"explicit — or active to auto-rebind.",{"_12623":1016,"_48290":930,"_18312":95956,"_5":17825,"_25222":95755,"_7710":95957},[48836],"phoenix.ha.failover.count",{"_12623":1017,"_48290":930,"_18312":95959,"_5":17825,"_25222":95755,"_7710":95960},[48836],"3 — max auto-rebind attempts for the active sub-policy.",{"_12623":1018,"_48290":930,"_18312":95962,"_5":17825,"_25222":95755,"_7710":95963},[48836],"phoenix.ha.failover.timeout.ms",{"_12623":1019,"_48290":930,"_18312":95965,"_5":17825,"_25222":95755,"_7710":95966},[48836],"10000 — wait timeout for a single failover operation.",{"_12623":1020,"_48290":930,"_18312":95968,"_5":17825,"_25222":95759,"_7710":95886},[48836],{"_12623":1021,"_48290":930,"_18312":95970,"_5":17825,"_25222":95759,"_7710":95598},[48836],{"_12623":1022,"_48290":930,"_18312":95972,"_5":17825,"_25222":95759,"_7710":95973},[48836],"phoenix.cluster.role.based.mutation.block.enabled",{"_12623":1023,"_48290":930,"_18312":95975,"_5":17825,"_25222":95759,"_7710":95976},[48836],"false — set true in the source cluster's hbase-site.xml to reject writes while the cluster is in ACTIVE_TO_STANDBY. Readers are unaffected.",{"_12623":1024,"_48290":930,"_18312":95978,"_5":17825,"_25222":95763,"_7710":95979},[48836],"A canonical graceful failover from cluster A → cluster B:",{"_12623":1025,"_48290":930,"_18312":95981,"_5":17825,"_25222":95763,"_7710":95982},[48836],"Confirm phoenix.cluster.role.based.mutation.block.enabled=true is set on\ncluster A and that replication A → B is healthy.",{"_12623":1026,"_48290":930,"_18312":95984,"_5":17825,"_25222":95763,"_7710":95985},[48836],"Set A → ACTIVE_TO_STANDBY, B remains STANDBY. Writes to A start being\nrejected. FAILOVER connections to A are closed; PARALLEL clients\ncontinue to operate against both clusters.",{"_12623":1027,"_48290":930,"_18312":95987,"_5":17825,"_25222":95763,"_7710":95988},[48836],"Wait for A → B replication lag to reach zero.",{"_12623":1028,"_48290":930,"_18312":95990,"_5":17825,"_25222":95763,"_7710":95991},[48836],"Promote: A → STANDBY, B → ACTIVE. active clients transparently\nrebind; explicit clients receive FailoverSQLException and call\nfailover() themselves.",{"_12623":1029,"_48290":930,"_18312":95993,"_5":17825,"_25222":95763,"_7710":95994},[48836],"For an unplanned failover, skip step 2 and go directly to step 4. The\nACTIVE_TO_STANDBY role is a graceful-failover convenience, not a\ncorrectness requirement.",{"_12623":1030,"_48290":930,"_18312":95996,"_5":17825,"_25222":95767,"_7710":95997},[48836],"Metrics — client metrics are emitted by both\nwrapped and HA connections.",{"_12623":1031,"_48290":1031,"_5":13058,"_7710":95999,"_48807":96000,"_18312":96001,"_25222":1031},"Metrics",[92880,92881,92882,94570],[48836],{"_12623":1032,"_48290":1031,"_18312":96003,"_5":17825,"_25222":1031,"_7710":96004},[48836],"Request-level and global Phoenix client metrics, with practical usage patterns and Java examples.",{"_12623":1033,"_48290":1031,"_5":48804,"_18312":96006,"_25222":96007,"_7710":96008},[48836],"/docs/features/metrics#request-level-metrics","Request-level metrics",{"_12623":1034,"_48290":1031,"_5":48804,"_18312":96010,"_25222":96011,"_7710":96012},[48836],"/docs/features/metrics#mutation-metrics","Mutation metrics",{"_12623":1035,"_48290":1031,"_5":48804,"_18312":96014,"_25222":96015,"_7710":96016},[48836],"/docs/features/metrics#scan-task-metrics","Scan task metrics",{"_12623":1036,"_48290":1031,"_5":48804,"_18312":96018,"_25222":96019,"_7710":96020},[48836],"/docs/features/metrics#overall-query-metrics","Overall query metrics",{"_12623":1037,"_48290":1031,"_5":48804,"_18312":96022,"_25222":96023,"_7710":96024},[48836],"/docs/features/metrics#how-to-use-sql-statement-level-metrics","How to use SQL statement-level metrics",{"_12623":1038,"_48290":1031,"_5":48804,"_18312":96026,"_25222":96027,"_7710":96028},[48836],"/docs/features/metrics#scan-latency-metrics","Scan latency metrics",{"_12623":1039,"_48290":1031,"_5":48804,"_18312":96030,"_25222":96031,"_7710":96032},[48836],"/docs/features/metrics#top-n-slowest-scans","Top-N slowest parallel scans",{"_12623":1040,"_48290":1031,"_5":48804,"_18312":96034,"_25222":96035,"_7710":96036},[48836],"/docs/features/metrics#enabling","Enabling",{"_12623":1041,"_48290":1031,"_5":48804,"_18312":96038,"_25222":96039,"_7710":96040},[48836],"/docs/features/metrics#retrieving-the-result","Retrieving the result",{"_12623":1042,"_48290":1031,"_18312":96042,"_5":17825,"_25222":1031,"_7710":96043},[48836],"Phoenix surfaces various metrics that provide an insight into what is going on within the Phoenix client as it is executing various SQL statements. These metrics are collected within the client JVM in two ways:",{"_12623":1043,"_48290":1031,"_18312":96045,"_5":17825,"_25222":1031,"_7710":96046},[48836],"Request level metrics - collected at an individual SQL statement level",{"_12623":1044,"_48290":1031,"_18312":96048,"_5":17825,"_25222":1031,"_7710":96049},[48836],"Global metrics - collected at the client JVM level",{"_12623":1045,"_48290":1031,"_18312":96051,"_5":17825,"_25222":1031,"_7710":96052},[48836],"Request level metrics are helpful for figuring out at a more granular level about the amount of work done by every SQL statement executed by Phoenix. These metrics can be classified into three categories:",{"_12623":1046,"_48290":1031,"_18312":96054,"_5":17825,"_25222":96011,"_7710":96055},[48836],"MUTATION_BATCH_SIZE - Batch sizes of mutations",{"_12623":1047,"_48290":1031,"_18312":96057,"_5":17825,"_25222":96011,"_7710":96058},[48836],"MUTATION_BYTES - Size of mutations in bytes",{"_12623":1048,"_48290":1031,"_18312":96060,"_5":17825,"_25222":96011,"_7710":96061},[48836],"MUTATION_COMMIT_TIME - Time it took to commit mutations",{"_12623":1049,"_48290":1031,"_18312":96063,"_5":17825,"_25222":96015,"_7710":96064},[48836],"NUM_PARALLEL_SCANS - Number of scans executed in parallel",{"_12623":1050,"_48290":1031,"_18312":96066,"_5":17825,"_25222":96015,"_7710":96067},[48836],"SCAN_BYTES - Number of bytes read by scans",{"_12623":1051,"_48290":1031,"_18312":96069,"_5":17825,"_25222":96015,"_7710":96070},[48836],"MEMORY_CHUNK_BYTES - Number of bytes allocated by the memory manager",{"_12623":1052,"_48290":1031,"_18312":96072,"_5":17825,"_25222":96015,"_7710":96073},[48836],"MEMORY_WAIT_TIME - Time in milliseconds threads needed to wait for memory to be allocated through memory manager",{"_12623":1053,"_48290":1031,"_18312":96075,"_5":17825,"_25222":96015,"_7710":96076},[48836],"SPOOL_FILE_SIZE - Size of spool files created in bytes",{"_12623":1054,"_48290":1031,"_18312":96078,"_5":17825,"_25222":96015,"_7710":96079},[48836],"SPOOL_FILE_COUNTER - Number of spool files created",{"_12623":1055,"_48290":1031,"_18312":96081,"_5":17825,"_25222":96015,"_7710":96082},[48836],"CACHE_REFRESH_SPLITS_COUNTER - Number of times Phoenix's metadata cache was refreshed because of splits",{"_12623":1056,"_48290":1031,"_18312":96084,"_5":17825,"_25222":96015,"_7710":96085},[48836],"TASK_QUEUE_WAIT_TIME - Time in milliseconds tasks had to wait in the queue of the thread pool executor",{"_12623":1057,"_48290":1031,"_18312":96087,"_5":17825,"_25222":96015,"_7710":96088},[48836],"TASK_END_TO_END_TIME - Time in milliseconds spent by tasks from creation to completion",{"_12623":1058,"_48290":1031,"_18312":96090,"_5":17825,"_25222":96015,"_7710":96091},[48836],"TASK_EXECUTION_TIME - Time in milliseconds tasks took to execute",{"_12623":1059,"_48290":1031,"_18312":96093,"_5":17825,"_25222":96015,"_7710":96094},[48836],"TASK_EXECUTED_COUNTER - Counter for number of tasks submitted to the thread pool executor",{"_12623":1060,"_48290":1031,"_18312":96096,"_5":17825,"_25222":96015,"_7710":96097},[48836],"TASK_REJECTED_COUNTER - Counter for number of tasks that were rejected by the thread pool executor",{"_12623":1061,"_48290":1031,"_18312":96099,"_5":17825,"_25222":96019,"_7710":96100},[48836],"QUERY_TIMEOUT_COUNTER - Number of times query timed out",{"_12623":1062,"_48290":1031,"_18312":96102,"_5":17825,"_25222":96019,"_7710":96103},[48836],"QUERY_FAILED_COUNTER - Number of times query failed",{"_12623":1063,"_48290":1031,"_18312":96105,"_5":17825,"_25222":96019,"_7710":96106},[48836],"WALL_CLOCK_TIME_MS - Wall clock time elapsed for the overall query execution",{"_12623":1064,"_48290":1031,"_18312":96108,"_5":17825,"_25222":96019,"_7710":96109},[48836],"RESULT_SET_TIME_MS - Wall clock time elapsed for reading all records using resultSet.next()",{"_12623":1065,"_48290":1031,"_18312":96111,"_5":17825,"_25222":96023,"_7710":96112},[48836],"Log and report query execution details which could be later used for analysis.",{"_12623":1066,"_48290":1031,"_18312":96114,"_5":17825,"_25222":96023,"_7710":96115},[48836],"Report top SQL queries by duration. Metric to use: WALL_CLOCK_TIME_MS.",{"_12623":1067,"_48290":1031,"_18312":96117,"_5":17825,"_25222":96023,"_7710":96118},[48836],"Check if the query is failing because it is timing out. Metric to use: QUERY_TIMEOUT_COUNTER > 0.",{"_12623":1068,"_48290":1031,"_18312":96120,"_5":17825,"_25222":96023,"_7710":96121},[48836],"Monitor the amount of bytes being written to or read from HBase for a SQL statement. Metrics to use: MUTATION_BYTES and SCAN_BYTES.",{"_12623":1069,"_48290":1031,"_18312":96123,"_5":17825,"_25222":96023,"_7710":96124},[48836],"Check if the query is doing too much work or needs tuning. Possible metrics to use: TASK_EXECUTED_COUNTER, TASK_QUEUE_WAIT_TIME, WALL_CLOCK_TIME_MS.",{"_12623":1070,"_48290":1031,"_18312":96126,"_5":17825,"_25222":96023,"_7710":96127},[48836],"Check if a successful query is facing thread starvation, i.e., number of threads in the thread pool likely needs to be increased. This is characterized by a relatively large difference between TASK_EXECUTION_TIME and TASK_END_TO_END_TIME.",{"_12623":1071,"_48290":1031,"_18312":96129,"_5":17825,"_25222":96023,"_7710":96130},[48836],"Request level metrics can be turned on/off for every Phoenix JDBC connection. Below is an example of how you can do that:",{"_12623":1072,"_48290":1031,"_18312":96132,"_5":17825,"_25222":96023,"_7710":96133},[48836],"A typical pattern for how one could get hold of read metrics for queries:",{"_12623":1073,"_48290":1031,"_18312":96135,"_5":17825,"_25222":96023,"_7710":96136},[48836],"One could also get hold of write related metrics (collected per table) for DML statements by doing something like this:",{"_12623":1074,"_48290":1031,"_18312":96138,"_5":17825,"_25222":96023,"_7710":96139},[48836],"Global metrics on the other hand are collected at the Phoenix client’s JVM level. These metrics could be used for building out a trend and seeing what is going on within Phoenix from client’s perspective over time. Other than the metrics reported above for request level metrics, the global metrics also includes the following counters:",{"_12623":1075,"_48290":1031,"_18312":96141,"_5":17825,"_25222":96023,"_7710":96142},[48836],"MUTATION_SQL_COUNTER - Counter for number of mutation SQL statements",{"_12623":1076,"_48290":1031,"_18312":96144,"_5":17825,"_25222":96023,"_7710":96145},[48836],"SELECT_SQL_COUNTER - Counter for number of SQL queries",{"_12623":1077,"_48290":1031,"_18312":96147,"_5":17825,"_25222":96023,"_7710":96148},[48836],"OPEN_PHOENIX_CONNECTIONS_COUNTER - Number of open Phoenix connections",{"_12623":1078,"_48290":1031,"_18312":96150,"_5":17825,"_25222":96023,"_7710":96151},[48836],"Global metrics could be helpful in monitoring and tuning various aspects of the execution environment. For example: an increase in TASK_REJECTED_COUNTER is probably a symptom of too much work being submitted, or that the Phoenix thread pool queue depth or number of threads (or both) needs to be increased. Similarly, a spike in TASK_EXECUTION_TIME for a time frame could be symptomatic of several things including overloaded region servers, a network glitch, or client/region servers undergoing garbage collection.",{"_12623":1079,"_48290":1031,"_18312":96153,"_5":17825,"_25222":96023,"_7710":96154},[48836],"Collection of global client metrics can be turned on/off (on by default) by setting the attribute phoenix.query.global.metrics.enabled to true/false in the client side hbase-site.xml.\nBelow is a code snippet showing how to log/report global metrics by using a scheduled job that runs periodically:",{"_12623":1080,"_48290":1031,"_18312":96156,"_5":17825,"_25222":96027,"_7710":96157},[48836],"Phoenix 5.3.1 surfaces HBase's per-scan latency and IO metrics through the\nrequest-level metrics API, giving per-query visibility into where a scan\nactually spent its time\n(PHOENIX-7704).",{"_12623":1081,"_48290":1031,"_18312":96159,"_5":17825,"_25222":96027,"_7710":96160},[48836],"Metric",{"_12623":1082,"_48290":1031,"_18312":96162,"_5":17825,"_25222":96027,"_7710":94969},[48836],{"_12623":1083,"_48290":1031,"_18312":96164,"_5":17825,"_25222":96027,"_7710":96165},[48836],"FS_READ_TIME",{"_12623":1084,"_48290":1031,"_18312":96167,"_5":17825,"_25222":96027,"_7710":96168},[48836],"Time (ms) spent in the underlying filesystem (HDFS/S3) for HFile reads.",{"_12623":1085,"_48290":1031,"_18312":96170,"_5":17825,"_25222":96027,"_7710":96171},[48836],"BYTES_READ_FROM_FS",{"_12623":1086,"_48290":1031,"_18312":96173,"_5":17825,"_25222":96027,"_7710":96174},[48836],"Bytes read from the filesystem — cold reads that missed HBase block cache.",{"_12623":1087,"_48290":1031,"_18312":96176,"_5":17825,"_25222":96027,"_7710":96177},[48836],"BYTES_READ_FROM_MEMSTORE",{"_12623":1088,"_48290":1031,"_18312":96179,"_5":17825,"_25222":96027,"_7710":96180},[48836],"Bytes read from memstore — un-flushed cells.",{"_12623":1089,"_48290":1031,"_18312":96182,"_5":17825,"_25222":96027,"_7710":96183},[48836],"BYTES_READ_FROM_BLOCKCACHE",{"_12623":1090,"_48290":1031,"_18312":96185,"_5":17825,"_25222":96027,"_7710":96186},[48836],"Bytes served from the HBase block cache — warm reads.",{"_12623":1091,"_48290":1031,"_18312":96188,"_5":17825,"_25222":96027,"_7710":96189},[48836],"BLOCK_READ_OPS_COUNT",{"_12623":1092,"_48290":1031,"_18312":96191,"_5":17825,"_25222":96027,"_7710":96192},[48836],"Number of HFile blocks read from filesystem (HDFS/S3).",{"_12623":1093,"_48290":1031,"_18312":96194,"_5":17825,"_25222":96027,"_7710":96195},[48836],"RPC_SCAN_PROCESSING_TIME",{"_12623":1094,"_48290":1031,"_18312":96197,"_5":17825,"_25222":96027,"_7710":96198},[48836],"Time (ms) the RegionServer spent processing the scan RPC in handler thread.",{"_12623":1095,"_48290":1031,"_18312":96200,"_5":17825,"_25222":96027,"_7710":96201},[48836],"RPC_SCAN_QUEUE_WAIT_TIME",{"_12623":1096,"_48290":1031,"_18312":96203,"_5":17825,"_25222":96027,"_7710":96204},[48836],"Time (ms) the scan RPC spent in the RegionServer's call queue.",{"_12623":1097,"_48290":1031,"_18312":96206,"_5":17825,"_25222":96027,"_7710":96207},[48836],"These are request-level metrics — they appear in the per-table map returned by\nPhoenixRuntime.getRequestReadMetricInfo(rs) alongside the existing entries:",{"_12623":1098,"_48290":1031,"_18312":96209,"_5":17825,"_25222":96027,"_7710":96210},[48836],"They piggyback on phoenix.trace.read.metrics.enabled (the existing\nrequest-level metrics switch, on by default) and require no additional\nconfiguration. Values originate from HBase 2.6.4+; on older HBase versions\nthey are silently zero.",{"_12623":1099,"_48290":1031,"_18312":96212,"_5":17825,"_25222":96031,"_7710":96213},[48836],"For diagnosing tail-latency on a single statement issuing multiple HBase scans, Phoenix can retain the\ntop-N slowest scan paths it issued while executing a query — useful when a\nquery fans out across many regions and you want to find the worst few\n(PHOENIX-7729).",{"_12623":1100,"_48290":1031,"_18312":96215,"_5":17825,"_25222":96035,"_7710":96216},[48836],"Off by default. Set the count to a positive number on the connection\n(Properties) or globally in hbase-site.xml:",{"_12623":1101,"_48290":1031,"_18312":96218,"_5":17825,"_25222":96035,"_7710":95595},[48836],{"_12623":1102,"_48290":1031,"_18312":96220,"_5":17825,"_25222":96035,"_7710":95598},[48836],{"_12623":1103,"_48290":1031,"_18312":96222,"_5":17825,"_25222":96035,"_7710":94969},[48836],{"_12623":1104,"_48290":1031,"_18312":96224,"_5":17825,"_25222":96035,"_7710":96225},[48836],"phoenix.slowest.scan.metrics.count",{"_12623":1105,"_48290":1031,"_18312":96227,"_5":17825,"_25222":96035,"_7710":9348},[48836],{"_12623":1106,"_48290":1031,"_18312":96229,"_5":17825,"_25222":96035,"_7710":96230},[48836],"N — number of slowest scans to retain. 0 disables the feature.",{"_12623":1107,"_48290":1031,"_18312":96232,"_5":17825,"_25222":96035,"_7710":96233},[48836],"phoenix.scan.metrics.by.region.enabled",{"_12623":1108,"_48290":1031,"_18312":96235,"_5":17825,"_25222":96035,"_7710":26233},[48836],{"_12623":1109,"_48290":1031,"_18312":96237,"_5":17825,"_25222":96035,"_7710":96238},[48836],"When true (and count > 0), the per-scan record also carries the region name and serving RegionServer. Requires HBase 2.6.3+.",{"_12623":1110,"_48290":1031,"_18312":96240,"_5":17825,"_25222":96035,"_7710":96241},[48836],"Request-level metrics (phoenix.trace.read.metrics.enabled) must also be on,\nwhich is the default.",{"_12623":1111,"_48290":1031,"_18312":96243,"_5":17825,"_25222":96039,"_7710":96244},[48836],"PhoenixRuntime.getTopNSlowestScanMetrics(rs) returns the slowest scan paths\nseen while executing the query, as a list of JSON-object lists — one outer\nentry per slow scan path, one inner entry per HBase table touched on that\npath. Forward to your telemetry sink as needed.",{"_12623":1112,"_48290":1112,"_5":13058,"_7710":96246,"_48807":96247,"_18312":96248,"_25222":1112},"Multi-tenancy",[92880,92881,92882,94570],[48836],{"_12623":1113,"_48290":1112,"_18312":96250,"_5":17825,"_25222":1112,"_7710":96251},[48836],"Use multi-tenant tables, tenant-specific connections, and tenant views to isolate tenant data in Phoenix.",{"_12623":1114,"_48290":1112,"_5":48804,"_18312":96253,"_25222":96254,"_7710":96255},[48836],"/docs/features/multi-tenancy#highlights","Highlights",{"_12623":1115,"_48290":1112,"_5":48804,"_18312":96257,"_25222":96258,"_7710":96259},[48836],"/docs/features/multi-tenancy#multi-tenant-tables","Multi-tenant tables",{"_12623":1116,"_48290":1112,"_5":48804,"_18312":96261,"_25222":96262,"_7710":96263},[48836],"/docs/features/multi-tenancy#tenant-specific-connections","Tenant-specific connections",{"_12623":1117,"_48290":1112,"_5":48804,"_18312":96265,"_25222":96266,"_7710":96267},[48836],"/docs/features/multi-tenancy#tenant-specific-views-optional","Tenant-specific views (optional)",{"_12623":1118,"_48290":1112,"_5":48804,"_18312":96269,"_25222":96270,"_7710":96271},[48836],"/docs/features/multi-tenancy#tenant-data-isolation","Tenant data isolation",{"_12623":1119,"_48290":1112,"_18312":96273,"_5":17825,"_25222":96254,"_7710":96274},[48836],"Multi-tenancy in Phoenix works via a combination of multi-tenant tables and tenant-specific connections (detailed below).",{"_12623":1120,"_48290":1112,"_18312":96276,"_5":17825,"_25222":96254,"_7710":96277},[48836],"Tenants open tenant-specific connections to Phoenix. These connections can only access data that belongs to the tenant.",{"_12623":1121,"_48290":1112,"_18312":96279,"_5":17825,"_25222":96254,"_7710":96280},[48836],"Tenants only see their own data in multi-tenant tables and can see all data in regular tables.",{"_12623":1122,"_48290":1112,"_18312":96282,"_5":17825,"_25222":96254,"_7710":96283},[48836],"In order to add their own columns, tenants create tenant-specific views on top of multi-tenant tables and add their own columns to the views.",{"_12623":1123,"_48290":1112,"_18312":96285,"_5":17825,"_25222":96258,"_7710":96286},[48836],"Multi-tenant tables in Phoenix are regular tables declared with the MULTI_TENANT=true DDL property. They work in conjunction with tenant-specific connections (detailed below) to ensure tenants only see their own data in these tables. The first primary key column of a multi-tenant table identifies the tenant. For example:",{"_12623":1124,"_48290":1112,"_18312":96288,"_5":17825,"_25222":96258,"_7710":96289},[48836],"The column that identifies the tenant may have any name, but it must be of type VARCHAR or CHAR. Regular Phoenix connections work with these tables without tenant constraints, including access across tenant boundaries.",{"_12623":1125,"_48290":1112,"_18312":96291,"_5":17825,"_25222":96262,"_7710":96292},[48836],"Tenants are identified by the presence or absence of the TenantId property at JDBC connection time. A connection with a non-null TenantId is tenant-specific. A connection with an unspecified or null TenantId is a regular connection. A tenant-specific connection may query only:",{"_12623":1126,"_48290":1112,"_18312":96294,"_5":17825,"_25222":96262,"_7710":96295},[48836],"all data in non-multi-tenant (global) tables, that is, tables created with a regular connection without MULTI_TENANT=true.",{"_12623":1127,"_48290":1112,"_18312":96297,"_5":17825,"_25222":96262,"_7710":96298},[48836],"their own data in multi-tenant tables.",{"_12623":1128,"_48290":1112,"_18312":96300,"_5":17825,"_25222":96262,"_7710":96301},[48836],"their own schema, meaning it sees only tenant-specific views created by that tenant (detailed below).",{"_12623":1129,"_48290":1112,"_18312":96303,"_5":17825,"_25222":96262,"_7710":96304},[48836],"For example, a tenant-specific connection is established like this:",{"_12623":1130,"_48290":1112,"_18312":96306,"_5":17825,"_25222":96266,"_7710":96307},[48836],"Tenant-specific views may only be created using tenant-specific connections. They are created the same way as views, however the base table must be a multi-tenant table or another view that eventually points to one. Tenant-specific views are typically used when new columns and/or filter criteria, specific to that tenant, are required. Otherwise the base table may be used directly through a tenant-specific connection as described above.",{"_12623":1131,"_48290":1112,"_18312":96309,"_5":17825,"_25222":96266,"_7710":96310},[48836],"For example, a tenant-specific view may be defined as follows:",{"_12623":1132,"_48290":1112,"_18312":96312,"_5":17825,"_25222":96266,"_7710":96313},[48836],"The tenant_id column is neither visible nor accessible from a tenant-specific view. Any reference to it causes a ColumnNotFoundException. As with any Phoenix view, whether the view is updatable follows the rules described here. In addition, indexes may be added to tenant-specific views just like regular tables and views (with these limitations).",{"_12623":1133,"_48290":1112,"_18312":96315,"_5":17825,"_25222":96270,"_7710":96316},[48836],"Any DML or query performed on multi-tenant tables using a tenant-specific connection is automatically constrained to that tenant’s data. For UPSERT, Phoenix automatically populates the tenant_id column with the tenant ID specified at connection time. For query and DELETE operations, a WHERE clause is transparently added so operations only see data for the current tenant.",{"_12623":1134,"_48290":1134,"_5":13058,"_7710":96318,"_48807":96319,"_18312":96320,"_25222":1134},"Namespace Mapping",[92880,92881,92882,94570],[48836],{"_12623":1135,"_48290":1134,"_18312":96322,"_5":17825,"_25222":1134,"_7710":96323},[48836],"Enable Phoenix schema-to-namespace mapping in HBase, including configuration, migration, and behavior by table type.",{"_12623":1136,"_48290":1134,"_5":48804,"_18312":96325,"_25222":96326,"_7710":92932},[48836],"/docs/features/namespace-mapping#namespace-mapping-configuration",{"_12623":1137,"_48290":1134,"_5":48804,"_18312":96328,"_25222":96329,"_7710":96330},[48836],"/docs/features/namespace-mapping#grammar-available","Grammar available",{"_12623":1138,"_48290":1134,"_5":48804,"_18312":96332,"_25222":96333,"_7710":94224},[48836],"/docs/features/namespace-mapping#namespace-mapping-faq",{"_12623":1139,"_48290":1134,"_5":48804,"_18312":96335,"_25222":96336,"_7710":96337},[48836],"/docs/features/namespace-mapping#how-to-migrate-existing-tables-with-schema-to-namespace","How to migrate existing tables with schema to namespace",{"_12623":1140,"_48290":1134,"_5":48804,"_18312":96339,"_25222":96340,"_7710":96341},[48836],"/docs/features/namespace-mapping#how-are-system-tables-migrated","How are system tables migrated",{"_12623":1141,"_48290":1134,"_5":48804,"_18312":96343,"_25222":96344,"_7710":96345},[48836],"/docs/features/namespace-mapping#what-permissions-are-required-to-create-and-drop-schema","What permissions are required to CREATE and DROP SCHEMA",{"_12623":1142,"_48290":1134,"_5":48804,"_18312":96347,"_25222":96348,"_7710":96349},[48836],"/docs/features/namespace-mapping#how-are-schemas-mapped-for-different-table-types","How are schemas mapped for different table types",{"_12623":1143,"_48290":1134,"_5":48804,"_18312":96351,"_25222":96352,"_7710":96353},[48836],"/docs/features/namespace-mapping#what-is-a-namespace-and-what-are-the-benefits-of-mapping-tables-to-namespaces","What is a namespace and what are the benefits of mapping tables to namespaces",{"_12623":1144,"_48290":1134,"_5":48804,"_18312":96355,"_25222":96356,"_7710":96357},[48836],"/docs/features/namespace-mapping#namespace-mapping-resources","Resources",{"_12623":1145,"_48290":1134,"_18312":96359,"_5":17825,"_25222":1134,"_7710":96360},[48836],"From v4.8.0 onward, users can map Phoenix schemas to HBase namespaces so that any table created with a schema is created in the corresponding HBase namespace.",{"_12623":1146,"_48290":1134,"_18312":96362,"_5":17825,"_25222":1134,"_7710":96363},[48836],"Earlier, every table (with or without schema) was created in the default namespace.",{"_12623":1147,"_48290":1134,"_18312":96365,"_5":17825,"_25222":96326,"_7710":96366},[48836],"Parameters to enable namespace mapping:",{"_12623":1148,"_48290":1134,"_18312":96368,"_5":17825,"_25222":96326,"_7710":95595},[48836],{"_12623":1149,"_48290":1134,"_18312":96370,"_5":17825,"_25222":96326,"_7710":94969},[48836],{"_12623":1150,"_48290":1134,"_18312":96372,"_5":17825,"_25222":96326,"_7710":95598},[48836],{"_12623":1151,"_48290":1134,"_18312":96374,"_5":17825,"_25222":96326,"_7710":96375},[48836],"phoenix.schema.isNamespaceMappingEnabled",{"_12623":1152,"_48290":1134,"_18312":96377,"_5":17825,"_25222":96326,"_7710":96378},[48836],"If enabled, tables created with a schema are mapped to the corresponding namespace. This must be set on both client and server. Once enabled, it should not be rolled back. Older clients will not work after this property is enabled.",{"_12623":1153,"_48290":1134,"_18312":96380,"_5":17825,"_25222":96326,"_7710":26233},[48836],{"_12623":1154,"_48290":1134,"_18312":96382,"_5":17825,"_25222":96326,"_7710":96383},[48836],"phoenix.schema.mapSystemTablesToNamespace",{"_12623":1155,"_48290":1134,"_18312":96385,"_5":17825,"_25222":96326,"_7710":96386},[48836],"This takes effect when phoenix.schema.isNamespaceMappingEnabled is also set to true. If enabled, existing SYSTEM tables are automatically migrated to the SYSTEM namespace. If disabled, system tables are created only in the default namespace. This must be set on both client and server.",{"_12623":1156,"_48290":1134,"_18312":96388,"_5":17825,"_25222":96326,"_7710":16457},[48836],{"_12623":1157,"_48290":1134,"_18312":96390,"_5":17825,"_25222":96329,"_7710":96391},[48836],"The following DDL statements can be used to interact with schemas:",{"_12623":1158,"_48290":1134,"_18312":96393,"_5":17825,"_25222":96329,"_7710":96394},[48836],"CREATE SCHEMA",{"_12623":1159,"_48290":1134,"_18312":96396,"_5":17825,"_25222":96329,"_7710":96397},[48836],"USE SCHEMA",{"_12623":1160,"_48290":1134,"_18312":96399,"_5":17825,"_25222":96329,"_7710":96400},[48836],"DROP SCHEMA",{"_12623":1161,"_48290":1134,"_18312":96402,"_5":17825,"_25222":96333,"_7710":96403},[48836],"How to migrate existing tables with schema to namespace?",{"_12623":1162,"_48290":1134,"_18312":96405,"_5":17825,"_25222":96333,"_7710":96406},[48836],"How are system tables migrated?",{"_12623":1163,"_48290":1134,"_18312":96408,"_5":17825,"_25222":96333,"_7710":96409},[48836],"What permissions are required to CREATE and DROP SCHEMA?",{"_12623":1164,"_48290":1134,"_18312":96411,"_5":17825,"_25222":96333,"_7710":96412},[48836],"How are schemas mapped for different table types?",{"_12623":1165,"_48290":1134,"_18312":96414,"_5":17825,"_25222":96333,"_7710":96415},[48836],"What is a namespace and what are the benefits of mapping tables to namespaces?",{"_12623":1166,"_48290":1134,"_18312":96417,"_5":17825,"_25222":96336,"_7710":96418},[48836],"For a Kerberized environment, run with a user that has sufficient permission (admin) to create a namespace.",{"_12623":1167,"_48290":1134,"_18312":96420,"_5":17825,"_25222":96336,"_7710":96421},[48836],"A table is mapped only to a namespace with the same name as the schema (schema_name). Currently, migrating an existing table to a different schema or namespace is not supported.",{"_12623":1168,"_48290":1134,"_18312":96423,"_5":17825,"_25222":96336,"_7710":94404},[48836],{"_12623":1169,"_48290":1134,"_18312":96425,"_5":17825,"_25222":96336,"_7710":96426},[48836],"Move table_name to the namespace named schema_name:",{"_12623":1170,"_48290":1134,"_18312":96428,"_5":17825,"_25222":96340,"_7710":96429},[48836],"SYSTEM tables are migrated automatically during the first connection after enabling phoenix.schema.mapSystemTablesToNamespace along with phoenix.schema.isNamespaceMappingEnabled.",{"_12623":1171,"_48290":1134,"_18312":96431,"_5":17825,"_25222":96344,"_7710":96432},[48836],"Users must have admin permission in HBase to execute CREATE SCHEMA and DROP SCHEMA, since these commands internally create or delete namespaces.",{"_12623":1172,"_48290":1134,"_18312":96434,"_5":17825,"_25222":96344,"_7710":96435},[48836],"Details for ACL management in HBase can be found here.",{"_12623":1173,"_48290":1134,"_18312":96437,"_5":17825,"_25222":96348,"_7710":96438},[48836],"Schema support in Phoenix is similar to other databases.",{"_12623":1174,"_48290":1134,"_18312":96440,"_5":17825,"_25222":96348,"_7710":96441},[48836],"The table below describes how physical tables map to Phoenix objects:",{"_12623":1175,"_48290":1134,"_18312":96443,"_5":17825,"_25222":96348,"_7710":96444},[48836],"DDL",{"_12623":1176,"_48290":1134,"_18312":96446,"_5":17825,"_25222":96348,"_7710":96447},[48836],"Table Type",{"_12623":1177,"_48290":1134,"_18312":96449,"_5":17825,"_25222":96348,"_7710":96450},[48836],"Physical Table",{"_12623":1178,"_48290":1134,"_18312":96452,"_5":17825,"_25222":96348,"_7710":94969},[48836],{"_12623":1179,"_48290":1134,"_18312":96454,"_5":17825,"_25222":96348,"_7710":96455},[48836],"CREATE TABLE S.T (ID INTEGER PRIMARY KEY)",{"_12623":1180,"_48290":1134,"_18312":96457,"_5":17825,"_25222":96348,"_7710":96458},[48836],"TABLE",{"_12623":1181,"_48290":1134,"_18312":96460,"_5":17825,"_25222":96348,"_7710":96461},[48836],"S:T",{"_12623":1182,"_48290":1134,"_18312":96463,"_5":17825,"_25222":96348,"_7710":96464},[48836],"Table T is created in namespace S.",{"_12623":1183,"_48290":1134,"_18312":96466,"_5":17825,"_25222":96348,"_7710":96467},[48836],"CREATE INDEX IDX ON S.T(ID)",{"_12623":1184,"_48290":1134,"_18312":96469,"_5":17825,"_25222":96348,"_7710":96470},[48836],"INDEX",{"_12623":1185,"_48290":1134,"_18312":96472,"_5":17825,"_25222":96348,"_7710":96473},[48836],"S:IDX",{"_12623":1186,"_48290":1134,"_18312":96475,"_5":17825,"_25222":96348,"_7710":96476},[48836],"Indexes inherit schema and namespace from the base table.",{"_12623":1187,"_48290":1134,"_18312":96478,"_5":17825,"_25222":96348,"_7710":96479},[48836],"CREATE VIEW V AS SELECT * FROM S.T",{"_12623":1188,"_48290":1134,"_18312":96481,"_5":17825,"_25222":96348,"_7710":96482},[48836],"VIEW with default schema",{"_12623":1189,"_48290":1134,"_18312":96484,"_5":17825,"_25222":96348,"_7710":96461},[48836],{"_12623":1190,"_48290":1134,"_18312":96486,"_5":17825,"_25222":96348,"_7710":96487},[48836],"View does not inherit schema from the parent table and can use the default schema.",{"_12623":1191,"_48290":1134,"_18312":96489,"_5":17825,"_25222":96348,"_7710":96490},[48836],"CREATE VIEW X.V AS SELECT * FROM S.T",{"_12623":1192,"_48290":1134,"_18312":96492,"_5":17825,"_25222":96348,"_7710":96493},[48836],"VIEW with different schema than physical table",{"_12623":1193,"_48290":1134,"_18312":96495,"_5":17825,"_25222":96348,"_7710":96461},[48836],{"_12623":1194,"_48290":1134,"_18312":96497,"_5":17825,"_25222":96348,"_7710":96498},[48836],"View uses the parent physical table and can have a different (or same) schema.",{"_12623":1195,"_48290":1134,"_18312":96500,"_5":17825,"_25222":96348,"_7710":96501},[48836],"CREATE VIEW S.V AS SELECT * FROM S.T",{"_12623":1196,"_48290":1134,"_18312":96503,"_5":17825,"_25222":96348,"_7710":96504},[48836],"VIEW with same schema as physical table",{"_12623":1197,"_48290":1134,"_18312":96506,"_5":17825,"_25222":96348,"_7710":96461},[48836],{"_12623":1198,"_48290":1134,"_18312":96508,"_5":17825,"_25222":96348,"_7710":96498},[48836],{"_12623":1199,"_48290":1134,"_18312":96510,"_5":17825,"_25222":96348,"_7710":96511},[48836],"CREATE INDEX IDX ON S.V(ID)",{"_12623":1200,"_48290":1134,"_18312":96513,"_5":17825,"_25222":96348,"_7710":96514},[48836],"VIEW INDEX",{"_12623":1201,"_48290":1134,"_18312":96516,"_5":17825,"_25222":96348,"_7710":96517},[48836],"S:_IDX_T",{"_12623":1202,"_48290":1134,"_18312":96519,"_5":17825,"_25222":96348,"_7710":96520},[48836],"View indexes inherit schema and map to the corresponding namespace.",{"_12623":1203,"_48290":1134,"_18312":96522,"_5":17825,"_25222":96352,"_7710":96523},[48836],"A namespace is a logical grouping of tables, analogous to a database in relational database systems. This abstraction lays the groundwork for multi-tenancy-related features:",{"_12623":1204,"_48290":1134,"_18312":96525,"_5":17825,"_25222":96352,"_7710":96526},[48836],"Quota Management - Restrict the amount of resources (i.e. regions, tables) a namespace can consume.",{"_12623":1205,"_48290":1134,"_18312":96528,"_5":17825,"_25222":96352,"_7710":96529},[48836],"Namespace Security Administration - Provide another level of security administration for tenants.",{"_12623":1206,"_48290":1134,"_18312":96531,"_5":17825,"_25222":96352,"_7710":96532},[48836],"Region server groups - A namespace/table can be pinned to a subset of RegionServers, guaranteeing a coarse level of isolation.",{"_12623":1207,"_48290":1134,"_18312":96534,"_5":17825,"_25222":96352,"_7710":96535},[48836],"Details about namespace management can be read here.",{"_12623":1208,"_48290":1134,"_18312":96537,"_5":17825,"_25222":96356,"_7710":96538},[48836],"PHOENIX-1311: Implementation details and discussion for the namespace mapping feature.",{"_12623":1209,"_48290":1209,"_5":13058,"_7710":96540,"_48807":96541,"_18312":96542,"_25222":1209},"Paged Queries",[92880,92881,92882,94570],[48836],{"_12623":1210,"_48290":1209,"_18312":96544,"_5":17825,"_25222":1209,"_7710":96545},[48836],"Use row value constructors and OFFSET/LIMIT for efficient paged query patterns in Phoenix.",{"_12623":1211,"_48290":1209,"_5":48804,"_18312":96547,"_25222":96548,"_7710":96549},[48836],"/docs/features/paged-queries#row-value-constructors-rvc","Row Value Constructors (RVC)",{"_12623":1212,"_48290":1209,"_5":48804,"_18312":96551,"_25222":96552,"_7710":96553},[48836],"/docs/features/paged-queries#offset-with-limit","OFFSET with LIMIT",{"_12623":1213,"_48290":1209,"_18312":96555,"_5":17825,"_25222":1209,"_7710":96556},[48836],"Phoenix supports standard SQL constructs to enable paged queries:",{"_12623":1214,"_48290":1209,"_18312":96558,"_5":17825,"_25222":1209,"_7710":96549},[48836],{"_12623":1215,"_48290":1209,"_18312":96560,"_5":17825,"_25222":1209,"_7710":96553},[48836],{"_12623":1216,"_48290":1209,"_18312":96562,"_5":17825,"_25222":96548,"_7710":96563},[48836],"A row value constructor is an ordered sequence of values delimited by parentheses. For example:",{"_12623":1217,"_48290":1209,"_18312":96565,"_5":17825,"_25222":96548,"_7710":96566},[48836],"Just like regular values, row value constructors may be used in comparison expressions:",{"_12623":1218,"_48290":1209,"_18312":96568,"_5":17825,"_25222":96548,"_7710":96569},[48836],"Row value constructors are compared by conceptually concatenating the values together and comparing them against each other, with the leftmost part being most significant. Section 8.2 (comparison predicates) of the SQL-92 standard explains this in detail, but here are a few examples of predicates that would evaluate to true:",{"_12623":1219,"_48290":1209,"_18312":96571,"_5":17825,"_25222":96548,"_7710":96572},[48836],"Row value constructors may also be used in an IN list expression to efficiently query for a set of rows given the composite primary key columns. For example, the following would be optimized to be a point get of three rows:",{"_12623":1220,"_48290":1209,"_18312":96574,"_5":17825,"_25222":96548,"_7710":96575},[48836],"Another primary use case for row value constructors is to support query-more type functionality by enabling an ordered set of rows to be incrementally stepped through. For example, the following query would step through a set of rows, 20 rows at a time:",{"_12623":1221,"_48290":1209,"_18312":96577,"_5":17825,"_25222":96548,"_7710":96578},[48836],"Assuming that the client binds the three bind variables to the values of the last row processed, the next invocation would find the next 20 rows that match the query. If the columns you supply in your row value constructor match in order the columns from your primary key (or from a secondary index), then Phoenix will be able to turn the row value constructor expression into the start row of your scan. This enables a very efficient mechanism to locate at or after a row.",{"_12623":1222,"_48290":1209,"_18312":96580,"_5":17825,"_25222":96552,"_7710":96581},[48836],"Use OFFSET to specify the starting row offset into the result set returned by your query and LIMIT to specify the page size.",{"_12623":1223,"_48290":1209,"_18312":96583,"_5":17825,"_25222":96552,"_7710":96584},[48836],"For example, if page size is 10, then to select the second page, the following query can be used (rows 11 to 20 are returned):",{"_12623":1224,"_48290":1209,"_18312":96586,"_5":17825,"_25222":96552,"_7710":96587},[48836],"OFFSET reads and skips rows on either the server or client depending on query type, whereas RVC is more effective for queries on the primary key axis because it can start directly from the provided key.",{"_12623":1225,"_48290":1225,"_5":13058,"_7710":96589,"_48807":96590,"_18312":96591,"_25222":1225},"PHOENIX_ROW_TIMESTAMP()",[92880,92881,92882,94570],[48836],{"_12623":1226,"_48290":1225,"_18312":96593,"_5":17825,"_25222":1225,"_7710":96594},[48836],"Read the per-row last-modified timestamp Phoenix maintains automatically — usable in projections, predicates, and indexes for fast time-bounded reads.",{"_12623":1227,"_48290":1225,"_5":48804,"_18312":96596,"_25222":96597,"_7710":96598},[48836],"/docs/features/phoenix-row-timestamp#phoenix-row-timestamp-read","Reading the row timestamp",{"_12623":1228,"_48290":1225,"_5":48804,"_18312":96600,"_25222":96601,"_7710":96602},[48836],"/docs/features/phoenix-row-timestamp#phoenix-row-timestamp-where","In WHERE predicates",{"_12623":1229,"_48290":1225,"_5":48804,"_18312":96604,"_25222":96605,"_7710":96606},[48836],"/docs/features/phoenix-row-timestamp#phoenix-row-timestamp-index","Indexing on PHOENIX_ROW_TIMESTAMP()",{"_12623":1230,"_48290":1225,"_5":48804,"_18312":96608,"_25222":96609,"_7710":96610},[48836],"/docs/features/phoenix-row-timestamp#phoenix-row-timestamp-vs-row-timestamp","Relationship to ROW_TIMESTAMP column",{"_12623":1231,"_48290":1225,"_18312":96612,"_5":17825,"_25222":1225,"_7710":96613},[48836],"PHOENIX_ROW_TIMESTAMP() is a built-in SQL function that returns the timestamp\nof the row's empty column, which Phoenix updates automatically on every write.\nIt's effectively the row's last-modified time, available on any Phoenix table\nwithout you having to declare or manage a timestamp column yourself. The return\ntype is DATE.",{"_12623":1232,"_48290":1225,"_18312":96615,"_5":17825,"_25222":1225,"_7710":96616},[48836],"It can be used in three places, and the third one is what makes it especially\npowerful:",{"_12623":1233,"_48290":1225,"_18312":96618,"_5":17825,"_25222":1225,"_7710":96619},[48836],"As a projection in SELECT.",{"_12623":1234,"_48290":1225,"_18312":96621,"_5":17825,"_25222":1225,"_7710":96622},[48836],"As a predicate in WHERE (and JOIN) clauses.",{"_12623":1235,"_48290":1225,"_18312":96624,"_5":17825,"_25222":1225,"_7710":96625},[48836],"As the indexed expression in a functional index, which makes time-bounded reads fast even when the table isn't ordered by time.",{"_12623":1236,"_48290":1225,"_18312":96627,"_5":17825,"_25222":96597,"_7710":96628},[48836],"Project it like any other column:",{"_12623":1237,"_48290":1225,"_18312":96630,"_5":17825,"_25222":96597,"_7710":96631},[48836],"The function takes no arguments and is evaluated server-side from the empty cell\nthat Phoenix already maintains for every row.",{"_12623":1238,"_48290":1225,"_18312":96633,"_5":17825,"_25222":96601,"_7710":96634},[48836],"Use it to bound queries by mutation time, including incremental \"what changed\nsince\" patterns:",{"_12623":1239,"_48290":1225,"_18312":96636,"_5":17825,"_25222":96601,"_7710":96637},[48836],"Without an index, these predicates require a full scan of the table. The next\nsection fixes that.",{"_12623":1240,"_48290":1225,"_18312":96639,"_5":17825,"_25222":96605,"_7710":96640},[48836],"Create a functional index\non the function to make time-bounded reads fast. Phoenix can then seek directly\non the indexed timestamp instead of scanning the data table:",{"_12623":1241,"_48290":1225,"_18312":96642,"_5":17825,"_25222":96605,"_7710":96643},[48836],"This is the typical recipe for \"scan rows changed in the last N minutes\" type\nqueries on a table whose primary key isn't time-ordered. Pair with\nuncovered indexes when you\ndon't want to duplicate payload columns into the index.",{"_12623":1242,"_48290":1225,"_18312":96645,"_5":17825,"_25222":96605,"_7710":96646},[48836],"If your downstream needs a continuous, ordered stream of changes rather than\nperiodic time-bounded scans — including the actual mutation deltas — reach for\nChange Data Capture instead. The functional\nindex pattern here is best suited to ad-hoc time-window reads from the same\nclient that issues regular SQL queries.",{"_12623":1243,"_48290":1225,"_18312":96648,"_5":17825,"_25222":96609,"_7710":96649},[48836],"Two related concepts share the word \"timestamp\" — they are not the same:",{"_12623":1244,"_48290":1225,"_18312":96651,"_5":17825,"_25222":96609,"_7710":96652},[48836],"Feature",{"_12623":1245,"_48290":1225,"_18312":96654,"_5":17825,"_25222":96609,"_7710":96655},[48836],"Direction",{"_12623":1246,"_48290":1225,"_18312":96657,"_5":17825,"_25222":96609,"_7710":96658},[48836],"What it does",{"_12623":1247,"_48290":1225,"_18312":96660,"_5":17825,"_25222":96609,"_7710":96661},[48836],"ROW_TIMESTAMP column",{"_12623":1248,"_48290":1225,"_18312":96663,"_5":17825,"_25222":96609,"_7710":96664},[48836],"Write",{"_12623":1249,"_48290":1225,"_18312":96666,"_5":17825,"_25222":96609,"_7710":96667},[48836],"Designate a primary-key column whose value is written into the underlying HBase row timestamp.",{"_12623":1250,"_48290":1225,"_18312":96669,"_5":17825,"_25222":96609,"_7710":96670},[48836],"PHOENIX_ROW_TIMESTAMP() function",{"_12623":1251,"_48290":1225,"_18312":96672,"_5":17825,"_25222":96609,"_7710":96673},[48836],"Read",{"_12623":1252,"_48290":1225,"_18312":96675,"_5":17825,"_25222":96609,"_7710":96676},[48836],"Return the underlying HBase row timestamp Phoenix already maintains on every row's empty cell.",{"_12623":1253,"_48290":1225,"_18312":96678,"_5":17825,"_25222":96609,"_7710":96679},[48836],"PHOENIX_ROW_TIMESTAMP() works on any Phoenix table, regardless of whether\nyou've declared a ROW_TIMESTAMP column. If you have declared one, both\nmechanisms read/write the same underlying timestamp, so PHOENIX_ROW_TIMESTAMP()\nreturns the value of the ROW_TIMESTAMP column for that row.",{"_12623":1254,"_48290":1254,"_5":13058,"_7710":96681,"_48807":96682,"_18312":96683,"_25222":1254},"PhoenixSyncTable Tool",[92880,92881,92882,94570],[48836],{"_12623":1255,"_48290":1254,"_18312":96685,"_5":17825,"_25222":1254,"_7710":96686},[48836],"Detect data divergence between a source and a target Phoenix table across two HBase clusters via a chunked hash comparison driven by MapReduce.",{"_12623":1256,"_48290":1254,"_5":48804,"_18312":96688,"_25222":96689,"_7710":95150},[48836],"/docs/features/phoenix-sync-table#sync-table-when",{"_12623":1257,"_48290":1254,"_5":48804,"_18312":96691,"_25222":96692,"_7710":96693},[48836],"/docs/features/phoenix-sync-table#sync-table-running","Running the tool",{"_12623":1258,"_48290":1254,"_5":48804,"_18312":96695,"_25222":96696,"_7710":96697},[48836],"/docs/features/phoenix-sync-table#flags","Flags",{"_12623":1259,"_48290":1254,"_5":48804,"_18312":96699,"_25222":96700,"_7710":96701},[48836],"/docs/features/phoenix-sync-table#sync-table-output","Output",{"_12623":1260,"_48290":1254,"_5":48804,"_18312":96703,"_25222":96704,"_7710":96705},[48836],"/docs/features/phoenix-sync-table#mapreduce-counters","MapReduce counters",{"_12623":1261,"_48290":1254,"_5":48804,"_18312":96707,"_25222":96708,"_7710":96709},[48836],"/docs/features/phoenix-sync-table#phoenix_sync_table_checkpoint","PHOENIX_SYNC_TABLE_CHECKPOINT",{"_12623":1262,"_48290":1254,"_5":48804,"_18312":96711,"_25222":96712,"_7710":96713},[48836],"/docs/features/phoenix-sync-table#resumability","Resumability",{"_12623":1263,"_48290":1254,"_5":48804,"_18312":96715,"_25222":96716,"_7710":93065},[48836],"/docs/features/phoenix-sync-table#sync-table-prereqs",{"_12623":1264,"_48290":1254,"_5":48804,"_18312":96718,"_25222":96719,"_7710":95522},[48836],"/docs/features/phoenix-sync-table#sync-table-tuning",{"_12623":1265,"_48290":1254,"_5":48804,"_18312":96721,"_25222":96722,"_7710":93002},[48836],"/docs/features/phoenix-sync-table#sync-table-limitations",{"_12623":1266,"_48290":1254,"_5":48804,"_18312":96724,"_25222":96725,"_7710":96726},[48836],"/docs/features/phoenix-sync-table#sync-table-upcoming","Upcoming",{"_12623":1267,"_48290":1254,"_18312":96728,"_5":17825,"_25222":1254,"_7710":96729},[48836],"PhoenixSyncTableTool is a MapReduce-based divergence detector for Phoenix\ntables that are replicated (or migrated) between two HBase clusters. For each\nregion-aligned chunk it computes an SHA-256 hash on both clusters server-side\nand compares only the hashes — full rows never leave their cluster. Chunks\nwhose hashes disagree are checkpointed to a Phoenix output table\n(PHOENIX_SYNC_TABLE_CHECKPOINT) for later inspection. Available in Phoenix\n5.3.1 (PHOENIX-7751).",{"_12623":1268,"_48290":1254,"_18312":96731,"_5":17825,"_25222":1254,"_7710":96732},[48836],"The tool is conceptually similar to HBase's HashTable/SyncTable pair but\nis Phoenix-aware (honors tenant id, indexes, the column-encoding scheme, and\na bounded time range via --from-time/--to-time) and runs as a single\nMapReduce job, writing results directly to a Phoenix table instead of staging\nhashes in HDFS between two jobs. The output table is queryable with SQL.",{"_12623":1269,"_48290":1254,"_18312":96734,"_5":17825,"_25222":1254,"_7710":96735},[48836],"Two operational properties differentiate it further from HashTable/SyncTable:",{"_12623":1270,"_48290":1254,"_18312":96737,"_5":17825,"_25222":1254,"_7710":96738},[48836],"Resumable via checkpointing. Both mapper-region completion and\nper-chunk progress are persisted to the checkpoint table during the run.\nOn a failure or re-run with the same (table, target cluster, from-time,\nto-time) window, completed mapper regions are filtered out of the input\nsplits and finished chunks are skipped — no need to redo verified work.",{"_12623":1271,"_48290":1254,"_18312":96740,"_5":17825,"_25222":1254,"_7710":96741},[48836],"Optional split coalescing (--coalesce-split). When enabled, adjacent\nregion splits co-located on the same RegionServer are grouped into a\nsingle mapper, reducing mapper count (and target-cluster RPC fan-out) on\ntables with many small regions. Off by default; enable for wide tables\nwhere per-mapper overhead dominates.",{"_12623":1272,"_48290":1254,"_18312":96743,"_5":17825,"_25222":1254,"_7710":96744},[48836],"PhoenixSyncTableTool performs detection only in 5.3.1; it does not\nmodify the target cluster.",{"_12623":1273,"_48290":1254,"_18312":96746,"_5":17825,"_25222":96689,"_7710":96747},[48836],"Reach for PhoenixSyncTableTool to verify:",{"_12623":1274,"_48290":1254,"_18312":96749,"_5":17825,"_25222":96689,"_7710":96750},[48836],"A cluster migration that used HBase snapshots, replication, or both — to\nconfirm the target is byte-for-byte identical after cutover.",{"_12623":1275,"_48290":1254,"_18312":96752,"_5":17825,"_25222":96689,"_7710":96753},[48836],"Long-running HBase replication — to detect cases where a replication peer\nhas silently drifted.",{"_12623":1276,"_48290":1254,"_18312":96755,"_5":17825,"_25222":96689,"_7710":96756},[48836],"DR drills — to confirm the standby is in sync before a planned failover.",{"_12623":1277,"_48290":1254,"_18312":96758,"_5":17825,"_25222":96689,"_7710":96759},[48836],"For ad-hoc row-count or row-key spot-checks you usually want a small SQL\nquery instead; PhoenixSyncTableTool is the right choice when you need\nfull-data confidence with bounded network cost.",{"_12623":1278,"_48290":1254,"_18312":96761,"_5":17825,"_25222":96692,"_7710":96762},[48836],"The tool runs through hbase (or hadoop jar) and takes only two mandatory\nflags — the source table name and the target cluster's ZooKeeper quorum.",{"_12623":1279,"_48290":1254,"_18312":96764,"_5":17825,"_25222":96692,"_7710":96765},[48836],"The source cluster comes from the Hadoop/HBase configuration the job is\nsubmitted under, so --target-cluster is the ZooKeeper quorum of the\nother cluster. Accepted quorum formats:",{"_12623":1280,"_48290":1254,"_18312":96767,"_5":17825,"_25222":96692,"_7710":96768},[48836],"host:port:/znode",{"_12623":1281,"_48290":1254,"_18312":96770,"_5":17825,"_25222":96692,"_7710":96771},[48836],"h1,h2:port:/znode",{"_12623":1282,"_48290":1254,"_18312":96773,"_5":17825,"_25222":96692,"_7710":96774},[48836],"h1:p1,h2:p2:/znode",{"_12623":1283,"_48290":1254,"_18312":96776,"_5":17825,"_25222":96696,"_7710":96777},[48836],"Short",{"_12623":1284,"_48290":1254,"_18312":96779,"_5":17825,"_25222":96696,"_7710":96780},[48836],"Long",{"_12623":1285,"_48290":1254,"_18312":96782,"_5":17825,"_25222":96696,"_7710":95744},[48836],{"_12623":1286,"_48290":1254,"_18312":96784,"_5":17825,"_25222":96696,"_7710":95598},[48836],{"_12623":1287,"_48290":1254,"_18312":96786,"_5":17825,"_25222":96696,"_7710":96787},[48836],"Purpose",{"_12623":1288,"_48290":1254,"_18312":96789,"_5":17825,"_25222":96696,"_7710":47429},[48836],{"_12623":1289,"_48290":1254,"_18312":96791,"_5":17825,"_25222":96696,"_7710":47653},[48836],{"_12623":1290,"_48290":1254,"_18312":96793,"_5":17825,"_25222":96696,"_7710":45946},[48836],{"_12623":1291,"_48290":1254,"_18312":96795,"_5":17825,"_25222":96696,"_7710":96796},[48836],"—",{"_12623":1292,"_48290":1254,"_18312":96798,"_5":17825,"_25222":96696,"_7710":96799},[48836],"Source table (physical name; index physical names are also accepted).",{"_12623":1293,"_48290":1254,"_18312":96801,"_5":17825,"_25222":96696,"_7710":47435},[48836],{"_12623":1294,"_48290":1254,"_18312":96803,"_5":17825,"_25222":96696,"_7710":47664},[48836],{"_12623":1295,"_48290":1254,"_18312":96805,"_5":17825,"_25222":96696,"_7710":45946},[48836],{"_12623":1296,"_48290":1254,"_18312":96807,"_5":17825,"_25222":96696,"_7710":96796},[48836],{"_12623":1297,"_48290":1254,"_18312":96809,"_5":17825,"_25222":96696,"_7710":96810},[48836],"ZK quorum of the target cluster.",{"_12623":1298,"_48290":1254,"_18312":96812,"_5":17825,"_25222":96696,"_7710":47482},[48836],{"_12623":1299,"_48290":1254,"_18312":96814,"_5":17825,"_25222":96696,"_7710":47774},[48836],{"_12623":1300,"_48290":1254,"_18312":96816,"_5":17825,"_25222":96696,"_7710":27002},[48836],{"_12623":1301,"_48290":1254,"_18312":96818,"_5":17825,"_25222":96696,"_7710":96796},[48836],{"_12623":1302,"_48290":1254,"_18312":96820,"_5":17825,"_25222":96696,"_7710":96821},[48836],"Phoenix schema name.",{"_12623":1303,"_48290":1254,"_18312":96823,"_5":17825,"_25222":96696,"_7710":44079},[48836],{"_12623":1304,"_48290":1254,"_18312":96825,"_5":17825,"_25222":96696,"_7710":47678},[48836],{"_12623":1305,"_48290":1254,"_18312":96827,"_5":17825,"_25222":96696,"_7710":27002},[48836],{"_12623":1306,"_48290":1254,"_18312":96829,"_5":17825,"_25222":96696,"_7710":96796},[48836],{"_12623":1307,"_48290":1254,"_18312":96831,"_5":17825,"_25222":96696,"_7710":96832},[48836],"Tenant id for tenant-specific sync.",{"_12623":1308,"_48290":1254,"_18312":96834,"_5":17825,"_25222":96696,"_7710":47340},[48836],{"_12623":1309,"_48290":1254,"_18312":96836,"_5":17825,"_25222":96696,"_7710":47799},[48836],{"_12623":1310,"_48290":1254,"_18312":96838,"_5":17825,"_25222":96696,"_7710":27002},[48836],{"_12623":1311,"_48290":1254,"_18312":96840,"_5":17825,"_25222":96696,"_7710":9348},[48836],{"_12623":1312,"_48290":1254,"_18312":96842,"_5":17825,"_25222":96696,"_7710":96843},[48836],"Lower bound of the cell-timestamp window, in ms.",{"_12623":1313,"_48290":1254,"_18312":96845,"_5":17825,"_25222":96696,"_7710":47446},[48836],{"_12623":1314,"_48290":1254,"_18312":96847,"_5":17825,"_25222":96696,"_7710":47671},[48836],{"_12623":1315,"_48290":1254,"_18312":96849,"_5":17825,"_25222":96696,"_7710":27002},[48836],{"_12623":1316,"_48290":1254,"_18312":96851,"_5":17825,"_25222":96696,"_7710":96852},[48836],"now - 1 hour",{"_12623":1317,"_48290":1254,"_18312":96854,"_5":17825,"_25222":96696,"_7710":96855},[48836],"Upper bound; also used as CURRENT_SCN. The 1-hour buffer gives async replication time to catch up.",{"_12623":1318,"_48290":1254,"_18312":96857,"_5":17825,"_25222":96696,"_7710":47390},[48836],{"_12623":1319,"_48290":1254,"_18312":96859,"_5":17825,"_25222":96696,"_7710":47823},[48836],{"_12623":1320,"_48290":1254,"_18312":96861,"_5":17825,"_25222":96696,"_7710":27002},[48836],{"_12623":1321,"_48290":1254,"_18312":96863,"_5":17825,"_25222":96696,"_7710":96864},[48836],"1073741824 (1 GiB)",{"_12623":1322,"_48290":1254,"_18312":96866,"_5":17825,"_25222":96696,"_7710":96867},[48836],"Approximate chunk size in bytes. Smaller chunks narrow the divergence search radius at the cost of more checkpoint rows.",{"_12623":1323,"_48290":1254,"_18312":96869,"_5":17825,"_25222":96696,"_7710":47913},[48836],{"_12623":1324,"_48290":1254,"_18312":96871,"_5":17825,"_25222":96696,"_7710":47835},[48836],{"_12623":1325,"_48290":1254,"_18312":96873,"_5":17825,"_25222":96696,"_7710":27002},[48836],{"_12623":1326,"_48290":1254,"_18312":96875,"_5":17825,"_25222":96696,"_7710":26233},[48836],{"_12623":1327,"_48290":1254,"_18312":96877,"_5":17825,"_25222":96696,"_7710":96878},[48836],"Include delete markers.",{"_12623":1328,"_48290":1254,"_18312":96880,"_5":17825,"_25222":96696,"_7710":47919},[48836],{"_12623":1329,"_48290":1254,"_18312":96882,"_5":17825,"_25222":96696,"_7710":47842},[48836],{"_12623":1330,"_48290":1254,"_18312":96884,"_5":17825,"_25222":96696,"_7710":27002},[48836],{"_12623":1331,"_48290":1254,"_18312":96886,"_5":17825,"_25222":96696,"_7710":26233},[48836],{"_12623":1332,"_48290":1254,"_18312":96888,"_5":17825,"_25222":96696,"_7710":96889},[48836],"Compare every cell version, not just the latest.",{"_12623":1333,"_48290":1254,"_18312":96891,"_5":17825,"_25222":96696,"_7710":47396},[48836],{"_12623":1334,"_48290":1254,"_18312":96893,"_5":17825,"_25222":96696,"_7710":47816},[48836],{"_12623":1335,"_48290":1254,"_18312":96895,"_5":17825,"_25222":96696,"_7710":27002},[48836],{"_12623":1336,"_48290":1254,"_18312":96897,"_5":17825,"_25222":96696,"_7710":26233},[48836],{"_12623":1337,"_48290":1254,"_18312":96899,"_5":17825,"_25222":96696,"_7710":96900},[48836],"Coalesce multiple source regions into one mapper.",{"_12623":1338,"_48290":1254,"_18312":96902,"_5":17825,"_25222":96696,"_7710":47925},[48836],{"_12623":1339,"_48290":1254,"_18312":96904,"_5":17825,"_25222":96696,"_7710":47849},[48836],{"_12623":1340,"_48290":1254,"_18312":96906,"_5":17825,"_25222":96696,"_7710":27002},[48836],{"_12623":1341,"_48290":1254,"_18312":96908,"_5":17825,"_25222":96696,"_7710":26233},[48836],{"_12623":1342,"_48290":1254,"_18312":96910,"_5":17825,"_25222":96696,"_7710":96911},[48836],"Block until the job completes (default is fire-and-forget submit).",{"_12623":1343,"_48290":1254,"_18312":96913,"_5":17825,"_25222":96696,"_7710":47288},[48836],{"_12623":1344,"_48290":1254,"_18312":96915,"_5":17825,"_25222":96696,"_7710":47707},[48836],{"_12623":1345,"_48290":1254,"_18312":96917,"_5":17825,"_25222":96696,"_7710":27002},[48836],{"_12623":1346,"_48290":1254,"_18312":96919,"_5":17825,"_25222":96696,"_7710":26233},[48836],{"_12623":1347,"_48290":1254,"_18312":96921,"_5":17825,"_25222":96696,"_7710":96922},[48836],"Marker only — reserved for a future auto-repair extension.",{"_12623":1348,"_48290":1254,"_18312":96924,"_5":17825,"_25222":96696,"_7710":47467},[48836],{"_12623":1349,"_48290":1254,"_18312":96926,"_5":17825,"_25222":96696,"_7710":47856},[48836],{"_12623":1350,"_48290":1254,"_18312":96928,"_5":17825,"_25222":96696,"_7710":27002},[48836],{"_12623":1351,"_48290":1254,"_18312":96930,"_5":17825,"_25222":96696,"_7710":96796},[48836],{"_12623":1352,"_48290":1254,"_18312":96932,"_5":17825,"_25222":96696,"_7710":96933},[48836],"Print help and exit.",{"_12623":1353,"_48290":1254,"_18312":96935,"_5":17825,"_25222":96696,"_7710":96936},[48836],"The mapper count is implicitly the number of source-table regions (one\nmapper per region) unless --coalesce-split is set.",{"_12623":1354,"_48290":1254,"_18312":96938,"_5":17825,"_25222":96704,"_7710":96939},[48836],"When --run-foreground is set, the tool logs counters from the\nPhoenixSyncTableMapper$SyncCounters group:",{"_12623":1355,"_48290":1254,"_18312":96941,"_5":17825,"_25222":96704,"_7710":96942},[48836],"MAPPERS_VERIFIED, MAPPERS_MISMATCHED",{"_12623":1356,"_48290":1254,"_18312":96944,"_5":17825,"_25222":96704,"_7710":96945},[48836],"CHUNKS_VERIFIED, CHUNKS_MISMATCHED",{"_12623":1357,"_48290":1254,"_18312":96947,"_5":17825,"_25222":96704,"_7710":96948},[48836],"SOURCE_ROWS_PROCESSED, TARGET_ROWS_PROCESSED",{"_12623":1358,"_48290":1254,"_18312":96950,"_5":17825,"_25222":96708,"_7710":96951},[48836],"The tool auto-creates a Phoenix table on the source cluster (90-day TTL,\nSnappy compression) with one row per chunk and per region. To list\ndivergences from the last run:",{"_12623":1359,"_48290":1254,"_18312":96953,"_5":17825,"_25222":96708,"_7710":96954},[48836],"Each row carries STATUS (VERIFIED or MISMATCHED), TYPE (CHUNK or\nREGION), the key range, and a comma-separated COUNTERS string with\nper-chunk source and target row counts.",{"_12623":1360,"_48290":1254,"_18312":96956,"_5":17825,"_25222":96712,"_7710":96957},[48836],"A re-run of the same (table, target, from-time, to-time, tenant) tuple\npicks up where the previous run left off — already-verified sub-ranges are\nskipped.",{"_12623":1361,"_48290":1254,"_18312":96959,"_5":17825,"_25222":96716,"_7710":96960},[48836],"Cross-cluster line of sight. Mapper YARN nodes need ZooKeeper and RPC\nreachability to both clusters' RegionServers.",{"_12623":1362,"_48290":1254,"_18312":96962,"_5":17825,"_25222":96716,"_7710":96963},[48836],"Both clusters must run Phoenix 5.3.1+.",{"_12623":1363,"_48290":1254,"_18312":96965,"_5":17825,"_25222":96716,"_7710":96966},[48836],"Live read, not snapshot-based. Both clusters are scanned through the\nregular Phoenix read path.",{"_12623":1364,"_48290":1254,"_18312":96968,"_5":17825,"_25222":96716,"_7710":96969},[48836],"Kerberos delegation tokens for the target cluster are acquired\nautomatically when security is enabled.",{"_12623":1365,"_48290":1254,"_18312":96971,"_5":17825,"_25222":96716,"_7710":96972},[48836],"The submitter principal needs READ on the physical HBase tables on both\nclusters, plus WRITE to PHOENIX_SYNC_TABLE_CHECKPOINT on the source.",{"_12623":1366,"_48290":1254,"_18312":96974,"_5":17825,"_25222":96716,"_7710":96975},[48836],"Views and logical (not physical) index names are rejected. Pass the\nphysical index table name to validate an index.",{"_12623":1367,"_48290":1254,"_18312":96977,"_5":17825,"_25222":96719,"_7710":96978},[48836],"--chunk-size is the main lever:",{"_12623":1368,"_48290":1254,"_18312":96980,"_5":17825,"_25222":96719,"_7710":96981},[48836],"Larger chunks (e.g. 4 GiB) reduce checkpoint rows and per-chunk overhead\nbut make every mismatch report a coarser range.",{"_12623":1369,"_48290":1254,"_18312":96983,"_5":17825,"_25222":96719,"_7710":96984},[48836],"Smaller chunks (e.g. 64 MiB) narrow the mismatch search radius and produce\nmore checkpoint rows.",{"_12623":1370,"_48290":1254,"_18312":96986,"_5":17825,"_25222":96719,"_7710":96987},[48836],"The tool runs at long-scan timescales. Adjust these client-side timeouts\n(set in the Hadoop Configuration the job is submitted with) if you see\nscanner timeouts on very large regions:",{"_12623":1371,"_48290":1254,"_18312":96989,"_5":17825,"_25222":96719,"_7710":95595},[48836],{"_12623":1372,"_48290":1254,"_18312":96991,"_5":17825,"_25222":96719,"_7710":95598},[48836],{"_12623":1373,"_48290":1254,"_18312":96993,"_5":17825,"_25222":96719,"_7710":96994},[48836],"phoenix.sync.table.query.timeout",{"_12623":1374,"_48290":1254,"_18312":96996,"_5":17825,"_25222":96719,"_7710":96997},[48836],"~150 minutes",{"_12623":1375,"_48290":1254,"_18312":96999,"_5":17825,"_25222":96719,"_7710":97000},[48836],"phoenix.sync.table.rpc.timeout",{"_12623":1376,"_48290":1254,"_18312":97002,"_5":17825,"_25222":96719,"_7710":97003},[48836],"30 minutes",{"_12623":1377,"_48290":1254,"_18312":97005,"_5":17825,"_25222":96719,"_7710":97006},[48836],"phoenix.sync.table.client.scanner.timeout",{"_12623":1378,"_48290":1254,"_18312":97008,"_5":17825,"_25222":96719,"_7710":97003},[48836],{"_12623":1379,"_48290":1254,"_18312":97010,"_5":17825,"_25222":96719,"_7710":97011},[48836],"phoenix.sync.table.rpc.retries.counter",{"_12623":1380,"_48290":1254,"_18312":97013,"_5":17825,"_25222":96719,"_7710":9473},[48836],{"_12623":1381,"_48290":1254,"_18312":97015,"_5":17825,"_25222":96722,"_7710":97016},[48836],"Detection only. Mismatched chunks are recorded but not repaired in\n5.3.1 (see Upcoming).",{"_12623":1382,"_48290":1254,"_18312":97018,"_5":17825,"_25222":96722,"_7710":97019},[48836],"No views. Only physical tables and index physical names are accepted.",{"_12623":1383,"_48290":1254,"_18312":97021,"_5":17825,"_25222":96725,"_7710":97022},[48836],"A future iteration of the tool will add a repair phase that converts\nrecorded MISMATCHED chunks into upserts on the target cluster, turning\ndetection into verify-and-repair in a single workflow. The current\n--dry-run flag is reserved for that mode.",{"_12623":1384,"_48290":1384,"_5":13058,"_7710":97024,"_48807":97025,"_18312":97026,"_25222":1384},"Query Server",[92880,92881,92882,94570],[48836],{"_12623":1385,"_48290":1384,"_18312":97028,"_5":17825,"_25222":1384,"_7710":97029},[48836],"Deploy and use Phoenix Query Server (PQS), including client access, impersonation, metrics, and load-balancing configuration.",{"_12623":1386,"_48290":1384,"_5":48804,"_18312":97031,"_25222":97032,"_7710":97033},[48836],"/docs/features/query-server#query-server-overview","Overview",{"_12623":1387,"_48290":1384,"_5":48804,"_18312":97035,"_25222":97036,"_7710":97037},[48836],"/docs/features/query-server#clients","Clients",{"_12623":1388,"_48290":1384,"_5":48804,"_18312":97039,"_25222":97040,"_7710":97041},[48836],"/docs/features/query-server#query-server-installation","Installation",{"_12623":1389,"_48290":1384,"_5":48804,"_18312":97043,"_25222":97044,"_7710":97045},[48836],"/docs/features/query-server#query-server-usage","Usage",{"_12623":1390,"_48290":1384,"_5":48804,"_18312":97047,"_25222":97048,"_7710":97049},[48836],"/docs/features/query-server#server","Server",{"_12623":1391,"_48290":1384,"_5":48804,"_18312":97051,"_25222":97052,"_7710":97053},[48836],"/docs/features/query-server#client","Client",{"_12623":1392,"_48290":1384,"_5":48804,"_18312":97055,"_25222":97056,"_7710":97057},[48836],"/docs/features/query-server#wire-api-documentation","Wire API documentation",{"_12623":1393,"_48290":1384,"_5":48804,"_18312":97059,"_25222":97060,"_7710":97061},[48836],"/docs/features/query-server#impersonation","Impersonation",{"_12623":1394,"_48290":1384,"_5":48804,"_18312":97063,"_25222":97064,"_7710":95999},[48836],"/docs/features/query-server#query-server-metrics",{"_12623":1395,"_48290":1384,"_5":48804,"_18312":97066,"_25222":97067,"_7710":92932},[48836],"/docs/features/query-server#query-server-configuration",{"_12623":1396,"_48290":1384,"_5":48804,"_18312":97069,"_25222":97070,"_7710":97071},[48836],"/docs/features/query-server#server-instantiation","Server Instantiation",{"_12623":1397,"_48290":1384,"_5":48804,"_18312":97073,"_25222":97074,"_7710":97075},[48836],"/docs/features/query-server#https","HTTPS",{"_12623":1398,"_48290":1384,"_5":48804,"_18312":97077,"_25222":97078,"_7710":97079},[48836],"/docs/features/query-server#secure-cluster-connection","Secure Cluster Connection",{"_12623":1399,"_48290":1384,"_5":48804,"_18312":97081,"_25222":97082,"_7710":97083},[48836],"/docs/features/query-server#server-connection-cache","Server Connection Cache",{"_12623":1400,"_48290":1384,"_5":48804,"_18312":97085,"_25222":97086,"_7710":97087},[48836],"/docs/features/query-server#server-statement-cache","Server Statement Cache",{"_12623":1401,"_48290":1384,"_5":48804,"_18312":97089,"_25222":97090,"_7710":97061},[48836],"/docs/features/query-server#impersonation-1",{"_12623":1402,"_48290":1384,"_5":48804,"_18312":97092,"_25222":97093,"_7710":95999},[48836],"/docs/features/query-server#query-server-metrics-config",{"_12623":1403,"_48290":1384,"_5":48804,"_18312":97095,"_25222":97096,"_7710":97097},[48836],"/docs/features/query-server#query-server-additions","Query Server Additions",{"_12623":1404,"_48290":1384,"_5":48804,"_18312":97099,"_25222":97100,"_7710":97101},[48836],"/docs/features/query-server#load-balancing","Load balancing",{"_12623":1405,"_48290":1384,"_18312":97103,"_5":17825,"_25222":1384,"_7710":97104},[48836],"The Phoenix Query Server provides an alternative means for interaction with\nPhoenix and HBase.",{"_12623":1406,"_48290":1384,"_18312":97106,"_5":17825,"_25222":97032,"_7710":97107},[48836],"Phoenix 4.4 introduces a stand-alone server that exposes Phoenix to \"thin\"\nclients. It is based on the Avatica component of\nApache Calcite. The query server is comprised of a Java server that\nmanages Phoenix Connections on the clients' behalf.",{"_12623":1407,"_48290":1384,"_18312":97109,"_5":17825,"_25222":97032,"_7710":97110},[48836],"With the introduction of the\nProtobuf transport, Avatica is moving towards backwards compatibility with the\nprovided thin JDBC driver. There are no such backwards compatibility guarantees\nfor the JSON API.",{"_12623":1408,"_48290":1384,"_18312":97112,"_5":17825,"_25222":97032,"_7710":97113},[48836],"To repeat, there is no guarantee of backwards compatibility with the JSON transport;\nhowever, compatibility with the Protobuf transport is stabilizing (although, not\ntested thoroughly enough to be stated as \"guaranteed\").",{"_12623":1409,"_48290":1384,"_18312":97115,"_5":17825,"_25222":97036,"_7710":97116},[48836],"The primary client implementation\nis currently a JDBC driver with minimal dependencies. The default and\nprimary transport mechanism since Phoenix 4.7 is Protobuf, the older JSON mechanism can still\nbe enabled.\nThe distribution includes the sqlline-thin.py CLI client that uses the JDBC thin client.",{"_12623":1410,"_48290":1384,"_18312":97118,"_5":17825,"_25222":97036,"_7710":97119},[48836],"The Phoenix project also maintains the Python driver\nphoenixdb.",{"_12623":1411,"_48290":1384,"_18312":97121,"_5":17825,"_25222":97036,"_7710":97122},[48836],"The Avatica Go client\ncan also be used.",{"_12623":1412,"_48290":1384,"_18312":97124,"_5":17825,"_25222":97036,"_7710":97125},[48836],"Proprietary ODBC drivers are also available for Windows and Linux.",{"_12623":1413,"_48290":1384,"_18312":97127,"_5":17825,"_25222":97040,"_7710":97128},[48836],"In the 4.4-4.14 and 5.0 releases the query server and its JDBC client are part of the standard Phoenix\ndistribution. They require no additional dependencies or installation.",{"_12623":1414,"_48290":1384,"_18312":97130,"_5":17825,"_25222":97040,"_7710":97131},[48836],"After the 4.15 and 5.1 release, the query server has been unbundled into the phoenix-queryserver\nrepository, and its version number has been reset to 6.0.",{"_12623":1415,"_48290":1384,"_18312":97133,"_5":17825,"_25222":97040,"_7710":97134},[48836],"Download the latest source or binary release from the\nDownload page,\nor check out the development version from\nGitHub.",{"_12623":1416,"_48290":1384,"_18312":97136,"_5":17825,"_25222":97040,"_7710":97137},[48836],"Either unpack the binary distribution, or build it from source. See BUILDING.md\nin the source distribution on how to build.",{"_12623":1417,"_48290":1384,"_18312":97139,"_5":17825,"_25222":97048,"_7710":97140},[48836],"The standalone Query Server distribution does not contain the necessary\nPhoenix (thick) client library by default.",{"_12623":1418,"_48290":1384,"_18312":97142,"_5":17825,"_25222":97048,"_7710":97143},[48836],"If using the standalone library you will either need to rebuild it from source to include the\nclient library (See BUILDING.md), or manually copy the phoenix thick client library\ninto the installation directory.",{"_12623":1419,"_48290":1384,"_18312":97145,"_5":17825,"_25222":97048,"_7710":97146},[48836],"The server component is managed through bin/queryserver.py. Its usage is as\nfollows",{"_12623":1420,"_48290":1384,"_18312":97148,"_5":17825,"_25222":97048,"_7710":97149},[48836],"When invoked with no arguments, the query server is launched in the foreground,\nwith logging directed to the console.",{"_12623":1421,"_48290":1384,"_18312":97151,"_5":17825,"_25222":97048,"_7710":97152},[48836],"The first argument is an optional start or stop command to the daemon. When\neither of these are provided, it will take appropriate action on a daemon\nprocess, if it exists.",{"_12623":1422,"_48290":1384,"_18312":97154,"_5":17825,"_25222":97048,"_7710":97155},[48836],"Any subsequent arguments are passed to the main class for interpretation.",{"_12623":1423,"_48290":1384,"_18312":97157,"_5":17825,"_25222":97048,"_7710":97158},[48836],"The server is packaged in a standalone jar,\nphoenix-queryserver-<version>.jar. This jar, the phoenix-client.jar and HBASE_CONF_DIR on the\nclasspath are all that is required to launch the server.",{"_12623":1424,"_48290":1384,"_18312":97160,"_5":17825,"_25222":97052,"_7710":97161},[48836],"Phoenix provides two mechanisms for interacting with the query server. A JDBC\ndriver is provided in the standalone\nphoenix-queryserver-client-<version>.jar. The script\nbin/sqlline-thin.py is available for the command line.",{"_12623":1425,"_48290":1384,"_18312":97163,"_5":17825,"_25222":97052,"_7710":97164},[48836],"The JDBC connection string is composed as follows:",{"_12623":1426,"_48290":1384,"_18312":97166,"_5":17825,"_25222":97052,"_7710":97167},[48836],"<scheme> specifies the transport protocol (http or https) used when communicating with the\nserver.",{"_12623":1427,"_48290":1384,"_18312":97169,"_5":17825,"_25222":97052,"_7710":97170},[48836],"<server-hostname> is the name of the host offering the service.",{"_12623":1428,"_48290":1384,"_18312":97172,"_5":17825,"_25222":97052,"_7710":97173},[48836],"<port> is the port number on which the host is listening. Default is 8765,\nthough this is configurable (see below).",{"_12623":1429,"_48290":1384,"_18312":97175,"_5":17825,"_25222":97052,"_7710":97176},[48836],"The full list of options that can be provided via the JDBC URL string is available\nin the Avatica documentation.",{"_12623":1430,"_48290":1384,"_18312":97178,"_5":17825,"_25222":97052,"_7710":97179},[48836],"The script bin/sqlline-thin.py is intended to behave identically to its\nsibling script bin/sqlline.py. It supports the following usage options.",{"_12623":1431,"_48290":1384,"_18312":97181,"_5":17825,"_25222":97052,"_7710":97182},[48836],"The first optional argument is a connection URL, as described previously. When\nnot provided, scheme defaults to http, host to localhost, and port to\n8765.",{"_12623":1432,"_48290":1384,"_18312":97184,"_5":17825,"_25222":97052,"_7710":97185},[48836],"The second optional parameter is a sql file from which to read commands.",{"_12623":1433,"_48290":1384,"_18312":97187,"_5":17825,"_25222":97056,"_7710":97188},[48836],"The API itself is documented in the Apache Calcite project as it is the Avatica\nAPI -- there is no wire API defined in Phoenix itself.",{"_12623":1434,"_48290":1384,"_18312":97190,"_5":17825,"_25222":97056,"_7710":97191},[48836],"JSON API",{"_12623":1435,"_48290":1384,"_18312":97193,"_5":17825,"_25222":97056,"_7710":97194},[48836],"Protocol Buffer API",{"_12623":1436,"_48290":1384,"_18312":97196,"_5":17825,"_25222":97056,"_7710":97197},[48836],"For more information in building clients in other languages that work with\nAvatica, please feel free to reach out to the Apache Calcite dev mailing list.",{"_12623":1437,"_48290":1384,"_18312":97199,"_5":17825,"_25222":97060,"_7710":97200},[48836],"By default, the Phoenix Query Server executes queries on behalf of the end-user. HBase permissions\nare enforced given the end-user, not the Phoenix Query Server's identity. In some cases, it may\nbe desirable to execute the query as some other user -- this is referred to as \"impersonation\".\nThis can enable workflows where a trusted user has the privilege to run queries for other users.",{"_12623":1438,"_48290":1384,"_18312":97202,"_5":17825,"_25222":97060,"_7710":97203},[48836],"This can be enabled by setting the configuration property phoenix.queryserver.withRemoteUserExtractor\nto true. The URL of the Query Server can be modified to include the required request parameter.\nFor example, to let \"bob\" to run a query as \"alice\", the following JDBC URL could be used:",{"_12623":1439,"_48290":1384,"_18312":97205,"_5":17825,"_25222":97060,"_7710":97206},[48836],"The standard Hadoop \"proxyuser\" configuration keys are checked to validate if the \"real\" remote user\nis allowed to impersonate the \"doAs\" user. See the Hadoop documentation\nfor more information on how to configure these rules.",{"_12623":1440,"_48290":1384,"_18312":97208,"_5":17825,"_25222":97060,"_7710":97209},[48836],"As a word of warning: there is no end-to-end test coverage for the HBase 0.98 and 1.1 Phoenix releases\nbecause of missing test-related code in those HBase releases. While we expect no issues on these\nPhoenix release lines, we recommend additional testing by the user to verify that there are no issues.",{"_12623":1441,"_48290":1384,"_18312":97211,"_5":17825,"_25222":97064,"_7710":97212},[48836],"By default, the Phoenix Query Server exposes various Phoenix global client metrics via JMX (for HBase versions 1.3 and up).\nThe list of metrics are available here.",{"_12623":1442,"_48290":1384,"_18312":97214,"_5":17825,"_25222":97064,"_7710":97215},[48836],"PQS Metrics use Hadoop Metrics 2 internally for metrics publishing. Hence it publishes various JVM related metrics. Metrics can be filtered based on certain tags, which can be configured by the property specified in hbase-site.xml on the classpath. Further details are provided in Configuration section.",{"_12623":1443,"_48290":1384,"_18312":97217,"_5":17825,"_25222":97067,"_7710":97218},[48836],"Server components are spread across a number of java packages, so effective\nlogging configuration requires updating multiple packages. The default server\nlogging configuration sets the following log levels:",{"_12623":1444,"_48290":1384,"_18312":97220,"_5":17825,"_25222":97067,"_7710":97221},[48836],"As of the time of writing, the underlying Avatica component respects the\nfollowing configuration options exposed via hbase-site.xml.",{"_12623":1445,"_48290":1384,"_18312":97223,"_5":17825,"_25222":97070,"_7710":95595},[48836],{"_12623":1446,"_48290":1384,"_18312":97225,"_5":17825,"_25222":97070,"_7710":94969},[48836],{"_12623":1447,"_48290":1384,"_18312":97227,"_5":17825,"_25222":97070,"_7710":95598},[48836],{"_12623":1448,"_48290":1384,"_18312":97229,"_5":17825,"_25222":97070,"_7710":97230},[48836],"phoenix.queryserver.http.port",{"_12623":1449,"_48290":1384,"_18312":97232,"_5":17825,"_25222":97070,"_7710":97233},[48836],"Port the server listens on.",{"_12623":1450,"_48290":1384,"_18312":97235,"_5":17825,"_25222":97070,"_7710":48024},[48836],{"_12623":1451,"_48290":1384,"_18312":97237,"_5":17825,"_25222":97070,"_7710":97238},[48836],"phoenix.queryserver.metafactory.class",{"_12623":1452,"_48290":1384,"_18312":97240,"_5":17825,"_25222":97070,"_7710":97241},[48836],"Avatica Meta.Factory implementation class.",{"_12623":1453,"_48290":1384,"_18312":97243,"_5":17825,"_25222":97070,"_7710":97244},[48836],"org.apache.phoenix.queryserver.server.PhoenixMetaFactoryImpl",{"_12623":1454,"_48290":1384,"_18312":97246,"_5":17825,"_25222":97070,"_7710":97247},[48836],"phoenix.queryserver.serialization",{"_12623":1455,"_48290":1384,"_18312":97249,"_5":17825,"_25222":97070,"_7710":97250},[48836],"Transport/serialization format (PROTOBUF or JSON).",{"_12623":1456,"_48290":1384,"_18312":97252,"_5":17825,"_25222":97070,"_7710":97253},[48836],"PROTOBUF",{"_12623":1457,"_48290":1384,"_18312":97255,"_5":17825,"_25222":97074,"_7710":97256},[48836],"HTTPS support is only available in unbundled phoenix-queryserver versions.",{"_12623":1458,"_48290":1384,"_18312":97258,"_5":17825,"_25222":97074,"_7710":95595},[48836],{"_12623":1459,"_48290":1384,"_18312":97260,"_5":17825,"_25222":97074,"_7710":94969},[48836],{"_12623":1460,"_48290":1384,"_18312":97262,"_5":17825,"_25222":97074,"_7710":95598},[48836],{"_12623":1461,"_48290":1384,"_18312":97264,"_5":17825,"_25222":97074,"_7710":97265},[48836],"phoenix.queryserver.tls.enabled",{"_12623":1462,"_48290":1384,"_18312":97267,"_5":17825,"_25222":97074,"_7710":97268},[48836],"Enables HTTPS transport. When enabled, keystore/truststore files and passwords are also required.",{"_12623":1463,"_48290":1384,"_18312":97270,"_5":17825,"_25222":97074,"_7710":26233},[48836],{"_12623":1464,"_48290":1384,"_18312":97272,"_5":17825,"_25222":97074,"_7710":97273},[48836],"phoenix.queryserver.tls.keystore",{"_12623":1465,"_48290":1384,"_18312":97275,"_5":17825,"_25222":97074,"_7710":97276},[48836],"Keystore file containing the HTTPS private key.",{"_12623":1466,"_48290":1384,"_18312":97278,"_5":17825,"_25222":97074,"_7710":25045},[48836],{"_12623":1467,"_48290":1384,"_18312":97280,"_5":17825,"_25222":97074,"_7710":97281},[48836],"phoenix.queryserver.tls.keystore.password",{"_12623":1468,"_48290":1384,"_18312":97283,"_5":17825,"_25222":97074,"_7710":97284},[48836],"Password for HTTPS keystore.",{"_12623":1469,"_48290":1384,"_18312":97286,"_5":17825,"_25222":97074,"_7710":97287},[48836],"empty string",{"_12623":1470,"_48290":1384,"_18312":97289,"_5":17825,"_25222":97074,"_7710":97290},[48836],"phoenix.queryserver.tls.truststore",{"_12623":1471,"_48290":1384,"_18312":97292,"_5":17825,"_25222":97074,"_7710":97293},[48836],"Keystore file containing the HTTPS certificate.",{"_12623":1472,"_48290":1384,"_18312":97295,"_5":17825,"_25222":97074,"_7710":25045},[48836],{"_12623":1473,"_48290":1384,"_18312":97297,"_5":17825,"_25222":97074,"_7710":97298},[48836],"phoenix.queryserver.tls.truststore.password",{"_12623":1474,"_48290":1384,"_18312":97300,"_5":17825,"_25222":97074,"_7710":97301},[48836],"Password for HTTPS truststore.",{"_12623":1475,"_48290":1384,"_18312":97303,"_5":17825,"_25222":97074,"_7710":97287},[48836],{"_12623":1476,"_48290":1384,"_18312":97305,"_5":17825,"_25222":97078,"_7710":95595},[48836],{"_12623":1477,"_48290":1384,"_18312":97307,"_5":17825,"_25222":97078,"_7710":94969},[48836],{"_12623":1478,"_48290":1384,"_18312":97309,"_5":17825,"_25222":97078,"_7710":95598},[48836],{"_12623":1479,"_48290":1384,"_18312":97311,"_5":17825,"_25222":97078,"_7710":97312},[48836],"hbase.security.authentication",{"_12623":1480,"_48290":1384,"_18312":97314,"_5":17825,"_25222":97078,"_7710":97315},[48836],"When set to kerberos, server logs in before initiating Phoenix connections.",{"_12623":1481,"_48290":1384,"_18312":97317,"_5":17825,"_25222":97078,"_7710":97318},[48836],"specified in hbase-default.xml",{"_12623":1482,"_48290":1384,"_18312":97320,"_5":17825,"_25222":97078,"_7710":97321},[48836],"phoenix.queryserver.keytab.file",{"_12623":1483,"_48290":1384,"_18312":97323,"_5":17825,"_25222":97078,"_7710":97324},[48836],"Key for keytab file lookup.",{"_12623":1484,"_48290":1384,"_18312":97326,"_5":17825,"_25222":97078,"_7710":25045},[48836],{"_12623":1485,"_48290":1384,"_18312":97328,"_5":17825,"_25222":97078,"_7710":97329},[48836],"phoenix.queryserver.kerberos.principal",{"_12623":1486,"_48290":1384,"_18312":97331,"_5":17825,"_25222":97078,"_7710":97332},[48836],"Kerberos principal for authentication; also used for SPNEGO if HTTP principal is not configured.",{"_12623":1487,"_48290":1384,"_18312":97334,"_5":17825,"_25222":97078,"_7710":25045},[48836],{"_12623":1488,"_48290":1384,"_18312":97336,"_5":17825,"_25222":97078,"_7710":97337},[48836],"phoenix.queryserver.http.keytab.file",{"_12623":1489,"_48290":1384,"_18312":97339,"_5":17825,"_25222":97078,"_7710":97340},[48836],"Keytab for SPNEGO auth; required if phoenix.queryserver.kerberos.http.principal is set; falls back to phoenix.queryserver.keytab.file.",{"_12623":1490,"_48290":1384,"_18312":97342,"_5":17825,"_25222":97078,"_7710":25045},[48836],{"_12623":1491,"_48290":1384,"_18312":97344,"_5":17825,"_25222":97078,"_7710":97345},[48836],"phoenix.queryserver.http.kerberos.principal",{"_12623":1492,"_48290":1384,"_18312":97347,"_5":17825,"_25222":97078,"_7710":97348},[48836],"Kerberos principal for SPNEGO auth; falls back to phoenix.queryserver.kerberos.principal.",{"_12623":1493,"_48290":1384,"_18312":97350,"_5":17825,"_25222":97078,"_7710":25045},[48836],{"_12623":1494,"_48290":1384,"_18312":97352,"_5":17825,"_25222":97078,"_7710":97353},[48836],"phoenix.queryserver.kerberos.http.principal",{"_12623":1495,"_48290":1384,"_18312":97355,"_5":17825,"_25222":97078,"_7710":97356},[48836],"Deprecated; use phoenix.queryserver.http.kerberos.principal.",{"_12623":1496,"_48290":1384,"_18312":97358,"_5":17825,"_25222":97078,"_7710":25045},[48836],{"_12623":1497,"_48290":1384,"_18312":97360,"_5":17825,"_25222":97078,"_7710":97361},[48836],"phoenix.queryserver.kerberos.allowed.realms",{"_12623":1498,"_48290":1384,"_18312":97363,"_5":17825,"_25222":97078,"_7710":97364},[48836],"Additional Kerberos realms allowed for SPNEGO auth.",{"_12623":1499,"_48290":1384,"_18312":97366,"_5":17825,"_25222":97078,"_7710":25045},[48836],{"_12623":1500,"_48290":1384,"_18312":97368,"_5":17825,"_25222":97078,"_7710":97369},[48836],"phoenix.queryserver.dns.nameserver",{"_12623":1501,"_48290":1384,"_18312":97371,"_5":17825,"_25222":97078,"_7710":97372},[48836],"DNS hostname.",{"_12623":1502,"_48290":1384,"_18312":97374,"_5":17825,"_25222":97078,"_7710":29518},[48836],{"_12623":1503,"_48290":1384,"_18312":97376,"_5":17825,"_25222":97078,"_7710":97377},[48836],"phoenix.queryserver.dns.interface",{"_12623":1504,"_48290":1384,"_18312":97379,"_5":17825,"_25222":97078,"_7710":97380},[48836],"Network interface name for DNS queries.",{"_12623":1505,"_48290":1384,"_18312":97382,"_5":17825,"_25222":97078,"_7710":29518},[48836],{"_12623":1506,"_48290":1384,"_18312":97384,"_5":17825,"_25222":97082,"_7710":95595},[48836],{"_12623":1507,"_48290":1384,"_18312":97386,"_5":17825,"_25222":97082,"_7710":94969},[48836],{"_12623":1508,"_48290":1384,"_18312":97388,"_5":17825,"_25222":97082,"_7710":95598},[48836],{"_12623":1509,"_48290":1384,"_18312":97390,"_5":17825,"_25222":97082,"_7710":97391},[48836],"avatica.connectioncache.concurrency",{"_12623":1510,"_48290":1384,"_18312":97393,"_5":17825,"_25222":97082,"_7710":97394},[48836],"Connection cache concurrency level.",{"_12623":1511,"_48290":1384,"_18312":97396,"_5":17825,"_25222":97082,"_7710":9344},[48836],{"_12623":1512,"_48290":1384,"_18312":97398,"_5":17825,"_25222":97082,"_7710":97399},[48836],"avatica.connectioncache.initialcapacity",{"_12623":1513,"_48290":1384,"_18312":97401,"_5":17825,"_25222":97082,"_7710":97402},[48836],"Connection cache initial capacity.",{"_12623":1514,"_48290":1384,"_18312":97404,"_5":17825,"_25222":97082,"_7710":45547},[48836],{"_12623":1515,"_48290":1384,"_18312":97406,"_5":17825,"_25222":97082,"_7710":97407},[48836],"avatica.connectioncache.maxcapacity",{"_12623":1516,"_48290":1384,"_18312":97409,"_5":17825,"_25222":97082,"_7710":97410},[48836],"Connection cache maximum capacity; LRU eviction begins near this point.",{"_12623":1517,"_48290":1384,"_18312":97412,"_5":17825,"_25222":97082,"_7710":45578},[48836],{"_12623":1518,"_48290":1384,"_18312":97414,"_5":17825,"_25222":97082,"_7710":97415},[48836],"avatica.connectioncache.expiryduration",{"_12623":1519,"_48290":1384,"_18312":97417,"_5":17825,"_25222":97082,"_7710":97418},[48836],"Connection cache expiration duration.",{"_12623":1520,"_48290":1384,"_18312":97420,"_5":17825,"_25222":97082,"_7710":9344},[48836],{"_12623":1521,"_48290":1384,"_18312":97422,"_5":17825,"_25222":97082,"_7710":97423},[48836],"avatica.connectioncache.expiryunit",{"_12623":1522,"_48290":1384,"_18312":97425,"_5":17825,"_25222":97082,"_7710":97426},[48836],"Time unit for avatica.connectioncache.expiryduration.",{"_12623":1523,"_48290":1384,"_18312":97428,"_5":17825,"_25222":97082,"_7710":97429},[48836],"MINUTES",{"_12623":1524,"_48290":1384,"_18312":97431,"_5":17825,"_25222":97086,"_7710":95595},[48836],{"_12623":1525,"_48290":1384,"_18312":97433,"_5":17825,"_25222":97086,"_7710":94969},[48836],{"_12623":1526,"_48290":1384,"_18312":97435,"_5":17825,"_25222":97086,"_7710":95598},[48836],{"_12623":1527,"_48290":1384,"_18312":97437,"_5":17825,"_25222":97086,"_7710":97438},[48836],"avatica.statementcache.concurrency",{"_12623":1528,"_48290":1384,"_18312":97440,"_5":17825,"_25222":97086,"_7710":97441},[48836],"Statement cache concurrency level.",{"_12623":1529,"_48290":1384,"_18312":97443,"_5":17825,"_25222":97086,"_7710":45547},[48836],{"_12623":1530,"_48290":1384,"_18312":97445,"_5":17825,"_25222":97086,"_7710":97446},[48836],"avatica.statementcache.initialcapacity",{"_12623":1531,"_48290":1384,"_18312":97448,"_5":17825,"_25222":97086,"_7710":97449},[48836],"Statement cache initial capacity.",{"_12623":1532,"_48290":1384,"_18312":97451,"_5":17825,"_25222":97086,"_7710":45578},[48836],{"_12623":1533,"_48290":1384,"_18312":97453,"_5":17825,"_25222":97086,"_7710":97454},[48836],"avatica.statementcache.maxcapacity",{"_12623":1534,"_48290":1384,"_18312":97456,"_5":17825,"_25222":97086,"_7710":97457},[48836],"Statement cache maximum capacity; LRU eviction begins near this point.",{"_12623":1535,"_48290":1384,"_18312":97459,"_5":17825,"_25222":97086,"_7710":45595},[48836],{"_12623":1536,"_48290":1384,"_18312":97461,"_5":17825,"_25222":97086,"_7710":97462},[48836],"avatica.statementcache.expiryduration",{"_12623":1537,"_48290":1384,"_18312":97464,"_5":17825,"_25222":97086,"_7710":97465},[48836],"Statement cache expiration duration.",{"_12623":1538,"_48290":1384,"_18312":97467,"_5":17825,"_25222":97086,"_7710":9473},[48836],{"_12623":1539,"_48290":1384,"_18312":97469,"_5":17825,"_25222":97086,"_7710":97470},[48836],"avatica.statementcache.expiryunit",{"_12623":1540,"_48290":1384,"_18312":97472,"_5":17825,"_25222":97086,"_7710":97473},[48836],"Time unit for avatica.statementcache.expiryduration.",{"_12623":1541,"_48290":1384,"_18312":97475,"_5":17825,"_25222":97086,"_7710":97429},[48836],{"_12623":1542,"_48290":1384,"_18312":97477,"_5":17825,"_25222":97090,"_7710":95595},[48836],{"_12623":1543,"_48290":1384,"_18312":97479,"_5":17825,"_25222":97090,"_7710":94969},[48836],{"_12623":1544,"_48290":1384,"_18312":97481,"_5":17825,"_25222":97090,"_7710":95598},[48836],{"_12623":1545,"_48290":1384,"_18312":97483,"_5":17825,"_25222":97090,"_7710":97484},[48836],"phoenix.queryserver.withRemoteUserExtractor",{"_12623":1546,"_48290":1384,"_18312":97486,"_5":17825,"_25222":97090,"_7710":97487},[48836],"If true, extracts impersonated user from request param instead of authenticated HTTP user.",{"_12623":1547,"_48290":1384,"_18312":97489,"_5":17825,"_25222":97090,"_7710":26233},[48836],{"_12623":1548,"_48290":1384,"_18312":97491,"_5":17825,"_25222":97090,"_7710":97492},[48836],"phoenix.queryserver.remoteUserExtractor.param",{"_12623":1549,"_48290":1384,"_18312":97494,"_5":17825,"_25222":97090,"_7710":97495},[48836],"HTTP request parameter name for impersonated user.",{"_12623":1550,"_48290":1384,"_18312":97497,"_5":17825,"_25222":97090,"_7710":97498},[48836],"doAs",{"_12623":1551,"_48290":1384,"_18312":97500,"_5":17825,"_25222":97093,"_7710":95595},[48836],{"_12623":1552,"_48290":1384,"_18312":97502,"_5":17825,"_25222":97093,"_7710":94969},[48836],{"_12623":1553,"_48290":1384,"_18312":97504,"_5":17825,"_25222":97093,"_7710":95598},[48836],{"_12623":1554,"_48290":1384,"_18312":97506,"_5":17825,"_25222":97093,"_7710":97507},[48836],"phoenix.client.metrics.tag",{"_12623":1555,"_48290":1384,"_18312":97509,"_5":17825,"_25222":97093,"_7710":97510},[48836],"Tag for filtering Phoenix global client metrics emitted by PQS in hadoop-metrics2.properties.",{"_12623":1556,"_48290":1384,"_18312":97512,"_5":17825,"_25222":97093,"_7710":97513},[48836],"FAT_CLIENT",{"_12623":1557,"_48290":1384,"_18312":97515,"_5":17825,"_25222":97096,"_7710":97516},[48836],"The Phoenix Query Server is meant to be horizontally scalable which means that it\nis a natural fit for add-on features like service discovery and load balancing.",{"_12623":1558,"_48290":1384,"_18312":97518,"_5":17825,"_25222":97100,"_7710":97519},[48836],"The Query Server can use off-the-shelf HTTP load balancers such as the Apache HTTP Server,\nnginx, or HAProxy. The primary requirement of\nusing these load balancers is that the implementation must implement \"sticky session\" (when a client\ncommunicates with a backend server, that client continues to talk to that backend server). The Query Server also\nprovides some bundled functionality for load balancing using ZooKeeper.",{"_12623":1559,"_48290":1384,"_18312":97521,"_5":17825,"_25222":97100,"_7710":97522},[48836],"The ZooKeeper-based load balancer functions by automatically registering PQS instances in\nZooKeeper and then allows clients to query the list of available servers. This implementation, unlike\nthe others mentioned above, requires that client use the advertised information to make a routing decision.\nIn this regard, this ZooKeeper-based approach is more akin to a service-discovery layer than a traditional\nload balancer. This load balancer implementation does not support SASL-based (Kerberos) ACLs in\nZooKeeper (see PHOENIX-4085).",{"_12623":1560,"_48290":1384,"_18312":97524,"_5":17825,"_25222":97100,"_7710":97525},[48836],"The following properties configure this load balancer:",{"_12623":1561,"_48290":1384,"_18312":97527,"_5":17825,"_25222":97100,"_7710":95595},[48836],{"_12623":1562,"_48290":1384,"_18312":97529,"_5":17825,"_25222":97100,"_7710":94969},[48836],{"_12623":1563,"_48290":1384,"_18312":97531,"_5":17825,"_25222":97100,"_7710":95598},[48836],{"_12623":1564,"_48290":1384,"_18312":97533,"_5":17825,"_25222":97100,"_7710":97534},[48836],"phoenix.queryserver.loadbalancer.enabled",{"_12623":1565,"_48290":1384,"_18312":97536,"_5":17825,"_25222":97100,"_7710":97537},[48836],"If true, PQS registers itself in ZooKeeper for load balancing.",{"_12623":1566,"_48290":1384,"_18312":97539,"_5":17825,"_25222":97100,"_7710":26233},[48836],{"_12623":1567,"_48290":1384,"_18312":97541,"_5":17825,"_25222":97100,"_7710":97542},[48836],"phoenix.queryserver.base.path",{"_12623":1568,"_48290":1384,"_18312":97544,"_5":17825,"_25222":97100,"_7710":97545},[48836],"Root znode where PQS instances register themselves.",{"_12623":1569,"_48290":1384,"_18312":97547,"_5":17825,"_25222":97100,"_7710":97548},[48836],"/phoenix",{"_12623":1570,"_48290":1384,"_18312":97550,"_5":17825,"_25222":97100,"_7710":97551},[48836],"phoenix.queryserver.service.name",{"_12623":1571,"_48290":1384,"_18312":97553,"_5":17825,"_25222":97100,"_7710":97554},[48836],"Unique name to identify this PQS instance.",{"_12623":1572,"_48290":1384,"_18312":97556,"_5":17825,"_25222":97100,"_7710":9291},[48836],{"_12623":1573,"_48290":1384,"_18312":97558,"_5":17825,"_25222":97100,"_7710":97559},[48836],"phoenix.queryserver.zookeeper.acl.username",{"_12623":1574,"_48290":1384,"_18312":97561,"_5":17825,"_25222":97100,"_7710":97562},[48836],"Username for optional DIGEST ZooKeeper ACL.",{"_12623":1575,"_48290":1384,"_18312":97564,"_5":17825,"_25222":97100,"_7710":7748},[48836],{"_12623":1576,"_48290":1384,"_18312":97566,"_5":17825,"_25222":97100,"_7710":97567},[48836],"phoenix.queryserver.zookeeper.acl.password",{"_12623":1577,"_48290":1384,"_18312":97569,"_5":17825,"_25222":97100,"_7710":97570},[48836],"Password for optional DIGEST ZooKeeper ACL.",{"_12623":1578,"_48290":1384,"_18312":97572,"_5":17825,"_25222":97100,"_7710":7748},[48836],{"_12623":1579,"_48290":1579,"_5":13058,"_7710":97574,"_48807":97575,"_18312":97576,"_25222":1579},"ROW_SIZE() and RAW_ROW_SIZE()",[92880,92881,92882,94570],[48836],{"_12623":1580,"_48290":1579,"_18312":97578,"_5":17825,"_25222":1579,"_7710":97579},[48836],"Built-in SQL functions that return the on-the-wire HBase byte footprint of a row — useful for hot-row diagnosis, capacity planning, and finding outliers directly from SQL.",{"_12623":1581,"_48290":1579,"_5":48804,"_18312":97581,"_25222":97582,"_7710":97045},[48836],"/docs/features/row-size#row-size-usage",{"_12623":1582,"_48290":1579,"_5":48804,"_18312":97584,"_25222":97585,"_7710":97586},[48836],"/docs/features/row-size#total-table-footprint","Total table footprint",{"_12623":1583,"_48290":1579,"_5":48804,"_18312":97588,"_25222":97589,"_7710":97590},[48836],"/docs/features/row-size#per-row-size","Per-row size",{"_12623":1584,"_48290":1579,"_5":48804,"_18312":97592,"_25222":97593,"_7710":97594},[48836],"/docs/features/row-size#distribution","Distribution",{"_12623":1585,"_48290":1579,"_5":48804,"_18312":97596,"_25222":97597,"_7710":97598},[48836],"/docs/features/row-size#find-rows-whose-footprint-exceeds-a-threshold","Find rows whose footprint exceeds a threshold",{"_12623":1586,"_48290":1579,"_5":48804,"_18312":97600,"_25222":97601,"_7710":97602},[48836],"/docs/features/row-size#including-delete-markers-and-old-versions","Including delete markers and old versions",{"_12623":1587,"_48290":1579,"_5":48804,"_18312":97604,"_25222":97605,"_7710":97606},[48836],"/docs/features/row-size#row-size-caveats","Limitations and caveats",{"_12623":1588,"_48290":1579,"_5":48804,"_18312":97608,"_25222":97609,"_7710":95532},[48836],"/docs/features/row-size#row-size-see-also",{"_12623":1589,"_48290":1579,"_18312":97611,"_5":17825,"_25222":1579,"_7710":97612},[48836],"ROW_SIZE() and RAW_ROW_SIZE() return the HBase byte footprint of the row\ncurrently being scanned. Both are zero-argument scalar functions that return\nUNSIGNED_LONG. Available in Phoenix 5.3.1\n(PHOENIX-7705).",{"_12623":1590,"_48290":1579,"_18312":97614,"_5":17825,"_25222":1579,"_7710":97615},[48836],"ROW_SIZE()",{"_12623":1591,"_48290":1579,"_18312":97617,"_5":17825,"_25222":1579,"_7710":97618},[48836],"RAW_ROW_SIZE()",{"_12623":1592,"_48290":1579,"_18312":97620,"_5":17825,"_25222":1579,"_7710":97621},[48836],"Arguments",{"_12623":1593,"_48290":1579,"_18312":97623,"_5":17825,"_25222":1579,"_7710":44123},[48836],{"_12623":1594,"_48290":1579,"_18312":97625,"_5":17825,"_25222":1579,"_7710":44123},[48836],{"_12623":1595,"_48290":1579,"_18312":97627,"_5":17825,"_25222":1579,"_7710":97628},[48836],"Return type",{"_12623":1596,"_48290":1579,"_18312":97630,"_5":17825,"_25222":1579,"_7710":97631},[48836],"UNSIGNED_LONG",{"_12623":1597,"_48290":1579,"_18312":97633,"_5":17825,"_25222":1579,"_7710":97631},[48836],{"_12623":1598,"_48290":1579,"_18312":97635,"_5":17825,"_25222":1579,"_7710":97636},[48836],"Counts",{"_12623":1599,"_48290":1579,"_18312":97638,"_5":17825,"_25222":1579,"_7710":97639},[48836],"latest visible version of each cell",{"_12623":1600,"_48290":1579,"_18312":97641,"_5":17825,"_25222":1579,"_7710":97642},[48836],"all retained cell versions and delete markers",{"_12623":1601,"_48290":1579,"_18312":97644,"_5":17825,"_25222":1579,"_7710":97645},[48836],"Each cell's contribution is its full HBase footprint — row key, column\nfamily, qualifier, timestamp, type byte, tags, and value — so the result is\nnot equal to the sum of user-visible column value lengths.",{"_12623":1602,"_48290":1579,"_18312":97647,"_5":17825,"_25222":97582,"_7710":97648},[48836],"ROW_SIZE() is only valid as an argument to an aggregate in the SELECT\nlist, or inside a WHERE clause. A bare projection (SELECT ROW_SIZE() FROM t)\nis rejected at compile time.",{"_12623":1603,"_48290":1579,"_18312":97650,"_5":17825,"_25222":97589,"_7710":97651},[48836],"Group by the primary key so each group is a single row:",{"_12623":1604,"_48290":1579,"_18312":97653,"_5":17825,"_25222":97597,"_7710":97654},[48836],"ROW_SIZE() is also valid in WHERE:",{"_12623":1605,"_48290":1579,"_18312":97656,"_5":17825,"_25222":97601,"_7710":97657},[48836],"RAW_ROW_SIZE() counts every retained cell version and the bytes of any\ndelete-family or delete-column tombstones — useful for measuring the\npost-compaction-debt footprint of a row.",{"_12623":1606,"_48290":1579,"_18312":97659,"_5":17825,"_25222":97605,"_7710":97660},[48836],"Wrap in an aggregate. SELECT ROW_SIZE() FROM t is rejected. Use\nSUM(ROW_SIZE()) (with GROUP BY <pk> for per-row values).",{"_12623":1607,"_48290":1579,"_18312":97662,"_5":17825,"_25222":97605,"_7710":97663},[48836],"Forces a full row read. A query using either function reads more bytes\nper row than the same query without it, because the scan can no longer\nuse empty-column / key-only / encoded-qualifier optimizations. Reach for\nthese functions for diagnostics, not hot-path scans.",{"_12623":1608,"_48290":1579,"_18312":97665,"_5":17825,"_25222":97605,"_7710":97666},[48836],"RAW_ROW_SIZE() reads all versions and tombstones. Both the byte count\nand the row count it produces will exceed ROW_SIZE() on the same data.",{"_12623":1609,"_48290":1579,"_18312":97668,"_5":17825,"_25222":97605,"_7710":97669},[48836],"Cell footprint, not user-data size. Adding a column generally\nincreases ROW_SIZE() by more than that column's value byte length.",{"_12623":1610,"_48290":1579,"_18312":97671,"_5":17825,"_25222":97605,"_7710":97672},[48836],"Measures whatever physical row the planner scans. If the optimizer\nchooses a secondary index, ROW_SIZE() will measure the index row, not\nthe data row. Pin the plan with a hint (e.g. /*+ NO_INDEX */) if you\nneed a specific physical answer.",{"_12623":1611,"_48290":1579,"_18312":97674,"_5":17825,"_25222":97609,"_7710":97675},[48836],"Metrics — runtime measurements on the client\nside (scan bytes, mutation bytes, scan latency, etc.).",{"_12623":1612,"_48290":1579,"_18312":97677,"_5":17825,"_25222":97609,"_7710":97678},[48836],"Statistics Collection — aggregate\nestimates without scanning every row.",{"_12623":1613,"_48290":1613,"_5":13058,"_7710":97680,"_48807":97681,"_18312":97682,"_25222":1613},"Row Timestamp Column",[92880,92881,92882,94570],[48836],{"_12623":1614,"_48290":1613,"_18312":97684,"_5":17825,"_25222":1613,"_7710":97685},[48836],"Map HBase row timestamps to a Phoenix primary-key column and use ROW_TIMESTAMP in table design and upserts.",{"_12623":1615,"_48290":1613,"_5":48804,"_18312":97687,"_25222":97688,"_7710":97689},[48836],"/docs/features/row-timestamp-column#sample-schema","Sample schema",{"_12623":1616,"_48290":1613,"_5":48804,"_18312":97691,"_25222":97692,"_7710":95532},[48836],"/docs/features/row-timestamp-column#see-also",{"_12623":1617,"_48290":1613,"_18312":97694,"_5":17825,"_25222":1613,"_7710":97695},[48836],"Phoenix 4.6 provides a way to map HBase’s native row timestamp to a Phoenix column. This helps you take advantage of HBase optimizations for time ranges in store files, along with query optimizations built into Phoenix.",{"_12623":1618,"_48290":1613,"_18312":97697,"_5":17825,"_25222":1613,"_7710":97698},[48836],"For a column to be designated as ROW_TIMESTAMP, certain constraints need to be followed:",{"_12623":1619,"_48290":1613,"_18312":97700,"_5":17825,"_25222":1613,"_7710":97701},[48836],"Only a primary key column of type TIME, DATE, TIMESTAMP, BIGINT, or UNSIGNED_LONG can be designated as ROW_TIMESTAMP.",{"_12623":1620,"_48290":1613,"_18312":97703,"_5":17825,"_25222":1613,"_7710":97704},[48836],"Only one primary key column can be designated as ROW_TIMESTAMP.",{"_12623":1621,"_48290":1613,"_18312":97706,"_5":17825,"_25222":1613,"_7710":97707},[48836],"The column value cannot be NULL (because it maps directly to the HBase row timestamp). This also means a column can be declared as ROW_TIMESTAMP only when creating the table.",{"_12623":1622,"_48290":1613,"_18312":97709,"_5":17825,"_25222":1613,"_7710":97710},[48836],"A ROW_TIMESTAMP column value cannot be negative. For DATE/TIME/TIMESTAMP, the corresponding epoch time in milliseconds cannot be less than zero.",{"_12623":1623,"_48290":1613,"_18312":97712,"_5":17825,"_25222":1613,"_7710":97713},[48836],"When upserting rows for a table with a row timestamp column (using UPSERT VALUES or UPSERT SELECT), you can explicitly provide the row timestamp value or let Phoenix set it automatically. When not specified, Phoenix sets the row timestamp column value to server-side time. The value also becomes the timestamp of the corresponding row in HBase.",{"_12623":1624,"_48290":1613,"_18312":97715,"_5":17825,"_25222":97688,"_7710":97716},[48836],"This sets CREATED_DATE to the value specified in the corresponding bind parameter.",{"_12623":1625,"_48290":1613,"_18312":97718,"_5":17825,"_25222":97688,"_7710":97719},[48836],"This sets CREATED_DATE to server-side time.",{"_12623":1626,"_48290":1613,"_18312":97721,"_5":17825,"_25222":97688,"_7710":97722},[48836],"This sets CREATED_DATE to the DATE selected from SOURCE_METRICS_TABLE.",{"_12623":1627,"_48290":1613,"_18312":97724,"_5":17825,"_25222":97688,"_7710":97725},[48836],"This sets CREATED_DATE in the destination table to the server timestamp.",{"_12623":1628,"_48290":1613,"_18312":97727,"_5":17825,"_25222":97688,"_7710":97728},[48836],"When querying with filters on the row timestamp column, Phoenix performs its usual row-key optimizations and can also set scan min/max time ranges appropriately. Using this time range information, HBase can skip store files that do not fall in the target time range, which significantly improves performance, especially for tail-end data queries.",{"_12623":1629,"_48290":1613,"_18312":97730,"_5":17825,"_25222":97692,"_7710":97731},[48836],"The PHOENIX_ROW_TIMESTAMP() function lets you read the underlying HBase row timestamp on any Phoenix table — even one without a declared ROW_TIMESTAMP column — and is indexable for fast time-bounded queries.",{"_12623":1630,"_48290":1630,"_5":13058,"_7710":97733,"_48807":97734,"_18312":97735,"_25222":1630},"Salted Tables",[92880,92881,92882,94570],[48836],{"_12623":1631,"_48290":1630,"_18312":97737,"_5":17825,"_25222":1630,"_7710":97738},[48836],"Use SALT_BUCKETS to reduce HBase hotspotting and understand scan, split, and ordering behavior for salted tables.",{"_12623":1632,"_48290":1630,"_5":48804,"_18312":97740,"_25222":97741,"_7710":97742},[48836],"/docs/features/salted-tables#sequential-scan","Sequential scan",{"_12623":1633,"_48290":1630,"_5":48804,"_18312":97744,"_25222":97745,"_7710":97746},[48836],"/docs/features/salted-tables#splitting","Splitting",{"_12623":1634,"_48290":1630,"_5":48804,"_18312":97748,"_25222":97749,"_7710":97750},[48836],"/docs/features/salted-tables#row-key-ordering","Row key ordering",{"_12623":1635,"_48290":1630,"_5":48804,"_18312":97752,"_25222":97753,"_7710":97754},[48836],"/docs/features/salted-tables#salted-tables-performance","Performance",{"_12623":1636,"_48290":1630,"_18312":97756,"_5":17825,"_25222":1630,"_7710":97757},[48836],"Sequential writes in HBase may suffer from region server hotspotting if your row key is monotonically increasing. Salting the row key helps mitigate this problem. See this article for details.",{"_12623":1637,"_48290":1630,"_18312":97759,"_5":17825,"_25222":1630,"_7710":97760},[48836],"Phoenix provides a way to transparently salt the row key with a salting byte for a table. Specify this at table creation time with the SALT_BUCKETS table property, using a value from 1 to 256:",{"_12623":1638,"_48290":1630,"_18312":97762,"_5":17825,"_25222":1630,"_7710":97763},[48836],"There are some behavior differences and cautions to be aware of when using a salted table.",{"_12623":1639,"_48290":1630,"_18312":97765,"_5":17825,"_25222":97741,"_7710":97766},[48836],"Since a salted table does not store data in natural key sequence, a strict sequential scan does not return data in natural sorted order. Clauses that force sequential scan behavior (for example, LIMIT) may return rows differently compared to a non-salted table.",{"_12623":1640,"_48290":1630,"_18312":97768,"_5":17825,"_25222":97745,"_7710":97769},[48836],"If no split points are specified, a salted table is pre-split on salt-byte boundaries to ensure load distribution across region servers, including during initial table growth. If split points are provided manually, they must include the salt byte.",{"_12623":1641,"_48290":1630,"_18312":97771,"_5":17825,"_25222":97749,"_7710":97772},[48836],"Pre-splitting also ensures that entries in each region start with the same salt byte and are therefore locally sorted. During a parallel scan across regions, Phoenix can use this property to perform a client-side merge sort. The resulting scan can still be returned sequentially, as if from a normal table.",{"_12623":1642,"_48290":1630,"_18312":97774,"_5":17825,"_25222":97749,"_7710":97775},[48836],"This row-key ordered scan can be enabled by setting phoenix.query.rowKeyOrderSaltedTable=true in hbase-site.xml. When enabled, user-specified split points on salted tables are disallowed to ensure each bucket contains only entries with the same salt byte. With this property enabled, a salted table behaves more like a normal table for scans and returns items in row-key order.",{"_12623":1643,"_48290":1630,"_18312":97777,"_5":17825,"_25222":97753,"_7710":97778},[48836],"Using salted tables with pre-splitting helps distribute write workload uniformly across region servers, which improves write performance. Our performance evaluation shows that salted tables can achieve up to 80% higher write throughput than non-salted tables.",{"_12623":1644,"_48290":1630,"_18312":97780,"_5":17825,"_25222":97753,"_7710":97781},[48836],"Reads from salted tables can also benefit from more uniform data distribution. Our performance evaluation shows improved read performance for queries focused on subsets of data.",{"_12623":1645,"_48290":1645,"_5":13058,"_7710":97783,"_48807":97784,"_18312":97785,"_25222":1645},"Secondary Indexes",[92880,92881,92882,94570],[48836],{"_12623":1646,"_48290":1645,"_18312":97787,"_5":17825,"_25222":1645,"_7710":97788},[48836],"Concepts, setup, consistency guarantees, and tooling for Phoenix secondary indexes.",{"_12623":1647,"_48290":1645,"_5":48804,"_18312":97790,"_25222":97791,"_7710":97792},[48836],"/docs/features/secondary-indexes#covered-indexes","Covered Indexes",{"_12623":1648,"_48290":1645,"_5":48804,"_18312":97794,"_25222":97795,"_7710":97796},[48836],"/docs/features/secondary-indexes#functional-indexes","Functional Indexes",{"_12623":1649,"_48290":1645,"_5":48804,"_18312":97798,"_25222":97799,"_7710":97800},[48836],"/docs/features/secondary-indexes#global-indexes","Global Indexes",{"_12623":1650,"_48290":1645,"_5":48804,"_18312":97802,"_25222":97803,"_7710":97804},[48836],"/docs/features/secondary-indexes#local-indexes","Local Indexes",{"_12623":1651,"_48290":1645,"_5":48804,"_18312":97806,"_25222":97807,"_7710":97808},[48836],"/docs/features/secondary-indexes#uncovered-indexes","Uncovered Indexes",{"_12623":1652,"_48290":1645,"_5":48804,"_18312":97810,"_25222":97811,"_7710":97812},[48836],"/docs/features/secondary-indexes#uncovered-indexes-when","When to choose an uncovered index",{"_12623":1653,"_48290":1645,"_5":48804,"_18312":97814,"_25222":97815,"_7710":97816},[48836],"/docs/features/secondary-indexes#uncovered-indexes-usage","Creating and using an uncovered index",{"_12623":1654,"_48290":1645,"_5":48804,"_18312":97818,"_25222":97819,"_7710":97820},[48836],"/docs/features/secondary-indexes#partial-indexes","Partial Indexes",{"_12623":1655,"_48290":1645,"_5":48804,"_18312":97822,"_25222":97823,"_7710":97824},[48836],"/docs/features/secondary-indexes#partial-indexes-when","When to choose a partial index",{"_12623":1656,"_48290":1645,"_5":48804,"_18312":97826,"_25222":97827,"_7710":97828},[48836],"/docs/features/secondary-indexes#partial-indexes-usage","Creating a partial index",{"_12623":1657,"_48290":1645,"_5":48804,"_18312":97830,"_25222":97831,"_7710":97832},[48836],"/docs/features/secondary-indexes#partial-indexes-mutations","Mutations that cross the predicate",{"_12623":1658,"_48290":1645,"_5":48804,"_18312":97834,"_25222":97835,"_7710":93002},[48836],"/docs/features/secondary-indexes#partial-indexes-limitations",{"_12623":1659,"_48290":1645,"_5":48804,"_18312":97837,"_25222":97838,"_7710":97839},[48836],"/docs/features/secondary-indexes#index-population","Index Population",{"_12623":1660,"_48290":1645,"_5":48804,"_18312":97841,"_25222":97842,"_7710":97843},[48836],"/docs/features/secondary-indexes#async-index-threshold","ASYNC Index threshold",{"_12623":1661,"_48290":1645,"_5":48804,"_18312":97845,"_25222":97846,"_7710":97847},[48836],"/docs/features/secondary-indexes#index-usage","Index Usage",{"_12623":1662,"_48290":1645,"_5":48804,"_18312":97849,"_25222":97850,"_7710":97851},[48836],"/docs/features/secondary-indexes#index-removal","Index Removal",{"_12623":1663,"_48290":1645,"_5":48804,"_18312":97853,"_25222":97854,"_7710":97855},[48836],"/docs/features/secondary-indexes#index-properties","Index Properties",{"_12623":1664,"_48290":1645,"_5":48804,"_18312":97857,"_25222":97858,"_7710":97859},[48836],"/docs/features/secondary-indexes#consistency-guarantees","Consistency Guarantees",{"_12623":1665,"_48290":1645,"_5":48804,"_18312":97861,"_25222":97862,"_7710":97804},[48836],"/docs/features/secondary-indexes#local-indexes-1",{"_12623":1666,"_48290":1645,"_5":48804,"_18312":97864,"_25222":97865,"_7710":97866},[48836],"/docs/features/secondary-indexes#global-indexes-on-transactional-tables","Global Indexes on Transactional Tables",{"_12623":1667,"_48290":1645,"_5":48804,"_18312":97868,"_25222":97869,"_7710":97870},[48836],"/docs/features/secondary-indexes#global-indexes-on-immutable-tables","Global Indexes on Immutable Tables",{"_12623":1668,"_48290":1645,"_5":48804,"_18312":97872,"_25222":97873,"_7710":97874},[48836],"/docs/features/secondary-indexes#immutable-table-indexes-for-415-and-51-and-newer-versions","Immutable table indexes for 4.15 (and 5.1) and newer versions",{"_12623":1669,"_48290":1645,"_5":48804,"_18312":97876,"_25222":97877,"_7710":97878},[48836],"/docs/features/secondary-indexes#immutable-table-indexes-for-414-and-50-and-older-versions","Immutable table indexes for 4.14 (and 5.0) and older versions",{"_12623":1670,"_48290":1645,"_5":48804,"_18312":97880,"_25222":97881,"_7710":97882},[48836],"/docs/features/secondary-indexes#global-indexes-on-mutable-tables","Global Indexes on Mutable Tables",{"_12623":1671,"_48290":1645,"_5":48804,"_18312":97884,"_25222":97885,"_7710":97886},[48836],"/docs/features/secondary-indexes#mutable-table-indexes-for-415-and-51-and-newer-versions","Mutable table indexes for 4.15 (and 5.1) and newer versions",{"_12623":1672,"_48290":1645,"_5":48804,"_18312":97888,"_25222":97889,"_7710":97890},[48836],"/docs/features/secondary-indexes#mutable-table-indexes-for-414-and-50-and-older-versions","Mutable table indexes for 4.14 (and 5.0) and older versions",{"_12623":1673,"_48290":1645,"_5":48804,"_18312":97892,"_25222":97893,"_7710":97894},[48836],"/docs/features/secondary-indexes#bulkload-tool-limitation","BulkLoad Tool Limitation",{"_12623":1674,"_48290":1645,"_5":48804,"_18312":97896,"_25222":97897,"_7710":97898},[48836],"/docs/features/secondary-indexes#setup","Setup",{"_12623":1675,"_48290":1645,"_5":48804,"_18312":97900,"_25222":97901,"_7710":97902},[48836],"/docs/features/secondary-indexes#for-phoenix-412-and-later","For Phoenix 4.12 and later",{"_12623":1676,"_48290":1645,"_5":48804,"_18312":97904,"_25222":97905,"_7710":97906},[48836],"/docs/features/secondary-indexes#for-phoenix-48---411","For Phoenix 4.8 - 4.11",{"_12623":1677,"_48290":1645,"_5":48804,"_18312":97908,"_25222":97909,"_7710":97910},[48836],"/docs/features/secondary-indexes#for-phoenix-versions-47-and-below","For Phoenix versions 4.7 and below",{"_12623":1678,"_48290":1645,"_5":48804,"_18312":97912,"_25222":97913,"_7710":97914},[48836],"/docs/features/secondary-indexes#upgrading-local-indexes-created-before-480","Upgrading Local Indexes created before 4.8.0",{"_12623":1679,"_48290":1645,"_5":48804,"_18312":97916,"_25222":97917,"_7710":95522},[48836],"/docs/features/secondary-indexes#secondary-indexes-tuning",{"_12623":1680,"_48290":1645,"_5":48804,"_18312":97919,"_25222":97920,"_7710":97754},[48836],"/docs/features/secondary-indexes#secondary-indexes-performance",{"_12623":1681,"_48290":1645,"_5":48804,"_18312":97922,"_25222":97923,"_7710":97924},[48836],"/docs/features/secondary-indexes#index-scrutiny-tool","Index Scrutiny Tool",{"_12623":1682,"_48290":1645,"_5":48804,"_18312":97926,"_25222":97927,"_7710":93002},[48836],"/docs/features/secondary-indexes#secondary-indexes-limitations",{"_12623":1683,"_48290":1645,"_5":48804,"_18312":97929,"_25222":97930,"_7710":97931},[48836],"/docs/features/secondary-indexes#index-upgrade-tool","Index Upgrade Tool",{"_12623":1684,"_48290":1645,"_5":48804,"_18312":97933,"_25222":97934,"_7710":96357},[48836],"/docs/features/secondary-indexes#secondary-indexes-resources",{"_12623":1685,"_48290":1645,"_18312":97936,"_5":17825,"_25222":1645,"_7710":97937},[48836],"Secondary indexes are an orthogonal way to access data from its primary access path. In HBase, you have a single\nindex that is lexicographically sorted on the primary row key. Access to records in any way other than through\nthe primary row requires scanning over potentially all the rows in the table to test them against your filter.\nWith secondary indexing, the columns or expressions you index form an alternate row key to allow point lookups\nand range scans along this new axis.",{"_12623":1686,"_48290":1645,"_18312":97939,"_5":17825,"_25222":97791,"_7710":97940},[48836],"Phoenix is particularly powerful in that we provide covered indexes -\nwe do not need to go back to the primary table once we have found the index entry. Instead, we bundle the data\nwe care about right in the index rows, saving read-time overhead.",{"_12623":1687,"_48290":1645,"_18312":97942,"_5":17825,"_25222":97791,"_7710":97943},[48836],"For example, the following would create an index on the v1 and v2 columns and\ninclude the v3 column in the index as well to prevent having to get it from the data table:",{"_12623":1688,"_48290":1645,"_18312":97945,"_5":17825,"_25222":97795,"_7710":97946},[48836],"Functional indexes (available in 4.3 and above) allow you to create\nan index not just on columns, but on an arbitrary expressions. Then when a query uses that expression, the index\nmay be used to retrieve the results instead of the data table. For example, you could create an index on UPPER(FIRST_NAME||' '||LAST_NAME)\nto allow you to do case insensitive searches on the combined first name and last name of a person.",{"_12623":1689,"_48290":1645,"_18312":97948,"_5":17825,"_25222":97795,"_7710":97949},[48836],"For example, the following would create this functional index:",{"_12623":1690,"_48290":1645,"_18312":97951,"_5":17825,"_25222":97795,"_7710":97952},[48836],"With this index in place, when the following query is issued, the index would be used instead of the data table to retrieve the results:",{"_12623":1691,"_48290":1645,"_18312":97954,"_5":17825,"_25222":97795,"_7710":97955},[48836],"Phoenix supports two types of indexing techniques: global and local indexing.\nEach are useful in different scenarios and have their own failure profiles and performance characteristics.",{"_12623":1692,"_48290":1645,"_18312":97957,"_5":17825,"_25222":97799,"_7710":97958},[48836],"Global indexing targets read heavy uses cases. With global indexes, all the performance penalties for indexes occur at write time. We intercept the data table updates on write (DELETE, UPSERT VALUES and UPSERT SELECT), build the index update and then sent any necessary updates to all interested index tables. At read time, Phoenix will select the index table to use that will produce the fastest query time and directly scan it just like any other HBase table. An index will not be used for a query that references a column that isn't part of the index.",{"_12623":1693,"_48290":1645,"_18312":97960,"_5":17825,"_25222":97799,"_7710":97961},[48836],"For write-heavy workloads where synchronous index maintenance is the bottleneck and a bounded staleness window on the index is acceptable, a global index can be created with CONSISTENCY=EVENTUAL to move its maintenance off the data-table write path. See Eventually Consistent Global Indexes.",{"_12623":1694,"_48290":1645,"_18312":97963,"_5":17825,"_25222":97803,"_7710":97964},[48836],"Local indexing targets write heavy, space constrained use cases. Just like with global indexes, Phoenix will automatically select whether or not to use a local index at query-time. With local indexes, index data and table data co-reside on same server preventing any network overhead during writes. Local indexes can be used even when the query isn't fully covered (i.e. Phoenix automatically retrieve the columns not in the index through point gets against the data table). Unlike global indexes, all local indexes of a table are stored in a single, separate shared table prior to 4.8.0 version. From 4.8.0 onwards we are storing all local index data in the separate shadow column families in the same data table. At read time when the local index is used, every region must be examined for the data as the exact region location of index data cannot be predetermined. Thus some overhead occurs at read-time.",{"_12623":1695,"_48290":1645,"_18312":97966,"_5":17825,"_25222":97807,"_7710":97967},[48836],"A global index is \"covered\" for a query when every column the query references is in\nthe index — either in the index key or in INCLUDE. Historically a global index that\nwasn't covered for a query simply wasn't used: Phoenix would fall back to a full\ndata-table scan. Uncovered indexes lift that restriction — Phoenix can use a\nglobal index even when the query needs columns that aren't in it, by joining back\nto the data table on the server side to fetch the missing columns\n(PHOENIX-6458).",{"_12623":1696,"_48290":1645,"_18312":97969,"_5":17825,"_25222":97807,"_7710":97970},[48836],"Local indexes already worked this way (see Local Indexes above);\nthe new capability is for global indexes.",{"_12623":1697,"_48290":1645,"_18312":97972,"_5":17825,"_25222":97811,"_7710":97973},[48836],"Both an INCLUDE covered index and an uncovered index let the same query use the\nindex. They trade off different costs:",{"_12623":1698,"_48290":1645,"_18312":97975,"_5":17825,"_25222":97811,"_7710":97976},[48836],"Approach",{"_12623":1699,"_48290":1645,"_18312":97978,"_5":17825,"_25222":97811,"_7710":97979},[48836],"Index size",{"_12623":1700,"_48290":1645,"_18312":97981,"_5":17825,"_25222":97811,"_7710":97982},[48836],"Read path",{"_12623":1701,"_48290":1645,"_18312":97984,"_5":17825,"_25222":97811,"_7710":97985},[48836],"Best when",{"_12623":1702,"_48290":1645,"_18312":97987,"_5":17825,"_25222":97811,"_7710":97988},[48836],"CREATE INDEX ... INCLUDE (c)",{"_12623":1703,"_48290":1645,"_18312":97990,"_5":17825,"_25222":97811,"_7710":97991},[48836],"Larger — c is duplicated",{"_12623":1704,"_48290":1645,"_18312":97993,"_5":17825,"_25222":97811,"_7710":97994},[48836],"Index-only scan",{"_12623":1705,"_48290":1645,"_18312":97996,"_5":17825,"_25222":97811,"_7710":97997},[48836],"Column c is small, frequently read with the index, and updated rarely",{"_12623":1706,"_48290":1645,"_18312":97999,"_5":17825,"_25222":97811,"_7710":98000},[48836],"CREATE UNCOVERED INDEX",{"_12623":1707,"_48290":1645,"_18312":98002,"_5":17825,"_25222":97811,"_7710":98003},[48836],"Smaller — only the key",{"_12623":1708,"_48290":1645,"_18312":98005,"_5":17825,"_25222":97811,"_7710":98006},[48836],"Index seek + server-side join to data row",{"_12623":1709,"_48290":1645,"_18312":98008,"_5":17825,"_25222":97811,"_7710":98009},[48836],"Column is large, rarely read with this access path, or updated often",{"_12623":1710,"_48290":1645,"_18312":98011,"_5":17825,"_25222":97811,"_7710":98012},[48836],"A common pattern is to leave wide payload columns out of the index entirely and\nlet Phoenix fetch them via the join-back when needed. This keeps the index compact\nand write-cheap, at the cost of a per-matching-row data-table read on the rare query\nthat wants the payload.",{"_12623":1711,"_48290":1645,"_18312":98014,"_5":17825,"_25222":97815,"_7710":98015},[48836],"Declare an uncovered global index with the UNCOVERED keyword in the DDL.\nUNCOVERED is global-only (cannot be combined with LOCAL) and cannot be combined\nwith INCLUDE — the whole point is to skip duplicating columns:",{"_12623":1712,"_48290":1645,"_18312":98017,"_5":17825,"_25222":97815,"_7710":98018},[48836],"The planner picks an uncovered index automatically when it's the best plan; no\nhint is required. If you want to force it (e.g. to compare plans), use the\nstandard index hint:",{"_12623":1713,"_48290":1645,"_18312":98020,"_5":17825,"_25222":97819,"_7710":98021},[48836],"A partial index indexes only the rows of the data table that satisfy a SQL\nboolean predicate, supplied at CREATE INDEX time via a WHERE clause. The\nindex is smaller, writes that don't affect the predicate are cheaper, and the\nplanner only uses it for queries whose own predicate implies the index's. Added\nin PHOENIX-7032.",{"_12623":1714,"_48290":1645,"_18312":98023,"_5":17825,"_25222":97823,"_7710":98024},[48836],"Reach for a partial index when the workload reads a small, well-defined slice of\na much larger table — and that slice is identifiable by a SQL predicate. Common\nshapes:",{"_12623":1715,"_48290":1645,"_18312":98026,"_5":17825,"_25222":97823,"_7710":98027},[48836],"Open / active records: WHERE status IN ('OPEN', 'PENDING') on a table that\nalso stores closed records.",{"_12623":1716,"_48290":1645,"_18312":98029,"_5":17825,"_25222":97823,"_7710":98030},[48836],"Recent rows: WHERE created_at > DATE '2024-01-01'.",{"_12623":1717,"_48290":1645,"_18312":98032,"_5":17825,"_25222":97823,"_7710":98033},[48836],"Hot tier: WHERE priority >= 5 for paging / alerting workloads.",{"_12623":1718,"_48290":1645,"_18312":98035,"_5":17825,"_25222":97823,"_7710":98036},[48836],"Failure investigation: WHERE result = 'FAIL' on a successful-most-of-the-time\ntable.",{"_12623":1719,"_48290":1645,"_18312":98038,"_5":17825,"_25222":97827,"_7710":98039},[48836],"The DDL is a regular CREATE INDEX with a trailing WHERE clause. Both\ncovered and uncovered global indexes can be partial:",{"_12623":1720,"_48290":1645,"_18312":98041,"_5":17825,"_25222":97827,"_7710":98042},[48836],"The planner uses the index for any query whose WHERE clause implies the\nindex's predicate:",{"_12623":1721,"_48290":1645,"_18312":98044,"_5":17825,"_25222":97831,"_7710":98045},[48836],"Partial indexes correctly maintain themselves when a mutation moves a row into\nor out of the predicate, including under ON DUPLICATE KEY UPDATE:",{"_12623":1722,"_48290":1645,"_18312":98047,"_5":17825,"_25222":97831,"_7710":98048},[48836],"A row that starts satisfying the predicate after an update has its index\nrow created.",{"_12623":1723,"_48290":1645,"_18312":98050,"_5":17825,"_25222":97831,"_7710":98051},[48836],"A row that stops satisfying the predicate after an update has its index\nrow removed.",{"_12623":1724,"_48290":1645,"_18312":98053,"_5":17825,"_25222":97831,"_7710":98054},[48836],"This means a partial index stays consistent for a workload like \"close an\norder\" even though that operation flips the row out of the index's covered\nslice.",{"_12623":1725,"_48290":1645,"_18312":98056,"_5":17825,"_25222":97835,"_7710":98057},[48836],"Local partial indexes are not supported — only global (covered or\nuncovered) partial indexes work today.",{"_12623":1726,"_48290":1645,"_18312":98059,"_5":17825,"_25222":97835,"_7710":98060},[48836],"The WHERE predicate is fixed at CREATE INDEX time. To change it, drop and\nrecreate the index.",{"_12623":1727,"_48290":1645,"_18312":98062,"_5":17825,"_25222":97838,"_7710":98063},[48836],"By default, when an index is created, it is populated synchronously during the CREATE INDEX call. This may not be feasible depending on the current size of the data table. As of 4.5, initially population of an index may be done asynchronously by including the ASYNC keyword in the index creation DDL statement:",{"_12623":1728,"_48290":1645,"_18312":98065,"_5":17825,"_25222":97838,"_7710":98066},[48836],"The map reduce job that populates the index table must be kicked off separately through the HBase command line like this:",{"_12623":1729,"_48290":1645,"_18312":98068,"_5":17825,"_25222":97838,"_7710":98069},[48836],"Only when the map reduce job is complete will the index be activated and start to be used in queries. The job is resilient to the client being exited. The output-path option is used to specify a HDFS directory that is used for writing HFiles to.",{"_12623":1730,"_48290":1645,"_18312":98071,"_5":17825,"_25222":97838,"_7710":98072},[48836],"You can also start index population for all indexes in BUILDING (\"b\") state with the following HBase command line:",{"_12623":1731,"_48290":1645,"_18312":98074,"_5":17825,"_25222":97842,"_7710":98075},[48836],"As of 4.16 (and 5.1), setting the phoenix.index.async.threshold property to a positive number will disallow synchronous index creation if the estimated indexed data size exceeds phoenix.index.async.threshold (in bytes).",{"_12623":1732,"_48290":1645,"_18312":98077,"_5":17825,"_25222":97846,"_7710":98078},[48836],"Indexes are automatically used by Phoenix to service a query when it's determined more efficient to do so. However, a global index will not be used unless all of the columns referenced in the query are contained in the index. For example, the following query would not use the index, because v2 is referenced in the query but not included in the index:",{"_12623":1733,"_48290":1645,"_18312":98080,"_5":17825,"_25222":97846,"_7710":98081},[48836],"There are two means of getting an index to be used in this case:",{"_12623":1734,"_48290":1645,"_18312":98083,"_5":17825,"_25222":97846,"_7710":98084},[48836],"Create a covered index by including v2 in the index:",{"_12623":1735,"_48290":1645,"_18312":98086,"_5":17825,"_25222":97846,"_7710":98087},[48836],"This will cause the v2 column value to be copied into the index and kept in synch as it changes. This will obviously increase the size of the index.",{"_12623":1736,"_48290":1645,"_18312":98089,"_5":17825,"_25222":97846,"_7710":98090},[48836],"Create a local index:",{"_12623":1737,"_48290":1645,"_18312":98092,"_5":17825,"_25222":97846,"_7710":98093},[48836],"Unlike global indexes, local indexes will use an index even when all columns referenced in the query are not contained in the index. This is done by default for local indexes because we know that the table and index data coreside on the same region server thus ensuring the lookup is local.",{"_12623":1738,"_48290":1645,"_18312":98095,"_5":17825,"_25222":97850,"_7710":98096},[48836],"To drop an index, you'd issue the following statement:",{"_12623":1739,"_48290":1645,"_18312":98098,"_5":17825,"_25222":97850,"_7710":98099},[48836],"If an indexed column is dropped in the data table, the index will automatically be dropped. In addition, if a covered column is dropped in the data table, it will be automatically dropped from the index as well.",{"_12623":1740,"_48290":1645,"_18312":98101,"_5":17825,"_25222":97854,"_7710":98102},[48836],"Just like with the CREATE TABLE statement, the CREATE INDEX statement may pass through properties to apply to the underlying HBase table, including the ability to salt it:",{"_12623":1741,"_48290":1645,"_18312":98104,"_5":17825,"_25222":97854,"_7710":98105},[48836],"Note that if the primary table is salted, then the index is automatically salted in the same way for global indexes. In addition, the MAX_FILESIZE for the index is adjusted down, relative to the size of the primary versus index table. For more on salting see here. With local indexes, on the other hand, specifying SALT_BUCKETS is not allowed.",{"_12623":1742,"_48290":1645,"_18312":98107,"_5":17825,"_25222":97858,"_7710":98108},[48836],"On successful return to the client after a commit, all data is guaranteed to be written to all interested indexes and the\nprimary table. In other words, index updates are synchronous with the same strong consistency guarantees provided by HBase.",{"_12623":1743,"_48290":1645,"_18312":98110,"_5":17825,"_25222":97858,"_7710":98111},[48836],"However, since indexes are stored in separate tables than the data table, depending on the properties of the table and the\ntype of index, the consistency between your table and index varies in the event that a commit fails due to a server-side\ncrash. This is an important design consideration driven by your requirements and use case.",{"_12623":1744,"_48290":1645,"_18312":98113,"_5":17825,"_25222":97858,"_7710":98114},[48836],"Outlined below are the different options with various levels of consistency guarantees.",{"_12623":1745,"_48290":1645,"_18312":98116,"_5":17825,"_25222":97862,"_7710":98117},[48836],"Since Phoenix 4.8 local indexes are always guaranteed to be consistent.",{"_12623":1746,"_48290":1645,"_18312":98119,"_5":17825,"_25222":97865,"_7710":98120},[48836],"By declaring your table as transactional, you achieve the highest level of consistency guarantee\nbetween your table and index. In this case, your commit of your table mutations and related index updates are atomic\nwith strong ACID guarantees. If the commit fails, then none of your data (table\nor index) is updated, thus ensuring that your table and index are always in sync.",{"_12623":1747,"_48290":1645,"_18312":98122,"_5":17825,"_25222":97865,"_7710":98123},[48836],"Why not just always declare your tables as transactional? This may be fine, especially if your\ntable is declared as immutable, since the transactional overhead is very small in this case. However, if your data\nis mutable, make sure that the overhead associated with the conflict detection that occurs with transactional tables\nand the operational overhead of running the transaction manager is acceptable. Additionally, transactional tables\nwith secondary indexes potentially lowers your availability of being able to write to your data table, as both the\ndata table and its secondary index tables must be availalbe as otherwise the write will fail.",{"_12623":1748,"_48290":1645,"_18312":98125,"_5":17825,"_25222":97869,"_7710":98126},[48836],"For a table in which the data is only written once and never updated in-place, certain optimizations may be made to reduce the write-time overhead for incremental maintenance.\nThis is common with time-series data such as log or event data, where once a row is written, it will never be updated.\nTo take advantage of these optimizations, declare your table as immutable by adding the IMMUTABLE_ROWS=true property to your DDL statement:",{"_12623":1749,"_48290":1645,"_18312":98128,"_5":17825,"_25222":97869,"_7710":98129},[48836],"All indexes on a table declared with IMMUTABLE_ROWS=true are considered immutable (note that by default, tables are considered mutable).\nFor global immutable indexes, the index is maintained entirely on the client-side with the index table being generated as changes to the data table occur.\nLocal immutable indexes, on the other hand, are maintained on the server-side.\nNote that no safeguards are in-place to enforce that a table declared as immutable doesn't actually mutate data (as that would negate the performance gain achieved).\nIf that was to occur, the index would no longer be in sync with the table.",{"_12623":1750,"_48290":1645,"_18312":98131,"_5":17825,"_25222":97869,"_7710":98132},[48836],"If you have an existing table that you'd like to switch from immutable indexing to mutable indexing, use the ALTER TABLE command as show below:",{"_12623":1751,"_48290":1645,"_18312":98134,"_5":17825,"_25222":97869,"_7710":98135},[48836],"Global Indexing for Immutable tables has been completely rewritten for version 4.15 (and 5.1)",{"_12623":1752,"_48290":1645,"_18312":98137,"_5":17825,"_25222":97873,"_7710":98138},[48836],"Immutable index updates go through the same three phase writes as mutable index updates do except that deleting or un-verifying existing index rows is not applicable to immutable indexes.\nThis guarantees that the index tables are always in sync with the data tables.",{"_12623":1753,"_48290":1645,"_18312":98140,"_5":17825,"_25222":97877,"_7710":98141},[48836],"Indexes on non transactional, immutable tables have no mechanism in place to automatically deal with a commit failure. Maintaining\nconsistency between the table and index is left to the client to handle. Because the updates are idempotent, the simplest\nsolution is for the client to continue retrying the batch of mutations until they succeed.",{"_12623":1754,"_48290":1645,"_18312":98143,"_5":17825,"_25222":97881,"_7710":98144},[48836],"Global Indexing for Mutable tables has been completely rewritten for version 4.15 (and 5.1)",{"_12623":1755,"_48290":1645,"_18312":98146,"_5":17825,"_25222":97885,"_7710":98147},[48836],"The new Strongly Consistent Global Indexing feature uses a three-phase indexing algorithm to guarantee that the index tables are always in sync with the data tables.",{"_12623":1756,"_48290":1645,"_18312":98149,"_5":17825,"_25222":97885,"_7710":98150},[48836],"The implementation uses a shadow column to track the status of index rows:",{"_12623":1757,"_48290":1645,"_18312":98152,"_5":17825,"_25222":97885,"_7710":98153},[48836],"Write:",{"_12623":1758,"_48290":1645,"_18312":98155,"_5":17825,"_25222":97885,"_7710":98156},[48836],"Set the status of existing index rows to unverified and write the new index rows with the unverified status",{"_12623":1759,"_48290":1645,"_18312":98158,"_5":17825,"_25222":97885,"_7710":98159},[48836],"Write the data table rows",{"_12623":1760,"_48290":1645,"_18312":98161,"_5":17825,"_25222":97885,"_7710":98162},[48836],"Delete the existing index rows and set the status of new rows to verified",{"_12623":1761,"_48290":1645,"_18312":98164,"_5":17825,"_25222":97885,"_7710":98165},[48836],"Read:",{"_12623":1762,"_48290":1645,"_18312":98167,"_5":17825,"_25222":97885,"_7710":98168},[48836],"Read the index rows and check their status",{"_12623":1763,"_48290":1645,"_18312":98170,"_5":17825,"_25222":97885,"_7710":98171},[48836],"The unverified rows are repaired from the data table",{"_12623":1764,"_48290":1645,"_18312":98173,"_5":17825,"_25222":97885,"_7710":98174},[48836],"Delete:",{"_12623":1765,"_48290":1645,"_18312":98176,"_5":17825,"_25222":97885,"_7710":98177},[48836],"Set the index table rows with the unverified status",{"_12623":1766,"_48290":1645,"_18312":98179,"_5":17825,"_25222":97885,"_7710":98180},[48836],"Delete the data table rows",{"_12623":1767,"_48290":1645,"_18312":98182,"_5":17825,"_25222":97885,"_7710":98183},[48836],"Delete index table rows",{"_12623":1768,"_48290":1645,"_18312":98185,"_5":17825,"_25222":97885,"_7710":98186},[48836],"See resources for more in-depth information.",{"_12623":1769,"_48290":1645,"_18312":98188,"_5":17825,"_25222":97885,"_7710":98189},[48836],"All newly created tables use the new indexing algorithm.",{"_12623":1770,"_48290":1645,"_18312":98191,"_5":17825,"_25222":97885,"_7710":98192},[48836],"Indexes created with older Phoenix versions will continue to use the old implementation, until upgraded with IndexUpgradeTool",{"_12623":1771,"_48290":1645,"_18312":98194,"_5":17825,"_25222":97889,"_7710":98195},[48836],"For non transactional mutable tables, we maintain index update durability by adding the index updates to the Write-Ahead-Log (WAL) entry of the primary table row.\nOnly after the WAL entry is successfully synced to disk do we attempt to make the index/primary table updates. We write the\nindex updates in parallel by default, leading to very high throughput. If the server crashes while we are writing the index\nupdates, we replay the all the index updates to the index tables in the WAL recovery process and rely on the idempotence of\nthe updates to ensure correctness. Therefore, indexes on non transactional mutable tables are only ever a single batch of\nedits behind the primary table.",{"_12623":1772,"_48290":1645,"_18312":98197,"_5":17825,"_25222":97889,"_7710":98198},[48836],"It's important to note several points:",{"_12623":1773,"_48290":1645,"_18312":98200,"_5":17825,"_25222":97889,"_7710":98201},[48836],"For non transactional tables, you could see the index table out of sync with the primary table.",{"_12623":1774,"_48290":1645,"_18312":98203,"_5":17825,"_25222":97889,"_7710":98204},[48836],"As noted above, this is ok as we are only a very small bit behind and out of sync for very short periods",{"_12623":1775,"_48290":1645,"_18312":98206,"_5":17825,"_25222":97889,"_7710":98207},[48836],"Each data row and its index row(s) are guaranteed to to be written or lost - we never see partial updates as this is part of the atomicity guarantees of HBase.",{"_12623":1776,"_48290":1645,"_18312":98209,"_5":17825,"_25222":97889,"_7710":98210},[48836],"Data is first written to the table followed by the index tables (the reverse is true if the WAL is disabled).",{"_12623":1777,"_48290":1645,"_18312":98212,"_5":17825,"_25222":97889,"_7710":98213},[48836],"Singular Write Path",{"_12623":1778,"_48290":1645,"_18312":98215,"_5":17825,"_25222":97889,"_7710":98216},[48836],"There is a single write path that guarantees the failure properties. All writes to the HRegion get intercepted by our\ncoprocessor. We then build the index updates based on the pending update (or updates, in the case of the batch).\nThese update are then appended to the WAL entry for the original update.",{"_12623":1779,"_48290":1645,"_18312":98218,"_5":17825,"_25222":97889,"_7710":98219},[48836],"If we get any failure up to this point, we return the failure to the client and no data is persisted or made visible\nto the client.",{"_12623":1780,"_48290":1645,"_18312":98221,"_5":17825,"_25222":97889,"_7710":98222},[48836],"Once the WAL is written, we ensure that the index and primary table data will become visible, even in the case of a failure.",{"_12623":1781,"_48290":1645,"_18312":98224,"_5":17825,"_25222":97889,"_7710":98225},[48836],"If the server does crash, we then replay the index updates with the usual WAL replay mechanism",{"_12623":1782,"_48290":1645,"_18312":98227,"_5":17825,"_25222":97889,"_7710":98228},[48836],"If the server does not crash, we just insert the index updates to their respective tables.",{"_12623":1783,"_48290":1645,"_18312":98230,"_5":17825,"_25222":97889,"_7710":98231},[48836],"If the index updates fail, the various means of maintaining consistency are outlined below.",{"_12623":1784,"_48290":1645,"_18312":98233,"_5":17825,"_25222":97889,"_7710":98234},[48836],"If the Phoenix system catalog table cannot be reached when a failure occurs, we force the server to be immediately aborted and failing this, call System.exit on the JVM, forcing the server to die. By killing the server, we ensure that the WAL will be replayed on recovery, replaying the index updates to their appropriate tables. This ensures that a secondary index is not continued to be used when it's in a know, invalid state.",{"_12623":1785,"_48290":1645,"_18312":98236,"_5":17825,"_25222":97889,"_7710":98237},[48836],"Disallow table writes until mutable index is consistent",{"_12623":1786,"_48290":1645,"_18312":98239,"_5":17825,"_25222":97889,"_7710":98240},[48836],"The highest level of maintaining consistency between your non transactional table and index is to declare that writes to the\ndata table should be temporarily disallowed in the event of a failure to update the index. In this consistency\nmode, the table and index will be held at the timestamp before the failure occurred, with writes to the data\ntable being disallowed until the index is back online and in-sync with the data table. The index will\nremain active and continue to be used by queries as usual.",{"_12623":1787,"_48290":1645,"_18312":98242,"_5":17825,"_25222":97889,"_7710":98243},[48836],"The following server-side configurations control this behavior:",{"_12623":1788,"_48290":1645,"_18312":98245,"_5":17825,"_25222":97889,"_7710":98246},[48836],"phoenix.index.failure.block.write must be true to enable a writes to the data table to fail\nin the event of a commit failure until the index can be caught up with the data table.",{"_12623":1789,"_48290":1645,"_18312":98248,"_5":17825,"_25222":97889,"_7710":98249},[48836],"phoenix.index.failure.handling.rebuild must be true (the default) to enable a mutable index to\nbe rebuilt in the background in the event of a commit failure.",{"_12623":1790,"_48290":1645,"_18312":98251,"_5":17825,"_25222":97889,"_7710":98252},[48836],"Disable mutable indexes on write failure until consistency restored",{"_12623":1791,"_48290":1645,"_18312":98254,"_5":17825,"_25222":97889,"_7710":98255},[48836],"The default behavior with mutable indexes is to mark the index as disabled if a write to them fails at commit time,\npartially rebuild them in the background, and then mark them as active again once consistency is restored. In this\nconsistency mode, writes to the data table will not be blocked while the secondary index is being rebuilt. However,\nthe secondary index will not be used by queries while the rebuild is happening.",{"_12623":1792,"_48290":1645,"_18312":98257,"_5":17825,"_25222":97889,"_7710":98243},[48836],{"_12623":1793,"_48290":1645,"_18312":98259,"_5":17825,"_25222":97889,"_7710":98249},[48836],{"_12623":1794,"_48290":1645,"_18312":98261,"_5":17825,"_25222":97889,"_7710":98262},[48836],"phoenix.index.failure.handling.rebuild.interval controls the millisecond frequency at which the server\nchecks whether or not a mutable index needs to be partially rebuilt to catch up with updates to the data\ntable. The default is 10000 or 10 seconds.",{"_12623":1795,"_48290":1645,"_18312":98264,"_5":17825,"_25222":97889,"_7710":98265},[48836],"phoenix.index.failure.handling.rebuild.overlap.time controls how many milliseconds to go back from the timestamp\nat which the failure occurred to go back when a partial rebuild is performed. The default is 1.",{"_12623":1796,"_48290":1645,"_18312":98267,"_5":17825,"_25222":97889,"_7710":98268},[48836],"Disable mutable index on write failure with manual rebuild required",{"_12623":1797,"_48290":1645,"_18312":98270,"_5":17825,"_25222":97889,"_7710":98271},[48836],"This is the lowest level of consistency for mutable secondary indexes. In this case, when a write to a secondary\nindex fails, the index will be marked as disabled with a manual\nrebuild of the index required to enable it to be used\nonce again by queries.",{"_12623":1798,"_48290":1645,"_18312":98273,"_5":17825,"_25222":97889,"_7710":98243},[48836],{"_12623":1799,"_48290":1645,"_18312":98275,"_5":17825,"_25222":97889,"_7710":98276},[48836],"phoenix.index.failure.handling.rebuild must be set to false to disable a mutable index from being\nrebuilt in the background in the event of a commit failure.",{"_12623":1800,"_48290":1645,"_18312":98278,"_5":17825,"_25222":97893,"_7710":98279},[48836],"The BulkLoadTools (e.g. CSVBulkLoadTool and JSONBulkLoadTool) cannot presently generate correct updates to mutable\nsecondary indexes when pre-existing records are being updated. In the normal mutable secondary index write path, we can\nsafely calculate a Delete (for the old record) and a Put (for the new record) for each secondary index while holding a\nrow-lock to prevent concurrent updates. In the context of a MapReduce job, we cannot effectively execute this same logic\nbecause we are specifically doing this \"out of band\" from the HBase RegionServers. As such, while these Tools generate\nHFiles for the index tables with the proper updates for the data being loaded, any previous index records corresponding\nto the same record in the table are not deleted. This net-effect of this limitation is: if you use these Tools to re-ingest\nthe same records to an index table, that index table will have duplicate records in it which will result in incorrect\nquery results from that index table.",{"_12623":1801,"_48290":1645,"_18312":98281,"_5":17825,"_25222":97893,"_7710":98282},[48836],"To perform incremental loads of data using the BulkLoadTools which may update existing records, you must\ndrop and re-create all index tables after the data table is loaded. Re-creating the index with the ASYNC option and\nusing IndexTool to populate and enable that index is likely a must for tables of non-trivial size.",{"_12623":1802,"_48290":1645,"_18312":98284,"_5":17825,"_25222":97893,"_7710":98285},[48836],"To perform incremental loading of CSV datasets that do not require any manual index intervention, the psql tool can\nbe used in place of the BulkLoadTools. Additionally, a MapReduce job could be written to parse CSV/JSON data and write\nit directly to Phoenix; although, such a tool is not currently provided by Phoenix for users.",{"_12623":1803,"_48290":1645,"_18312":98287,"_5":17825,"_25222":97897,"_7710":98288},[48836],"Non transactional, mutable indexing requires special configuration options on the region server and master to run - Phoenix ensures that they are setup correctly when you enable mutable indexing on the table; if the correct properties are not set, you will not be able to use secondary indexing. After adding these settings to your hbase-site.xml, you'll need to do a rolling restart of your cluster.",{"_12623":1804,"_48290":1645,"_18312":98290,"_5":17825,"_25222":97897,"_7710":98291},[48836],"As Phoenix matures, it needs less and less manual configuration. For older Phoenix versions you'll need to add the properties listed for that version, as well as the properties listed for the later versions.",{"_12623":1805,"_48290":1645,"_18312":98293,"_5":17825,"_25222":97901,"_7710":98294},[48836],"You will need to add the following parameters to hbase-site.xml on each region server:",{"_12623":1806,"_48290":1645,"_18312":98296,"_5":17825,"_25222":97901,"_7710":98297},[48836],"The above property enables custom WAL edits to be written, ensuring proper writing/replay of the index updates. This codec supports the usual host of WALEdit options, most notably WALEdit compression.",{"_12623":1807,"_48290":1645,"_18312":98299,"_5":17825,"_25222":97905,"_7710":98300},[48836],"The following configuration changes are also required to the server-side hbase-site.xml on the master and regions server nodes:",{"_12623":1808,"_48290":1645,"_18312":98302,"_5":17825,"_25222":97905,"_7710":98303},[48836],"The above properties prevent deadlocks from occurring during index maintenance for global indexes (HBase 0.98.4+ and Phoenix 4.3.1+) by ensuring index updates are processed with a higher priority than data updates. It also prevents deadlocks by ensuring metadata rpc calls are processed with a higher priority than data rpc calls.",{"_12623":1809,"_48290":1645,"_18312":98305,"_5":17825,"_25222":97909,"_7710":98300},[48836],{"_12623":1810,"_48290":1645,"_18312":98307,"_5":17825,"_25222":97909,"_7710":98308},[48836],"The above properties are required to use local indexing.",{"_12623":1811,"_48290":1645,"_18312":98310,"_5":17825,"_25222":97913,"_7710":98311},[48836],"While upgrading the Phoenix to 4.8.0+ version at server remove above three local indexing related configurations from hbase-site.xml if present. From client we are supporting both online(while initializing the connection from phoenix client of 4.8.0+ versions) and offline(using psql tool) upgrade of local indexes created before 4.8.0. As part of upgrade we recreate the local indexes in ASYNC mode. After upgrade user need to build the indexes using IndexTool",{"_12623":1812,"_48290":1645,"_18312":98313,"_5":17825,"_25222":97913,"_7710":98314},[48836],"Following client side configuration used in the upgrade.",{"_12623":1813,"_48290":1645,"_18312":98316,"_5":17825,"_25222":97913,"_7710":98317},[48836],"phoenix.client.localIndexUpgradeThe value of it is true means online upgrade and false means offline upgrade.Default: true",{"_12623":1814,"_48290":1645,"_18312":98319,"_5":17825,"_25222":97913,"_7710":98320},[48836],"Command to run offline upgrade using psql:",{"_12623":1815,"_48290":1645,"_18312":98322,"_5":17825,"_25222":97917,"_7710":98323},[48836],"Out the box, indexing is pretty fast. However, to optimize for your particular environment and workload, there are several properties you can tune.",{"_12623":1816,"_48290":1645,"_18312":98325,"_5":17825,"_25222":97917,"_7710":98326},[48836],"All the following parameters must be set in hbase-site.xml - they are true for the entire cluster and all index tables, as well as across all regions on the same server (so, for instance, a single server would not write to too many different index tables at once).",{"_12623":1817,"_48290":1645,"_18312":98328,"_5":17825,"_25222":97917,"_7710":98329},[48836],"index.builder.threads.max",{"_12623":1818,"_48290":1645,"_18312":98331,"_5":17825,"_25222":97917,"_7710":98332},[48836],"Number of threads to used to build the index update from the primary table update",{"_12623":1819,"_48290":1645,"_18312":98334,"_5":17825,"_25222":97917,"_7710":98335},[48836],"Increasing this value overcomes the bottleneck of reading the current row state from the underlying HRegion. Tuning this value too high will just bottleneck at the HRegion as it will not be able to handle too many concurrent scan requests as well as general thread-swapping concerns.",{"_12623":1820,"_48290":1645,"_18312":98337,"_5":17825,"_25222":97917,"_7710":98338},[48836],"Default: 10",{"_12623":1821,"_48290":1645,"_18312":98340,"_5":17825,"_25222":97917,"_7710":98341},[48836],"index.builder.threads.keepalivetime",{"_12623":1822,"_48290":1645,"_18312":98343,"_5":17825,"_25222":97917,"_7710":98344},[48836],"Amount of time in seconds after we expire threads in the builder thread pool.",{"_12623":1823,"_48290":1645,"_18312":98346,"_5":17825,"_25222":97917,"_7710":98347},[48836],"Unused threads are immediately released after this amount of time and not core threads are retained (though this last is a small concern as tables are expected to sustain a fairly constant write load), but simultaneously allows us to drop threads if we are not seeing the expected load.",{"_12623":1824,"_48290":1645,"_18312":98349,"_5":17825,"_25222":97917,"_7710":98350},[48836],"Default: 60",{"_12623":1825,"_48290":1645,"_18312":98352,"_5":17825,"_25222":97917,"_7710":98353},[48836],"index.writer.threads.max",{"_12623":1826,"_48290":1645,"_18312":98355,"_5":17825,"_25222":97917,"_7710":98356},[48836],"Number of threads to use when writing to the target index tables.",{"_12623":1827,"_48290":1645,"_18312":98358,"_5":17825,"_25222":97917,"_7710":98359},[48836],"The first level of parallelization, on a per-table basis - it should roughly correspond to the number of index tables",{"_12623":1828,"_48290":1645,"_18312":98361,"_5":17825,"_25222":97917,"_7710":98338},[48836],{"_12623":1829,"_48290":1645,"_18312":98363,"_5":17825,"_25222":97917,"_7710":98364},[48836],"index.writer.threads.keepalivetime",{"_12623":1830,"_48290":1645,"_18312":98366,"_5":17825,"_25222":97917,"_7710":98367},[48836],"Amount of time in seconds after we expire threads in the writer thread pool.",{"_12623":1831,"_48290":1645,"_18312":98369,"_5":17825,"_25222":97917,"_7710":98347},[48836],{"_12623":1832,"_48290":1645,"_18312":98371,"_5":17825,"_25222":97917,"_7710":98350},[48836],{"_12623":1833,"_48290":1645,"_18312":98373,"_5":17825,"_25222":97917,"_7710":98374},[48836],"hbase.htable.threads.max",{"_12623":1834,"_48290":1645,"_18312":98376,"_5":17825,"_25222":97917,"_7710":98377},[48836],"Number of threads each index HTable can use for writes.",{"_12623":1835,"_48290":1645,"_18312":98379,"_5":17825,"_25222":97917,"_7710":98380},[48836],"Increasing this allows more concurrent index updates (for instance across batches), leading to high overall throughput.",{"_12623":1836,"_48290":1645,"_18312":98382,"_5":17825,"_25222":97917,"_7710":98383},[48836],"Default: 2,147,483,647",{"_12623":1837,"_48290":1645,"_18312":98385,"_5":17825,"_25222":97917,"_7710":98386},[48836],"hbase.htable.threads.keepalivetime",{"_12623":1838,"_48290":1645,"_18312":98388,"_5":17825,"_25222":97917,"_7710":98389},[48836],"Amount of time in seconds after we expire threads in the HTable's thread pool.",{"_12623":1839,"_48290":1645,"_18312":98391,"_5":17825,"_25222":97917,"_7710":98392},[48836],"Using the \"direct handoff\" approach, new threads will only be created if it is necessary and will grow unbounded. This could be bad but HTables only create as many Runnables as there are region servers; therefore, it also scales when new region servers are added.",{"_12623":1840,"_48290":1645,"_18312":98394,"_5":17825,"_25222":97917,"_7710":98350},[48836],{"_12623":1841,"_48290":1645,"_18312":98396,"_5":17825,"_25222":97917,"_7710":98397},[48836],"index.tablefactory.cache.size",{"_12623":1842,"_48290":1645,"_18312":98399,"_5":17825,"_25222":97917,"_7710":98400},[48836],"Number of index HTables we should keep in cache.",{"_12623":1843,"_48290":1645,"_18312":98402,"_5":17825,"_25222":97917,"_7710":98403},[48836],"Increasing this number ensures that we do not need to recreate an HTable for each attempt to write to an index table. Conversely, you could see memory pressure if this value is set too high.",{"_12623":1844,"_48290":1645,"_18312":98405,"_5":17825,"_25222":97917,"_7710":98338},[48836],{"_12623":1845,"_48290":1645,"_18312":98407,"_5":17825,"_25222":97917,"_7710":98408},[48836],"org.apache.phoenix.regionserver.index.priority.min",{"_12623":1846,"_48290":1645,"_18312":98410,"_5":17825,"_25222":97917,"_7710":98411},[48836],"Value to specify to bottom (inclusive) of the range in which index priority may lie.",{"_12623":1847,"_48290":1645,"_18312":98413,"_5":17825,"_25222":97917,"_7710":98414},[48836],"Default: 1000",{"_12623":1848,"_48290":1645,"_18312":98416,"_5":17825,"_25222":97917,"_7710":98417},[48836],"org.apache.phoenix.regionserver.index.priority.max",{"_12623":1849,"_48290":1645,"_18312":98419,"_5":17825,"_25222":97917,"_7710":98420},[48836],"Value to specify to top (exclusive) of the range in which index priority may lie.",{"_12623":1850,"_48290":1645,"_18312":98422,"_5":17825,"_25222":97917,"_7710":98423},[48836],"Higher priorites within the index min/max range do not means updates are processed sooner.",{"_12623":1851,"_48290":1645,"_18312":98425,"_5":17825,"_25222":97917,"_7710":98426},[48836],"Default: 1050",{"_12623":1852,"_48290":1645,"_18312":98428,"_5":17825,"_25222":97917,"_7710":98429},[48836],"org.apache.phoenix.regionserver.index.handler.count",{"_12623":1853,"_48290":1645,"_18312":98431,"_5":17825,"_25222":97917,"_7710":98432},[48836],"Number of threads to use when serving index write requests for global index maintenance.",{"_12623":1854,"_48290":1645,"_18312":98434,"_5":17825,"_25222":97917,"_7710":98435},[48836],"Though the actual number of threads is dictated by the Max(number of call queues, handler count), where the number of call queues is determined by standard HBase configuration. To further tune the queues, you can adjust the standard rpc queue length parameters (currently, there are no special knobs for the index queues), specifically ipc.server.max.callqueue.length and ipc.server.callqueue.handler.factor. See the HBase Reference Guide for more details.",{"_12623":1855,"_48290":1645,"_18312":98437,"_5":17825,"_25222":97917,"_7710":98438},[48836],"Default: 30",{"_12623":1856,"_48290":1645,"_18312":98440,"_5":17825,"_25222":97920,"_7710":98441},[48836],"We track secondary index performance via our performance framework. This is a generic test of performance based on defaults - your results will vary based on hardware specs as well as you individual configuration.",{"_12623":1857,"_48290":1645,"_18312":98443,"_5":17825,"_25222":97920,"_7710":98444},[48836],"That said, we have seen secondary indexing (both immutable and mutable) go as quickly as < 2x the regular write path on a small, (3 node) desktop-based cluster. This is actually pretty reasonable as we have to write to multiple tables as well as build the index update.",{"_12623":1858,"_48290":1645,"_18312":98446,"_5":17825,"_25222":97923,"_7710":98447},[48836],"With Phoenix 4.12, there is now a tool to run a MapReduce job to verify that an index table is valid against its data table. The only way to find orphaned rows in either table is to scan over all rows in the table and do a lookup in the other table for the corresponding row. For that reason, the tool can run with either the data or index table as the \"source\" table, and the other as the \"target\" table. The tool writes all invalid rows it finds either to file or to an output table PHOENIX_INDEX_SCRUTINY. An invalid row is a source row that either has no corresponding row in the target table, or has an incorrect value in the target table (i.e. covered column value).",{"_12623":1859,"_48290":1645,"_18312":98449,"_5":17825,"_25222":97923,"_7710":98450},[48836],"The tool has job counters that track its status. VALID_ROW_COUNT, INVALID_ROW_COUNT, BAD_COVERED_COL_VAL_COUNT. Note that invalid rows - bad col val rows = number of orphaned rows. These counters are written to the table PHOENIX_INDEX_SCRUTINY_METADATA, along with other job metadata.",{"_12623":1860,"_48290":1645,"_18312":98452,"_5":17825,"_25222":97923,"_7710":98453},[48836],"The Index Scrutiny Tool can be launched via the hbase command (in hbase/bin) as follows:",{"_12623":1861,"_48290":1645,"_18312":98455,"_5":17825,"_25222":97923,"_7710":98456},[48836],"It can also be run from Hadoop using either the phoenix-core or phoenix-server jar as follows:",{"_12623":1862,"_48290":1645,"_18312":98458,"_5":17825,"_25222":97923,"_7710":98459},[48836],"By default two mapreduce jobs are launched, one with the data table as the source table and one with the index table as the source table.",{"_12623":1863,"_48290":1645,"_18312":98461,"_5":17825,"_25222":97923,"_7710":98462},[48836],"The following parameters can be used with the Index Scrutiny Tool:",{"_12623":1864,"_48290":1645,"_18312":98464,"_5":17825,"_25222":97923,"_7710":94966},[48836],{"_12623":1865,"_48290":1645,"_18312":98466,"_5":17825,"_25222":97923,"_7710":94969},[48836],{"_12623":1866,"_48290":1645,"_18312":98468,"_5":17825,"_25222":97923,"_7710":98469},[48836],"-dt,--data-table",{"_12623":1867,"_48290":1645,"_18312":98471,"_5":17825,"_25222":97923,"_7710":98472},[48836],"Data table name (mandatory)",{"_12623":1868,"_48290":1645,"_18312":98474,"_5":17825,"_25222":97923,"_7710":95086},[48836],{"_12623":1869,"_48290":1645,"_18312":98476,"_5":17825,"_25222":97923,"_7710":98477},[48836],"Index table name (mandatory)",{"_12623":1870,"_48290":1645,"_18312":98479,"_5":17825,"_25222":97923,"_7710":95074},[48836],{"_12623":1871,"_48290":1645,"_18312":98481,"_5":17825,"_25222":97923,"_7710":95077},[48836],{"_12623":1872,"_48290":1645,"_18312":98483,"_5":17825,"_25222":97923,"_7710":98484},[48836],"-src,--source",{"_12623":1873,"_48290":1645,"_18312":98486,"_5":17825,"_25222":97923,"_7710":98487},[48836],"DATA_TABLE_SOURCE, INDEX_TABLE_SOURCE, or BOTH. Defaults to BOTH",{"_12623":1874,"_48290":1645,"_18312":98489,"_5":17825,"_25222":97923,"_7710":95068},[48836],{"_12623":1875,"_48290":1645,"_18312":98491,"_5":17825,"_25222":97923,"_7710":98492},[48836],"Whether to output invalid rows. Off by default",{"_12623":1876,"_48290":1645,"_18312":98494,"_5":17825,"_25222":97923,"_7710":98495},[48836],"-of,--output-format",{"_12623":1877,"_48290":1645,"_18312":98497,"_5":17825,"_25222":97923,"_7710":98498},[48836],"TABLE or FILE output format. Defaults to TABLE",{"_12623":1878,"_48290":1645,"_18312":98500,"_5":17825,"_25222":97923,"_7710":98501},[48836],"-om,--output-max",{"_12623":1879,"_48290":1645,"_18312":98503,"_5":17825,"_25222":97923,"_7710":98504},[48836],"Maximum number of invalid rows to output per mapper. Defaults to 1M",{"_12623":1880,"_48290":1645,"_18312":98506,"_5":17825,"_25222":97923,"_7710":98507},[48836],"-op,--output-path",{"_12623":1881,"_48290":1645,"_18312":98509,"_5":17825,"_25222":97923,"_7710":98510},[48836],"For FILE output format, the HDFS directory where files are written",{"_12623":1882,"_48290":1645,"_18312":98512,"_5":17825,"_25222":97923,"_7710":98513},[48836],"-t,--time",{"_12623":1883,"_48290":1645,"_18312":98515,"_5":17825,"_25222":97923,"_7710":98516},[48836],"Timestamp in millis at which to run the scrutiny. This is important so that incoming writes don't throw off the scrutiny. Defaults to current time minus 60 seconds",{"_12623":1884,"_48290":1645,"_18312":98518,"_5":17825,"_25222":97923,"_7710":98519},[48836],"-b,--batch-size",{"_12623":1885,"_48290":1645,"_18312":98521,"_5":17825,"_25222":97923,"_7710":98522},[48836],"Number of rows to compare at a time",{"_12623":1886,"_48290":1645,"_18312":98524,"_5":17825,"_25222":97927,"_7710":98525},[48836],"If rows are actively being updated or deleted while the scrutiny is running, the tool may give you false positives for inconsistencies (PHOENIX-4277).",{"_12623":1887,"_48290":1645,"_18312":98527,"_5":17825,"_25222":97927,"_7710":98528},[48836],"Snapshot reads are not supported by the scrutiny tool (PHOENIX-4270).",{"_12623":1888,"_48290":1645,"_18312":98530,"_5":17825,"_25222":97930,"_7710":98531},[48836],"IndexUpgradeTool updates global indexes created by Phoenix 4.14 and earlier (or 5.0) to use the new Strongly Consistent Global Indexes implementation.",{"_12623":1889,"_48290":1645,"_18312":98533,"_5":17825,"_25222":97930,"_7710":98534},[48836],"It accepts following parameters:",{"_12623":1890,"_48290":1645,"_18312":98536,"_5":17825,"_25222":97930,"_7710":94966},[48836],{"_12623":1891,"_48290":1645,"_18312":98538,"_5":17825,"_25222":97930,"_7710":94969},[48836],{"_12623":1892,"_48290":1645,"_18312":98540,"_5":17825,"_25222":97930,"_7710":98541},[48836],"only in version",{"_12623":1893,"_48290":1645,"_18312":98543,"_5":17825,"_25222":97930,"_7710":98544},[48836],"-o,--operation",{"_12623":1894,"_48290":1645,"_18312":98546,"_5":17825,"_25222":97930,"_7710":98547},[48836],"upgrade or rollback (mandatory)",{"_12623":1895,"_48290":1645,"_18312":98549,"_5":17825,"_25222":97930,"_7710":98550},[48836],"-tb,--tables",{"_12623":1896,"_48290":1645,"_18312":98552,"_5":17825,"_25222":97930,"_7710":98553},[48836],"[table1,table2,table3] (-tb or -f mandatory)",{"_12623":1897,"_48290":1645,"_18312":98555,"_5":17825,"_25222":97930,"_7710":98556},[48836],"-f,--file",{"_12623":1898,"_48290":1645,"_18312":98558,"_5":17825,"_25222":97930,"_7710":98559},[48836],"Csv file with above format (-tb or -f mandatory)",{"_12623":1899,"_48290":1645,"_18312":98561,"_5":17825,"_25222":97930,"_7710":98562},[48836],"-d,--dry-run",{"_12623":1900,"_48290":1645,"_18312":98564,"_5":17825,"_25222":97930,"_7710":98565},[48836],"If passed this will just output steps that will be executed; like a dry run",{"_12623":1901,"_48290":1645,"_18312":98567,"_5":17825,"_25222":97930,"_7710":98568},[48836],"-h,--help",{"_12623":1902,"_48290":1645,"_18312":98570,"_5":17825,"_25222":97930,"_7710":98571},[48836],"Help on how to use the tool",{"_12623":1903,"_48290":1645,"_18312":98573,"_5":17825,"_25222":97930,"_7710":98574},[48836],"-lf,--logfile",{"_12623":1904,"_48290":1645,"_18312":98576,"_5":17825,"_25222":97930,"_7710":98577},[48836],"File location to dump the logs",{"_12623":1905,"_48290":1645,"_18312":98579,"_5":17825,"_25222":97930,"_7710":98580},[48836],"-sr,--index-sync-rebuild",{"_12623":1906,"_48290":1645,"_18312":98582,"_5":17825,"_25222":97930,"_7710":98583},[48836],"whether or not synchronously rebuild the indexes; default rebuild asynchronous",{"_12623":1907,"_48290":1645,"_18312":98585,"_5":17825,"_25222":97930,"_7710":98586},[48836],"4.15",{"_12623":1908,"_48290":1645,"_18312":98588,"_5":17825,"_25222":97930,"_7710":98589},[48836],"-rb,--index-rebuild",{"_12623":1909,"_48290":1645,"_18312":98591,"_5":17825,"_25222":97930,"_7710":98592},[48836],"Rebuild the indexes. Set -tool to pass options to IndexTool",{"_12623":1910,"_48290":1645,"_18312":98594,"_5":17825,"_25222":97930,"_7710":98595},[48836],"4.16+, 5.1+",{"_12623":1911,"_48290":1645,"_18312":98597,"_5":17825,"_25222":97930,"_7710":98598},[48836],"-tool,--index-tool",{"_12623":1912,"_48290":1645,"_18312":98600,"_5":17825,"_25222":97930,"_7710":98601},[48836],"Options to pass to indexTool when rebuilding indexes",{"_12623":1913,"_48290":1645,"_18312":98603,"_5":17825,"_25222":97930,"_7710":98595},[48836],{"_12623":1914,"_48290":1645,"_18312":98605,"_5":17825,"_25222":97930,"_7710":98606},[48836],"For 4.16+/5.1+ either specifying the -rb option, or manually rebuilding the indexes with IndexTool after the upgrade is recommended, otherwise the first access of every index row will trigger an index row repair.",{"_12623":1915,"_48290":1645,"_18312":98608,"_5":17825,"_25222":97930,"_7710":98609},[48836],"Depending on whether index is mutable, it will remove Indexer coprocessor from a data table and load new coprocessor IndexRegionObserver. For both immutable and mutable, it will load GlobalIndexChecker coprocessor on Index table. During this process, data table and index table are disabled-loaded/unloaded with coproc-enabled within short time span. At the end, it does an asynchronous index rebuilds. Index reads are not blocked while index-rebuild is still ongoing, however, they may be a bit slower for rows written prior to upgrade.",{"_12623":1916,"_48290":1645,"_18312":98611,"_5":17825,"_25222":97930,"_7710":98612},[48836],"IndexUpgradeTool doesn't make any distinction between view-index and table-index. When a table is passed, it will perform the upgrade-operation on all the 'children' indexes of the given table.",{"_12623":1917,"_48290":1645,"_18312":98614,"_5":17825,"_25222":97934,"_7710":98615},[48836],"There have been several presentations given on how secondary indexing works in Phoenix that have a more in-depth look at how indexing works (with pretty pictures!):",{"_12623":1918,"_48290":1645,"_18312":98617,"_5":17825,"_25222":97934,"_7710":98618},[48836],"Slides for Strongly Consistent Global Indexes for Apache Phoenix, 2019 Distributed SQL Summit",{"_12623":1919,"_48290":1645,"_18312":98620,"_5":17825,"_25222":97934,"_7710":98621},[48836],"Recording of Strongly Consistent Global Indexes for Apache Phoenix, 2019 Distributed SQL Summit",{"_12623":1920,"_48290":1645,"_18312":98623,"_5":17825,"_25222":97934,"_7710":98624},[48836],"Slides for Local Secondary Indexes in Apache Phoenix, 2017 PhoenixCon",{"_12623":1921,"_48290":1645,"_18312":98626,"_5":17825,"_25222":97934,"_7710":98627},[48836],"These older resources refer to obsolete implementations in some cases",{"_12623":1922,"_48290":1645,"_18312":98629,"_5":17825,"_25222":97934,"_7710":98630},[48836],"Los Anglees HBase Meetup - Sept, 4th, 2013",{"_12623":1923,"_48290":1645,"_18312":98632,"_5":17825,"_25222":97934,"_7710":98633},[48836],"Local Indexes by Huawei",{"_12623":1924,"_48290":1645,"_18312":98635,"_5":17825,"_25222":97934,"_7710":98636},[48836],"PHOENIX-938 and HBASE-11513 for deadlock prevention during global index maintenance.",{"_12623":1925,"_48290":1645,"_18312":98638,"_5":17825,"_25222":97934,"_7710":98639},[48836],"PHOENIX-1112: Atomically rebuild index partially when index update fails",{"_12623":1926,"_48290":1926,"_5":13058,"_7710":98641,"_48807":98642,"_18312":98643,"_25222":1926},"Segment Scan",[92880,92881,92882,94570],[48836],{"_12623":1927,"_48290":1926,"_18312":98645,"_5":17825,"_25222":1926,"_7710":98646},[48836],"Get N evenly-bucketed key ranges for a Phoenix table so a client can drive a parallel full-table scan.",{"_12623":1928,"_48290":1926,"_5":48804,"_18312":98648,"_25222":98649,"_7710":95150},[48836],"/docs/features/segment-scan#segment-scan-when",{"_12623":1929,"_48290":1926,"_5":48804,"_18312":98651,"_25222":98652,"_7710":98653},[48836],"/docs/features/segment-scan#segment-scan-usage","Basic usage",{"_12623":1930,"_48290":1926,"_5":48804,"_18312":98655,"_25222":98656,"_7710":98657},[48836],"/docs/features/segment-scan#segment-scan-count","How many segments you actually get",{"_12623":1931,"_48290":1926,"_5":48804,"_18312":98659,"_25222":98660,"_7710":98661},[48836],"/docs/features/segment-scan#segment-scan-how","How it actually runs",{"_12623":1932,"_48290":1926,"_5":48804,"_18312":98663,"_25222":98664,"_7710":98665},[48836],"/docs/features/segment-scan#segment-scan-watch","Things to watch for",{"_12623":1933,"_48290":1926,"_18312":98667,"_5":17825,"_25222":1926,"_7710":98668},[48836],"Segment Scan turns a Phoenix table into N contiguous, non-overlapping key ranges\nthat you can hand out to a pool of workers to drive a parallel full-table scan. It is\nthe natural primitive for ETL exports, table validation/repair tools, bulk\nre-encoding, and anything else that needs to walk every row as fast as the cluster\ncan serve it. Available in Phoenix 5.3.0\n(PHOENIX-7684).",{"_12623":1934,"_48290":1926,"_18312":98670,"_5":17825,"_25222":98649,"_7710":98671},[48836],"Reach for Segment Scan when you want to read every row and you'd rather have many\nworkers do it concurrently than one client streaming sequentially. Typical use cases:",{"_12623":1935,"_48290":1926,"_18312":98673,"_5":17825,"_25222":98649,"_7710":98674},[48836],"Snapshot exports to a data lake / warehouse.",{"_12623":1936,"_48290":1926,"_18312":98676,"_5":17825,"_25222":98649,"_7710":98677},[48836],"Backfills or re-encodes (e.g. moving a column from VARBINARY to\nVARBINARY_ENCODED).",{"_12623":1937,"_48290":1926,"_18312":98679,"_5":17825,"_25222":98649,"_7710":98680},[48836],"Validation/repair scripts that scrub or hash every row.",{"_12623":1938,"_48290":1926,"_18312":98682,"_5":17825,"_25222":98649,"_7710":98683},[48836],"DynamoDB-style parallel scan against a Phoenix-backed table.",{"_12623":1939,"_48290":1926,"_18312":98685,"_5":17825,"_25222":98649,"_7710":98686},[48836],"If you only want to read some rows (e.g. by a key prefix or an indexed predicate),\nissue a normal SQL query — Segment Scan is for full-table fan-out, not selective\nfiltering.",{"_12623":1940,"_48290":1926,"_18312":98688,"_5":17825,"_25222":98652,"_7710":98689},[48836],"TOTAL_SEGMENTS() = N in the WHERE clause asks Phoenix to return N segment\nboundaries instead of running the query against the data. The boundaries are\nprojected via the SCAN_START_KEY() and SCAN_END_KEY() functions:",{"_12623":1941,"_48290":1926,"_18312":98691,"_5":17825,"_25222":98652,"_7710":98692},[48836],"You get back one row per segment with two VARBINARY columns: the start key and\nthe end key of that range, as raw HBase row-key bytes. Either may be empty — an\nempty start key means \"from the beginning of the table\"; an empty end key means\n\"to the end of the table\".",{"_12623":1942,"_48290":1926,"_18312":98694,"_5":17825,"_25222":98652,"_7710":98695},[48836],"To scan a segment, pass each (start_key, end_key) pair back into a regular Phoenix\nSQL query, using SCAN_START_KEY() and SCAN_END_KEY() as predicates with the\nbytes bound as parameters:",{"_12623":1943,"_48290":1926,"_18312":98697,"_5":17825,"_25222":98652,"_7710":98698},[48836],"Phoenix translates these predicates into the underlying HBase scan bounds for you,\nso a worker pool can stay in plain SQL — each worker runs its own query against one\nsegment, in parallel.",{"_12623":1944,"_48290":1926,"_18312":98700,"_5":17825,"_25222":98656,"_7710":98701},[48836],"The number of segments returned is min(N, num_regions):",{"_12623":1945,"_48290":1926,"_18312":98703,"_5":17825,"_25222":98656,"_7710":98704},[48836],"If N <= num_regions, Phoenix bundles consecutive regions together so you get\nexactly N segments. The grouping is as even as possible — with r = num_regions\nmod N segments getting one extra region.",{"_12623":1946,"_48290":1926,"_18312":98706,"_5":17825,"_25222":98656,"_7710":98707},[48836],"If N > num_regions, you simply get one segment per region. Phoenix will not\nsplit a region's key range into smaller sub-ranges for you, so the maximum\nachievable parallelism is bounded by the number of regions in the table.",{"_12623":1947,"_48290":1926,"_18312":98709,"_5":17825,"_25222":98656,"_7710":98710},[48836],"If you want more parallelism than your region count permits, pre-split the table or\nsalt it; Segment Scan respects whatever the current region layout is.",{"_12623":1948,"_48290":1926,"_18312":98712,"_5":17825,"_25222":98656,"_7710":98713},[48836],"N must be a positive integer. Passing 0 or a negative value returns SQL error\ncode 221 (\"TOTAL_SEGMENTS() value must be greater than 0\").",{"_12623":1949,"_48290":1926,"_18312":98715,"_5":17825,"_25222":98660,"_7710":98716},[48836],"TOTAL_SEGMENTS() is a marker, not a server-side function. The Phoenix planner sees\nit during compilation and replaces the query plan entirely with a client-side plan\nthat:",{"_12623":1950,"_48290":1926,"_18312":98718,"_5":17825,"_25222":98660,"_7710":98719},[48836],"Looks up the table's current region locations.",{"_12623":1951,"_48290":1926,"_18312":98721,"_5":17825,"_25222":98660,"_7710":98722},[48836],"Buckets them into min(N, num_regions) contiguous groups.",{"_12623":1952,"_48290":1926,"_18312":98724,"_5":17825,"_25222":98660,"_7710":98725},[48836],"Returns each group's combined (start_key, end_key) as a result row.",{"_12623":1953,"_48290":1926,"_18312":98727,"_5":17825,"_25222":98660,"_7710":98728},[48836],"No region-server scan is issued for this query — it's a metadata-only operation, so\nit's cheap to call, and it doesn't read or count any of the actual data.",{"_12623":1954,"_48290":1926,"_18312":98730,"_5":17825,"_25222":98664,"_7710":98731},[48836],"Region layout changes between discovery and scan. The segments you got back\nreflect the region layout at the time of the call. If the table splits or merges\nbetween segment discovery and your parallel scan, your (start_key, end_key)\nranges are still valid as byte ranges — they just may not align with current\nregions. The parallel scan still works; you just lose some of the\nregion-locality benefit.",{"_12623":1955,"_48290":1926,"_18312":98733,"_5":17825,"_25222":98664,"_7710":98734},[48836],"Each segment can still hold a lot of data. Segments correspond to one or more\nwhole regions. If your regions are large or unevenly populated, individual\nworkers may end up scanning more than others. Use this with the standard scan\ncontrols (paging, batch sizes) rather than relying on Segment Scan to balance row\ncounts.",{"_12623":1956,"_48290":1926,"_18312":98736,"_5":17825,"_25222":98664,"_7710":98737},[48836],"Segment Scan describes ranges; it doesn't scan. The parallel scan itself is\nyour responsibility — a worker pool takes one (start_key, end_key) per task and\nruns a regular Phoenix query bounded with SCAN_START_KEY() = ? AND SCAN_END_KEY()\n= ?.",{"_12623":1957,"_48290":1957,"_5":13058,"_7710":98739,"_48807":98740,"_18312":98741,"_25222":1957},"Skip Scan",[92880,92881,92882,94570],[48836],{"_12623":1958,"_48290":1957,"_18312":98743,"_5":17825,"_25222":1957,"_7710":98744},[48836],"How Phoenix Skip Scan uses key-range hints to efficiently skip non-matching row-key regions.",{"_12623":1959,"_48290":1957,"_18312":98746,"_5":17825,"_25222":1957,"_7710":98747},[48836],"Phoenix uses Skip Scan for intra-row scanning which allows for significant performance improvement over Range Scan when rows are retrieved based on a given set of keys.",{"_12623":1960,"_48290":1957,"_18312":98749,"_5":17825,"_25222":1957,"_7710":98750},[48836],"Skip Scan leverages SEEK_NEXT_USING_HINT in HBase filters. It stores information about which key sets or key ranges are being searched for in each column. During filter evaluation, it checks whether a key is in one of the valid combinations or ranges. If not, it computes the next highest key to jump to.",{"_12623":1961,"_48290":1957,"_18312":98752,"_5":17825,"_25222":1957,"_7710":98753},[48836],"Input to SkipScanFilter is a List<List<KeyRange>> where the top-level list represents each row-key column (that is, each primary key part), and the inner list represents OR-ed byte-array boundaries.",{"_12623":1962,"_48290":1957,"_18312":98755,"_5":17825,"_25222":1957,"_7710":98756},[48836],"Consider the following query:",{"_12623":1963,"_48290":1957,"_18312":98758,"_5":17825,"_25222":1957,"_7710":98759},[48836],"For the query above, the List<List<KeyRange>> passed to SkipScanFilter would look like:",{"_12623":1964,"_48290":1957,"_18312":98761,"_5":17825,"_25222":1957,"_7710":98762},[48836],"Here, [[a - b], [d - e]] represents ranges for KEY1, and [1, 2] represents the keys for KEY2.",{"_12623":1965,"_48290":1957,"_18312":98764,"_5":17825,"_25222":1957,"_7710":98765},[48836],"The following diagram illustrates graphically how the skip scan is able to jump around the key space:",{"_12623":1966,"_48290":1966,"_5":13058,"_7710":98767,"_48807":98768,"_18312":98769,"_25222":1966},"Statistics Collection",[92880,92881,92882,94570],[48836],{"_12623":1967,"_48290":1966,"_18312":98771,"_5":17825,"_25222":1966,"_7710":98772},[48836],"How Phoenix collects and uses guidepost statistics for query parallelization, with commands and configuration.",{"_12623":1968,"_48290":1966,"_5":48804,"_18312":98774,"_25222":98775,"_7710":98776},[48836],"/docs/features/statistics-collection#statistics-collection-parallelization","Parallelization",{"_12623":1969,"_48290":1966,"_5":48804,"_18312":98778,"_25222":98779,"_7710":94578},[48836],"/docs/features/statistics-collection#statistics-collection-examples",{"_12623":1970,"_48290":1966,"_5":48804,"_18312":98781,"_25222":98782,"_7710":98783},[48836],"/docs/features/statistics-collection#known-issues","Known issues",{"_12623":1971,"_48290":1966,"_5":48804,"_18312":98785,"_25222":98786,"_7710":92932},[48836],"/docs/features/statistics-collection#statistics-collection-configuration",{"_12623":1972,"_48290":1966,"_18312":98788,"_5":17825,"_25222":1966,"_7710":98789},[48836],"The UPDATE STATISTICS command updates the statistics collected on a table.\nThis command collects a set of keys per region per column family that\nare equal byte distanced from each other. These collected keys are called guideposts\nand they act as hints/guides to improve the parallelization of queries on a given\ntarget region.",{"_12623":1973,"_48290":1966,"_18312":98791,"_5":17825,"_25222":1966,"_7710":98792},[48836],"Statistics are also automatically collected during major compactions and region splits so\nmanually running this command may not be necessary.",{"_12623":1974,"_48290":1966,"_18312":98794,"_5":17825,"_25222":98775,"_7710":98795},[48836],"Phoenix breaks up queries into multiple scans and runs them in parallel to reduce latency.\nParallelization in Phoenix is driven by statistics-related configuration parameters.\nEach chunk of data between guideposts will be run in parallel in a separate scan to improve\nquery performance. The chunk size is determined by the GUIDE_POSTS_WIDTH table property (Phoenix 4.9+)\nor the global server-side phoenix.stats.guidepost.width parameter if the table property is\nnot set. As the size of the chunks decrease,\nyou'll want to increase phoenix.query.queueSize as more work will be queued in that\ncase. Note that at a minimum, separate scans will be run for each table region. Statistics in Phoenix\nprovides a means of gaining intraregion parallelization. In addition to the guidepost width specification,\nthe client-side phoenix.query.threadPoolSize and phoenix.query.queueSize parameters\nand the server-side hbase.regionserver.handler.count parameter have an impact on the amount\nof parallelization.",{"_12623":1975,"_48290":1966,"_18312":98797,"_5":17825,"_25222":98779,"_7710":98798},[48836],"To update the statistics for a given table my_table, execute the following command:",{"_12623":1976,"_48290":1966,"_18312":98800,"_5":17825,"_25222":98779,"_7710":98801},[48836],"The above syntax would collect the statistics for the table my_table and all the index tables,\nviews and view index tables associated with the table my_table.",{"_12623":1977,"_48290":1966,"_18312":98803,"_5":17825,"_25222":98779,"_7710":98804},[48836],"The equivalent syntax is:",{"_12623":1978,"_48290":1966,"_18312":98806,"_5":17825,"_25222":98779,"_7710":98807},[48836],"To collect statistics on the index table only:",{"_12623":1979,"_48290":1966,"_18312":98809,"_5":17825,"_25222":98779,"_7710":98810},[48836],"To collect statistics on the table only:",{"_12623":1980,"_48290":1966,"_18312":98812,"_5":17825,"_25222":98779,"_7710":98813},[48836],"To modify the guidepost width to 10MB for a table, execute the following command:",{"_12623":1981,"_48290":1966,"_18312":98815,"_5":17825,"_25222":98779,"_7710":98816},[48836],"To remove the guidepost width, set the property to null:",{"_12623":1982,"_48290":1966,"_18312":98818,"_5":17825,"_25222":98782,"_7710":98819},[48836],"Duplicated records (SQL count shows more rows than HBase row_count) can occur in Phoenix versions earlier than 4.12.",{"_12623":1983,"_48290":1966,"_18312":98821,"_5":17825,"_25222":98782,"_7710":98822},[48836],"This may happen for tables with several regions where guideposts were not generated for the last region(s) because the region size is smaller than the guidepost width.\nIn that case, parallel scans for those regions may start with the latest guidepost instead of the region start key.\nThis was fixed in 4.12 as part of PHOENIX-4007.",{"_12623":1984,"_48290":1966,"_18312":98824,"_5":17825,"_25222":98786,"_7710":98825},[48836],"The configuration parameters controlling statistics collection include:",{"_12623":1985,"_48290":1966,"_18312":98827,"_5":17825,"_25222":98786,"_7710":98828},[48836],"phoenix.stats.guidepost.width",{"_12623":1986,"_48290":1966,"_18312":98830,"_5":17825,"_25222":98786,"_7710":98831},[48836],"A server-side parameter that specifies the number of bytes between guideposts.\nA smaller amount increases parallelization, but also increases the number of\nchunks which must be merged on the client side.",{"_12623":1987,"_48290":1966,"_18312":98833,"_5":17825,"_25222":98786,"_7710":98834},[48836],"The default value is 104857600 (100 MB).",{"_12623":1988,"_48290":1966,"_18312":98836,"_5":17825,"_25222":98786,"_7710":98837},[48836],"phoenix.stats.updateFrequency",{"_12623":1989,"_48290":1966,"_18312":98839,"_5":17825,"_25222":98786,"_7710":98840},[48836],"A server-side parameter that determines the frequency in milliseconds for which statistics\nwill be refreshed from the statistics table and subsequently used by the client.",{"_12623":1990,"_48290":1966,"_18312":98842,"_5":17825,"_25222":98786,"_7710":98843},[48836],"The default value is 900000 (15 mins).",{"_12623":1991,"_48290":1966,"_18312":98845,"_5":17825,"_25222":98786,"_7710":98846},[48836],"phoenix.stats.minUpdateFrequency - A client-side parameter that determines the minimum amount of time in milliseconds that\nmust pass before statistics may again be manually collected through another UPDATE\nSTATISTICS call. - The default value is phoenix.stats.updateFrequency divided by two (7.5 mins).",{"_12623":1992,"_48290":1966,"_18312":98848,"_5":17825,"_25222":98786,"_7710":98849},[48836],"phoenix.stats.useCurrentTime",{"_12623":1993,"_48290":1966,"_18312":98851,"_5":17825,"_25222":98786,"_7710":98852},[48836],"An advanced server-side parameter that, if true, causes the current time on the server-side\nto be used as the timestamp of rows in the statistics table when background tasks such as\ncompactions or splits occur. If false, then the max timestamp found while traversing the\ntable over which statistics are being collected is used as the timestamp. Unless your\nclient is controlling the timestamps while reading and writing data, this parameter\nshould be left alone.",{"_12623":1994,"_48290":1966,"_18312":98854,"_5":17825,"_25222":98786,"_7710":98855},[48836],"The default value is true.",{"_12623":1995,"_48290":1966,"_18312":98857,"_5":17825,"_25222":98786,"_7710":98858},[48836],"phoenix.use.stats.parallelization",{"_12623":1996,"_48290":1966,"_18312":98860,"_5":17825,"_25222":98786,"_7710":98861},[48836],"This configuration is available starting in Phoenix 4.12. It controls whether statistical information\non the data should be used to drive query parallelization.",{"_12623":1997,"_48290":1966,"_18312":98863,"_5":17825,"_25222":98786,"_7710":98855},[48836],{"_12623":1998,"_48290":1998,"_5":13058,"_7710":98865,"_48807":98866,"_18312":98867,"_25222":1998},"Storage Formats",[92880,92881,92882,94570],[48836],{"_12623":1999,"_48290":1998,"_18312":98869,"_5":17825,"_25222":1998,"_7710":98870},[48836],"Configure Phoenix column mapping and immutable storage encoding for better storage efficiency and performance.",{"_12623":2000,"_48290":1998,"_5":48804,"_18312":98872,"_25222":98873,"_7710":98874},[48836],"/docs/features/storage-formats#how-to-use-column-mapping","How to use column mapping",{"_12623":2001,"_48290":1998,"_5":48804,"_18312":98876,"_25222":98877,"_7710":98878},[48836],"/docs/features/storage-formats#how-to-use-immutable-data-encoding","How to use immutable data encoding",{"_12623":2002,"_48290":1998,"_5":48804,"_18312":98880,"_25222":98881,"_7710":98882},[48836],"/docs/features/storage-formats#how-to-disable-column-mapping","How to disable column mapping",{"_12623":2003,"_48290":1998,"_18312":98884,"_5":17825,"_25222":1998,"_7710":98885},[48836],"As part of Phoenix 4.10, we have reduced on-disk storage size to improve overall performance by implementing the following enhancements:",{"_12623":2004,"_48290":1998,"_18312":98887,"_5":17825,"_25222":1998,"_7710":98888},[48836],"Introduce a layer of indirection between Phoenix column names and the corresponding HBase column qualifiers.",{"_12623":2005,"_48290":1998,"_18312":98890,"_5":17825,"_25222":1998,"_7710":98891},[48836],"Support a new encoding scheme for immutable tables that packs all values into a single cell per column family.",{"_12623":2006,"_48290":1998,"_18312":98893,"_5":17825,"_25222":1998,"_7710":98894},[48836],"For more details on column mapping and immutable data encoding, see this blog.",{"_12623":2007,"_48290":1998,"_18312":98896,"_5":17825,"_25222":98873,"_7710":98897},[48836],"You can set the column mapping property only when creating a table. Before deciding to use column mapping, think about how many columns your table and view hierarchy will require over their lifecycle. The following limits apply for each mapping scheme:",{"_12623":2008,"_48290":1998,"_18312":98899,"_5":17825,"_25222":98873,"_7710":98900},[48836],"Config/Property Value",{"_12623":2009,"_48290":1998,"_18312":98902,"_5":17825,"_25222":98873,"_7710":98903},[48836],"Max # of columns",{"_12623":2010,"_48290":1998,"_18312":98905,"_5":17825,"_25222":98873,"_7710":9341},[48836],{"_12623":2011,"_48290":1998,"_18312":98907,"_5":17825,"_25222":98873,"_7710":46859},[48836],{"_12623":2012,"_48290":1998,"_18312":98909,"_5":17825,"_25222":98873,"_7710":9370},[48836],{"_12623":2013,"_48290":1998,"_18312":98911,"_5":17825,"_25222":98873,"_7710":48271},[48836],{"_12623":2014,"_48290":1998,"_18312":98913,"_5":17825,"_25222":98873,"_7710":9397},[48836],{"_12623":2015,"_48290":1998,"_18312":98915,"_5":17825,"_25222":98873,"_7710":45749},[48836],{"_12623":2016,"_48290":1998,"_18312":98917,"_5":17825,"_25222":98873,"_7710":9320},[48836],{"_12623":2017,"_48290":1998,"_18312":98919,"_5":17825,"_25222":98873,"_7710":46752},[48836],{"_12623":2018,"_48290":1998,"_18312":98921,"_5":17825,"_25222":98873,"_7710":98922},[48836],"NONE",{"_12623":2019,"_48290":1998,"_18312":98924,"_5":17825,"_25222":98873,"_7710":98925},[48836],"no limit (theoretically)",{"_12623":2020,"_48290":1998,"_18312":98927,"_5":17825,"_25222":98873,"_7710":98928},[48836],"For mutable tables, this limit applies to columns in all column families. For immutable tables, the limit applies per column family. By default, new Phoenix tables use column mapping. These defaults can be overridden by setting the following config value in hbase-site.xml.",{"_12623":2021,"_48290":1998,"_18312":98930,"_5":17825,"_25222":98873,"_7710":98931},[48836],"Table type",{"_12623":2022,"_48290":1998,"_18312":98933,"_5":17825,"_25222":98873,"_7710":98934},[48836],"Default Column mapping",{"_12623":2023,"_48290":1998,"_18312":98936,"_5":17825,"_25222":98873,"_7710":98937},[48836],"Config",{"_12623":2024,"_48290":1998,"_18312":98939,"_5":17825,"_25222":98873,"_7710":98940},[48836],"Mutable/Immutable",{"_12623":2025,"_48290":1998,"_18312":98942,"_5":17825,"_25222":98873,"_7710":98943},[48836],"2 byte qualifiers",{"_12623":2026,"_48290":1998,"_18312":98945,"_5":17825,"_25222":98873,"_7710":98946},[48836],"phoenix.default.column.encoded.bytes.attrib",{"_12623":2027,"_48290":1998,"_18312":98948,"_5":17825,"_25222":98873,"_7710":98949},[48836],"This config controls global defaults that apply to all tables. If you want a different mapping scheme than the global default, use the COLUMN_ENCODED_BYTES table property.",{"_12623":2028,"_48290":1998,"_18312":98951,"_5":17825,"_25222":98877,"_7710":98952},[48836],"Like column mapping, immutable data encoding can only be set when creating a table. Through performance testing, SINGLE_CELL_ARRAY_WITH_OFFSETS generally provides strong performance and space savings. Below are some scenarios where ONE_CELL_PER_COLUMN encoding may be a better fit.",{"_12623":2029,"_48290":1998,"_18312":98954,"_5":17825,"_25222":98877,"_7710":98955},[48836],"Data is sparse, i.e. less than 50% of the columns have values.",{"_12623":2030,"_48290":1998,"_18312":98957,"_5":17825,"_25222":98877,"_7710":98958},[48836],"Size of data within a column family gets too big. With default HBase block size of 64K, if data within a column family grows beyond 50K then SINGLE_CELL_ARRAY_WITH_OFFSETS is generally not recommended.",{"_12623":2031,"_48290":1998,"_18312":98960,"_5":17825,"_25222":98877,"_7710":98961},[48836],"Immutable tables that are expected to have views on them.",{"_12623":2032,"_48290":1998,"_18312":98963,"_5":17825,"_25222":98877,"_7710":98964},[48836],"By default, immutable non-multitenant tables are created using two-byte column mapping and SINGLE_CELL_ARRAY_WITH_OFFSETS data encoding. Immutable multi-tenant tables are created with two-byte column mapping and ONE_CELL_PER_COLUMN data encoding. This is because users often create tenant-specific views on base multi-tenant tables, and as noted above this is more suitable for ONE_CELL_PER_COLUMN. Like column mapping, you can change these global defaults by setting the following configs in hbase-site.xml.",{"_12623":2033,"_48290":1998,"_18312":98966,"_5":17825,"_25222":98877,"_7710":98967},[48836],"Immutable Table type",{"_12623":2034,"_48290":1998,"_18312":98969,"_5":17825,"_25222":98877,"_7710":98970},[48836],"Immutable storage scheme",{"_12623":2035,"_48290":1998,"_18312":98972,"_5":17825,"_25222":98877,"_7710":98937},[48836],{"_12623":2036,"_48290":1998,"_18312":98974,"_5":17825,"_25222":98877,"_7710":98975},[48836],"Multi-tenant",{"_12623":2037,"_48290":1998,"_18312":98977,"_5":17825,"_25222":98877,"_7710":98978},[48836],"ONE_CELL_PER_COLUMN",{"_12623":2038,"_48290":1998,"_18312":98980,"_5":17825,"_25222":98877,"_7710":98981},[48836],"phoenix.default.multitenant.immutable.storage.scheme",{"_12623":2039,"_48290":1998,"_18312":98983,"_5":17825,"_25222":98877,"_7710":98984},[48836],"Non multi-tenant",{"_12623":2040,"_48290":1998,"_18312":98986,"_5":17825,"_25222":98877,"_7710":98987},[48836],"SINGLE_CELL_ARRAY_WITH_OFFSETS",{"_12623":2041,"_48290":1998,"_18312":98989,"_5":17825,"_25222":98877,"_7710":98990},[48836],"phoenix.default.immutable.storage.scheme",{"_12623":2042,"_48290":1998,"_18312":98992,"_5":17825,"_25222":98877,"_7710":98993},[48836],"You can also provide specific immutable storage and column mapping schemes with the IMMUTABLE_STORAGE_SCHEME and COLUMN_ENCODED_BYTES table properties. For example:",{"_12623":2043,"_48290":1998,"_18312":98995,"_5":17825,"_25222":98877,"_7710":98996},[48836],"You can choose not to use SINGLE_CELL_ARRAY_WITH_OFFSETS while still using numeric column mapping. For example:",{"_12623":2044,"_48290":1998,"_18312":98998,"_5":17825,"_25222":98877,"_7710":98999},[48836],"When using SINGLE_CELL_ARRAY_WITH_OFFSETS, you must use a numeric column mapping scheme. Attempting to use SINGLE_CELL_ARRAY_WITH_OFFSETS with COLUMN_ENCODED_BYTES = NONE throws an error.",{"_12623":2045,"_48290":1998,"_18312":99001,"_5":17825,"_25222":98881,"_7710":99002},[48836],"To disable column mapping across all new tables, set phoenix.default.column.encoded.bytes.attrib to 0. You can also keep it enabled globally and disable it selectively for a table by setting COLUMN_ENCODED_BYTES = 0 in the CREATE TABLE statement.",{"_12623":2046,"_48290":2046,"_5":13058,"_7710":99004,"_48807":99005,"_18312":99006,"_25222":2046},"Table Sampling",[92880,92881,92882,94570],[48836],{"_12623":2047,"_48290":2046,"_18312":99008,"_5":17825,"_25222":2046,"_7710":99009},[48836],"Use TABLESAMPLE in Phoenix for Bernoulli-style sampling, with performance notes, repeatability behavior, and tuning guidance.",{"_12623":2048,"_48290":2046,"_5":48804,"_18312":99011,"_25222":99012,"_7710":97754},[48836],"/docs/features/table-sampling#table-sampling-performance",{"_12623":2049,"_48290":2046,"_5":48804,"_18312":99014,"_25222":99015,"_7710":99016},[48836],"/docs/features/table-sampling#repeatable","Repeatable",{"_12623":2050,"_48290":2046,"_5":48804,"_18312":99018,"_25222":99019,"_7710":94578},[48836],"/docs/features/table-sampling#table-sampling-examples",{"_12623":2051,"_48290":2046,"_5":48804,"_18312":99021,"_25222":99022,"_7710":95522},[48836],"/docs/features/table-sampling#table-sampling-tuning",{"_12623":2052,"_48290":2046,"_18312":99024,"_5":17825,"_25222":2046,"_7710":99025},[48836],"To support table sampling (similar to PostgreSQL and T-SQL syntax), a TABLESAMPLE clause was incorporated into aliased table references as of Phoenix 4.12. The general syntax is described here. This feature limits the number of rows returned from a table to a percentage of rows. See PHOENIX-153 for implementation details.",{"_12623":2053,"_48290":2046,"_18312":99027,"_5":17825,"_25222":2046,"_7710":99028},[48836],"This feature is implemented with a Bernoulli trial and a consistent-hashing-based table sampler to achieve Bernoulli sampling on a given row population. Given a sampling rate, it leverages Phoenix statistics and HBase region distribution to perform table sampling.",{"_12623":2054,"_48290":2046,"_18312":99030,"_5":17825,"_25222":2046,"_7710":99031},[48836],"As part of statistics collection, a guidepost (a row reference) is created at equidistant byte intervals. When sampling is required, a Bernoulli trial process is applied repeatedly on each guidepost in each region with a probability proportional to the sampling rate. An included guidepost results in all rows between it and the next guidepost being included in the sample population.",{"_12623":2055,"_48290":2046,"_18312":99033,"_5":17825,"_25222":99012,"_7710":99034},[48836],"Sampling on a table with a sampling rate of 100% costs roughly the same computational resources as a query without sampling.\nResource consumption drops quickly as sampling rate decreases. In general, the amortized complexity of the sampling process is O(k + mn), where:",{"_12623":2056,"_48290":2046,"_18312":99036,"_5":17825,"_25222":99012,"_7710":99037},[48836],"n is the number of regions in the sampled HBase table.",{"_12623":2057,"_48290":2046,"_18312":99039,"_5":17825,"_25222":99012,"_7710":99040},[48836],"m is the number of guideposts.",{"_12623":2058,"_48290":2046,"_18312":99042,"_5":17825,"_25222":99012,"_7710":99043},[48836],"k is the sampled population size.",{"_12623":2059,"_48290":2046,"_18312":99045,"_5":17825,"_25222":99015,"_7710":99046},[48836],"Repeatable means repeated sampling on the same table returns the same sampled result.",{"_12623":2060,"_48290":2046,"_18312":99048,"_5":17825,"_25222":99015,"_7710":99049},[48836],"Repeatability is enabled by applying a consistent-hashing process to the binary representation of the start row key of each guidepost in each region during sampling. By default, an FNV1 implementation with lazy modulo is used. See FNV1.",{"_12623":2061,"_48290":2046,"_18312":99051,"_5":17825,"_25222":99019,"_7710":99052},[48836],"To sample a table, execute a query such as the following. The sampling rate is a numeric value between 0 and 100, inclusive.",{"_12623":2062,"_48290":2046,"_18312":99054,"_5":17825,"_25222":99019,"_7710":99055},[48836],"More examples:",{"_12623":2063,"_48290":2046,"_18312":99057,"_5":17825,"_25222":99019,"_7710":99058},[48836],"To use with aggregation:",{"_12623":2064,"_48290":2046,"_18312":99060,"_5":17825,"_25222":99019,"_7710":99061},[48836],"To explain a sampled query:",{"_12623":2065,"_48290":2046,"_18312":99063,"_5":17825,"_25222":99022,"_7710":99064},[48836],"Due to the sampling process, TABLESAMPLE should be used with caution. For example, a join of two tables is likely to return a match for each row in both tables; however, when sampling is applied to one or both tables, join results may differ from non-sampled expectations.",{"_12623":2066,"_48290":2046,"_18312":99066,"_5":17825,"_25222":99022,"_7710":99067},[48836],"Statistics should be collected to achieve the best sampling accuracy. To turn on statistics collection, refer to Statistics Collection.",{"_12623":2067,"_48290":2046,"_18312":99069,"_5":17825,"_25222":99022,"_7710":99070},[48836],"A denser guidepost setting improves sampling accuracy, but may reduce performance. A comparison is shown below.",{"_12623":2068,"_48290":2068,"_5":13058,"_7710":99072,"_48807":99073,"_18312":99074,"_25222":2068},"Tracing",[92880,92881,92882,94570],[48836],{"_12623":2069,"_48290":2068,"_18312":99076,"_5":17825,"_25222":2068,"_7710":99077},[48836],"Configure, enable, collect, and inspect Phoenix tracing data, including metrics sinks and tracing web app usage.",{"_12623":2070,"_48290":2068,"_5":48804,"_18312":99079,"_25222":99080,"_7710":92932},[48836],"/docs/features/tracing#tracing-configuration",{"_12623":2071,"_48290":2068,"_5":48804,"_18312":99082,"_25222":99083,"_7710":99084},[48836],"/docs/features/tracing#hadoop-metrics2-phoenixproperties","hadoop-metrics2-phoenix.properties",{"_12623":2072,"_48290":2068,"_5":48804,"_18312":99086,"_25222":99087,"_7710":99088},[48836],"/docs/features/tracing#hadoop-metrics2-hbaseproperties","hadoop-metrics2-hbase.properties",{"_12623":2073,"_48290":2068,"_5":48804,"_18312":99090,"_25222":99091,"_7710":99092},[48836],"/docs/features/tracing#disabling-tracing","Disabling tracing",{"_12623":2074,"_48290":2068,"_5":48804,"_18312":99094,"_25222":99095,"_7710":97045},[48836],"/docs/features/tracing#tracing-usage",{"_12623":2075,"_48290":2068,"_5":48804,"_18312":99097,"_25222":99098,"_7710":99099},[48836],"/docs/features/tracing#client-property","Client Property",{"_12623":2076,"_48290":2068,"_5":48804,"_18312":99101,"_25222":99102,"_7710":99103},[48836],"/docs/features/tracing#hbase-sitexml","hbase-site.xml",{"_12623":2077,"_48290":2068,"_5":48804,"_18312":99105,"_25222":99106,"_7710":99107},[48836],"/docs/features/tracing#reading-traces","Reading Traces",{"_12623":2078,"_48290":2068,"_5":48804,"_18312":99109,"_25222":99110,"_7710":99111},[48836],"/docs/features/tracing#phoenix-tracing-web-application","Phoenix Tracing Web Application",{"_12623":2079,"_48290":2068,"_5":48804,"_18312":99113,"_25222":99114,"_7710":99115},[48836],"/docs/features/tracing#how-to-start-the-tracing-web-application","How to start the tracing web application",{"_12623":2080,"_48290":2068,"_5":48804,"_18312":99117,"_25222":99118,"_7710":99119},[48836],"/docs/features/tracing#changing-the-web-app-port-number","Changing the web app port number",{"_12623":2081,"_48290":2068,"_5":48804,"_18312":99121,"_25222":99122,"_7710":99123},[48836],"/docs/features/tracing#feature-list","Feature list",{"_12623":2082,"_48290":2068,"_5":48804,"_18312":99125,"_25222":99126,"_7710":99127},[48836],"/docs/features/tracing#list","List",{"_12623":2083,"_48290":2068,"_5":48804,"_18312":99129,"_25222":99130,"_7710":99131},[48836],"/docs/features/tracing#dependency-tree","Dependency tree",{"_12623":2084,"_48290":2068,"_5":48804,"_18312":99133,"_25222":99134,"_7710":99135},[48836],"/docs/features/tracing#trace-count","Trace count",{"_12623":2085,"_48290":2068,"_5":48804,"_18312":99137,"_25222":99138,"_7710":99139},[48836],"/docs/features/tracing#trace-distribution","Trace distribution",{"_12623":2086,"_48290":2068,"_5":48804,"_18312":99141,"_25222":99142,"_7710":99143},[48836],"/docs/features/tracing#timeline","Timeline",{"_12623":2087,"_48290":2068,"_18312":99145,"_5":17825,"_25222":2068,"_7710":99146},[48836],"As of Phoenix 4.1.0, Phoenix supports collecting per-request traces. This allows you to see each important step in a query or insertion, all the way from the client through HBase and back again.",{"_12623":2088,"_48290":2068,"_18312":99148,"_5":17825,"_25222":2068,"_7710":99149},[48836],"Phoenix leverages Cloudera's HTrace library to integrate with HBase tracing utilities. Trace metrics are then deposited into a Hadoop Metrics2 sink that writes them into a Phoenix table.",{"_12623":2089,"_48290":2068,"_18312":99151,"_5":17825,"_25222":2068,"_7710":99152},[48836],"Writing traces to a Phoenix table is not supported on Hadoop 1.",{"_12623":2090,"_48290":2068,"_18312":99154,"_5":17825,"_25222":99080,"_7710":99155},[48836],"There are two key configuration files that you will need to update.",{"_12623":2091,"_48290":2068,"_18312":99157,"_5":17825,"_25222":99080,"_7710":99084},[48836],{"_12623":2092,"_48290":2068,"_18312":99159,"_5":17825,"_25222":99080,"_7710":99088},[48836],{"_12623":2093,"_48290":2068,"_18312":99161,"_5":17825,"_25222":99080,"_7710":99162},[48836],"They contain the properties you need to set on the client and server, respectively, as well as information on how the Metrics2 system uses the configuration files.",{"_12623":2094,"_48290":2068,"_18312":99164,"_5":17825,"_25222":99080,"_7710":99165},[48836],"Put these files on their respective classpaths and restart the process to pick up the new configurations.",{"_12623":2095,"_48290":2068,"_18312":99167,"_5":17825,"_25222":99083,"_7710":99168},[48836],"This file will configure the Hadoop Metrics2 system for Phoenix clients.",{"_12623":2096,"_48290":2068,"_18312":99170,"_5":17825,"_25222":99083,"_7710":99171},[48836],"The default properties you should set are:",{"_12623":2097,"_48290":2068,"_18312":99173,"_5":17825,"_25222":99083,"_7710":99174},[48836],"This enables standard Phoenix metrics sink (which collects the trace information) and writer (writes the traces to the Phoenix SYSTEM.TRACING_STATS table). You can modify this to set your own custom classes as well, if you have them.",{"_12623":2098,"_48290":2068,"_18312":99176,"_5":17825,"_25222":99083,"_7710":99177},[48836],"See the properties file in the source (phoenix-hadoop2-compat/bin) for more information on setting custom sinks and writers.",{"_12623":2099,"_48290":2068,"_18312":99179,"_5":17825,"_25222":99087,"_7710":99180},[48836],"A default HBase deployment already includes a Metrics2 configuration, so Phoenix Metrics2 config can either replace the existing file (if you do not have custom settings) or be merged into your existing Metrics2 configuration file.",{"_12623":2100,"_48290":2068,"_18312":99182,"_5":17825,"_25222":99087,"_7710":99183},[48836],"These are essentially the same properties as in hadoop-metrics2-phoenix.properties, but prefixed with hbase instead of phoenix so they are loaded with the rest of HBase metrics.",{"_12623":2101,"_48290":2068,"_18312":99185,"_5":17825,"_25222":99091,"_7710":99186},[48836],"You can disable tracing for client requests by creating a new connection without the tracing property enabled (see below).",{"_12623":2102,"_48290":2068,"_18312":99188,"_5":17825,"_25222":99091,"_7710":99189},[48836],"However, on the server side, once the metrics sink is enabled you cannot turn off trace collection and writing unless you remove the Phoenix Metrics2 configuration and restart the region server. This is enforced by the Metrics2 framework, which assumes server metrics should always be collected.",{"_12623":2103,"_48290":2068,"_18312":99191,"_5":17825,"_25222":99095,"_7710":99192},[48836],"There are only a couple small things you need to do to enable tracing a given request with Phoenix.",{"_12623":2104,"_48290":2068,"_18312":99194,"_5":17825,"_25222":99098,"_7710":99195},[48836],"The frequency of tracing is determined by the following client-side Phoenix property:",{"_12623":2105,"_48290":2068,"_18312":99197,"_5":17825,"_25222":99098,"_7710":99198},[48836],"There are three possible tracing frequencies you can use:",{"_12623":2106,"_48290":2068,"_18312":99200,"_5":17825,"_25222":99098,"_7710":44337},[48836],{"_12623":2107,"_48290":2068,"_18312":99202,"_5":17825,"_25222":99098,"_7710":99203},[48836],"This is the default",{"_12623":2108,"_48290":2068,"_18312":99205,"_5":17825,"_25222":99098,"_7710":27589},[48836],{"_12623":2109,"_48290":2068,"_18312":99207,"_5":17825,"_25222":99098,"_7710":99208},[48836],"Every request will be traced",{"_12623":2110,"_48290":2068,"_18312":99210,"_5":17825,"_25222":99098,"_7710":11465},[48836],{"_12623":2111,"_48290":2068,"_18312":99212,"_5":17825,"_25222":99098,"_7710":99213},[48836],"Take traces with a probabilistic frequency",{"_12623":2112,"_48290":2068,"_18312":99215,"_5":17825,"_25222":99098,"_7710":99216},[48836],"probability threshold is set by phoenix.trace.probability.threshold with a default of 0.05 (5%).",{"_12623":2113,"_48290":2068,"_18312":99218,"_5":17825,"_25222":99098,"_7710":99219},[48836],"As with other configuration properties, this property may be specified at JDBC connection time as a connection property.\nEnabling one of these properties only turns on trace collection. Trace data still needs to be deposited somewhere.",{"_12623":2114,"_48290":2068,"_18312":99221,"_5":17825,"_25222":99098,"_7710":94470},[48836],{"_12623":2115,"_48290":2068,"_18312":99223,"_5":17825,"_25222":99102,"_7710":99224},[48836],"You can also enable tracing via hbase-site.xml. However, only always and never are currently supported.",{"_12623":2116,"_48290":2068,"_18312":99226,"_5":17825,"_25222":99106,"_7710":99227},[48836],"Once the traces are deposited into the tracing table, by default SYSTEM.TRACING_STATS, but it is configurable in the HBase configuration via:",{"_12623":2117,"_48290":2068,"_18312":99229,"_5":17825,"_25222":99106,"_7710":99230},[48836],"The tracing table is initialized via the DDL:",{"_12623":2118,"_48290":2068,"_18312":99232,"_5":17825,"_25222":99106,"_7710":99233},[48836],"The tracing table also contains a number of dynamic columns for each trace. A trace is identified by trace ID (request ID), parent ID (parent span ID), and span ID (individual segment ID), and may have multiple tags and annotations. Once you know the number of tags and annotations, you can retrieve them from the table with a query like:",{"_12623":2119,"_48290":2068,"_18312":99235,"_5":17825,"_25222":99106,"_7710":99236},[48836],"Where columns is either annotations.aX or tags.tX, where X is the index of the dynamic column to look up.",{"_12623":2120,"_48290":2068,"_18312":99238,"_5":17825,"_25222":99106,"_7710":99239},[48836],"For more usage examples, see TraceReader, which can programmatically read traces from the tracing results table.",{"_12623":2121,"_48290":2068,"_18312":99241,"_5":17825,"_25222":99106,"_7710":99242},[48836],"Custom annotations can also be passed into Phoenix to be added to traces. Phoenix looks for connection properties whose names start with phoenix.annotation. and adds them as annotations to client-side traces. For example, a connection property phoenix.annotation.myannotation=abc results in an annotation with key myannotation and value abc. Use this to link traces to other request identifiers in your system, such as user or session IDs.",{"_12623":2122,"_48290":2068,"_18312":99244,"_5":17825,"_25222":99114,"_7710":99245},[48836],"Enable tracing for Apache Phoenix as above",{"_12623":2123,"_48290":2068,"_18312":99247,"_5":17825,"_25222":99114,"_7710":99248},[48836],"Start the web app:",{"_12623":2124,"_48290":2068,"_18312":99250,"_5":17825,"_25222":99114,"_7710":99251},[48836],"Open this URL in your browser: http://localhost:8864/webapp/",{"_12623":2125,"_48290":2068,"_18312":99253,"_5":17825,"_25222":99114,"_7710":99254},[48836],"Stop the tracing web app:",{"_12623":2126,"_48290":2068,"_18312":99256,"_5":17825,"_25222":99118,"_7710":99257},[48836],"Execute the command below:",{"_12623":2127,"_48290":2068,"_18312":99259,"_5":17825,"_25222":99122,"_7710":99260},[48836],"The tracing web app for Apache Phoenix includes: feature list, dependency tree, trace count, trace distribution, and timeline.",{"_12623":2128,"_48290":2068,"_18312":99262,"_5":17825,"_25222":99126,"_7710":99263},[48836],"The most recent traces are listed down. The limiting value entered on the textbox is used to determine the trace count displayed. With each trace, there is a link to view either the dependency tree or the timeline.",{"_12623":2129,"_48290":2068,"_18312":99265,"_5":17825,"_25222":99130,"_7710":99266},[48836],"The dependency tree shows traces for a given trace ID in a tree view. Parent-child relationships are displayed clearly. Tooltip data includes host name, parent ID, span ID, start time, end time, description, and duration. Each node is collapsible and expandable. The SQL query is shown for each tree rendering. Clear is used to remove the tree from view.",{"_12623":2130,"_48290":2068,"_18312":99268,"_5":17825,"_25222":99134,"_7710":99269},[48836],"The trace list is categorized by description. The trace count chart can be viewed as pie, line, bar, or area chart. The chart selector is collapsible and can be hidden.",{"_12623":2131,"_48290":2068,"_18312":99271,"_5":17825,"_25222":99138,"_7710":99272},[48836],"The trace distribution chart shows traces across Phoenix hosts on which they are running. Chart types include pie, line, bar, and area. The chart selector is collapsible and can be hidden.",{"_12623":2132,"_48290":2068,"_18312":99274,"_5":17825,"_25222":99142,"_7710":99275},[48836],"The traces can be viewed along the time axis for a given trace id. Traces can be added or cleared from the timeline. There should be a minimum of two traces starting at two different times for the system to draw its timeline. This feature helps the user to easily compare execution times between traces and within the same trace.",{"_12623":2133,"_48290":2133,"_5":13058,"_7710":99277,"_48807":99278,"_18312":99279,"_25222":2133},"Transactions",[92880,92881,92882,94570],[48836],{"_12623":2134,"_48290":2133,"_18312":99281,"_5":17825,"_25222":2133,"_7710":99282},[48836],"Configure and use transactional tables in Phoenix with Tephra, including setup steps and limitations.",{"_12623":2135,"_48290":2133,"_5":48804,"_18312":99284,"_25222":99285,"_7710":93002},[48836],"/docs/features/transactions#transactions-limitations",{"_12623":2136,"_48290":2133,"_18312":99287,"_5":17825,"_25222":2133,"_7710":99288},[48836],"Transactions (beta). Above and beyond the row-level transactional semantics of HBase, Phoenix adds cross row and cross table transaction support with full ACID semantics by integrating with Tephra, now an Apache incubator project. Tephra provides snapshot isolation of concurrent transactions by implementing multi-versioned concurrency control.",{"_12623":2137,"_48290":2133,"_18312":99290,"_5":17825,"_25222":2133,"_7710":99291},[48836],"Set up a system to use transactions in Phoenix with the following steps:",{"_12623":2138,"_48290":2133,"_18312":99293,"_5":17825,"_25222":2133,"_7710":99294},[48836],"Add the following config to your client-side hbase-site.xml file to enable transactions:",{"_12623":2139,"_48290":2133,"_18312":99296,"_5":17825,"_25222":2133,"_7710":99297},[48836],"Add the following config to your server-side hbase-site.xml file to configure the transaction manager.\nThe \"Transaction Server Configuration\" section of Tephra describes the available configuration options.",{"_12623":2140,"_48290":2133,"_18312":99299,"_5":17825,"_25222":2133,"_7710":99300},[48836],"Also set the transaction timeout (time after which open transactions become invalid) to a reasonable value:",{"_12623":2141,"_48290":2133,"_18312":99302,"_5":17825,"_25222":2133,"_7710":99303},[48836],"Set $HBASE_HOME and start the transaction manager:",{"_12623":2142,"_48290":2133,"_18312":99305,"_5":17825,"_25222":2133,"_7710":99306},[48836],"The transaction manager would typically be configured to run on one or more of the master nodes in your HBase cluster.",{"_12623":2143,"_48290":2133,"_18312":99308,"_5":17825,"_25222":2133,"_7710":99309},[48836],"Once this setup is done, transactions may then be enabled on a table by table basis by using the TRANSACTIONAL=true property when you create your table:",{"_12623":2144,"_48290":2133,"_18312":99311,"_5":17825,"_25222":2133,"_7710":99312},[48836],"An existing table may also be altered to be transactional, but be careful because you cannot switch a transactional table back to being non transactional:",{"_12623":2145,"_48290":2133,"_18312":99314,"_5":17825,"_25222":2133,"_7710":99315},[48836],"A transaction is started implicitly through the execution of a statement on a transactional table and then finished through either a commit or rollback. Once started, the statements will not see any data committed by other transactions until the transaction is complete. They will, however, see their own uncommitted data. For example:",{"_12623":2146,"_48290":2133,"_18312":99317,"_5":17825,"_25222":2133,"_7710":99318},[48836],"An exception is thrown if a transaction tries to commit a row that conflicts with other overlapping transaction that already committed. For example:",{"_12623":2147,"_48290":2133,"_18312":99320,"_5":17825,"_25222":2133,"_7710":99321},[48836],"In a second transaction perform a commit for the same row.",{"_12623":2148,"_48290":2133,"_18312":99323,"_5":17825,"_25222":2133,"_7710":99324},[48836],"Now if you try to commit the first transaction you will get an exception",{"_12623":2149,"_48290":2133,"_18312":99326,"_5":17825,"_25222":2133,"_7710":99327},[48836],"Queries are only able to view commits that completed before the current transaction started and are not able to view the in progress changes of other transactions.",{"_12623":2150,"_48290":2133,"_18312":99329,"_5":17825,"_25222":2133,"_7710":99330},[48836],"Indexes added to a transactional table are transactional as well with regard to their incremental maintenance. For example, the following index added to my_table will be kept transactional consistent with its data table as mutations are made:",{"_12623":2151,"_48290":2133,"_18312":99332,"_5":17825,"_25222":2133,"_7710":99333},[48836],"During a commit, if either the index or data table write fails, an exception is thrown and the client can either roll back or retry.\nIf the commit fails both the index and data table rows are not visible.",{"_12623":2152,"_48290":2133,"_18312":99335,"_5":17825,"_25222":2133,"_7710":99336},[48836],"An external Tephra transaction that has already been started can be used with Phoenix by setting the transaction context of the Phoenix connection:",{"_12623":2153,"_48290":2133,"_18312":99338,"_5":17825,"_25222":99285,"_7710":99339},[48836],"Starting a transaction on a connection with an SCN set is not allowed.",{"_12623":2154,"_48290":2133,"_18312":99341,"_5":17825,"_25222":99285,"_7710":99342},[48836],"Setting the maximum number of versions property while creating a transactional table limits the number of snapshots available for concurrent transactions.",{"_12623":2155,"_48290":2133,"_18312":99344,"_5":17825,"_25222":99285,"_7710":99345},[48836],"When a transaction times out or if it cannot be rolled back by the client, it is added to an invalid list. This list can potentially grow if there are a lot of failed or timed out transactions.\nFor now, an administrator can manually clear transactions from this list after a major compaction has occurred. TEPHRA-35 describes ongoing work to automatically remove transactions from the invalid list once all data associated with the transaction has been removed.",{"_12623":2156,"_48290":2133,"_18312":99347,"_5":17825,"_25222":99285,"_7710":99348},[48836],"If adding an index asynchronously to an existing transactional table, make sure to run a major compaction before issuing the CREATE INDEX ASYNC command as otherwise invalid and/or uncommitted transactions may appear in your index PHOENIX-2154.",{"_12623":2157,"_48290":2157,"_5":13058,"_7710":99350,"_48807":99351,"_18312":99352,"_25222":2157},"TTL",[92880,92881,92882,94570],[48836],{"_12623":2158,"_48290":2157,"_18312":99354,"_5":17825,"_25222":2157,"_7710":99355},[48836],"Phoenix TTL flavors (time-based, view, conditional) and the IS_STRICT_TTL property that controls visibility of expired rows.",{"_12623":2159,"_48290":2157,"_5":48804,"_18312":99357,"_25222":99358,"_7710":99359},[48836],"/docs/features/ttl#time-based-ttl","Time-based TTL",{"_12623":2160,"_48290":2157,"_5":48804,"_18312":99361,"_25222":99362,"_7710":99363},[48836],"/docs/features/ttl#view-ttl-summary","View TTL",{"_12623":2161,"_48290":2157,"_5":48804,"_18312":99365,"_25222":99366,"_7710":95379},[48836],"/docs/features/ttl#conditional-ttl-summary",{"_12623":2162,"_48290":2157,"_5":48804,"_18312":99368,"_25222":99369,"_7710":99370},[48836],"/docs/features/ttl#strict-vs-relaxed-ttl","Strict vs Relaxed TTL",{"_12623":2163,"_48290":2157,"_18312":99372,"_5":17825,"_25222":2157,"_7710":99373},[48836],"Phoenix supports per-row time-to-live (TTL) so that rows can be expired and removed\nwithout an application-issued DELETE. There are three flavors, and one orthogonal\ntable property — IS_STRICT_TTL — that controls how aggressively expired rows are\nhidden from reads.",{"_12623":2164,"_48290":2157,"_18312":99375,"_5":17825,"_25222":99358,"_7710":99376},[48836],"Set a numeric value (in seconds) on the TTL table property at CREATE TABLE time\nto age every row out a fixed duration after its cell timestamp:",{"_12623":2165,"_48290":2157,"_18312":99378,"_5":17825,"_25222":99358,"_7710":99379},[48836],"Rows older than the TTL are removed by Phoenix compaction during HBase region\ncompactions. Time-based TTL is the right choice when retention is a flat duration\nthat applies uniformly to every row in the table.",{"_12623":2166,"_48290":2157,"_18312":99381,"_5":17825,"_25222":99362,"_7710":99382},[48836],"Each view over a shared base table can set its own retention\nwindow, so different tenants or use cases can age data out independently without\nsplitting the underlying table. See View TTL for the\nfull feature.",{"_12623":2167,"_48290":2157,"_18312":99384,"_5":17825,"_25222":99366,"_7710":99385},[48836],"Express row expiration as a SQL boolean expression evaluated against the row's own\ncolumn values, instead of a fixed duration. A row is considered expired the moment\nthe expression evaluates to TRUE for that row. See\nConditional TTL for the full feature.",{"_12623":2168,"_48290":2157,"_18312":99387,"_5":17825,"_25222":99369,"_7710":99388},[48836],"IS_STRICT_TTL is a table property that controls how strictly expired rows are\nhidden from reads. It applies to every flavor of TTL above — time-based, view,\nand conditional. The default is true (strict).",{"_12623":2169,"_48290":2157,"_18312":99390,"_5":17825,"_25222":99369,"_7710":99391},[48836],"Mode",{"_12623":2170,"_48290":2157,"_18312":99393,"_5":17825,"_25222":99369,"_7710":95842},[48836],{"_12623":2171,"_48290":2157,"_18312":99395,"_5":17825,"_25222":99369,"_7710":99396},[48836],"Strict (IS_STRICT_TTL = true, default)",{"_12623":2172,"_48290":2157,"_18312":99398,"_5":17825,"_25222":99369,"_7710":99399},[48836],"Expired rows are filtered out on every read path — they're invisible to queries the moment they expire.",{"_12623":2173,"_48290":2157,"_18312":99401,"_5":17825,"_25222":99369,"_7710":99402},[48836],"Relaxed (IS_STRICT_TTL = false)",{"_12623":2174,"_48290":2157,"_18312":99404,"_5":17825,"_25222":99369,"_7710":99405},[48836],"Expired rows remain visible to readers until major compaction physically removes them. Similar to DynamoDB's TTL expiry behavior.",{"_12623":2175,"_48290":2157,"_18312":99407,"_5":17825,"_25222":99369,"_7710":99408},[48836],"The trade-off:",{"_12623":2176,"_48290":2157,"_18312":99410,"_5":17825,"_25222":99369,"_7710":99411},[48836],"Strict gives you a strong \"expired = invisible\" guarantee. It's the right\nchoice when retention is a correctness or compliance concern.",{"_12623":2177,"_48290":2157,"_18312":99413,"_5":17825,"_25222":99369,"_7710":99414},[48836],"Relaxed has a cheaper write path. The largest gain is with\nConditional TTL: under strict mode, every\nmutation reads the current row state to evaluate the TTL expression, which adds\nlatency. Relaxed mode skips that pre-read.",{"_12623":2178,"_48290":2157,"_18312":99416,"_5":17825,"_25222":99369,"_7710":99417},[48836],"You can also switch a table between modes:",{"_12623":2179,"_48290":2157,"_18312":99419,"_5":17825,"_25222":99369,"_7710":99420},[48836],"Start with the default. Switch to relaxed only when the cheaper write path is the\nright trade-off for your workload and eventual visibility of expired rows is\nacceptable for your readers.",{"_12623":2180,"_48290":2180,"_5":13058,"_7710":99422,"_48807":99423,"_18312":99424,"_25222":2180},"User-defined Functions",[92880,92881,92882,94570],[48836],{"_12623":2181,"_48290":2180,"_18312":99426,"_5":17825,"_25222":2180,"_7710":99427},[48836],"Create, deploy, and manage custom Phoenix UDFs with configuration, implementation steps, and known limitations.",{"_12623":2182,"_48290":2180,"_5":48804,"_18312":99429,"_25222":99430,"_7710":97033},[48836],"/docs/features/user-defined-functions#user-defined-functions-overview",{"_12623":2183,"_48290":2180,"_5":48804,"_18312":99432,"_25222":99433,"_7710":92932},[48836],"/docs/features/user-defined-functions#user-defined-functions-configuration",{"_12623":2184,"_48290":2180,"_5":48804,"_18312":99435,"_25222":99436,"_7710":99437},[48836],"/docs/features/user-defined-functions#creating-custom-udfs","Creating Custom UDFs",{"_12623":2185,"_48290":2180,"_5":48804,"_18312":99439,"_25222":99440,"_7710":99441},[48836],"/docs/features/user-defined-functions#dropping-the-udfs","Dropping the UDFs",{"_12623":2186,"_48290":2180,"_5":48804,"_18312":99443,"_25222":99444,"_7710":99445},[48836],"/docs/features/user-defined-functions#how-to-write-custom-udf","How to write custom UDF",{"_12623":2187,"_48290":2180,"_5":48804,"_18312":99447,"_25222":99448,"_7710":93002},[48836],"/docs/features/user-defined-functions#user-defined-functions-limitations",{"_12623":2188,"_48290":2180,"_18312":99450,"_5":17825,"_25222":2180,"_7710":99451},[48836],"As of Phoenix 4.4.0 we have added the ability to allow users to create and deploy\ntheir own custom or domain-specific UDFs to the cluster.",{"_12623":2189,"_48290":2180,"_18312":99453,"_5":17825,"_25222":99430,"_7710":99454},[48836],"Users can create temporary or permanent user-defined (domain-specific) scalar functions.\nUDFs can be used like built-in functions in queries such as SELECT, UPSERT, DELETE, and when creating functional indexes.\nTemporary functions are session-scoped and are not accessible from other sessions.\nPermanent function metadata is stored in the SYSTEM.FUNCTION table.\nPhoenix also supports tenant-specific functions. Functions created in one tenant-specific connection are not visible to other tenant-specific connections.\nOnly global tenant (no-tenant) functions are visible to all connections.",{"_12623":2190,"_48290":2180,"_18312":99456,"_5":17825,"_25222":99430,"_7710":99457},[48836],"Phoenix leverages the HBase dynamic class loader to load UDF JARs from HDFS at the Phoenix client and region server without restarting services.",{"_12623":2191,"_48290":2180,"_18312":99459,"_5":17825,"_25222":99433,"_7710":99460},[48836],"Add the following parameters to hbase-site.xml on the Phoenix client:",{"_12623":2192,"_48290":2180,"_18312":99462,"_5":17825,"_25222":99433,"_7710":99463},[48836],"The last two configuration values should match the HBase server-side configuration.",{"_12623":2193,"_48290":2180,"_18312":99465,"_5":17825,"_25222":99433,"_7710":99466},[48836],"As with other configuration properties, phoenix.functions.allowUserDefinedFunctions\nmay be specified at JDBC connection time as a connection property.",{"_12623":2194,"_48290":2180,"_18312":99468,"_5":17825,"_25222":99433,"_7710":94470},[48836],{"_12623":2195,"_48290":2180,"_18312":99470,"_5":17825,"_25222":99433,"_7710":99471},[48836],"The following optional parameter is used by the dynamic class loader to copy JARs from HDFS into the local filesystem:",{"_12623":2196,"_48290":2180,"_18312":99473,"_5":17825,"_25222":99436,"_7710":99474},[48836],"Implement your custom UDF by following How to write custom\nUDF.",{"_12623":2197,"_48290":2180,"_18312":99476,"_5":17825,"_25222":99436,"_7710":99477},[48836],"Compile your code into a JAR, then deploy the JAR to HDFS. It is recommended\nto add the JAR to the HDFS directory configured by hbase.dynamic.jars.dir.",{"_12623":2198,"_48290":2180,"_18312":99479,"_5":17825,"_25222":99440,"_7710":99480},[48836],"You can drop functions using the DROP FUNCTION query.\nDropping a function deletes the metadata for that function from Phoenix.",{"_12623":2199,"_48290":2180,"_18312":99482,"_5":17825,"_25222":99444,"_7710":99483},[48836],"You can follow these steps to write your UDF (for more detail, see this blog post):",{"_12623":2200,"_48290":2180,"_18312":99485,"_5":17825,"_25222":99444,"_7710":99486},[48836],"Create a new class derived from org.apache.phoenix.expression.function.ScalarFunction.",{"_12623":2201,"_48290":2180,"_18312":99488,"_5":17825,"_25222":99444,"_7710":99489},[48836],"Implement getDataType() to determine the function return type.",{"_12623":2202,"_48290":2180,"_18312":99491,"_5":17825,"_25222":99444,"_7710":99492},[48836],"Implement evaluate() to calculate the result for each row.\nThe method receives org.apache.phoenix.schema.tuple.Tuple with the current row state and an org.apache.hadoop.hbase.io.ImmutableBytesWritable to populate with the function result.\nThe method returns false if there is not enough information to calculate the result (usually because one argument is unknown), and true otherwise.",{"_12623":2203,"_48290":2180,"_18312":99494,"_5":17825,"_25222":99444,"_7710":99495},[48836],"Below are additional optimization-related steps.",{"_12623":2204,"_48290":2180,"_18312":99497,"_5":17825,"_25222":99444,"_7710":99498},[48836],"To contribute to scan start/stop key formation, custom functions need to override the following two methods from ScalarFunction:",{"_12623":2205,"_48290":2180,"_18312":99500,"_5":17825,"_25222":99444,"_7710":99501},[48836],"Additionally, to enable ORDER BY optimization or in-place GROUP BY, override:",{"_12623":2206,"_48290":2180,"_18312":99503,"_5":17825,"_25222":99448,"_7710":99504},[48836],"The JAR containing UDFs must be manually added to and deleted from HDFS. There is ongoing work to add SQL statements for JAR add/remove (PHOENIX-1890).",{"_12623":2207,"_48290":2180,"_18312":99506,"_5":17825,"_25222":99448,"_7710":99507},[48836],"The dynamic class loader copies UDF JARs to {hbase.local.dir}/jars at the Phoenix client and region server when a UDF is used in queries. These JARs must be deleted manually when a function is deleted.",{"_12623":2208,"_48290":2180,"_18312":99509,"_5":17825,"_25222":99448,"_7710":99510},[48836],"Functional indexes must be rebuilt manually if the function implementation changes (PHOENIX-1907).",{"_12623":2209,"_48290":2180,"_18312":99512,"_5":17825,"_25222":99448,"_7710":99513},[48836],"Once loaded, a JAR is not unloaded. Use a different JAR for modified implementations to avoid restarting the cluster (PHOENIX-1907).",{"_12623":2210,"_48290":2180,"_18312":99515,"_5":17825,"_25222":99448,"_7710":99516},[48836],"To list functions, query the SYSTEM.\"FUNCTION\" table (PHOENIX-1921).",{"_12623":2211,"_48290":2211,"_5":13058,"_7710":99518,"_48807":99519,"_18312":99520,"_25222":2211},"VARBINARY_ENCODED",[92880,92881,92882,94570],[48836],{"_12623":2212,"_48290":2211,"_18312":99522,"_5":17825,"_25222":2211,"_7710":99523},[48836],"A variable-length binary type that sorts correctly anywhere in a composite key — use it for row keys, index keys, and row value constructors that contain binary data.",{"_12623":2213,"_48290":2211,"_5":48804,"_18312":99525,"_25222":99526,"_7710":95150},[48836],"/docs/features/varbinary-encoded#varbinary-encoded-when",{"_12623":2214,"_48290":2211,"_5":48804,"_18312":99528,"_25222":99529,"_7710":99530},[48836],"/docs/features/varbinary-encoded#varbinary-encoded-defining","Defining columns",{"_12623":2215,"_48290":2211,"_5":48804,"_18312":99532,"_25222":99533,"_7710":99534},[48836],"/docs/features/varbinary-encoded#varbinary-encoded-paging","Paged scans with row value constructors",{"_12623":2216,"_48290":2211,"_5":48804,"_18312":99536,"_25222":99537,"_7710":99538},[48836],"/docs/features/varbinary-encoded#varbinary-encoded-sizing","Sizing and storage",{"_12623":2217,"_48290":2211,"_5":48804,"_18312":99540,"_25222":99541,"_7710":99542},[48836],"/docs/features/varbinary-encoded#varbinary-encoded-migrating","Migrating from VARBINARY",{"_12623":2218,"_48290":2211,"_18312":99544,"_5":17825,"_25222":2211,"_7710":99545},[48836],"VARBINARY_ENCODED is the safe choice whenever you need a variable-length binary\ncolumn that participates in ordering: a non-trailing column of a composite primary\nkey, a secondary-index key, or a row value constructor used for paged queries.\nIntroduced in Phoenix 5.3.0\n(PHOENIX-7357).",{"_12623":2219,"_48290":2211,"_18312":99547,"_5":17825,"_25222":99526,"_7710":99548},[48836],"Pick VARBINARY_ENCODED over VARBINARY when any of the following is true:",{"_12623":2220,"_48290":2211,"_18312":99550,"_5":17825,"_25222":99526,"_7710":99551},[48836],"The column is part of a multi-column primary key and is not the last PK column.",{"_12623":2221,"_48290":2211,"_18312":99553,"_5":17825,"_25222":99526,"_7710":99554},[48836],"The column is used as part of an index key.",{"_12623":2222,"_48290":2211,"_18312":99556,"_5":17825,"_25222":99526,"_7710":99557},[48836],"You scan with row value constructors (e.g., WHERE (a, b) > (?, ?) for keyset\npagination) and one of the columns is binary.",{"_12623":2223,"_48290":2211,"_18312":99559,"_5":17825,"_25222":99526,"_7710":99560},[48836],"The binary value can contain 0x00 bytes and you cannot guarantee it never will.",{"_12623":2224,"_48290":2211,"_18312":99562,"_5":17825,"_25222":99526,"_7710":99563},[48836],"Stick with VARBINARY only when the column is purely a payload — i.e. it's never used\nin a WHERE, ORDER BY, index, or non-trailing PK position.",{"_12623":2225,"_48290":2211,"_18312":99565,"_5":17825,"_25222":99526,"_7710":99566},[48836],"The reason: VARBINARY uses 0x00 as a separator between columns in the encoded row\nkey, so an embedded 0x00 byte in an earlier PK column collides with the separator and\nbreaks ordering. VARBINARY_ENCODED escapes zero bytes during encoding so the\nbyte-by-byte sort order of the encoded form matches the lexicographic order of the\noriginal bytes. The transform is reversed on read, so application code keeps seeing the\noriginal bytes.",{"_12623":2226,"_48290":2211,"_18312":99568,"_5":17825,"_25222":99529,"_7710":99569},[48836],"Use it like any other column type — including in any position of a composite key:",{"_12623":2227,"_48290":2211,"_18312":99571,"_5":17825,"_25222":99529,"_7710":99572},[48836],"Literals use the standard hex form x'...' in both UPSERT and WHERE:",{"_12623":2228,"_48290":2211,"_18312":99574,"_5":17825,"_25222":99533,"_7710":99575},[48836],"The intended use case for VARBINARY_ENCODED in a composite key is keyset pagination\nthat resumes from the last seen row. Because the type orders correctly, you can drive\nthis with a row value constructor without any application-level encoding:",{"_12623":2229,"_48290":2211,"_18312":99577,"_5":17825,"_25222":99533,"_7710":99578},[48836],"Bind the two parameters to the last row seen by the previous page; Phoenix turns the\npredicate into an efficient seek directly to the resume point. See\nPaged Queries for the broader pattern.",{"_12623":2230,"_48290":2211,"_18312":99580,"_5":17825,"_25222":99537,"_7710":99581},[48836],"The encoded form is at most 1 extra byte per 0x00 byte in the value. For typical\ninputs (random IDs, hashes, opaque tokens) the overhead is effectively zero. Plan a bit\nof headroom only when values are known to contain many zero bytes (e.g. fixed-width\nintegers stored raw with a lot of high-order zeros — in which case a fixed-width\nUNSIGNED_* type is usually a better choice anyway).",{"_12623":2231,"_48290":2211,"_18312":99583,"_5":17825,"_25222":99541,"_7710":99584},[48836],"Phoenix does not support changing a column's type in place via ALTER TABLE, so\nmoving an existing VARBINARY column to VARBINARY_ENCODED is a copy-and-switch\noperation:",{"_12623":2232,"_48290":2211,"_18312":99586,"_5":17825,"_25222":99541,"_7710":99587},[48836],"Create a new table with the same schema but with the affected columns declared as\nVARBINARY_ENCODED.",{"_12623":2233,"_48290":2211,"_18312":99589,"_5":17825,"_25222":99541,"_7710":99590},[48836],"Backfill: UPSERT INTO new_table SELECT ... FROM old_table; (Phoenix re-encodes\nthe values into the new physical layout for you).",{"_12623":2234,"_48290":2211,"_18312":99592,"_5":17825,"_25222":99541,"_7710":99593},[48836],"Cut over reads and writes to the new table, then drop the old one.",{"_12623":2235,"_48290":2211,"_18312":99595,"_5":17825,"_25222":99541,"_7710":99596},[48836],"For a brand-new column that you're adding to an existing table, you can declare it as\nVARBINARY_ENCODED directly with ALTER TABLE ... ADD ....",{"_12623":2236,"_48290":2236,"_5":13058,"_7710":99363,"_48807":99598,"_18312":99599,"_25222":2236},[92880,92881,92882,94570],[48836],{"_12623":2237,"_48290":2236,"_18312":99601,"_5":17825,"_25222":2236,"_7710":99602},[48836],"Per-view retention on top of a shared base table — different views can age data out on different schedules without splitting the table.",{"_12623":2238,"_48290":2236,"_5":48804,"_18312":99604,"_25222":99605,"_7710":95150},[48836],"/docs/features/view-ttl#view-ttl-when",{"_12623":2239,"_48290":2236,"_5":48804,"_18312":99607,"_25222":99608,"_7710":99609},[48836],"/docs/features/view-ttl#view-ttl-enable","Enable the feature",{"_12623":2240,"_48290":2236,"_5":48804,"_18312":99611,"_25222":99612,"_7710":99613},[48836],"/docs/features/view-ttl#view-ttl-define","Defining a TTL on a view",{"_12623":2241,"_48290":2236,"_5":48804,"_18312":99615,"_25222":99616,"_7710":99617},[48836],"/docs/features/view-ttl#view-ttl-inheritance","Inheritance and child views",{"_12623":2242,"_48290":2236,"_5":48804,"_18312":99619,"_25222":99620,"_7710":99621},[48836],"/docs/features/view-ttl#view-ttl-how","How it actually expires data",{"_12623":2243,"_48290":2236,"_5":48804,"_18312":99623,"_25222":99624,"_7710":99625},[48836],"/docs/features/view-ttl#view-ttl-conditional","Combining with Conditional TTL",{"_12623":2244,"_48290":2236,"_18312":99627,"_5":17825,"_25222":2236,"_7710":99628},[48836],"A Phoenix view is a logical table that shares a single physical\nHBase table with its sibling views. View TTL lets each view define its own data\nretention policy on top of that shared table. Rows that have outlived their view's TTL\ndisappear from queries against that view and are eventually removed in the background —\nwithout affecting any other view (or the base table). Available in Phoenix 5.3.0\n(PHOENIX-6978).",{"_12623":2245,"_48290":2236,"_18312":99630,"_5":17825,"_25222":99605,"_7710":99631},[48836],"The classic case is multi-tenant retention: one shared base table, many tenant\nviews, each tenant gets a different retention window driven by its plan, region, or\ncontract.",{"_12623":2246,"_48290":2236,"_18312":99633,"_5":17825,"_25222":99605,"_7710":99634},[48836],"Scenario",{"_12623":2247,"_48290":2236,"_18312":99636,"_5":17825,"_25222":99605,"_7710":99637},[48836],"View TTL fit",{"_12623":2248,"_48290":2236,"_18312":99639,"_5":17825,"_25222":99605,"_7710":99640},[48836],"Per-tenant retention windows on one shared base table",{"_12623":2249,"_48290":2236,"_18312":99642,"_5":17825,"_25222":99605,"_7710":99643},[48836],"Yes",{"_12623":2250,"_48290":2236,"_18312":99645,"_5":17825,"_25222":99605,"_7710":99646},[48836],"Per-use-case retention (e.g., \"raw events 7 days, audit 1 year\")",{"_12623":2251,"_48290":2236,"_18312":99648,"_5":17825,"_25222":99605,"_7710":99643},[48836],{"_12623":2252,"_48290":2236,"_18312":99650,"_5":17825,"_25222":99605,"_7710":99651},[48836],"Per-tenant extra columns on top of the shared base table (each tenant's view)",{"_12623":2253,"_48290":2236,"_18312":99653,"_5":17825,"_25222":99605,"_7710":99654},[48836],"Yes — views can extend the base schema, View TTL still applies",{"_12623":2254,"_48290":2236,"_18312":99656,"_5":17825,"_25222":99605,"_7710":99657},[48836],"Same retention for the entire physical table",{"_12623":2255,"_48290":2236,"_18312":99659,"_5":17825,"_25222":99605,"_7710":99660},[48836],"Use a regular table-level TTL instead",{"_12623":2256,"_48290":2236,"_18312":99662,"_5":17825,"_25222":99605,"_7710":99663},[48836],"Retention based on row content rather than age",{"_12623":2257,"_48290":2236,"_18312":99665,"_5":17825,"_25222":99605,"_7710":99666},[48836],"Use Conditional TTL",{"_12623":2258,"_48290":2236,"_18312":99668,"_5":17825,"_25222":99605,"_7710":99669},[48836],"Different base-table schemas per tenant (different PK, different core columns)",{"_12623":2259,"_48290":2236,"_18312":99671,"_5":17825,"_25222":99605,"_7710":99672},[48836],"Use separate tables — View TTL doesn't apply",{"_12623":2260,"_48290":2236,"_18312":99674,"_5":17825,"_25222":99605,"_7710":99675},[48836],"If the retention rule is the same for everyone reading the table, set TTL on the\ntable itself; you don't need View TTL.",{"_12623":2261,"_48290":2236,"_18312":99677,"_5":17825,"_25222":99608,"_7710":99678},[48836],"View TTL is off by default. Enable it cluster-wide by setting this server-side\nproperty and restarting region servers:",{"_12623":2262,"_48290":2236,"_18312":99680,"_5":17825,"_25222":99608,"_7710":99681},[48836],"While the feature is disabled, attempts to declare TTL on a view return a SQL error\nexplaining the property must be turned on.",{"_12623":2263,"_48290":2236,"_18312":99683,"_5":17825,"_25222":99612,"_7710":99684},[48836],"Set TTL (in seconds) as a property on CREATE VIEW. Different views over the same\nbase table can use different values:",{"_12623":2264,"_48290":2236,"_18312":99686,"_5":17825,"_25222":99612,"_7710":99687},[48836],"Adjust the value later, or remove the TTL entirely:",{"_12623":2265,"_48290":2236,"_18312":99689,"_5":17825,"_25222":99616,"_7710":99690},[48836],"A child view inherits its parent view's TTL. Child views cannot override the\nparent's value — the TTL belongs to the view that owns it. If you need different\nretention windows for two slices of the same parent, create them as siblings under a\ncommon parent rather than nesting.",{"_12623":2266,"_48290":2236,"_18312":99692,"_5":17825,"_25222":99616,"_7710":99693},[48836],"In multi-tenant mode, each tenant connection sees its own view; setting TTL on a\ntenant view applies retention to that tenant's slice only.",{"_12623":2267,"_48290":2236,"_18312":99695,"_5":17825,"_25222":99620,"_7710":99696},[48836],"Two things happen to expired rows:",{"_12623":2268,"_48290":2236,"_18312":99698,"_5":17825,"_25222":99620,"_7710":99699},[48836],"Read-time filter (immediate). Whenever a query goes through a view, Phoenix\nfilters out rows whose age exceeds the view's TTL — so as soon as a row is \"too\nold\" for a view, it disappears from queries against that view, even before\nphysical deletion.",{"_12623":2269,"_48290":2236,"_18312":99701,"_5":17825,"_25222":99620,"_7710":99702},[48836],"Phoenix compaction (eventual). Expired rows are physically removed by\nPhoenix's compaction during HBase region compactions. This reclaims disk and\nstops the rows showing up via lower-level scans. There is no separate cleanup\njob — physical removal happens whenever the underlying HBase regions compact.",{"_12623":2270,"_48290":2236,"_18312":99704,"_5":17825,"_25222":99624,"_7710":99705},[48836],"A view's TTL can also be a SQL boolean expression instead of a number, in which\ncase it follows the Conditional TTL rules. This\nunlocks expiry based on row content (e.g. expire 30 days after STATUS becomes\n'CLOSED'). The IS_STRICT_TTL property described in\nStrict vs Relaxed TTL applies to view\nTTL too.",{"_12623":2271,"_48290":2271,"_5":13058,"_7710":99707,"_48807":99708,"_18312":99709,"_25222":2271},"Views",[92880,92881,92882,94570],[48836],{"_12623":2272,"_48290":2271,"_18312":99711,"_5":17825,"_25222":2271,"_7710":99712},[48836],"Define updatable and read-only Phoenix views over shared HBase tables, including indexing behavior and limitations.",{"_12623":2273,"_48290":2271,"_5":48804,"_18312":99714,"_25222":99715,"_7710":99716},[48836],"/docs/features/views#updatable-views","Updatable Views",{"_12623":2274,"_48290":2271,"_5":48804,"_18312":99718,"_25222":99719,"_7710":99720},[48836],"/docs/features/views#read-only-views","Read-only Views",{"_12623":2275,"_48290":2271,"_5":48804,"_18312":99722,"_25222":99723,"_7710":99724},[48836],"/docs/features/views#indexes-on-views","Indexes on Views",{"_12623":2276,"_48290":2271,"_5":48804,"_18312":99726,"_25222":99727,"_7710":93002},[48836],"/docs/features/views#views-limitations",{"_12623":2277,"_48290":2271,"_18312":99729,"_5":17825,"_25222":2271,"_7710":99730},[48836],"The standard SQL view syntax (with some limitations) is now supported by Phoenix to enable multiple virtual tables to all share the same underlying physical HBase table. This is important in HBase as there are limits to the number of regions which HBase can manage. Limiting the number of tables can help limit the number of regions in a cluster.",{"_12623":2278,"_48290":2271,"_18312":99732,"_5":17825,"_25222":2271,"_7710":99733},[48836],"For example, given the following table definition that defines a base table to collect product metrics:",{"_12623":2279,"_48290":2271,"_18312":99735,"_5":17825,"_25222":2271,"_7710":99736},[48836],"You may define the following view:",{"_12623":2280,"_48290":2271,"_18312":99738,"_5":17825,"_25222":2271,"_7710":99739},[48836],"In this case, the same underlying physical HBase table (i.e. PRODUCT_METRICS) stores all of the data.\nNotice that unlike with standard SQL views, you may define additional columns for your view. The view inherits all of the columns from its base table, in addition to being able to optionally add new KeyValue columns. You may also add these columns after-the-fact with an ALTER VIEW statement.",{"_12623":2281,"_48290":2271,"_18312":99741,"_5":17825,"_25222":2271,"_7710":99742},[48836],"NOTE: Phoenix 4.15.0 onwards contains PHOENIX-4810 which introduces a new endpoint coprocessor on the SYSTEM.CHILD_LINK table for adding parent->child links, whenever a view is created. Thus, when namespace mapping is enabled, users that wish to create views will need to be granted EXEC permissions on SYSTEM.CHILD_LINK in order to be able to invoke this coprocessor.",{"_12623":2282,"_48290":2271,"_18312":99744,"_5":17825,"_25222":99715,"_7710":99745},[48836],"If your view uses only simple equality expressions in the WHERE clause, you are also allowed to issue DML against the view. These views are termed updatable views. For example, in this case you could issue the following UPSERT statement:",{"_12623":2283,"_48290":2271,"_18312":99747,"_5":17825,"_25222":99715,"_7710":99748},[48836],"In this case, the row will be stored in the PRODUCT_METRICS HBase table and the metric_type column value will be inferred to be 'm' since the VIEW defines it as such.",{"_12623":2284,"_48290":2271,"_18312":99750,"_5":17825,"_25222":99715,"_7710":99751},[48836],"Also, queries done through the view will automatically apply the WHERE clause filter. For example:",{"_12623":2285,"_48290":2271,"_18312":99753,"_5":17825,"_25222":99715,"_7710":99754},[48836],"This would sum all the dropped_calls across all product_metrics with a metric_type of 'm' and a carrier of 'Verizon'.",{"_12623":2286,"_48290":2271,"_18312":99756,"_5":17825,"_25222":99719,"_7710":99757},[48836],"Views may also be defined with more complex WHERE clauses, but in that case you cannot issue DML against them as you'll get a ReadOnlyException. You are still allowed to query through them and their WHERE clauses will be in effect as with standard SQL views.",{"_12623":2287,"_48290":2271,"_18312":99759,"_5":17825,"_25222":99719,"_7710":99760},[48836],"As expected, you may create a VIEW on another VIEW as well to further filter the data set. The same rules as above apply: if only simple equality expressions are used in the VIEW and its parent VIEW(s), the new view is updatable as well, otherwise it's read-only.",{"_12623":2288,"_48290":2271,"_18312":99762,"_5":17825,"_25222":99719,"_7710":99763},[48836],"Note that the previous support for creating a read-only VIEW directly over an HBase table is still supported.",{"_12623":2289,"_48290":2271,"_18312":99765,"_5":17825,"_25222":99723,"_7710":99766},[48836],"In addition, you may create an INDEX over a VIEW, just as with a TABLE. This is particularly useful to improve query performance over newly added columns on a VIEW, since it provides a way of doing point lookups based on these column values. Note that until PHOENIX-1499 gets implemented, an INDEX over a VIEW is only maintained if the updates are made through the VIEW (as opposed to through the underlying TABLE).",{"_12623":2290,"_48290":2271,"_18312":99768,"_5":17825,"_25222":99727,"_7710":99769},[48836],"Views have the following restrictions:",{"_12623":2291,"_48290":2271,"_18312":99771,"_5":17825,"_25222":99727,"_7710":99772},[48836],"An INDEX over a VIEW is only maintained if the updates are made through the VIEW. Updates made through the underlying TABLE or the parent VIEW will not be reflected in the index (PHOENIX-1499).",{"_12623":2292,"_48290":2271,"_18312":99774,"_5":17825,"_25222":99727,"_7710":99775},[48836],"A primary key column may not be added to a VIEW when its base table has a primary key constraint that ends with a variable-length column (PHOENIX-2157).",{"_12623":2293,"_48290":2271,"_18312":99777,"_5":17825,"_25222":99727,"_7710":99778},[48836],"A VIEW may be defined over only a single table through a simple SELECT * query. You may not create a VIEW over multiple joined tables or over aggregations (PHOENIX-1505, PHOENIX-1506).",{"_12623":2294,"_48290":2271,"_18312":99780,"_5":17825,"_25222":99727,"_7710":99781},[48836],"When a column is added to a VIEW, the new column is not automatically added to child VIEWs (PHOENIX-2054). The workaround is to manually add the column to child VIEWs.",{"_12623":2295,"_48290":2271,"_18312":99783,"_5":17825,"_25222":99727,"_7710":99784},[48836],"All columns must be projected into a VIEW when it is created (that is, only CREATE VIEW ... AS SELECT * is supported). You may drop non-primary-key columns inherited from the base table after creation using ALTER VIEW. Providing a subset of columns or expressions in the SELECT clause is planned for a future release (PHOENIX-1507).",{"_12623":2296,"_48290":2296,"_5":13058,"_7710":99786,"_48807":99787,"_18312":99788,"_25222":2296},"SQL Functions",[92880,92881,92994],[48836],{"_12623":2297,"_48290":2296,"_18312":99790,"_5":17825,"_25222":2296,"_7710":99791},[48836],"Built-in SQL function reference for Apache Phoenix — aggregate, string, numeric, array, date/time, and general functions.",{"_12623":2298,"_48290":2296,"_5":48804,"_18312":99793,"_25222":99794,"_7710":99795},[48836],"/docs/functions#functions-aggregate","Functions (Aggregate)",{"_12623":2299,"_48290":2296,"_5":48804,"_18312":99797,"_25222":99798,"_7710":99799},[48836],"/docs/functions#avg","AVG",{"_12623":2300,"_48290":2296,"_5":48804,"_18312":99801,"_25222":99802,"_7710":99803},[48836],"/docs/functions#count","COUNT",{"_12623":2301,"_48290":2296,"_5":48804,"_18312":99805,"_25222":99806,"_7710":99807},[48836],"/docs/functions#approx_count_distinct","APPROX_COUNT_DISTINCT",{"_12623":2302,"_48290":2296,"_5":48804,"_18312":99809,"_25222":99810,"_7710":99811},[48836],"/docs/functions#max","MAX",{"_12623":2303,"_48290":2296,"_5":48804,"_18312":99813,"_25222":99814,"_7710":99815},[48836],"/docs/functions#min","MIN",{"_12623":2304,"_48290":2296,"_5":48804,"_18312":99817,"_25222":99818,"_7710":99819},[48836],"/docs/functions#sum","SUM",{"_12623":2305,"_48290":2296,"_5":48804,"_18312":99821,"_25222":99822,"_7710":99823},[48836],"/docs/functions#percentile_cont","PERCENTILE_CONT",{"_12623":2306,"_48290":2296,"_5":48804,"_18312":99825,"_25222":99826,"_7710":99827},[48836],"/docs/functions#percentile_disc","PERCENTILE_DISC",{"_12623":2307,"_48290":2296,"_5":48804,"_18312":99829,"_25222":99830,"_7710":99831},[48836],"/docs/functions#percent_rank","PERCENT_RANK",{"_12623":2308,"_48290":2296,"_5":48804,"_18312":99833,"_25222":99834,"_7710":99835},[48836],"/docs/functions#first_value","FIRST_VALUE",{"_12623":2309,"_48290":2296,"_5":48804,"_18312":99837,"_25222":99838,"_7710":99839},[48836],"/docs/functions#last_value","LAST_VALUE",{"_12623":2310,"_48290":2296,"_5":48804,"_18312":99841,"_25222":99842,"_7710":99843},[48836],"/docs/functions#first_values","FIRST_VALUES",{"_12623":2311,"_48290":2296,"_5":48804,"_18312":99845,"_25222":99846,"_7710":99847},[48836],"/docs/functions#last_values","LAST_VALUES",{"_12623":2312,"_48290":2296,"_5":48804,"_18312":99849,"_25222":99850,"_7710":99851},[48836],"/docs/functions#nth_value","NTH_VALUE",{"_12623":2313,"_48290":2296,"_5":48804,"_18312":99853,"_25222":99854,"_7710":99855},[48836],"/docs/functions#stddev_pop","STDDEV_POP",{"_12623":2314,"_48290":2296,"_5":48804,"_18312":99857,"_25222":99858,"_7710":99859},[48836],"/docs/functions#stddev_samp","STDDEV_SAMP",{"_12623":2315,"_48290":2296,"_5":48804,"_18312":99861,"_25222":99862,"_7710":99863},[48836],"/docs/functions#functions-numeric","Functions (Numeric)",{"_12623":2316,"_48290":2296,"_5":48804,"_18312":99865,"_25222":99866,"_7710":99867},[48836],"/docs/functions#round","ROUND",{"_12623":2317,"_48290":2296,"_5":48804,"_18312":99869,"_25222":99870,"_7710":99871},[48836],"/docs/functions#ceil","CEIL",{"_12623":2318,"_48290":2296,"_5":48804,"_18312":99873,"_25222":99874,"_7710":99875},[48836],"/docs/functions#floor","FLOOR",{"_12623":2319,"_48290":2296,"_5":48804,"_18312":99877,"_25222":99878,"_7710":99879},[48836],"/docs/functions#trunc","TRUNC",{"_12623":2320,"_48290":2296,"_5":48804,"_18312":99881,"_25222":99882,"_7710":99883},[48836],"/docs/functions#to_number","TO_NUMBER",{"_12623":2321,"_48290":2296,"_5":48804,"_18312":99885,"_25222":99886,"_7710":99887},[48836],"/docs/functions#rand","RAND",{"_12623":2322,"_48290":2296,"_5":48804,"_18312":99889,"_25222":99890,"_7710":99891},[48836],"/docs/functions#functions-string","Functions (String)",{"_12623":2323,"_48290":2296,"_5":48804,"_18312":99893,"_25222":99894,"_7710":99895},[48836],"/docs/functions#substr","SUBSTR",{"_12623":2324,"_48290":2296,"_5":48804,"_18312":99897,"_25222":99898,"_7710":99899},[48836],"/docs/functions#instr","INSTR",{"_12623":2325,"_48290":2296,"_5":48804,"_18312":99901,"_25222":99902,"_7710":99903},[48836],"/docs/functions#trim","TRIM",{"_12623":2326,"_48290":2296,"_5":48804,"_18312":99905,"_25222":99906,"_7710":99907},[48836],"/docs/functions#ltrim","LTRIM",{"_12623":2327,"_48290":2296,"_5":48804,"_18312":99909,"_25222":99910,"_7710":99911},[48836],"/docs/functions#rtrim","RTRIM",{"_12623":2328,"_48290":2296,"_5":48804,"_18312":99913,"_25222":99914,"_7710":99915},[48836],"/docs/functions#lpad","LPAD",{"_12623":2329,"_48290":2296,"_5":48804,"_18312":99917,"_25222":99918,"_7710":99919},[48836],"/docs/functions#length","LENGTH",{"_12623":2330,"_48290":2296,"_5":48804,"_18312":99921,"_25222":99922,"_7710":99923},[48836],"/docs/functions#regexp_substr","REGEXP_SUBSTR",{"_12623":2331,"_48290":2296,"_5":48804,"_18312":99925,"_25222":99926,"_7710":99927},[48836],"/docs/functions#regexp_replace","REGEXP_REPLACE",{"_12623":2332,"_48290":2296,"_5":48804,"_18312":99929,"_25222":99930,"_7710":99931},[48836],"/docs/functions#regexp_split","REGEXP_SPLIT",{"_12623":2333,"_48290":2296,"_5":48804,"_18312":99933,"_25222":99934,"_7710":99935},[48836],"/docs/functions#upper","UPPER",{"_12623":2334,"_48290":2296,"_5":48804,"_18312":99937,"_25222":99938,"_7710":99939},[48836],"/docs/functions#lower","LOWER",{"_12623":2335,"_48290":2296,"_5":48804,"_18312":99941,"_25222":99942,"_7710":99943},[48836],"/docs/functions#reverse","REVERSE",{"_12623":2336,"_48290":2296,"_5":48804,"_18312":99945,"_25222":99946,"_7710":99947},[48836],"/docs/functions#to_char","TO_CHAR",{"_12623":2337,"_48290":2296,"_5":48804,"_18312":99949,"_25222":99950,"_7710":99951},[48836],"/docs/functions#collation_key","COLLATION_KEY",{"_12623":2338,"_48290":2296,"_5":48804,"_18312":99953,"_25222":99954,"_7710":99955},[48836],"/docs/functions#functions-array","Functions (Array)",{"_12623":2339,"_48290":2296,"_5":48804,"_18312":99957,"_25222":99958,"_7710":99959},[48836],"/docs/functions#array_elem","ARRAY_ELEM",{"_12623":2340,"_48290":2296,"_5":48804,"_18312":99961,"_25222":99962,"_7710":99963},[48836],"/docs/functions#array_length","ARRAY_LENGTH",{"_12623":2341,"_48290":2296,"_5":48804,"_18312":99965,"_25222":99966,"_7710":99967},[48836],"/docs/functions#array_append","ARRAY_APPEND",{"_12623":2342,"_48290":2296,"_5":48804,"_18312":99969,"_25222":99970,"_7710":99971},[48836],"/docs/functions#array_prepend","ARRAY_PREPEND",{"_12623":2343,"_48290":2296,"_5":48804,"_18312":99973,"_25222":99974,"_7710":99975},[48836],"/docs/functions#array_cat","ARRAY_CAT",{"_12623":2344,"_48290":2296,"_5":48804,"_18312":99977,"_25222":99978,"_7710":99979},[48836],"/docs/functions#array_fill","ARRAY_FILL",{"_12623":2345,"_48290":2296,"_5":48804,"_18312":99981,"_25222":99982,"_7710":99983},[48836],"/docs/functions#array_to_string","ARRAY_TO_STRING",{"_12623":2346,"_48290":2296,"_5":48804,"_18312":99985,"_25222":99986,"_7710":99987},[48836],"/docs/functions#any","ANY",{"_12623":2347,"_48290":2296,"_5":48804,"_18312":99989,"_25222":99990,"_7710":99991},[48836],"/docs/functions#all","ALL",{"_12623":2348,"_48290":2296,"_5":48804,"_18312":99993,"_25222":99994,"_7710":99995},[48836],"/docs/functions#functions-general","Functions (General)",{"_12623":2349,"_48290":2296,"_5":48804,"_18312":99997,"_25222":99998,"_7710":99999},[48836],"/docs/functions#md5","MD5",{"_12623":2350,"_48290":2296,"_5":48804,"_18312":100001,"_25222":100002,"_7710":100003},[48836],"/docs/functions#invert","INVERT",{"_12623":2351,"_48290":2296,"_5":48804,"_18312":100005,"_25222":100006,"_7710":100007},[48836],"/docs/functions#encode","ENCODE",{"_12623":2352,"_48290":2296,"_5":48804,"_18312":100009,"_25222":100010,"_7710":100011},[48836],"/docs/functions#decode","DECODE",{"_12623":2353,"_48290":2296,"_5":48804,"_18312":100013,"_25222":100014,"_7710":100015},[48836],"/docs/functions#coalesce","COALESCE",{"_12623":2354,"_48290":2296,"_5":48804,"_18312":100017,"_25222":100018,"_7710":100019},[48836],"/docs/functions#get_bit","GET_BIT",{"_12623":2355,"_48290":2296,"_5":48804,"_18312":100021,"_25222":100022,"_7710":100023},[48836],"/docs/functions#get_byte","GET_BYTE",{"_12623":2356,"_48290":2296,"_5":48804,"_18312":100025,"_25222":100026,"_7710":100027},[48836],"/docs/functions#octet_length","OCTET_LENGTH",{"_12623":2357,"_48290":2296,"_5":48804,"_18312":100029,"_25222":100030,"_7710":100031},[48836],"/docs/functions#set_bit","SET_BIT",{"_12623":2358,"_48290":2296,"_5":48804,"_18312":100033,"_25222":100034,"_7710":100035},[48836],"/docs/functions#set_byte","SET_BYTE",{"_12623":2359,"_48290":2296,"_5":48804,"_18312":100037,"_25222":100038,"_7710":100039},[48836],"/docs/functions#functions-time-and-date","Functions (Time and Date)",{"_12623":2360,"_48290":2296,"_5":48804,"_18312":100041,"_25222":100042,"_7710":100043},[48836],"/docs/functions#to_date","TO_DATE",{"_12623":2361,"_48290":2296,"_5":48804,"_18312":100045,"_25222":100046,"_7710":100047},[48836],"/docs/functions#current_date","CURRENT_DATE",{"_12623":2362,"_48290":2296,"_5":48804,"_18312":100049,"_25222":100050,"_7710":100051},[48836],"/docs/functions#to_time","TO_TIME",{"_12623":2363,"_48290":2296,"_5":48804,"_18312":100053,"_25222":100054,"_7710":100055},[48836],"/docs/functions#to_timestamp","TO_TIMESTAMP",{"_12623":2364,"_48290":2296,"_5":48804,"_18312":100057,"_25222":100058,"_7710":100059},[48836],"/docs/functions#current_time","CURRENT_TIME",{"_12623":2365,"_48290":2296,"_5":48804,"_18312":100061,"_25222":100062,"_7710":100063},[48836],"/docs/functions#convert_tz","CONVERT_TZ",{"_12623":2366,"_48290":2296,"_5":48804,"_18312":100065,"_25222":100066,"_7710":100067},[48836],"/docs/functions#timezone_offset","TIMEZONE_OFFSET",{"_12623":2367,"_48290":2296,"_5":48804,"_18312":100069,"_25222":100070,"_7710":100071},[48836],"/docs/functions#now","NOW",{"_12623":2368,"_48290":2296,"_5":48804,"_18312":100073,"_25222":100074,"_7710":100075},[48836],"/docs/functions#year","YEAR",{"_12623":2369,"_48290":2296,"_5":48804,"_18312":100077,"_25222":100078,"_7710":100079},[48836],"/docs/functions#month","MONTH",{"_12623":2370,"_48290":2296,"_5":48804,"_18312":100081,"_25222":100082,"_7710":100083},[48836],"/docs/functions#week","WEEK",{"_12623":2371,"_48290":2296,"_5":48804,"_18312":100085,"_25222":100086,"_7710":100087},[48836],"/docs/functions#dayofyear","DAYOFYEAR",{"_12623":2372,"_48290":2296,"_5":48804,"_18312":100089,"_25222":100090,"_7710":100091},[48836],"/docs/functions#dayofmonth","DAYOFMONTH",{"_12623":2373,"_48290":2296,"_5":48804,"_18312":100093,"_25222":100094,"_7710":100095},[48836],"/docs/functions#dayofweek","DAYOFWEEK",{"_12623":2374,"_48290":2296,"_5":48804,"_18312":100097,"_25222":100098,"_7710":100099},[48836],"/docs/functions#hour","HOUR",{"_12623":2375,"_48290":2296,"_5":48804,"_18312":100101,"_25222":100102,"_7710":100103},[48836],"/docs/functions#minute","MINUTE",{"_12623":2376,"_48290":2296,"_5":48804,"_18312":100105,"_25222":100106,"_7710":100107},[48836],"/docs/functions#second","SECOND",{"_12623":2377,"_48290":2296,"_5":48804,"_18312":100109,"_25222":100110,"_7710":100111},[48836],"/docs/functions#functions-math","Functions (Math)",{"_12623":2378,"_48290":2296,"_5":48804,"_18312":100113,"_25222":100114,"_7710":100115},[48836],"/docs/functions#sign","SIGN",{"_12623":2379,"_48290":2296,"_5":48804,"_18312":100117,"_25222":100118,"_7710":100119},[48836],"/docs/functions#abs","ABS",{"_12623":2380,"_48290":2296,"_5":48804,"_18312":100121,"_25222":100122,"_7710":100123},[48836],"/docs/functions#sqrt","SQRT",{"_12623":2381,"_48290":2296,"_5":48804,"_18312":100125,"_25222":100126,"_7710":100127},[48836],"/docs/functions#cbrt","CBRT",{"_12623":2382,"_48290":2296,"_5":48804,"_18312":100129,"_25222":100130,"_7710":100131},[48836],"/docs/functions#exp","EXP",{"_12623":2383,"_48290":2296,"_5":48804,"_18312":100133,"_25222":100134,"_7710":100135},[48836],"/docs/functions#power","POWER",{"_12623":2384,"_48290":2296,"_5":48804,"_18312":100137,"_25222":100138,"_7710":100139},[48836],"/docs/functions#ln","LN",{"_12623":2385,"_48290":2296,"_5":48804,"_18312":100141,"_25222":100142,"_7710":100143},[48836],"/docs/functions#log","LOG",{"_12623":2386,"_48290":2296,"_18312":100145,"_5":17825,"_25222":99798,"_7710":100146},[48836],"The average (mean) value. If no rows are selected, the result is NULL. Aggregates are only allowed in select statements. The returned value is of the same data type as the parameter.",{"_12623":2387,"_48290":2296,"_18312":100148,"_5":17825,"_25222":99798,"_7710":93959},[48836],{"_12623":2388,"_48290":2296,"_18312":100150,"_5":17825,"_25222":99802,"_7710":100151},[48836],"The count of all row, or of the non-null values. This method returns a long. When DISTINCT is used, it counts only distinct values. If no rows are selected, the result is 0. Aggregates are only allowed in select statements.",{"_12623":2389,"_48290":2296,"_18312":100153,"_5":17825,"_25222":99802,"_7710":93959},[48836],{"_12623":2390,"_48290":2296,"_18312":100155,"_5":17825,"_25222":99806,"_7710":100156},[48836],"The approximate distinct count of all row, or of the non-null values. The relative error of approximation by default is less than 0.00405 This method returns a long. If no rows are selected, the result is 0. Aggregates are only allowed in select statements.",{"_12623":2391,"_48290":2296,"_18312":100158,"_5":17825,"_25222":99806,"_7710":93959},[48836],{"_12623":2392,"_48290":2296,"_18312":100160,"_5":17825,"_25222":99810,"_7710":100161},[48836],"The highest value. If no rows are selected, the result is NULL. Aggregates are only allowed in select statements. The returned value is of the same data type as the parameter.",{"_12623":2393,"_48290":2296,"_18312":100163,"_5":17825,"_25222":99810,"_7710":93959},[48836],{"_12623":2394,"_48290":2296,"_18312":100165,"_5":17825,"_25222":99814,"_7710":100166},[48836],"The lowest value. If no rows are selected, the result is NULL. Aggregates are only allowed in select statements. The returned value is of the same data type as the parameter.",{"_12623":2395,"_48290":2296,"_18312":100168,"_5":17825,"_25222":99814,"_7710":93959},[48836],{"_12623":2396,"_48290":2296,"_18312":100170,"_5":17825,"_25222":99818,"_7710":100171},[48836],"The sum of all values. If no rows are selected, the result is NULL. Aggregates are only allowed in select statements. The returned value is of the same data type as the parameter.",{"_12623":2397,"_48290":2296,"_18312":100173,"_5":17825,"_25222":99818,"_7710":93959},[48836],{"_12623":2398,"_48290":2296,"_18312":100175,"_5":17825,"_25222":99822,"_7710":100176},[48836],"The nth percentile of values in the column. The percentile value can be between 0 and 1 inclusive. Aggregates are only allowed in select statements. The returned value is of decimal data type.",{"_12623":2399,"_48290":2296,"_18312":100178,"_5":17825,"_25222":99822,"_7710":93959},[48836],{"_12623":2400,"_48290":2296,"_18312":100180,"_5":17825,"_25222":99826,"_7710":100181},[48836],"PERCENTILE_DISC is an inverse distribution function that assumes a discrete distribution model. It takes a percentile value and a sort specification and returns an element from the set. Nulls are ignored in the calculation.",{"_12623":2401,"_48290":2296,"_18312":100183,"_5":17825,"_25222":99826,"_7710":93959},[48836],{"_12623":2402,"_48290":2296,"_18312":100185,"_5":17825,"_25222":99830,"_7710":100186},[48836],"The percentile rank for a hypothetical value, if inserted into the column. Aggregates are only allowed in select statements. The returned value is of decimal data type.",{"_12623":2403,"_48290":2296,"_18312":100188,"_5":17825,"_25222":99830,"_7710":93959},[48836],{"_12623":2404,"_48290":2296,"_18312":100190,"_5":17825,"_25222":99834,"_7710":100191},[48836],"The first value in each distinct group ordered according to the ORDER BY specification.",{"_12623":2405,"_48290":2296,"_18312":100193,"_5":17825,"_25222":99834,"_7710":93959},[48836],{"_12623":2406,"_48290":2296,"_18312":100195,"_5":17825,"_25222":99838,"_7710":100196},[48836],"The last value in each distinct group ordered according to the ORDER BY specification.",{"_12623":2407,"_48290":2296,"_18312":100198,"_5":17825,"_25222":99838,"_7710":93959},[48836],{"_12623":2408,"_48290":2296,"_18312":100200,"_5":17825,"_25222":99842,"_7710":100201},[48836],"Returns an array of at most the given numeric size of the first values in each distinct group ordered according to the ORDER BY specification.",{"_12623":2409,"_48290":2296,"_18312":100203,"_5":17825,"_25222":99842,"_7710":93959},[48836],{"_12623":2410,"_48290":2296,"_18312":100205,"_5":17825,"_25222":99846,"_7710":100206},[48836],"Returns an array of at most the given numeric size of the last values in each distinct group ordered according to the ORDER BY specification.",{"_12623":2411,"_48290":2296,"_18312":100208,"_5":17825,"_25222":99846,"_7710":93959},[48836],{"_12623":2412,"_48290":2296,"_18312":100210,"_5":17825,"_25222":99850,"_7710":100211},[48836],"The nth value in each distinct group ordered according to the ORDER BY specification.",{"_12623":2413,"_48290":2296,"_18312":100213,"_5":17825,"_25222":99850,"_7710":93959},[48836],{"_12623":2414,"_48290":2296,"_18312":100215,"_5":17825,"_25222":99854,"_7710":100216},[48836],"The population standard deviation of all values. Aggregates are only allowed in select statements. The returned value is of decimal data type.",{"_12623":2415,"_48290":2296,"_18312":100218,"_5":17825,"_25222":99854,"_7710":93959},[48836],{"_12623":2416,"_48290":2296,"_18312":100220,"_5":17825,"_25222":99858,"_7710":100221},[48836],"The sample standard deviation of all values. Aggregates are only allowed in select statements. The returned value is of decimal data type.",{"_12623":2417,"_48290":2296,"_18312":100223,"_5":17825,"_25222":99858,"_7710":93959},[48836],{"_12623":2418,"_48290":2296,"_18312":100225,"_5":17825,"_25222":99866,"_7710":100226},[48836],"Rounds the numeric or timestamp expression to the nearest scale or time unit specified. If the expression is a numeric type, then the second argument is the scale to be used for rounding off the number, defaulting to zero. If the expression is a date/time type, then the second argument may be one of the time units listed to determine the remaining precision of the date/time. A default of MILLISECONDS is used if not present. The multiplier is only applicable for a date/time type and is used to round to a multiple of a time unit (i.e. 10 minute) and defaults to 1 if not specified. This method returns the same type as its first argument.",{"_12623":2419,"_48290":2296,"_18312":100228,"_5":17825,"_25222":99866,"_7710":93959},[48836],{"_12623":2420,"_48290":2296,"_18312":100230,"_5":17825,"_25222":99870,"_7710":100231},[48836],"Same as ROUND, except it rounds any fractional value up to the next even multiple.",{"_12623":2421,"_48290":2296,"_18312":100233,"_5":17825,"_25222":99870,"_7710":93959},[48836],{"_12623":2422,"_48290":2296,"_18312":100235,"_5":17825,"_25222":99874,"_7710":100236},[48836],"Same as ROUND, except it rounds any fractional value down to the previous even multiple.",{"_12623":2423,"_48290":2296,"_18312":100238,"_5":17825,"_25222":99874,"_7710":93959},[48836],{"_12623":2424,"_48290":2296,"_18312":100240,"_5":17825,"_25222":99878,"_7710":100241},[48836],"Same as FLOOR",{"_12623":2425,"_48290":2296,"_18312":100243,"_5":17825,"_25222":99878,"_7710":93959},[48836],{"_12623":2426,"_48290":2296,"_18312":100245,"_5":17825,"_25222":99882,"_7710":100246},[48836],"Formats a string or date/time type as a number, optionally accepting a format string. For details on the format, see java.text.DecimalFormat. For date, time, and timeStamp terms, the result is the time in milliseconds since the epoch. This method returns a decimal number.",{"_12623":2427,"_48290":2296,"_18312":100248,"_5":17825,"_25222":99882,"_7710":93959},[48836],{"_12623":2428,"_48290":2296,"_18312":100250,"_5":17825,"_25222":99886,"_7710":100251},[48836],"Function that produces a random, uniformly distributed double value between 0.0 (inclusive) and 1.0 (exclusive). If a seed is provided, then the the returned value is identical across each invocation for the same row. If a seed is not provided, then the returned value is different for each invocation. The seed must be a constant.",{"_12623":2429,"_48290":2296,"_18312":100253,"_5":17825,"_25222":99886,"_7710":93959},[48836],{"_12623":2430,"_48290":2296,"_18312":100255,"_5":17825,"_25222":99894,"_7710":100256},[48836],"Returns a substring of a string starting at the one-based position. If zero is used, the position is zero-based. If the start index is negative, then the start index is relative to the end of the string. The length is optional and if not supplied, the rest of the string will be returned.",{"_12623":2431,"_48290":2296,"_18312":100258,"_5":17825,"_25222":99894,"_7710":93959},[48836],{"_12623":2432,"_48290":2296,"_18312":100260,"_5":17825,"_25222":99898,"_7710":100261},[48836],"Returns the one-based position of the initial occurrence of the second argument in the first argument. If the second argument is not contained in the first argument, then zero is returned.",{"_12623":2433,"_48290":2296,"_18312":100263,"_5":17825,"_25222":99898,"_7710":93959},[48836],{"_12623":2434,"_48290":2296,"_18312":100265,"_5":17825,"_25222":99902,"_7710":100266},[48836],"Removes leading and trailing spaces from the input string.",{"_12623":2435,"_48290":2296,"_18312":100268,"_5":17825,"_25222":99902,"_7710":93959},[48836],{"_12623":2436,"_48290":2296,"_18312":100270,"_5":17825,"_25222":99906,"_7710":100271},[48836],"Removes leading spaces from the input string.",{"_12623":2437,"_48290":2296,"_18312":100273,"_5":17825,"_25222":99906,"_7710":93959},[48836],{"_12623":2438,"_48290":2296,"_18312":100275,"_5":17825,"_25222":99910,"_7710":100276},[48836],"Removes trailing spaces from the input string.",{"_12623":2439,"_48290":2296,"_18312":100278,"_5":17825,"_25222":99910,"_7710":93959},[48836],{"_12623":2440,"_48290":2296,"_18312":100280,"_5":17825,"_25222":99914,"_7710":100281},[48836],"Pads the string expression with the specific pad character (space by default) up to the length argument.",{"_12623":2441,"_48290":2296,"_18312":100283,"_5":17825,"_25222":99914,"_7710":93959},[48836],{"_12623":2442,"_48290":2296,"_18312":100285,"_5":17825,"_25222":99918,"_7710":100286},[48836],"Returns the length of the string in characters.",{"_12623":2443,"_48290":2296,"_18312":100288,"_5":17825,"_25222":99918,"_7710":93959},[48836],{"_12623":2444,"_48290":2296,"_18312":100290,"_5":17825,"_25222":99922,"_7710":100291},[48836],"Returns a substring of a string by applying a regular expression start from the offset of a one-based position. Just like with SUBSTR, if the start index is negative, then it is relative to the end of the string. If not specified, the start index defaults to 1.",{"_12623":2445,"_48290":2296,"_18312":100293,"_5":17825,"_25222":99922,"_7710":93959},[48836],{"_12623":2446,"_48290":2296,"_18312":100295,"_5":17825,"_25222":99926,"_7710":100296},[48836],"Returns a string by applying a regular expression and replacing the matches with the replacement string. If the replacement string is not specified, it defaults to an empty string.",{"_12623":2447,"_48290":2296,"_18312":100298,"_5":17825,"_25222":99926,"_7710":93959},[48836],{"_12623":2448,"_48290":2296,"_18312":100300,"_5":17825,"_25222":99930,"_7710":100301},[48836],"Splits a string into a VARCHAR ARRAY using a regular expression. If characters that have a special meaning in regular expressions are to be used as a regular delimiter in the pattern string, they must be escaped with backslashes.",{"_12623":2449,"_48290":2296,"_18312":100303,"_5":17825,"_25222":99930,"_7710":93959},[48836],{"_12623":2450,"_48290":2296,"_18312":100305,"_5":17825,"_25222":99934,"_7710":100306},[48836],"Returns upper case string of the string argument. If localeString (available in Phoenix 4.14) is provided, it identifies the locale whose rules are used for the conversion. If localeString is not provided, the default locale is used. The localeString must be of the form returned by the Java 6 implementation of java.util.Locale.toString() e.g. 'zh_TW_STROKE' or 'en_US' or 'fr_FR'.",{"_12623":2451,"_48290":2296,"_18312":100308,"_5":17825,"_25222":99934,"_7710":93959},[48836],{"_12623":2452,"_48290":2296,"_18312":100310,"_5":17825,"_25222":99938,"_7710":100311},[48836],"Returns lower case string of the string argument. If localeString (available in Phoenix 4.14) is provided, it identifies the locale whose rules are used for the conversion. If localeString is not provided, the default locale is used. The localeString must be of the form returned by the Java 6 implementation of java.util.Locale.toString() e.g. 'zh_TW_STROKE' or 'en_US' or 'fr_FR'.",{"_12623":2453,"_48290":2296,"_18312":100313,"_5":17825,"_25222":99938,"_7710":93959},[48836],{"_12623":2454,"_48290":2296,"_18312":100315,"_5":17825,"_25222":99942,"_7710":100316},[48836],"Returns reversed string of the string argument.",{"_12623":2455,"_48290":2296,"_18312":100318,"_5":17825,"_25222":99942,"_7710":93959},[48836],{"_12623":2456,"_48290":2296,"_18312":100320,"_5":17825,"_25222":99946,"_7710":100321},[48836],"Formats a date, time, timestamp, or number as a string. The default date format is \"yyyy-MM-dd HH:mm:ss\" and the default number format is \"#,##0.###\". For details, see java.text.SimpleDateFormat for date/time values and java.text.DecimalFormat for numbers. This method returns a string.",{"_12623":2457,"_48290":2296,"_18312":100323,"_5":17825,"_25222":99946,"_7710":93959},[48836],{"_12623":2458,"_48290":2296,"_18312":100325,"_5":17825,"_25222":99950,"_7710":100326},[48836],"Calculates a collation key that can be used to sort strings in a natural-language-aware way. The localeString must be of the form returned by the Java 6 implementation of java.util.Locale.toString() e.g. 'zh_TW_STROKE' or 'en_US' or 'fr_FR'. The third, fourth and fifth arguments are optional and determine respectively whether to use a special upper-case collator, the strength value of the collator, and the decomposition value of the collator. (See java.text.Collator to learn about strength and decomposition).",{"_12623":2459,"_48290":2296,"_18312":100328,"_5":17825,"_25222":99950,"_7710":93959},[48836],{"_12623":2460,"_48290":2296,"_18312":100330,"_5":17825,"_25222":99958,"_7710":100331},[48836],"Alternative to using array subscript notation to access an array element. Returns the element in the array at the given position. The position is one-based.",{"_12623":2461,"_48290":2296,"_18312":100333,"_5":17825,"_25222":99958,"_7710":93959},[48836],{"_12623":2462,"_48290":2296,"_18312":100335,"_5":17825,"_25222":99962,"_7710":100336},[48836],"Returns the current length of the array.",{"_12623":2463,"_48290":2296,"_18312":100338,"_5":17825,"_25222":99962,"_7710":93959},[48836],{"_12623":2464,"_48290":2296,"_18312":100340,"_5":17825,"_25222":99966,"_7710":100341},[48836],"Appends the given element to the end of the array.",{"_12623":2465,"_48290":2296,"_18312":100343,"_5":17825,"_25222":99966,"_7710":93959},[48836],{"_12623":2466,"_48290":2296,"_18312":100345,"_5":17825,"_25222":99970,"_7710":100346},[48836],"Appends the given element to the beginning of the array.",{"_12623":2467,"_48290":2296,"_18312":100348,"_5":17825,"_25222":99970,"_7710":93959},[48836],{"_12623":2468,"_48290":2296,"_18312":100350,"_5":17825,"_25222":99974,"_7710":100351},[48836],"Concatenates the input arrays and returns the result.",{"_12623":2469,"_48290":2296,"_18312":100353,"_5":17825,"_25222":99974,"_7710":93959},[48836],{"_12623":2470,"_48290":2296,"_18312":100355,"_5":17825,"_25222":99978,"_7710":100356},[48836],"Returns an array initialized with supplied value and length.",{"_12623":2471,"_48290":2296,"_18312":100358,"_5":17825,"_25222":99978,"_7710":93959},[48836],{"_12623":2472,"_48290":2296,"_18312":100360,"_5":17825,"_25222":99982,"_7710":100361},[48836],"Concatenates array elements using supplied delimiter and optional null string and returns the resulting string. If the nullString parameter is omitted or NULL, any null elements in the array are simply skipped and not represented in the output string.",{"_12623":2473,"_48290":2296,"_18312":100363,"_5":17825,"_25222":99982,"_7710":93959},[48836],{"_12623":2474,"_48290":2296,"_18312":100365,"_5":17825,"_25222":99986,"_7710":100366},[48836],"Used on the right-hand side of a comparison expression to test that any array element satisfies the comparison expression against the left-hand side.",{"_12623":2475,"_48290":2296,"_18312":100368,"_5":17825,"_25222":99986,"_7710":93959},[48836],{"_12623":2476,"_48290":2296,"_18312":100370,"_5":17825,"_25222":99990,"_7710":100371},[48836],"Used on the right-hand side of a comparison expression to test that all array elements satisfy the comparison expression against the left-hand side. of the array.",{"_12623":2477,"_48290":2296,"_18312":100373,"_5":17825,"_25222":99990,"_7710":93959},[48836],{"_12623":2478,"_48290":2296,"_18312":100375,"_5":17825,"_25222":99998,"_7710":100376},[48836],"Computes the MD5 hash of the argument, returning the result as a BINARY(16).",{"_12623":2479,"_48290":2296,"_18312":100378,"_5":17825,"_25222":99998,"_7710":93959},[48836],{"_12623":2480,"_48290":2296,"_18312":100380,"_5":17825,"_25222":100002,"_7710":100381},[48836],"Inverts the bits of the argument. The return type will be the same as the argument.",{"_12623":2481,"_48290":2296,"_18312":100383,"_5":17825,"_25222":100002,"_7710":93959},[48836],{"_12623":2482,"_48290":2296,"_18312":100385,"_5":17825,"_25222":100006,"_7710":100386},[48836],"Encodes the expression according to the encoding format provided and returns the resulting string. For 'BASE62', converts the given base 10 number to a base 62 number and returns a string representing the number.",{"_12623":2483,"_48290":2296,"_18312":100388,"_5":17825,"_25222":100006,"_7710":93959},[48836],{"_12623":2484,"_48290":2296,"_18312":100390,"_5":17825,"_25222":100010,"_7710":100391},[48836],"Decodes the expression according to the encoding format provided and returns the resulting value as a VARBINARY. For 'HEX', converts the hex string expression to its binary representation, providing a mechanism for inputting binary data through the console.",{"_12623":2485,"_48290":2296,"_18312":100393,"_5":17825,"_25222":100010,"_7710":93959},[48836],{"_12623":2486,"_48290":2296,"_18312":100395,"_5":17825,"_25222":100014,"_7710":100396},[48836],"Returns the value of the first argument if not null and the second argument otherwise. Useful to guarantee that a column in an UPSERT SELECT command will evaluate to a non null value.",{"_12623":2487,"_48290":2296,"_18312":100398,"_5":17825,"_25222":100014,"_7710":93959},[48836],{"_12623":2488,"_48290":2296,"_18312":100400,"_5":17825,"_25222":100018,"_7710":100401},[48836],"Retrieves the bit at the given index in the given binary value.",{"_12623":2489,"_48290":2296,"_18312":100403,"_5":17825,"_25222":100018,"_7710":93959},[48836],{"_12623":2490,"_48290":2296,"_18312":100405,"_5":17825,"_25222":100022,"_7710":100406},[48836],"Retrieves the byte at the given index in the given binary value.",{"_12623":2491,"_48290":2296,"_18312":100408,"_5":17825,"_25222":100022,"_7710":93959},[48836],{"_12623":2492,"_48290":2296,"_18312":100410,"_5":17825,"_25222":100026,"_7710":100411},[48836],"Returns the number of bytes in a binary value.",{"_12623":2493,"_48290":2296,"_18312":100413,"_5":17825,"_25222":100026,"_7710":93959},[48836],{"_12623":2494,"_48290":2296,"_18312":100415,"_5":17825,"_25222":100030,"_7710":100416},[48836],"Replaces the bit at the given index in the binary value with the provided newValue.",{"_12623":2495,"_48290":2296,"_18312":100418,"_5":17825,"_25222":100030,"_7710":93959},[48836],{"_12623":2496,"_48290":2296,"_18312":100420,"_5":17825,"_25222":100034,"_7710":100421},[48836],"Replaces the byte at the given index in the binary value with the provided newValue.",{"_12623":2497,"_48290":2296,"_18312":100423,"_5":17825,"_25222":100034,"_7710":93959},[48836],{"_12623":2498,"_48290":2296,"_18312":100425,"_5":17825,"_25222":100042,"_7710":100426},[48836],"Parses a string and returns a date. Note that the returned date is internally represented as the number of milliseconds since the java epoch. The most important format characters are: y year, M month, d day, H hour, m minute, s second. The default format string is \"yyyy-MM-dd HH:mm:ss\". For details of the format, see java.text.SimpleDateFormat. By default, GMT will be used as the time zone when parsing the date. However, a time zone id can also be supplied. This is a time zone id such as 'GMT+1'. If 'local' is provided as the time zone id, the local time zone will be used for parsing. The configuration setting \"phoenix.query.dateFormatTimeZone\" can also be set to a time zone id, which will cause the default of GMT to be overridden with the configured time zone id. Please see the Data Type reference guide about how Apache Phoenix presently defines the DATE datatype. Additionally, Phoenix supports the ANSI SQL \"date\" literal which acts similarly to the single-argument \"TO_DATE\" function.",{"_12623":2499,"_48290":2296,"_18312":100428,"_5":17825,"_25222":100042,"_7710":93959},[48836],{"_12623":2500,"_48290":2296,"_18312":100430,"_5":17825,"_25222":100046,"_7710":100431},[48836],"Returns the current server-side date, bound at the start of the execution of a query based on the current time on the region server owning the metadata of the table being queried. Please see the Data Type reference guide about how Apache Phoenix presently defines the DATE datatype.",{"_12623":2501,"_48290":2296,"_18312":100433,"_5":17825,"_25222":100046,"_7710":93959},[48836],{"_12623":2502,"_48290":2296,"_18312":100435,"_5":17825,"_25222":100050,"_7710":100436},[48836],"Converts the given string into a TIME instance. When a date format is not provided it defaults to \"yyyy-MM-dd HH:mm:ss.SSS\" or whatever is defined by the configuration property phoenix.query.dateFormat. The configuration setting phoenix.query.dateFormatTimeZone can also be set to a time zone id, which will cause the default of GMT to be overridden with the configured time zone id. Additionally, Phoenix supports the ANSI SQL \"time\" literal which acts similarly to the single-argument \"TO_TIME\" function.",{"_12623":2503,"_48290":2296,"_18312":100438,"_5":17825,"_25222":100050,"_7710":93959},[48836],{"_12623":2504,"_48290":2296,"_18312":100440,"_5":17825,"_25222":100054,"_7710":100441},[48836],"Converts the given string into a TIMESTAMP instance. When a date format is not provided it defaults to \"yyyy-MM-dd HH:mm:ss.SSS\" or whatever is defined by the configuration property phoenix.query.dateFormat. The configuration setting phoenix.query.dateFormatTimeZone can also be set to a time zone id, which will cause the default of GMT to be overridden with the configured time zone id. Additionally, Phoenix supports the ANSI SQL \"timestamp\" literal which acts similarly to the single-argument \"TO_TIMESTAMP\" function.",{"_12623":2505,"_48290":2296,"_18312":100443,"_5":17825,"_25222":100054,"_7710":93959},[48836],{"_12623":2506,"_48290":2296,"_18312":100445,"_5":17825,"_25222":100058,"_7710":100446},[48836],"Same as CURRENT_DATE(), except returns a value of type TIME. In either case, the underlying representation is the epoch time as a long value. Please see the Data Type reference guide about how Apache Phoenix presently defines the TIME datatype.",{"_12623":2507,"_48290":2296,"_18312":100448,"_5":17825,"_25222":100058,"_7710":93959},[48836],{"_12623":2508,"_48290":2296,"_18312":100450,"_5":17825,"_25222":100062,"_7710":100451},[48836],"Converts date/time from one time zone to another returning the shifted date/time value.",{"_12623":2509,"_48290":2296,"_18312":100453,"_5":17825,"_25222":100062,"_7710":93959},[48836],{"_12623":2510,"_48290":2296,"_18312":100455,"_5":17825,"_25222":100066,"_7710":100456},[48836],"Returns offset (shift in minutes) of a time zone at particular date/time in minutes.",{"_12623":2511,"_48290":2296,"_18312":100458,"_5":17825,"_25222":100066,"_7710":93959},[48836],{"_12623":2512,"_48290":2296,"_18312":100460,"_5":17825,"_25222":100070,"_7710":100461},[48836],"Returns the current date, bound at the start of the execution of a query based on the current time on the region server owning the metadata of the table being queried.",{"_12623":2513,"_48290":2296,"_18312":100463,"_5":17825,"_25222":100070,"_7710":93959},[48836],{"_12623":2514,"_48290":2296,"_18312":100465,"_5":17825,"_25222":100074,"_7710":100466},[48836],"Returns the year of the specified date.",{"_12623":2515,"_48290":2296,"_18312":100468,"_5":17825,"_25222":100074,"_7710":93959},[48836],{"_12623":2516,"_48290":2296,"_18312":100470,"_5":17825,"_25222":100078,"_7710":100471},[48836],"Returns the month of the specified date.",{"_12623":2517,"_48290":2296,"_18312":100473,"_5":17825,"_25222":100078,"_7710":93959},[48836],{"_12623":2518,"_48290":2296,"_18312":100475,"_5":17825,"_25222":100082,"_7710":100476},[48836],"Returns the week of the specified date.",{"_12623":2519,"_48290":2296,"_18312":100478,"_5":17825,"_25222":100082,"_7710":93959},[48836],{"_12623":2520,"_48290":2296,"_18312":100480,"_5":17825,"_25222":100086,"_7710":100481},[48836],"Returns the day of the year of the specified date.",{"_12623":2521,"_48290":2296,"_18312":100483,"_5":17825,"_25222":100086,"_7710":93959},[48836],{"_12623":2522,"_48290":2296,"_18312":100485,"_5":17825,"_25222":100090,"_7710":100486},[48836],"Returns the day of the month of the specified date.",{"_12623":2523,"_48290":2296,"_18312":100488,"_5":17825,"_25222":100090,"_7710":93959},[48836],{"_12623":2524,"_48290":2296,"_18312":100490,"_5":17825,"_25222":100094,"_7710":100491},[48836],"Returns the day of the week of the specified date.",{"_12623":2525,"_48290":2296,"_18312":100493,"_5":17825,"_25222":100094,"_7710":93959},[48836],{"_12623":2526,"_48290":2296,"_18312":100495,"_5":17825,"_25222":100098,"_7710":100496},[48836],"Returns the hour of the specified date.",{"_12623":2527,"_48290":2296,"_18312":100498,"_5":17825,"_25222":100098,"_7710":93959},[48836],{"_12623":2528,"_48290":2296,"_18312":100500,"_5":17825,"_25222":100102,"_7710":100501},[48836],"Returns the minute of the specified date.",{"_12623":2529,"_48290":2296,"_18312":100503,"_5":17825,"_25222":100102,"_7710":93959},[48836],{"_12623":2530,"_48290":2296,"_18312":100505,"_5":17825,"_25222":100106,"_7710":100506},[48836],"Returns the second of the specified date.",{"_12623":2531,"_48290":2296,"_18312":100508,"_5":17825,"_25222":100106,"_7710":93959},[48836],{"_12623":2532,"_48290":2296,"_18312":100510,"_5":17825,"_25222":100114,"_7710":100511},[48836],"Returns the signum function of the given numeric expression as an INTEGER. The return value is -1 if the given numeric expression is negative; 0 if the given numeric expression is zero; and 1 if the given numeric expression is positive.",{"_12623":2533,"_48290":2296,"_18312":100513,"_5":17825,"_25222":100114,"_7710":93959},[48836],{"_12623":2534,"_48290":2296,"_18312":100515,"_5":17825,"_25222":100118,"_7710":100516},[48836],"Returns the absolute value of the given numeric expression maintaining the same type.",{"_12623":2535,"_48290":2296,"_18312":100518,"_5":17825,"_25222":100118,"_7710":93959},[48836],{"_12623":2536,"_48290":2296,"_18312":100520,"_5":17825,"_25222":100122,"_7710":100521},[48836],"Returns the correctly rounded square root of the given non-negative numeric expression as a DOUBLE.",{"_12623":2537,"_48290":2296,"_18312":100523,"_5":17825,"_25222":100122,"_7710":93959},[48836],{"_12623":2538,"_48290":2296,"_18312":100525,"_5":17825,"_25222":100126,"_7710":100526},[48836],"Returns the cube root of the given numeric expression as a DOUBLE.",{"_12623":2539,"_48290":2296,"_18312":100528,"_5":17825,"_25222":100126,"_7710":93959},[48836],{"_12623":2540,"_48290":2296,"_18312":100530,"_5":17825,"_25222":100130,"_7710":100531},[48836],"Returns Euler's number e raised to the power of the given numeric value as a DOUBLE.",{"_12623":2541,"_48290":2296,"_18312":100533,"_5":17825,"_25222":100130,"_7710":93959},[48836],{"_12623":2542,"_48290":2296,"_18312":100535,"_5":17825,"_25222":100134,"_7710":100536},[48836],"Returns the value of the first argument raised to the power of the second argument as a DOUBLE.",{"_12623":2543,"_48290":2296,"_18312":100538,"_5":17825,"_25222":100134,"_7710":93959},[48836],{"_12623":2544,"_48290":2296,"_18312":100540,"_5":17825,"_25222":100138,"_7710":100541},[48836],"Returns the natural logarithm (base e) of the given positive expression as a DOUBLE.",{"_12623":2545,"_48290":2296,"_18312":100543,"_5":17825,"_25222":100138,"_7710":93959},[48836],{"_12623":2546,"_48290":2296,"_18312":100545,"_5":17825,"_25222":100142,"_7710":100546},[48836],"Returns the logarithm of the first argument computed at the base of the second argument as a DOUBLE. If omitted, a base of 10 will be used for the second argument.",{"_12623":2547,"_48290":2296,"_18312":100548,"_5":17825,"_25222":100142,"_7710":93959},[48836],{"_12623":2548,"_48290":2548,"_5":13058,"_7710":100550,"_48807":100551,"_18312":100553,"_25222":2548},"Backward Compatibility",[92880,92881,92882,100552],"Fundamentals",[48836],{"_12623":2549,"_48290":2548,"_18312":100555,"_5":17825,"_25222":2548,"_7710":100556},[48836],"Phoenix upgrade compatibility across patch, minor, and major releases.",{"_12623":2550,"_48290":2548,"_5":48804,"_18312":100558,"_25222":100559,"_7710":100560},[48836],"/docs/fundamentals/backward-compatibility#versioning-convention","Versioning Convention",{"_12623":2551,"_48290":2548,"_5":48804,"_18312":100562,"_25222":100563,"_7710":100564},[48836],"/docs/fundamentals/backward-compatibility#patch-release","Patch Release",{"_12623":2552,"_48290":2548,"_5":48804,"_18312":100566,"_25222":100567,"_7710":100568},[48836],"/docs/fundamentals/backward-compatibility#minor-release","Minor Release",{"_12623":2553,"_48290":2548,"_5":48804,"_18312":100570,"_25222":100571,"_7710":100572},[48836],"/docs/fundamentals/backward-compatibility#major-release","Major Release",{"_12623":2554,"_48290":2548,"_5":48804,"_18312":100574,"_25222":100575,"_7710":100576},[48836],"/docs/fundamentals/backward-compatibility#release-notes","Release Notes",{"_12623":2555,"_48290":2548,"_18312":100578,"_5":17825,"_25222":2548,"_7710":100579},[48836],"Phoenix maintains backward compatibility across at least two minor releases to allow for no downtime through server-side rolling\nrestarts upon upgrading. See below for details.",{"_12623":2556,"_48290":2548,"_18312":100581,"_5":17825,"_25222":100559,"_7710":100582},[48836],"Phoenix uses a standard three number versioning schema of the form:",{"_12623":2557,"_48290":2548,"_18312":100584,"_5":17825,"_25222":100559,"_7710":100585},[48836],"For example, 4.2.1 has a major version of 4,\na minor version of 2, and a patch version of 1.",{"_12623":2558,"_48290":2548,"_18312":100587,"_5":17825,"_25222":100563,"_7710":100588},[48836],"Upgrading to a new patch release (i.e. only the patch version has changed) is the simplest case. The jar upgrade may occur in any order: client first or server first, and a mix of clients with different patch release versions is fine.",{"_12623":2559,"_48290":2548,"_18312":100590,"_5":17825,"_25222":100567,"_7710":100591},[48836],"When upgrading to a new minor release (i.e. the major version is the same, but the minor\nversion has changed), sometimes modifications to the system tables are necessary to either\nfix a bug or provide a new feature. This upgrade will occur automatically the first time a\nnewly upgraded client connects to the newly upgraded server. It is required that the\nserver-side jar be upgraded first across your entire cluster, before any clients are\nupgraded. An older client (two minor versions back) will work with a newer server jar when\nthe minor version is different, but not vice versa. In other words, clients do not need to\nbe upgraded in lock step with the server. However, as the server version moves forward,\nthe client version should move forward as well. This allows Phoenix to evolve its client/server\nprotocol while still providing clients sufficient time to upgrade their clients.",{"_12623":2560,"_48290":2548,"_18312":100593,"_5":17825,"_25222":100567,"_7710":100594},[48836],"As of the 4.3 release, a mix of clients on different minor release versions is supported as well\n(note that prior releases required all clients to be upgraded at the same time). Another improvement\nas of the 4.3 release is that an upgrade may be done directly from one minor version to another\nhigher minor version (prior releases required an upgrade to each minor version in between).",{"_12623":2561,"_48290":2548,"_18312":100596,"_5":17825,"_25222":100571,"_7710":100597},[48836],"Upgrading to a new major release may require downtime as well as potentially the running of a migration\nscript. Additionally, all clients and servers may need to be upgraded at the same time. This will be\ndetermined on a release-by-release basis.",{"_12623":2562,"_48290":2548,"_18312":100599,"_5":17825,"_25222":100575,"_7710":100600},[48836],"Specific details on issues and their fixes that may impact you can be found here.",{"_12623":2563,"_48290":2563,"_5":13058,"_7710":100602,"_48807":100603,"_18312":100604,"_25222":2563},"Building",[92880,92881,92882,100552],[48836],{"_12623":2564,"_48290":2563,"_18312":100606,"_5":17825,"_25222":2563,"_7710":100607},[48836],"Build Apache Phoenix and add it to Maven-based projects.",{"_12623":2565,"_48290":2563,"_5":48804,"_18312":100609,"_25222":100610,"_7710":100611},[48836],"/docs/fundamentals/building#building-the-main-phoenix-project","Building the Main Phoenix Project",{"_12623":2566,"_48290":2563,"_5":48804,"_18312":100613,"_25222":100614,"_7710":100615},[48836],"/docs/fundamentals/building#using-phoenix-in-a-maven-project","Using Phoenix in a Maven Project",{"_12623":2567,"_48290":2563,"_5":48804,"_18312":100617,"_25222":100618,"_7710":100619},[48836],"/docs/fundamentals/building#branches","Branches",{"_12623":2568,"_48290":2563,"_18312":100621,"_5":17825,"_25222":100610,"_7710":100622},[48836],"Phoenix consists of several subprojects.",{"_12623":2569,"_48290":2563,"_18312":100624,"_5":17825,"_25222":100610,"_7710":100625},[48836],"The core project is phoenix, which depends on phoenix-thirdparty, phoenix-omid, and phoenix-tephra.",{"_12623":2570,"_48290":2563,"_18312":100627,"_5":17825,"_25222":100610,"_7710":100628},[48836],"phoenix-queryserver and phoenix-connectors are optional packages that also depend on phoenix.",{"_12623":2571,"_48290":2563,"_18312":100630,"_5":17825,"_25222":100610,"_7710":100631},[48836],"Check out the source and follow the build instructions in BUILDING.md (or README.md) in the repository root.",{"_12623":2572,"_48290":2563,"_18312":100633,"_5":17825,"_25222":100614,"_7710":100634},[48836],"Phoenix artifacts are published to Apache and Maven Central repositories. Add the dependency below to your pom.xml:",{"_12623":2573,"_48290":2563,"_18312":100636,"_5":17825,"_25222":100614,"_7710":100637},[48836],"Where:",{"_12623":2574,"_48290":2563,"_18312":100639,"_5":17825,"_25222":100614,"_7710":100640},[48836],"[phoenix.version] is the Phoenix release version (for example, 5.1.2 or 4.16.1)",{"_12623":2575,"_48290":2563,"_18312":100642,"_5":17825,"_25222":100614,"_7710":100643},[48836],"[hbase.profile] is the compatible HBase profile",{"_12623":2576,"_48290":2563,"_18312":100645,"_5":17825,"_25222":100614,"_7710":100646},[48836],"See Downloads for supported release/profile combinations.",{"_12623":2577,"_48290":2563,"_18312":100648,"_5":17825,"_25222":100618,"_7710":100649},[48836],"The main Phoenix project currently has two active branches.",{"_12623":2578,"_48290":2563,"_18312":100651,"_5":17825,"_25222":100618,"_7710":100652},[48836],"4.x works with HBase 1 and Hadoop 2",{"_12623":2579,"_48290":2563,"_18312":100654,"_5":17825,"_25222":100618,"_7710":100655},[48836],"5.x works with HBase 2 and Hadoop 3",{"_12623":2580,"_48290":2563,"_18312":100657,"_5":17825,"_25222":100618,"_7710":100658},[48836],"See Downloads and BUILDING.md for exact version compatibility by release.",{"_12623":2581,"_48290":2563,"_18312":100660,"_5":17825,"_25222":100618,"_7710":100661},[48836],"See also:",{"_12623":2582,"_48290":2563,"_18312":100663,"_5":17825,"_25222":100618,"_7710":100664},[48836],"Building Project Website",{"_12623":2583,"_48290":2563,"_18312":100666,"_5":17825,"_25222":100618,"_7710":93536},[48836],{"_12623":2584,"_48290":2584,"_5":13058,"_7710":100668,"_48807":100669,"_18312":100670,"_25222":2584},"Client Classpath and JDBC URL",[92880,92881,92882,100552],[48836],{"_12623":2585,"_48290":2584,"_18312":100672,"_5":17825,"_25222":2584,"_7710":100673},[48836],"Configure Phoenix thick-client classpath and JDBC URLs.",{"_12623":2586,"_48290":2584,"_5":48804,"_18312":100675,"_25222":100676,"_7710":100677},[48836],"/docs/fundamentals/client-classpath-and-jdbc-url#using-the-phoenix-jdbc-driver","Using the Phoenix JDBC Driver",{"_12623":2587,"_48290":2584,"_5":48804,"_18312":100679,"_25222":100680,"_7710":100681},[48836],"/docs/fundamentals/client-classpath-and-jdbc-url#the-phoenix-classpath","The Phoenix classpath",{"_12623":2588,"_48290":2584,"_5":48804,"_18312":100683,"_25222":100684,"_7710":100685},[48836],"/docs/fundamentals/client-classpath-and-jdbc-url#phoenix-driver-jar","Phoenix driver JAR",{"_12623":2589,"_48290":2584,"_5":48804,"_18312":100687,"_25222":100688,"_7710":100689},[48836],"/docs/fundamentals/client-classpath-and-jdbc-url#hbase--hadoop-configuration-files","HBase / Hadoop configuration files",{"_12623":2590,"_48290":2584,"_5":48804,"_18312":100691,"_25222":100692,"_7710":100693},[48836],"/docs/fundamentals/client-classpath-and-jdbc-url#the-phoenix-jdbc-url","The Phoenix JDBC URL",{"_12623":2591,"_48290":2584,"_5":48804,"_18312":100695,"_25222":100696,"_7710":100697},[48836],"/docs/fundamentals/client-classpath-and-jdbc-url#default-connection","Default connection",{"_12623":2592,"_48290":2584,"_5":48804,"_18312":100699,"_25222":100700,"_7710":100701},[48836],"/docs/fundamentals/client-classpath-and-jdbc-url#the-jdbcphoenix-protocol-variant","The jdbc:phoenix: protocol variant",{"_12623":2593,"_48290":2584,"_5":48804,"_18312":100703,"_25222":100704,"_7710":100705},[48836],"/docs/fundamentals/client-classpath-and-jdbc-url#the-jdbcphoenixzk-protocol-variant","The jdbc:phoenix+zk: protocol variant",{"_12623":2594,"_48290":2584,"_5":48804,"_18312":100707,"_25222":100708,"_7710":100709},[48836],"/docs/fundamentals/client-classpath-and-jdbc-url#the-jdbcphoenixmaster-protocol-variant","The jdbc:phoenix+master: protocol variant",{"_12623":2595,"_48290":2584,"_5":48804,"_18312":100711,"_25222":100712,"_7710":100713},[48836],"/docs/fundamentals/client-classpath-and-jdbc-url#the-jdbcphoenixrpc-protocol-variant","The jdbc:phoenix+rpc: protocol variant",{"_12623":2596,"_48290":2584,"_5":48804,"_18312":100715,"_25222":100716,"_7710":95284},[48836],"/docs/fundamentals/client-classpath-and-jdbc-url#client-classpath-and-jdbc-url-notes",{"_12623":2597,"_48290":2584,"_18312":100718,"_5":17825,"_25222":100676,"_7710":100719},[48836],"This page is about using the Phoenix thick client.",{"_12623":2598,"_48290":2584,"_18312":100721,"_5":17825,"_25222":100676,"_7710":100722},[48836],"The thin client for Phoenix Query Server is described on its own page.",{"_12623":2599,"_48290":2584,"_18312":100724,"_5":17825,"_25222":100680,"_7710":100725},[48836],"To use Phoenix, both the JDBC driver JAR and hbase-site.xml must be added to the application classpath.",{"_12623":2600,"_48290":2584,"_18312":100727,"_5":17825,"_25222":100684,"_7710":100728},[48836],"The Phoenix JDBC client is built on top of the HBase client, and has an unusually high number of dependencies.\nTo make this manageable, Phoenix provides a single shaded uberjar that can be added to the classpath.",{"_12623":2601,"_48290":2584,"_18312":100730,"_5":17825,"_25222":100684,"_7710":100731},[48836],"Phoenix uses some private and semi-public HBase APIs, which may change between HBase versions, and provides separate binary distributions for different HBase versions.",{"_12623":2602,"_48290":2584,"_18312":100733,"_5":17825,"_25222":100684,"_7710":100734},[48836],"Choose the binary distribution or Maven artifact corresponding to the HBase version on your cluster.",{"_12623":2603,"_48290":2584,"_18312":100736,"_5":17825,"_25222":100684,"_7710":100737},[48836],"Copy the driver JAR from the binary distribution.",{"_12623":2604,"_48290":2584,"_18312":100739,"_5":17825,"_25222":100684,"_7710":100740},[48836],"Copy the corresponding phoenix-client-embedded-hbase-[hbase.profile]-[phoenix.version].jar to the application classpath.",{"_12623":2605,"_48290":2584,"_18312":100742,"_5":17825,"_25222":100684,"_7710":100743},[48836],"Add the dependency via Maven.",{"_12623":2606,"_48290":2584,"_18312":100745,"_5":17825,"_25222":100688,"_7710":100746},[48836],"As Phoenix is built on top of the HBase client, it needs the HBase configuration files for correct operation.\nFor some configurations, it may also need other Hadoop / HDFS config files like core-site.xml.",{"_12623":2607,"_48290":2584,"_18312":100748,"_5":17825,"_25222":100688,"_7710":100749},[48836],"Download the correct hbase-site.xml (the client one, usually in /etc/hbase/conf) from the cluster, and copy it to a directory on the classpath.\nIt is important to add the directory containing hbase-site.xml, and not the full file path, to the classpath.",{"_12623":2608,"_48290":2584,"_18312":100751,"_5":17825,"_25222":100688,"_7710":100752},[48836],"Alternatively, package hbase-site.xml into the root directory of a JAR file and add that JAR to the classpath.",{"_12623":2609,"_48290":2584,"_18312":100754,"_5":17825,"_25222":100688,"_7710":100755},[48836],"If hbase-site.xml changes on the cluster, make sure to copy the updated file to your application classpath.",{"_12623":2610,"_48290":2584,"_18312":100757,"_5":17825,"_25222":100688,"_7710":100758},[48836],"For some development clusters that use default configuration Phoenix may work without this, but not having the correct hbase-site.xml on the\nclasspath is almost guaranteed to cause problems.",{"_12623":2611,"_48290":2584,"_18312":100760,"_5":17825,"_25222":100692,"_7710":100761},[48836],"The Phoenix URL contains two main parts. The first describes the connection to HBase; the second specifies extra Phoenix options.",{"_12623":2612,"_48290":2584,"_18312":100763,"_5":17825,"_25222":100692,"_7710":100764},[48836],"protocol variant: The HBase connection registry to use (details below).",{"_12623":2613,"_48290":2584,"_18312":100766,"_5":17825,"_25222":100692,"_7710":100767},[48836],"server list: A comma-separated list of hostnames or IPv4 addresses.\nIt is also possible to specify per-host ports, as defined in HBASE-12706. In this case : characters must be escaped with \\. You may need to escape again in Java source strings.",{"_12623":2614,"_48290":2584,"_18312":100769,"_5":17825,"_25222":100692,"_7710":100770},[48836],"port: An integer port number. Ports specified in server list take precedence.",{"_12623":2615,"_48290":2584,"_18312":100772,"_5":17825,"_25222":100692,"_7710":100773},[48836],"zk root node: The root znode for HBase. Must be empty for non-ZK registries.",{"_12623":2616,"_48290":2584,"_18312":100775,"_5":17825,"_25222":100692,"_7710":100776},[48836],"principal: The Kerberos principal used for authentication.If only principal is specified, this defines a distinct user identity with its own dedicated HBase connection (HConnection) and allows multiple differently configured connections in the same JVM.",{"_12623":2617,"_48290":2584,"_18312":100778,"_5":17825,"_25222":100692,"_7710":100779},[48836],"keytab: Kerberos keytab used for authentication. Must be specified together with principal.",{"_12623":2618,"_48290":2584,"_18312":100781,"_5":17825,"_25222":100692,"_7710":100782},[48836],"option: A connection option.",{"_12623":2619,"_48290":2584,"_18312":100784,"_5":17825,"_25222":100692,"_7710":100785},[48836],"value: A connection option value.",{"_12623":2620,"_48290":2584,"_18312":100787,"_5":17825,"_25222":100692,"_7710":100788},[48836],"Parameters from end of the connection definition can be omitted.\nUse empty strings for missing parameters in the middle of the URL.\nFor example, the jdbc:phoenix::::principal:/home/user/keytab URL can be used to specify the kerberos principal and keytab, while using the default connection specified in hbase-site.xml.",{"_12623":2621,"_48290":2584,"_18312":100790,"_5":17825,"_25222":100696,"_7710":100791},[48836],"The underlying HBase client identifies the cluster based on parameters in hbase-site.xml.\nWhile Phoenix allows overriding this, it is usually best to use the cluster definition from hbase-site.xml.\nThe only time the connection should be directly specified is when switching between otherwise identically configured HBase instances, like a production and a disaster recovery cluster.",{"_12623":2622,"_48290":2584,"_18312":100793,"_5":17825,"_25222":100696,"_7710":100794},[48836],"To use the defaults from hbase-site.xml, use the jdbc:phoenix URL or jdbc:phoenix;option=value if additional options are needed.",{"_12623":2623,"_48290":2584,"_18312":100796,"_5":17825,"_25222":100696,"_7710":100797},[48836],"See HBase documentation for how each registry is configured in hbase-site.xml.",{"_12623":2624,"_48290":2584,"_18312":100799,"_5":17825,"_25222":100700,"_7710":100800},[48836],"If this protocol variant is specified, Phoenix will select the registry based on the value of hbase.client.registry.impl.",{"_12623":2625,"_48290":2584,"_18312":100802,"_5":17825,"_25222":100700,"_7710":100803},[48836],"If hbase.client.registry.impl is not defined, Phoenix chooses a default based on the HBase client version it includes.",{"_12623":2626,"_48290":2584,"_18312":100805,"_5":17825,"_25222":100704,"_7710":100806},[48836],"This uses the original ZooKeeper-based HBase connection registry. The server list and port specify the ZK quorum. HBASE-12706 is supported; : characters must be escaped with \\.",{"_12623":2627,"_48290":2584,"_18312":100808,"_5":17825,"_25222":100704,"_7710":100809},[48836],"Examples:",{"_12623":2628,"_48290":2584,"_18312":100811,"_5":17825,"_25222":100704,"_7710":100812},[48836],"jdbc:phoenix+zk:localhost:2181:/hbase:principal:keytab - fully specified",{"_12623":2629,"_48290":2584,"_18312":100814,"_5":17825,"_25222":100704,"_7710":100815},[48836],"jdbc:phoenix+zk:host1\\:2181,host1\\:2182,host2\\:2183 - heterogeneous ports, default ZK root node",{"_12623":2630,"_48290":2584,"_18312":100817,"_5":17825,"_25222":100704,"_7710":100818},[48836],"jdbc:phoenix+zk - use default ZK parameters from hbase-site.xml (using jdbc:phoenix is preferred in most cases)",{"_12623":2631,"_48290":2584,"_18312":100820,"_5":17825,"_25222":100708,"_7710":100821},[48836],"This uses the Master based connection registry added in HBASE-18095, and is available from HBase 2.3.0.\nThe zk root node parameter must never be specified.",{"_12623":2632,"_48290":2584,"_18312":100823,"_5":17825,"_25222":100708,"_7710":100809},[48836],{"_12623":2633,"_48290":2584,"_18312":100825,"_5":17825,"_25222":100708,"_7710":100826},[48836],"jdbc:phoenix+master:master1\\:16001,master2\\:16002::principal:/path/to/keytab - fully specified",{"_12623":2634,"_48290":2584,"_18312":100828,"_5":17825,"_25222":100708,"_7710":100829},[48836],"jdbc:phoenix+master:master1,master2 - use default master port for both hosts",{"_12623":2635,"_48290":2584,"_18312":100831,"_5":17825,"_25222":100712,"_7710":100832},[48836],"This uses the Master based connection registry added in HBASE-26150, and is available from HBase 2.5.0.\nThis is very similar to the phoenix+master variant, but also allows specifying RegionServers in the host list.\nThere is no built-in default port for this registry, the port must always be specified together with the host list.",{"_12623":2636,"_48290":2584,"_18312":100834,"_5":17825,"_25222":100712,"_7710":100809},[48836],{"_12623":2637,"_48290":2584,"_18312":100836,"_5":17825,"_25222":100712,"_7710":100837},[48836],"jdbc:phoenix+rpc:server1\\:16001,server2\\:16002::principal:/path/to/keytab - fully specified",{"_12623":2638,"_48290":2584,"_18312":100839,"_5":17825,"_25222":100712,"_7710":100840},[48836],"jdbc:phoenix+rpc - use values from hbase-site.xml",{"_12623":2639,"_48290":2584,"_18312":100842,"_5":17825,"_25222":100716,"_7710":100843},[48836],"type: warning",{"_12623":2640,"_48290":2584,"_18312":100845,"_5":17825,"_25222":100716,"_7710":100846},[48836],"Support for master and rpc registries is only available in Phoenix 5.1.4+\nand 5.2.0+.",{"_12623":2641,"_48290":2584,"_18312":100848,"_5":17825,"_25222":100716,"_7710":100849},[48836],"Earlier versions support only the jdbc:phoenix: protocol variant implementing the original HBase ZooKeeper connection registry.",{"_12623":2642,"_48290":2584,"_18312":100851,"_5":17825,"_25222":100716,"_7710":100852},[48836],"Support for registry variants is only available for HBase versions that support them.\nPhoenix will throw an error if a variant that the HBase client version doesn't support is specified.",{"_12623":2643,"_48290":2584,"_18312":100854,"_5":17825,"_25222":100716,"_7710":100855},[48836],"Phoenix 5.2 also supports High Availability connections. Documentation for that is only available in the JIRA ticket.",{"_12623":2644,"_48290":2644,"_5":13058,"_7710":92932,"_48807":100857,"_18312":100858,"_25222":2644},[92880,92881,92882,100552],[48836],{"_12623":2645,"_48290":2644,"_18312":100860,"_5":17825,"_25222":2644,"_7710":100861},[48836],"Phoenix configuration properties and tuning defaults.",{"_12623":2646,"_48290":2644,"_5":48804,"_18312":100863,"_25222":100864,"_7710":92932},[48836],"/docs/fundamentals/configuration#configuration-configuration",{"_12623":2647,"_48290":2644,"_18312":100866,"_5":17825,"_25222":100864,"_7710":100867},[48836],"Phoenix provides many different knobs and dials to configure and tune the system to run more optimally on your cluster. The configuration is done through a series of Phoenix-specific properties specified both on client and server-side hbase-site.xml files. In addition to these properties, there are of course all the HBase configuration properties with the most important ones documented here.",{"_12623":2648,"_48290":2644,"_18312":100869,"_5":17825,"_25222":100864,"_7710":100870},[48836],"The table below outlines the full set of Phoenix-specific configuration properties and their defaults.",{"_12623":2649,"_48290":2644,"_18312":100872,"_5":17825,"_25222":100864,"_7710":95595},[48836],{"_12623":2650,"_48290":2644,"_18312":100874,"_5":17825,"_25222":100864,"_7710":94969},[48836],{"_12623":2651,"_48290":2644,"_18312":100876,"_5":17825,"_25222":100864,"_7710":95598},[48836],{"_12623":2652,"_48290":2644,"_18312":100878,"_5":17825,"_25222":100864,"_7710":100879},[48836],"data.tx.snapshot.dir",{"_12623":2653,"_48290":2644,"_18312":100881,"_5":17825,"_25222":100864,"_7710":100882},[48836],"Server-side property specifying the HDFS directory used to store snapshots of the transaction state. No default value.",{"_12623":2654,"_48290":2644,"_18312":100884,"_5":17825,"_25222":100864,"_7710":100885},[48836],"None",{"_12623":2655,"_48290":2644,"_18312":100887,"_5":17825,"_25222":100864,"_7710":100888},[48836],"data.tx.timeout",{"_12623":2656,"_48290":2644,"_18312":100890,"_5":17825,"_25222":100864,"_7710":100891},[48836],"Server-side property specifying the timeout in seconds for a transaction to complete. Default is 30 seconds.",{"_12623":2657,"_48290":2644,"_18312":100893,"_5":17825,"_25222":100864,"_7710":9493},[48836],{"_12623":2658,"_48290":2644,"_18312":100895,"_5":17825,"_25222":100864,"_7710":100896},[48836],"phoenix.query.timeoutMs",{"_12623":2659,"_48290":2644,"_18312":100898,"_5":17825,"_25222":100864,"_7710":100899},[48836],"Client-side property specifying the number of milliseconds after which a query will timeout on the client. Default is 10 min.",{"_12623":2660,"_48290":2644,"_18312":100901,"_5":17825,"_25222":100864,"_7710":48259},[48836],{"_12623":2661,"_48290":2644,"_18312":100903,"_5":17825,"_25222":100864,"_7710":100904},[48836],"phoenix.query.keepAliveMs",{"_12623":2662,"_48290":2644,"_18312":100906,"_5":17825,"_25222":100864,"_7710":100907},[48836],"Maximum time in milliseconds that excess idle threads will wait for new tasks before terminating when the number of threads is greater than the cores in the client side thread pool executor. Default is 60 sec.",{"_12623":2663,"_48290":2644,"_18312":100909,"_5":17825,"_25222":100864,"_7710":48252},[48836],{"_12623":2664,"_48290":2644,"_18312":100911,"_5":17825,"_25222":100864,"_7710":100912},[48836],"phoenix.query.threadPoolSize",{"_12623":2665,"_48290":2644,"_18312":100914,"_5":17825,"_25222":100864,"_7710":100915},[48836],"Number of threads in client side thread pool executor. As the number of machines/cores in the cluster grows, this value should be increased.",{"_12623":2666,"_48290":2644,"_18312":100917,"_5":17825,"_25222":100864,"_7710":45708},[48836],{"_12623":2667,"_48290":2644,"_18312":100919,"_5":17825,"_25222":100864,"_7710":100920},[48836],"phoenix.query.queueSize",{"_12623":2668,"_48290":2644,"_18312":100922,"_5":17825,"_25222":100864,"_7710":100923},[48836],"Max queue depth of the bounded round robin backing the client side thread pool executor, beyond which an attempt to queue additional work is rejected. If zero, a SynchronousQueue is used instead of the bounded round robin queue. The default value is 5000.",{"_12623":2669,"_48290":2644,"_18312":100925,"_5":17825,"_25222":100864,"_7710":48147},[48836],{"_12623":2670,"_48290":2644,"_18312":100927,"_5":17825,"_25222":100864,"_7710":98828},[48836],{"_12623":2671,"_48290":2644,"_18312":100929,"_5":17825,"_25222":100864,"_7710":100930},[48836],"Server-side parameter that specifies the number of bytes between guideposts. A smaller amount increases parallelization, but also increases the number of chunks which must be merged on the client side. The default value is 100 MB.",{"_12623":2672,"_48290":2644,"_18312":100932,"_5":17825,"_25222":100864,"_7710":45642},[48836],{"_12623":2673,"_48290":2644,"_18312":100934,"_5":17825,"_25222":100864,"_7710":100935},[48836],"phoenix.stats.guidepost.per.region",{"_12623":2674,"_48290":2644,"_18312":100937,"_5":17825,"_25222":100864,"_7710":100938},[48836],"Server-side parameter that specifies the number of guideposts per region. If set to a value greater than zero, then the guidepost width is determined by MAX_FILE_SIZE of table / phoenix.stats.guidepost.per.region. Otherwise, if not set, then the phoenix.stats.guidepost.width parameter is used. No default value.",{"_12623":2675,"_48290":2644,"_18312":100940,"_5":17825,"_25222":100864,"_7710":100885},[48836],{"_12623":2676,"_48290":2644,"_18312":100942,"_5":17825,"_25222":100864,"_7710":98837},[48836],{"_12623":2677,"_48290":2644,"_18312":100944,"_5":17825,"_25222":100864,"_7710":100945},[48836],"Server-side parameter that determines the frequency in milliseconds for which statistics will be refreshed from the statistics table and subsequently used by the client. The default value is 15 min.",{"_12623":2678,"_48290":2644,"_18312":100947,"_5":17825,"_25222":100864,"_7710":48007},[48836],{"_12623":2679,"_48290":2644,"_18312":100949,"_5":17825,"_25222":100864,"_7710":100950},[48836],"phoenix.stats.minUpdateFrequency",{"_12623":2680,"_48290":2644,"_18312":100952,"_5":17825,"_25222":100864,"_7710":100953},[48836],"Client-side parameter that determines the minimum amount of time in milliseconds that must pass before statistics may again be manually collected through another UPDATE STATISTICS call. The default value is phoenix.stats.updateFrequency / 2.",{"_12623":2681,"_48290":2644,"_18312":100955,"_5":17825,"_25222":100864,"_7710":46463},[48836],{"_12623":2682,"_48290":2644,"_18312":100957,"_5":17825,"_25222":100864,"_7710":98849},[48836],{"_12623":2683,"_48290":2644,"_18312":100959,"_5":17825,"_25222":100864,"_7710":100960},[48836],"Server-side parameter that if true causes the current time on the server-side to be used as the timestamp of rows in the statistics table when background tasks such as compactions or splits occur. If false, then the max timestamp found while traversing the table over which statistics are being collected is used as the timestamp. Unless your client is controlling the timestamps while reading and writing data, this parameter should be left alone. The default value is true.",{"_12623":2684,"_48290":2644,"_18312":100962,"_5":17825,"_25222":100864,"_7710":16457},[48836],{"_12623":2685,"_48290":2644,"_18312":100964,"_5":17825,"_25222":100864,"_7710":100965},[48836],"phoenix.query.spoolThresholdBytes",{"_12623":2686,"_48290":2644,"_18312":100967,"_5":17825,"_25222":100864,"_7710":100968},[48836],"Threshold size in bytes after which results from parallelly executed query results are spooled to disk. Default is 20 mb.",{"_12623":2687,"_48290":2644,"_18312":100970,"_5":17825,"_25222":100864,"_7710":46822},[48836],{"_12623":2688,"_48290":2644,"_18312":100972,"_5":17825,"_25222":100864,"_7710":100973},[48836],"phoenix.query.maxSpoolToDiskBytes",{"_12623":2689,"_48290":2644,"_18312":100975,"_5":17825,"_25222":100864,"_7710":100976},[48836],"Threshold size in bytes up to which results from parallelly executed query results are spooled to disk above which the query will fail. Default is 1 GB.",{"_12623":2690,"_48290":2644,"_18312":100978,"_5":17825,"_25222":100864,"_7710":45674},[48836],{"_12623":2691,"_48290":2644,"_18312":100980,"_5":17825,"_25222":100864,"_7710":100981},[48836],"phoenix.query.maxGlobalMemoryPercentage",{"_12623":2692,"_48290":2644,"_18312":100983,"_5":17825,"_25222":100864,"_7710":100984},[48836],"Percentage of total heap memory (i.e. Runtime.getRuntime().maxMemory()) that all threads may use. Only coarse-grained memory usage is tracked, mainly accounting for memory usage in the intermediate map built during group by aggregation. When this limit is reached clients block while attempting to get more memory, essentially throttling memory usage. Defaults to 15%",{"_12623":2693,"_48290":2644,"_18312":100986,"_5":17825,"_25222":100864,"_7710":9425},[48836],{"_12623":2694,"_48290":2644,"_18312":100988,"_5":17825,"_25222":100864,"_7710":100989},[48836],"phoenix.query.maxGlobalMemorySize",{"_12623":2695,"_48290":2644,"_18312":100991,"_5":17825,"_25222":100864,"_7710":100992},[48836],"Max size in bytes of total tracked memory usage. By default not specified, however, if present, the lower of this parameter and phoenix.query.maxGlobalMemoryPercentage will be used.",{"_12623":2696,"_48290":2644,"_18312":100994,"_5":17825,"_25222":100864,"_7710":100995},[48836],"phoenix.query.maxGlobalMemoryWaitMs",{"_12623":2697,"_48290":2644,"_18312":100997,"_5":17825,"_25222":100864,"_7710":100998},[48836],"Maximum amount of time that a client will block while waiting for more memory to become available. After this amount of time, an InsufficientMemoryException is thrown. Default is 10 sec.",{"_12623":2698,"_48290":2644,"_18312":101000,"_5":17825,"_25222":100864,"_7710":45595},[48836],{"_12623":2699,"_48290":2644,"_18312":101002,"_5":17825,"_25222":100864,"_7710":101003},[48836],"phoenix.query.maxTenantMemoryPercentage",{"_12623":2700,"_48290":2644,"_18312":101005,"_5":17825,"_25222":100864,"_7710":101006},[48836],"Maximum percentage of phoenix.query.maxGlobalMemoryPercentage that any one tenant is allowed to consume. After this percentage, an InsufficientMemoryException is thrown. Default is 100%",{"_12623":2701,"_48290":2644,"_18312":101008,"_5":17825,"_25222":100864,"_7710":45547},[48836],{"_12623":2702,"_48290":2644,"_18312":101010,"_5":17825,"_25222":100864,"_7710":101011},[48836],"phoenix.query.dateFormat",{"_12623":2703,"_48290":2644,"_18312":101013,"_5":17825,"_25222":100864,"_7710":101014},[48836],"Default pattern to use for conversion of a date to/from a string, whether through the TO_CHAR(&lt;date&gt;) or TO_DATE(&lt;date-string&gt;) functions, or through resultSet.getString(&lt;date-column&gt;). Default is yyyy-MM-dd HH:mm:ss.SSS",{"_12623":2704,"_48290":2644,"_18312":101016,"_5":17825,"_25222":100864,"_7710":101017},[48836],"yyyy-MM-dd HH:mm:ss.SSS",{"_12623":2705,"_48290":2644,"_18312":101019,"_5":17825,"_25222":100864,"_7710":101020},[48836],"phoenix.query.dateFormatTimeZone",{"_12623":2706,"_48290":2644,"_18312":101022,"_5":17825,"_25222":100864,"_7710":101023},[48836],"A timezone id that specifies the default time zone in which date, time, and timestamp literals should be interpreted when interpreting string literals or using the TO_DATE function. A time zone id can be a timezone abbreviation such as \"PST\", or a full name such as \"America/Los_Angeles\", or a custom offset such as \"GMT-9:00\". The time zone id \"LOCAL\" can also be used to interpret all date, time, and timestamp literals as being in the current timezone of the client.",{"_12623":2707,"_48290":2644,"_18312":101025,"_5":17825,"_25222":100864,"_7710":101026},[48836],"GMT",{"_12623":2708,"_48290":2644,"_18312":101028,"_5":17825,"_25222":100864,"_7710":101029},[48836],"phoenix.query.timeFormat",{"_12623":2709,"_48290":2644,"_18312":101031,"_5":17825,"_25222":100864,"_7710":101032},[48836],"Default pattern to use for conversion of TIME to/from a string, whether through the TO_CHAR(&lt;time&gt;) or TO_TIME(&lt;time-string&gt;) functions, or through resultSet.getString(&lt;time-column&gt;). Default is yyyy-MM-dd HH:mm:ss.SSS",{"_12623":2710,"_48290":2644,"_18312":101034,"_5":17825,"_25222":100864,"_7710":101017},[48836],{"_12623":2711,"_48290":2644,"_18312":101036,"_5":17825,"_25222":100864,"_7710":101037},[48836],"phoenix.query.timestampFormat",{"_12623":2712,"_48290":2644,"_18312":101039,"_5":17825,"_25222":100864,"_7710":101040},[48836],"Default pattern to use for conversion of TIMESTAMP to/from a string, whether through the TO_CHAR(&lt;timestamp&gt;) or TO_TIMESTAMP(&lt;timestamp-string&gt;) functions, or through resultSet.getString(&lt;timestamp-column&gt;). Default is yyyy-MM-dd HH:mm:ss.SSS",{"_12623":2713,"_48290":2644,"_18312":101042,"_5":17825,"_25222":100864,"_7710":101017},[48836],{"_12623":2714,"_48290":2644,"_18312":101044,"_5":17825,"_25222":100864,"_7710":101045},[48836],"phoenix.query.numberFormat",{"_12623":2715,"_48290":2644,"_18312":101047,"_5":17825,"_25222":100864,"_7710":101048},[48836],"Default pattern to use for conversion of a decimal number to/from a string, whether through the TO_CHAR(&lt;decimal-number&gt;) or TO_NUMBER(&lt;decimal-string&gt;) functions, or through resultSet.getString(&lt;decimal-column&gt;). Default is #,##0.###",{"_12623":2716,"_48290":2644,"_18312":101050,"_5":17825,"_25222":100864,"_7710":101051},[48836],"#,##0.###",{"_12623":2717,"_48290":2644,"_18312":101053,"_5":17825,"_25222":100864,"_7710":101054},[48836],"phoenix.mutate.maxSize",{"_12623":2718,"_48290":2644,"_18312":101056,"_5":17825,"_25222":100864,"_7710":101057},[48836],"The maximum number of rows that may be batched on the client before a commit or rollback must be called.",{"_12623":2719,"_48290":2644,"_18312":101059,"_5":17825,"_25222":100864,"_7710":48155},[48836],{"_12623":2720,"_48290":2644,"_18312":101061,"_5":17825,"_25222":100864,"_7710":101062},[48836],"phoenix.mutate.batchSize",{"_12623":2721,"_48290":2644,"_18312":101064,"_5":17825,"_25222":100864,"_7710":101065},[48836],"The number of rows that are batched together and automatically committed during the execution of an UPSERT SELECT or DELETE statement. This property may be overridden at connection time by specifying the UpsertBatchSize property value. Note that the connection property value does not affect the batch size used by the coprocessor when these statements are executed completely on the server side.",{"_12623":2722,"_48290":2644,"_18312":101067,"_5":17825,"_25222":100864,"_7710":45578},[48836],{"_12623":2723,"_48290":2644,"_18312":101069,"_5":17825,"_25222":100864,"_7710":101070},[48836],"phoenix.query.maxServerCacheBytes",{"_12623":2724,"_48290":2644,"_18312":101072,"_5":17825,"_25222":100864,"_7710":101073},[48836],"Maximum size (in bytes) of a single sub-query result (usually the filtered result of a table) before compression and conversion to a hash map. Attempting to hash an intermediate sub-query result of a size bigger than this setting will result in a MaxServerCacheSizeExceededException. Default 100MB.",{"_12623":2725,"_48290":2644,"_18312":101075,"_5":17825,"_25222":100864,"_7710":45642},[48836],{"_12623":2726,"_48290":2644,"_18312":101077,"_5":17825,"_25222":100864,"_7710":101078},[48836],"phoenix.coprocessor.maxServerCacheTimeToLiveMs",{"_12623":2727,"_48290":2644,"_18312":101080,"_5":17825,"_25222":100864,"_7710":101081},[48836],"Maximum living time (in milliseconds) of server caches. A cache entry expires after this amount of time has passed since last access. Consider adjusting this parameter when a server-side IOException(\"Could not find hash cache for joinId\") happens. Getting warnings like \"Earlier hash cache(s) might have expired on servers\" might also be a sign that this number should be increased.",{"_12623":2728,"_48290":2644,"_18312":101083,"_5":17825,"_25222":100864,"_7710":46247},[48836],{"_12623":2729,"_48290":2644,"_18312":101085,"_5":17825,"_25222":100864,"_7710":101086},[48836],"phoenix.query.useIndexes",{"_12623":2730,"_48290":2644,"_18312":101088,"_5":17825,"_25222":100864,"_7710":101089},[48836],"Client-side property determining whether or not indexes are considered by the optimizer to satisfy a query. Default is true",{"_12623":2731,"_48290":2644,"_18312":101091,"_5":17825,"_25222":100864,"_7710":16457},[48836],{"_12623":2732,"_48290":2644,"_18312":101093,"_5":17825,"_25222":100864,"_7710":101094},[48836],"phoenix.index.failure.handling.rebuild",{"_12623":2733,"_48290":2644,"_18312":101096,"_5":17825,"_25222":100864,"_7710":101097},[48836],"Server-side property determining whether or not a mutable index is rebuilt in the background in the event of a commit failure. Only applicable for indexes on mutable, non transactional tables. Default is true",{"_12623":2734,"_48290":2644,"_18312":101099,"_5":17825,"_25222":100864,"_7710":16457},[48836],{"_12623":2735,"_48290":2644,"_18312":101101,"_5":17825,"_25222":100864,"_7710":101102},[48836],"phoenix.index.failure.block.write",{"_12623":2736,"_48290":2644,"_18312":101104,"_5":17825,"_25222":100864,"_7710":101105},[48836],"Server-side property determining whether or not writes to the data table are disallowed in the event of a commit failure until the index can be caught up with the data table. Requires that phoenix.index.failure.handling.rebuild is true as well. Only applicable for indexes on mutable, non transactional tables. Default is false",{"_12623":2737,"_48290":2644,"_18312":101107,"_5":17825,"_25222":100864,"_7710":26233},[48836],{"_12623":2738,"_48290":2644,"_18312":101109,"_5":17825,"_25222":100864,"_7710":101110},[48836],"phoenix.index.failure.handling.rebuild.interval",{"_12623":2739,"_48290":2644,"_18312":101112,"_5":17825,"_25222":100864,"_7710":101113},[48836],"Server-side property controlling the millisecond frequency at which the server checks whether or not a mutable index needs to be partially rebuilt to catch up with updates to the data table. Only applicable for indexes on mutable, non transactional tables. Default is 10 seconds.",{"_12623":2740,"_48290":2644,"_18312":101115,"_5":17825,"_25222":100864,"_7710":45595},[48836],{"_12623":2741,"_48290":2644,"_18312":101117,"_5":17825,"_25222":100864,"_7710":101118},[48836],"phoenix.index.failure.handling.rebuild.overlap.time",{"_12623":2742,"_48290":2644,"_18312":101120,"_5":17825,"_25222":100864,"_7710":101121},[48836],"Server-side property controlling how many milliseconds to go back from the timestamp at which the failure occurred to go back when a partial rebuild is performed. Only applicable for indexes on mutable, non transactional tables. Default is 1 millisecond.",{"_12623":2743,"_48290":2644,"_18312":101123,"_5":17825,"_25222":100864,"_7710":9341},[48836],{"_12623":2744,"_48290":2644,"_18312":101125,"_5":17825,"_25222":100864,"_7710":101126},[48836],"phoenix.index.mutableBatchSizeThreshold",{"_12623":2745,"_48290":2644,"_18312":101128,"_5":17825,"_25222":100864,"_7710":101129},[48836],"Number of mutations in a batch beyond which index metadata will be sent as a separate RPC to each region server as opposed to included inline with each mutation. Defaults to 5.",{"_12623":2746,"_48290":2644,"_18312":101131,"_5":17825,"_25222":100864,"_7710":9473},[48836],{"_12623":2747,"_48290":2644,"_18312":101133,"_5":17825,"_25222":100864,"_7710":101134},[48836],"phoenix.schema.dropMetaData",{"_12623":2748,"_48290":2644,"_18312":101136,"_5":17825,"_25222":100864,"_7710":101137},[48836],"Determines whether or not an HBase table is dropped when the Phoenix table is dropped. Default is true",{"_12623":2749,"_48290":2644,"_18312":101139,"_5":17825,"_25222":100864,"_7710":16457},[48836],{"_12623":2750,"_48290":2644,"_18312":101141,"_5":17825,"_25222":100864,"_7710":101142},[48836],"phoenix.groupby.spillable",{"_12623":2751,"_48290":2644,"_18312":101144,"_5":17825,"_25222":100864,"_7710":101145},[48836],"Determines whether or not a GROUP BY over a large number of distinct values is allowed to spill to disk on the region server. If false, an InsufficientMemoryException will be thrown instead. Default is true",{"_12623":2752,"_48290":2644,"_18312":101147,"_5":17825,"_25222":100864,"_7710":16457},[48836],{"_12623":2753,"_48290":2644,"_18312":101149,"_5":17825,"_25222":100864,"_7710":101150},[48836],"phoenix.groupby.spillFiles",{"_12623":2754,"_48290":2644,"_18312":101152,"_5":17825,"_25222":100864,"_7710":101153},[48836],"Number of memory mapped spill files to be used when spilling GROUP BY distinct values to disk. Default is 2",{"_12623":2755,"_48290":2644,"_18312":101155,"_5":17825,"_25222":100864,"_7710":9370},[48836],{"_12623":2756,"_48290":2644,"_18312":101157,"_5":17825,"_25222":100864,"_7710":101158},[48836],"phoenix.groupby.maxCacheSize",{"_12623":2757,"_48290":2644,"_18312":101160,"_5":17825,"_25222":100864,"_7710":101161},[48836],"Size in bytes of pages cached during GROUP BY spilling. Default is 100Mb",{"_12623":2758,"_48290":2644,"_18312":101163,"_5":17825,"_25222":100864,"_7710":45667},[48836],{"_12623":2759,"_48290":2644,"_18312":101165,"_5":17825,"_25222":100864,"_7710":101166},[48836],"phoenix.groupby.estimatedDistinctValues",{"_12623":2760,"_48290":2644,"_18312":101168,"_5":17825,"_25222":100864,"_7710":101169},[48836],"Number of estimated distinct values when a GROUP BY is performed. Used to perform initial sizing with growth of 1.5x each time reallocation is required. Default is 1000",{"_12623":2761,"_48290":2644,"_18312":101171,"_5":17825,"_25222":100864,"_7710":45578},[48836],{"_12623":2762,"_48290":2644,"_18312":101173,"_5":17825,"_25222":100864,"_7710":101174},[48836],"phoenix.distinct.value.compress.threshold",{"_12623":2763,"_48290":2644,"_18312":101176,"_5":17825,"_25222":100864,"_7710":101177},[48836],"Size in bytes beyond which aggregate operations which require tracking distinct value counts (such as COUNT DISTINCT) will use Snappy compression. Default is 1Mb",{"_12623":2764,"_48290":2644,"_18312":101179,"_5":17825,"_25222":100864,"_7710":45652},[48836],{"_12623":2765,"_48290":2644,"_18312":101181,"_5":17825,"_25222":100864,"_7710":101182},[48836],"phoenix.index.maxDataFileSizePerc",{"_12623":2766,"_48290":2644,"_18312":101184,"_5":17825,"_25222":100864,"_7710":101185},[48836],"Percentage used to determine the MAX_FILESIZE for the shared index table for views relative to the data table MAX_FILESIZE. The percentage should be estimated based on the anticipated average size of a view index row versus the data row. Default is 50%.",{"_12623":2767,"_48290":2644,"_18312":101187,"_5":17825,"_25222":100864,"_7710":45617},[48836],{"_12623":2768,"_48290":2644,"_18312":101189,"_5":17825,"_25222":100864,"_7710":101190},[48836],"phoenix.coprocessor.maxMetaDataCacheTimeToLiveMs",{"_12623":2769,"_48290":2644,"_18312":101192,"_5":17825,"_25222":100864,"_7710":101193},[48836],"Time in milliseconds after which the server-side metadata cache for a tenant will expire if not accessed. Default is 30mins",{"_12623":2770,"_48290":2644,"_18312":101195,"_5":17825,"_25222":100864,"_7710":45875},[48836],{"_12623":2771,"_48290":2644,"_18312":101197,"_5":17825,"_25222":100864,"_7710":101198},[48836],"phoenix.coprocessor.maxMetaDataCacheSize",{"_12623":2772,"_48290":2644,"_18312":101200,"_5":17825,"_25222":100864,"_7710":101201},[48836],"Max size in bytes of total server-side metadata cache after which evictions will begin to occur based on least recent access time. Default is 20Mb",{"_12623":2773,"_48290":2644,"_18312":101203,"_5":17825,"_25222":100864,"_7710":46835},[48836],{"_12623":2774,"_48290":2644,"_18312":101205,"_5":17825,"_25222":100864,"_7710":101206},[48836],"phoenix.client.maxMetaDataCacheSize",{"_12623":2775,"_48290":2644,"_18312":101208,"_5":17825,"_25222":100864,"_7710":101209},[48836],"Max size in bytes of total client-side metadata cache after which evictions will begin to occur based on least recent access time. Default is 10Mb",{"_12623":2776,"_48290":2644,"_18312":101211,"_5":17825,"_25222":100864,"_7710":45660},[48836],{"_12623":2777,"_48290":2644,"_18312":101213,"_5":17825,"_25222":100864,"_7710":101214},[48836],"phoenix.sequence.cacheSize",{"_12623":2778,"_48290":2644,"_18312":101216,"_5":17825,"_25222":100864,"_7710":101217},[48836],"Number of sequence values to reserve from the server and cache on the client when the next sequence value is allocated. Only used if not defined by the sequence itself. Default is 100",{"_12623":2779,"_48290":2644,"_18312":101219,"_5":17825,"_25222":100864,"_7710":45547},[48836],{"_12623":2780,"_48290":2644,"_18312":101221,"_5":17825,"_25222":100864,"_7710":101222},[48836],"phoenix.clock.skew.interval",{"_12623":2781,"_48290":2644,"_18312":101224,"_5":17825,"_25222":100864,"_7710":101225},[48836],"Delay interval(in milliseconds) when opening SYSTEM.CATALOG to compensate possible time clock skew when SYSTEM.CATALOG moves among region servers.",{"_12623":2782,"_48290":2644,"_18312":101227,"_5":17825,"_25222":100864,"_7710":46472},[48836],{"_12623":2783,"_48290":2644,"_18312":101229,"_5":17825,"_25222":100864,"_7710":101094},[48836],{"_12623":2784,"_48290":2644,"_18312":101231,"_5":17825,"_25222":100864,"_7710":101232},[48836],"Boolean flag which turns on/off auto-rebuild a failed index from when some updates are failed to be updated into the index.",{"_12623":2785,"_48290":2644,"_18312":101234,"_5":17825,"_25222":100864,"_7710":16457},[48836],{"_12623":2786,"_48290":2644,"_18312":101236,"_5":17825,"_25222":100864,"_7710":101110},[48836],{"_12623":2787,"_48290":2644,"_18312":101238,"_5":17825,"_25222":100864,"_7710":101239},[48836],"Time interval(in milliseconds) for index rebuild backend Job to check if there is an index to be rebuilt",{"_12623":2788,"_48290":2644,"_18312":101241,"_5":17825,"_25222":100864,"_7710":45595},[48836],{"_12623":2789,"_48290":2644,"_18312":101243,"_5":17825,"_25222":100864,"_7710":101118},[48836],{"_12623":2790,"_48290":2644,"_18312":101245,"_5":17825,"_25222":100864,"_7710":101246},[48836],"Index rebuild job builds an index from when it failed - the time interval(in milliseconds) in order to create a time overlap to prevent missing updates when there exists time clock skew.",{"_12623":2791,"_48290":2644,"_18312":101248,"_5":17825,"_25222":100864,"_7710":46255},[48836],{"_12623":2792,"_48290":2644,"_18312":101250,"_5":17825,"_25222":100864,"_7710":101251},[48836],"phoenix.query.force.rowkeyorder",{"_12623":2793,"_48290":2644,"_18312":101253,"_5":17825,"_25222":100864,"_7710":101254},[48836],"Whether or not a non aggregate query returns rows in row key order for salted tables. For version prior to 4.4, use phoenix.query.rowKeyOrderSaltedTable instead. Default is true.",{"_12623":2794,"_48290":2644,"_18312":101256,"_5":17825,"_25222":100864,"_7710":16457},[48836],{"_12623":2795,"_48290":2644,"_18312":101258,"_5":17825,"_25222":100864,"_7710":101259},[48836],"phoenix.connection.autoCommit",{"_12623":2796,"_48290":2644,"_18312":101261,"_5":17825,"_25222":100864,"_7710":101262},[48836],"Whether or not a new connection has auto-commit enabled when it is created.",{"_12623":2797,"_48290":2644,"_18312":101264,"_5":17825,"_25222":100864,"_7710":26233},[48836],{"_12623":2798,"_48290":2644,"_18312":101266,"_5":17825,"_25222":100864,"_7710":101267},[48836],"phoenix.table.default.store.nulls",{"_12623":2799,"_48290":2644,"_18312":101269,"_5":17825,"_25222":100864,"_7710":101270},[48836],"The default value of the STORE_NULLS flag used for table creation which determines whether or not null values should be explicitly stored in HBase. This is a client side parameter. Available starting from Phoenix 4.3.",{"_12623":2800,"_48290":2644,"_18312":101272,"_5":17825,"_25222":100864,"_7710":26233},[48836],{"_12623":2801,"_48290":2644,"_18312":101274,"_5":17825,"_25222":100864,"_7710":101275},[48836],"phoenix.table.istransactional.default",{"_12623":2802,"_48290":2644,"_18312":101277,"_5":17825,"_25222":100864,"_7710":101278},[48836],"The default value of the TRANSACTIONAL flag used for table creation which determines whether or not a table is transactional . This is a client side parameter. Available starting from Phoenix 4.7.",{"_12623":2803,"_48290":2644,"_18312":101280,"_5":17825,"_25222":100864,"_7710":26233},[48836],{"_12623":2804,"_48290":2644,"_18312":101282,"_5":17825,"_25222":100864,"_7710":101283},[48836],"phoenix.transactions.enabled",{"_12623":2805,"_48290":2644,"_18312":101285,"_5":17825,"_25222":100864,"_7710":101286},[48836],"Determines whether or not transactions are enabled in Phoenix. A table may not be declared as transactional if transactions are disabled. This is a client side parameter. Available starting from Phoenix 4.7.",{"_12623":2806,"_48290":2644,"_18312":101288,"_5":17825,"_25222":100864,"_7710":26233},[48836],{"_12623":2807,"_48290":2644,"_18312":101290,"_5":17825,"_25222":100864,"_7710":101291},[48836],"phoenix.mapreduce.split.by.stats",{"_12623":2808,"_48290":2644,"_18312":101293,"_5":17825,"_25222":100864,"_7710":101294},[48836],"Determines whether to use the splits determined by statistics for MapReduce input splits. Default is true. This is a server side parameter. Available starting from Phoenix 4.10. Set to false to enable behavior from previous versions.",{"_12623":2809,"_48290":2644,"_18312":101296,"_5":17825,"_25222":100864,"_7710":16457},[48836],{"_12623":2810,"_48290":2644,"_18312":101298,"_5":17825,"_25222":100864,"_7710":101299},[48836],"phoenix.log.level",{"_12623":2811,"_48290":2644,"_18312":101301,"_5":17825,"_25222":100864,"_7710":101302},[48836],"Client-side property enabling query (only SELECT statement) logging. The logs are written to the SYSTEM.LOG table (requires a user to have W access on SYSTEM.LOG table). Possible values: OFF = No logging; INFO = Enables query logging; DEBUG = More details on Query (Explain plan, HBase Scan Details etc); TRACE = Logs query bind parameters as well. Available starting from Phoenix 4.14. WARNING: Enabling this feature may leak sensitive information to anyone who can access the SYSTEM.LOG table.",{"_12623":2812,"_48290":2644,"_18312":101304,"_5":17825,"_25222":100864,"_7710":101305},[48836],"OFF",{"_12623":2813,"_48290":2644,"_18312":101307,"_5":17825,"_25222":100864,"_7710":101308},[48836],"phoenix.log.sample.rate",{"_12623":2814,"_48290":2644,"_18312":101310,"_5":17825,"_25222":100864,"_7710":101311},[48836],"Client-side property controlling the probability of logging a query to the query log. Set to a value between 0.0(no query) and 1.0(100% queries) . Available starting from Phoenix 4.14.",{"_12623":2815,"_48290":2644,"_18312":101313,"_5":17825,"_25222":100864,"_7710":101314},[48836],"1.0",{"_12623":2816,"_48290":2816,"_5":13058,"_7710":101316,"_48807":101317,"_18312":101318,"_25222":2816},"Performance Testing",[92880,92881,92882,100552],[48836],{"_12623":2817,"_48290":2816,"_18312":101320,"_5":17825,"_25222":2816,"_7710":101321},[48836],"Use Pherf to generate data and run Phoenix performance tests.",{"_12623":2818,"_48290":2816,"_5":48804,"_18312":101323,"_25222":101324,"_7710":97033},[48836],"/docs/fundamentals/performance-testing#performance-testing-overview",{"_12623":2819,"_48290":2816,"_5":48804,"_18312":101326,"_25222":101327,"_7710":101328},[48836],"/docs/fundamentals/performance-testing#build-all-of-phoenix-includes-pherf-default-profile","Build all of Phoenix (includes Pherf default profile)",{"_12623":2820,"_48290":2816,"_5":48804,"_18312":101330,"_25222":101331,"_7710":101332},[48836],"/docs/fundamentals/performance-testing#running","Running",{"_12623":2821,"_48290":2816,"_5":48804,"_18312":101334,"_25222":101335,"_7710":101336},[48836],"/docs/fundamentals/performance-testing#example-run-commands","Example run commands",{"_12623":2822,"_48290":2816,"_5":48804,"_18312":101338,"_25222":101339,"_7710":101340},[48836],"/docs/fundamentals/performance-testing#list-all-scenario-files-available-to-run","List all scenario files available to run.",{"_12623":2823,"_48290":2816,"_5":48804,"_18312":101342,"_25222":101343,"_7710":101344},[48836],"/docs/fundamentals/performance-testing#drop-all-existing-tables-load-and-query-data-specified-in-all-scenario-files","Drop all existing tables, load and query data specified in all scenario files.",{"_12623":2824,"_48290":2816,"_5":48804,"_18312":101346,"_25222":101347,"_7710":101348},[48836],"/docs/fundamentals/performance-testing#pherf-arguments","Pherf arguments:",{"_12623":2825,"_48290":2816,"_5":48804,"_18312":101350,"_25222":101351,"_7710":101352},[48836],"/docs/fundamentals/performance-testing#adding-rules-for-data-creation","Adding Rules for Data Creation",{"_12623":2826,"_48290":2816,"_5":48804,"_18312":101354,"_25222":101355,"_7710":101356},[48836],"/docs/fundamentals/performance-testing#defining-scenario","Defining Scenario",{"_12623":2827,"_48290":2816,"_5":48804,"_18312":101358,"_25222":101359,"_7710":101360},[48836],"/docs/fundamentals/performance-testing#results","Results",{"_12623":2828,"_48290":2816,"_5":48804,"_18312":101362,"_25222":101363,"_7710":101364},[48836],"/docs/fundamentals/performance-testing#xml-results","XML results",{"_12623":2829,"_48290":2816,"_5":48804,"_18312":101366,"_25222":101367,"_7710":101368},[48836],"/docs/fundamentals/performance-testing#csv-results","CSV results",{"_12623":2830,"_48290":2816,"_5":48804,"_18312":101370,"_25222":101371,"_7710":101372},[48836],"/docs/fundamentals/performance-testing#testing","Testing",{"_12623":2831,"_48290":2816,"_18312":101374,"_5":17825,"_25222":101324,"_7710":101375},[48836],"Pherf is a standalone tool for performance and functional testing through Phoenix. Pherf can be used both to generate highly customized datasets and to measure SQL performance against that data.",{"_12623":2832,"_48290":2816,"_18312":101377,"_5":17825,"_25222":101331,"_7710":101378},[48836],"Edit config/env.sh to include the required property values.",{"_12623":2833,"_48290":2816,"_18312":101380,"_5":17825,"_25222":101331,"_7710":101381},[48836],"bin/pherf-standalone.py -h",{"_12623":2834,"_48290":2816,"_18312":101383,"_5":17825,"_25222":101331,"_7710":101384},[48836],"Example: bin/pherf-standalone.py -drop all -l -q -z [zookeeper] -schemaFile .*user_defined_schema.sql -scenarioFile .*user_defined_scenario.xml",{"_12623":2835,"_48290":2816,"_18312":101386,"_5":17825,"_25222":101347,"_7710":101387},[48836],"-h Help",{"_12623":2836,"_48290":2816,"_18312":101389,"_5":17825,"_25222":101347,"_7710":101390},[48836],"-l Apply schema and load data",{"_12623":2837,"_48290":2816,"_18312":101392,"_5":17825,"_25222":101347,"_7710":101393},[48836],"-q Executes multi-threaded query sets and writes results",{"_12623":2838,"_48290":2816,"_18312":101395,"_5":17825,"_25222":101347,"_7710":101396},[48836],"-z [quorum] ZooKeeper quorum",{"_12623":2839,"_48290":2816,"_18312":101398,"_5":17825,"_25222":101347,"_7710":101399},[48836],"-m Enable monitor for statistics",{"_12623":2840,"_48290":2816,"_18312":101401,"_5":17825,"_25222":101347,"_7710":101402},[48836],"-monitorFrequency [frequency in ms] Frequency at which the monitor will snapshot stats to log file",{"_12623":2841,"_48290":2816,"_18312":101404,"_5":17825,"_25222":101347,"_7710":101405},[48836],"-drop [pattern] Regex drop all tables with schema name as PHERF. Example drop Event tables: -drop .*(EVENT).*. Drop all: -drop .* or -drop all",{"_12623":2842,"_48290":2816,"_18312":101407,"_5":17825,"_25222":101347,"_7710":101408},[48836],"-scenarioFile Regex or file name of a specific scenario file to run",{"_12623":2843,"_48290":2816,"_18312":101410,"_5":17825,"_25222":101347,"_7710":101411},[48836],"-schemaFile Regex or file name of a specific schema file to run",{"_12623":2844,"_48290":2816,"_18312":101413,"_5":17825,"_25222":101347,"_7710":101414},[48836],"-export Exports query results to CSV files in CSV_EXPORT directory",{"_12623":2845,"_48290":2816,"_18312":101416,"_5":17825,"_25222":101347,"_7710":101417},[48836],"-diff Compares results with previously exported results",{"_12623":2846,"_48290":2816,"_18312":101419,"_5":17825,"_25222":101347,"_7710":101420},[48836],"-hint Executes all queries with specified hint. Example: SMALL",{"_12623":2847,"_48290":2816,"_18312":101422,"_5":17825,"_25222":101347,"_7710":101423},[48836],"-rowCountOverride",{"_12623":2848,"_48290":2816,"_18312":101425,"_5":17825,"_25222":101347,"_7710":101426},[48836],"-rowCountOverride [number of rows] Specify number of rows to be upserted rather than using row count specified in schema",{"_12623":2849,"_48290":2816,"_18312":101428,"_5":17825,"_25222":101351,"_7710":101429},[48836],"Review test_scenario.xml\nfor syntax examples.",{"_12623":2850,"_48290":2816,"_18312":101431,"_5":17825,"_25222":101351,"_7710":101432},[48836],"Rules are defined as <columns /> and are applied in the order they appear in file.",{"_12623":2851,"_48290":2816,"_18312":101434,"_5":17825,"_25222":101351,"_7710":101435},[48836],"Rules of the same type override the values of a prior rule of the same type. If <userDefined>true</userDefined> is\nset, rule will only\napply override when type and name match the column name in Phoenix.",{"_12623":2852,"_48290":2816,"_18312":101437,"_5":17825,"_25222":101351,"_7710":101438},[48836],"<prefix> tag is set at the column level. It can be used to define a constant string appended to the beginning of\nCHAR and VARCHAR data type values.",{"_12623":2853,"_48290":2816,"_18312":101440,"_5":17825,"_25222":101351,"_7710":101441},[48836],"Required field Supported Phoenix types: VARCHAR, CHAR, DATE, DECIMAL, INTEGER",{"_12623":2854,"_48290":2816,"_18312":101443,"_5":17825,"_25222":101351,"_7710":101444},[48836],"denoted by the <type> tag",{"_12623":2855,"_48290":2816,"_18312":101446,"_5":17825,"_25222":101351,"_7710":101447},[48836],"User defined true changes rule matching to use both name and type fields to determine equivalence.",{"_12623":2856,"_48290":2816,"_18312":101449,"_5":17825,"_25222":101351,"_7710":101450},[48836],"Default is false if not specified and equivalence will be determined by type only. An important note here is that you can still override rules without the user defined flag, but they will change the rule globally and not just for a specified column.",{"_12623":2857,"_48290":2816,"_18312":101452,"_5":17825,"_25222":101351,"_7710":101453},[48836],"Required field Supported Data Sequences",{"_12623":2858,"_48290":2816,"_18312":101455,"_5":17825,"_25222":101351,"_7710":101456},[48836],"RANDOM: Random value which can be bound by other fields such as length.",{"_12623":2859,"_48290":2816,"_18312":101458,"_5":17825,"_25222":101351,"_7710":101459},[48836],"SEQUENTIAL: Monotonically increasing long prepended to random strings.",{"_12623":2860,"_48290":2816,"_18312":101461,"_5":17825,"_25222":101351,"_7710":101462},[48836],"Only supported on VARCHAR and CHAR types",{"_12623":2861,"_48290":2816,"_18312":101464,"_5":17825,"_25222":101351,"_7710":101465},[48836],"LIST: Means pick values from predefined list of values",{"_12623":2862,"_48290":2816,"_18312":101467,"_5":17825,"_25222":101351,"_7710":101468},[48836],"Required field Length defines boundary for random values for CHAR and VARCHAR types.",{"_12623":2863,"_48290":2816,"_18312":101470,"_5":17825,"_25222":101351,"_7710":101471},[48836],"denoted by the <length> tag",{"_12623":2864,"_48290":2816,"_18312":101473,"_5":17825,"_25222":101351,"_7710":101474},[48836],"Column level Min/Max value defines boundaries for numerical values. For DATEs, these values supply a range between\nwhich values are generated. At the column level the granularity is a year. At a specific data value level, the\ngranularity is down to the Ms.",{"_12623":2865,"_48290":2816,"_18312":101476,"_5":17825,"_25222":101351,"_7710":101477},[48836],"denoted by the <minValue> tag",{"_12623":2866,"_48290":2816,"_18312":101479,"_5":17825,"_25222":101351,"_7710":101480},[48836],"denoted by the <maxValue> tag",{"_12623":2867,"_48290":2816,"_18312":101482,"_5":17825,"_25222":101351,"_7710":101483},[48836],"Null chance denotes the probability of generating a null value. From [0-100]. The higher the number, the more likely\nthe value will be null. Denoted by <nullChance>.",{"_12623":2868,"_48290":2816,"_18312":101485,"_5":17825,"_25222":101351,"_7710":101486},[48836],"Name can either be any text or the actual column name in the Phoenix table.",{"_12623":2869,"_48290":2816,"_18312":101488,"_5":17825,"_25222":101351,"_7710":101489},[48836],"denoted by the <name> tag",{"_12623":2870,"_48290":2816,"_18312":101491,"_5":17825,"_25222":101351,"_7710":101492},[48836],"Value List is used in conjunction with LIST data sequences. Each entry is a DataValue with a specified value to be\nused when generating data.",{"_12623":2871,"_48290":2816,"_18312":101494,"_5":17825,"_25222":101351,"_7710":101495},[48836],"Denoted by the <valueList><datavalue><value/></datavalue></valueList> tags",{"_12623":2872,"_48290":2816,"_18312":101497,"_5":17825,"_25222":101351,"_7710":101498},[48836],"If the distribution attribute on the datavalue is set, values will be created according to\nthat probability.",{"_12623":2873,"_48290":2816,"_18312":101500,"_5":17825,"_25222":101351,"_7710":101501},[48836],"When distribution is used, values must add up to 100%.",{"_12623":2874,"_48290":2816,"_18312":101503,"_5":17825,"_25222":101351,"_7710":101504},[48836],"If distribution is not used, values will be randomly picked from the list with equal distribution.",{"_12623":2875,"_48290":2816,"_18312":101506,"_5":17825,"_25222":101355,"_7710":101507},[48836],"A scenario can have multiple querySets. Consider the following example: concurrency of 1-4 means that each query will be\nexecuted starting with concurrency level of 1 and reach up to maximum concurrency of 4. Per thread, query would be\nexecuted to a minimum of 10 times or 10 seconds (whichever comes first). QuerySet by default is executed serially but you\ncan change executionType to PARALLEL so queries are executed concurrently. Each Query may have an optional timeoutDuration\nfield that defines the amount of time (in milliseconds) before execution for that Query is cancelled. Scenarios are defined\nin XML files stored in the resource directory.",{"_12623":2876,"_48290":2816,"_18312":101509,"_5":17825,"_25222":101359,"_7710":101510},[48836],"Results are written real time in results directory. Open the result that is saved in .jpg format for real time\nvisualization. Results are written using DataModelResult objects, which are modified over the course of each Pherf\nrun.",{"_12623":2877,"_48290":2816,"_18312":101512,"_5":17825,"_25222":101363,"_7710":101513},[48836],"Pherf XML results have a similar format to the corresponding scenario.xml file used for the Pherf run, but also include\nadditional information, such as the execution time of queries, whether queries timed out, and result row count.",{"_12623":2878,"_48290":2816,"_18312":101515,"_5":17825,"_25222":101367,"_7710":101516},[48836],"Each row in a CSV result file represents a single execution of a query and provides details about a query execution's\nruntime, timeout status, result row count, and more. The header file format can be found in Header.java.",{"_12623":2879,"_48290":2816,"_18312":101518,"_5":17825,"_25222":101371,"_7710":101519},[48836],"Default quorum is localhost. If you want to override set the system variable.",{"_12623":2880,"_48290":2816,"_18312":101521,"_5":17825,"_25222":101371,"_7710":101522},[48836],"Run unit tests: mvn test -DZK_QUORUM=localhostRun a specific method: mvn -Dtest=ClassName#methodName test",{"_12623":2881,"_48290":2816,"_18312":101524,"_5":17825,"_25222":101371,"_7710":101525},[48836],"More to come...",{"_12623":2882,"_48290":2882,"_5":13058,"_7710":97754,"_48807":101527,"_18312":101528,"_25222":2882},[92880,92881,92882,100552],[48836],{"_12623":2883,"_48290":2882,"_18312":101530,"_5":17825,"_25222":2882,"_7710":101531},[48836],"Historical Phoenix performance comparisons and feature-level improvements for scans, salting, and query execution.",{"_12623":2884,"_48290":2882,"_5":48804,"_18312":101533,"_25222":101534,"_7710":101535},[48836],"/docs/fundamentals/performance#phoenix-vs-related-products","Phoenix vs related products",{"_12623":2885,"_48290":2882,"_5":48804,"_18312":101537,"_25222":101538,"_7710":101539},[48836],"/docs/fundamentals/performance#phoenix-vs-hive-running-over-hdfs-and-hbase","Phoenix vs Hive (running over HDFS and HBase)",{"_12623":2886,"_48290":2882,"_5":48804,"_18312":101541,"_25222":101542,"_7710":101543},[48836],"/docs/fundamentals/performance#phoenix-vs-impala-running-over-hbase","Phoenix vs Impala (running over HBase)",{"_12623":2887,"_48290":2882,"_5":48804,"_18312":101545,"_25222":101546,"_7710":101547},[48836],"/docs/fundamentals/performance#latest-automated-performance-run","Latest Automated Performance Run",{"_12623":2888,"_48290":2882,"_5":48804,"_18312":101549,"_25222":101550,"_7710":101551},[48836],"/docs/fundamentals/performance#performance-improvements-in-phoenix-12","Performance improvements in Phoenix 1.2",{"_12623":2889,"_48290":2882,"_5":48804,"_18312":101553,"_25222":101554,"_7710":101555},[48836],"/docs/fundamentals/performance#essential-column-family","Essential Column Family",{"_12623":2890,"_48290":2882,"_5":48804,"_18312":101557,"_25222":101558,"_7710":98739},[48836],"/docs/fundamentals/performance#performance-skip-scan",{"_12623":2891,"_48290":2882,"_5":48804,"_18312":101560,"_25222":101561,"_7710":101562},[48836],"/docs/fundamentals/performance#performance-salting","Salting",{"_12623":2892,"_48290":2882,"_5":48804,"_18312":101564,"_25222":101565,"_7710":101566},[48836],"/docs/fundamentals/performance#top-n","Top-N",{"_12623":2893,"_48290":2882,"_18312":101568,"_5":17825,"_25222":2882,"_7710":100843},[48836],{"_12623":2894,"_48290":2882,"_18312":101570,"_5":17825,"_25222":2882,"_7710":101571},[48836],"This page has not been updated recently and may not reflect the current state\nof the project.",{"_12623":2895,"_48290":2882,"_18312":101573,"_5":17825,"_25222":2882,"_7710":101574},[48836],"Phoenix follows the philosophy of bringing the computation to the data by using:",{"_12623":2896,"_48290":2882,"_18312":101576,"_5":17825,"_25222":2882,"_7710":101577},[48836],"coprocessors to perform operations on the server-side thus minimizing client/server data transfer",{"_12623":2897,"_48290":2882,"_18312":101579,"_5":17825,"_25222":2882,"_7710":101580},[48836],"custom filters to prune data as close to the source as possible.",{"_12623":2898,"_48290":2882,"_18312":101582,"_5":17825,"_25222":2882,"_7710":101583},[48836],"In addition, to minimize startup costs, Phoenix uses native HBase APIs rather than going through the MapReduce framework.",{"_12623":2899,"_48290":2882,"_18312":101585,"_5":17825,"_25222":101534,"_7710":101586},[48836],"Below are charts showing relative performance between Phoenix and some other related products.",{"_12623":2900,"_48290":2882,"_18312":101588,"_5":17825,"_25222":101538,"_7710":101589},[48836],"Query: SELECT COUNT(1) from a table over 10M and 100M rows. Data has 5 narrow columns. Number of region\nservers: 4 (HBase heap: 10GB, processor: 6 cores @ 3.3GHz Xeon).",{"_12623":2901,"_48290":2882,"_18312":101591,"_5":17825,"_25222":101542,"_7710":101592},[48836],"Query: SELECT COUNT(1) from a table over 1M and 5M rows. Data has 3 narrow columns. Number of region servers: 1 (virtual machine, HBase heap: 2GB, processor: 2 cores @ 3.3GHz Xeon).",{"_12623":2902,"_48290":2882,"_18312":101594,"_5":17825,"_25222":101546,"_7710":101595},[48836],"Latest Automated Performance Run |\nAutomated Performance Runs History",{"_12623":2903,"_48290":2882,"_18312":101597,"_5":17825,"_25222":101554,"_7710":101598},[48836],"The Phoenix 1.2 query filter leverages the HBase Filter Essential Column Family feature. This improves performance when Phoenix filters data split across multiple column families (CFs) by loading only essential CFs first. In a second pass, all CFs are loaded as needed.",{"_12623":2904,"_48290":2882,"_18312":101600,"_5":17825,"_25222":101554,"_7710":101601},[48836],"Consider the following schema in which data is split into two CFs:\nCREATE TABLE t (k VARCHAR NOT NULL PRIMARY KEY, a.c1 INTEGER, b.c2 VARCHAR, b.c3 VARCHAR, b.c4 VARCHAR).",{"_12623":2905,"_48290":2882,"_18312":101603,"_5":17825,"_25222":101554,"_7710":101604},[48836],"Running a query similar to the following shows significant performance gains when a subset of rows matches the filter:\nSELECT COUNT(c2) FROM t WHERE c1 = ?",{"_12623":2906,"_48290":2882,"_18312":101606,"_5":17825,"_25222":101554,"_7710":101607},[48836],"The following chart shows in-memory query performance for the query above with 10M rows on 4 region servers, when 10% of rows match the filter. Note: cf-a is approximately 8 bytes and cf-b is approximately 400 bytes wide.",{"_12623":2907,"_48290":2882,"_18312":101609,"_5":17825,"_25222":101558,"_7710":101610},[48836],"Skip Scan Filter leverages HBase filter SEEK_NEXT_USING_HINT (docs). It significantly improves point queries over key columns.",{"_12623":2908,"_48290":2882,"_18312":101612,"_5":17825,"_25222":101558,"_7710":101613},[48836],"Consider the following schema in which data is split into two CFs:\nCREATE TABLE t (k VARCHAR NOT NULL PRIMARY KEY, a.c1 INTEGER, b.c2 VARCHAR, b.c3 VARCHAR).",{"_12623":2909,"_48290":2882,"_18312":101615,"_5":17825,"_25222":101558,"_7710":101616},[48836],"Running a query similar to the following shows significant performance gains when a subset of rows matches the filter:\nSELECT COUNT(c1) FROM t WHERE k IN (1% random k's)",{"_12623":2910,"_48290":2882,"_18312":101618,"_5":17825,"_25222":101558,"_7710":101619},[48836],"The following chart shows in-memory query performance of the query above with 10M rows on 4 region servers when 1% random keys over the full key range are passed in the IN clause. Note: all VARCHAR columns are approximately 15 bytes.",{"_12623":2911,"_48290":2882,"_18312":101621,"_5":17825,"_25222":101561,"_7710":101622},[48836],"Salting in Phoenix 1.2 improves both read and write performance by adding an extra hash byte at the start of the key and pre-splitting data into regions. This reduces hotspotting on one or a few region servers. Read more about this feature here.",{"_12623":2912,"_48290":2882,"_18312":101624,"_5":17825,"_25222":101561,"_7710":101625},[48836],"Consider the following schema:",{"_12623":2913,"_48290":2882,"_18312":101627,"_5":17825,"_25222":101561,"_7710":101628},[48836],"CREATE TABLE T (HOST CHAR(2) NOT NULL,DOMAIN VARCHAR NOT NULL,\nFEATURE VARCHAR NOT NULL,DATE DATE NOT NULL,USAGE.CORE BIGINT,USAGE.DB BIGINT,STATS.ACTIVE_VISITOR\nINTEGER CONSTRAINT PK PRIMARY KEY (HOST, DOMAIN, FEATURE, DATE)) SALT_BUCKETS = 4.",{"_12623":2914,"_48290":2882,"_18312":101630,"_5":17825,"_25222":101561,"_7710":101631},[48836],"The following chart shows write performance with and without salting, where the table is split into 4 regions on a 4-region-server cluster (note: for optimal performance, salt bucket count should match region server count).",{"_12623":2915,"_48290":2882,"_18312":101633,"_5":17825,"_25222":101561,"_7710":101634},[48836],"The following chart shows in-memory query performance for a 10M-row table where host='NA' matches 3.3M rows.",{"_12623":2916,"_48290":2882,"_18312":101636,"_5":17825,"_25222":101561,"_7710":101637},[48836],"select count(1) from t where host='NA'",{"_12623":2917,"_48290":2882,"_18312":101639,"_5":17825,"_25222":101565,"_7710":101640},[48836],"The following chart shows in-memory query time for a Top-N query over 10M rows using Phoenix 1.2 and Hive over HBase.",{"_12623":2918,"_48290":2882,"_18312":101642,"_5":17825,"_25222":101565,"_7710":101643},[48836],"select core from t order by core desc limit 10",{"_12623":2919,"_48290":2919,"_5":13058,"_7710":101645,"_48807":101646,"_18312":101647,"_25222":2919},"Tuning Guide",[92880,92881,92882,100552],[48836],{"_12623":2920,"_48290":2919,"_18312":101649,"_5":17825,"_25222":2919,"_7710":101650},[48836],"Best practices for tuning Phoenix schema, indexes, queries, and write paths for read/write performance.",{"_12623":2921,"_48290":2919,"_5":48804,"_18312":101652,"_25222":101653,"_7710":101654},[48836],"/docs/fundamentals/tuning-guide#primary-keys","Primary Keys",{"_12623":2922,"_48290":2919,"_5":48804,"_18312":101656,"_25222":101657,"_7710":101658},[48836],"/docs/fundamentals/tuning-guide#monotonically-increasing-primary-keys","Monotonically increasing Primary keys",{"_12623":2923,"_48290":2919,"_5":48804,"_18312":101660,"_25222":101661,"_7710":101662},[48836],"/docs/fundamentals/tuning-guide#general-tips","General Tips",{"_12623":2924,"_48290":2919,"_5":48804,"_18312":101664,"_25222":101665,"_7710":101666},[48836],"/docs/fundamentals/tuning-guide#is-the-data-random-access","Is the Data Random-Access?",{"_12623":2925,"_48290":2919,"_5":48804,"_18312":101668,"_25222":101669,"_7710":101670},[48836],"/docs/fundamentals/tuning-guide#is-the-data-read-heavy-or-write-heavy","Is the data read-heavy or write-heavy?",{"_12623":2926,"_48290":2919,"_5":48804,"_18312":101672,"_25222":101673,"_7710":101674},[48836],"/docs/fundamentals/tuning-guide#which-columns-will-be-accessed-often","Which columns will be accessed often?",{"_12623":2927,"_48290":2919,"_5":48804,"_18312":101676,"_25222":101677,"_7710":101678},[48836],"/docs/fundamentals/tuning-guide#can-the-data-be-append-only-immutable","Can the data be append-only (immutable)?",{"_12623":2928,"_48290":2919,"_5":48804,"_18312":101680,"_25222":101681,"_7710":101682},[48836],"/docs/fundamentals/tuning-guide#is-the-table-very-large","Is the table very large?",{"_12623":2929,"_48290":2919,"_5":48804,"_18312":101684,"_25222":101685,"_7710":101686},[48836],"/docs/fundamentals/tuning-guide#is-transactionality-required","Is transactionality required?",{"_12623":2930,"_48290":2919,"_5":48804,"_18312":101688,"_25222":101689,"_7710":101690},[48836],"/docs/fundamentals/tuning-guide#block-encoding","Block Encoding",{"_12623":2931,"_48290":2919,"_5":48804,"_18312":101692,"_25222":101693,"_7710":101694},[48836],"/docs/fundamentals/tuning-guide#schema-design","Schema Design",{"_12623":2932,"_48290":2919,"_5":48804,"_18312":101696,"_25222":101697,"_7710":101698},[48836],"/docs/fundamentals/tuning-guide#phoenix-and-the-hbase-data-model","Phoenix and the HBase data model",{"_12623":2933,"_48290":2919,"_5":48804,"_18312":101700,"_25222":101701,"_7710":101702},[48836],"/docs/fundamentals/tuning-guide#column-families","Column Families",{"_12623":2934,"_48290":2919,"_5":48804,"_18312":101704,"_25222":101705,"_7710":101706},[48836],"/docs/fundamentals/tuning-guide#columns","Columns",{"_12623":2935,"_48290":2919,"_5":48804,"_18312":101708,"_25222":101709,"_7710":101710},[48836],"/docs/fundamentals/tuning-guide#indexes","Indexes",{"_12623":2936,"_48290":2919,"_5":48804,"_18312":101712,"_25222":101713,"_7710":101714},[48836],"/docs/fundamentals/tuning-guide#tuning-guide-secondary-indexes","Secondary indexes",{"_12623":2937,"_48290":2919,"_5":48804,"_18312":101716,"_25222":101717,"_7710":101718},[48836],"/docs/fundamentals/tuning-guide#queries","Queries",{"_12623":2938,"_48290":2919,"_5":48804,"_18312":101720,"_25222":101721,"_7710":101722},[48836],"/docs/fundamentals/tuning-guide#reading","Reading",{"_12623":2939,"_48290":2919,"_5":48804,"_18312":101724,"_25222":101725,"_7710":101726},[48836],"/docs/fundamentals/tuning-guide#range-queries","Range Queries",{"_12623":2940,"_48290":2919,"_5":48804,"_18312":101728,"_25222":101729,"_7710":101730},[48836],"/docs/fundamentals/tuning-guide#large-range-queries","Large Range Queries",{"_12623":2941,"_48290":2919,"_5":48804,"_18312":101732,"_25222":101733,"_7710":101734},[48836],"/docs/fundamentals/tuning-guide#point-lookups","Point Lookups",{"_12623":2942,"_48290":2919,"_5":48804,"_18312":101736,"_25222":101737,"_7710":101738},[48836],"/docs/fundamentals/tuning-guide#hints","Hints",{"_12623":2943,"_48290":2919,"_5":48804,"_18312":101740,"_25222":101741,"_7710":101742},[48836],"/docs/fundamentals/tuning-guide#explain-plans","Explain plans",{"_12623":2944,"_48290":2919,"_5":48804,"_18312":101744,"_25222":101745,"_7710":98776},[48836],"/docs/fundamentals/tuning-guide#tuning-guide-parallelization",{"_12623":2945,"_48290":2919,"_5":48804,"_18312":101747,"_25222":101748,"_7710":101749},[48836],"/docs/fundamentals/tuning-guide#writing","Writing",{"_12623":2946,"_48290":2919,"_5":48804,"_18312":101751,"_25222":101752,"_7710":101753},[48836],"/docs/fundamentals/tuning-guide#updating-data-with-upsert-values","Updating data with UPSERT VALUES",{"_12623":2947,"_48290":2919,"_5":48804,"_18312":101755,"_25222":101756,"_7710":101757},[48836],"/docs/fundamentals/tuning-guide#updating-data-with-upsert-select","Updating data with UPSERT SELECT",{"_12623":2948,"_48290":2919,"_5":48804,"_18312":101759,"_25222":101760,"_7710":101761},[48836],"/docs/fundamentals/tuning-guide#deleting-data","Deleting data",{"_12623":2949,"_48290":2919,"_5":48804,"_18312":101763,"_25222":101764,"_7710":101765},[48836],"/docs/fundamentals/tuning-guide#reducing-rpc-traffic","Reducing RPC traffic",{"_12623":2950,"_48290":2919,"_5":48804,"_18312":101767,"_25222":101768,"_7710":101769},[48836],"/docs/fundamentals/tuning-guide#using-local-indexes","Using local indexes",{"_12623":2951,"_48290":2919,"_5":48804,"_18312":101771,"_25222":101772,"_7710":101773},[48836],"/docs/fundamentals/tuning-guide#further-tuning","Further tuning",{"_12623":2952,"_48290":2919,"_5":48804,"_18312":101775,"_25222":101776,"_7710":101777},[48836],"/docs/fundamentals/tuning-guide#special-cases","Special Cases",{"_12623":2953,"_48290":2919,"_5":48804,"_18312":101779,"_25222":101780,"_7710":101781},[48836],"/docs/fundamentals/tuning-guide#for-applications-where-failing-quickly-is-better-than-waiting","For applications where failing quickly is better than waiting",{"_12623":2954,"_48290":2919,"_5":48804,"_18312":101783,"_25222":101784,"_7710":101785},[48836],"/docs/fundamentals/tuning-guide#for-applications-that-can-tolerate-slightly-out-of-date-information","For applications that can tolerate slightly out of date information",{"_12623":2955,"_48290":2919,"_18312":101787,"_5":17825,"_25222":2919,"_7710":101788},[48836],"Tuning Phoenix can be complex, but with a little knowledge of how it works you can make significant improvements to read and write performance. The most important factor is schema design, especially how it affects underlying HBase row keys. See \"General Tips\" below for design guidance based on anticipated data access patterns. Subsequent sections describe how to use secondary indexes, hints, and explain plans.",{"_12623":2956,"_48290":2919,"_18312":101790,"_5":17825,"_25222":2919,"_7710":101791},[48836],"Note: Phoenix and HBase work well when your application does point lookups and small range scans. This can be achieved by good primary key design (see below). If you find that your application requires many full table scans, then Phoenix and HBase are likely not the best tool for the job. Instead, look at using other tools that write to HDFS directly using columnar representations such as Parquet.",{"_12623":2957,"_48290":2919,"_18312":101793,"_5":17825,"_25222":101653,"_7710":101794},[48836],"The underlying row key design is the single most important factor in Phoenix performance, and it's important to get it right at design time because you cannot change it later without re-writing the data and index tables.",{"_12623":2958,"_48290":2919,"_18312":101796,"_5":17825,"_25222":101653,"_7710":101797},[48836],"The Phoenix primary keys are concatenated to create the underlying row key in Apache HBase. Choose and order primary key columns to align with common query patterns. The leading key column has the greatest performance impact. For example, if you lead with a column containing org IDs, it is easy to select all rows for a specific org. You can also add the HBase row timestamp to the primary key to improve scan efficiency by skipping rows outside the queried time range.",{"_12623":2959,"_48290":2919,"_18312":101799,"_5":17825,"_25222":101653,"_7710":101800},[48836],"Every primary key imposes a cost because the entire row key is appended to every piece of data in memory and on disk. The larger the row key, the greater the storage overhead. Find ways to store information compactly in columns you plan to use for primary keys — store deltas instead of complete time stamps, for example.",{"_12623":2960,"_48290":2919,"_18312":101802,"_5":17825,"_25222":101653,"_7710":101803},[48836],"To sum up, the best practice is to design primary keys to add up to a row key that lets you scan the smallest amount of data.",{"_12623":2961,"_48290":2919,"_18312":101805,"_5":17825,"_25222":101653,"_7710":101806},[48836],"Tip: When choosing primary keys, lead with the column you filter most frequently across the queries that are most important to optimize. If you use ORDER BY, make sure your PK columns match expressions in the ORDER BY clause.",{"_12623":2962,"_48290":2919,"_18312":101808,"_5":17825,"_25222":101657,"_7710":101809},[48836],"If your primary keys are monotonically increasing, use salting to help distribute writes across the cluster and improve parallelization. Example:",{"_12623":2963,"_48290":2919,"_18312":101811,"_5":17825,"_25222":101657,"_7710":101812},[48836],"CREATE TABLE … ( … ) SALT_BUCKETS = N",{"_12623":2964,"_48290":2919,"_18312":101814,"_5":17825,"_25222":101657,"_7710":101815},[48836],"For optimal performance the number of salt buckets should approximately equal the number of region servers. Do not salt automatically. Use salting only when experiencing hotspotting. The downside of salting is that it imposes a cost on read because when you want to query the data you have to run multiple queries to do a range scan.",{"_12623":2965,"_48290":2919,"_18312":101817,"_5":17825,"_25222":101661,"_7710":101818},[48836],"The following sections provide a few general tips for different access scenarios.",{"_12623":2966,"_48290":2919,"_18312":101820,"_5":17825,"_25222":101665,"_7710":101821},[48836],"As with any random read workloads, SSDs can improve performance because of their faster random seek time.",{"_12623":2967,"_48290":2919,"_18312":101823,"_5":17825,"_25222":101669,"_7710":101824},[48836],"For read-heavy data:",{"_12623":2968,"_48290":2919,"_18312":101826,"_5":17825,"_25222":101669,"_7710":101827},[48836],"Create global indexes. This will affect write speed depending on the number of columns included in an index because each index writes to its own separate table.",{"_12623":2969,"_48290":2919,"_18312":101829,"_5":17825,"_25222":101669,"_7710":101830},[48836],"Use multiple indexes to provide fast access to common queries.",{"_12623":2970,"_48290":2919,"_18312":101832,"_5":17825,"_25222":101669,"_7710":101833},[48836],"When specifying machines for HBase, do not skimp on cores; HBase needs them.",{"_12623":2971,"_48290":2919,"_18312":101835,"_5":17825,"_25222":101669,"_7710":101836},[48836],"For write-heavy data:",{"_12623":2972,"_48290":2919,"_18312":101838,"_5":17825,"_25222":101669,"_7710":101839},[48836],"Pre-split the table. It can be helpful to split the table into predefined regions, or if keys are monotonically increasing, use salting to avoid creating write hotspots on a small number of nodes. Use real data types rather than raw byte data.",{"_12623":2973,"_48290":2919,"_18312":101841,"_5":17825,"_25222":101669,"_7710":101842},[48836],"Create local indexes. Reads from local indexes have a performance penalty, so it's important to do performance testing. See the Pherf tool.",{"_12623":2974,"_48290":2919,"_18312":101844,"_5":17825,"_25222":101673,"_7710":101845},[48836],"Choose commonly-queried columns as primary keys. For more information, see “Primary Keys” below.",{"_12623":2975,"_48290":2919,"_18312":101847,"_5":17825,"_25222":101673,"_7710":101848},[48836],"Create additional indexes to support common query patterns, including heavily accessed fields that are not in the primary key.",{"_12623":2976,"_48290":2919,"_18312":101850,"_5":17825,"_25222":101677,"_7710":101851},[48836],"If the data is immutable or append-only, declare the table and its indexes as immutable using the IMMUTABLE_ROWS option at creation time to reduce the write-time cost. If you need to make an existing table immutable, you can do so with ALTER TABLE trans.event SET IMMUTABLE_ROWS=true after creation time.",{"_12623":2977,"_48290":2919,"_18312":101853,"_5":17825,"_25222":101677,"_7710":101854},[48836],"If speed is more important than data integrity, you can use the DISABLE_WAL option. Note: it is possible to lose data with DISABLE_WAL if a region server fails.",{"_12623":2978,"_48290":2919,"_18312":101856,"_5":17825,"_25222":101677,"_7710":101857},[48836],"Set the UPDATE_CACHE_FREQUENCY option to 15 minutes or so if your metadata doesn't change very often. This property determines how often an RPC is done to ensure you're seeing the latest schema.",{"_12623":2979,"_48290":2919,"_18312":101859,"_5":17825,"_25222":101677,"_7710":101860},[48836],"If the data is not sparse (over 50% of the cells have values), use the SINGLE_CELL_ARRAY_WITH_OFFSETS data encoding scheme introduced in Phoenix 4.10, which obtains faster performance by reducing the size of the data. For more information, see “Column Mapping and Immutable Data Encoding” on the Apache Phoenix blog.",{"_12623":2980,"_48290":2919,"_18312":101862,"_5":17825,"_25222":101681,"_7710":101863},[48836],"Use the ASYNC keyword with your CREATE INDEX call to create the index asynchronously via MapReduce job. You'll need to manually start the job; see Index Population for details.",{"_12623":2981,"_48290":2919,"_18312":101865,"_5":17825,"_25222":101681,"_7710":101866},[48836],"If the data is too large to scan the table completely, use primary keys to create an underlying composite row key that makes it easy to return a subset of the data or facilitates skip-scanning — Phoenix can jump directly to matching keys when the query includes key sets in the predicate.",{"_12623":2982,"_48290":2919,"_18312":101868,"_5":17825,"_25222":101685,"_7710":101869},[48836],"A transaction is a data operation that is atomic — that is, guaranteed to succeed completely or not at all. For example, if you need to make cross-row updates to a data table, then you should consider your data transactional.",{"_12623":2983,"_48290":2919,"_18312":101871,"_5":17825,"_25222":101685,"_7710":101872},[48836],"If you need transactionality, use the TRANSACTIONAL option. (See also Transactions)",{"_12623":2984,"_48290":2919,"_18312":101874,"_5":17825,"_25222":101689,"_7710":101875},[48836],"Using compression or encoding is a must. Both SNAPPY and FAST_DIFF are good all around options.",{"_12623":2985,"_48290":2919,"_18312":101877,"_5":17825,"_25222":101689,"_7710":101878},[48836],"FAST_DIFF encoding is automatically enabled on all Phoenix tables by default, and almost always improves overall read latencies and throughput by allowing more data to fit into blockcache. Note: FAST_DIFF encoding can increase garbage produced during request processing.",{"_12623":2986,"_48290":2919,"_18312":101880,"_5":17825,"_25222":101689,"_7710":101881},[48836],"Set encoding at table creation time. Example:\n CREATE TABLE … ( … ) DATA_BLOCK_ENCODING=‘FAST_DIFF’",{"_12623":2987,"_48290":2919,"_18312":101883,"_5":17825,"_25222":101693,"_7710":101884},[48836],"Because the schema affects the way the data is written to the underlying HBase layer, Phoenix performance relies on the design of your tables, indexes, and primary keys.",{"_12623":2988,"_48290":2919,"_18312":101886,"_5":17825,"_25222":101697,"_7710":101887},[48836],"HBase stores data in tables, which in turn contain columns grouped in column families. A row in an HBase table consists of versioned cells associated with one or more columns. An HBase row is a collection of many key-value pairs in which the rowkey attribute of the keys are equal. Data in an HBase table is sorted by the rowkey, and all access is via the rowkey.\nPhoenix creates a relational data model on top of HBase, enforcing a PRIMARY KEY constraint whose columns are concatenated to form the row key for the underlying HBase table. For this reason, it's important to be cognizant of the size and number of the columns you include in the PK constraint, because a copy of the row key is included with every cell in the underlying HBase table.",{"_12623":2989,"_48290":2919,"_18312":101889,"_5":17825,"_25222":101701,"_7710":101890},[48836],"If some columns are accessed more frequently than others, create multiple column families to separate the frequently-accessed columns from rarely-accessed columns. This improves performance because HBase reads only the column families specified in the query.",{"_12623":2990,"_48290":2919,"_18312":101892,"_5":17825,"_25222":101705,"_7710":101893},[48836],"Here are a few tips that apply to columns in general, whether they are indexed or not:",{"_12623":2991,"_48290":2919,"_18312":101895,"_5":17825,"_25222":101705,"_7710":101896},[48836],"Keep VARCHAR columns under 1MB or so due to I/O costs. When processing queries, HBase materializes cells in full before sending them over to the client, and the client receives them in full before handing them off to the application code.",{"_12623":2992,"_48290":2919,"_18312":101898,"_5":17825,"_25222":101705,"_7710":101899},[48836],"For structured objects, don't use JSON, which is not very compact. Use a format such as protobuf, Avro, msgpack, or BSON.",{"_12623":2993,"_48290":2919,"_18312":101901,"_5":17825,"_25222":101705,"_7710":101902},[48836],"Consider compressing data before storage using a fast LZ variant to cut latency and I/O costs.",{"_12623":2994,"_48290":2919,"_18312":101904,"_5":17825,"_25222":101705,"_7710":101905},[48836],"Use the column mapping feature (added in Phoenix 4.10), which uses numerical HBase column qualifiers for non-PK columns instead of directly using column names. This improves performance when looking for a cell in the sorted list of cells returned by HBase, adds further across-the-board performance by reducing the disk size used by tables, and speeds up DDL operations like column rename and metadata-level column drops. For more information, see “Column Mapping and Immutable Data Encoding” on the Apache Phoenix blog.",{"_12623":2995,"_48290":2919,"_18312":101907,"_5":17825,"_25222":101709,"_7710":101908},[48836],"A Phoenix index is a physical table that stores a pivoted copy of some or all of the data in the main table to serve specific query patterns. When you issue a query, Phoenix automatically selects the best index. The primary index is created automatically based on selected primary keys. You can create secondary indexes by specifying included columns based on expected query patterns.",{"_12623":2996,"_48290":2919,"_18312":101910,"_5":17825,"_25222":101709,"_7710":101911},[48836],"See also:\nSecondary Indexing",{"_12623":2997,"_48290":2919,"_18312":101913,"_5":17825,"_25222":101713,"_7710":101914},[48836],"Secondary indexes can improve read performance by turning what would normally be a full table scan into a point lookup (at the cost of storage space and write speed). Secondary indexes can be added or removed after table creation and don't require changes to existing queries – queries simply run faster. A small number of secondary indexes is often sufficient. Depending on your needs, consider creating covered indexes or functional indexes, or both.",{"_12623":2998,"_48290":2919,"_18312":101916,"_5":17825,"_25222":101713,"_7710":101917},[48836],"If your table is large, use ASYNC with CREATE INDEX to create indexes asynchronously. In this case, index build runs through MapReduce, so client restarts will not impact index creation and jobs can be retried automatically if needed. You still need to start the job manually, and then monitor it like any other MapReduce job.",{"_12623":2999,"_48290":2919,"_18312":101919,"_5":17825,"_25222":101713,"_7710":94470},[48836],{"_12623":3000,"_48290":2919,"_18312":101921,"_5":17825,"_25222":101713,"_7710":101922},[48836],"See Index Population for details.",{"_12623":3001,"_48290":2919,"_18312":101924,"_5":17825,"_25222":101713,"_7710":101925},[48836],"If you cannot create the index asynchronously, increase query timeout (phoenix.query.timeoutMs) to exceed expected index build time. If CREATE INDEX times out or the client goes down before completion, the build stops and must be run again. You can monitor the index table during creation: new regions appear as splits occur. You can query SYSTEM.STATS (populated by splits/compactions), or run COUNT(*) against the index table (higher load because it requires a full scan).",{"_12623":3002,"_48290":2919,"_18312":101927,"_5":17825,"_25222":101713,"_7710":101928},[48836],"Tips:",{"_12623":3003,"_48290":2919,"_18312":101930,"_5":17825,"_25222":101713,"_7710":101931},[48836],"Create local indexes for write-heavy use cases.",{"_12623":3004,"_48290":2919,"_18312":101933,"_5":17825,"_25222":101713,"_7710":101934},[48836],"Create global indexes for read-heavy use cases. To save read-time overhead, consider creating covered indexes.",{"_12623":3005,"_48290":2919,"_18312":101936,"_5":17825,"_25222":101713,"_7710":101937},[48836],"If the primary key is monotonically increasing, create salt buckets. The salt buckets can't be changed later, so design them to handle future growth. Salt buckets help avoid write hotspots, but can decrease overall throughput due to the additional scans needed on read.",{"_12623":3006,"_48290":2919,"_18312":101939,"_5":17825,"_25222":101713,"_7710":101940},[48836],"Set up a cron job to build indexes. Use ASYNC with CREATE INDEX to avoid blocking.",{"_12623":3007,"_48290":2919,"_18312":101942,"_5":17825,"_25222":101713,"_7710":101943},[48836],"Only create the indexes you need.",{"_12623":3008,"_48290":2919,"_18312":101945,"_5":17825,"_25222":101713,"_7710":101946},[48836],"Limit the number of indexes on frequently updated tables.",{"_12623":3009,"_48290":2919,"_18312":101948,"_5":17825,"_25222":101713,"_7710":101949},[48836],"Use covered indexes to convert table scans into efficient point lookups or range queries over the index table instead of the primary table:",{"_12623":3010,"_48290":2919,"_18312":101951,"_5":17825,"_25222":101717,"_7710":101952},[48836],"It's important to know which queries execute on the server side versus client side, because this affects performance due to network I/O and other bottlenecks. If you're querying a billion-row table, you want as much computation as possible on the server side instead of transmitting rows to the client. Some queries must still execute on the client. Sorting data that resides on multiple region servers, for example, requires aggregation and re-sort on the client.",{"_12623":3011,"_48290":2919,"_18312":101954,"_5":17825,"_25222":101721,"_7710":101955},[48836],"Avoid joins unless one side is small, especially on frequent queries. For larger joins, see “Hints,” below.",{"_12623":3012,"_48290":2919,"_18312":101957,"_5":17825,"_25222":101721,"_7710":101958},[48836],"In the WHERE clause, filter leading columns in the primary key constraint.",{"_12623":3013,"_48290":2919,"_18312":101960,"_5":17825,"_25222":101721,"_7710":101961},[48836],"Filtering the first leading column with IN or OR in the WHERE clause enables skip scan optimizations.",{"_12623":3014,"_48290":2919,"_18312":101963,"_5":17825,"_25222":101721,"_7710":101964},[48836],"Equality or comparisons (< or >) in the WHERE clause enable range-scan optimizations.",{"_12623":3015,"_48290":2919,"_18312":101966,"_5":17825,"_25222":101721,"_7710":101967},[48836],"Let Phoenix optimize query parallelism using statistics. This provides an automatic benefit if using Phoenix 4.2 or greater in production.",{"_12623":3016,"_48290":2919,"_18312":101969,"_5":17825,"_25222":101721,"_7710":101970},[48836],"See also: Joins",{"_12623":3017,"_48290":2919,"_18312":101972,"_5":17825,"_25222":101725,"_7710":101973},[48836],"If you regularly scan large data sets from spinning disk, you're best off with GZIP (but watch write speed). Use a lot of cores for a scan to utilize the available memory bandwidth. Apache Phoenix makes it easy to utilize many cores to increase scan performance.",{"_12623":3018,"_48290":2919,"_18312":101975,"_5":17825,"_25222":101725,"_7710":101976},[48836],"For range queries, the HBase block cache does not provide much advantage.",{"_12623":3019,"_48290":2919,"_18312":101978,"_5":17825,"_25222":101729,"_7710":101979},[48836],"For large range queries, consider setting Scan.setCacheBlocks(false) even if the whole scan could fit into the block cache.",{"_12623":3020,"_48290":2919,"_18312":101981,"_5":17825,"_25222":101729,"_7710":101982},[48836],"If you mostly perform large range queries you might even want to consider running HBase with a much smaller heap and size the block cache down, to only rely on the OS Cache. This will alleviate some garbage collection related issues.",{"_12623":3021,"_48290":2919,"_18312":101984,"_5":17825,"_25222":101733,"_7710":101985},[48836],"For point lookups it is quite important to have your data set cached, and you should use the HBase block cache.",{"_12623":3022,"_48290":2919,"_18312":101987,"_5":17825,"_25222":101737,"_7710":101988},[48836],"Hints let you override default query processing behavior and specify such factors as which index to use, what type of scan to perform, and what type of join to use.",{"_12623":3023,"_48290":2919,"_18312":101990,"_5":17825,"_25222":101737,"_7710":101991},[48836],"During the query, Hint global index if you want to force it when query includes a column not in the index.",{"_12623":3024,"_48290":2919,"_18312":101993,"_5":17825,"_25222":101737,"_7710":101994},[48836],"If necessary, you can do bigger joins with the /*+ USE_SORT_MERGE_JOIN */ hint, but a big join will be an expensive operation over huge numbers of rows.",{"_12623":3025,"_48290":2919,"_18312":101996,"_5":17825,"_25222":101737,"_7710":101997},[48836],"If the overall size of all right-hand-side tables would exceed the memory size limit, use the /*+ NO_STAR_JOIN */ hint.",{"_12623":3026,"_48290":2919,"_18312":101999,"_5":17825,"_25222":101737,"_7710":102000},[48836],"See also: Hint.",{"_12623":3027,"_48290":2919,"_18312":102002,"_5":17825,"_25222":101741,"_7710":102003},[48836],"An EXPLAIN plan tells you a lot about how a query will be run. To generate an explain plan run this query and to interpret the plan, see this reference.",{"_12623":3028,"_48290":2919,"_18312":102005,"_5":17825,"_25222":101745,"_7710":102006},[48836],"You can improve parallelization with the UPDATE STATISTICS command. This command subdivides each region by determining keys called guideposts that are equidistant from each other, then uses these guideposts to break up queries into multiple parallel scans.\nStatistics are turned on by default. With Phoenix 4.9, the user can set guidepost width for each table. Optimal guidepost width depends on a number of factors such as cluster size, cluster usage, number of cores per node, table size, and disk I/O.",{"_12623":3029,"_48290":2919,"_18312":102008,"_5":17825,"_25222":101745,"_7710":102009},[48836],"In Phoenix 4.12, configuration phoenix.use.stats.parallelization was added to control whether statistics are used to drive parallelization. Stats collection can still run regardless. Collected information is also used to estimate bytes and rows scanned when generating EXPLAIN.",{"_12623":3030,"_48290":2919,"_18312":102011,"_5":17825,"_25222":101752,"_7710":102012},[48836],"When using UPSERT VALUES to write a large number of records, turn off autocommit and batch records in reasonably small batches (try 100 rows and adjust from there to fine-tune performance).",{"_12623":3031,"_48290":2919,"_18312":102014,"_5":17825,"_25222":101752,"_7710":102015},[48836],"Note: With the default fat driver, executeBatch() does not provide benefit. Instead, update multiple rows by executing UPSERT VALUES multiple times and then use commit() to submit the batch. With the thin driver, however, use executeBatch() to minimize RPCs between the client and query server.",{"_12623":3032,"_48290":2919,"_18312":102017,"_5":17825,"_25222":101752,"_7710":102018},[48836],"Note: Because the Phoenix client keeps uncommitted rows in memory, be careful not to set commitSize too high.",{"_12623":3033,"_48290":2919,"_18312":102020,"_5":17825,"_25222":101756,"_7710":102021},[48836],"When using UPSERT SELECT to write many rows in a single statement, turn on autocommit and the rows will be automatically batched according to the phoenix.mutate.batchSize. This will minimize the amount of data returned back to the client and is the most efficient means of updating many rows.",{"_12623":3034,"_48290":2919,"_18312":102023,"_5":17825,"_25222":101760,"_7710":102024},[48836],"When deleting a large data set, turn on autoCommit before issuing the DELETE query so that the client does not need to remember the row keys of all the keys as they are deleted. This prevents the client from buffering the rows affected by the DELETE so that Phoenix can delete them directly on the region servers without the expense of returning them to the client.",{"_12623":3035,"_48290":2919,"_18312":102026,"_5":17825,"_25222":101764,"_7710":102027},[48836],"To reduce RPC traffic, set UPDATE_CACHE_FREQUENCY (4.7 or above) on your tables and indexes when creating them (or via ALTER TABLE/ALTER INDEX). See Altering.",{"_12623":3036,"_48290":2919,"_18312":102029,"_5":17825,"_25222":101768,"_7710":102030},[48836],"If using 4.8, consider using local indexes to minimize the write time. In this case, the writes for the secondary index will be to the same region server as your base table. This approach does involve a performance hit on the read side, though, so make sure to quantify both write speed improvement and read speed reduction.",{"_12623":3037,"_48290":2919,"_18312":102032,"_5":17825,"_25222":101772,"_7710":102033},[48836],"For advice about tuning the underlying HBase and JVM layers, see Operational and Performance Configuration Options in the Apache HBase™ Reference Guide.",{"_12623":3038,"_48290":2919,"_18312":102035,"_5":17825,"_25222":101776,"_7710":102036},[48836],"The following sections provide Phoenix-specific additions to the tuning recommendations in the Apache HBase™ Reference Guide section referenced above.",{"_12623":3039,"_48290":2919,"_18312":102038,"_5":17825,"_25222":101780,"_7710":102039},[48836],"In addition to the HBase tuning referenced above, set phoenix.query.timeoutMs in hbase-site.xml on the client side to the maximum tolerable wait time in milliseconds.",{"_12623":3040,"_48290":2919,"_18312":102041,"_5":17825,"_25222":101784,"_7710":102042},[48836],"In addition to the HBase tuning referenced above, set phoenix.connection.consistency = timeline in hbase-site.xml on the client side for all connections.",{"_12623":3041,"_48290":3041,"_5":13058,"_7710":102044,"_48807":102045,"_18312":102046,"_25222":3041},"SQL Grammar",[92880,92881,92994],[48836],{"_12623":3042,"_48290":3041,"_18312":102048,"_5":17825,"_25222":3041,"_7710":102049},[48836],"SQL command and grammar reference for Apache Phoenix — SELECT, UPSERT, CREATE TABLE, indexes, and more.",{"_12623":3043,"_48290":3041,"_5":48804,"_18312":102051,"_25222":102052,"_7710":102053},[48836],"/docs/grammar#commands","Commands",{"_12623":3044,"_48290":3041,"_5":48804,"_18312":102055,"_25222":102056,"_7710":102057},[48836],"/docs/grammar#select","SELECT",{"_12623":3045,"_48290":3041,"_5":48804,"_18312":102059,"_25222":102060,"_7710":102061},[48836],"/docs/grammar#upsert-values","UPSERT VALUES",{"_12623":3046,"_48290":3041,"_5":48804,"_18312":102063,"_25222":102064,"_7710":102065},[48836],"/docs/grammar#upsert-select","UPSERT SELECT",{"_12623":3047,"_48290":3041,"_5":48804,"_18312":102067,"_25222":102068,"_7710":102069},[48836],"/docs/grammar#delete","DELETE",{"_12623":3048,"_48290":3041,"_5":48804,"_18312":102071,"_25222":102072,"_7710":102073},[48836],"/docs/grammar#declare-cursor","DECLARE CURSOR",{"_12623":3049,"_48290":3041,"_5":48804,"_18312":102075,"_25222":102076,"_7710":102077},[48836],"/docs/grammar#open-cursor","OPEN CURSOR",{"_12623":3050,"_48290":3041,"_5":48804,"_18312":102079,"_25222":102080,"_7710":102081},[48836],"/docs/grammar#fetch-next","FETCH NEXT",{"_12623":3051,"_48290":3041,"_5":48804,"_18312":102083,"_25222":102084,"_7710":102085},[48836],"/docs/grammar#close","CLOSE",{"_12623":3052,"_48290":3041,"_5":48804,"_18312":102087,"_25222":102088,"_7710":102089},[48836],"/docs/grammar#create-table","CREATE TABLE",{"_12623":3053,"_48290":3041,"_5":48804,"_18312":102091,"_25222":102092,"_7710":102093},[48836],"/docs/grammar#drop-table","DROP TABLE",{"_12623":3054,"_48290":3041,"_5":48804,"_18312":102095,"_25222":102096,"_7710":102097},[48836],"/docs/grammar#create-function","CREATE FUNCTION",{"_12623":3055,"_48290":3041,"_5":48804,"_18312":102099,"_25222":102100,"_7710":102101},[48836],"/docs/grammar#drop-function","DROP FUNCTION",{"_12623":3056,"_48290":3041,"_5":48804,"_18312":102103,"_25222":102104,"_7710":102105},[48836],"/docs/grammar#create-view","CREATE VIEW",{"_12623":3057,"_48290":3041,"_5":48804,"_18312":102107,"_25222":102108,"_7710":102109},[48836],"/docs/grammar#drop-view","DROP VIEW",{"_12623":3058,"_48290":3041,"_5":48804,"_18312":102111,"_25222":102112,"_7710":102113},[48836],"/docs/grammar#create-sequence","CREATE SEQUENCE",{"_12623":3059,"_48290":3041,"_5":48804,"_18312":102115,"_25222":102116,"_7710":102117},[48836],"/docs/grammar#drop-sequence","DROP SEQUENCE",{"_12623":3060,"_48290":3041,"_5":48804,"_18312":102119,"_25222":102120,"_7710":102121},[48836],"/docs/grammar#alter","ALTER",{"_12623":3061,"_48290":3041,"_5":48804,"_18312":102123,"_25222":102124,"_7710":102125},[48836],"/docs/grammar#create-index","CREATE INDEX",{"_12623":3062,"_48290":3041,"_5":48804,"_18312":102127,"_25222":102128,"_7710":102129},[48836],"/docs/grammar#drop-index","DROP INDEX",{"_12623":3063,"_48290":3041,"_5":48804,"_18312":102131,"_25222":102132,"_7710":102133},[48836],"/docs/grammar#alter-index","ALTER INDEX",{"_12623":3064,"_48290":3041,"_5":48804,"_18312":102135,"_25222":102136,"_7710":102137},[48836],"/docs/grammar#explain","EXPLAIN",{"_12623":3065,"_48290":3041,"_5":48804,"_18312":102139,"_25222":102140,"_7710":102141},[48836],"/docs/grammar#update-statistics","UPDATE STATISTICS",{"_12623":3066,"_48290":3041,"_5":48804,"_18312":102143,"_25222":102144,"_7710":96394},[48836],"/docs/grammar#create-schema",{"_12623":3067,"_48290":3041,"_5":48804,"_18312":102146,"_25222":102147,"_7710":102148},[48836],"/docs/grammar#use","USE",{"_12623":3068,"_48290":3041,"_5":48804,"_18312":102150,"_25222":102151,"_7710":96400},[48836],"/docs/grammar#drop-schema",{"_12623":3069,"_48290":3041,"_5":48804,"_18312":102153,"_25222":102154,"_7710":102155},[48836],"/docs/grammar#grant","GRANT",{"_12623":3070,"_48290":3041,"_5":48804,"_18312":102157,"_25222":102158,"_7710":102159},[48836],"/docs/grammar#revoke","REVOKE",{"_12623":3071,"_48290":3041,"_5":48804,"_18312":102161,"_25222":102162,"_7710":102163},[48836],"/docs/grammar#other-grammar","Other Grammar",{"_12623":3072,"_48290":3041,"_5":48804,"_18312":102165,"_25222":102166,"_7710":102167},[48836],"/docs/grammar#constraint","Constraint",{"_12623":3073,"_48290":3041,"_5":48804,"_18312":102169,"_25222":102170,"_7710":102171},[48836],"/docs/grammar#options","Options",{"_12623":3074,"_48290":3041,"_5":48804,"_18312":102173,"_25222":102174,"_7710":102175},[48836],"/docs/grammar#hint","Hint",{"_12623":3075,"_48290":3041,"_5":48804,"_18312":102177,"_25222":102178,"_7710":102179},[48836],"/docs/grammar#scan-hint","Scan Hint",{"_12623":3076,"_48290":3041,"_5":48804,"_18312":102181,"_25222":102182,"_7710":102183},[48836],"/docs/grammar#cache-hint","Cache Hint",{"_12623":3077,"_48290":3041,"_5":48804,"_18312":102185,"_25222":102186,"_7710":102187},[48836],"/docs/grammar#index-hint","Index Hint",{"_12623":3078,"_48290":3041,"_5":48804,"_18312":102189,"_25222":102190,"_7710":102191},[48836],"/docs/grammar#small-hint","Small Hint",{"_12623":3079,"_48290":3041,"_5":48804,"_18312":102193,"_25222":102194,"_7710":102195},[48836],"/docs/grammar#seek-to-column-hint","Seek To Column Hint",{"_12623":3080,"_48290":3041,"_5":48804,"_18312":102197,"_25222":102198,"_7710":102199},[48836],"/docs/grammar#join-hint","Join Hint",{"_12623":3081,"_48290":3041,"_5":48804,"_18312":102201,"_25222":102202,"_7710":102203},[48836],"/docs/grammar#serial-hint","Serial Hint",{"_12623":3082,"_48290":3041,"_5":48804,"_18312":102205,"_25222":102206,"_7710":102207},[48836],"/docs/grammar#column-def","Column Def",{"_12623":3083,"_48290":3041,"_5":48804,"_18312":102209,"_25222":102210,"_7710":102211},[48836],"/docs/grammar#table-ref","Table Ref",{"_12623":3084,"_48290":3041,"_5":48804,"_18312":102213,"_25222":102214,"_7710":102215},[48836],"/docs/grammar#sequence-ref","Sequence Ref",{"_12623":3085,"_48290":3041,"_5":48804,"_18312":102217,"_25222":102218,"_7710":102219},[48836],"/docs/grammar#column-ref","Column Ref",{"_12623":3086,"_48290":3041,"_5":48804,"_18312":102221,"_25222":102222,"_7710":102223},[48836],"/docs/grammar#select-expression","Select Expression",{"_12623":3087,"_48290":3041,"_5":48804,"_18312":102225,"_25222":102226,"_7710":102227},[48836],"/docs/grammar#select-statement","Select Statement",{"_12623":3088,"_48290":3041,"_5":48804,"_18312":102229,"_25222":102230,"_7710":102231},[48836],"/docs/grammar#split-point","Split Point",{"_12623":3089,"_48290":3041,"_5":48804,"_18312":102233,"_25222":102234,"_7710":102235},[48836],"/docs/grammar#table-spec","Table Spec",{"_12623":3090,"_48290":3041,"_5":48804,"_18312":102237,"_25222":102238,"_7710":102239},[48836],"/docs/grammar#aliased-table-ref","Aliased Table Ref",{"_12623":3091,"_48290":3041,"_5":48804,"_18312":102241,"_25222":102242,"_7710":102243},[48836],"/docs/grammar#join-type","Join Type",{"_12623":3092,"_48290":3041,"_5":48804,"_18312":102245,"_25222":102246,"_7710":102247},[48836],"/docs/grammar#func-argument","Func Argument",{"_12623":3093,"_48290":3041,"_5":48804,"_18312":102249,"_25222":102250,"_7710":102251},[48836],"/docs/grammar#class-name","Class Name",{"_12623":3094,"_48290":3041,"_5":48804,"_18312":102253,"_25222":102254,"_7710":102255},[48836],"/docs/grammar#jar-path","Jar Path",{"_12623":3095,"_48290":3041,"_5":48804,"_18312":102257,"_25222":102258,"_7710":102259},[48836],"/docs/grammar#order","Order",{"_12623":3096,"_48290":3041,"_5":48804,"_18312":102261,"_25222":102262,"_7710":102263},[48836],"/docs/grammar#expression","Expression",{"_12623":3097,"_48290":3041,"_5":48804,"_18312":102265,"_25222":102266,"_7710":102267},[48836],"/docs/grammar#and-condition","And Condition",{"_12623":3098,"_48290":3041,"_5":48804,"_18312":102269,"_25222":102270,"_7710":102271},[48836],"/docs/grammar#boolean-condition","Boolean Condition",{"_12623":3099,"_48290":3041,"_5":48804,"_18312":102273,"_25222":102274,"_7710":102275},[48836],"/docs/grammar#condition","Condition",{"_12623":3100,"_48290":3041,"_5":48804,"_18312":102277,"_25222":102278,"_7710":102279},[48836],"/docs/grammar#rhs-operand","RHS Operand",{"_12623":3101,"_48290":3041,"_5":48804,"_18312":102281,"_25222":102282,"_7710":102283},[48836],"/docs/grammar#operand","Operand",{"_12623":3102,"_48290":3041,"_5":48804,"_18312":102285,"_25222":102286,"_7710":102287},[48836],"/docs/grammar#summand","Summand",{"_12623":3103,"_48290":3041,"_5":48804,"_18312":102289,"_25222":102290,"_7710":102291},[48836],"/docs/grammar#factor","Factor",{"_12623":3104,"_48290":3041,"_5":48804,"_18312":102293,"_25222":102294,"_7710":102295},[48836],"/docs/grammar#term","Term",{"_12623":3105,"_48290":3041,"_5":48804,"_18312":102297,"_25222":102298,"_7710":102299},[48836],"/docs/grammar#array-constructor","Array Constructor",{"_12623":3106,"_48290":3041,"_5":48804,"_18312":102301,"_25222":102302,"_7710":102303},[48836],"/docs/grammar#sequence","Sequence",{"_12623":3107,"_48290":3041,"_5":48804,"_18312":102305,"_25222":102306,"_7710":102307},[48836],"/docs/grammar#cast","Cast",{"_12623":3108,"_48290":3041,"_5":48804,"_18312":102309,"_25222":102310,"_7710":102311},[48836],"/docs/grammar#row-value-constructor","Row Value Constructor",{"_12623":3109,"_48290":3041,"_5":48804,"_18312":102313,"_25222":102314,"_7710":102315},[48836],"/docs/grammar#bind-parameter","Bind Parameter",{"_12623":3110,"_48290":3041,"_5":48804,"_18312":102317,"_25222":102318,"_7710":102319},[48836],"/docs/grammar#value","Value",{"_12623":3111,"_48290":3041,"_5":48804,"_18312":102321,"_25222":102322,"_7710":102323},[48836],"/docs/grammar#case","Case",{"_12623":3112,"_48290":3041,"_5":48804,"_18312":102325,"_25222":102326,"_7710":102327},[48836],"/docs/grammar#case-when","Case When",{"_12623":3113,"_48290":3041,"_5":48804,"_18312":102329,"_25222":102330,"_7710":102331},[48836],"/docs/grammar#name","Name",{"_12623":3114,"_48290":3041,"_5":48804,"_18312":102333,"_25222":102334,"_7710":102335},[48836],"/docs/grammar#quoted-name","Quoted Name",{"_12623":3115,"_48290":3041,"_5":48804,"_18312":102337,"_25222":102338,"_7710":102339},[48836],"/docs/grammar#alias","Alias",{"_12623":3116,"_48290":3041,"_5":48804,"_18312":102341,"_25222":102342,"_7710":102343},[48836],"/docs/grammar#null","Null",{"_12623":3117,"_48290":3041,"_5":48804,"_18312":102345,"_25222":102346,"_7710":102347},[48836],"/docs/grammar#data-type","Data Type",{"_12623":3118,"_48290":3041,"_5":48804,"_18312":102349,"_25222":102350,"_7710":102351},[48836],"/docs/grammar#sql-data-type","SQL Data Type",{"_12623":3119,"_48290":3041,"_5":48804,"_18312":102353,"_25222":102354,"_7710":102355},[48836],"/docs/grammar#hbase-data-type","HBase Data Type",{"_12623":3120,"_48290":3041,"_5":48804,"_18312":102357,"_25222":102358,"_7710":102359},[48836],"/docs/grammar#string","String",{"_12623":3121,"_48290":3041,"_5":48804,"_18312":102361,"_25222":102362,"_7710":102363},[48836],"/docs/grammar#boolean","Boolean",{"_12623":3122,"_48290":3041,"_5":48804,"_18312":102365,"_25222":102366,"_7710":102367},[48836],"/docs/grammar#numeric","Numeric",{"_12623":3123,"_48290":3041,"_5":48804,"_18312":102369,"_25222":102370,"_7710":102371},[48836],"/docs/grammar#int","Int",{"_12623":3124,"_48290":3041,"_5":48804,"_18312":102373,"_25222":102374,"_7710":96780},[48836],"/docs/grammar#long",{"_12623":3125,"_48290":3041,"_5":48804,"_18312":102376,"_25222":102377,"_7710":102378},[48836],"/docs/grammar#decimal","Decimal",{"_12623":3126,"_48290":3041,"_5":48804,"_18312":102380,"_25222":102381,"_7710":102382},[48836],"/docs/grammar#number","Number",{"_12623":3127,"_48290":3041,"_5":48804,"_18312":102384,"_25222":102385,"_7710":102386},[48836],"/docs/grammar#comments","Comments",{"_12623":3128,"_48290":3041,"_18312":102388,"_5":17825,"_25222":102056,"_7710":102389},[48836],"Selects data from one or more tables. UNION ALL combines rows from multiple select statements. ORDER BY sorts the result based on the given expressions. LIMIT (or FETCH FIRST) limits the number of rows returned by the query with no limit applied if unspecified or specified as null or less than zero. The LIMIT (or FETCH FIRST) clause is executed after the ORDER BY clause to support top-N type queries. OFFSET clause skips that many rows before beginning to return rows. An optional hint may be used to override decisions made by the query optimizer.",{"_12623":3129,"_48290":3041,"_18312":102391,"_5":17825,"_25222":102056,"_7710":93959},[48836],{"_12623":3130,"_48290":3041,"_18312":102393,"_5":17825,"_25222":102060,"_7710":102394},[48836],"Inserts if not present and updates otherwise the value in the table. The list of columns is optional and if not present, the values will map to the column in the order they are declared in the schema. The values must evaluate to constants.",{"_12623":3131,"_48290":3041,"_18312":102396,"_5":17825,"_25222":102060,"_7710":102397},[48836],"Use the ON DUPLICATE KEY clause (available in Phoenix 4.9) if you need the UPSERT to be atomic. Performance will be slower in this case as the row needs to be read on the server side when the commit is done. Use IGNORE if you do not want the UPSERT performed if the row already exists. Otherwise, with UPDATE, the expression will be evaluated and the result used to set the column, for example to perform an atomic increment. An UPSERT to the same row in the same commit batch will be processed in the order of execution.",{"_12623":3132,"_48290":3041,"_18312":102399,"_5":17825,"_25222":102060,"_7710":93959},[48836],{"_12623":3133,"_48290":3041,"_18312":102401,"_5":17825,"_25222":102064,"_7710":102402},[48836],"Inserts if not present and updates otherwise rows in the table based on the results of running another query. The values are set based on their matching position between the source and target tables. The list of columns is optional and if not present will map to the column in the order they are declared in the schema. If auto commit is on, and both a) the target table matches the source table, and b) the select performs no aggregation, then the population of the target table will be done completely on the server-side (with constraint violations logged, but otherwise ignored). Otherwise, data is buffered on the client and, if auto commit is on, committed in row batches as specified by the UpsertBatchSize connection property (or the phoenix.mutate.upsertBatchSize HBase config property which defaults to 10000 rows)",{"_12623":3134,"_48290":3041,"_18312":102404,"_5":17825,"_25222":102064,"_7710":93959},[48836],{"_12623":3135,"_48290":3041,"_18312":102406,"_5":17825,"_25222":102068,"_7710":102407},[48836],"Deletes the rows selected by the where clause. If auto commit is on, the deletion is performed completely server-side.",{"_12623":3136,"_48290":3041,"_18312":102409,"_5":17825,"_25222":102068,"_7710":93959},[48836],{"_12623":3137,"_48290":3041,"_18312":102411,"_5":17825,"_25222":102072,"_7710":102412},[48836],"Creates a cursor for the select statement",{"_12623":3138,"_48290":3041,"_18312":102414,"_5":17825,"_25222":102072,"_7710":93959},[48836],{"_12623":3139,"_48290":3041,"_18312":102416,"_5":17825,"_25222":102076,"_7710":102417},[48836],"Opens already declared cursor to perform FETCH operations",{"_12623":3140,"_48290":3041,"_18312":102419,"_5":17825,"_25222":102076,"_7710":93959},[48836],{"_12623":3141,"_48290":3041,"_18312":102421,"_5":17825,"_25222":102080,"_7710":102422},[48836],"Retrieves next or next n rows from already opened cursor",{"_12623":3142,"_48290":3041,"_18312":102424,"_5":17825,"_25222":102080,"_7710":93959},[48836],{"_12623":3143,"_48290":3041,"_18312":102426,"_5":17825,"_25222":102084,"_7710":102427},[48836],"Closes an already open cursor",{"_12623":3144,"_48290":3041,"_18312":102429,"_5":17825,"_25222":102084,"_7710":93959},[48836],{"_12623":3145,"_48290":3041,"_18312":102431,"_5":17825,"_25222":102088,"_7710":102432},[48836],"Creates a new table. The HBase table and any column families referenced are created if they don't already exist. All table, column family and column names are uppercased unless they are double quoted in which case they are case sensitive. Column families that exist in the HBase table but are not listed are ignored. At create time, to improve query performance, an empty key value is added to the first column family of any existing rows or the default column family if no column families are explicitly defined. Upserts will also add this empty key value. This improves query performance by having a key value column we can guarantee always being there and thus minimizing the amount of data that must be projected and subsequently returned back to the client. HBase table and column configuration options may be passed through as key/value pairs to configure the HBase table as desired. Note that when using the IF NOT EXISTS clause, if a table already exists, then no change will be made to it. Additionally, no validation is done to check whether the existing table metadata matches the proposed table metadata. so it's better to use DROP TABLE followed by CREATE TABLE if the table metadata may be changing.",{"_12623":3146,"_48290":3041,"_18312":102434,"_5":17825,"_25222":102088,"_7710":93959},[48836],{"_12623":3147,"_48290":3041,"_18312":102436,"_5":17825,"_25222":102092,"_7710":102437},[48836],"Drops a table. The optional CASCADE keyword causes any views on the table to be dropped as well. When dropping a table, by default the underlying HBase data and index tables are dropped. The phoenix.schema.dropMetaData may be used to override this and keep the HBase table for point-in-time queries.",{"_12623":3148,"_48290":3041,"_18312":102439,"_5":17825,"_25222":102092,"_7710":93959},[48836],{"_12623":3149,"_48290":3041,"_18312":102441,"_5":17825,"_25222":102096,"_7710":102442},[48836],"Creates a new function. The function name is uppercased unless they are double quoted in which case they are case sensitive. The function accepts zero or more arguments. The class name and jar path should be in single quotes. The jar path is optional and if not specified then the class name will be loaded from the jars present in directory configured for hbase.dynamic.jars.dir.",{"_12623":3150,"_48290":3041,"_18312":102444,"_5":17825,"_25222":102096,"_7710":93959},[48836],{"_12623":3151,"_48290":3041,"_18312":102446,"_5":17825,"_25222":102100,"_7710":102447},[48836],"Drops a function.",{"_12623":3152,"_48290":3041,"_18312":102449,"_5":17825,"_25222":102100,"_7710":93959},[48836],{"_12623":3153,"_48290":3041,"_18312":102451,"_5":17825,"_25222":102104,"_7710":102452},[48836],"Creates a new view over an existing HBase or Phoenix table. As expected, the WHERE expression is always automatically applied to any query run against the view. As with CREATE TABLE, the table, column family, and column names are uppercased unless they are double quoted. The newTableRef may refer directly to an HBase table, in which case, the table, column family, and column names must match the existing metadata exactly or an exception will occur. When a view is mapped directly to an HBase table, no empty key value will be added to rows and the view will be read-only. A view will be updatable (i.e. referenceable in a DML statement such as UPSERT or DELETE) if its WHERE clause expression contains only simple equality expressions separated by ANDs. Updatable views are not required to set the columns which appear in the equality expressions, as the equality expressions define the default values for those columns. If they are set, then they must match the value used in the WHERE clause, or an error will occur. All columns from the existingTableRef are included as columns in the new view as are columns defined in the columnDef list. An ALTER VIEW statement may be issued against a view to remove or add columns, however, no changes may be made to the primary key constraint. In addition, columns referenced in the WHERE clause are not allowed to be removed. Once a view is created for a table, that table may no longer altered or dropped until all of its views have been dropped.",{"_12623":3154,"_48290":3041,"_18312":102454,"_5":17825,"_25222":102104,"_7710":93959},[48836],{"_12623":3155,"_48290":3041,"_18312":102456,"_5":17825,"_25222":102108,"_7710":102457},[48836],"Drops a view. The optional CASCADE keyword causes any views derived from the view to be dropped as well. When dropping a view, the actual table data is not affected. However, index data for the view will be deleted.",{"_12623":3156,"_48290":3041,"_18312":102459,"_5":17825,"_25222":102108,"_7710":93959},[48836],{"_12623":3157,"_48290":3041,"_18312":102461,"_5":17825,"_25222":102112,"_7710":102462},[48836],"Creates a monotonically increasing sequence. START controls the initial sequence value while INCREMENT controls by how much the sequence is incremented after each call to NEXT VALUE FOR. By default, the sequence will start with 1 and be incremented by 1. Specify CYCLE to indicate that the sequence should continue to generate values after reaching either its MINVALUE or MAXVALUE. After an ascending sequence reaches its MAXVALUE, it generates its MINVALUE. After a descending sequence reaches its MINVALUE, it generates its MAXVALUE. CACHE controls how many sequence values will be reserved from the server, cached on the client, and doled out as need by subsequent NEXT VALUE FOR calls for that client connection to the cluster to save on RPC calls. If not specified, the phoenix.sequence.cacheSize config parameter defaulting to 100 will be used for the CACHE value.",{"_12623":3158,"_48290":3041,"_18312":102464,"_5":17825,"_25222":102112,"_7710":93959},[48836],{"_12623":3159,"_48290":3041,"_18312":102466,"_5":17825,"_25222":102116,"_7710":102467},[48836],"Drops a sequence.",{"_12623":3160,"_48290":3041,"_18312":102469,"_5":17825,"_25222":102116,"_7710":93959},[48836],{"_12623":3161,"_48290":3041,"_18312":102471,"_5":17825,"_25222":102120,"_7710":102472},[48836],"Alters an existing table by adding or removing columns or updating table options. When a column is dropped from a table, the data in that column is deleted as well. PK columns may not be dropped, and only nullable PK columns may be added. For a view, the data is not affected when a column is dropped. Note that creating or dropping columns only affects subsequent queries and data modifications. Snapshot queries that are connected at an earlier timestamp will still use the prior schema that was in place when the data was written.",{"_12623":3162,"_48290":3041,"_18312":102474,"_5":17825,"_25222":102120,"_7710":93959},[48836],{"_12623":3163,"_48290":3041,"_18312":102476,"_5":17825,"_25222":102124,"_7710":102477},[48836],"Creates a new secondary index on a table or view. The index will be automatically kept in sync with the table as the data changes. At query time, the optimizer will use the index if it contains all columns referenced in the query and produces the most efficient execution plan. If a table has rows that are write-once and append-only, then the table may set the IMMUTABLE_ROWS property to true (either up-front in the CREATE TABLE statement or afterwards in an ALTER TABLE statement). This reduces the overhead at write time to maintain the index. Otherwise, if this property is not set on the table, then incremental index maintenance will be performed on the server side when the data changes. As of the 4.3 release, functional indexes are supported which allow arbitrary expressions rather than solely column names to be indexed. As of the 4.4.0 release, you can specify the ASYNC keyword to create the index using a map reduce job.",{"_12623":3164,"_48290":3041,"_18312":102479,"_5":17825,"_25222":102124,"_7710":93959},[48836],{"_12623":3165,"_48290":3041,"_18312":102481,"_5":17825,"_25222":102128,"_7710":102482},[48836],"Drops an index from a table. When dropping an index, the data in the index is deleted. Note that since metadata is versioned, snapshot queries connecting at an earlier time stamp may still use the index, as the HBase table backing the index is not deleted.",{"_12623":3166,"_48290":3041,"_18312":102484,"_5":17825,"_25222":102128,"_7710":93959},[48836],{"_12623":3167,"_48290":3041,"_18312":102486,"_5":17825,"_25222":102132,"_7710":102487},[48836],"Alters the state of an existing index.  DISABLE will cause the no further index maintenance to be performed on the index and it will no longer be considered for use in queries. REBUILD will completely rebuild the index and upon completion will enable the index to be used in queries again. UNUSABLE will cause the index to no longer be considered for use in queries, however index maintenance will continue to be performed. USABLE will cause the index to again be considered for use in queries. Note that a disabled index must be rebuild and cannot be set as USABLE.",{"_12623":3168,"_48290":3041,"_18312":102489,"_5":17825,"_25222":102132,"_7710":93959},[48836],{"_12623":3169,"_48290":3041,"_18312":102491,"_5":17825,"_25222":102136,"_7710":102492},[48836],"Computes the logical steps necessary to execute the given command. Each step is represented as a string in a single column result set row.",{"_12623":3170,"_48290":3041,"_18312":102494,"_5":17825,"_25222":102136,"_7710":93959},[48836],{"_12623":3171,"_48290":3041,"_18312":102496,"_5":17825,"_25222":102140,"_7710":102497},[48836],"Updates the statistics on the table and by default all of its associated index tables. To only update the table, use the COLUMNS option and to only update the INDEX, use the INDEX option. The statistics for a single index may also be updated by using its full index name for the tableRef. The default guidepost properties may be overridden by specifying their values after the SET keyword. Note that when a major compaction occurs, the default guidepost properties will be used again.",{"_12623":3172,"_48290":3041,"_18312":102499,"_5":17825,"_25222":102140,"_7710":93959},[48836],{"_12623":3173,"_48290":3041,"_18312":102501,"_5":17825,"_25222":102144,"_7710":102502},[48836],"creates a schema and corresponding name-space in hbase. To enable namespace mapping, see namespace mapping",{"_12623":3174,"_48290":3041,"_18312":102504,"_5":17825,"_25222":102144,"_7710":102505},[48836],"User that execute this command should have admin permissions to create namespace in HBase.",{"_12623":3175,"_48290":3041,"_18312":102507,"_5":17825,"_25222":102144,"_7710":93959},[48836],{"_12623":3176,"_48290":3041,"_18312":102509,"_5":17825,"_25222":102147,"_7710":102510},[48836],"Sets a default schema for the connection and is used as a target schema for all statements issued from the connection that do not specify schema name explicitly. USE DEFAULT unset the schema for the connection so that no schema will be used for the statements issued from the connection.",{"_12623":3177,"_48290":3041,"_18312":102512,"_5":17825,"_25222":102147,"_7710":102513},[48836],"schemaName should already be existed for the USE SCHEMA statement to succeed. see CREATE SCHEMA for creating schema.",{"_12623":3178,"_48290":3041,"_18312":102515,"_5":17825,"_25222":102147,"_7710":93959},[48836],{"_12623":3179,"_48290":3041,"_18312":102517,"_5":17825,"_25222":102151,"_7710":102518},[48836],"Drops a schema and corresponding name-space from hbase. To enable namespace mapping, see namespace mapping",{"_12623":3180,"_48290":3041,"_18312":102520,"_5":17825,"_25222":102151,"_7710":102521},[48836],"This statement succeed only when schema doesn't hold any tables.",{"_12623":3181,"_48290":3041,"_18312":102523,"_5":17825,"_25222":102151,"_7710":93959},[48836],{"_12623":3182,"_48290":3041,"_18312":102525,"_5":17825,"_25222":102154,"_7710":102526},[48836],"Grant permissions at table, schema or user level. Permissions are managed by HBase in hbase:acl table, hence access controls need to be enabled. This feature will be available from Phoenix 4.14 version onwards.",{"_12623":3183,"_48290":3041,"_18312":102528,"_5":17825,"_25222":102154,"_7710":102529},[48836],"Possible permissions are R - Read, W - Write, X - Execute, C - Create and A - Admin. To enable/disable access controls, see https://hbase.apache.org/docs/security/data-access#how-it-works",{"_12623":3184,"_48290":3041,"_18312":102531,"_5":17825,"_25222":102154,"_7710":102532},[48836],"Permissions should be granted on base tables. It will be propagated to all its indexes and views. Group permissions are applicable to all users in the group and schema permissions are applicable to all tables with that schema. Grant statements without table/schema specified are assigned at GLOBAL level.",{"_12623":3185,"_48290":3041,"_18312":102534,"_5":17825,"_25222":102154,"_7710":102535},[48836],"Phoenix doesn't expose Execute('X') functionality to end users. However, it is required for mutable tables with secondary indexes.",{"_12623":3186,"_48290":3041,"_18312":102537,"_5":17825,"_25222":102154,"_7710":102538},[48836],"Important Note:",{"_12623":3187,"_48290":3041,"_18312":102540,"_5":17825,"_25222":102154,"_7710":102541},[48836],"Every user requires 'RX' permissions on all Phoenix SYSTEM tables in order to work correctly. Users also require 'RWX' permissions on SYSTEM.SEQUENCE table for using SEQUENCES.",{"_12623":3188,"_48290":3041,"_18312":102543,"_5":17825,"_25222":102154,"_7710":93959},[48836],{"_12623":3189,"_48290":3041,"_18312":102545,"_5":17825,"_25222":102158,"_7710":102546},[48836],"Revoke permissions at table, schema or user level. Permissions are managed by HBase in hbase:acl table, hence access controls need to be enabled. This feature will be available from Phoenix 4.14 version onwards.",{"_12623":3190,"_48290":3041,"_18312":102548,"_5":17825,"_25222":102158,"_7710":102549},[48836],"To enable/disable access controls, see https://hbase.apache.org/docs/security/data-access#how-it-works",{"_12623":3191,"_48290":3041,"_18312":102551,"_5":17825,"_25222":102158,"_7710":102552},[48836],"Group permissions are applicable to all users in the group and schema permissions are applicable to all tables with that schema. Permissions should be revoked on base tables. It will be propagated to all its indexes and views. Revoke statements without table/schema specified are assigned at GLOBAL level.",{"_12623":3192,"_48290":3041,"_18312":102554,"_5":17825,"_25222":102158,"_7710":102555},[48836],"Revoke removes all the permissions at that level.",{"_12623":3193,"_48290":3041,"_18312":102557,"_5":17825,"_25222":102158,"_7710":102538},[48836],{"_12623":3194,"_48290":3041,"_18312":102559,"_5":17825,"_25222":102158,"_7710":102560},[48836],"Revoke permissions needs to be exactly at the same level as permissions assigned via GRANT permissions statement. Level refers to table, schema or user. Revoking any of 'RX' permissions on any Phoenix SYSTEM tables will cause exceptions. Revoking any of 'RWX' permissions on SYSTEM.SEQUENCE will cause exceptions while accessing sequences.",{"_12623":3195,"_48290":3041,"_18312":102562,"_5":17825,"_25222":102158,"_7710":102563},[48836],"The examples below are for revoking permissions granted using the examples from GRANT statement above.",{"_12623":3196,"_48290":3041,"_18312":102565,"_5":17825,"_25222":102158,"_7710":93959},[48836],{"_12623":3197,"_48290":3041,"_18312":102567,"_5":17825,"_25222":102166,"_7710":102568},[48836],"Defines a multi-part primary key constraint. Each column may be declared to be sorted in ascending or descending ordering. The default is ascending. One primary key column can also be designated as ROW_TIMESTAMP provided it is of one of the types: BIGINT, UNSIGNED_LONG, DATE, TIME and TIMESTAMP.",{"_12623":3198,"_48290":3041,"_18312":102570,"_5":17825,"_25222":102166,"_7710":93959},[48836],{"_12623":3199,"_48290":3041,"_18312":102572,"_5":17825,"_25222":102170,"_7710":102573},[48836],"Sets a built-in Phoenix table property or an HBase table or column descriptor metadata attribute. The name is case insensitive. If the name is a known HColumnDescriptor attribute, then the value is applied to the specified column family or, if omitted, to all column families. Otherwise, the HBase metadata attribute value is applied to the HTableDescriptor. Note that no validation is performed on the property name or value, so unknown or misspelled options will end up as adhoc metadata attributes values on the HBase table.",{"_12623":3200,"_48290":3041,"_18312":102575,"_5":17825,"_25222":102170,"_7710":102576},[48836],"Built-in Phoenix table options include:",{"_12623":3201,"_48290":3041,"_18312":102578,"_5":17825,"_25222":102170,"_7710":102579},[48836],"SALT_BUCKETS numeric property causes an extra byte to be transparently prepended to every row key to ensure an evenly distributed read and write load across all region servers. This is especially useful when your row key is always monotonically increasing and causing hot spotting on a single region server. However, even if it's not, it often improves performance by ensuring an even distribution of data across your cluster.  The byte is determined by hashing the row key and modding it with the SALT_BUCKETS value. The value may be from 0 to 256, with 0 being a special means of turning salting off for an index in which the data table is salted (since by default an index has the same number of salt buckets as its data table). If split points are not defined for the table, the table will automatically be pre-split at each possible salt bucket value. For more information, see salted tables",{"_12623":3202,"_48290":3041,"_18312":102581,"_5":17825,"_25222":102170,"_7710":102582},[48836],"DISABLE_WAL boolean option when true causes HBase not to write data to the write-ahead-log, thus making updates faster at the expense of potentially losing data in the event of a region server failure. This option is useful when updating a table which is not the source-of-truth and thus making the lose of data acceptable.",{"_12623":3203,"_48290":3041,"_18312":102584,"_5":17825,"_25222":102170,"_7710":102585},[48836],"IMMUTABLE_ROWS boolean option when true declares that your table has rows which are write-once, append-only (i.e. the same row is never updated). With this option set, indexes added to the table are managed completely on the client-side, with no need to perform incremental index maintenance, thus improving performance. Deletes of rows in immutable tables are allowed with some restrictions if there are indexes on the table. Namely, the WHERE clause may not filter on columns not contained by every index. Upserts are expected to never update an existing row (failure to follow this will result in invalid indexes). For more information, see secondary indexing",{"_12623":3204,"_48290":3041,"_18312":102587,"_5":17825,"_25222":102170,"_7710":102588},[48836],"MULTI_TENANT boolean option when true enables views to be created over the table across different tenants. This option is useful to share the same physical HBase table across many different tenants. For more information, see multi-tenancy",{"_12623":3205,"_48290":3041,"_18312":102590,"_5":17825,"_25222":102170,"_7710":102591},[48836],"DEFAULT_COLUMN_FAMILY string option determines the column family used used when none is specified. The value is case sensitive. If this option is not present, a column family name of '0' is used.",{"_12623":3206,"_48290":3041,"_18312":102593,"_5":17825,"_25222":102170,"_7710":102594},[48836],"STORE_NULLS boolean option (available as of Phoenix 4.3) determines whether or not null values should be explicitly stored in HBase. This option is generally only useful if a table is configured to store multiple versions in order to facilitate doing flashback queries (i.e. queries to look at the state of a record in the past).",{"_12623":3207,"_48290":3041,"_18312":102596,"_5":17825,"_25222":102170,"_7710":102597},[48836],"TRANSACTIONAL option (available as of Phoenix 4.7) determines whether a table (and its secondary indexes) are tranactional. The default value is FALSE, but may be overridden with the phoenix.table.istransactional.default property. A table may be altered to become transactional, but it cannot be transitioned back to be non transactional. For more information on transactions, see transactions",{"_12623":3208,"_48290":3041,"_18312":102599,"_5":17825,"_25222":102170,"_7710":102600},[48836],"UPDATE_CACHE_FREQUENCY option (available as of Phoenix 4.7) determines how often the server will be checked for meta data updates (for example, the addition or removal of a table column or the updates of table statistics). Possible values are ALWAYS (the default), NEVER, and a millisecond numeric value. An ALWAYS value will cause the client to check with the server each time a statement is executed that references a table (or once per commit for an UPSERT VALUES statement).  A millisecond value indicates how long the client will hold on to its cached version of the metadata before checking back with the server for updates.",{"_12623":3209,"_48290":3041,"_18312":102602,"_5":17825,"_25222":102170,"_7710":102603},[48836],"APPEND_ONLY_SCHEMA boolean option (available as of Phoenix 4.8) when true declares that columns will only be added but never removed from a table. With this option set we can prevent the RPC from the client to the server to fetch the table metadata when the client already has all columns declared in a CREATE TABLE/VIEW IF NOT EXISTS statement.",{"_12623":3210,"_48290":3041,"_18312":102605,"_5":17825,"_25222":102170,"_7710":102606},[48836],"AUTO_PARTITION_SEQ string option (available as of Phoenix 4.8) when set on a base table determines the sequence used to automatically generate a WHERE clause with the first PK column and the unique identifier from the sequence for child views. With this option set, we prevent allocating a sequence in the event that the view already exists.",{"_12623":3211,"_48290":3041,"_18312":102608,"_5":17825,"_25222":102170,"_7710":102609},[48836],"The GUIDE_POSTS_WIDTH option (available as of Phoenix 4.9) enables specifying a different guidepost width per table. The guidepost width determines the byte sized chunk of work over which a query will be parallelized. A value of 0 means that no guideposts should be collected for the table. A value of null removes any table specific guidepost setting, causing the global server-side phoenix.stats.guidepost.width config parameter to be used again. For more information, see the Statistics Collection page.",{"_12623":3212,"_48290":3041,"_18312":102611,"_5":17825,"_25222":102170,"_7710":93959},[48836],{"_12623":3213,"_48290":3041,"_18312":102613,"_5":17825,"_25222":102174,"_7710":102614},[48836],"An advanced features that overrides default query processing behavior for decisions such as whether to use a range scan versus skip scan and an index versus no index. Note that strict parsing is not done on hints. If hints are misspelled or invalid, they are silently ignored.",{"_12623":3214,"_48290":3041,"_18312":102616,"_5":17825,"_25222":102174,"_7710":93959},[48836],{"_12623":3215,"_48290":3041,"_18312":102618,"_5":17825,"_25222":102178,"_7710":102619},[48836],"Use the SKIP_SCAN hint to force a skip scan to be performed on the query when it otherwise would not be. This option may improve performance if a query does not include the leading primary key column, but does include other, very selective primary key columns.",{"_12623":3216,"_48290":3041,"_18312":102621,"_5":17825,"_25222":102178,"_7710":102622},[48836],"Use the RANGE_SCAN hint to force a range scan to be performed on the query. This option may improve performance if a query filters on a range for non selective leading primary key column along with other primary key columns",{"_12623":3217,"_48290":3041,"_18312":102624,"_5":17825,"_25222":102178,"_7710":93959},[48836],{"_12623":3218,"_48290":3041,"_18312":102626,"_5":17825,"_25222":102182,"_7710":102627},[48836],"Use the NO_CACHE hint to prevent the results of the query from populating the HBase block cache. This is useful in situation where you're doing a full table scan and know that it's unlikely that the rows being returned will be queried again.",{"_12623":3219,"_48290":3041,"_18312":102629,"_5":17825,"_25222":102182,"_7710":93959},[48836],{"_12623":3220,"_48290":3041,"_18312":102631,"_5":17825,"_25222":102186,"_7710":102632},[48836],"Use the INDEX(<table_name> <index_name>...) to suggest which index to use for a given query. Double quotes may be used to surround a table_name and/or index_name to make them case sensitive. As of the 4.3 release, this will force an index to be used, even if it doesn't contain all referenced columns, by joining back to the data table to retrieve any columns not contained by the index.",{"_12623":3221,"_48290":3041,"_18312":102634,"_5":17825,"_25222":102186,"_7710":102635},[48836],"Use the NO_INDEX hint to force the data table to be used for a query.",{"_12623":3222,"_48290":3041,"_18312":102637,"_5":17825,"_25222":102186,"_7710":102638},[48836],"Use the USE_INDEX_OVER_DATA_TABLE hint to act as a tiebreaker for choosing the index table over the data table when all other criteria are equal. Note that this is the default optimizer decision.",{"_12623":3223,"_48290":3041,"_18312":102640,"_5":17825,"_25222":102186,"_7710":102641},[48836],"Use the USE_DATA_OVER_INDEX_TABLE hint to act as a tiebreaker for choosing the data table over the index table when all other criteria are equal.",{"_12623":3224,"_48290":3041,"_18312":102643,"_5":17825,"_25222":102186,"_7710":93959},[48836],{"_12623":3225,"_48290":3041,"_18312":102645,"_5":17825,"_25222":102190,"_7710":102646},[48836],"Use the SMALL hint to reduce the number of RPCs done between the client and server when a query is executed. Generally, if the query is a point lookup or returns data that is likely in a single data block (64 KB by default), performance may improve when using this hint.",{"_12623":3226,"_48290":3041,"_18312":102648,"_5":17825,"_25222":102190,"_7710":93959},[48836],{"_12623":3227,"_48290":3041,"_18312":102650,"_5":17825,"_25222":102194,"_7710":102651},[48836],"Use the SEEK_TO_COLUMN hint to force the server to seek to navigate between columns instead of doing a next. If there are many versions of the same column value or if there are many columns between the columns that are projected, then this may be more efficient.",{"_12623":3228,"_48290":3041,"_18312":102653,"_5":17825,"_25222":102194,"_7710":102654},[48836],"Use the NO_SEEK_TO_COLUMN hint to force the server to do a next to navigate between columns instead of a seek. If there are few versions of the same column value or if the columns that are projected are adjacent to each other, then this may be more efficient.",{"_12623":3229,"_48290":3041,"_18312":102656,"_5":17825,"_25222":102194,"_7710":93959},[48836],{"_12623":3230,"_48290":3041,"_18312":102658,"_5":17825,"_25222":102198,"_7710":102659},[48836],"Use the USE_SORT_MERGE_JOIN hint to force the optimizer to use a sort merge join instead of a broadcast hash join when both sides of the join are bigger than will fit in the server-side memory. Currently the optimizer will not make this determination itself, so this hint is required to override the default behavior of using a hash join.",{"_12623":3231,"_48290":3041,"_18312":102661,"_5":17825,"_25222":102198,"_7710":102662},[48836],"Use the NO_STAR_JOIN hint to prevent the optimizer from using the star join query to broadcast the results of the querying one common table to all region servers. This is useful when the results of the querying the one common table is too large and would likely be substantially filtered when joined against one or more of the other joined tables.",{"_12623":3232,"_48290":3041,"_18312":102664,"_5":17825,"_25222":102198,"_7710":102665},[48836],"Use the NO_CHILD_PARENT_JOIN_OPTIMIZATION hint to prevent the optimizer from doing point lookups between a child table (such as a secondary index) and a parent table (such as the data table) for a correlated subquery.",{"_12623":3233,"_48290":3041,"_18312":102667,"_5":17825,"_25222":102198,"_7710":93959},[48836],{"_12623":3234,"_48290":3041,"_18312":102669,"_5":17825,"_25222":102202,"_7710":102670},[48836],"Use the SERIAL hint to force a query to be executed serially as opposed to being parallelized along the guideposts and region boundaries.",{"_12623":3235,"_48290":3041,"_18312":102672,"_5":17825,"_25222":102202,"_7710":93959},[48836],{"_12623":3236,"_48290":3041,"_18312":102674,"_5":17825,"_25222":102206,"_7710":102675},[48836],"Define a new primary key column. The column name is case insensitive by default and case sensitive if double quoted. The sort order of a primary key may be ascending (ASC) or descending (DESC). The default is ascending. You may also specify a default value (Phoenix 4.9 or above) for the column with a constant expression. If the column is the only column that forms the primary key, then it can be designated as ROW_TIMESTAMP column provided its data type is one of these: BIGINT, UNSIGNED_LONG, DATE, TIME and TIMESTAMP.",{"_12623":3237,"_48290":3041,"_18312":102677,"_5":17825,"_25222":102206,"_7710":93959},[48836],{"_12623":3238,"_48290":3041,"_18312":102679,"_5":17825,"_25222":102210,"_7710":102680},[48836],"References a table or view with an optional schema name qualifier",{"_12623":3239,"_48290":3041,"_18312":102682,"_5":17825,"_25222":102210,"_7710":93959},[48836],{"_12623":3240,"_48290":3041,"_18312":102684,"_5":17825,"_25222":102214,"_7710":102685},[48836],"References a sequence with an optional schema name qualifier",{"_12623":3241,"_48290":3041,"_18312":102687,"_5":17825,"_25222":102214,"_7710":93959},[48836],{"_12623":3242,"_48290":3041,"_18312":102689,"_5":17825,"_25222":102218,"_7710":102690},[48836],"References a column with an optional family name qualifier",{"_12623":3243,"_48290":3041,"_18312":102692,"_5":17825,"_25222":102218,"_7710":93959},[48836],{"_12623":3244,"_48290":3041,"_18312":102694,"_5":17825,"_25222":102222,"_7710":102695},[48836],"An expression in a SELECT statement. All columns in a table may be selected using , and all columns in a column family may be selected using <familyName>..",{"_12623":3245,"_48290":3041,"_18312":102697,"_5":17825,"_25222":102222,"_7710":93959},[48836],{"_12623":3246,"_48290":3041,"_18312":102699,"_5":17825,"_25222":102226,"_7710":102700},[48836],"Selects data from a table. DISTINCT filters out duplicate results while ALL, the default, includes all results. FROM identifies the table being queried. Columns may be dynamically defined in parenthesis after the table name and then used in the query. Joins are processed in reverse order through a broadcast hash join mechanism. For best performance, order tables from largest to smallest in terms of how many rows you expect to be used from each table. GROUP BY groups the result by the given expression(s). HAVING filters rows after grouping. An optional hint may be used to override decisions made by the query optimizer.",{"_12623":3247,"_48290":3041,"_18312":102702,"_5":17825,"_25222":102226,"_7710":93959},[48836],{"_12623":3248,"_48290":3041,"_18312":102704,"_5":17825,"_25222":102230,"_7710":102705},[48836],"Defines a split point for a table. Use a bind parameter with preparedStatement.setBinary(int,byte[]) to supply arbitrary bytes.",{"_12623":3249,"_48290":3041,"_18312":102707,"_5":17825,"_25222":102230,"_7710":93959},[48836],{"_12623":3250,"_48290":3041,"_18312":102709,"_5":17825,"_25222":102234,"_7710":102710},[48836],"An optionally aliased table reference, or an optionally aliased select statement in paranthesis.",{"_12623":3251,"_48290":3041,"_18312":102712,"_5":17825,"_25222":102234,"_7710":93959},[48836],{"_12623":3252,"_48290":3041,"_18312":102714,"_5":17825,"_25222":102238,"_7710":102715},[48836],"A reference to an optionally aliased table optionally followed by dynamic column definitions.",{"_12623":3253,"_48290":3041,"_18312":102717,"_5":17825,"_25222":102238,"_7710":93959},[48836],{"_12623":3254,"_48290":3041,"_18312":102719,"_5":17825,"_25222":102242,"_7710":102720},[48836],"The type of join",{"_12623":3255,"_48290":3041,"_18312":102722,"_5":17825,"_25222":102242,"_7710":93959},[48836],{"_12623":3256,"_48290":3041,"_18312":102724,"_5":17825,"_25222":102246,"_7710":102725},[48836],"The function argument is sql data type. It can be constant and also we can provide default,min and max values for the argument in single quotes.",{"_12623":3257,"_48290":3041,"_18312":102727,"_5":17825,"_25222":102246,"_7710":93959},[48836],{"_12623":3258,"_48290":3041,"_18312":102729,"_5":17825,"_25222":102250,"_7710":102730},[48836],"Canonical class name in single quotes.",{"_12623":3259,"_48290":3041,"_18312":102732,"_5":17825,"_25222":102250,"_7710":93959},[48836],{"_12623":3260,"_48290":3041,"_18312":102734,"_5":17825,"_25222":102254,"_7710":102735},[48836],"Hdfs path of jar in single quotes.",{"_12623":3261,"_48290":3041,"_18312":102737,"_5":17825,"_25222":102254,"_7710":93959},[48836],{"_12623":3262,"_48290":3041,"_18312":102739,"_5":17825,"_25222":102258,"_7710":102740},[48836],"Sorts the result by an expression.",{"_12623":3263,"_48290":3041,"_18312":102742,"_5":17825,"_25222":102258,"_7710":93959},[48836],{"_12623":3264,"_48290":3041,"_18312":102744,"_5":17825,"_25222":102262,"_7710":102745},[48836],"Value or condition.",{"_12623":3265,"_48290":3041,"_18312":102747,"_5":17825,"_25222":102262,"_7710":93959},[48836],{"_12623":3266,"_48290":3041,"_18312":102749,"_5":17825,"_25222":102266,"_7710":102750},[48836],"Condition separated by AND.",{"_12623":3267,"_48290":3041,"_18312":102752,"_5":17825,"_25222":102266,"_7710":93959},[48836],{"_12623":3268,"_48290":3041,"_18312":102754,"_5":17825,"_25222":102270,"_7710":102755},[48836],"Boolean condition.",{"_12623":3269,"_48290":3041,"_18312":102757,"_5":17825,"_25222":102270,"_7710":93959},[48836],{"_12623":3270,"_48290":3041,"_18312":102759,"_5":17825,"_25222":102274,"_7710":102760},[48836],"Boolean value or condition. When comparing with LIKE, the wildcards characters are \"\" (any one character) and \"%\" (any characters). ILIKE is the same, but the search is case insensitive. To search for the characters \"%\" and \"\", the characters need to be escaped. The escape character is \" \\ \" (backslash). Patterns that end with an escape character are invalid and the expression returns NULL. BETWEEN does an inclusive comparison for both operands.",{"_12623":3271,"_48290":3041,"_18312":102762,"_5":17825,"_25222":102274,"_7710":93959},[48836],{"_12623":3272,"_48290":3041,"_18312":102764,"_5":17825,"_25222":102278,"_7710":102765},[48836],"Right-hand side operand",{"_12623":3273,"_48290":3041,"_18312":102767,"_5":17825,"_25222":102278,"_7710":93959},[48836],{"_12623":3274,"_48290":3041,"_18312":102769,"_5":17825,"_25222":102282,"_7710":102770},[48836],"A string concatenation.",{"_12623":3275,"_48290":3041,"_18312":102772,"_5":17825,"_25222":102282,"_7710":93959},[48836],{"_12623":3276,"_48290":3041,"_18312":102774,"_5":17825,"_25222":102286,"_7710":102775},[48836],"An addition or subtraction of numeric or date type values",{"_12623":3277,"_48290":3041,"_18312":102777,"_5":17825,"_25222":102286,"_7710":93959},[48836],{"_12623":3278,"_48290":3041,"_18312":102779,"_5":17825,"_25222":102290,"_7710":102780},[48836],"A multiplication, division, or modulus of numeric type values.",{"_12623":3279,"_48290":3041,"_18312":102782,"_5":17825,"_25222":102290,"_7710":93959},[48836],{"_12623":3280,"_48290":3041,"_18312":102784,"_5":17825,"_25222":102294,"_7710":102785},[48836],"A term which may use subscript notation if it's an array.",{"_12623":3281,"_48290":3041,"_18312":102787,"_5":17825,"_25222":102294,"_7710":93959},[48836],{"_12623":3282,"_48290":3041,"_18312":102789,"_5":17825,"_25222":102298,"_7710":102790},[48836],"Constructs an ARRAY out of the list of expressions.",{"_12623":3283,"_48290":3041,"_18312":102792,"_5":17825,"_25222":102298,"_7710":93959},[48836],{"_12623":3284,"_48290":3041,"_18312":102794,"_5":17825,"_25222":102302,"_7710":102795},[48836],"Gets the CURRENT or NEXT value for a sequence, a monotonically incrementing BIGINT value. Each call to NEXT VALUE FOR increments the sequence value and returns the current value. The NEXT <n> VALUES syntax may be used to reserve <n> consecutive sequence values. A sequence is only increment once for a given statement, so multiple references to the same sequence by NEXT VALUE FOR produce the same value. Use CURRENT VALUE FOR to access the last sequence allocated with NEXT VALUE FOR for cluster connection of your client. If no NEXT VALUE FOR had been previously called, an error will occur. These calls are only allowed in the SELECT expressions or UPSERT VALUES expressions.",{"_12623":3285,"_48290":3041,"_18312":102797,"_5":17825,"_25222":102302,"_7710":93959},[48836],{"_12623":3286,"_48290":3041,"_18312":102799,"_5":17825,"_25222":102306,"_7710":102800},[48836],"The CAST operator coerces the given expression to a different dataType. This is useful, for example, to convert a BIGINT or INTEGER to a DECIMAL or DOUBLE to prevent truncation to a whole number during arithmetic operations. It is also useful to coerce from a more precise type to a less precise type since this type of coercion will not automatically occur, for example from a TIMESTAMP to a DATE. If the coercion is not possible, an error will occur.",{"_12623":3287,"_48290":3041,"_18312":102802,"_5":17825,"_25222":102306,"_7710":93959},[48836],{"_12623":3288,"_48290":3041,"_18312":102804,"_5":17825,"_25222":102310,"_7710":102805},[48836],"A row value constructor is a list of other terms which are treated together as a kind of composite structure. They may be compared to each other or to other other terms. The main use case is 1) to enable efficiently stepping through a set of rows in support of query-more type functionality, or 2) to allow IN clause to perform point gets on composite row keys.",{"_12623":3289,"_48290":3041,"_18312":102807,"_5":17825,"_25222":102310,"_7710":93959},[48836],{"_12623":3290,"_48290":3041,"_18312":102809,"_5":17825,"_25222":102314,"_7710":102810},[48836],"A parameters can be indexed, for example \":1\" meaning the first parameter.",{"_12623":3291,"_48290":3041,"_18312":102812,"_5":17825,"_25222":102314,"_7710":93959},[48836],{"_12623":3292,"_48290":3041,"_18312":102814,"_5":17825,"_25222":102318,"_7710":102815},[48836],"A literal value of any data type, or null.",{"_12623":3293,"_48290":3041,"_18312":102817,"_5":17825,"_25222":102318,"_7710":93959},[48836],{"_12623":3294,"_48290":3041,"_18312":102819,"_5":17825,"_25222":102322,"_7710":102820},[48836],"Returns the first expression where the value is equal to the test expression. If no else part is specified, return NULL.",{"_12623":3295,"_48290":3041,"_18312":102822,"_5":17825,"_25222":102322,"_7710":93959},[48836],{"_12623":3296,"_48290":3041,"_18312":102824,"_5":17825,"_25222":102326,"_7710":102825},[48836],"Returns the first expression where the condition is true. If no else part is specified, return NULL.",{"_12623":3297,"_48290":3041,"_18312":102827,"_5":17825,"_25222":102326,"_7710":93959},[48836],{"_12623":3298,"_48290":3041,"_18312":102829,"_5":17825,"_25222":102330,"_7710":102830},[48836],"Unquoted names are not case sensitive. There is no maximum name length.",{"_12623":3299,"_48290":3041,"_18312":102832,"_5":17825,"_25222":102330,"_7710":93959},[48836],{"_12623":3300,"_48290":3041,"_18312":102834,"_5":17825,"_25222":102334,"_7710":102835},[48836],"Quoted names are case sensitive, and can contain spaces. There is no maximum name length. Two double quotes can be used to create a single double quote inside an identifier.",{"_12623":3301,"_48290":3041,"_18312":102837,"_5":17825,"_25222":102334,"_7710":93959},[48836],{"_12623":3302,"_48290":3041,"_18312":102839,"_5":17825,"_25222":102338,"_7710":102840},[48836],"An alias is a name that is only valid in the context of the statement.",{"_12623":3303,"_48290":3041,"_18312":102842,"_5":17825,"_25222":102338,"_7710":93959},[48836],{"_12623":3304,"_48290":3041,"_18312":102844,"_5":17825,"_25222":102342,"_7710":102845},[48836],"NULL is a value without data type and means 'unknown value'.",{"_12623":3305,"_48290":3041,"_18312":102847,"_5":17825,"_25222":102342,"_7710":93959},[48836],{"_12623":3306,"_48290":3041,"_18312":102849,"_5":17825,"_25222":102346,"_7710":102850},[48836],"A type name optionally declared as an array. An array is mapped to \"java.sql.Array\". Only single dimension arrays are supported and varbinary arrays are not allowed.",{"_12623":3307,"_48290":3041,"_18312":102852,"_5":17825,"_25222":102346,"_7710":93959},[48836],{"_12623":3308,"_48290":3041,"_18312":102854,"_5":17825,"_25222":102350,"_7710":102855},[48836],"A standard SQL data type.",{"_12623":3309,"_48290":3041,"_18312":102857,"_5":17825,"_25222":102350,"_7710":93959},[48836],{"_12623":3310,"_48290":3041,"_18312":102859,"_5":17825,"_25222":102354,"_7710":102860},[48836],"A type that maps to a native primitive HBase value serialized through the Bytes.toBytes() utility methods. Only positive values are allowed.",{"_12623":3311,"_48290":3041,"_18312":102862,"_5":17825,"_25222":102354,"_7710":93959},[48836],{"_12623":3312,"_48290":3041,"_18312":102864,"_5":17825,"_25222":102358,"_7710":102865},[48836],"A string starts and ends with a single quote. Two single quotes can be used to create a single quote inside a string.",{"_12623":3313,"_48290":3041,"_18312":102867,"_5":17825,"_25222":102358,"_7710":93959},[48836],{"_12623":3314,"_48290":3041,"_18312":102869,"_5":17825,"_25222":102362,"_7710":102870},[48836],"A boolean value.",{"_12623":3315,"_48290":3041,"_18312":102872,"_5":17825,"_25222":102362,"_7710":93959},[48836],{"_12623":3316,"_48290":3041,"_18312":102874,"_5":17825,"_25222":102366,"_7710":102875},[48836],"The data type of a numeric value is always the lowest possible for the given value. If the number contains a dot this is decimal; otherwise it is int, long, or decimal (depending on the value).",{"_12623":3317,"_48290":3041,"_18312":102877,"_5":17825,"_25222":102366,"_7710":93959},[48836],{"_12623":3318,"_48290":3041,"_18312":102879,"_5":17825,"_25222":102370,"_7710":102880},[48836],"The maximum integer number is 2147483647, the minimum is -2147483648.",{"_12623":3319,"_48290":3041,"_18312":102882,"_5":17825,"_25222":102370,"_7710":93959},[48836],{"_12623":3320,"_48290":3041,"_18312":102884,"_5":17825,"_25222":102374,"_7710":102885},[48836],"Long numbers are between -9223372036854775808 and 9223372036854775807.",{"_12623":3321,"_48290":3041,"_18312":102887,"_5":17825,"_25222":102374,"_7710":93959},[48836],{"_12623":3322,"_48290":3041,"_18312":102889,"_5":17825,"_25222":102377,"_7710":102890},[48836],"A decimal number with fixed precision and scale. Internally, java.lang.BigDecimal is used.",{"_12623":3323,"_48290":3041,"_18312":102892,"_5":17825,"_25222":102377,"_7710":93959},[48836],{"_12623":3324,"_48290":3041,"_18312":102894,"_5":17825,"_25222":102381,"_7710":102895},[48836],"The maximum length of the number depends on the data type used.",{"_12623":3325,"_48290":3041,"_18312":102897,"_5":17825,"_25222":102381,"_7710":93959},[48836],{"_12623":3326,"_48290":3041,"_18312":102899,"_5":17825,"_25222":102385,"_7710":102900},[48836],"Comments can be used anywhere in a command and are ignored by the database. Line comments end with a newline. Block comments cannot be nested, but can be multiple lines long.",{"_12623":3327,"_48290":3041,"_18312":102902,"_5":17825,"_25222":102385,"_7710":93959},[48836],{"_12623":3328,"_48290":3328,"_5":13058,"_7710":97033,"_48807":102904,"_18312":102905,"_25222":3328},[92880,92881,93148],[48836],{"_12623":3329,"_48290":3328,"_18312":102907,"_5":17825,"_25222":3328,"_7710":102908},[48836],"OLTP and operational analytics for Apache Hadoop.",{"_12623":3330,"_48290":3328,"_5":48804,"_18312":102910,"_25222":102911,"_7710":102912},[48836],"/docs#mission","Mission",{"_12623":3331,"_48290":3328,"_5":48804,"_18312":102914,"_25222":102915,"_7710":102916},[48836],"/docs#index-quick-start","Quick Start",{"_12623":3332,"_48290":3328,"_5":48804,"_18312":102918,"_25222":102919,"_7710":102920},[48836],"/docs#sql-support","SQL Support",{"_12623":3333,"_48290":3328,"_5":48804,"_18312":102922,"_25222":102923,"_7710":102924},[48836],"/docs#connection","Connection",{"_12623":3334,"_48290":3328,"_5":48804,"_18312":102926,"_25222":102927,"_7710":99277},[48836],"/docs#index-transactions",{"_12623":3335,"_48290":3328,"_5":48804,"_18312":102929,"_25222":102930,"_7710":102931},[48836],"/docs#timestamps","Timestamps",{"_12623":3336,"_48290":3328,"_5":48804,"_18312":102933,"_25222":102934,"_7710":102935},[48836],"/docs#schema","Schema",{"_12623":3337,"_48290":3328,"_5":48804,"_18312":102937,"_25222":102938,"_7710":102939},[48836],"/docs#altering","Altering",{"_12623":3338,"_48290":3328,"_5":48804,"_18312":102941,"_25222":102942,"_7710":99707},[48836],"/docs#index-views",{"_12623":3339,"_48290":3328,"_5":48804,"_18312":102944,"_25222":102945,"_7710":96246},[48836],"/docs#index-multi-tenancy",{"_12623":3340,"_48290":3328,"_5":48804,"_18312":102947,"_25222":102948,"_7710":102949},[48836],"/docs#schema-at-read-time","Schema at read time",{"_12623":3341,"_48290":3328,"_5":48804,"_18312":102951,"_25222":102952,"_7710":102953},[48836],"/docs#mapping-to-an-existing-hbase-table","Mapping to an Existing HBase Table",{"_12623":3342,"_48290":3328,"_5":48804,"_18312":102955,"_25222":102956,"_7710":101562},[48836],"/docs#index-salting",{"_12623":3343,"_48290":3328,"_5":48804,"_18312":102958,"_25222":102959,"_7710":102960},[48836],"/docs#apis","APIs",{"_12623":3344,"_48290":3328,"_18312":102962,"_5":17825,"_25222":3328,"_7710":102963},[48836],"OLTP and operational analytics for Apache Hadoop",{"_12623":3345,"_48290":3328,"_18312":102965,"_5":17825,"_25222":3328,"_7710":102966},[48836],"Download latest Apache Phoenix binary and source release artifacts",{"_12623":3346,"_48290":3328,"_18312":102968,"_5":17825,"_25222":3328,"_7710":102969},[48836],"Browse Apache Phoenix JIRAs",{"_12623":3347,"_48290":3328,"_18312":102971,"_5":17825,"_25222":3328,"_7710":102972},[48836],"Sync and build Apache Phoenix from source code",{"_12623":3348,"_48290":3328,"_18312":102974,"_5":17825,"_25222":3328,"_7710":102975},[48836],"type: info",{"_12623":3349,"_48290":3328,"_18312":102977,"_5":17825,"_25222":3328,"_7710":102978},[48836],"News: Phoenix 5.3.0 has been released and is available for\ndownload here. Follow Apache Phoenix on\nX/Twitter.",{"_12623":3350,"_48290":3328,"_18312":102980,"_5":17825,"_25222":3328,"_7710":102981},[48836],"Apache Phoenix enables OLTP and operational analytics in Hadoop for low-latency applications by combining:",{"_12623":3351,"_48290":3328,"_18312":102983,"_5":17825,"_25222":3328,"_7710":102984},[48836],"the power of standard SQL and JDBC APIs, with full ACID transaction capabilities",{"_12623":3352,"_48290":3328,"_18312":102986,"_5":17825,"_25222":3328,"_7710":102987},[48836],"the flexibility of late-bound, schema-on-read capabilities from the NoSQL world by leveraging HBase as its backing store",{"_12623":3353,"_48290":3328,"_18312":102989,"_5":17825,"_25222":3328,"_7710":102990},[48836],"Apache Phoenix is fully integrated with other Hadoop products such as Spark, Hive, Pig, Flume, and MapReduce.",{"_12623":3354,"_48290":3328,"_18312":102992,"_5":17825,"_25222":3328,"_7710":102993},[48836],"Who is using Apache Phoenix? Read more here.",{"_12623":3355,"_48290":3328,"_18312":102995,"_5":17825,"_25222":102911,"_7710":102996},[48836],"Become the trusted data platform for OLTP and operational analytics for Hadoop through well-defined, industry-standard APIs.",{"_12623":3356,"_48290":3328,"_18312":102998,"_5":17825,"_25222":102915,"_7710":102999},[48836],"Tired of reading and just want to get started? Take a look at our FAQs, listen to the Apache Phoenix talk from Hadoop Summit 2015, review the overview presentation, and jump to our quick start guide here.",{"_12623":3357,"_48290":3328,"_18312":103001,"_5":17825,"_25222":102919,"_7710":103002},[48836],"Apache Phoenix takes your SQL query, compiles it into a series of HBase scans, and orchestrates those scans to produce regular JDBC result sets. Direct use of the HBase API, along with coprocessors and custom filters, results in performance on the order of milliseconds for small queries, or seconds for tens of millions of rows.",{"_12623":3358,"_48290":3328,"_18312":103004,"_5":17825,"_25222":102919,"_7710":103005},[48836],"To see a complete list of what is supported, go to our language reference. All standard SQL query constructs are supported, including SELECT, FROM, WHERE, GROUP BY, HAVING, ORDER BY, etc. It also supports a full set of DML commands, as well as table creation and versioned incremental alterations through DDL commands.",{"_12623":3359,"_48290":3328,"_18312":103007,"_5":17825,"_25222":102919,"_7710":103008},[48836],"Here is a list of what is currently not supported:",{"_12623":3360,"_48290":3328,"_18312":103010,"_5":17825,"_25222":102919,"_7710":103011},[48836],"Relational operators: INTERSECT, MINUS",{"_12623":3361,"_48290":3328,"_18312":103013,"_5":17825,"_25222":102919,"_7710":103014},[48836],"Miscellaneous built-in functions: these are easy to add — read this blog for step-by-step instructions.",{"_12623":3362,"_48290":3328,"_18312":103016,"_5":17825,"_25222":102923,"_7710":103017},[48836],"Use JDBC to get a connection to an HBase cluster:",{"_12623":3363,"_48290":3328,"_18312":103019,"_5":17825,"_25222":102923,"_7710":103020},[48836],"Where props are optional properties that may include Phoenix and HBase configuration values.",{"_12623":3364,"_48290":3328,"_18312":103022,"_5":17825,"_25222":102923,"_7710":103023},[48836],"The JDBC connection string is composed as:",{"_12623":3365,"_48290":3328,"_18312":103025,"_5":17825,"_25222":102923,"_7710":103026},[48836],"For omitted parts, values are taken from hbase-site.xml (hbase.zookeeper.quorum, hbase.zookeeper.property.clientPort, and zookeeper.znode.parent).",{"_12623":3366,"_48290":3328,"_18312":103028,"_5":17825,"_25222":102923,"_7710":103029},[48836],"The optional principal and keytab file may be used to connect to a Kerberos-secured cluster. If only principal is specified, each distinct user gets a dedicated HBase connection (HConnection), allowing multiple different connections with different configuration properties on the same JVM.",{"_12623":3367,"_48290":3328,"_18312":103031,"_5":17825,"_25222":102923,"_7710":103032},[48836],"For example, for longer-running queries:",{"_12623":3368,"_48290":3328,"_18312":103034,"_5":17825,"_25222":102923,"_7710":103035},[48836],"And for shorter-running queries:",{"_12623":3369,"_48290":3328,"_18312":103037,"_5":17825,"_25222":102923,"_7710":103038},[48836],"See the relevant FAQ entry for example URLs.",{"_12623":3370,"_48290":3328,"_18312":103040,"_5":17825,"_25222":102923,"_7710":103041},[48836],"Phoenix also supports connecting to HBase without ZooKeeper.",{"_12623":3371,"_48290":3328,"_18312":103043,"_5":17825,"_25222":102927,"_7710":103044},[48836],"To enable full ACID transactions (beta in 4.7.0), set phoenix.transactions.enabled=true. In this case, you also need to run the transaction manager included in the distribution. Once enabled, a table may optionally be declared as transactional (see transactions).",{"_12623":3372,"_48290":3328,"_18312":103046,"_5":17825,"_25222":102927,"_7710":103047},[48836],"Commits over transactional tables are all-or-none: either all data is committed (including secondary index updates) or none is committed (and an exception is thrown). Both cross-table and cross-row transactions are supported. Transactional tables also see their own uncommitted data when querying. An optimistic concurrency model is used to detect row-level conflicts with first-commit-wins semantics.",{"_12623":3373,"_48290":3328,"_18312":103049,"_5":17825,"_25222":102927,"_7710":103050},[48836],"Non-transactional tables have no guarantees beyond HBase row-level atomicity (see HBase ACID semantics). Also, non-transactional tables do not see updates until commit occurs.",{"_12623":3374,"_48290":3328,"_18312":103052,"_5":17825,"_25222":102927,"_7710":103053},[48836],"Phoenix DML commands (UPSERT VALUES, UPSERT SELECT, DELETE) batch pending changes on the client side. Changes are sent to server on commit and discarded on rollback. If auto-commit is enabled, Phoenix will execute the entire DML command server-side via coprocessors whenever possible for better performance.",{"_12623":3375,"_48290":3328,"_18312":103055,"_5":17825,"_25222":102930,"_7710":103056},[48836],"Most applications let HBase manage timestamps. In cases where timestamps must be controlled, the CurrentSCN property can be set at connection time to control timestamps for DDL, DML, and queries. This also enables snapshot queries against prior row values because Phoenix uses this property as scan max timestamp.",{"_12623":3376,"_48290":3328,"_18312":103058,"_5":17825,"_25222":102930,"_7710":103059},[48836],"Timestamps cannot be controlled for transactional tables. Instead, the transaction manager assigns timestamps that become HBase cell timestamps on commit. They still correspond to wall-clock time, but are multiplied by 1,000,000 to ensure enough granularity for uniqueness across the cluster.",{"_12623":3377,"_48290":3328,"_18312":103061,"_5":17825,"_25222":102934,"_7710":103062},[48836],"Apache Phoenix supports table creation and versioned incremental alterations through DDL commands. Table metadata is stored in an HBase table and versioned, so snapshot queries over prior versions automatically use the correct schema.",{"_12623":3378,"_48290":3328,"_18312":103064,"_5":17825,"_25222":102934,"_7710":103065},[48836],"A Phoenix table can be created through CREATE TABLE and can either be:",{"_12623":3379,"_48290":3328,"_18312":103067,"_5":17825,"_25222":102934,"_7710":103068},[48836],"Built from scratch: HBase table and column families are created automatically.",{"_12623":3380,"_48290":3328,"_18312":103070,"_5":17825,"_25222":102934,"_7710":103071},[48836],"Mapped to an existing HBase table: either as a read-write TABLE or a read-only VIEW, with the caveat that row key/key-value binary representation must match Phoenix data types (see Data Types).",{"_12623":3381,"_48290":3328,"_18312":103073,"_5":17825,"_25222":102934,"_7710":103074},[48836],"For a read-write TABLE, column families are created automatically if absent. An empty key value is added to the first column family of each existing row to minimize projection size for queries.",{"_12623":3382,"_48290":3328,"_18312":103076,"_5":17825,"_25222":102934,"_7710":103077},[48836],"For a read-only VIEW, all column families must already exist. The only change is adding Phoenix coprocessors for query processing. The primary use case is transferring existing data into Phoenix; DML is not allowed on a VIEW, and query performance may be lower than with a TABLE.",{"_12623":3383,"_48290":3328,"_18312":103079,"_5":17825,"_25222":102934,"_7710":103080},[48836],"All schema is versioned (up to 1000 versions kept). Snapshot queries over older data pick up the correct schema based on connection time via CurrentSCN.",{"_12623":3384,"_48290":3328,"_18312":103082,"_5":17825,"_25222":102938,"_7710":103083},[48836],"A Phoenix table may be altered via ALTER TABLE. When a SQL statement references a table, Phoenix checks with the server by default to ensure metadata and statistics are up to date.",{"_12623":3385,"_48290":3328,"_18312":103085,"_5":17825,"_25222":102938,"_7710":103086},[48836],"If table structure is known to be stable, this RPC may be unnecessary. UPDATE_CACHE_FREQUENCY (added in 4.7) lets users define how often the server is checked for metadata/statistics updates. Possible values: ALWAYS (default), NEVER, or a millisecond value.",{"_12623":3386,"_48290":3328,"_18312":103088,"_5":17825,"_25222":102938,"_7710":103089},[48836],"For example, this DDL creates table FOO and tells clients to check for updates every 15 minutes:",{"_12623":3387,"_48290":3328,"_18312":103091,"_5":17825,"_25222":102942,"_7710":103092},[48836],"Phoenix supports updatable views on top of tables, with the unique capability of adding columns by leveraging HBase schemaless behavior. All views share the same underlying HBase table and may be indexed independently. Read more here.",{"_12623":3388,"_48290":3328,"_18312":103094,"_5":17825,"_25222":102945,"_7710":103095},[48836],"Built on top of view support, Phoenix also supports multi-tenancy. As with views, a multi-tenant view can add columns defined solely for that user.",{"_12623":3389,"_48290":3328,"_18312":103097,"_5":17825,"_25222":102948,"_7710":103098},[48836],"Another schema-related feature allows columns to be defined dynamically at query time. This is useful when not all columns are known at create time. More details here.",{"_12623":3390,"_48290":3328,"_18312":103100,"_5":17825,"_25222":102952,"_7710":103101},[48836],"Phoenix supports mapping to an existing HBase table through CREATE TABLE and CREATE VIEW. In both cases, HBase metadata remains as-is, except that with CREATE TABLE, KEEP_DELETED_CELLS is enabled so flashback queries work correctly.",{"_12623":3391,"_48290":3328,"_18312":103103,"_5":17825,"_25222":102952,"_7710":103104},[48836],"For CREATE TABLE, missing HBase metadata (table/column families) is created if needed. Table and column family names are case-sensitive at HBase level; Phoenix uppercases names by default. To preserve case sensitivity, wrap names in double quotes:",{"_12623":3392,"_48290":3328,"_18312":103106,"_5":17825,"_25222":102952,"_7710":103107},[48836],"For CREATE TABLE, an empty key value is added per row so queries behave as expected without projecting all columns during scans. For CREATE VIEW, this is not done and no HBase metadata is created. Existing HBase metadata must match DDL metadata, or ERROR 505 (42000): Table is read only is thrown.",{"_12623":3393,"_48290":3328,"_18312":103109,"_5":17825,"_25222":102952,"_7710":103110},[48836],"Another caveat: bytes serialized in HBase must match Phoenix serialization expectations.",{"_12623":3394,"_48290":3328,"_18312":103112,"_5":17825,"_25222":102952,"_7710":103113},[48836],"For VARCHAR, CHAR, and UNSIGNED_* types, Phoenix uses HBase Bytes utility methods.",{"_12623":3395,"_48290":3328,"_18312":103115,"_5":17825,"_25222":102952,"_7710":103116},[48836],"CHAR expects only single-byte characters.",{"_12623":3396,"_48290":3328,"_18312":103118,"_5":17825,"_25222":102952,"_7710":103119},[48836],"UNSIGNED_* expects non-negative values.",{"_12623":3397,"_48290":3328,"_18312":103121,"_5":17825,"_25222":102952,"_7710":103122},[48836],"Composite row keys are formed by concatenating values, with a zero byte separator after variable-length types. For more on type system details, see Data Types.",{"_12623":3398,"_48290":3328,"_18312":103124,"_5":17825,"_25222":102956,"_7710":103125},[48836],"Tables can be declared salted to avoid HBase region hotspotting. Declare a salt bucket count and Phoenix manages salting transparently. See details here, and write-throughput comparison here.",{"_12623":3399,"_48290":3328,"_18312":103127,"_5":17825,"_25222":102959,"_7710":103128},[48836],"Catalog metadata (tables, columns, primary keys, and types) can be retrieved through Java SQL metadata interfaces: DatabaseMetaData, ParameterMetaData, and ResultSetMetaData.",{"_12623":3400,"_48290":3328,"_18312":103130,"_5":17825,"_25222":102959,"_7710":103131},[48836],"For schema/table/column retrieval via DatabaseMetaData, schema pattern, table pattern, and column pattern are LIKE-style expressions (% and _, escaped by \\).",{"_12623":3401,"_48290":3328,"_18312":103133,"_5":17825,"_25222":102959,"_7710":103134},[48836],"In metadata APIs, table catalog argument is used to filter by tenant ID for multi-tenant tables.",{"_12623":3402,"_48290":3402,"_5":13058,"_7710":97041,"_48807":103136,"_18312":103137,"_25222":3402},[92880,92881,93148],[48836],{"_12623":3403,"_48290":3402,"_18312":103139,"_5":17825,"_25222":3402,"_7710":103140},[48836],"Install and configure Apache Phoenix clients and server components.",{"_12623":3404,"_48290":3402,"_5":48804,"_18312":103142,"_25222":103143,"_7710":97041},[48836],"/docs/installation#installation-installation",{"_12623":3405,"_48290":3402,"_5":48804,"_18312":103145,"_25222":103146,"_7710":93148},[48836],"/docs/installation#installation-getting-started",{"_12623":3406,"_48290":3402,"_5":48804,"_18312":103148,"_25222":103149,"_7710":103150},[48836],"/docs/installation#command-line","Command Line",{"_12623":3407,"_48290":3402,"_5":48804,"_18312":103152,"_25222":103153,"_7710":103154},[48836],"/docs/installation#loading-data","Loading Data",{"_12623":3408,"_48290":3402,"_5":48804,"_18312":103156,"_25222":103157,"_7710":103158},[48836],"/docs/installation#squirrel-sql-client","SQuirreL SQL Client",{"_12623":3409,"_48290":3402,"_5":48804,"_18312":103160,"_25222":103161,"_7710":103162},[48836],"/docs/installation#samples","Samples",{"_12623":3410,"_48290":3402,"_18312":103164,"_5":17825,"_25222":103143,"_7710":103165},[48836],"To install a pre-built Phoenix, use these directions:",{"_12623":3411,"_48290":3402,"_18312":103167,"_5":17825,"_25222":103143,"_7710":103168},[48836],"Download and expand the latest phoenix-hbase-[hbase.version]-[phoenix.version]-bin.tar.gz for your HBase version.",{"_12623":3412,"_48290":3402,"_18312":103170,"_5":17825,"_25222":103143,"_7710":103171},[48836],"Add phoenix-server-hbase-[hbase.version]-[phoenix.version].jar to the classpath of all HBase region servers and masters, and remove any previous version. An easy way is to copy it into the HBase lib directory.",{"_12623":3413,"_48290":3402,"_18312":103173,"_5":17825,"_25222":103143,"_7710":103174},[48836],"Restart HBase.",{"_12623":3414,"_48290":3402,"_18312":103176,"_5":17825,"_25222":103143,"_7710":103177},[48836],"Add phoenix-client-hbase-[hbase.version]-[phoenix.version].jar to the classpath of any JDBC client.",{"_12623":3415,"_48290":3402,"_18312":103179,"_5":17825,"_25222":103143,"_7710":103180},[48836],"To install Phoenix from source:",{"_12623":3416,"_48290":3402,"_18312":103182,"_5":17825,"_25222":103143,"_7710":103183},[48836],"Download and expand the latest phoenix-[phoenix.version]-src.tar.gz for your HBase version, or check it out from the main source repository.",{"_12623":3417,"_48290":3402,"_18312":103185,"_5":17825,"_25222":103143,"_7710":103186},[48836],"Follow the build instructions in BUILDING.md in the root directory of the source distribution/repository to build the binary assembly.",{"_12623":3418,"_48290":3402,"_18312":103188,"_5":17825,"_25222":103143,"_7710":103189},[48836],"Follow the instructions above, but use the assembly built from source.",{"_12623":3419,"_48290":3402,"_18312":103191,"_5":17825,"_25222":103146,"_7710":103192},[48836],"Want to get started quickly? Take a look at our FAQs and quick start guide here.",{"_12623":3420,"_48290":3402,"_18312":103194,"_5":17825,"_25222":103149,"_7710":103195},[48836],"A terminal interface to execute SQL from the command line is now bundled with Phoenix. To start it, execute the following from the bin directory:",{"_12623":3421,"_48290":3402,"_18312":103197,"_5":17825,"_25222":103149,"_7710":103198},[48836],"To execute SQL scripts from the command line, you can include a SQL file argument like this:",{"_12623":3422,"_48290":3402,"_18312":103200,"_5":17825,"_25222":103149,"_7710":103201},[48836],"For more information, see the manual.",{"_12623":3423,"_48290":3402,"_18312":103203,"_5":17825,"_25222":103153,"_7710":103204},[48836],"In addition, you can use bin/psql.py to load CSV data or execute SQL scripts. For example:",{"_12623":3424,"_48290":3402,"_18312":103206,"_5":17825,"_25222":103153,"_7710":103207},[48836],"Other alternatives include:",{"_12623":3425,"_48290":3402,"_18312":103209,"_5":17825,"_25222":103153,"_7710":103210},[48836],"Using our map-reduce based CSV loader for bigger data sets",{"_12623":3426,"_48290":3402,"_18312":103212,"_5":17825,"_25222":103153,"_7710":103213},[48836],"Mapping an existing HBase table to a Phoenix table and using the UPSERT SELECT command to populate a new table.",{"_12623":3427,"_48290":3402,"_18312":103215,"_5":17825,"_25222":103153,"_7710":103216},[48836],"Populating the table through our UPSERT VALUES command.",{"_12623":3428,"_48290":3402,"_18312":103218,"_5":17825,"_25222":103157,"_7710":103219},[48836],"If you'd rather use a client GUI to interact with Phoenix, download and install SQuirrel. Since Phoenix is a JDBC driver, integration with tools such as this are seamless. Here are the setup steps necessary:",{"_12623":3429,"_48290":3402,"_18312":103221,"_5":17825,"_25222":103157,"_7710":103222},[48836],"Remove prior phoenix-[_oldversion_]-client.jar from the SQuirreL lib\ndirectory, then copy phoenix-[_newversion_]-client.jar there (_newversion_\nshould match the Phoenix server jar used with your HBase installation).",{"_12623":3430,"_48290":3402,"_18312":103224,"_5":17825,"_25222":103157,"_7710":103225},[48836],"In Add Driver, set Name to Phoenix, and set the Example URL to\njdbc:phoenix:localhost.",{"_12623":3431,"_48290":3402,"_18312":103227,"_5":17825,"_25222":103157,"_7710":103228},[48836],"Enter org.apache.phoenix.jdbc.PhoenixDriver into the Class Name field and\nclick OK.",{"_12623":3432,"_48290":3402,"_18312":103230,"_5":17825,"_25222":103157,"_7710":103231},[48836],"Switch to Alias tab and create a new Alias (Aliases -> New Alias).",{"_12623":3433,"_48290":3402,"_18312":103233,"_5":17825,"_25222":103157,"_7710":103234},[48836],"In the dialog, use Name: any name, Driver: Phoenix, User Name: anything,\nPassword: anything.",{"_12623":3434,"_48290":3402,"_18312":103236,"_5":17825,"_25222":103157,"_7710":103237},[48836],"Construct URL as follows: jdbc:phoenix:[zookeeper quorum server]. For\nexample, to connect to local HBase use jdbc:phoenix:localhost.",{"_12623":3435,"_48290":3402,"_18312":103239,"_5":17825,"_25222":103157,"_7710":103240},[48836],"Press Test (it should succeed if everything is set up correctly), then press\nOK to close.",{"_12623":3436,"_48290":3402,"_18312":103242,"_5":17825,"_25222":103157,"_7710":103243},[48836],"Double-click your newly created Phoenix alias and click Connect. You are now\nready to run SQL queries against Phoenix.",{"_12623":3437,"_48290":3402,"_18312":103245,"_5":17825,"_25222":103157,"_7710":103246},[48836],"Through SQuirreL, you can issue SQL statements in the SQL tab (create tables, insert data, run queries), and inspect table metadata in the Object tab (for example, list tables, columns, primary keys, and types).",{"_12623":3438,"_48290":3402,"_18312":103248,"_5":17825,"_25222":103157,"_7710":103249},[48836],"Note that most graphical clients that support generic JDBC drives should also work, and the setup process is usually similar.",{"_12623":3439,"_48290":3402,"_18312":103251,"_5":17825,"_25222":103161,"_7710":103252},[48836],"The best place to see samples are in our unit tests under src/test/java. The ones in the endToEnd package are tests demonstrating how to use all aspects of the Phoenix JDBC driver. We also have some examples in the examples directory.",{"_12623":3440,"_48290":3440,"_5":13058,"_7710":103254,"_48807":103255,"_18312":103257,"_25222":3440},"Apache Hive",[92880,92881,92882,103256],"Integrations",[48836],{"_12623":3441,"_48290":3440,"_18312":103259,"_5":17825,"_25222":3440,"_7710":103260},[48836],"Configure and use the Phoenix Storage Handler with Apache Hive.",{"_12623":3442,"_48290":3440,"_5":48804,"_18312":103262,"_25222":103263,"_7710":93065},[48836],"/docs/integrations/apache-hive#apache-hive-prerequisites",{"_12623":3443,"_48290":3440,"_5":48804,"_18312":103265,"_25222":103266,"_7710":100602},[48836],"/docs/integrations/apache-hive#apache-hive-building",{"_12623":3444,"_48290":3440,"_5":48804,"_18312":103268,"_25222":103269,"_7710":103270},[48836],"/docs/integrations/apache-hive#preparing-hive-3","Preparing Hive 3",{"_12623":3445,"_48290":3440,"_5":48804,"_18312":103272,"_25222":103273,"_7710":103274},[48836],"/docs/integrations/apache-hive#hive-setup","Hive Setup",{"_12623":3446,"_48290":3440,"_5":48804,"_18312":103276,"_25222":103277,"_7710":103278},[48836],"/docs/integrations/apache-hive#table-creation-and-deletion","Table Creation and Deletion",{"_12623":3447,"_48290":3440,"_5":48804,"_18312":103280,"_25222":103281,"_7710":103282},[48836],"/docs/integrations/apache-hive#create-external-table","Create EXTERNAL Table",{"_12623":3448,"_48290":3440,"_5":48804,"_18312":103284,"_25222":103285,"_7710":103286},[48836],"/docs/integrations/apache-hive#properties","Properties",{"_12623":3449,"_48290":3440,"_5":48804,"_18312":103288,"_25222":103289,"_7710":103290},[48836],"/docs/integrations/apache-hive#data-ingestion-deletions-and-updates","Data Ingestion, Deletions, and Updates",{"_12623":3450,"_48290":3440,"_5":48804,"_18312":103292,"_25222":103293,"_7710":103294},[48836],"/docs/integrations/apache-hive#additional-configuration-options","Additional Configuration Options",{"_12623":3451,"_48290":3440,"_5":48804,"_18312":103296,"_25222":103297,"_7710":103298},[48836],"/docs/integrations/apache-hive#performance-tuning","Performance Tuning",{"_12623":3452,"_48290":3440,"_5":48804,"_18312":103300,"_25222":103301,"_7710":103302},[48836],"/docs/integrations/apache-hive#query-data","Query Data",{"_12623":3453,"_48290":3440,"_5":48804,"_18312":103304,"_25222":103305,"_7710":93002},[48836],"/docs/integrations/apache-hive#apache-hive-limitations",{"_12623":3454,"_48290":3440,"_5":48804,"_18312":103307,"_25222":103308,"_7710":96357},[48836],"/docs/integrations/apache-hive#apache-hive-resources",{"_12623":3455,"_48290":3440,"_18312":103310,"_5":17825,"_25222":3440,"_7710":103311},[48836],"The Apache Phoenix Storage Handler is a plugin that enables Apache Hive access to Phoenix tables from the Apache Hive command line using HiveQL.",{"_12623":3456,"_48290":3440,"_18312":103313,"_5":17825,"_25222":103263,"_7710":103314},[48836],"This document describes the plugin available in the phoenix-connectors source repo, as of December 2023.",{"_12623":3457,"_48290":3440,"_18312":103316,"_5":17825,"_25222":103263,"_7710":103317},[48836],"Phoenix 5.1.0+",{"_12623":3458,"_48290":3440,"_18312":103319,"_5":17825,"_25222":103263,"_7710":103320},[48836],"Hive 3.1.2+",{"_12623":3459,"_48290":3440,"_18312":103322,"_5":17825,"_25222":103263,"_7710":103323},[48836],"phoenix-connectors 6.0.0-SNAPSHOT",{"_12623":3460,"_48290":3440,"_18312":103325,"_5":17825,"_25222":103263,"_7710":103326},[48836],"The Phoenix Storage handler currently only supports Hive 3.1.\nIt has only been tested with Hive Hive 3.1.3, and Phoenix 5.1.3.",{"_12623":3461,"_48290":3440,"_18312":103328,"_5":17825,"_25222":103263,"_7710":103329},[48836],"A variant for Hive 4 is planned after Hive 4.0.0 is released.",{"_12623":3462,"_48290":3440,"_18312":103331,"_5":17825,"_25222":103266,"_7710":103332},[48836],"The Phoenix Storage Handler used to be part of the main Phoenix repo, but it has been refactored into the separate phoenix-connectors repo after the release of Phoenix 5.0.\nAt the time of writing there is no released version of the connectors project, so it must be built from the Git source repository HEAD.",{"_12623":3463,"_48290":3440,"_18312":103334,"_5":17825,"_25222":103266,"_7710":103335},[48836],"Official releases will be available on the Downloads page.",{"_12623":3464,"_48290":3440,"_18312":103337,"_5":17825,"_25222":103266,"_7710":103338},[48836],"Check the value of the hbase.version property in the root pom.xml.\nIf it is older than HBase 2.5.0, then you need to rebuild HBase locally as described\nin BUILDING.md in the main Phoenix repository.",{"_12623":3465,"_48290":3440,"_18312":103340,"_5":17825,"_25222":103266,"_7710":103341},[48836],"Check out the HEAD version of https://github.com/apache/phoenix-connectors.\nBuild it with:",{"_12623":3466,"_48290":3440,"_18312":103343,"_5":17825,"_25222":103266,"_7710":103344},[48836],"The binary distribution will be created in phoenix5-connectors-assembly/target.",{"_12623":3467,"_48290":3440,"_18312":103346,"_5":17825,"_25222":103266,"_7710":103347},[48836],"The driver is built for HBase 2.4.x by default.",{"_12623":3468,"_48290":3440,"_18312":103349,"_5":17825,"_25222":103266,"_7710":103350},[48836],"To build it for other HBase versions, set hbase.version, hbase.compat.version, hadoop.version, zookeeper.version, and hbase-thirdparty-version to the versions used by HBase. hbase.compat.version is the matching hbase-compat module in Phoenix; other versions can be copied from the root pom.xml in the HBase source.",{"_12623":3469,"_48290":3440,"_18312":103352,"_5":17825,"_25222":103266,"_7710":103353},[48836],"For example, to build with HBase 2.1.10 (rebuilt with -Dhadoop.profile=3.0), use:",{"_12623":3470,"_48290":3440,"_18312":103355,"_5":17825,"_25222":103269,"_7710":103356},[48836],"Hive 3.1 ships with HBase 2.0 beta, which is incompatible with Phoenix.\nTo use the Phoenix Storage handler, HBase and its dependencies have to be removed from Hive.",{"_12623":3471,"_48290":3440,"_18312":103358,"_5":17825,"_25222":103269,"_7710":103359},[48836],"To remove the shipped HBase 2.0 beta perform the following on each Hive node:",{"_12623":3472,"_48290":3440,"_18312":103361,"_5":17825,"_25222":103269,"_7710":103362},[48836],"Create a backup of the Hive /lib directory",{"_12623":3473,"_48290":3440,"_18312":103364,"_5":17825,"_25222":103269,"_7710":103365},[48836],"Remove the HBase dependencies from the /lib directory:",{"_12623":3474,"_48290":3440,"_18312":103367,"_5":17825,"_25222":103269,"_7710":103368},[48836],"Even though Hive ships with HBase jars, it includes a mechanism to load the hbase mapredcp jars automatically.",{"_12623":3475,"_48290":3440,"_18312":103370,"_5":17825,"_25222":103269,"_7710":103371},[48836],"To ensure that Hive finds and uses the correct HBase JARs and hbase-site.xml, set the following\nenvironment variables in hive-env.sh on each node, or make sure they are set properly in the environment:",{"_12623":3476,"_48290":3440,"_18312":103373,"_5":17825,"_25222":103269,"_7710":103374},[48836],"HBASE_HOME: The root directory of the HBase installation.",{"_12623":3477,"_48290":3440,"_18312":103376,"_5":17825,"_25222":103269,"_7710":103377},[48836],"HBASE_CONF_DIR: The directory where hbase-site.xml resides. Defaults to /etc/hbase/conf, or if it does not exist, to $HBASE_HOME/conf.",{"_12623":3478,"_48290":3440,"_18312":103379,"_5":17825,"_25222":103269,"_7710":103380},[48836],"HBASE_BIN_DIR: The directory that holds the hbase command. Defaults to $HBASE_HOME/bin.",{"_12623":3479,"_48290":3440,"_18312":103382,"_5":17825,"_25222":103269,"_7710":103383},[48836],"It is assumed that the Hadoop variables are already set correctly, and the HBase libraries and up-to-date hbase-site.xml are available on each Hive node.",{"_12623":3480,"_48290":3440,"_18312":103385,"_5":17825,"_25222":103273,"_7710":103386},[48836],"It is necessary to make the phoenix5-hive-shaded-6.0.0-SNAPSHOT-shaded.jar available for every hive component.\nThere are many ways to achieve this; one of the simpler options is to use the HIVE_AUX_JARS_PATH environment variable.",{"_12623":3481,"_48290":3440,"_18312":103388,"_5":17825,"_25222":103273,"_7710":103389},[48836],"If hive-env.sh already sets HIVE_AUX_JARS_PATH, then copy the connector JAR there.\nOtherwise, create a world-readable directory on the system and copy the connector JAR there. Then add:",{"_12623":3482,"_48290":3440,"_18312":103391,"_5":17825,"_25222":103273,"_7710":103392},[48836],"to hive-env.sh.",{"_12623":3483,"_48290":3440,"_18312":103394,"_5":17825,"_25222":103273,"_7710":103395},[48836],"This must be performed on every Hive node.",{"_12623":3484,"_48290":3440,"_18312":103397,"_5":17825,"_25222":103277,"_7710":103398},[48836],"The Phoenix Storage Handler supports only EXTERNAL Hive tables.",{"_12623":3485,"_48290":3440,"_18312":103400,"_5":17825,"_25222":103281,"_7710":103401},[48836],"For EXTERNAL tables, Hive works with an existing Phoenix table and manages only Hive metadata. Dropping an EXTERNAL table from Hive deletes only Hive metadata but does not delete the Phoenix table.",{"_12623":3486,"_48290":3440,"_18312":103403,"_5":17825,"_25222":103285,"_7710":103404},[48836],"phoenix.table.name",{"_12623":3487,"_48290":3440,"_18312":103406,"_5":17825,"_25222":103285,"_7710":103407},[48836],"Specifies the Phoenix table name",{"_12623":3488,"_48290":3440,"_18312":103409,"_5":17825,"_25222":103285,"_7710":103410},[48836],"Default: the same as the Hive table",{"_12623":3489,"_48290":3440,"_18312":103412,"_5":17825,"_25222":103285,"_7710":103413},[48836],"phoenix.zookeeper.quorum",{"_12623":3490,"_48290":3440,"_18312":103415,"_5":17825,"_25222":103285,"_7710":103416},[48836],"Specifies the ZooKeeper quorum for HBase",{"_12623":3491,"_48290":3440,"_18312":103418,"_5":17825,"_25222":103285,"_7710":103419},[48836],"Default: localhost",{"_12623":3492,"_48290":3440,"_18312":103421,"_5":17825,"_25222":103285,"_7710":103422},[48836],"phoenix.zookeeper.znode.parent",{"_12623":3493,"_48290":3440,"_18312":103424,"_5":17825,"_25222":103285,"_7710":103425},[48836],"Specifies the ZooKeeper parent node for HBase",{"_12623":3494,"_48290":3440,"_18312":103427,"_5":17825,"_25222":103285,"_7710":103428},[48836],"Default: /hbase",{"_12623":3495,"_48290":3440,"_18312":103430,"_5":17825,"_25222":103285,"_7710":103431},[48836],"phoenix.zookeeper.client.port",{"_12623":3496,"_48290":3440,"_18312":103433,"_5":17825,"_25222":103285,"_7710":103434},[48836],"Specifies the ZooKeeper port",{"_12623":3497,"_48290":3440,"_18312":103436,"_5":17825,"_25222":103285,"_7710":103437},[48836],"Default: 2181",{"_12623":3498,"_48290":3440,"_18312":103439,"_5":17825,"_25222":103285,"_7710":103440},[48836],"phoenix.rowkeys",{"_12623":3499,"_48290":3440,"_18312":103442,"_5":17825,"_25222":103285,"_7710":103443},[48836],"The list of columns to be the primary key in a Phoenix table",{"_12623":3500,"_48290":3440,"_18312":103445,"_5":17825,"_25222":103285,"_7710":95744},[48836],{"_12623":3501,"_48290":3440,"_18312":103447,"_5":17825,"_25222":103285,"_7710":103448},[48836],"phoenix.column.mapping",{"_12623":3502,"_48290":3440,"_18312":103450,"_5":17825,"_25222":103285,"_7710":103451},[48836],"Mappings between column names for Hive and Phoenix. See Limitations for details.",{"_12623":3503,"_48290":3440,"_18312":103453,"_5":17825,"_25222":103285,"_7710":103454},[48836],"The phoenix.zookeeper.* properties are optional. If they are not specified, values from hbase-site.xml will be used.",{"_12623":3504,"_48290":3440,"_18312":103456,"_5":17825,"_25222":103289,"_7710":103457},[48836],"Data ingestion can be done by all ways that Hive and Phoenix support:",{"_12623":3505,"_48290":3440,"_18312":103459,"_5":17825,"_25222":103289,"_7710":103460},[48836],"Hive:",{"_12623":3506,"_48290":3440,"_18312":103462,"_5":17825,"_25222":103289,"_7710":103463},[48836],"Phoenix:",{"_12623":3507,"_48290":3440,"_18312":103465,"_5":17825,"_25222":103289,"_7710":103466},[48836],"Phoenix CSV BulkLoad tools can also be used.",{"_12623":3508,"_48290":3440,"_18312":103468,"_5":17825,"_25222":103289,"_7710":103469},[48836],"All delete and update operations should be performed on the Phoenix side. See Limitations for more details.",{"_12623":3509,"_48290":3440,"_18312":103471,"_5":17825,"_25222":103293,"_7710":103472},[48836],"Those options can be set in a Hive command-line interface (CLI) environment.",{"_12623":3510,"_48290":3440,"_18312":103474,"_5":17825,"_25222":103297,"_7710":94966},[48836],{"_12623":3511,"_48290":3440,"_18312":103476,"_5":17825,"_25222":103297,"_7710":103477},[48836],"Default Value",{"_12623":3512,"_48290":3440,"_18312":103479,"_5":17825,"_25222":103297,"_7710":94969},[48836],{"_12623":3513,"_48290":3440,"_18312":103481,"_5":17825,"_25222":103297,"_7710":103482},[48836],"phoenix.upsert.batch.size",{"_12623":3514,"_48290":3440,"_18312":103484,"_5":17825,"_25222":103297,"_7710":45578},[48836],{"_12623":3515,"_48290":3440,"_18312":103486,"_5":17825,"_25222":103297,"_7710":103487},[48836],"Batch size for upsert.",{"_12623":3516,"_48290":3440,"_18312":103489,"_5":17825,"_25222":103297,"_7710":103490},[48836],"[phoenix-table-name].disable.wal",{"_12623":3517,"_48290":3440,"_18312":103492,"_5":17825,"_25222":103297,"_7710":26233},[48836],{"_12623":3518,"_48290":3440,"_18312":103494,"_5":17825,"_25222":103297,"_7710":103495},[48836],"Temporarily sets the table attribute DISABLE_WAL to true. Sometimes used to improve performance",{"_12623":3519,"_48290":3440,"_18312":103497,"_5":17825,"_25222":103297,"_7710":103498},[48836],"[phoenix-table-name].auto.flush",{"_12623":3520,"_48290":3440,"_18312":103500,"_5":17825,"_25222":103297,"_7710":26233},[48836],{"_12623":3521,"_48290":3440,"_18312":103502,"_5":17825,"_25222":103297,"_7710":103503},[48836],"When WAL is disabled and if this value is true, then MemStore is flushed to an HFile.",{"_12623":3522,"_48290":3440,"_18312":103505,"_5":17825,"_25222":103297,"_7710":103506},[48836],"Disabling WAL can lead to data loss.",{"_12623":3523,"_48290":3440,"_18312":103508,"_5":17825,"_25222":103301,"_7710":103509},[48836],"You can use HiveQL for querying data in a Phoenix table. A Hive query on a single table can be as fast as running the query in the Phoenix CLI with the following property settings: hive.fetch.task.conversion=more and hive.exec.parallel=true",{"_12623":3524,"_48290":3440,"_18312":103511,"_5":17825,"_25222":103301,"_7710":94966},[48836],{"_12623":3525,"_48290":3440,"_18312":103513,"_5":17825,"_25222":103301,"_7710":103477},[48836],{"_12623":3526,"_48290":3440,"_18312":103515,"_5":17825,"_25222":103301,"_7710":94969},[48836],{"_12623":3527,"_48290":3440,"_18312":103517,"_5":17825,"_25222":103301,"_7710":103518},[48836],"hbase.scan.cache",{"_12623":3528,"_48290":3440,"_18312":103520,"_5":17825,"_25222":103301,"_7710":45547},[48836],{"_12623":3529,"_48290":3440,"_18312":103522,"_5":17825,"_25222":103301,"_7710":103523},[48836],"Read row size for a unit request",{"_12623":3530,"_48290":3440,"_18312":103525,"_5":17825,"_25222":103301,"_7710":103526},[48836],"hbase.scan.cacheblock",{"_12623":3531,"_48290":3440,"_18312":103528,"_5":17825,"_25222":103301,"_7710":26233},[48836],{"_12623":3532,"_48290":3440,"_18312":103530,"_5":17825,"_25222":103301,"_7710":103531},[48836],"Whether or not cache block",{"_12623":3533,"_48290":3440,"_18312":103533,"_5":17825,"_25222":103301,"_7710":103534},[48836],"split.by.stats",{"_12623":3534,"_48290":3440,"_18312":103536,"_5":17825,"_25222":103301,"_7710":26233},[48836],{"_12623":3535,"_48290":3440,"_18312":103538,"_5":17825,"_25222":103301,"_7710":103539},[48836],"If true, mappers use table statistics. One mapper per guide post.",{"_12623":3536,"_48290":3440,"_18312":103541,"_5":17825,"_25222":103301,"_7710":103542},[48836],"[hive-table-name].reducer.count",{"_12623":3537,"_48290":3440,"_18312":103544,"_5":17825,"_25222":103301,"_7710":9341},[48836],{"_12623":3538,"_48290":3440,"_18312":103546,"_5":17825,"_25222":103301,"_7710":103547},[48836],"Number of reducers. In Tez mode, this affects only single-table queries. See Limitations.",{"_12623":3539,"_48290":3440,"_18312":103549,"_5":17825,"_25222":103301,"_7710":103550},[48836],"[phoenix-table-name].query.hint",{"_12623":3540,"_48290":3440,"_18312":103552,"_5":17825,"_25222":103301,"_7710":103553},[48836],"Hint for Phoenix query (for example, NO_INDEX)",{"_12623":3541,"_48290":3440,"_18312":103555,"_5":17825,"_25222":103305,"_7710":103556},[48836],"Hive update and delete operations require transaction manager support on both Hive and Phoenix sides. Related Hive and Phoenix JIRAs are listed in the Resources section.",{"_12623":3542,"_48290":3440,"_18312":103558,"_5":17825,"_25222":103305,"_7710":103559},[48836],"Column mapping does not work correctly with mapping row key columns.",{"_12623":3543,"_48290":3440,"_18312":103561,"_5":17825,"_25222":103305,"_7710":103562},[48836],"MapReduce and Tez jobs always have a single reducer.",{"_12623":3544,"_48290":3440,"_18312":103564,"_5":17825,"_25222":103308,"_7710":103565},[48836],"PHOENIX-2743: Implementation accepted by the Apache Phoenix community. Original pull request contains modifications for Hive classes.",{"_12623":3545,"_48290":3440,"_18312":103567,"_5":17825,"_25222":103308,"_7710":103568},[48836],"PHOENIX-331: An outdated implementation with support for Hive 0.98.",{"_12623":3546,"_48290":3546,"_5":13058,"_7710":103570,"_48807":103571,"_18312":103572,"_25222":3546},"Flume Plugin",[92880,92881,92882,103256],[48836],{"_12623":3547,"_48290":3546,"_18312":103574,"_5":17825,"_25222":3546,"_7710":103575},[48836],"Configure Apache Flume to ingest events into Phoenix tables.",{"_12623":3548,"_48290":3546,"_5":48804,"_18312":103577,"_25222":103578,"_7710":93065},[48836],"/docs/integrations/flume-plugin#flume-plugin-prerequisites",{"_12623":3549,"_48290":3546,"_5":48804,"_18312":103580,"_25222":103581,"_7710":103582},[48836],"/docs/integrations/flume-plugin#flume-plugin-installation-and-setup","Installation and Setup",{"_12623":3550,"_48290":3546,"_5":48804,"_18312":103584,"_25222":103585,"_7710":92932},[48836],"/docs/integrations/flume-plugin#flume-plugin-configuration",{"_12623":3551,"_48290":3546,"_5":48804,"_18312":103587,"_25222":103588,"_7710":103589},[48836],"/docs/integrations/flume-plugin#starting-the-agent","Starting the agent",{"_12623":3552,"_48290":3546,"_5":48804,"_18312":103591,"_25222":103592,"_7710":103593},[48836],"/docs/integrations/flume-plugin#monitoring","Monitoring",{"_12623":3553,"_48290":3546,"_18312":103595,"_5":17825,"_25222":3546,"_7710":103596},[48836],"The plugin enables reliable and efficient streaming of large amounts of data/logs into HBase using the Phoenix API. The custom Phoenix sink and event serializer must be configured in the Flume agent configuration file. Currently, the only supported event serializer is RegexEventSerializer, which parses the Flume event body using a configured regex.",{"_12623":3554,"_48290":3546,"_18312":103598,"_5":17825,"_25222":103578,"_7710":103599},[48836],"Phoenix v3.0.0-SNAPSHOT+",{"_12623":3555,"_48290":3546,"_18312":103601,"_5":17825,"_25222":103578,"_7710":103602},[48836],"Flume 1.4.0+",{"_12623":3556,"_48290":3546,"_18312":103604,"_5":17825,"_25222":103581,"_7710":103605},[48836],"Download and build Phoenix v3.0.0-SNAPSHOT.",{"_12623":3557,"_48290":3546,"_18312":103607,"_5":17825,"_25222":103581,"_7710":103608},[48836],"Follow the instructions here to build the project, as the Flume plugin is still under beta.",{"_12623":3558,"_48290":3546,"_18312":103610,"_5":17825,"_25222":103581,"_7710":103611},[48836],"Create a plugins.d directory within $FLUME_HOME. Within that, create sub-directory phoenix-sink/lib.",{"_12623":3559,"_48290":3546,"_18312":103613,"_5":17825,"_25222":103581,"_7710":103614},[48836],"Copy generated phoenix-3.0.0-SNAPSHOT-client.jar to $FLUME_HOME/plugins.d/phoenix-sink/lib.",{"_12623":3560,"_48290":3546,"_18312":103616,"_5":17825,"_25222":103585,"_7710":103617},[48836],"Property Name",{"_12623":3561,"_48290":3546,"_18312":103619,"_5":17825,"_25222":103585,"_7710":95598},[48836],{"_12623":3562,"_48290":3546,"_18312":103621,"_5":17825,"_25222":103585,"_7710":94969},[48836],{"_12623":3563,"_48290":3546,"_18312":103623,"_5":17825,"_25222":103585,"_7710":5},[48836],{"_12623":3564,"_48290":3546,"_18312":103625,"_5":17825,"_25222":103585,"_7710":103626},[48836],"org.apache.phoenix.flume.sink.PhoenixSink",{"_12623":3565,"_48290":3546,"_18312":103628,"_5":17825,"_25222":103585,"_7710":103629},[48836],"batchSize",{"_12623":3566,"_48290":3546,"_18312":103631,"_5":17825,"_25222":103585,"_7710":45547},[48836],{"_12623":3567,"_48290":3546,"_18312":103633,"_5":17825,"_25222":103585,"_7710":103634},[48836],"Default number of events per transaction.",{"_12623":3568,"_48290":3546,"_18312":103636,"_5":17825,"_25222":103585,"_7710":103637},[48836],"zookeeperQuorum",{"_12623":3569,"_48290":3546,"_18312":103639,"_5":17825,"_25222":103585,"_7710":103640},[48836],"ZooKeeper quorum of the HBase cluster.",{"_12623":3570,"_48290":3546,"_18312":103642,"_5":17825,"_25222":103585,"_7710":18036},[48836],{"_12623":3571,"_48290":3546,"_18312":103644,"_5":17825,"_25222":103585,"_7710":103645},[48836],"Name of the table in HBase to write to.",{"_12623":3572,"_48290":3546,"_18312":103647,"_5":17825,"_25222":103585,"_7710":34364},[48836],{"_12623":3573,"_48290":3546,"_18312":103649,"_5":17825,"_25222":103585,"_7710":103650},[48836],"The CREATE TABLE query for the HBase table where events will be upserted. If specified, the query will be executed. Recommended to include the IF NOT EXISTS clause in the DDL.",{"_12623":3574,"_48290":3546,"_18312":103652,"_5":17825,"_25222":103585,"_7710":22562},[48836],{"_12623":3575,"_48290":3546,"_18312":103654,"_5":17825,"_25222":103585,"_7710":31646},[48836],{"_12623":3576,"_48290":3546,"_18312":103656,"_5":17825,"_25222":103585,"_7710":103657},[48836],"Event serializer for processing the Flume event. Currently only regex is supported.",{"_12623":3577,"_48290":3546,"_18312":103659,"_5":17825,"_25222":103585,"_7710":103660},[48836],"serializer.regex",{"_12623":3578,"_48290":3546,"_18312":103662,"_5":17825,"_25222":103585,"_7710":103663},[48836],"(.*)",{"_12623":3579,"_48290":3546,"_18312":103665,"_5":17825,"_25222":103585,"_7710":103666},[48836],"Regular expression for parsing the event.",{"_12623":3580,"_48290":3546,"_18312":103668,"_5":17825,"_25222":103585,"_7710":103669},[48836],"serializer.columns",{"_12623":3581,"_48290":3546,"_18312":103671,"_5":17825,"_25222":103585,"_7710":103672},[48836],"Columns extracted from the Flume event for inserting into HBase.",{"_12623":3582,"_48290":3546,"_18312":103674,"_5":17825,"_25222":103585,"_7710":103675},[48836],"serializer.headers",{"_12623":3583,"_48290":3546,"_18312":103677,"_5":17825,"_25222":103585,"_7710":103678},[48836],"Flume event headers included as part of the UPSERT query. Data type for these columns is VARCHAR by default.",{"_12623":3584,"_48290":3546,"_18312":103680,"_5":17825,"_25222":103585,"_7710":103681},[48836],"serializer.rowkeyType",{"_12623":3585,"_48290":3546,"_18312":103683,"_5":17825,"_25222":103585,"_7710":103684},[48836],"A custom row key generator. Can be one of timestamp, date, uuid, random, or nanotimestamp. Configure this when a custom row key should be auto-generated for the primary key column.",{"_12623":3586,"_48290":3546,"_18312":103686,"_5":17825,"_25222":103585,"_7710":103687},[48836],"For an example configuration for ingesting Apache access logs into Phoenix, see this property file. It uses UUID as a row key generator for the primary key.",{"_12623":3587,"_48290":3546,"_18312":103689,"_5":17825,"_25222":103592,"_7710":103690},[48836],"To monitor the agent and sink process, enable JMX via flume-env.sh ($FLUME_HOME/conf/flume-env.sh). Ensure you have the following line uncommented:",{"_12623":3588,"_48290":3588,"_5":13058,"_7710":103692,"_48807":103693,"_18312":103694,"_25222":3588},"Kafka Plugin",[92880,92881,92882,103256],[48836],{"_12623":3589,"_48290":3588,"_18312":103696,"_5":17825,"_25222":3588,"_7710":103697},[48836],"Ingest Kafka messages into Phoenix using PhoenixConsumer.",{"_12623":3590,"_48290":3588,"_5":48804,"_18312":103699,"_25222":103700,"_7710":93065},[48836],"/docs/integrations/kafka-plugin#kafka-plugin-prerequisites",{"_12623":3591,"_48290":3588,"_5":48804,"_18312":103702,"_25222":103703,"_7710":103582},[48836],"/docs/integrations/kafka-plugin#kafka-plugin-installation-and-setup",{"_12623":3592,"_48290":3588,"_5":48804,"_18312":103705,"_25222":103706,"_7710":103707},[48836],"/docs/integrations/kafka-plugin#phoenixconsumer-with-regexeventserializer","PhoenixConsumer with RegexEventSerializer",{"_12623":3593,"_48290":3588,"_5":48804,"_18312":103709,"_25222":103710,"_7710":103711},[48836],"/docs/integrations/kafka-plugin#phoenixconsumer-with-jsoneventserializer","PhoenixConsumer with JsonEventSerializer",{"_12623":3594,"_48290":3588,"_5":48804,"_18312":103713,"_25222":103714,"_7710":103715},[48836],"/docs/integrations/kafka-plugin#phoenixconsumer-execution-procedure","PhoenixConsumer Execution Procedure",{"_12623":3595,"_48290":3588,"_5":48804,"_18312":103717,"_25222":103718,"_7710":92932},[48836],"/docs/integrations/kafka-plugin#kafka-plugin-configuration",{"_12623":3596,"_48290":3588,"_18312":103720,"_5":17825,"_25222":3588,"_7710":103721},[48836],"The plugin enables reliable and efficient streaming of large amounts of data/logs into HBase using the Phoenix API.",{"_12623":3597,"_48290":3588,"_18312":103723,"_5":17825,"_25222":3588,"_7710":103724},[48836],"Apache Kafka™ is a distributed, partitioned, replicated commit log service. It provides the functionality of a messaging system, but with a unique design.",{"_12623":3598,"_48290":3588,"_18312":103726,"_5":17825,"_25222":3588,"_7710":103727},[48836],"At a high level, producers send messages over the network to the Kafka cluster, which then serves them to consumers:",{"_12623":3599,"_48290":3588,"_18312":103729,"_5":17825,"_25222":3588,"_7710":103730},[48836],"Phoenix provides PhoenixConsumer to receive messages from Kafka producers.",{"_12623":3600,"_48290":3588,"_18312":103732,"_5":17825,"_25222":103700,"_7710":103733},[48836],"Phoenix 4.10.0+",{"_12623":3601,"_48290":3588,"_18312":103735,"_5":17825,"_25222":103700,"_7710":103736},[48836],"Kafka 0.9.0.0+",{"_12623":3602,"_48290":3588,"_18312":103738,"_5":17825,"_25222":103703,"_7710":103739},[48836],"Use our binary artifacts for Phoenix 4.10.0+ directly or download and build Phoenix yourself (see\ninstructions here).",{"_12623":3603,"_48290":3588,"_18312":103741,"_5":17825,"_25222":103706,"_7710":103742},[48836],"Create a kafka-consumer-regex.properties file with the following properties:",{"_12623":3604,"_48290":3588,"_18312":103744,"_5":17825,"_25222":103710,"_7710":103745},[48836],"Create a kafka-consumer-json.properties file with the following properties:",{"_12623":3605,"_48290":3588,"_18312":103747,"_5":17825,"_25222":103714,"_7710":103748},[48836],"Start the Kafka producer, then send some messages:",{"_12623":3606,"_48290":3588,"_18312":103750,"_5":17825,"_25222":103714,"_7710":103751},[48836],"Learn more about Apache Kafka here.",{"_12623":3607,"_48290":3588,"_18312":103753,"_5":17825,"_25222":103714,"_7710":103754},[48836],"Start PhoenixConsumer using the command below:",{"_12623":3608,"_48290":3588,"_18312":103756,"_5":17825,"_25222":103714,"_7710":103757},[48836],"The input file must be present on HDFS (not the local filesystem where the command is being run).",{"_12623":3609,"_48290":3588,"_18312":103759,"_5":17825,"_25222":103718,"_7710":103617},[48836],{"_12623":3610,"_48290":3588,"_18312":103761,"_5":17825,"_25222":103718,"_7710":95598},[48836],{"_12623":3611,"_48290":3588,"_18312":103763,"_5":17825,"_25222":103718,"_7710":94969},[48836],{"_12623":3612,"_48290":3588,"_18312":103765,"_5":17825,"_25222":103718,"_7710":103766},[48836],"bootstrap.servers",{"_12623":3613,"_48290":3588,"_18312":103768,"_5":17825,"_25222":103718,"_7710":103769},[48836],"List of Kafka servers used to bootstrap connections to Kafka. Format: host1:port1,host2:port2,...",{"_12623":3614,"_48290":3588,"_18312":103771,"_5":17825,"_25222":103718,"_7710":17577},[48836],{"_12623":3615,"_48290":3588,"_18312":103773,"_5":17825,"_25222":103718,"_7710":103774},[48836],"List of topics to use as input for this connector. Format: topic1,topic2,...",{"_12623":3616,"_48290":3588,"_18312":103776,"_5":17825,"_25222":103718,"_7710":103777},[48836],"poll.timeout.ms",{"_12623":3617,"_48290":3588,"_18312":103779,"_5":17825,"_25222":103718,"_7710":45547},[48836],{"_12623":3618,"_48290":3588,"_18312":103781,"_5":17825,"_25222":103718,"_7710":103782},[48836],"Default poll timeout in milliseconds.",{"_12623":3619,"_48290":3588,"_18312":103784,"_5":17825,"_25222":103718,"_7710":103629},[48836],{"_12623":3620,"_48290":3588,"_18312":103786,"_5":17825,"_25222":103718,"_7710":45547},[48836],{"_12623":3621,"_48290":3588,"_18312":103788,"_5":17825,"_25222":103718,"_7710":103634},[48836],{"_12623":3622,"_48290":3588,"_18312":103790,"_5":17825,"_25222":103718,"_7710":103637},[48836],{"_12623":3623,"_48290":3588,"_18312":103792,"_5":17825,"_25222":103718,"_7710":103640},[48836],{"_12623":3624,"_48290":3588,"_18312":103794,"_5":17825,"_25222":103718,"_7710":18036},[48836],{"_12623":3625,"_48290":3588,"_18312":103796,"_5":17825,"_25222":103718,"_7710":103645},[48836],{"_12623":3626,"_48290":3588,"_18312":103798,"_5":17825,"_25222":103718,"_7710":34364},[48836],{"_12623":3627,"_48290":3588,"_18312":103800,"_5":17825,"_25222":103718,"_7710":103801},[48836],"The CREATE TABLE query for the HBase table where events will be upserted. If specified, this query is executed. It is recommended to include IF NOT EXISTS in the DDL.",{"_12623":3628,"_48290":3588,"_18312":103803,"_5":17825,"_25222":103718,"_7710":22562},[48836],{"_12623":3629,"_48290":3588,"_18312":103805,"_5":17825,"_25222":103718,"_7710":103806},[48836],"Event serializer for processing Kafka messages. This plugin supports Phoenix Flume event serializers (for example, regex, json).",{"_12623":3630,"_48290":3588,"_18312":103808,"_5":17825,"_25222":103718,"_7710":103660},[48836],{"_12623":3631,"_48290":3588,"_18312":103810,"_5":17825,"_25222":103718,"_7710":103663},[48836],{"_12623":3632,"_48290":3588,"_18312":103812,"_5":17825,"_25222":103718,"_7710":103813},[48836],"Regular expression for parsing the message.",{"_12623":3633,"_48290":3588,"_18312":103815,"_5":17825,"_25222":103718,"_7710":103669},[48836],{"_12623":3634,"_48290":3588,"_18312":103817,"_5":17825,"_25222":103718,"_7710":103818},[48836],"Columns that will be extracted from the message for inserting into HBase.",{"_12623":3635,"_48290":3588,"_18312":103820,"_5":17825,"_25222":103718,"_7710":103675},[48836],{"_12623":3636,"_48290":3588,"_18312":103822,"_5":17825,"_25222":103718,"_7710":103823},[48836],"Headers that go as part of the UPSERT query. Data type for these columns is VARCHAR by default.",{"_12623":3637,"_48290":3588,"_18312":103825,"_5":17825,"_25222":103718,"_7710":103681},[48836],{"_12623":3638,"_48290":3588,"_18312":103827,"_5":17825,"_25222":103718,"_7710":103828},[48836],"Custom row key generator. Can be one of timestamp, date, uuid, random, or nanotimestamp. Configure this when a custom row key should be auto-generated for the primary key column.",{"_12623":3639,"_48290":3588,"_18312":103830,"_5":17825,"_25222":103718,"_7710":103831},[48836],"Note: This plugin supports Phoenix Flume event serializers.",{"_12623":3640,"_48290":3588,"_18312":103833,"_5":17825,"_25222":103718,"_7710":103834},[48836],"RegexEventSerializer parses Kafka messages based on the regex specified in the configuration file.",{"_12623":3641,"_48290":3588,"_18312":103836,"_5":17825,"_25222":103718,"_7710":103837},[48836],"JsonEventSerializer parses Kafka messages based on the schema specified in the configuration file.",{"_12623":3642,"_48290":3642,"_5":13058,"_7710":103839,"_48807":103840,"_18312":103841,"_25222":3642},"Map Reduce Integration",[92880,92881,92882,103256],[48836],{"_12623":3643,"_48290":3642,"_18312":103843,"_5":17825,"_25222":3642,"_7710":103844},[48836],"Read and write Phoenix tables from Hadoop MapReduce jobs.",{"_12623":3644,"_48290":3642,"_5":48804,"_18312":103846,"_25222":103847,"_7710":103848},[48836],"/docs/integrations/map-reduce-integration#a-stock","a) stock",{"_12623":3645,"_48290":3642,"_5":48804,"_18312":103850,"_25222":103851,"_7710":103852},[48836],"/docs/integrations/map-reduce-integration#b-stock_stats","b) stock_stats",{"_12623":3646,"_48290":3642,"_5":48804,"_18312":103854,"_25222":103855,"_7710":103856},[48836],"/docs/integrations/map-reduce-integration#below-is-a-simple-job-configuration","Below is a simple job configuration",{"_12623":3647,"_48290":3642,"_5":48804,"_18312":103858,"_25222":103859,"_7710":103860},[48836],"/docs/integrations/map-reduce-integration#job-configuration","Job Configuration",{"_12623":3648,"_48290":3642,"_5":48804,"_18312":103862,"_25222":103863,"_7710":103864},[48836],"/docs/integrations/map-reduce-integration#stockwritable","StockWritable",{"_12623":3649,"_48290":3642,"_5":48804,"_18312":103866,"_25222":103867,"_7710":103868},[48836],"/docs/integrations/map-reduce-integration#stock-mapper","Stock Mapper",{"_12623":3650,"_48290":3642,"_5":48804,"_18312":103870,"_25222":103871,"_7710":103872},[48836],"/docs/integrations/map-reduce-integration#stock-reducer","Stock Reducer",{"_12623":3651,"_48290":3642,"_5":48804,"_18312":103874,"_25222":103875,"_7710":103876},[48836],"/docs/integrations/map-reduce-integration#packaging-and-running","Packaging and Running",{"_12623":3652,"_48290":3642,"_18312":103878,"_5":17825,"_25222":3642,"_7710":103879},[48836],"Phoenix provides support for retrieving and writing to Phoenix tables from within MapReduce jobs. The framework now provides custom InputFormat and OutputFormat classes PhoenixInputFormat , PhoenixOutputFormat.",{"_12623":3653,"_48290":3642,"_18312":103881,"_5":17825,"_25222":3642,"_7710":103882},[48836],"PhoenixMapReduceUtil provides several utility methods to set the input and output configuration parameters to the job.",{"_12623":3654,"_48290":3642,"_18312":103884,"_5":17825,"_25222":3642,"_7710":103885},[48836],"When a Phoenix table is the source for the MapReduce job, we can provide a SELECT query or pass a table name and specific columns to import data. To retrieve data from the table within the mapper class, we need to have a class that implements DBWritable and pass it as an argument to PhoenixMapReduceUtil.setInput. The custom DBWritable class provides an implementation for readFields(ResultSet rs) that allows us to retrieve columns for each row. This custom DBWritable class will form the input value to the mapper class.",{"_12623":3655,"_48290":3642,"_18312":103887,"_5":17825,"_25222":3642,"_7710":103888},[48836],"Note: The SELECT query must not perform any aggregation or use DISTINCT as these are not supported by our map-reduce integration.",{"_12623":3656,"_48290":3642,"_18312":103890,"_5":17825,"_25222":3642,"_7710":103891},[48836],"Similarly, when writing to a Phoenix table, we use PhoenixMapReduceUtil.setOutput to set the output table and columns.",{"_12623":3657,"_48290":3642,"_18312":103893,"_5":17825,"_25222":3642,"_7710":103894},[48836],"Note: Phoenix internally builds the UPSERT query for you .",{"_12623":3658,"_48290":3642,"_18312":103896,"_5":17825,"_25222":3642,"_7710":103897},[48836],"The output key and value class for the job should always be NullWritable and the custom DBWritable class that implements the write method.",{"_12623":3659,"_48290":3642,"_18312":103899,"_5":17825,"_25222":3642,"_7710":103900},[48836],"Let's dive into an example where we have a table, STOCK, that holds the master data of quarterly recordings in a double array for each year, and we want to find the max price of each stock across all years. Let's store the output in STOCK_STATS, which is another Phoenix table.",{"_12623":3660,"_48290":3642,"_18312":103902,"_5":17825,"_25222":3642,"_7710":103903},[48836],"Note: You can definitely configure a job to read from HDFS and load into a Phoenix table.",{"_12623":3661,"_48290":3642,"_18312":103905,"_5":17825,"_25222":103851,"_7710":103906},[48836],"Sample Data",{"_12623":3662,"_48290":3642,"_18312":103908,"_5":17825,"_25222":103875,"_7710":103909},[48836],"Ensure phoenix-[version]-client.jar is in the classpath of your MapReduce job JAR.",{"_12623":3663,"_48290":3642,"_18312":103911,"_5":17825,"_25222":103875,"_7710":103912},[48836],"To run the job, use the hadoop jar command with the necessary arguments.",{"_12623":3664,"_48290":3664,"_5":13058,"_7710":103914,"_48807":103915,"_18312":103916,"_25222":3664},"Phoenix-DynamoDB REST Service",[92880,92881,92882,103256],[48836],{"_12623":3665,"_48290":3664,"_18312":103918,"_5":17825,"_25222":3664,"_7710":103919},[48836],"Run a DynamoDB-compatible REST endpoint on top of Apache Phoenix using the phoenix-dynamodb module from apache/phoenix-adapters.",{"_12623":3666,"_48290":3664,"_5":48804,"_18312":103921,"_25222":103922,"_7710":95150},[48836],"/docs/integrations/phoenix-dynamodb#phoenix-dynamodb-when",{"_12623":3667,"_48290":3664,"_5":48804,"_18312":103924,"_25222":103925,"_7710":103926},[48836],"/docs/integrations/phoenix-dynamodb#phoenix-dynamodb-where","Where to find it",{"_12623":3668,"_48290":3664,"_18312":103928,"_5":17825,"_25222":3664,"_7710":103929},[48836],"Phoenix-DynamoDB is a REST service that lets applications written against the\nAmazon DynamoDB HTTP API talk to a Phoenix cluster instead. It is distributed as the\nphoenix-dynamodb module of\napache/phoenix-adapters.",{"_12623":3669,"_48290":3664,"_18312":103931,"_5":17825,"_25222":3664,"_7710":103932},[48836],"This page describes when to choose it and points at the canonical source. Build\ninstructions, supported API surface, configuration reference, and deployment\nnotes live in the phoenix-adapters repo's own README and module documentation.",{"_12623":3670,"_48290":3664,"_18312":103934,"_5":17825,"_25222":103922,"_7710":103935},[48836],"Reach for Phoenix-DynamoDB when:",{"_12623":3671,"_48290":3664,"_18312":103937,"_5":17825,"_25222":103922,"_7710":103938},[48836],"You have an existing application built against the AWS DynamoDB SDK and want to\npoint it at a Phoenix cluster without rewriting the data-access layer.",{"_12623":3672,"_48290":3664,"_18312":103940,"_5":17825,"_25222":103922,"_7710":103941},[48836],"You want to serve DynamoDB-style document workloads from Phoenix and pair the\nREST front-end with the BSON document type for the\nunderlying storage and indexing.",{"_12623":3673,"_48290":3664,"_18312":103943,"_5":17825,"_25222":103922,"_7710":103944},[48836],"You need a REST endpoint in front of a Phoenix cluster that speaks a wire\nprotocol most clients already know how to talk to.",{"_12623":3674,"_48290":3664,"_18312":103946,"_5":17825,"_25222":103922,"_7710":103947},[48836],"For native Phoenix workloads, prefer the standard JDBC driver — it exposes the full\nSQL surface, not just whatever subset the DynamoDB API maps onto.",{"_12623":3675,"_48290":3664,"_18312":103949,"_5":17825,"_25222":103925,"_7710":103950},[48836],"Source and documentation:\ngithub.com/apache/phoenix-adapters",{"_12623":3676,"_48290":3664,"_18312":103952,"_5":17825,"_25222":103925,"_7710":103953},[48836],"Module: phoenix-dynamodb",{"_12623":3677,"_48290":3677,"_5":13058,"_7710":103955,"_48807":103956,"_18312":103957,"_25222":3677},"Pig Integration",[92880,92881,92882,103256],[48836],{"_12623":3678,"_48290":3677,"_18312":103959,"_5":17825,"_25222":3677,"_7710":103960},[48836],"Use Apache Pig StoreFunc and Loader with Phoenix-backed tables.",{"_12623":3679,"_48290":3677,"_5":48804,"_18312":103962,"_25222":103963,"_7710":103964},[48836],"/docs/integrations/pig-integration#pig-storefunc","Pig StoreFunc",{"_12623":3680,"_48290":3677,"_5":48804,"_18312":103966,"_25222":103967,"_7710":103968},[48836],"/docs/integrations/pig-integration#gotchas","Gotchas",{"_12623":3681,"_48290":3677,"_5":48804,"_18312":103970,"_25222":103971,"_7710":103972},[48836],"/docs/integrations/pig-integration#pig-loader","Pig Loader",{"_12623":3682,"_48290":3677,"_5":48804,"_18312":103974,"_25222":103975,"_7710":93959},[48836],"/docs/integrations/pig-integration#pig-integration-example",{"_12623":3683,"_48290":3677,"_5":48804,"_18312":103977,"_25222":103978,"_7710":103979},[48836],"/docs/integrations/pig-integration#future-work","Future Work",{"_12623":3684,"_48290":3677,"_18312":103981,"_5":17825,"_25222":3677,"_7710":103982},[48836],"Pig integration may be divided into two parts: a StoreFunc as a means to generate Phoenix-encoded data through Pig, and a Loader which enables Phoenix-encoded data to be read by Pig.",{"_12623":3685,"_48290":3677,"_18312":103984,"_5":17825,"_25222":103963,"_7710":103985},[48836],"The StoreFunc allows users to write data in Phoenix-encoded format to HBase tables using Pig scripts. This is a nice way to bulk upload data from a MapReduce job in parallel to a Phoenix table in HBase. All you need to specify is the endpoint address, HBase table name and a batch size. For example:",{"_12623":3686,"_48290":3677,"_18312":103987,"_5":17825,"_25222":103963,"_7710":103988},[48836],"The above reads a file testdata and writes the elements to table CORE.ENTITY_HISTORY in HBase running on localhost. The first StoreFunc argument is the server, and the second is the batch size for Phoenix upserts. The batch size is related to how many rows you can hold in memory. A good default is 1000 rows, but if your rows are wide, you may want to decrease this.",{"_12623":3687,"_48290":3677,"_18312":103990,"_5":17825,"_25222":103963,"_7710":103991},[48836],"Note that Pig types must be in sync with the target Phoenix data types. This StoreFunc tries best to cast based on input Pig types and target Phoenix data types, but it is recommended to provide an appropriate schema.",{"_12623":3688,"_48290":3677,"_18312":103993,"_5":17825,"_25222":103967,"_7710":103994},[48836],"It is advised that the upsert operation be idempotent. That is, trying to re-upsert data should not cause any inconsistencies. This is important in the case when a Pig job fails in process of writing to a Phoenix table. There is no notion of rollback (due to lack of transactions in HBase), and re-trying the upsert with PhoenixHBaseStorage must result in the same data in HBase table.",{"_12623":3689,"_48290":3677,"_18312":103996,"_5":17825,"_25222":103967,"_7710":103997},[48836],"For example, let’s assume we are writing records n1...n10 to HBase. If the job fails in the middle of this process, we are left in an inconsistent state where n1...n7 made it to the phoenix tables but n8...n10 were missed. If we retry the same operation, n1...n7 would be re-upserted and n8...n10 would be upserted this time.",{"_12623":3690,"_48290":3677,"_18312":103999,"_5":17825,"_25222":103971,"_7710":104000},[48836],"A Pig data loader allows users to read data from Phoenix-backed HBase tables within a Pig script.",{"_12623":3691,"_48290":3677,"_18312":104002,"_5":17825,"_25222":103971,"_7710":104003},[48836],"The LoadFunc provides two alternative ways to load data.",{"_12623":3692,"_48290":3677,"_18312":104005,"_5":17825,"_25222":103971,"_7710":104006},[48836],"Given a table name, the following will load the data for all the columns in the HIRES table:",{"_12623":3693,"_48290":3677,"_18312":104008,"_5":17825,"_25222":103971,"_7710":104009},[48836],"To restrict the list of columns, you may specify the column names as part of LOAD as shown below:",{"_12623":3694,"_48290":3677,"_18312":104011,"_5":17825,"_25222":103971,"_7710":104012},[48836],"Here, only data for ID and NAME columns are returned.",{"_12623":3695,"_48290":3677,"_18312":104014,"_5":17825,"_25222":103971,"_7710":104015},[48836],"Given a query, the following loads data for all those rows whose AGE column has a value of greater than 50:",{"_12623":3696,"_48290":3677,"_18312":104017,"_5":17825,"_25222":103971,"_7710":104018},[48836],"The LOAD func merely executes the given SQL query and returns the results. Though there is a provision to provide a query as part of LOAD, it is restricted to the following:",{"_12623":3697,"_48290":3677,"_18312":104020,"_5":17825,"_25222":103971,"_7710":104021},[48836],"Only a SELECT query is allowed. No DML statements such as UPSERT or DELETE.",{"_12623":3698,"_48290":3677,"_18312":104023,"_5":17825,"_25222":103971,"_7710":104024},[48836],"The query may not contain any GROUP BY, ORDER BY, LIMIT, or DISTINCT clauses.",{"_12623":3699,"_48290":3677,"_18312":104026,"_5":17825,"_25222":103971,"_7710":104027},[48836],"The query may not contain any AGGREGATE functions.",{"_12623":3700,"_48290":3677,"_18312":104029,"_5":17825,"_25222":103971,"_7710":104030},[48836],"In both cases, the ZooKeeper quorum should be passed to PhoenixHBaseLoader as a constructor argument.",{"_12623":3701,"_48290":3677,"_18312":104032,"_5":17825,"_25222":103971,"_7710":104033},[48836],"The LoadFunc makes a best effort to map Phoenix data types to Pig datatypes. You can check org.apache.phoenix.pig.util.TypeUtil to see how each Phoenix data type maps to Pig.",{"_12623":3702,"_48290":3677,"_18312":104035,"_5":17825,"_25222":103975,"_7710":104036},[48836],"Determine the number of users by a CLIENT ID.",{"_12623":3703,"_48290":3677,"_18312":104038,"_5":17825,"_25222":103975,"_7710":96444},[48836],{"_12623":3704,"_48290":3677,"_18312":104040,"_5":17825,"_25222":103975,"_7710":104041},[48836],"Pig Script",{"_12623":3705,"_48290":3677,"_18312":104043,"_5":17825,"_25222":103978,"_7710":104044},[48836],"Support for ARRAY data type.",{"_12623":3706,"_48290":3677,"_18312":104046,"_5":17825,"_25222":103978,"_7710":104047},[48836],"Usage of expressions within the SELECT clause when providing a full query.",{"_12623":3707,"_48290":3707,"_5":13058,"_7710":104049,"_48807":104050,"_18312":104051,"_25222":3707},"Python Driver",[92880,92881,92882,103256],[48836],{"_12623":3708,"_48290":3707,"_18312":104053,"_5":17825,"_25222":3707,"_7710":104054},[48836],"Use the Phoenix DB-API Python driver with Phoenix Query Server.",{"_12623":3709,"_48290":3707,"_5":48804,"_18312":104056,"_25222":104057,"_7710":97041},[48836],"/docs/integrations/python-driver#python-driver-installation",{"_12623":3710,"_48290":3707,"_5":48804,"_18312":104059,"_25222":104060,"_7710":104061},[48836],"/docs/integrations/python-driver#from-pypi","From PyPI",{"_12623":3711,"_48290":3707,"_5":48804,"_18312":104063,"_25222":104064,"_7710":104065},[48836],"/docs/integrations/python-driver#from-source","From source",{"_12623":3712,"_48290":3707,"_5":48804,"_18312":104067,"_25222":104068,"_7710":94578},[48836],"/docs/integrations/python-driver#python-driver-examples",{"_12623":3713,"_48290":3707,"_5":48804,"_18312":104070,"_25222":104071,"_7710":93002},[48836],"/docs/integrations/python-driver#python-driver-limitations",{"_12623":3714,"_48290":3707,"_5":48804,"_18312":104073,"_25222":104074,"_7710":96357},[48836],"/docs/integrations/python-driver#python-driver-resources",{"_12623":3715,"_48290":3707,"_18312":104076,"_5":17825,"_25222":3707,"_7710":104077},[48836],"The Python driver for Apache Phoenix implements the Python DB 2.0 API to access Phoenix via Phoenix Query Server.\nThe driver is tested with Python 2.7 and 3.5-3.8. This code was originally called python-phoenixdb\nand was graciously donated by its authors to the Apache Phoenix project.",{"_12623":3716,"_48290":3707,"_18312":104079,"_5":17825,"_25222":3707,"_7710":104080},[48836],"All future development of the project is being done in Apache Phoenix.",{"_12623":3717,"_48290":3707,"_18312":104082,"_5":17825,"_25222":104060,"_7710":104083},[48836],"The latest release is always available from PyPI, and can be installed by\npip/pip3 as usual.",{"_12623":3718,"_48290":3707,"_18312":104085,"_5":17825,"_25222":104064,"_7710":104086},[48836],"You can build phoenixdb from the official source release,\nor use the latest development version from the source\nrepository. The python-phoenixdb source\nlives in the python-phoenixdb directory of the phoenix-queryserver\nrepository.",{"_12623":3719,"_48290":3707,"_18312":104088,"_5":17825,"_25222":104071,"_7710":104089},[48836],"None presently known.",{"_12623":3720,"_48290":3707,"_18312":104091,"_5":17825,"_25222":104074,"_7710":104092},[48836],"PHOENIX-4636: Initial landing of the driver into Apache Phoenix.",{"_12623":3721,"_48290":3707,"_18312":104094,"_5":17825,"_25222":104074,"_7710":104095},[48836],"PHOENIX-4688: Implementation of Kerberos authentication via SPNEGO.",{"_12623":3722,"_48290":3722,"_5":13058,"_7710":104097,"_48807":104098,"_18312":104099,"_25222":3722},"Spark Integration",[92880,92881,92882,103256],[48836],{"_12623":3723,"_48290":3722,"_18312":104101,"_5":17825,"_25222":3722,"_7710":104102},[48836],"Use Apache Spark with Phoenix to read and write DataFrames.",{"_12623":3724,"_48290":3722,"_5":48804,"_18312":104104,"_25222":104105,"_7710":93065},[48836],"/docs/integrations/spark-integration#spark-integration-prerequisites",{"_12623":3725,"_48290":3722,"_5":48804,"_18312":104107,"_25222":104108,"_7710":104109},[48836],"/docs/integrations/spark-integration#why-not-jdbc","Why not JDBC?",{"_12623":3726,"_48290":3722,"_5":48804,"_18312":104111,"_25222":104112,"_7710":104113},[48836],"/docs/integrations/spark-integration#spark-setup","Spark setup",{"_12623":3727,"_48290":3722,"_5":48804,"_18312":104115,"_25222":104116,"_7710":104117},[48836],"/docs/integrations/spark-integration#reading-phoenix-tables","Reading Phoenix Tables",{"_12623":3728,"_48290":3722,"_5":48804,"_18312":104119,"_25222":104120,"_7710":104121},[48836],"/docs/integrations/spark-integration#load-as-a-dataframe-using-the-datasourcev2-api","Load as a DataFrame using the DataSourceV2 API",{"_12623":3729,"_48290":3722,"_5":48804,"_18312":104123,"_25222":104124,"_7710":104125},[48836],"/docs/integrations/spark-integration#saving-to-phoenix","Saving to Phoenix",{"_12623":3730,"_48290":3722,"_5":48804,"_18312":104127,"_25222":104128,"_7710":104129},[48836],"/docs/integrations/spark-integration#save-dataframes-to-phoenix-using-datasourcev2","Save DataFrames to Phoenix using DataSourceV2",{"_12623":3731,"_48290":3722,"_5":48804,"_18312":104131,"_25222":104132,"_7710":104133},[48836],"/docs/integrations/spark-integration#save-from-an-external-rdd-with-a-schema-to-a-phoenix-table","Save from an external RDD with a schema to a Phoenix table",{"_12623":3732,"_48290":3722,"_5":48804,"_18312":104135,"_25222":104136,"_7710":104137},[48836],"/docs/integrations/spark-integration#pyspark","PySpark",{"_12623":3733,"_48290":3722,"_5":48804,"_18312":104139,"_25222":104140,"_7710":104141},[48836],"/docs/integrations/spark-integration#load-a-dataframe","Load a DataFrame",{"_12623":3734,"_48290":3722,"_5":48804,"_18312":104143,"_25222":104144,"_7710":104145},[48836],"/docs/integrations/spark-integration#save-a-dataframe","Save a DataFrame",{"_12623":3735,"_48290":3722,"_5":48804,"_18312":104147,"_25222":104148,"_7710":95284},[48836],"/docs/integrations/spark-integration#spark-integration-notes",{"_12623":3736,"_48290":3722,"_5":48804,"_18312":104150,"_25222":104151,"_7710":93002},[48836],"/docs/integrations/spark-integration#spark-integration-limitations",{"_12623":3737,"_48290":3722,"_5":48804,"_18312":104153,"_25222":104154,"_7710":104155},[48836],"/docs/integrations/spark-integration#pagerank-example","PageRank example",{"_12623":3738,"_48290":3722,"_5":48804,"_18312":104157,"_25222":104158,"_7710":104159},[48836],"/docs/integrations/spark-integration#deprecated-usages","Deprecated Usages",{"_12623":3739,"_48290":3722,"_5":48804,"_18312":104161,"_25222":104162,"_7710":104163},[48836],"/docs/integrations/spark-integration#load-as-a-dataframe-directly-using-a-configuration-object","Load as a DataFrame directly using a Configuration object",{"_12623":3740,"_48290":3722,"_5":48804,"_18312":104165,"_25222":104166,"_7710":104167},[48836],"/docs/integrations/spark-integration#load-as-an-rdd-using-a-zookeeper-url","Load as an RDD, using a Zookeeper URL",{"_12623":3741,"_48290":3722,"_5":48804,"_18312":104169,"_25222":104170,"_7710":104171},[48836],"/docs/integrations/spark-integration#saving-rdds-to-phoenix","Saving RDDs to Phoenix",{"_12623":3742,"_48290":3722,"_18312":104173,"_5":17825,"_25222":3722,"_7710":104174},[48836],"The phoenix-spark plugin extends Phoenix's MapReduce support to allow Spark to load Phoenix tables\nas DataFrames, and enables persisting them back to Phoenix.",{"_12623":3743,"_48290":3722,"_18312":104176,"_5":17825,"_25222":104105,"_7710":104177},[48836],"Phoenix 4.4.0+",{"_12623":3744,"_48290":3722,"_18312":104179,"_5":17825,"_25222":104105,"_7710":104180},[48836],"Spark 1.3.1+ (prebuilt with Hadoop 2.4 recommended)",{"_12623":3745,"_48290":3722,"_18312":104182,"_5":17825,"_25222":104108,"_7710":104183},[48836],"Although Spark supports connecting directly to JDBC databases, it's only able to parallelize\nqueries by partitioning on a numeric column. It also requires a known lower bound, upper bound\nand partition count in order to create split queries.",{"_12623":3746,"_48290":3722,"_18312":104185,"_5":17825,"_25222":104108,"_7710":104186},[48836],"In contrast, the phoenix-spark integration is able to leverage the underlying splits provided by\nPhoenix in order to retrieve and save data across multiple workers. All that's required is a\ndatabase URL and a table name. Optional SELECT columns can be given, as well as pushdown predicates\nfor efficient filtering.",{"_12623":3747,"_48290":3722,"_18312":104188,"_5":17825,"_25222":104108,"_7710":104189},[48836],"The choice of which method to use to access Phoenix comes down to each specific use case.",{"_12623":3748,"_48290":3722,"_18312":104191,"_5":17825,"_25222":104112,"_7710":104192},[48836],"To ensure that all requisite Phoenix/HBase platform dependencies are available on the classpath\nfor Spark executors and drivers, set both spark.executor.extraClassPath and\nspark.driver.extraClassPath in spark-defaults.conf to include\nphoenix-<version>-client.jar.",{"_12623":3749,"_48290":3722,"_18312":104194,"_5":17825,"_25222":104112,"_7710":104195},[48836],"Note that for Phoenix versions 4.7 and 4.8 you must use the 'phoenix-<version>-client-spark.jar'.",{"_12623":3750,"_48290":3722,"_18312":104197,"_5":17825,"_25222":104112,"_7710":104198},[48836],"As of Phoenix 4.10, phoenix-<version>-client.jar is compiled against Spark 2.x.\nIf compatibility with Spark 1.x is needed, compile Phoenix with the spark16 Maven profile.",{"_12623":3751,"_48290":3722,"_18312":104200,"_5":17825,"_25222":104112,"_7710":104201},[48836],"To help your IDE, you can add the following provided dependency to your build:",{"_12623":3752,"_48290":3722,"_18312":104203,"_5":17825,"_25222":104112,"_7710":104204},[48836],"As of Phoenix 4.15.0, the connectors project is separated from the main Phoenix project (see phoenix-connectors)\nand will have its own releases. You can add the following dependency in your project:",{"_12623":3753,"_48290":3722,"_18312":104206,"_5":17825,"_25222":104112,"_7710":104207},[48836],"The first released connectors jar is connectors-1.0.0 (replace phoenix.connectors.version above with this version).",{"_12623":3754,"_48290":3722,"_18312":104209,"_5":17825,"_25222":104116,"_7710":104210},[48836],"Given a Phoenix table with the following DDL and DML:",{"_12623":3755,"_48290":3722,"_18312":104212,"_5":17825,"_25222":104120,"_7710":104213},[48836],"Scala example:",{"_12623":3756,"_48290":3722,"_18312":104215,"_5":17825,"_25222":104120,"_7710":104216},[48836],"Java example:",{"_12623":3757,"_48290":3722,"_18312":104218,"_5":17825,"_25222":104128,"_7710":104219},[48836],"The save method on DataFrame allows passing in a data source type. You can use\nphoenix for DataSourceV2 and must also pass in a table and zkUrl parameter to\nspecify which table and server to persist the DataFrame to. The column names are derived from\nthe DataFrame's schema field names, and must match the Phoenix column names.",{"_12623":3758,"_48290":3722,"_18312":104221,"_5":17825,"_25222":104128,"_7710":104222},[48836],"The save method also takes a SaveMode option, for which only SaveMode.Overwrite is supported.",{"_12623":3759,"_48290":3722,"_18312":104224,"_5":17825,"_25222":104128,"_7710":104225},[48836],"Given two Phoenix tables with the following DDL:",{"_12623":3760,"_48290":3722,"_18312":104227,"_5":17825,"_25222":104128,"_7710":104228},[48836],"you can load from an input table and save to an output table as a DataFrame as follows in Scala:",{"_12623":3761,"_48290":3722,"_18312":104230,"_5":17825,"_25222":104128,"_7710":104216},[48836],{"_12623":3762,"_48290":3722,"_18312":104232,"_5":17825,"_25222":104132,"_7710":104233},[48836],"Just like the previous example, you can pass in the data source type as phoenix and specify the table and\nzkUrl parameters indicating which table and server to persist the DataFrame to.",{"_12623":3763,"_48290":3722,"_18312":104235,"_5":17825,"_25222":104132,"_7710":104236},[48836],"Note that the schema of the RDD must match its column data and this must match the schema of the Phoenix table\nthat you save to.",{"_12623":3764,"_48290":3722,"_18312":104238,"_5":17825,"_25222":104132,"_7710":104239},[48836],"Given an output Phoenix table with the following DDL:",{"_12623":3765,"_48290":3722,"_18312":104241,"_5":17825,"_25222":104132,"_7710":104242},[48836],"you can save a dataframe from an RDD as follows in Scala:",{"_12623":3766,"_48290":3722,"_18312":104244,"_5":17825,"_25222":104132,"_7710":104216},[48836],{"_12623":3767,"_48290":3722,"_18312":104246,"_5":17825,"_25222":104136,"_7710":104247},[48836],"With Spark's DataFrame support, you can also use pyspark to read and write from Phoenix tables.",{"_12623":3768,"_48290":3722,"_18312":104249,"_5":17825,"_25222":104140,"_7710":104250},[48836],"Given a table TABLE1 and a ZooKeeper URL of phoenix-server:2181, you can load the table as a\nDataFrame using the following Python code in pyspark:",{"_12623":3769,"_48290":3722,"_18312":104252,"_5":17825,"_25222":104144,"_7710":104253},[48836],"Given the same table and ZooKeeper URL above, you can save a DataFrame to a Phoenix table\nusing the following code:",{"_12623":3770,"_48290":3722,"_18312":104255,"_5":17825,"_25222":104148,"_7710":104256},[48836],"If you want to use DataSourceV1, you can use source type \"org.apache.phoenix.spark\"\ninstead of \"phoenix\", however this is deprecated as of connectors-1.0.0.",{"_12623":3771,"_48290":3722,"_18312":104258,"_5":17825,"_25222":104148,"_7710":104259},[48836],"The (deprecated) functions phoenixTableAsDataFrame, phoenixTableAsRDD and saveToPhoenix all support\noptionally specifying a conf Hadoop configuration parameter with custom Phoenix client settings,\nas well as an optional zkUrl parameter for the Phoenix connection URL.",{"_12623":3772,"_48290":3722,"_18312":104261,"_5":17825,"_25222":104148,"_7710":104262},[48836],"If zkUrl isn't specified, it's assumed that the \"hbase.zookeeper.quorum\" property has been set\nin the conf parameter. Similarly, if no configuration is passed in, zkUrl must be specified.",{"_12623":3773,"_48290":3722,"_18312":104264,"_5":17825,"_25222":104148,"_7710":104265},[48836],"As of PHOENIX-5197, you can pass configurations from the driver\nto executors as a comma-separated list against the key phoenixConfigs i.e (PhoenixDataSource.PHOENIX_CONFIGS), for ex:",{"_12623":3774,"_48290":3722,"_18312":104267,"_5":17825,"_25222":104148,"_7710":104268},[48836],"This list of properties is parsed and populated into a properties map which is passed to DriverManager.getConnection(connString, propsMap).\nNote that the same property values will be used for both the driver and all executors and\nthese configurations are used each time a connection is made (both on the driver and executors).",{"_12623":3775,"_48290":3722,"_18312":104270,"_5":17825,"_25222":104151,"_7710":104271},[48836],"Basic support for column and predicate pushdown using the Data Source API",{"_12623":3776,"_48290":3722,"_18312":104273,"_5":17825,"_25222":104151,"_7710":104274},[48836],"The Data Source API does not support passing custom Phoenix settings in configuration, you must\ncreate the DataFrame or RDD directly if you need fine-grained configuration.",{"_12623":3777,"_48290":3722,"_18312":104276,"_5":17825,"_25222":104151,"_7710":104277},[48836],"No support for aggregate or distinct queries as explained in our Map Reduce Integration documentation.",{"_12623":3778,"_48290":3722,"_18312":104279,"_5":17825,"_25222":104154,"_7710":104280},[48836],"This example makes use of the Enron email data set, provided by the\nStanford Network Analysis Project,\nand executes the GraphX implementation of PageRank on it to find interesting entities. It then\nsaves the results back to Phoenix.",{"_12623":3779,"_48290":3722,"_18312":104282,"_5":17825,"_25222":104154,"_7710":104283},[48836],"Download and extract the file enron.csv.gz",{"_12623":3780,"_48290":3722,"_18312":104285,"_5":17825,"_25222":104154,"_7710":104286},[48836],"Create the necessary Phoenix schema",{"_12623":3781,"_48290":3722,"_18312":104288,"_5":17825,"_25222":104154,"_7710":104289},[48836],"Load the email data into Phoenix (assuming localhost for ZooKeeper quorum URL)",{"_12623":3782,"_48290":3722,"_18312":104291,"_5":17825,"_25222":104154,"_7710":104292},[48836],"In spark-shell, with the phoenix-client in the Spark driver classpath, run the following:",{"_12623":3783,"_48290":3722,"_18312":104294,"_5":17825,"_25222":104154,"_7710":104295},[48836],"Query the top ranked entities in SQL",{"_12623":3784,"_48290":3722,"_18312":104297,"_5":17825,"_25222":104170,"_7710":104298},[48836],"saveToPhoenix is an implicit method on RDD[Product], or an RDD of Tuples. The data types must\ncorrespond to the Java types Phoenix supports Datatypes",{"_12623":3785,"_48290":3722,"_18312":104300,"_5":17825,"_25222":104170,"_7710":104301},[48836],"Given a Phoenix table with the following DDL:",{"_12623":3786,"_48290":3786,"_5":13058,"_7710":104303,"_48807":104304,"_18312":104305,"_25222":3786},"Joins",[92880,92881,92994],[48836],{"_12623":3787,"_48290":3786,"_18312":104307,"_5":17825,"_25222":3786,"_7710":104308},[48836],"Phoenix join support, join execution strategies, optimization techniques, and configuration for hash and sort-merge joins.",{"_12623":3788,"_48290":3786,"_5":48804,"_18312":104310,"_25222":104311,"_7710":104312},[48836],"/docs/joins#joining-tables-with-indices","Joining Tables with Indices",{"_12623":3789,"_48290":3786,"_5":48804,"_18312":104314,"_25222":104315,"_7710":104316},[48836],"/docs/joins#grouped-joins-and-derived-tables","Grouped Joins and Derived Tables",{"_12623":3790,"_48290":3786,"_5":48804,"_18312":104318,"_25222":104319,"_7710":104320},[48836],"/docs/joins#hash-join-vs-sort-merge-join","Hash Join vs. Sort-Merge Join",{"_12623":3791,"_48290":3786,"_5":48804,"_18312":104322,"_25222":104323,"_7710":104324},[48836],"/docs/joins#foreign-key-to-primary-key-join-optimization","Foreign Key to Primary Key Join Optimization",{"_12623":3792,"_48290":3786,"_5":48804,"_18312":104326,"_25222":104327,"_7710":92932},[48836],"/docs/joins#joins-configuration",{"_12623":3793,"_48290":3786,"_5":48804,"_18312":104329,"_25222":104330,"_7710":104331},[48836],"/docs/joins#optimizing-your-query","Optimizing Your Query",{"_12623":3794,"_48290":3786,"_5":48804,"_18312":104333,"_25222":104334,"_7710":93002},[48836],"/docs/joins#joins-limitations",{"_12623":3795,"_48290":3786,"_18312":104336,"_5":17825,"_25222":3786,"_7710":104337},[48836],"The standard SQL join syntax (with some limitations) is now supported by Phoenix to combine records from two or more tables based on their fields having common values.",{"_12623":3796,"_48290":3786,"_18312":104339,"_5":17825,"_25222":3786,"_7710":104340},[48836],"For example, we have the following tables to store our order records, our customer information and the item information we sell in those orders.",{"_12623":3797,"_48290":3786,"_18312":104342,"_5":17825,"_25222":3786,"_7710":104343},[48836],"The \"Orders\" table:",{"_12623":3798,"_48290":3786,"_18312":104345,"_5":17825,"_25222":3786,"_7710":104346},[48836],"OrderID",{"_12623":3799,"_48290":3786,"_18312":104348,"_5":17825,"_25222":3786,"_7710":104349},[48836],"CustomerID",{"_12623":3800,"_48290":3786,"_18312":104351,"_5":17825,"_25222":3786,"_7710":104352},[48836],"ItemID",{"_12623":3801,"_48290":3786,"_18312":104354,"_5":17825,"_25222":3786,"_7710":104355},[48836],"Quantity",{"_12623":3802,"_48290":3786,"_18312":104357,"_5":17825,"_25222":3786,"_7710":104358},[48836],"Date",{"_12623":3803,"_48290":3786,"_18312":104360,"_5":17825,"_25222":3786,"_7710":45778},[48836],{"_12623":3804,"_48290":3786,"_18312":104362,"_5":17825,"_25222":3786,"_7710":104363},[48836],"C004",{"_12623":3805,"_48290":3786,"_18312":104365,"_5":17825,"_25222":3786,"_7710":104366},[48836],"I001",{"_12623":3806,"_48290":3786,"_18312":104368,"_5":17825,"_25222":3786,"_7710":48279},[48836],{"_12623":3807,"_48290":3786,"_18312":104370,"_5":17825,"_25222":3786,"_7710":46360},[48836],{"_12623":3808,"_48290":3786,"_18312":104372,"_5":17825,"_25222":3786,"_7710":45787},[48836],{"_12623":3809,"_48290":3786,"_18312":104374,"_5":17825,"_25222":3786,"_7710":104375},[48836],"C003",{"_12623":3810,"_48290":3786,"_18312":104377,"_5":17825,"_25222":3786,"_7710":104378},[48836],"I006",{"_12623":3811,"_48290":3786,"_18312":104380,"_5":17825,"_25222":3786,"_7710":46866},[48836],{"_12623":3812,"_48290":3786,"_18312":104382,"_5":17825,"_25222":3786,"_7710":46370},[48836],{"_12623":3813,"_48290":3786,"_18312":104384,"_5":17825,"_25222":3786,"_7710":45796},[48836],{"_12623":3814,"_48290":3786,"_18312":104386,"_5":17825,"_25222":3786,"_7710":104387},[48836],"C002",{"_12623":3815,"_48290":3786,"_18312":104389,"_5":17825,"_25222":3786,"_7710":104390},[48836],"I002",{"_12623":3816,"_48290":3786,"_18312":104392,"_5":17825,"_25222":3786,"_7710":46278},[48836],{"_12623":3817,"_48290":3786,"_18312":104394,"_5":17825,"_25222":3786,"_7710":46380},[48836],{"_12623":3818,"_48290":3786,"_18312":104396,"_5":17825,"_25222":3786,"_7710":45805},[48836],{"_12623":3819,"_48290":3786,"_18312":104398,"_5":17825,"_25222":3786,"_7710":104363},[48836],{"_12623":3820,"_48290":3786,"_18312":104400,"_5":17825,"_25222":3786,"_7710":104378},[48836],{"_12623":3821,"_48290":3786,"_18312":104402,"_5":17825,"_25222":3786,"_7710":45715},[48836],{"_12623":3822,"_48290":3786,"_18312":104404,"_5":17825,"_25222":3786,"_7710":46390},[48836],{"_12623":3823,"_48290":3786,"_18312":104406,"_5":17825,"_25222":3786,"_7710":45814},[48836],{"_12623":3824,"_48290":3786,"_18312":104408,"_5":17825,"_25222":3786,"_7710":104409},[48836],"C005",{"_12623":3825,"_48290":3786,"_18312":104411,"_5":17825,"_25222":3786,"_7710":104412},[48836],"I003",{"_12623":3826,"_48290":3786,"_18312":104414,"_5":17825,"_25222":3786,"_7710":45738},[48836],{"_12623":3827,"_48290":3786,"_18312":104416,"_5":17825,"_25222":3786,"_7710":46400},[48836],{"_12623":3828,"_48290":3786,"_18312":104418,"_5":17825,"_25222":3786,"_7710":104419},[48836],"The \"Customers\" table:",{"_12623":3829,"_48290":3786,"_18312":104421,"_5":17825,"_25222":3786,"_7710":104349},[48836],{"_12623":3830,"_48290":3786,"_18312":104423,"_5":17825,"_25222":3786,"_7710":104424},[48836],"CustomerName",{"_12623":3831,"_48290":3786,"_18312":104426,"_5":17825,"_25222":3786,"_7710":104427},[48836],"Country",{"_12623":3832,"_48290":3786,"_18312":104429,"_5":17825,"_25222":3786,"_7710":104430},[48836],"C001",{"_12623":3833,"_48290":3786,"_18312":104432,"_5":17825,"_25222":3786,"_7710":104433},[48836],"Telefunken",{"_12623":3834,"_48290":3786,"_18312":104435,"_5":17825,"_25222":3786,"_7710":104436},[48836],"Germany",{"_12623":3835,"_48290":3786,"_18312":104438,"_5":17825,"_25222":3786,"_7710":104387},[48836],{"_12623":3836,"_48290":3786,"_18312":104440,"_5":17825,"_25222":3786,"_7710":104441},[48836],"Logica",{"_12623":3837,"_48290":3786,"_18312":104443,"_5":17825,"_25222":3786,"_7710":104444},[48836],"Belgium",{"_12623":3838,"_48290":3786,"_18312":104446,"_5":17825,"_25222":3786,"_7710":104375},[48836],{"_12623":3839,"_48290":3786,"_18312":104448,"_5":17825,"_25222":3786,"_7710":104449},[48836],"Salora Oy",{"_12623":3840,"_48290":3786,"_18312":104451,"_5":17825,"_25222":3786,"_7710":104452},[48836],"Finland",{"_12623":3841,"_48290":3786,"_18312":104454,"_5":17825,"_25222":3786,"_7710":104363},[48836],{"_12623":3842,"_48290":3786,"_18312":104456,"_5":17825,"_25222":3786,"_7710":104457},[48836],"Alps Nordic AB",{"_12623":3843,"_48290":3786,"_18312":104459,"_5":17825,"_25222":3786,"_7710":104460},[48836],"Sweden",{"_12623":3844,"_48290":3786,"_18312":104462,"_5":17825,"_25222":3786,"_7710":104409},[48836],{"_12623":3845,"_48290":3786,"_18312":104464,"_5":17825,"_25222":3786,"_7710":104465},[48836],"Deister Electronics",{"_12623":3846,"_48290":3786,"_18312":104467,"_5":17825,"_25222":3786,"_7710":104436},[48836],{"_12623":3847,"_48290":3786,"_18312":104469,"_5":17825,"_25222":3786,"_7710":104470},[48836],"C006",{"_12623":3848,"_48290":3786,"_18312":104472,"_5":17825,"_25222":3786,"_7710":104473},[48836],"Thales Nederland",{"_12623":3849,"_48290":3786,"_18312":104475,"_5":17825,"_25222":3786,"_7710":104476},[48836],"Netherlands",{"_12623":3850,"_48290":3786,"_18312":104478,"_5":17825,"_25222":3786,"_7710":104479},[48836],"The \"Items\" table:",{"_12623":3851,"_48290":3786,"_18312":104481,"_5":17825,"_25222":3786,"_7710":104352},[48836],{"_12623":3852,"_48290":3786,"_18312":104483,"_5":17825,"_25222":3786,"_7710":104484},[48836],"ItemName",{"_12623":3853,"_48290":3786,"_18312":104486,"_5":17825,"_25222":3786,"_7710":104487},[48836],"Price",{"_12623":3854,"_48290":3786,"_18312":104489,"_5":17825,"_25222":3786,"_7710":104366},[48836],{"_12623":3855,"_48290":3786,"_18312":104491,"_5":17825,"_25222":3786,"_7710":104492},[48836],"BX016",{"_12623":3856,"_48290":3786,"_18312":104494,"_5":17825,"_25222":3786,"_7710":104495},[48836],"15.96",{"_12623":3857,"_48290":3786,"_18312":104497,"_5":17825,"_25222":3786,"_7710":104390},[48836],{"_12623":3858,"_48290":3786,"_18312":104499,"_5":17825,"_25222":3786,"_7710":104500},[48836],"MU947",{"_12623":3859,"_48290":3786,"_18312":104502,"_5":17825,"_25222":3786,"_7710":104503},[48836],"20.35",{"_12623":3860,"_48290":3786,"_18312":104505,"_5":17825,"_25222":3786,"_7710":104412},[48836],{"_12623":3861,"_48290":3786,"_18312":104507,"_5":17825,"_25222":3786,"_7710":104508},[48836],"MU3508",{"_12623":3862,"_48290":3786,"_18312":104510,"_5":17825,"_25222":3786,"_7710":104511},[48836],"9.60",{"_12623":3863,"_48290":3786,"_18312":104513,"_5":17825,"_25222":3786,"_7710":104514},[48836],"I004",{"_12623":3864,"_48290":3786,"_18312":104516,"_5":17825,"_25222":3786,"_7710":104517},[48836],"XC7732",{"_12623":3865,"_48290":3786,"_18312":104519,"_5":17825,"_25222":3786,"_7710":104520},[48836],"55.24",{"_12623":3866,"_48290":3786,"_18312":104522,"_5":17825,"_25222":3786,"_7710":104523},[48836],"I005",{"_12623":3867,"_48290":3786,"_18312":104525,"_5":17825,"_25222":3786,"_7710":104526},[48836],"XT0019",{"_12623":3868,"_48290":3786,"_18312":104528,"_5":17825,"_25222":3786,"_7710":104529},[48836],"12.65",{"_12623":3869,"_48290":3786,"_18312":104531,"_5":17825,"_25222":3786,"_7710":104378},[48836],{"_12623":3870,"_48290":3786,"_18312":104533,"_5":17825,"_25222":3786,"_7710":104534},[48836],"XT2217",{"_12623":3871,"_48290":3786,"_18312":104536,"_5":17825,"_25222":3786,"_7710":104537},[48836],"12.35",{"_12623":3872,"_48290":3786,"_18312":104539,"_5":17825,"_25222":3786,"_7710":104540},[48836],"You may get a combined view of the \"Orders\" table and the \"Customers\" table by running the following join query:",{"_12623":3873,"_48290":3786,"_18312":104542,"_5":17825,"_25222":3786,"_7710":104543},[48836],"This will produce results like:",{"_12623":3874,"_48290":3786,"_18312":104545,"_5":17825,"_25222":3786,"_7710":104546},[48836],"O.OrderID",{"_12623":3875,"_48290":3786,"_18312":104548,"_5":17825,"_25222":3786,"_7710":104549},[48836],"C.CustomerName",{"_12623":3876,"_48290":3786,"_18312":104551,"_5":17825,"_25222":3786,"_7710":104552},[48836],"C.Country",{"_12623":3877,"_48290":3786,"_18312":104554,"_5":17825,"_25222":3786,"_7710":104555},[48836],"O.Date",{"_12623":3878,"_48290":3786,"_18312":104557,"_5":17825,"_25222":3786,"_7710":45778},[48836],{"_12623":3879,"_48290":3786,"_18312":104559,"_5":17825,"_25222":3786,"_7710":104457},[48836],{"_12623":3880,"_48290":3786,"_18312":104561,"_5":17825,"_25222":3786,"_7710":104460},[48836],{"_12623":3881,"_48290":3786,"_18312":104563,"_5":17825,"_25222":3786,"_7710":46360},[48836],{"_12623":3882,"_48290":3786,"_18312":104565,"_5":17825,"_25222":3786,"_7710":45787},[48836],{"_12623":3883,"_48290":3786,"_18312":104567,"_5":17825,"_25222":3786,"_7710":104449},[48836],{"_12623":3884,"_48290":3786,"_18312":104569,"_5":17825,"_25222":3786,"_7710":104452},[48836],{"_12623":3885,"_48290":3786,"_18312":104571,"_5":17825,"_25222":3786,"_7710":46370},[48836],{"_12623":3886,"_48290":3786,"_18312":104573,"_5":17825,"_25222":3786,"_7710":45796},[48836],{"_12623":3887,"_48290":3786,"_18312":104575,"_5":17825,"_25222":3786,"_7710":104441},[48836],{"_12623":3888,"_48290":3786,"_18312":104577,"_5":17825,"_25222":3786,"_7710":104444},[48836],{"_12623":3889,"_48290":3786,"_18312":104579,"_5":17825,"_25222":3786,"_7710":46380},[48836],{"_12623":3890,"_48290":3786,"_18312":104581,"_5":17825,"_25222":3786,"_7710":45805},[48836],{"_12623":3891,"_48290":3786,"_18312":104583,"_5":17825,"_25222":3786,"_7710":104457},[48836],{"_12623":3892,"_48290":3786,"_18312":104585,"_5":17825,"_25222":3786,"_7710":104460},[48836],{"_12623":3893,"_48290":3786,"_18312":104587,"_5":17825,"_25222":3786,"_7710":46390},[48836],{"_12623":3894,"_48290":3786,"_18312":104589,"_5":17825,"_25222":3786,"_7710":45814},[48836],{"_12623":3895,"_48290":3786,"_18312":104591,"_5":17825,"_25222":3786,"_7710":104465},[48836],{"_12623":3896,"_48290":3786,"_18312":104593,"_5":17825,"_25222":3786,"_7710":104436},[48836],{"_12623":3897,"_48290":3786,"_18312":104595,"_5":17825,"_25222":3786,"_7710":46400},[48836],{"_12623":3898,"_48290":3786,"_18312":104597,"_5":17825,"_25222":104311,"_7710":104598},[48836],"Secondary indices will be automatically utilized when running join queries. For example, if we create indices on the \"Orders\" table and the \"Items\" table respectively, which are defined as follows:",{"_12623":3899,"_48290":3786,"_18312":104600,"_5":17825,"_25222":104311,"_7710":104601},[48836],"We can find out each item's total sales value by joining the \"Items\" table and the \"Orders\" table and then grouping the joined result with \"ItemName\" (and also adding some filtering conditions):",{"_12623":3900,"_48290":3786,"_18312":104603,"_5":17825,"_25222":104311,"_7710":104604},[48836],"The results will be like:",{"_12623":3901,"_48290":3786,"_18312":104606,"_5":17825,"_25222":104311,"_7710":104484},[48836],{"_12623":3902,"_48290":3786,"_18312":104608,"_5":17825,"_25222":104311,"_7710":104609},[48836],"OrderValue",{"_12623":3903,"_48290":3786,"_18312":104611,"_5":17825,"_25222":104311,"_7710":104492},[48836],{"_12623":3904,"_48290":3786,"_18312":104613,"_5":17825,"_25222":104311,"_7710":45686},[48836],{"_12623":3905,"_48290":3786,"_18312":104615,"_5":17825,"_25222":104311,"_7710":104508},[48836],{"_12623":3906,"_48290":3786,"_18312":104617,"_5":17825,"_25222":104311,"_7710":45833},[48836],{"_12623":3907,"_48290":3786,"_18312":104619,"_5":17825,"_25222":104311,"_7710":104534},[48836],{"_12623":3908,"_48290":3786,"_18312":104621,"_5":17825,"_25222":104311,"_7710":46477},[48836],{"_12623":3909,"_48290":3786,"_18312":104623,"_5":17825,"_25222":104311,"_7710":104624},[48836],"The execution plan for this query (by running EXPLAIN <query>) will be:",{"_12623":3910,"_48290":3786,"_18312":104626,"_5":17825,"_25222":104311,"_7710":104627},[48836],"In this case, the index table iItems is used in place of the data table Items since the index table iItems is indexed on column ItemName and will hence benefit the GROUP BY clause in this query. Meanwhile, the index table i2Orders is favored over the data table Orders and another index table iOrders because a range scan instead of a full scan can be applied as a result of the WHERE clause.",{"_12623":3911,"_48290":3786,"_18312":104629,"_5":17825,"_25222":104315,"_7710":104630},[48836],"Phoenix also supports complex join syntax such as grouped joins (or sub joins) and joins with derived-tables. You can group joins by using parenthesis to prioritize certain joins before other joins are executed. You can also replace any one (or more) of your join tables with a subquery (derived table), which could be yet another join query.",{"_12623":3912,"_48290":3786,"_18312":104632,"_5":17825,"_25222":104315,"_7710":104633},[48836],"For grouped joins, you can write something like:",{"_12623":3913,"_48290":3786,"_18312":104635,"_5":17825,"_25222":104315,"_7710":104636},[48836],"By replacing the sub join with a subquery (derived table), we get an equivalent query as:",{"_12623":3914,"_48290":3786,"_18312":104638,"_5":17825,"_25222":104315,"_7710":104639},[48836],"As an alternative to the earlier example where we find each item's sales figures, instead of using GROUP BY after joining two tables, we can join the \"Items\" table with grouped results from the \"Orders\" table:",{"_12623":3915,"_48290":3786,"_18312":104641,"_5":17825,"_25222":104319,"_7710":104642},[48836],"Basic hash join usually outperforms other types of join algorithms, but it has its limitations too, the most significant of which is the assumption that one of the relations must be small enough to fit into memory. Thus Phoenix now has both hash join and sort-merge join implemented to facilitate fast join operations as well as join between two large tables.",{"_12623":3916,"_48290":3786,"_18312":104644,"_5":17825,"_25222":104319,"_7710":104645},[48836],"Phoenix currently uses hash join whenever possible since it is usually faster. You can force sort-merge join with hint USE_SORT_MERGE_JOIN. Choosing between algorithms and detecting the smaller relation for hash join is expected to be increasingly guided by table statistics.",{"_12623":3917,"_48290":3786,"_18312":104647,"_5":17825,"_25222":104323,"_7710":104648},[48836],"Oftentimes a join will occur from a child table to a parent table, mapping the foreign key of the child table to the primary key of the parent. So instead of doing a full scan on the parent table, Phoenix will drive a skip-scan or a range-scan based on the foreign key values it got from the child table result.",{"_12623":3918,"_48290":3786,"_18312":104650,"_5":17825,"_25222":104323,"_7710":104651},[48836],"Phoenix will extract and sort multiple key parts from the join keys so that it can get the most accurate key hints/ranges possible for the parent table scan.",{"_12623":3919,"_48290":3786,"_18312":104653,"_5":17825,"_25222":104323,"_7710":104654},[48836],"For example, we have parent table \"Employee\" and child table \"Patent\" defined as:",{"_12623":3920,"_48290":3786,"_18312":104656,"_5":17825,"_25222":104323,"_7710":104657},[48836],"Now we'd like to find employees who filed patents after January 2000 and list their names by patent count:",{"_12623":3921,"_48290":3786,"_18312":104659,"_5":17825,"_25222":104323,"_7710":104660},[48836],"The above statement will do a skip-scan over the \"Employee\" table and will use both join key \"Region\" and \"LocalID\" for runtime key hint calculation. Below is the execution time of this query with and without this optimization on an \"Employee\" table of about 5000000 records and a \"Patent\" table of about 1000 records:",{"_12623":3922,"_48290":3786,"_18312":104662,"_5":17825,"_25222":104323,"_7710":104663},[48836],"W/O Optimization",{"_12623":3923,"_48290":3786,"_18312":104665,"_5":17825,"_25222":104323,"_7710":104666},[48836],"W/ Optimization",{"_12623":3924,"_48290":3786,"_18312":104668,"_5":17825,"_25222":104323,"_7710":104669},[48836],"8.1s",{"_12623":3925,"_48290":3786,"_18312":104671,"_5":17825,"_25222":104323,"_7710":104672},[48836],"0.4s",{"_12623":3926,"_48290":3786,"_18312":104674,"_5":17825,"_25222":104323,"_7710":104675},[48836],"However, there are times when foreign key values from the child table account for the complete primary key space in the parent table, so skip scans may be slower. You can turn off this optimization with hint NO_CHILD_PARENT_OPTIMIZATION. Table statistics are expected to help make smarter choices between these schemes.",{"_12623":3927,"_48290":3786,"_18312":104677,"_5":17825,"_25222":104327,"_7710":104678},[48836],"As mentioned earlier, if we decide to use the hash join approach for our join queries, the prerequisite is that either of the relations can be small enough to fit into memory in order to be broadcast over all servers that have the data of concern from the other relation. And aside from making sure that the region server heap size is big enough to hold the smaller relation, we might also need to pay a attention to a few configuration parameters that are crucial to running hash joins.",{"_12623":3928,"_48290":3786,"_18312":104680,"_5":17825,"_25222":104327,"_7710":104681},[48836],"The server-side caches hold the hash table built on the smaller relation. Cache size and lifetime are controlled by the following parameters. A relation may be a physical table, a view, a subquery, or a joined result of other relations in a multi-join query.",{"_12623":3929,"_48290":3786,"_18312":104683,"_5":17825,"_25222":104327,"_7710":101070},[48836],{"_12623":3930,"_48290":3786,"_18312":104685,"_5":17825,"_25222":104327,"_7710":104686},[48836],"Maximum size (in bytes) of the raw results of a relation before being compressed and sent over to the region servers.",{"_12623":3931,"_48290":3786,"_18312":104688,"_5":17825,"_25222":104327,"_7710":104689},[48836],"Attempting to serializing the raw results of a relation with a size bigger than this setting will result in a MaxServerCacheSizeExceededException.",{"_12623":3932,"_48290":3786,"_18312":104691,"_5":17825,"_25222":104327,"_7710":104692},[48836],"Default: 104,857,600",{"_12623":3933,"_48290":3786,"_18312":104694,"_5":17825,"_25222":104327,"_7710":100981},[48836],{"_12623":3934,"_48290":3786,"_18312":104696,"_5":17825,"_25222":104327,"_7710":104697},[48836],"Percentage of total heap memory (i.e. Runtime.getRuntime().maxMemory()) that all threads may use.",{"_12623":3935,"_48290":3786,"_18312":104699,"_5":17825,"_25222":104327,"_7710":104700},[48836],"The summed size of all living caches must be smaller than this global memory pool size. Otherwise, you would get an InsufficientMemoryException.",{"_12623":3936,"_48290":3786,"_18312":104702,"_5":17825,"_25222":104327,"_7710":104703},[48836],"Default: 15",{"_12623":3937,"_48290":3786,"_18312":104705,"_5":17825,"_25222":104327,"_7710":101078},[48836],{"_12623":3938,"_48290":3786,"_18312":104707,"_5":17825,"_25222":104327,"_7710":104708},[48836],"Maximum living time (in milliseconds) of server caches. A cache entry expires after this amount of time has passed since last access.",{"_12623":3939,"_48290":3786,"_18312":104710,"_5":17825,"_25222":104327,"_7710":104711},[48836],"Consider adjusting this parameter when a server-side IOException (\"Could not find hash cache for joinId\") happens. Getting warnings like \"Earlier hash cache(s) might have expired on servers\" might also be a sign that this number should be increased.",{"_12623":3940,"_48290":3786,"_18312":104713,"_5":17825,"_25222":104327,"_7710":104714},[48836],"Default: 30,000",{"_12623":3941,"_48290":3786,"_18312":104716,"_5":17825,"_25222":104327,"_7710":104717},[48836],"See our Configuration and Tuning Guide for more details.",{"_12623":3942,"_48290":3786,"_18312":104719,"_5":17825,"_25222":104327,"_7710":104720},[48836],"Although changing parameters can sometimes be a solution to getting rid of the exceptions mentioned above, it is highly recommended that you first consider optimizing the join queries according to the information provided in the following section.",{"_12623":3943,"_48290":3786,"_18312":104722,"_5":17825,"_25222":104330,"_7710":104723},[48836],"Now that we know hash joins depend heavily on available memory, instead of immediately changing configuration, it can be enough to understand execution internals and adjust table order in your join query.",{"_12623":3944,"_48290":3786,"_18312":104725,"_5":17825,"_25222":104330,"_7710":104726},[48836],"Below is the default join order (without table statistics) and which side of the query is treated as the \"smaller\" relation and put into server cache:",{"_12623":3945,"_48290":3786,"_18312":104728,"_5":17825,"_25222":104330,"_7710":104729},[48836],"lhs INNER JOIN rhsrhs will be built as hash table in server cache.",{"_12623":3946,"_48290":3786,"_18312":104731,"_5":17825,"_25222":104330,"_7710":104732},[48836],"lhs LEFT OUTER JOIN rhsrhs will be built as hash table in server cache.",{"_12623":3947,"_48290":3786,"_18312":104734,"_5":17825,"_25222":104330,"_7710":104735},[48836],"lhs RIGHT OUTER JOIN rhslhs will be built as hash table in server cache.",{"_12623":3948,"_48290":3786,"_18312":104737,"_5":17825,"_25222":104330,"_7710":104738},[48836],"Join order is more complicated with multi-join queries. You can run EXPLAIN <join_query> to inspect the actual execution plan. For multi-inner-join queries, Phoenix applies star-join optimization by default, which means the leading (left-hand-side) table is scanned once while joining all right-hand-side tables at the same time. You can disable this optimization with hint NO_STAR_JOIN if total size of right-hand-side tables exceeds memory limits.",{"_12623":3949,"_48290":3786,"_18312":104740,"_5":17825,"_25222":104330,"_7710":104741},[48836],"Let's take the previous query for example:",{"_12623":3950,"_48290":3786,"_18312":104743,"_5":17825,"_25222":104330,"_7710":104744},[48836],"The default join order (using star-join optimization) will be:",{"_12623":3951,"_48290":3786,"_18312":104746,"_5":17825,"_25222":104330,"_7710":104747},[48836],"Alternatively, if we use hint NO_STAR_JOIN:",{"_12623":3952,"_48290":3786,"_18312":104749,"_5":17825,"_25222":104330,"_7710":104750},[48836],"The join order will be:",{"_12623":3953,"_48290":3786,"_18312":104752,"_5":17825,"_25222":104330,"_7710":104753},[48836],"It is also worth mentioning that not the entire dataset of the table should be counted into the memory consumption. Instead, only those columns used by the query, and of only the records that satisfy the predicates will be built into the server hash table.",{"_12623":3954,"_48290":3786,"_18312":104755,"_5":17825,"_25222":104334,"_7710":104756},[48836],"In our Phoenix 3.3.0 and 4.3.0 releases, joins have the following restrictions and improvements to be made:",{"_12623":3955,"_48290":3786,"_18312":104758,"_5":17825,"_25222":104334,"_7710":104759},[48836],"PHOENIX-1555: Fallback to many-to-many join if hash join fails due to insufficient memory.",{"_12623":3956,"_48290":3786,"_18312":104761,"_5":17825,"_25222":104334,"_7710":104762},[48836],"PHOENIX-1556: Base hash join versus many-to-many decision on how many guideposts will be traversed for RHS table(s).",{"_12623":3957,"_48290":3786,"_18312":104764,"_5":17825,"_25222":104334,"_7710":104765},[48836],"Continuous efforts are being made to bring in more performance enhancement for join queries based on table statistics. Please refer to our Roadmap for more information.",{"_12623":3958,"_48290":3958,"_5":13058,"_7710":102916,"_48807":104767,"_18312":104768,"_25222":3958},[92880,92881,93148],[48836],{"_12623":3959,"_48290":3958,"_18312":104770,"_5":17825,"_25222":3958,"_7710":104771},[48836],"Phoenix in 15 minutes or less.",{"_12623":3960,"_48290":3958,"_5":48804,"_18312":104773,"_25222":104774,"_7710":104775},[48836],"/docs/quick-start#what-is-this-new-phoenix-thing-ive-been-hearing-about","What is this new Phoenix thing I've been hearing about?",{"_12623":3961,"_48290":3958,"_5":48804,"_18312":104777,"_25222":104778,"_7710":104779},[48836],"/docs/quick-start#doesnt-putting-an-extra-layer-between-my-application-and-hbase-just-slow-things-down","Doesn't putting an extra layer between my application and HBase just slow things down?",{"_12623":3962,"_48290":3958,"_5":48804,"_18312":104781,"_25222":104782,"_7710":104783},[48836],"/docs/quick-start#ok-so-its-fast-but-why-sql-its-so-1970s","Ok, so it's fast. But why SQL? It's so 1970s",{"_12623":3963,"_48290":3958,"_5":48804,"_18312":104785,"_25222":104786,"_7710":104787},[48836],"/docs/quick-start#but-how-can-sql-support-my-favorite-hbase-technique-of-xyz","But how can SQL support my favorite HBase technique of x,y,z",{"_12623":3964,"_48290":3958,"_5":48804,"_18312":104789,"_25222":104790,"_7710":104791},[48836],"/docs/quick-start#blah-blah-blah---i-just-want-to-get-started","Blah, blah, blah - I just want to get started!",{"_12623":3965,"_48290":3958,"_5":48804,"_18312":104793,"_25222":104794,"_7710":104795},[48836],"/docs/quick-start#i-dont-want-to-download-and-setup-anything-else","I don't want to download and setup anything else!",{"_12623":3966,"_48290":3958,"_5":48804,"_18312":104797,"_25222":104798,"_7710":104799},[48836],"/docs/quick-start#first-lets-create-a-us_populationsql-file-containing-a-table-definition","First, let's create a us_population.sql file, containing a table definition:",{"_12623":3967,"_48290":3958,"_5":48804,"_18312":104801,"_25222":104802,"_7710":104803},[48836],"/docs/quick-start#now-lets-create-a-us_populationcsv-file-containing-some-data-to-put-in-that-table","Now let's create a us_population.csv file containing some data to put in that table:",{"_12623":3968,"_48290":3958,"_5":48804,"_18312":104805,"_25222":104806,"_7710":104807},[48836],"/docs/quick-start#execute-the-following-command-from-a-command-terminal-to-create-and-populate-the-table","Execute the following command from a command terminal to create and populate the table",{"_12623":3969,"_48290":3958,"_5":48804,"_18312":104809,"_25222":104810,"_7710":104811},[48836],"/docs/quick-start#start-the-interactive-sql-client","Start the interactive sql client",{"_12623":3970,"_48290":3958,"_5":48804,"_18312":104813,"_25222":104814,"_7710":104815},[48836],"/docs/quick-start#big-deal---10-rows-what-else-you-got","Big deal - 10 rows! What else you got?",{"_12623":3971,"_48290":3958,"_5":48804,"_18312":104817,"_25222":104818,"_7710":104819},[48836],"/docs/quick-start#why-is-it-called-phoenix-anyway-did-some-other-project-crash-and-burn-and-this-is-the-next-generation","Why is it called Phoenix anyway? Did some other project crash and burn and this is the next generation?",{"_12623":3972,"_48290":3958,"_18312":104821,"_5":17825,"_25222":104774,"_7710":104822},[48836],"Phoenix is an open source SQL skin for HBase. You use the standard JDBC APIs instead of the regular HBase client APIs to create tables, insert data, and query your HBase data.",{"_12623":3973,"_48290":3958,"_18312":104824,"_5":17825,"_25222":104778,"_7710":104825},[48836],"Actually, no. Phoenix achieves as good or likely better performance than if you hand-coded it yourself (not to mention with a heck of a lot less code) by:",{"_12623":3974,"_48290":3958,"_18312":104827,"_5":17825,"_25222":104778,"_7710":104828},[48836],"compiling your SQL queries to native HBase scans",{"_12623":3975,"_48290":3958,"_18312":104830,"_5":17825,"_25222":104778,"_7710":104831},[48836],"determining the optimal start and stop for your scan key",{"_12623":3976,"_48290":3958,"_18312":104833,"_5":17825,"_25222":104778,"_7710":104834},[48836],"orchestrating the parallel execution of your scans",{"_12623":3977,"_48290":3958,"_18312":104836,"_5":17825,"_25222":104778,"_7710":104837},[48836],"bringing the computation to the data by",{"_12623":3978,"_48290":3958,"_18312":104839,"_5":17825,"_25222":104778,"_7710":104840},[48836],"pushing the predicates in your where clause to a server-side filter",{"_12623":3979,"_48290":3958,"_18312":104842,"_5":17825,"_25222":104778,"_7710":104843},[48836],"executing aggregate queries through server-side hooks (called co-processors)",{"_12623":3980,"_48290":3958,"_18312":104845,"_5":17825,"_25222":104778,"_7710":104846},[48836],"secondary indexes to improve performance for queries on non row key columns",{"_12623":3981,"_48290":3958,"_18312":104848,"_5":17825,"_25222":104778,"_7710":104849},[48836],"stats gathering to improve parallelization and guide choices between optimizations",{"_12623":3982,"_48290":3958,"_18312":104851,"_5":17825,"_25222":104778,"_7710":104852},[48836],"skip scan filter to optimize IN, LIKE, and OR queries",{"_12623":3983,"_48290":3958,"_18312":104854,"_5":17825,"_25222":104778,"_7710":104855},[48836],"optional salting of row keys to evenly distribute write load",{"_12623":3984,"_48290":3958,"_18312":104857,"_5":17825,"_25222":104782,"_7710":104858},[48836],"Well, that's kind of the point: give folks something with which they're already familiar. What better way to spur the adoption of HBase? On top of that, using JDBC and SQL:",{"_12623":3985,"_48290":3958,"_18312":104860,"_5":17825,"_25222":104782,"_7710":104861},[48836],"Reduces the amount of code users need to write",{"_12623":3986,"_48290":3958,"_18312":104863,"_5":17825,"_25222":104782,"_7710":104864},[48836],"Allows for performance optimizations transparent to the user",{"_12623":3987,"_48290":3958,"_18312":104866,"_5":17825,"_25222":104782,"_7710":104867},[48836],"Opens the door for leveraging and integrating lots of existing tooling",{"_12623":3988,"_48290":3958,"_18312":104869,"_5":17825,"_25222":104786,"_7710":104870},[48836],"Didn't make it to the last HBase Meetup did you? SQL is just a way of expressing what you want to get not how you want to get it. Check out my presentation for various existing and to-be-done Phoenix features to support your favorite HBase trick. Have ideas of your own? We'd love to hear about them: file an issue for us and/or join our mailing list.",{"_12623":3989,"_48290":3958,"_18312":104872,"_5":17825,"_25222":104790,"_7710":104873},[48836],"Ok, great! Just follow our install instructions:",{"_12623":3990,"_48290":3958,"_18312":104875,"_5":17825,"_25222":104790,"_7710":104876},[48836],"download and expand our installation binary tar corresponding to your HBase version",{"_12623":3991,"_48290":3958,"_18312":104878,"_5":17825,"_25222":104790,"_7710":104879},[48836],"copy the phoenix server jar into the lib directory of every region server and master",{"_12623":3992,"_48290":3958,"_18312":104881,"_5":17825,"_25222":104790,"_7710":104882},[48836],"restart HBase",{"_12623":3993,"_48290":3958,"_18312":104884,"_5":17825,"_25222":104790,"_7710":104885},[48836],"add the phoenix client jar to the classpath of your JDBC client or application",{"_12623":3994,"_48290":3958,"_18312":104887,"_5":17825,"_25222":104790,"_7710":104888},[48836],"We have detailed instructions for setting up SQuirreL SQL as your SQL client",{"_12623":3995,"_48290":3958,"_18312":104890,"_5":17825,"_25222":104794,"_7710":104891},[48836],"Ok, fair enough - you can create your own SQL scripts and execute them using our command line tools instead. Let's walk through an example now. Begin by navigating to the bin/ directory of your Phoenix install location.",{"_12623":3996,"_48290":3958,"_18312":104893,"_5":17825,"_25222":104810,"_7710":104894},[48836],"and issue a query",{"_12623":3997,"_48290":3958,"_18312":104896,"_5":17825,"_25222":104810,"_7710":104897},[48836],"Congratulations! You've just created your first Phoenix table, inserted data into it, and executed an aggregate query with just a few lines of code in 15 minutes or less!",{"_12623":3998,"_48290":3958,"_18312":104899,"_5":17825,"_25222":104814,"_7710":104900},[48836],"Ok, ok - tough crowd. Check out our bin/performance.py script to create as many rows as you want, for any schema you come up with, and run timed queries against it.",{"_12623":3999,"_48290":3958,"_18312":104902,"_5":17825,"_25222":104818,"_7710":104903},[48836],"I'm sorry, but we're out of time and space, so we'll have to answer that next time!",{"_12623":4000,"_48290":4000,"_5":13058,"_7710":104905,"_48807":104906,"_18312":104907,"_25222":4000},"Sequences",[92880,92881,92994],[48836],{"_12623":4001,"_48290":4000,"_18312":104909,"_5":17825,"_25222":4000,"_7710":104910},[48836],"Create, configure, and use SQL sequences in Phoenix, including caching, cycling, and NEXT/CURRENT VALUE semantics.",{"_12623":4002,"_48290":4000,"_18312":104912,"_5":17825,"_25222":4000,"_7710":104913},[48836],"Sequences are a standard SQL feature that generate monotonically increasing numbers, typically used to create IDs. To create a sequence, use:",{"_12623":4003,"_48290":4000,"_18312":104915,"_5":17825,"_25222":4000,"_7710":104916},[48836],"This creates a sequence named my_schema.my_sequence with an initial value of 1, incremented by 1 each time, with no cycle, minimum value, or maximum value, and 100 sequence values cached in your session (controlled by the phoenix.sequence.cacheSize config parameter). The complete syntax of CREATE SEQUENCE is documented here.",{"_12623":4004,"_48290":4000,"_18312":104918,"_5":17825,"_25222":4000,"_7710":104919},[48836],"Caching sequence values on your session improves performance, as we don't need to ask the server for more sequence values until we run out of cached values. The tradeoff is that you may end up with gaps in your sequence values when other sessions also use the same sequence.",{"_12623":4005,"_48290":4000,"_18312":104921,"_5":17825,"_25222":4000,"_7710":104922},[48836],"All of these parameters can be overridden when the sequence is created like this:",{"_12623":4006,"_48290":4000,"_18312":104924,"_5":17825,"_25222":4000,"_7710":104925},[48836],"Phoenix 3.1/4.1 added support for defining minimum and maximum values using MINVALUE and MAXVALUE, and for controlling cycling with the CYCLE keyword. Specifying CYCLE means the sequence continues generating values after reaching either boundary. For ascending sequences, after the maximum it returns to the minimum. For descending sequences, after the minimum it returns to the maximum. For example:",{"_12623":4007,"_48290":4000,"_18312":104927,"_5":17825,"_25222":4000,"_7710":104928},[48836],"will cause the sequence to cycle continuously from 1 to 100.",{"_12623":4008,"_48290":4000,"_18312":104930,"_5":17825,"_25222":4000,"_7710":104931},[48836],"Sequences are incremented using the NEXT VALUE FOR <sequence_name> expression in UPSERT VALUES, UPSERT SELECT, or SELECT statements:",{"_12623":4009,"_48290":4000,"_18312":104933,"_5":17825,"_25222":4000,"_7710":104934},[48836],"This will allocate a BIGINT based on the next value from the sequence (beginning with the START WITH value and incrementing from there based on the INCREMENT BY amount).",{"_12623":4010,"_48290":4000,"_18312":104936,"_5":17825,"_25222":4000,"_7710":104937},[48836],"When used in an UPSERT SELECT or SELECT statement, each row returned by the statement would have a unique value associated with it. For example:",{"_12623":4011,"_48290":4000,"_18312":104939,"_5":17825,"_25222":4000,"_7710":104940},[48836],"This allocates a new sequence value for each row returned from the SELECT expression. A sequence is incremented only once per statement, so multiple references to the same sequence by NEXT VALUE FOR produce the same value. For example, in the statement below, my_table.col1 and my_table.col2 would end up with the same value:",{"_12623":4012,"_48290":4000,"_18312":104942,"_5":17825,"_25222":4000,"_7710":104943},[48836],"You may also access the last sequence value allocated using a CURRENT VALUE FOR expression as shown below:",{"_12623":4013,"_48290":4000,"_18312":104945,"_5":17825,"_25222":4000,"_7710":104946},[48836],"This would evaluate to the last sequence value allocated from the previous NEXT VALUE FOR expression for your session (i.e. all connections on the same JVM for the same client machine). If no NEXT VALUE FOR expression had been previously called, this would produce an exception. If in a given statement a CURRENT VALUE FOR expression is used together with a NEXT VALUE FOR expression for the same sequence, then both would evaluate to the value produced by the NEXT VALUE FOR expression.",{"_12623":4014,"_48290":4000,"_18312":104948,"_5":17825,"_25222":4000,"_7710":104949},[48836],"The NEXT VALUE FOR and CURRENT VALUE FOR expressions may only be used as SELECT expressions or in the UPSERT VALUES statement. Use in WHERE, GROUP BY, HAVING, or ORDER BY will produce an exception. In addition, they cannot be used as the argument to an aggregate function.",{"_12623":4015,"_48290":4000,"_18312":104951,"_5":17825,"_25222":4000,"_7710":104952},[48836],"To drop a sequence, issue the following command:",{"_12623":4016,"_48290":4000,"_18312":104954,"_5":17825,"_25222":4000,"_7710":104955},[48836],"To discover all sequences that have been created, you may query the SYSTEM.SEQUENCE table as shown here:",{"_12623":4017,"_48290":4000,"_18312":104957,"_5":17825,"_25222":4000,"_7710":104958},[48836],"Note that only read-only access to the SYSTEM.SEQUENCE table is supported.",{"_12623":4018,"_48290":4018,"_5":13058,"_7710":104960,"_48807":104961,"_18312":104962,"_25222":4018},"Subqueries",[92880,92881,92994],[48836],{"_12623":4019,"_48290":4018,"_18312":104964,"_5":17825,"_25222":4018,"_7710":104965},[48836],"Use IN/EXISTS/comparison subqueries, correlated subqueries, row subqueries, and derived tables in Phoenix.",{"_12623":4020,"_48290":4018,"_5":48804,"_18312":104967,"_25222":104968,"_7710":104969},[48836],"/docs/subqueries#subqueries-with-in-or-not-in","Subqueries with IN or NOT IN",{"_12623":4021,"_48290":4018,"_5":48804,"_18312":104971,"_25222":104972,"_7710":104973},[48836],"/docs/subqueries#subqueries-with-exists-or-not-exists","Subqueries with EXISTS or NOT EXISTS",{"_12623":4022,"_48290":4018,"_5":48804,"_18312":104975,"_25222":104976,"_7710":104977},[48836],"/docs/subqueries#semi-joins-and-anti-joins","Semi-joins and Anti-joins",{"_12623":4023,"_48290":4018,"_5":48804,"_18312":104979,"_25222":104980,"_7710":104981},[48836],"/docs/subqueries#semi-join-optimization","Semi-join Optimization",{"_12623":4024,"_48290":4018,"_5":48804,"_18312":104983,"_25222":104984,"_7710":104985},[48836],"/docs/subqueries#subqueries-with-comparison-operators","Subqueries with Comparison Operators",{"_12623":4025,"_48290":4018,"_5":48804,"_18312":104987,"_25222":104988,"_7710":104989},[48836],"/docs/subqueries#subqueries-with-anysomeall-comparison-operators","Subqueries with ANY/SOME/ALL Comparison Operators",{"_12623":4026,"_48290":4018,"_5":48804,"_18312":104991,"_25222":104992,"_7710":104993},[48836],"/docs/subqueries#correlated-subqueries","Correlated Subqueries",{"_12623":4027,"_48290":4018,"_5":48804,"_18312":104995,"_25222":104996,"_7710":104997},[48836],"/docs/subqueries#andor-branches-and-multiple-levels-of-nesting","AND/OR Branches and Multiple levels of Nesting",{"_12623":4028,"_48290":4018,"_5":48804,"_18312":104999,"_25222":105000,"_7710":105001},[48836],"/docs/subqueries#row-subqueries","Row subqueries",{"_12623":4029,"_48290":4018,"_5":48804,"_18312":105003,"_25222":105004,"_7710":105005},[48836],"/docs/subqueries#derived-tables","Derived Tables",{"_12623":4030,"_48290":4018,"_5":48804,"_18312":105007,"_25222":105008,"_7710":93002},[48836],"/docs/subqueries#subqueries-limitations",{"_12623":4031,"_48290":4018,"_18312":105010,"_5":17825,"_25222":4018,"_7710":105011},[48836],"Phoenix now supports subqueries in the WHERE clause and the FROM clause. Subqueries can be specified in many places, like IN/NOT IN, EXISTS/NOT EXISTS, unmodified comparison operators or ANY/SOME/ALL comparison operators.",{"_12623":4032,"_48290":4018,"_18312":105013,"_5":17825,"_25222":104968,"_7710":105014},[48836],"The following query finds the names of the items that have sales record after Sept 2nd 2013. The inner query returns a list of items that satisfy the search criteria and the outer query will make use of this list to find matching entries.",{"_12623":4033,"_48290":4018,"_18312":105016,"_5":17825,"_25222":104972,"_7710":105017},[48836],"EXISTS simply tests the existence of the returned rows by the inner query. If the inner query returns one or more rows, EXISTS returns a value of TRUE; otherwise a value of FALSE. Many EXISTS queries are used to achieve the same goal as with IN queries or with ANY/SOME/ALL comparison queries. The below query returns the same results as the query in the previous example does:",{"_12623":4034,"_48290":4018,"_18312":105019,"_5":17825,"_25222":104976,"_7710":105020},[48836],"Queries with IN/NOT IN or EXISTS/NOT EXISTS are implemented with semi-joins and anti-joins wherever possible. A semi-join is different from a conventional join in that rows in the first table will be returned at most once, regardless of how many matches the second table contains for a certain row in the first table. A semi-join returns all those rows from the first table which can find at least one match in the second table. An IN or EXISTS construct is often translated into semi-joins.",{"_12623":4035,"_48290":4018,"_18312":105022,"_5":17825,"_25222":104976,"_7710":105023},[48836],"An anti-join is the opposite of a semi-join. The results of an anti-join are all those rows from the first table that can find no match in the second table. A NOT IN or NOT EXISTS construct is often translated into anti-joins.",{"_12623":4036,"_48290":4018,"_18312":105025,"_5":17825,"_25222":104980,"_7710":105026},[48836],"The \"Foreign Key to Primary Key Join Optimization\" mentioned in Phoenix Joins is equally applied to semi-joins. So if a skip-scan is driven for a semi-join qualified for this optimization and the IN or EXISTS semantics can be fully substituted by the skip-scan alone, the server-side join operation will not happen at all.",{"_12623":4037,"_48290":4018,"_18312":105028,"_5":17825,"_25222":104984,"_7710":105029},[48836],"Subqueries can be specified as the right-hand-side operand of the comparison operators (=, <>, >, >=, <, !>, !<, or <=).",{"_12623":4038,"_48290":4018,"_18312":105031,"_5":17825,"_25222":104984,"_7710":105032},[48836],"The example below finds participants whose contest scores are greater than the overall average score.",{"_12623":4039,"_48290":4018,"_18312":105034,"_5":17825,"_25222":104984,"_7710":105035},[48836],"A subquery introduced with an unmodified comparison operator (a comparison operator not followed by ANY or ALL) must only return a single row; otherwise it would result in getting a SQL error message.",{"_12623":4040,"_48290":4018,"_18312":105037,"_5":17825,"_25222":104988,"_7710":105038},[48836],"Subqueries can be introduced with a comparison operator modified by the keywords ANY, SOME or ALL, which has exactly the same semantics with static arrays, only that the array elements have to be dynamically computed through the execution of the inner query.",{"_12623":4041,"_48290":4018,"_18312":105040,"_5":17825,"_25222":104988,"_7710":105041},[48836],"The following query provides an example which lists the orders with a quantity greater than or equal to the maximum order quantity of any item.",{"_12623":4042,"_48290":4018,"_18312":105043,"_5":17825,"_25222":104992,"_7710":105044},[48836],"Correlated subqueries (also known as synchronized subqueries) are subqueries that contain references to the outer queries. Unlike independent subqueries, which only need to be evaluated once, the correlated inner query result depends on the outer query values and may differ from row to row.",{"_12623":4043,"_48290":4018,"_18312":105046,"_5":17825,"_25222":104992,"_7710":105047},[48836],"The following example finds the patents filed earlier than or equal to all patents filed within the same region:",{"_12623":4044,"_48290":4018,"_18312":105049,"_5":17825,"_25222":104992,"_7710":105050},[48836],"Phoenix optimizes such queries by rewriting them into equivalent join queries so that the inner query only needs to be executed once instead of once per outer row. The correlated subquery above will be rewritten in Phoenix as:",{"_12623":4045,"_48290":4018,"_18312":105052,"_5":17825,"_25222":104992,"_7710":105053},[48836],"Here, collect_distinct() is a reserved internal function in Phoenix, which collects distinct values of a given column or expression into a Phoenix array.",{"_12623":4046,"_48290":4018,"_18312":105055,"_5":17825,"_25222":104996,"_7710":105056},[48836],"Correlated subqueries or independent subqueries can be specified anywhere in the WHERE clause, whether in AND branches or in OR branches. And a query can have more than one level of subquery nesting, which means a subquery can include yet another (or more) subquery in itself.",{"_12623":4047,"_48290":4018,"_18312":105058,"_5":17825,"_25222":104996,"_7710":105059},[48836],"Below is an example of a complicated query that has multiple levels of subqueries connected with AND and OR branches, which is to find the items not involved in the orders sold to customers in Belgium with a quantity lower than 1000 or to customers in Germany with a quantity lower than 2000:",{"_12623":4048,"_48290":4018,"_18312":105061,"_5":17825,"_25222":105000,"_7710":105062},[48836],"A subquery can return multiple fields in one row, which is considered returning a row constructor. The row constructor on both sides of the operator (IN/NOT IN, EXISTS/NOT EXISTS or comparison operator) must contain the same number of values, like in the below example:",{"_12623":4049,"_48290":4018,"_18312":105064,"_5":17825,"_25222":105000,"_7710":105065},[48836],"This query returns all pairs of (column1, column2) that can match any pair of (column3, column4) in the second table after being filtered by condition: column5 = ‘nowhere’.",{"_12623":4050,"_48290":4018,"_18312":105067,"_5":17825,"_25222":105004,"_7710":105068},[48836],"Subqueries specified in the FROM clause are also called derived tables. For example, suppose you want to list a set of maximum values of a grouped table by their frequency of occurrence, and the below query will return the desired result:",{"_12623":4051,"_48290":4018,"_18312":105070,"_5":17825,"_25222":105004,"_7710":105071},[48836],"Derived tables can also be specified anywhere in a join query as join-tables. Please refer to the \"Grouped Joins and Derived Tables\" section of Phoenix Joins for more information and examples.",{"_12623":4052,"_48290":4018,"_18312":105073,"_5":17825,"_25222":105008,"_7710":105074},[48836],"In our Phoenix 3.2 and 4.2 releases, the subquery support has the following restrictions:",{"_12623":4053,"_48290":4018,"_18312":105076,"_5":17825,"_25222":105008,"_7710":105077},[48836],"PHOENIX-1388 Support correlated subqueries in the HAVING clause.",{"_12623":4054,"_48290":4018,"_18312":105079,"_5":17825,"_25222":105008,"_7710":105080},[48836],"PHOENIX-1392 Using subqueries as expressions.",{"_12623":4055,"_48290":4055,"_5":13058,"_7710":105082,"_48807":105083,"_18312":105085,"_25222":4055},"Apache Phoenix Documentation",[92880,105084],"Single-Page Documentation",[48696],{"_12623":4056,"_48290":4055,"_18312":105087,"_5":17825,"_25222":4055,"_7710":105088},[48696],"Complete Apache Phoenix documentation in one continuous page.",{"_12623":4057,"_48290":4055,"_5":48804,"_18312":105090,"_25222":105091,"_7710":97033},[48696],"/docs/single-page#overview",{"_12623":4058,"_48290":4055,"_5":48804,"_18312":105093,"_25222":105094,"_7710":102912},[48696],"/docs/single-page#mission",{"_12623":4059,"_48290":4055,"_5":48804,"_18312":105096,"_25222":105097,"_7710":102916},[48696],"/docs/single-page#index-quick-start",{"_12623":4060,"_48290":4055,"_5":48804,"_18312":105099,"_25222":105100,"_7710":102920},[48696],"/docs/single-page#sql-support",{"_12623":4061,"_48290":4055,"_5":48804,"_18312":105102,"_25222":105103,"_7710":102924},[48696],"/docs/single-page#connection",{"_12623":4062,"_48290":4055,"_5":48804,"_18312":105105,"_25222":105106,"_7710":99277},[48696],"/docs/single-page#index-transactions",{"_12623":4063,"_48290":4055,"_5":48804,"_18312":105108,"_25222":105109,"_7710":102931},[48696],"/docs/single-page#timestamps",{"_12623":4064,"_48290":4055,"_5":48804,"_18312":105111,"_25222":105112,"_7710":102935},[48696],"/docs/single-page#schema",{"_12623":4065,"_48290":4055,"_5":48804,"_18312":105114,"_25222":105115,"_7710":102939},[48696],"/docs/single-page#altering",{"_12623":4066,"_48290":4055,"_5":48804,"_18312":105117,"_25222":105118,"_7710":99707},[48696],"/docs/single-page#index-views",{"_12623":4067,"_48290":4055,"_5":48804,"_18312":105120,"_25222":105121,"_7710":96246},[48696],"/docs/single-page#index-multi-tenancy",{"_12623":4068,"_48290":4055,"_5":48804,"_18312":105123,"_25222":105124,"_7710":102949},[48696],"/docs/single-page#schema-at-read-time",{"_12623":4069,"_48290":4055,"_5":48804,"_18312":105126,"_25222":105127,"_7710":102953},[48696],"/docs/single-page#mapping-to-an-existing-hbase-table",{"_12623":4070,"_48290":4055,"_5":48804,"_18312":105129,"_25222":105130,"_7710":101562},[48696],"/docs/single-page#index-salting",{"_12623":4071,"_48290":4055,"_5":48804,"_18312":105132,"_25222":105133,"_7710":102960},[48696],"/docs/single-page#apis",{"_12623":4072,"_48290":4055,"_5":48804,"_18312":105135,"_25222":105136,"_7710":102916},[48696],"/docs/single-page#quick-start",{"_12623":4073,"_48290":4055,"_5":48804,"_18312":105138,"_25222":105139,"_7710":104775},[48696],"/docs/single-page#what-is-this-new-phoenix-thing-ive-been-hearing-about",{"_12623":4074,"_48290":4055,"_5":48804,"_18312":105141,"_25222":105142,"_7710":104779},[48696],"/docs/single-page#doesnt-putting-an-extra-layer-between-my-application-and-hbase-just-slow-things-down",{"_12623":4075,"_48290":4055,"_5":48804,"_18312":105144,"_25222":105145,"_7710":104783},[48696],"/docs/single-page#ok-so-its-fast-but-why-sql-its-so-1970s",{"_12623":4076,"_48290":4055,"_5":48804,"_18312":105147,"_25222":105148,"_7710":104787},[48696],"/docs/single-page#but-how-can-sql-support-my-favorite-hbase-technique-of-xyz",{"_12623":4077,"_48290":4055,"_5":48804,"_18312":105150,"_25222":105151,"_7710":104791},[48696],"/docs/single-page#blah-blah-blah---i-just-want-to-get-started",{"_12623":4078,"_48290":4055,"_5":48804,"_18312":105153,"_25222":105154,"_7710":104795},[48696],"/docs/single-page#i-dont-want-to-download-and-setup-anything-else",{"_12623":4079,"_48290":4055,"_5":48804,"_18312":105156,"_25222":105157,"_7710":104799},[48696],"/docs/single-page#first-lets-create-a-us_populationsql-file-containing-a-table-definition",{"_12623":4080,"_48290":4055,"_5":48804,"_18312":105159,"_25222":105160,"_7710":104803},[48696],"/docs/single-page#now-lets-create-a-us_populationcsv-file-containing-some-data-to-put-in-that-table",{"_12623":4081,"_48290":4055,"_5":48804,"_18312":105162,"_25222":105163,"_7710":104807},[48696],"/docs/single-page#execute-the-following-command-from-a-command-terminal-to-create-and-populate-the-table",{"_12623":4082,"_48290":4055,"_5":48804,"_18312":105165,"_25222":105166,"_7710":104811},[48696],"/docs/single-page#start-the-interactive-sql-client",{"_12623":4083,"_48290":4055,"_5":48804,"_18312":105168,"_25222":105169,"_7710":104815},[48696],"/docs/single-page#big-deal---10-rows-what-else-you-got",{"_12623":4084,"_48290":4055,"_5":48804,"_18312":105171,"_25222":105172,"_7710":104819},[48696],"/docs/single-page#why-is-it-called-phoenix-anyway-did-some-other-project-crash-and-burn-and-this-is-the-next-generation",{"_12623":4085,"_48290":4055,"_5":48804,"_18312":105174,"_25222":105175,"_7710":94224},[48696],"/docs/single-page#faq",{"_12623":4086,"_48290":4055,"_5":48804,"_18312":105177,"_25222":105178,"_7710":94233},[48696],"/docs/single-page#questions-answered-in-this-page",{"_12623":4087,"_48290":4055,"_5":48804,"_18312":105180,"_25222":105181,"_7710":94237},[48696],"/docs/single-page#i-want-to-get-started-is-there-a-phoenix-hello-world",{"_12623":4088,"_48290":4055,"_5":48804,"_18312":105183,"_25222":105184,"_7710":94241},[48696],"/docs/single-page#using-console",{"_12623":4089,"_48290":4055,"_5":48804,"_18312":105186,"_25222":105187,"_7710":94245},[48696],"/docs/single-page#using-java",{"_12623":4090,"_48290":4055,"_5":48804,"_18312":105189,"_25222":105190,"_7710":94249},[48696],"/docs/single-page#what-is-the-phoen