les.","/docs/integrations/pig-integration",{"_39":209},"(multi-page)/integrations/phoenix-dynamodb.mdx","Phoenix-DynamoDB REST Service","Run a DynamoDB-compatible REST endpoint on top of Apache Phoenix using the phoenix-dynamodb module from apache/phoenix-adapters.","/docs/integrations/phoenix-dynamodb",{"_39":214},"(multi-page)/integrations/apache-hive.mdx","Apache Hive","Configure and use the Phoenix Storage Handler with Apache Hive.","/docs/integrations/apache-hive",{"_39":219},"(multi-page)/integrations/spark-integration.mdx","Spark Integration","Use Apache Spark with Phoenix to read and write DataFrames.","/docs/integrations/spark-integration",{"_39":224},"Features",[234,235,236,237,238,239,240,241,242,243,244,245,246,247,248,249,250,251,252,253,254,255,256,257,258,259,260,261,262,263,264,265],"(multi-page)/features",{"_32":233},"(multi-page)/features/meta.json",{"_11":421,"_19":35,"_13":422,"_25":423,"_22":-7,"_7":424,"_30":425},{"_11":416,"_19":35,"_13":417,"_25":418,"_22":-7,"_7":419,"_30":420},{"_11":411,"_19":35,"_13":412,"_25":413,"_22":-7,"_7":414,"_30":415},{"_11":406,"_19":35,"_13":407,"_25":408,"_22":-7,"_7":409,"_30":410},{"_11":401,"_19":35,"_13":402,"_25":403,"_22":-7,"_7":404,"_30":405},{"_11":396,"_19":35,"_13":397,"_25":398,"_22":-7,"_7":399,"_30":400},{"_11":391,"_19":35,"_13":392,"_25":393,"_22":-7,"_7":394,"_30":395},{"_11":386,"_19":35,"_13":387,"_25":388,"_22":-7,"_7":389,"_30":390},{"_11":381,"_19":35,"_13":382,"_25":383,"_22":-7,"_7":384,"_30":385},{"_11":376,"_19":35,"_13":377,"_25":378,"_22":-7,"_7":379,"_30":380},{"_11":371,"_19":35,"_13":372,"_25":373,"_22":-7,"_7":374,"_30":375},{"_11":366,"_19":35,"_13":367,"_25":368,"_22":-7,"_7":369,"_30":370},{"_11":361,"_19":35,"_13":362,"_25":363,"_22":-7,"_7":364,"_30":365},{"_11":356,"_19":35,"_13":357,"_25":358,"_22":-7,"_7":359,"_30":360},{"_11":351,"_19":35,"_13":352,"_25":353,"_22":-7,"_7":354,"_30":355},{"_11":346,"_19":35,"_13":347,"_25":348,"_22":-7,"_7":349,"_30":350},{"_11":341,"_19":35,"_13":342,"_25":343,"_22":-7,"_7":344,"_30":345},{"_11":336,"_19":35,"_13":337,"_25":338,"_22":-7,"_7":339,"_30":340},{"_11":331,"_19":35,"_13":332,"_25":333,"_22":-7,"_7":334,"_30":335},{"_11":326,"_19":35,"_13":327,"_25":328,"_22":-7,"_7":329,"_30":330},{"_11":321,"_19":35,"_13":322,"_25":323,"_22":-7,"_7":324,"_30":325},{"_11":316,"_19":35,"_13":317,"_25":318,"_22":-7,"_7":319,"_30":320},{"_11":311,"_19":35,"_13":312,"_25":313,"_22":-7,"_7":314,"_30":315},{"_11":306,"_19":35,"_13":307,"_25":308,"_22":-7,"_7":309,"_30":310},{"_11":301,"_19":35,"_13":302,"_25":303,"_22":-7,"_7":304,"_30":305},{"_11":296,"_19":35,"_13":297,"_25":298,"_22":-7,"_7":299,"_30":300},{"_11":291,"_19":35,"_13":292,"_25":293,"_22":-7,"_7":294,"_30":295},{"_11":286,"_19":35,"_13":287,"_25":288,"_22":-7,"_7":289,"_30":290},{"_11":281,"_19":35,"_13":282,"_25":283,"_22":-7,"_7":284,"_30":285},{"_11":276,"_19":35,"_13":277,"_25":278,"_22":-7,"_7":279,"_30":280},{"_11":271,"_19":35,"_13":272,"_25":273,"_22":-7,"_7":274,"_30":275},{"_11":266,"_19":35,"_13":267,"_25":268,"_22":-7,"_7":269,"_30":270},"(multi-page)/features/cursor.mdx","Cursor","Use CURSOR statements in Phoenix to process query results in controlled row batches.","/docs/features/cursor",{"_39":266},"(multi-page)/features/tracing.mdx","Tracing","Configure, enable, collect, and inspect Phoenix tracing data, including metrics sinks and tracing web app usage.","/docs/features/tracing",{"_39":271},"(multi-page)/features/row-size.mdx","ROW_SIZE() and RAW_ROW_SIZE()","Built-in SQL functions that return the on-the-wire HBase byte footprint of a row — useful for hot-row diagnosis, capacity planning, and finding outliers directly from SQL.","/docs/features/row-size",{"_39":276},"(multi-page)/features/metrics.mdx","Metrics","Request-level and global Phoenix client metrics, with practical usage patterns and Java examples.","/docs/features/metrics",{"_39":281},"(multi-page)/features/high-availability.mdx","High Availability","Active/active and active/standby Phoenix client wiring across two HBase clusters, with graceful failover that lets writes drain server-side before the peer is promoted.","/docs/features/high-availability",{"_39":286},"(multi-page)/features/query-server.mdx","Query Server","Deploy and use Phoenix Query Server (PQS), including client access, impersonation, metrics, and load-balancing configuration.","/docs/features/query-server",{"_39":291},"(multi-page)/features/phoenix-sync-table.mdx","PhoenixSyncTable Tool","Detect data divergence between a source and a target Phoenix table across two HBase clusters via a chunked hash comparison driven by MapReduce.","/docs/features/phoenix-sync-table",{"_39":296},"(multi-page)/features/bulk-loading.mdx","Bulk Loading","Load Phoenix tables with PSQL and MapReduce-based CSV/JSON bulk loaders, including options, permissions, and tuning notes.","/docs/features/bulk-loading",{"_39":301},"(multi-page)/features/change-data-capture.mdx","Change Data Capture (CDC)","Query row-level change events on a Phoenix table using standard SQL — pull pre/post images and change deltas with bounded, resumable reads.","/docs/features/change-data-capture",{"_39":306},"(multi-page)/features/bson.mdx","Document Data: BSON","Store, query, filter, and atomically update Binary JSON (BSON) documents inside a Phoenix table — without round-tripping the document to the client.","/docs/features/bson",{"_39":311},"(multi-page)/features/varbinary-encoded.mdx","VARBINARY_ENCODED","A variable-length binary type that sorts correctly anywhere in a composite key — use it for row keys, index keys, and row value constructors that contain binary data.","/docs/features/varbinary-encoded",{"_39":316},"(multi-page)/features/dynamic-columns.mdx","Dynamic Columns","Define and query late-bound dynamic columns in Phoenix when full schema cannot be declared upfront.","/docs/features/dynamic-columns",{"_39":321},"(multi-page)/features/multi-tenancy.mdx","Multi-tenancy","Use multi-tenant tables, tenant-specific connections, and tenant views to isolate tenant data in Phoenix.","/docs/features/multi-tenancy",{"_39":326},"(multi-page)/features/conditional-ttl.mdx","Conditional TTL","Express row expiration as a SQL boolean expression evaluated against the row itself.","/docs/features/conditional-ttl",{"_39":331},"(multi-page)/features/view-ttl.mdx","View TTL","Per-view retention on top of a shared base table — different views can age data out on different schedules without splitting the table.","/docs/features/view-ttl",{"_39":336},"(multi-page)/features/ttl.mdx","TTL","Phoenix TTL flavors (time-based, view, conditional) and the IS_STRICT_TTL property that controls visibility of expired rows.","/docs/features/ttl",{"_39":341},"(multi-page)/features/views.mdx","Views","Define updatable and read-only Phoenix views over shared HBase tables, including indexing behavior and limitations.","/docs/features/views",{"_39":346},"(multi-page)/features/table-sampling.mdx","Table Sampling","Use TABLESAMPLE in Phoenix for Bernoulli-style sampling, with performance notes, repeatability behavior, and tuning guidance.","/docs/features/table-sampling",{"_39":351},"(multi-page)/features/segment-scan.mdx","Segment Scan","Get N evenly-bucketed key ranges for a Phoenix table so a client can drive a parallel full-table scan.","/docs/features/segment-scan",{"_39":356},"(multi-page)/features/skip-scan.mdx","Skip Scan","How Phoenix Skip Scan uses key-range hints to efficiently skip non-matching row-key regions.","/docs/features/skip-scan",{"_39":361},"(multi-page)/features/salted-tables.mdx","Salted Tables","Use SALT_BUCKETS to reduce HBase hotspotting and understand scan, split, and ordering behavior for salted tables.","/docs/features/salted-tables",{"_39":366},"(multi-page)/features/paged-queries.mdx","Paged Queries","Use row value constructors and OFFSET/LIMIT for efficient paged query patterns in Phoenix.","/docs/features/paged-queries",{"_39":371},"(multi-page)/features/phoenix-row-timestamp.mdx","PHOENIX_ROW_TIMESTAMP()","Read the per-row last-modified timestamp Phoenix maintains automatically — usable in projections, predicates, and indexes for fast time-bounded reads.","/docs/features/phoenix-row-timestamp",{"_39":376},"(multi-page)/features/row-timestamp-column.mdx","Row Timestamp Column","Map HBase row timestamps to a Phoenix primary-key column and use ROW_TIMESTAMP in table design and upserts.","/docs/features/row-timestamp-column",{"_39":381},"(multi-page)/features/statistics-collection.mdx","Statistics Collection","How Phoenix collects and uses guidepost statistics for query parallelization, with commands and configuration.","/docs/features/statistics-collection",{"_39":386},"(multi-page)/features/namespace-mapping.mdx","Namespace Mapping","Enable Phoenix schema-to-namespace mapping in HBase, including configuration, migration, and behavior by table type.","/docs/features/namespace-mapping",{"_39":391},"(multi-page)/features/atomic-upsert.mdx","Atomic Upsert","Use UPSERT ... ON DUPLICATE KEY for atomic row-level updates in Phoenix, with examples and limitations.","/docs/features/atomic-upsert",{"_39":396},"(multi-page)/features/storage-formats.mdx","Storage Formats","Configure Phoenix column mapping and immutable storage encoding for better storage efficiency and performance.","/docs/features/storage-formats",{"_39":401},"(multi-page)/features/eventually-consistent-indexes.mdx","Eventually Consistent Global Indexes","Global secondary indexes maintained asynchronously off the data-table write path — for write-heavy workloads that can tolerate a bounded staleness window on the index in exchange for higher write throughput.","/docs/features/eventually-consistent-indexes",{"_39":406},"(multi-page)/features/secondary-indexes.mdx","Secondary Indexes","Concepts, setup, consistency guarantees, and tooling for Phoenix secondary indexes.","/docs/features/secondary-indexes",{"_39":411},"(multi-page)/features/user-defined-functions.mdx","User-defined Functions","Create, deploy, and manage custom Phoenix UDFs with configuration, implementation steps, and known limitations.","/docs/features/user-defined-functions",{"_39":416},"(multi-page)/features/transactions.mdx","Transactions","Configure and use transactional tables in Phoenix with Tephra, including setup steps and limitations.","/docs/features/transactions",{"_39":421},"Fundamentals",[431,432,433,434,435,436,437],"(multi-page)/fundamentals",{"_32":430},"(multi-page)/fundamentals/meta.json",{"_11":468,"_19":35,"_13":469,"_25":470,"_22":-7,"_7":471,"_30":472},{"_11":463,"_19":35,"_13":464,"_25":465,"_22":-7,"_7":466,"_30":467},{"_11":458,"_19":35,"_13":459,"_25":460,"_22":-7,"_7":461,"_30":462},{"_11":453,"_19":35,"_13":454,"_25":455,"_22":-7,"_7":456,"_30":457},{"_11":448,"_19":35,"_13":449,"_25":450,"_22":-7,"_7":451,"_30":452},{"_11":443,"_19":35,"_13":444,"_25":445,"_22":-7,"_7":446,"_30":447},{"_11":438,"_19":35,"_13":439,"_25":440,"_22":-7,"_7":441,"_30":442},"(multi-page)/fundamentals/performance-testing.mdx","Performance Testing","Use Pherf to generate data and run Phoenix performance tests.","/docs/fundamentals/performance-testing",{"_39":438},"(multi-page)/fundamentals/performance.mdx","Performance","Historical Phoenix performance comparisons and feature-level improvements for scans, salting, and query execution.","/docs/fundamentals/performance",{"_39":443},"(multi-page)/fundamentals/backward-compatibility.mdx","Backward Compatibility","Phoenix upgrade compatibility across patch, minor, and major releases.","/docs/fundamentals/backward-compatibility",{"_39":448},"(multi-page)/fundamentals/configuration.mdx","Configuration","Phoenix configuration properties and tuning defaults.","/docs/fundamentals/configuration",{"_39":453},"(multi-page)/fundamentals/tuning-guide.mdx","Tuning Guide","Best practices for tuning Phoenix schema, indexes, queries, and write paths for read/write performance.","/docs/fundamentals/tuning-guide",{"_39":458},"(multi-page)/fundamentals/client-classpath-and-jdbc-url.mdx","Client Classpath and JDBC URL","Configure Phoenix thick-client classpath and JDBC URLs.","/docs/fundamentals/client-classpath-and-jdbc-url",{"_39":463},"(multi-page)/fundamentals/building.mdx","Building","Build Apache Phoenix and add it to Maven-based projects.","/docs/fundamentals/building",{"_39":468},"(multi-page)#5","Development","(multi-page)/faq.mdx","FAQ","Frequently asked question about Phoenix","CircleQuestionMark","/docs/faq",{"_39":475},"(multi-page)/installation.mdx","Installation","Install and configure Apache Phoenix clients and server components.","Wrench","/docs/installation",{"_39":481},"(multi-page)/quick-start.mdx","Quick Start","Phoenix in 15 minutes or less.","Rocket","/docs/quick-start",{"_39":487},"(multi-page)/index.mdx","Overview","OLTP and operational analytics for Apache Hadoop.","BookOpen","/docs",{"_39":493},"(multi-page)#0","Getting Started"]
