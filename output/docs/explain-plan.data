1":37,"_16":300,"_18":301,"_32":-7,"_7":302,"_13":299},{"_15":295,"_11":37,"_16":296,"_18":297,"_32":-7,"_7":298,"_13":295},{"_15":291,"_11":37,"_16":292,"_18":293,"_32":-7,"_7":294,"_13":291},{"_15":287,"_11":37,"_16":288,"_18":289,"_32":-7,"_7":290,"_13":287},{"_15":283,"_11":37,"_16":284,"_18":285,"_32":-7,"_7":286,"_13":283},{"_15":279,"_11":37,"_16":280,"_18":281,"_32":-7,"_7":282,"_13":279},{"_15":275,"_11":37,"_16":276,"_18":277,"_32":-7,"_7":278,"_13":275},{"_15":271,"_11":37,"_16":272,"_18":273,"_32":-7,"_7":274,"_13":271},{"_15":267,"_11":37,"_16":268,"_18":269,"_32":-7,"_7":270,"_13":267},{"_15":263,"_11":37,"_16":264,"_18":265,"_32":-7,"_7":266,"_13":263},{"_15":259,"_11":37,"_16":260,"_18":261,"_32":-7,"_7":262,"_13":259},{"_15":255,"_11":37,"_16":256,"_18":257,"_32":-7,"_7":258,"_13":255},{"_15":251,"_11":37,"_16":252,"_18":253,"_32":-7,"_7":254,"_13":251},{"_15":247,"_11":37,"_16":248,"_18":249,"_32":-7,"_7":250,"_13":247},"(multi-page)/features/cursor.mdx","Cursor","Use CURSOR statements in Phoenix to process query results in controlled row batches.","/docs/features/cursor","(multi-page)/features/tracing.mdx","Tracing","Configure, enable, collect, and inspect Phoenix tracing data, including metrics sinks and tracing web app usage.","/docs/features/tracing","(multi-page)/features/row-size.mdx","ROW_SIZE() and RAW_ROW_SIZE()","Built-in SQL functions that return the on-the-wire HBase byte footprint of a row — useful for hot-row diagnosis, capacity planning, and finding outliers directly from SQL.","/docs/features/row-size","(multi-page)/features/metrics.mdx","Metrics","Request-level and global Phoenix client metrics, with practical usage patterns and Java examples.","/docs/features/metrics","(multi-page)/features/high-availability.mdx","High Availability","Active/active and active/standby Phoenix client wiring across two HBase clusters, with graceful failover that lets writes drain server-side before the peer is promoted.","/docs/features/high-availability","(multi-page)/features/query-server.mdx","Query Server","Deploy and use Phoenix Query Server (PQS), including client access, impersonation, metrics, and load-balancing configuration.","/docs/features/query-server","(multi-page)/features/phoenix-sync-table.mdx","PhoenixSyncTable Tool","Detect data divergence between a source and a target Phoenix table across two HBase clusters via a chunked hash comparison driven by MapReduce.","/docs/features/phoenix-sync-table","(multi-page)/features/bulk-loading.mdx","Bulk Loading","Load Phoenix tables with PSQL and MapReduce-based CSV/JSON bulk loaders, including options, permissions, and tuning notes.","/docs/features/bulk-loading","(multi-page)/features/change-data-capture.mdx","Change Data Capture (CDC)","Query row-level change events on a Phoenix table using standard SQL — pull pre/post images and change deltas with bounded, resumable reads.","/docs/features/change-data-capture","(multi-page)/features/bson.mdx","Document Data: BSON","Store, query, filter, and atomically update Binary JSON (BSON) documents inside a Phoenix table — without round-tripping the document to the client.","/docs/features/bson","(multi-page)/features/varbinary-encoded.mdx","VARBINARY_ENCODED","A variable-length binary type that sorts correctly anywhere in a composite key — use it for row keys, index keys, and row value constructors that contain binary data.","/docs/features/varbinary-encoded","(multi-page)/features/dynamic-columns.mdx","Dynamic Columns","Define and query late-bound dynamic columns in Phoenix when full schema cannot be declared upfront.","/docs/features/dynamic-columns","(multi-page)/features/multi-tenancy.mdx","Multi-tenancy","Use multi-tenant tables, tenant-specific connections, and tenant views to isolate tenant data in Phoenix.","/docs/features/multi-tenancy","(multi-page)/features/conditional-ttl.mdx","Conditional TTL","Express row expiration as a SQL boolean expression evaluated against the row itself.","/docs/features/conditional-ttl","(multi-page)/features/view-ttl.mdx","View TTL","Per-view retention on top of a shared base table — different views can age data out on different schedules without splitting the table.","/docs/features/view-ttl","(multi-page)/features/ttl.mdx","TTL","Phoenix TTL flavors (time-based, view, conditional) and the IS_STRICT_TTL property that controls visibility of expired rows.","/docs/features/ttl","(multi-page)/features/views.mdx","Views","Define updatable and read-only Phoenix views over shared HBase tables, including indexing behavior and limitations.","/docs/features/views","(multi-page)/features/table-sampling.mdx","Table Sampling","Use TABLESAMPLE in Phoenix for Bernoulli-style sampling, with performance notes, repeatability behavior, and tuning guidance.","/docs/features/table-sampling","(multi-page)/features/segment-scan.mdx","Segment Scan","Get N evenly-bucketed key ranges for a Phoenix table so a client can drive a parallel full-table scan.","/docs/features/segment-scan","(multi-page)/features/skip-scan.mdx","Skip Scan","How Phoenix Skip Scan uses key-range hints to efficiently skip non-matching row-key regions.","/docs/features/skip-scan","(multi-page)/features/salted-tables.mdx","Salted Tables","Use SALT_BUCKETS to reduce HBase hotspotting and understand scan, split, and ordering behavior for salted tables.","/docs/features/salted-tables","(multi-page)/features/paged-queries.mdx","Paged Queries","Use row value constructors and OFFSET/LIMIT for efficient paged query patterns in Phoenix.","/docs/features/paged-queries","(multi-page)/features/phoenix-row-timestamp.mdx","PHOENIX_ROW_TIMESTAMP()","Read the per-row last-modified timestamp Phoenix maintains automatically — usable in projections, predicates, and indexes for fast time-bounded reads.","/docs/features/phoenix-row-timestamp","(multi-page)/features/row-timestamp-column.mdx","Row Timestamp Column","Map HBase row timestamps to a Phoenix primary-key column and use ROW_TIMESTAMP in table design and upserts.","/docs/features/row-timestamp-column","(multi-page)/features/statistics-collection.mdx","Statistics Collection","How Phoenix collects and uses guidepost statistics for query parallelization, with commands and configuration.","/docs/features/statistics-collection","(multi-page)/features/namespace-mapping.mdx","Namespace Mapping","Enable Phoenix schema-to-namespace mapping in HBase, including configuration, migration, and behavior by table type.","/docs/features/namespace-mapping","(multi-page)/features/atomic-upsert.mdx","Atomic Upsert","Use UPSERT ... ON DUPLICATE KEY for atomic row-level updates in Phoenix, with examples and limitations.","/docs/features/atomic-upsert","(multi-page)/features/storage-formats.mdx","Storage Formats","Configure Phoenix column mapping and immutable storage encoding for better storage efficiency and performance.","/docs/features/storage-formats","(multi-page)/features/eventually-consistent-indexes.mdx","Eventually Consistent Global Indexes","Global secondary indexes maintained asynchronously off the data-table write path — for write-heavy workloads that can tolerate a bounded staleness window on the index in exchange for higher write throughput.","/docs/features/eventually-consistent-indexes","(multi-page)/features/secondary-indexes.mdx","Secondary Indexes","Concepts, setup, consistency guarantees, and tooling for Phoenix secondary indexes.","/docs/features/secondary-indexes","(multi-page)/features/user-defined-functions.mdx","User-defined Functions","Create, deploy, and manage custom Phoenix UDFs with configuration, implementation steps, and known limitations.","/docs/features/user-defined-functions","(multi-page)/features/transactions.mdx","Transactions","Configure and use transactional tables in Phoenix with Tephra, including setup steps and limitations.","/docs/features/transactions","Fundamentals",[380,381,382,383,384,385,386],"(multi-page)/fundamentals",{"_23":377,"_33":379},"(multi-page)/fundamentals/meta.json",{"_15"