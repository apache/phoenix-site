eatures/transactions",{"_41":119},{"_11":125,"_18":34,"_13":126,"_24":127,"_21":-7,"_7":128,"_39":129},"(multi-page)/features/user-defined-functions.mdx","User-defined Functions","Create, deploy, and manage custom Phoenix UDFs with configuration, implementation steps, and known limitations.","/docs/features/user-defined-functions",{"_41":125},{"_11":131,"_18":34,"_13":132,"_24":133,"_21":-7,"_7":134,"_39":135},"(multi-page)/features/secondary-indexes.mdx","Secondary Indexes","Concepts, setup, consistency guarantees, and tooling for Phoenix secondary indexes.","/docs/features/secondary-indexes",{"_41":131},{"_11":137,"_18":34,"_13":138,"_24":139,"_21":-7,"_7":140,"_39":141},"(multi-page)/features/eventually-consistent-indexes.mdx","Eventually Consistent Global Indexes","Global secondary indexes maintained asynchronously off the data-table write path — for write-heavy workloads that can tolerate a bounded staleness window on the index in exchange for higher write throughput.","/docs/features/eventually-consistent-indexes",{"_41":137},{"_11":143,"_18":34,"_13":144,"_24":145,"_21":-7,"_7":146,"_39":147},"(multi-page)/features/storage-formats.mdx","Storage Formats","Configure Phoenix column mapping and immutable storage encoding for better storage efficiency and performance.","/docs/features/storage-formats",{"_41":143},{"_11":149,"_18":34,"_13":150,"_24":151,"_21":-7,"_7":152,"_39":153},"(multi-page)/features/atomic-upsert.mdx","Atomic Upsert","Use UPSERT ... ON DUPLICATE KEY for atomic row-level updates in Phoenix, with examples and limitations.","/docs/features/atomic-upsert",{"_41":149},{"_11":155,"_18":34,"_13":156,"_24":157,"_21":-7,"_7":158,"_39":159},"(multi-page)/features/namespace-mapping.mdx","Namespace Mapping","Enable Phoenix schema-to-namespace mapping in HBase, including configuration, migration, and behavior by table type.","/docs/features/namespace-mapping",{"_41":155},{"_11":161,"_18":34,"_13":162,"_24":163,"_21":-7,"_7":164,"_39":165},"(multi-page)/fea